//===----------------------------------------------------------------------===//
//
// !!!!!!!
// WARNING: this file is autogenerated, manual changes will be overwritten
// !!!!!!!

// WARNING: this API is not yet stable, meaning it is only guaranteed to work for this specific DuckDB version.

#pragma once

// An extension targets either the V1 or the V2 C API, never both.
#ifdef DUCKDB_EXTENSION_HEADER_VERSION
#error "duckdb_extension.h and duckdb_extension_v2.h cannot both be included: pick one C API version"
#endif
#define DUCKDB_EXTENSION_HEADER_VERSION 2

#include "duckdb_v2.h"

//===--------------------------------------------------------------------===//
// Util Macros
//===--------------------------------------------------------------------===//

#ifdef __cplusplus
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN  extern "C" {
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE }
#else
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE
#endif

#define DUCKDB_EXTENSION_GLUE_HELPER(x, y) x##y
#define DUCKDB_EXTENSION_GLUE(x, y)        DUCKDB_EXTENSION_GLUE_HELPER(x, y)
#define DUCKDB_EXTENSION_STR_HELPER(x)     #x
#define DUCKDB_EXTENSION_STR(x)            DUCKDB_EXTENSION_STR_HELPER(x)
#define DUCKDB_EXTENSION_SEMVER_STRING(major, minor, patch)                                                            \
	"v" DUCKDB_EXTENSION_STR_HELPER(major) "." DUCKDB_EXTENSION_STR_HELPER(minor) "." DUCKDB_EXTENSION_STR_HELPER(patch)

//===--------------------------------------------------------------------===//
// Versioning
//===--------------------------------------------------------------------===//
//! Set version to latest if no explicit version is defined

#if !defined(DUCKDB_EXTENSION_API_VERSION_MAJOR) && !defined(DUCKDB_EXTENSION_API_VERSION_MINOR) &&                    \
    !defined(DUCKDB_EXTENSION_API_VERSION_PATCH)
#define DUCKDB_EXTENSION_API_VERSION_MAJOR 2
#define DUCKDB_EXTENSION_API_VERSION_MINOR 0
#define DUCKDB_EXTENSION_API_VERSION_PATCH 0
#elif !(defined(DUCKDB_EXTENSION_API_VERSION_MAJOR) && defined(DUCKDB_EXTENSION_API_VERSION_MINOR) &&                  \
        defined(DUCKDB_EXTENSION_API_VERSION_PATCH))
#error "either all or none of the  DUCKDB_EXTENSION_API_VERSION_ defines should be defined"
#endif

//! The version string passed to DuckDB on extension load. The major selects the V2 API family; for extensions pinned
//! to an exact DuckDB version (C_STRUCT_UNSTABLE) the loader reads only the major and ignores the rest.
#define DUCKDB_EXTENSION_API_VERSION_STRING                                                                            \
	DUCKDB_EXTENSION_SEMVER_STRING(DUCKDB_EXTENSION_API_VERSION_MAJOR, DUCKDB_EXTENSION_API_VERSION_MINOR,             \
	                               DUCKDB_EXTENSION_API_VERSION_PATCH)

#if DUCKDB_EXTENSION_API_VERSION_MAJOR != 2
#error "This version of the extension API header only supports API VERSION v2.x.x"
#endif

// No V2 function has been stabilized yet, so without the unstable surface the function pointer struct would be empty.
#if !DUCKDB_V2_API_ALLOW_UNSTABLE
#error "the V2 C API has no stable surface yet: build with build_loadable_extension_capi_unstable or build_static_extension_capi_unstable, which tie the extension to this DuckDB version"
#endif

//===--------------------------------------------------------------------===//
// Function pointer struct
//===--------------------------------------------------------------------===//
typedef struct {
	// capigen:begin appended
	// capigen:end appended
} duckdb_ext_api_v2;

//===--------------------------------------------------------------------===//
// Typedefs mapping functions to struct entries
//===--------------------------------------------------------------------===//
// When building as a static extension, DuckDB symbols are resolved directly at link time.
// The vtable (duckdb_ext_api) is not used - skip these macro redirections.
#ifndef DUCKDB_BUILD_STATIC_EXTENSION
// capigen:begin appended
// capigen:end appended
#endif // DUCKDB_BUILD_STATIC_EXTENSION

//===--------------------------------------------------------------------===//
// Struct Global Macros
//===--------------------------------------------------------------------===//
#ifdef DUCKDB_BUILD_STATIC_EXTENSION
// No vtable global needed for static builds - DuckDB symbols are resolved directly at link time
#define DUCKDB_EXTENSION_GLOBAL
#define DUCKDB_EXTENSION_API_INIT(input, minimum_api_version)
#else
// This goes in the c/c++ file containing the entrypoint
#define DUCKDB_EXTENSION_GLOBAL duckdb_ext_api_v2 duckdb_ext_api = {0};
// Initializes the C Extension API: First thing to call in the extension entrypoint. Nothing else in the API may be
// called before it succeeds, so a failure returns without touching the error slot: the library has already recorded
// why get_api refused, and reports that.
#define DUCKDB_EXTENSION_API_INIT(input, minimum_api_version)                                                          \
	duckdb_ext_api_v2 *res = (duckdb_ext_api_v2 *)(input)->get_api((input)->extension, minimum_api_version);            \
	if (!res) {                                                                                                        \
		return;                                                                                                        \
	};                                                                                                                 \
	duckdb_ext_api = *res;
#endif // DUCKDB_BUILD_STATIC_EXTENSION

// Place in global scope of any C/C++ file that needs to access the extension API
#define DUCKDB_EXTENSION_EXTERN extern duckdb_ext_api_v2 duckdb_ext_api;

#ifdef _WIN32
#define DUCKDB_CAPI_ENTRY_VISIBILITY __declspec(dllexport)
#else
#define DUCKDB_CAPI_ENTRY_VISIBILITY __attribute__((visibility("default")))
#endif

//===--------------------------------------------------------------------===//
// Entrypoint Macros
//===--------------------------------------------------------------------===//

// Note: the DUCKDB_EXTENSION_ENTRYPOINT macro requires DUCKDB_EXTENSION_NAME to be set.

#ifdef DUCKDB_EXTENSION_NAME

// Main entrypoint: receives the extension being loaded to register functionality through, a context to read and run
// queries through, and the error slot to report failure on. Write the body as
//
//		DUCKDB_EXTENSION_ENTRYPOINT(duckdb_v2_extension_handle extension, duckdb_v2_context_handle context,
//		                            duckdb_v2_error_info_handle *err) {
//			...
//		}
#define DUCKDB_EXTENSION_ENTRYPOINT                                                                                    \
	DUCKDB_EXTENSION_GLOBAL static void DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME, _init_c_api_v2_internal)(         \
	    duckdb_v2_extension_handle extension, duckdb_v2_context_handle context, duckdb_v2_error_info_handle * err);    \
	DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN DUCKDB_CAPI_ENTRY_VISIBILITY DUCKDB_EXTENSION_API void DUCKDB_EXTENSION_GLUE( \
	    DUCKDB_EXTENSION_NAME, _init_c_api_v2)(struct duckdb_v2_extension_input * input) {                             \
		DUCKDB_EXTENSION_API_INIT(input, DUCKDB_EXTENSION_API_VERSION_STRING);                                         \
		DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME, _init_c_api_v2_internal)(input->extension, input->context,        \
		                                                                      input->err);                             \
	}                                                                                                                  \
	DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE static void DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME,                     \
	                                                                        _init_c_api_v2_internal)

// Custom entrypoint: identical to the main entrypoint
#define DUCKDB_EXTENSION_ENTRYPOINT_CUSTOM DUCKDB_EXTENSION_ENTRYPOINT
#endif
