# name: benchmark/large/tpch-sf100/q11.benchmark
# description: Run query 11 from the TPC-H benchmark ()
# group: [tpch-sf100]

# Q11 is the only TPC-H query whose substitution parameter depends on the scale factor (FRACTION = 0.0001 / SF),
# so it runs the SF 100 query text instead of the shared template. The result has ties on the ORDER BY key, so the
# answer is verified in a deterministic order.

name Q11
group tpch
subgroup sf1

require tpch

cache tpch_sf100.duckdb

load benchmark/large/tpch-sf100/load.sql

run benchmark/large/tpch-sf100/q11.sql

result_query extension/tpch/dbgen/answers/sf100/q11.csv
SELECT ps_partkey, value FROM __answer ORDER BY value DESC, ps_partkey
----
