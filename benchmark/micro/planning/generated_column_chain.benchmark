	g76 AS (g75 + 1),
	g77 AS (g76 + 1),
	g78 AS (g77 + 1),
	g79 AS (g78 + 1)
);
INSERT INTO r VALUES (1);

run
EXPLAIN SELECT r.g79 FROM (VALUES (1)) l(i) LEFT JOIN r USING (i);
