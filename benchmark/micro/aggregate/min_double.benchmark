# name: benchmark/micro/aggregate/min_double.benchmark
# description: MIN(d) over a DOUBLE column
# group: [aggregate]

name Double MIN (Ungrouped)
group aggregate

load
CREATE TABLE doubles AS SELECT i::DOUBLE + 0.5 AS d FROM range(0, 100000000) tbl(i);

run
SELECT MIN(d) FROM doubles

result I
0.5
