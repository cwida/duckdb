# name: benchmark/micro/update/upsert_enum_key.benchmark
# description: Many small INSERT ... SELECT ... ON CONFLICT statements into a table with a key of a large ENUM type
# group: [update]

load
CREATE TYPE big_enum AS ENUM (SELECT 'v' || i::VARCHAR FROM range(200000) r(i));
CREATE TABLE t (k big_enum PRIMARY KEY, v INTEGER);
INSERT INTO t SELECT ('v' || i::VARCHAR)::big_enum, 0 FROM range(1000) r(i);

run
INSERT INTO t SELECT k, 1 FROM t WHERE v = 0 LIMIT 1 ON CONFLICT DO UPDATE SET v = excluded.v;
INSERT INTO t SELECT k, 2 FROM t WHERE v = 0 LIMIT 1 ON CONFLICT DO UPDATE SET v = excluded.v;
INSERT INTO t SELECT k, 3 FROM t WHERE v = 0 LIMIT 1 ON CONFLICT DO UPDATE SET v = excluded.v;
INSERT INTO t SELECT k, 4 FROM t WHERE v = 0 LIMIT 1 ON CONFLICT DO UPDATE SET v = excluded.v;
INSERT INTO t SELECT k, 5 FROM t WHERE v = 0 LIMIT 1 ON CONFLICT DO UPDATE SET v = excluded.v;

cleanup
UPDATE t SET v = 0;

result_query I
SELECT count(*) FROM t WHERE v > 0
----
5
