# name: benchmark/micro/compression/string/string_filter_selective.benchmark
# description: Evaluate a pushed-down string predicate after a selective integer predicate
# group: [string]

name Filter Uncompressed Strings (0.1% input selectivity)
group string
storage persistent

load
CREATE TABLE string_values(k INTEGER USING COMPRESSION UNCOMPRESSED, s VARCHAR USING COMPRESSION UNCOMPRESSED);
INSERT INTO string_values SELECT (i%1000)::INTEGER, repeat('abcdefgh',16)||i::VARCHAR FROM range(2000000) r(i);

run
SELECT sum(length(s)) FROM string_values WHERE k<1 AND contains(s,'123');

result I
1619
