# name: benchmark/micro/optimizer/one_sided_distinct_count_sparse_keys.benchmark
# description: Repeated numeric Parquet keys over a sparse range joined to a selective native input
# group: [optimizer]

name One-Sided Distinct Count Sparse Keys
group micro
subgroup optimizer

load
CREATE TABLE f AS SELECT ((range % 50) * 2000)::BIGINT k, range::VARCHAR j FROM range(100000);
CREATE TABLE t AS SELECT ((range % 100000) * 10)::VARCHAR j FROM range(300000);
ANALYZE;
COPY (SELECT ((range % 50) * 2000)::BIGINT k FROM range(50000)) TO '${BENCHMARK_DIR}/sparse_keys.parquet' (FORMAT parquet);

run
SELECT count(*)
FROM f
JOIN read_parquet('${BENCHMARK_DIR}/sparse_keys.parquet') r USING(k)
JOIN t USING(j);

result I
30000000
