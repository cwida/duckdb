# name: benchmark/micro/optimizer/one_sided_distinct_count_join_sequence.benchmark
# description: Fact with few distinct date keys joined to a filtered date range and a second fact table
# group: [optimizer]

name One-Sided Distinct Count Join Sequence
group micro
subgroup optimizer

load
CREATE TABLE inv AS SELECT (i % 261) * 7 AS date_sk, (i // 261) % 100000 AS item_sk FROM range(10000000) t(i);
CREATE TABLE sales AS SELECT (i * 7919) % 100000 AS item_sk FROM range(5000000) t(i);

run
SELECT count(*)
FROM inv
JOIN (SELECT range AS k, range // 7 AS week FROM range(73049)) d ON inv.date_sk = d.k
JOIN sales s ON s.item_sk = inv.item_sk
WHERE d.week = 3;

result I
1915750
