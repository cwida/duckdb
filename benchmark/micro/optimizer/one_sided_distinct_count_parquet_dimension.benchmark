# name: benchmark/micro/optimizer/one_sided_distinct_count_parquet_dimension.benchmark
# description: Native date-key facts joined through a Parquet date dimension filtered on a string attribute
# group: [optimizer]

name One-Sided Distinct Count Parquet Dimension
group micro
subgroup optimizer

load
CREATE TABLE store_sales AS SELECT 2450816 + i // 5486 AS ss_sold_date_sk FROM range(10000000) t(i);
CREATE TABLE store_returns AS SELECT 2450820 + i // 9985 AS sr_returned_date_sk FROM range(20000000) t(i);
ANALYZE;
COPY (SELECT 2415022 + range AS d_date_sk, year(DATE '1900-01-02' + range::INTEGER)::VARCHAR AS d_year FROM range(73049)) TO '${BENCHMARK_DIR}/one_sided_distinct_count_date_dim.parquet' (FORMAT parquet);

run
SELECT count(*)
FROM store_returns
WHERE sr_returned_date_sk IN (
	SELECT ss_sold_date_sk
	FROM store_sales
	JOIN read_parquet('${BENCHMARK_DIR}/one_sided_distinct_count_date_dim.parquet') d ON store_sales.ss_sold_date_sk = d.d_date_sk
	WHERE d.d_year = '2000');

result I
3654510
