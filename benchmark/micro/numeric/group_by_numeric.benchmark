# name: benchmark/micro/numeric/group_by_numeric.benchmark
# description: NUMERIC vs native types: grouping on a 1000-value key over 10M rows of NUMERIC
# group: [numeric]

name group_by numeric
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER::NUMERIC AS a, ((i * 847892347987) % 1000)::INTEGER::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT b, count(*), sum(a) FROM t GROUP BY b ORDER BY b LIMIT 5
