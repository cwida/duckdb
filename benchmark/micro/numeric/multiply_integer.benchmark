# name: benchmark/micro/numeric/multiply_integer.benchmark
# description: NUMERIC vs native types: exact multiplication of two columns over 10M rows of INTEGER
# group: [numeric]

name multiply integer
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER AS a, ((i * 847892347987) % 1000)::INTEGER AS b FROM range(0, 10000000) tbl(i);

run
SELECT max(a * b), min(a * b) FROM t
