# name: benchmark/micro/numeric/sort_numeric_decimal.benchmark
# description: NUMERIC vs native types: ordering on both columns over 10M rows of NUMERIC
# group: [numeric]

name sort numeric_decimal
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT (((i * 9582398353) % 100000) / 100.0)::DECIMAL(10,2)::NUMERIC AS a, (((i * 847892347987) % 1000) / 100.0)::DECIMAL(10,2)::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT a, b FROM t ORDER BY a, b LIMIT 10
