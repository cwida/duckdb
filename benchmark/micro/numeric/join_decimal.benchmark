# name: benchmark/micro/numeric/join_decimal.benchmark
# description: NUMERIC vs native types: self join on both columns over 10M rows of DECIMAL(10,2)
# group: [numeric]

name join decimal
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT (((i * 9582398353) % 100000) / 100.0)::DECIMAL(10,2) AS a, (((i * 847892347987) % 1000) / 100.0)::DECIMAL(10,2) AS b FROM range(0, 10000000) tbl(i);

run
SELECT count(*) FROM t t1 JOIN t t2 ON t1.b = t2.b AND t1.a = t2.a WHERE t1.a < 100
