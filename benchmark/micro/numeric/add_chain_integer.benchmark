# name: benchmark/micro/numeric/add_chain_integer.benchmark
# description: NUMERIC vs native types: a chain of additions over 10M rows of INTEGER
# group: [numeric]

name add_chain integer
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER AS a, ((i * 847892347987) % 1000)::INTEGER AS b FROM range(0, 10000000) tbl(i);

run
SELECT max(a + b + a + b) FROM t
