# name: benchmark/micro/numeric/sum_numeric.benchmark
# description: NUMERIC vs native types: sum of two columns (scan + aggregate) over 10M rows of NUMERIC
# group: [numeric]

name sum numeric
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER::NUMERIC AS a, ((i * 847892347987) % 1000)::INTEGER::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT sum(a), sum(b) FROM t
