# name: benchmark/micro/numeric/filter_numeric.benchmark
# description: NUMERIC vs native types: count with two comparison filters over 10M rows of NUMERIC
# group: [numeric]

name filter numeric
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER::NUMERIC AS a, ((i * 847892347987) % 1000)::INTEGER::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT count(*) FROM t WHERE a > 50000 AND b < 500
