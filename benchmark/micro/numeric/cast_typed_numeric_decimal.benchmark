# name: benchmark/micro/numeric/cast_typed_numeric_decimal.benchmark
# description: NUMERIC vs native types: explicit cast of two columns to their representation, summed, over 10M rows of NUMERIC holding DECIMAL(10,2) values
# group: [numeric]

name cast_typed numeric_decimal
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT (((i * 9582398353) % 100000) / 100.0)::DECIMAL(10,2)::NUMERIC AS a, (((i * 847892347987) % 1000) / 100.0)::DECIMAL(10,2)::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT sum(a::DECIMAL(10,2)), sum(b::DECIMAL(10,2)) FROM t
