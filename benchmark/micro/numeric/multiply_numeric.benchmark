# name: benchmark/micro/numeric/multiply_numeric.benchmark
# description: NUMERIC vs native types: exact multiplication of two columns over 10M rows of NUMERIC
# group: [numeric]

name multiply numeric
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER::NUMERIC AS a, ((i * 847892347987) % 1000)::INTEGER::NUMERIC AS b FROM range(0, 10000000) tbl(i);

run
SELECT max(a * b), min(a * b) FROM t
