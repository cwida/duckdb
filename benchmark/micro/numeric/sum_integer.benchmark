# name: benchmark/micro/numeric/sum_integer.benchmark
# description: NUMERIC vs native types: sum of two columns (scan + aggregate) over 10M rows of INTEGER
# group: [numeric]

name sum integer
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT ((i * 9582398353) % 100000)::INTEGER AS a, ((i * 847892347987) % 1000)::INTEGER AS b FROM range(0, 10000000) tbl(i);

run
SELECT sum(a), sum(b) FROM t
