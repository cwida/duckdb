# name: benchmark/micro/numeric/add_chain_decimal.benchmark
# description: NUMERIC vs native types: a chain of additions over 10M rows of DECIMAL(10,2)
# group: [numeric]

name add_chain decimal
group micro
subgroup numeric

load
CREATE TABLE t AS SELECT (((i * 9582398353) % 100000) / 100.0)::DECIMAL(10,2) AS a, (((i * 847892347987) % 1000) / 100.0)::DECIMAL(10,2) AS b FROM range(0, 10000000) tbl(i);

run
SELECT max(a + b + a + b) FROM t
