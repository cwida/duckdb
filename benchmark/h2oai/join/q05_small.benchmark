# name: benchmark/h2oai/join/q05_small.benchmark
# description: Run the small query 05 from the H2OAI join benchmark
# group: [join]

template benchmark/h2oai/join/h2oai.benchmark.in
QUERY_NUMBER=5_small
QUERY_NUMBER_PADDED=05_small
