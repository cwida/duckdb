# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [ingestion]

name Q${table_name}
group ingestion
subgroup tpcds

require tpcds

require parquet

cache tpcds_sf1_ingest.duckdb

load benchmark/ingestion/load_tpcds.sql

# reads table from view created in load script
run
create table ${table_name}_ingested as select * from ${table_name}_${format} limit 500000;

cleanup
drop table ${table_name}_ingested;
