# name: benchmark/recursive_cte/fsm_match_arms.benchmark
# description: Simulate the FSM with one UNION ALL arm per state
# group: [recursive_cte]

name FSM row pattern matching, UNION ALL arms
group Recursive CTE

load benchmark/recursive_cte/load/performance/fsm_match.sql

run benchmark/recursive_cte/queries/performance/fsm_match_arms.sql

result benchmark/recursive_cte/answers/performance/fsm_match_arms.csv
