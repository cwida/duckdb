# name: benchmark/recursive_cte/vm_collatz_arms.benchmark
# description: Step a compiled register program with one UNION ALL arm per opcode
# group: [recursive_cte]

name Collatz register machine, UNION ALL arms
group Recursive CTE

load benchmark/recursive_cte/load/performance/vm_collatz.sql

run benchmark/recursive_cte/queries/performance/vm_collatz_arms.sql

result benchmark/recursive_cte/answers/performance/vm_collatz_arms.csv
