# name: benchmark/recursive_cte/gcd_batch_arms.benchmark
# description: Iterate Euclid's algorithm with one UNION ALL arm per program point
# group: [recursive_cte]

name GCD argument batch, UNION ALL arms
group Recursive CTE

load benchmark/recursive_cte/load/performance/gcd_batch.sql

run benchmark/recursive_cte/queries/performance/gcd_batch_arms.sql

result benchmark/recursive_cte/answers/performance/gcd_batch_arms.csv
