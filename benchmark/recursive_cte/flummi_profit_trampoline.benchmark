# name: benchmark/recursive_cte/flummi_profit_trampoline.benchmark
# description: Per-day profit scan loop from the flummi compiler PVLDB samples (samples/profit), trampoline formulation
# group: [recursive_cte]

name Flummi profit day loop, trampoline
group Recursive CTE

load benchmark/recursive_cte/load/performance/flummi_profit.sql

run benchmark/recursive_cte/queries/performance/flummi_profit_trampoline.sql

result benchmark/recursive_cte/answers/performance/flummi_profit_trampoline.csv
