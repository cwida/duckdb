# name: benchmark/csv/lineitem_quoted_count.benchmark
# description: Count the rows of lineitem written as CSV with every value quoted
# group: [csv]

template benchmark/csv/lineitem_csv.benchmark.in
name=Lineitem Quoted Count
variant=quoted
copy_options=FORMAT CSV, DELIMITER '|', HEADER false, FORCE_QUOTE *
newline=\n
query_start=SELECT count(*) FROM
query_end=;
result=6001215
