# name: benchmark/csv/lineitem_noquote_count.benchmark
# description: Count the rows of lineitem written as CSV, read with quotes disabled
# group: [csv]

name CSV Lineitem Count Without Quotes
group csv

require tpch

cache lineitem_sf1_plain.csv

load
CALL dbgen(sf=1);
COPY lineitem TO '${BENCHMARK_DIR}/lineitem_sf1_plain.csv' (FORMAT CSV, DELIMITER '|', HEADER false);

run
SELECT count(*) FROM read_csv('${BENCHMARK_DIR}/lineitem_sf1_plain.csv', delim='|', quote='', escape='', header=false, new_line='\n', auto_detect=false, columns={'l_orderkey':'BIGINT','l_partkey':'BIGINT','l_suppkey':'BIGINT','l_linenumber':'INTEGER','l_quantity':'DECIMAL(15,2)','l_extendedprice':'DECIMAL(15,2)','l_discount':'DECIMAL(15,2)','l_tax':'DECIMAL(15,2)','l_returnflag':'VARCHAR','l_linestatus':'VARCHAR','l_shipdate':'DATE','l_commitdate':'DATE','l_receiptdate':'DATE','l_shipinstruct':'VARCHAR','l_shipmode':'VARCHAR','l_comment':'VARCHAR'});

result I
6001215
