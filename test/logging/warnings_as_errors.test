# name: test/logging/warnings_as_errors.test
# description: Test warnings as errors setting
# group: [logging]

statement ok
SET warnings_as_errors = False;

# query producing warning
statement ok
SELECT write_log('test warning', level := 'warning');

statement error
SET warnings_as_errors = True;
----
Invalid Input Error: Cannot set 'warnings_as_errors=true'; no logger is available. To solve, run: 'SET enable_logging=true;'

statement ok
SET enable_logging=true;

statement ok
SET warnings_as_errors = True;

statement error
SELECT write_log('test warning', level := 'warning');
----
Invalid Input Error: test warning
