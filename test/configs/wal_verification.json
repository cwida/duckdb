{
  "description": "Run on persistent databases as storage with automatic checkpointing disabled to stress test the WAL.",
  "initial_db": "{TEST_DIR}/{BASE_TEST_NAME}__test__config__stress_test_wal.db",
  "force_restart": "true",
  "checkpoint_wal_size": "1000000000",
  "checkpoint_on_shutdown": "false",
  "skip_compiled": "true",
  "inherit_skip_tests": "test/configs/force_storage_restart.json",
  "skip_tests": [
    {
      "reason": "Loading from disk is necessary to trigger expected OOM.",
      "paths": [
        "test/sql/storage/constraints/foreignkey/foreign_key_persistent_memory_limit.test"
      ]
    },
    {
      "reason": "Checkpointing is necessary to trigger expected checkpoint error.",
      "paths": [
        "test/sql/storage/checkpoint/test_checkpoint_failure_delayed_commit.test",
        "test/sql/storage/checkpoint/test_checkpoint_failure_delayed_rollback.test",
        "test/sql/storage/checkpoint/test_checkpoint_failure_on_detach.test"
      ]
    },
    {
      "reason": "Autocheckpoint cannot be triggered: this config overrides checkpoint_wal_size and restarts between statements, resetting wal_autocheckpoint_entries.",
      "paths": [
        "test/sql/storage/checkpoint/initial_database_autocheckpoint_failure.test"
      ]
    },
    {
      "reason": "Empty WAL is necessary to trigger optimizer rule.",
      "paths": [
        "test/sql/topn/top_n_pruning.test",
        "test/optimizer/eager_aggregate_execution.test",
        "test/optimizer/partial_aggregate_precomputation.test"
      ]
    },
    {
      "reason": "Test explicitly checks WAL creation",
      "paths": [
        "test/sql/storage/wal/wal_lazy_creation.test"
      ]
    },
    {
      "reason": "Test explicitly checks the checkpoint on shutdown.",
      "paths": [
        "test/sql/index/art/storage/test_art_list_sort_checkpoint_on_close.test"
      ]
    },
    {
      "reason": "Test relies on checkpoint/vacuum ordering.",
      "paths": [
        "test/sql/storage/rowid_gaps/alter_preserves_rowid_gaps.test"
      ]
    },
    {
      "reason": "FIXME: Unexpected (?) binder error.",
      "paths": [
        "test/sql/alter/alter_type/test_alter_type.test",
        "test/sql/function/list/lambdas/arrow/table_functions_deprecated.test",
        "test/sql/function/list/lambdas/table_functions.test",
        "test/sql/function/list/test_lambda_with_struct_aliases.test",
        "test/sql/types/enum/test_alter_enum.test",
        "test/sql/types/enum/test_enum_structs.test"
      ]
    },
    {
      "reason": "FIXME: Wrong result in query.",
      "paths": [
        "test/sql/storage/update/nop_update_tpch.test_slow",
        "test/sql/storage/optimistic_write/optimistic_write.test_slow",
        "test/sql/index/art/storage/test_art_reclaim_storage_pk_fk.test_slow",
        "test/sql/index/art/memory/test_art_non_linear.test_slow",
        "test/sql/index/art/memory/test_art_varchar.test_slow"
      ]
    },
    {
      "reason": "FIXME: Internal Exception.",
      "paths": [
        "test/sql/alter/add_pk/test_add_pk_with_generated_column.test",
        "test/sql/storage/optimistic_write/optimistic_write_alter_type.test_slow"
      ]
    }
  ]
}
