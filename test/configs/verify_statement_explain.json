{
  "description": "Run with debug_verify_statement set to explain_statement - forcing statements to be explained",
  "on_init": "SET debug_verify_statement='explain_statement';",
  "skip_compiled": "true",
  "skip_tests": [
    {
      "reason": "Extra queries mess up logs",
      "paths": [
        "test/sql/pragma/test_query_log.test",
        "test/sql/cte/warn_deprecated_union_in_using_key.test",
        "test/sql/function/list/lambdas/arrow/warn_deprecated_arrow.test",
        "test/sql/logging/test_logging_function.test",
        "test/sql/logging/logging_buffer_size.test",
        "test/sql/logging/logging_types.test",
        "test/sql/logging/logging.test",
        "test/sql/logging/logging_context_ids.test",
        "test/sql/logging/logging_csv.test",
        "test/sql/logging/logging_file_truncate_rewrite.test"
      ]
    },
    {
      "reason": "Binding the explained statement evaluates its table function arguments a second time",
      "paths": [
        "test/issues/general/test_26175_bind_once.test"
      ]
    },
    {
      "reason": "Explain exceeds 300KB memory limit",
      "paths": [
        "test/issues/internal/test_5457.test"
      ]
    },
    {
      "reason": "Statement verification temporarily disables profiling for its internal EXPLAIN",
      "paths": [
        "test/sql/pragma/profiling/test_custom_profiling_using_groups.test",
        "test/sql/profiling/test_failed_query_profile.test"
      ]
    },
    {
      "reason": "Random errors",
      "paths": [
        "test/sql/pragma/test_pragma_sanitized_inputs.test",
        "test/sql/storage/wal/wal_autocheckpoint_entries.test",
        "test/sql/transactions/statement-preprocessor/multistatement_is_transactional.test",
        "test/sql/transactions/statement-preprocessor/multistatement_is_transactional_chained_PRAGMA.test",
        "test/sql/copy/csv/glob/read_csv_glob.test",
        "test/sql/copy/parquet/parquet_list.test",
        "test/sql/copy_database/copy_table_with_sequence.test",
        "test/sql/copy_database/copy_database_simple.test",
        "test/sql/copy_database/copy_database_errors.test"
      ]
    },
    {
      "reason": "Recipe callbacks run on an internal connection; under statement verification the statement is already inside a transaction, so that connection cannot start one.",
      "paths": [
        "test/sql/attach/external_resource_lifecycle.test",
        "test/sql/attach/attach_to_external_resource.test",
        "test/sql/attach/external_resource_logging.test"
      ]
    }
  ]
}
