				"test/sql/types/numeric/numeric_type.test",
				"test/sql/types/numeric/numeric_variant_arithmetic.test",
				"test/sql/types/numeric/numeric_variant_smoke.test",
				"test/sql/types/numeric/numeric_variant_storage_smoke.test",
