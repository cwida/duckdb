				"test/sql/types/decimal/wide_decimal_casts.test",
				"test/sql/types/decimal/wide_decimal_literals.test",
				"test/sql/types/decimal/wide_decimal_quantiles.test",
				"test/sql/types/decimal/wide_decimal_statistics.test",
				"test/sql/types/decimal/wide_decimal_review.test",
				"test/sql/types/decimal/wide_decimal_storage.test"
			]
		},
		{
			"reason": "Roundtrip is not possible (MAP type)",
			"paths": [
				"test/parquet/test_parquet_schema.test",
				"test/parquet/schema_nested_extract.test",
				"test/parquet/test_parquet_schema_null_nested.test",
				"test/parquet/schema_nested_evolution.test",
				"test/parquet/test_parquet_schema_incompatible_nested_types.test",
				"test/parquet/parquet_schema_renamed_struct_filter.test"
