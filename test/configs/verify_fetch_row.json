{
  "description": "Run on persistent databases as storage with row verification enabled.",
  "initial_db": "{TEST_DIR}/{BASE_TEST_NAME}__test__config__verify_fetch_row.db",
  "on_init": "SET debug_force_fetch_row=true;",
  "skip_compiled": "true",
  "inherit_skip_tests": "test/configs/force_storage.json",
  "skip_tests": [
    {
      "reason": "Behavior changes when forcing row fetches",
      "paths": [
        "test/sql/storage/compression/rle/rle_constant.test",
        "test/sql/storage/compression/fsst/fsst_corrupt_decoded_length.test",
        "test/sql/storage/compression/zstd/zstd_corrupt_count.test"
      ]
    },
    {
      "reason": "No stats",
      "paths": [
        "test/sql/types/geo/geometry_shred_types.test_slow",
        "test/sql/types/geo/geometry_shred_more.test"
      ]
    }
  ]
}
