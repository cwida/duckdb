{
  "description": "Run with the latest v1.x storage format on persistent databases.",
  "initial_db": "{TEST_DIR}/{BASE_TEST_NAME}__test__config__latest_storage.db",
  "on_load": "skip",
  "settings": [
    {
      "name": "storage_compatibility_version",
      "value": "v1.5.2"
    }
  ],
  "inherit_skip_tests": "test/configs/force_storage.json",
  "skip_compiled": "true",
  "skip_tests": [
    {
      "reason": "Explicit constraint check mode requires storage version v2.0.0 or higher.",
      "paths": [
        "test/optimizer/remove_redundant_order_keys_deferred.test"
      ]
    },
    {
      "reason": "The AT clause is only serialized with storage version v2.0.0 or higher.",
      "paths": [
        "test/sql/json/test_deserialize_at_clause.test"
      ]
    },
    {
      "reason": "Explicit constraint check mode requires storage version v2.0.0 or higher.",
      "paths": [
        "test/sql/constraints/deferred/test_alter_constraint_check_mode.test",
        "test/sql/constraints/deferred/test_deferred_alter.test",
        "test/sql/constraints/deferred/test_deferred_checkpoint.test_slow",
        "test/sql/constraints/deferred/test_deferred_compatibility.test",
        "test/sql/constraints/deferred/test_deferred_delete_reinsert.test",
        "test/sql/constraints/deferred/test_deferred_large.test_slow",
        "test/sql/constraints/deferred/test_deferred_metadata.test",
        "test/sql/constraints/deferred/test_deferred_statements.test",
        "test/sql/constraints/deferred/test_deferred_syntax.test",
        "test/sql/constraints/deferred/test_deferred_trigger.test",
        "test/sql/constraints/deferred/test_deferred_unique_pk.test",
        "test/sql/window/test_window_degenerate_frames.test",
        "test/optimizer/remove_redundant_order_keys.test"
      ]
    },
    {
      "reason": "Keyword-only arguments cannot be serialized to v1.x storage.",
      "paths": [
        "test/extension/test_function_args_kwargs.test"
      ]
    },
    {
      "reason": "TODO",
      "paths": [
        "test/extension/autoloading_types.test",
        "test/fuzzer/pedro/incomplete_checkpoint.test",
        "test/sql/storage/temp_directory/max_swap_space_error.test",
        "test/sql/attach/attach_icu_collation.test",
        "test/sql/json/test_json_serialize_sql.test",
        "test/sql/table_function/duckdb_databases.test",
        "test/sql/logging/file_system_logging_attach.test",
        "test/sql/logging/file_system_logging_attach_deadlock.test"
      ]
    },
    {
      "reason": "Attached databases have a main schema, which is not implicit.",
      "paths": [
        "test/fuzzer/sqlsmith/current_schemas_null.test"
      ]
    },
    {
      "reason": "CREATE SECURE VIEW requires v2.0.0 storage.",
      "paths": [
        "test/sql/catalog/view/secure_view.test",
        "test/sql/optimizer/secure_view_explain.test",
        "test/sql/optimizer/secure_view_pushdown.test",
        "test/sql/pragma/profiling/test_profiling_bytes_scanned_secure_view.test",
        "test/sql/optimizer/secure_view_statistics.test",
        "test/sql/sql_export/secure_view_sql_export.test",
        "test/sql/sql_export/secure_view_predicates.test",
        "test/sql/optimizer/secure_view_fallible_functions.test"
      ]
    },
    {
      "reason": "Stored aggregate-state and TUPLE columns require v2.0.0 storage.",
      "paths": [
        "test/sql/sql_export/empty_aggregate_state.test",
        "test/sql/sql_export/mark_condition_shapes.test",
        "test/sql/types/variant/variant_struct_field_subquery.test"
      ]
    }
  ]
}
