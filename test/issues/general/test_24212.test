UPDATE	2	21	42

statement ok
CREATE TABLE indexed(i INTEGER PRIMARY KEY, j INTEGER);

statement ok
INSERT INTO indexed VALUES (1, 10), (2, 20);

query III
MERGE INTO indexed
USING (VALUES (1)) s(i)
ON indexed.i = s.i
WHEN NOT MATCHED BY SOURCE THEN UPDATE SET i = indexed.i + 10
RETURNING merge_action, i, j;
