# name: test/fuzzer/sqlsmith/window-rows-overflow.test
# description: Overflow testing for rows offsets.
# group: [sqlsmith]

statement ok
create table all_types as
	select * exclude(
		small_enum,
		medium_enum,
		large_enum,
	)
from test_all_types();

query I
SELECT nth_value(1929, 42) OVER (
	PARTITION BY (
		"usmallint" > "smallint"
	), 747 ROWS BETWEEN GREATEST(COALESCE("bigint", 0), 0) PRECEDING AND CURRENT ROW
)
FROM all_types;
----
NULL
NULL
NULL

query I
SELECT nth_value(1929, 42) OVER (
	PARTITION BY (
		"usmallint" > "smallint"
	), 747 ROWS BETWEEN 1 PRECEDING AND GREATEST(COALESCE("bigint", 0), 0) PRECEDING
)
FROM all_types;
----
NULL
NULL
NULL

query I
SELECT nth_value(1929, 42) OVER (
	PARTITION BY (
		"usmallint" > "smallint"
	), 747 ROWS BETWEEN GREATEST(COALESCE("bigint", 0), 0) FOLLOWING AND 1 FOLLOWING
)
FROM all_types;
----
NULL
NULL
NULL

query I
SELECT nth_value(1929, 42) OVER (
	PARTITION BY (
		"usmallint" > "smallint"
	), 747 ROWS BETWEEN CURRENT ROW AND GREATEST(COALESCE("bigint", 0), 0) FOLLOWING
)
FROM all_types;
----
NULL
