# name: test/fuzzer/duckfuzz/duckdb_fuzzer_4430.test
# description: Regression test for DETACH while the current transaction has outstanding work on the database
# group: [duckfuzz]

statement ok
ATTACH '{TEST_DIR}/duckdb_fuzzer_4430.db' AS db1

# DETACH after a write to db1, then attach another file under the same name in the same transaction
statement ok
BEGIN

statement ok
CREATE TABLE db1.tbl(i INTEGER)

statement ok
DETACH db1

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/duckdb_fuzzer_4430_other.db' AS db1

# the transaction has already written to the detached database
statement error
CREATE TABLE db1.tbl2(i INTEGER)
----
a single transaction can only write to a single attached database

statement ok
ROLLBACK

# the rollback undoes the second ATTACH and the CREATE TABLE, not the DETACH
query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'db1'
----
0

statement ok
ATTACH '{TEST_DIR}/duckdb_fuzzer_4430.db' AS db1

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'db1'
----
0

# DETACH after a read from db1 in the same transaction
statement ok
CREATE TABLE db1.tbl(i INTEGER)

statement ok
BEGIN

query I
SELECT * FROM db1.tbl
----

statement ok
DETACH db1

statement ok
COMMIT

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'db1'
----
0
