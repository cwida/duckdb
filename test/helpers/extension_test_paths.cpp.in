string ExtensionTestConfigPath(const string &test_path) {
	static const vector<pair<string, string>> configs = {
@EXT_TEST_CONFIG_INITIALIZER@	};
	if (configs.empty()) {
		return string();
	}
	auto absolute_path = StringUtil::Replace(TestMakeAbsolute(test_path, TestGetCurrentDirectory()), "\\", "/");
	for (const auto &entry : configs) {
		auto prefix = StringUtil::Replace(entry.first, "\\", "/") + "/";
		if (StringUtil::StartsWith(absolute_path, prefix)) {
			return entry.second;
		}
	}
	return string();
}

} // namespace duckdb
