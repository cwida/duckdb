# name: test/optimizer/deliminator_nullability.test
# description: Preserve NULL semantics when removing duplicate-eliminated joins
# group: [optimizer]

statement ok
SET explain_output='optimized_only';

statement ok
CREATE TABLE nn(k INTEGER, wh INTEGER NOT NULL);

statement ok
INSERT INTO nn VALUES (1, 5), (3, 8);

statement ok
CREATE TABLE ids(id INTEGER NOT NULL);

statement ok
INSERT INTO ids VALUES (1), (2);

statement ok
CREATE TABLE ev(id INTEGER NOT NULL, wh INTEGER NOT NULL);

statement ok
INSERT INTO ev VALUES (1, 6), (2, 7), (3, 9);

statement ok
CREATE TABLE nested_outer(s STRUCT(x INTEGER, y INTEGER));

statement ok
INSERT INTO nested_outer VALUES ({'x': NULL, 'y': 1}), ({'x': 1, 'y': 2}), ({'x': 9, 'y': 9});

statement ok
CREATE TABLE nested_inner(s STRUCT(x INTEGER, y INTEGER));

statement ok
INSERT INTO nested_inner VALUES ({'x': NULL, 'y': 1}), ({'x': 1, 'y': 2});

statement ok
CREATE TABLE lateral_nested(a STRUCT(x INTEGER, y INTEGER), k INTEGER);

statement ok
INSERT INTO lateral_nested VALUES ({'x': 1, 'y': 2}, 1), ({'x': NULL, 'y': 1}, 2), (NULL, 3), ({'x': 5, 'y': 5}, 4);

foreach cte_mode true false

statement ok
SET delim_join_as_cte={cte_mode};

# A NOT NULL column on the nullable side of a LEFT join can still be NULL in the join output.
query IIT
SELECT ids.id, nn.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = ids.id
             AND nn.wh <> ev.wh
       )
FROM ids
LEFT JOIN nn ON ids.id = nn.k
ORDER BY ids.id;
----
1	5	true
2	NULL	false

# The same applies to the left input of a RIGHT join.
query IIT
SELECT ids.id, nn.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = ids.id
             AND nn.wh <> ev.wh
       )
FROM nn
RIGHT JOIN ids ON ids.id = nn.k
ORDER BY ids.id;
----
1	5	true
2	NULL	false

# A FULL join can introduce NULL into either input.
query IIITT
SELECT coalesce(ids.id, nn.k), ids.id, nn.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = coalesce(ids.id, nn.k)
             AND ids.id <> ev.wh
       ),
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = coalesce(ids.id, nn.k)
             AND nn.wh <> ev.wh
       )
FROM ids
FULL JOIN nn ON ids.id = nn.k
ORDER BY 1;
----
1	1	5	true	true
2	2	NULL	true	false
3	NULL	8	false	true

# A scalar subquery is planned as a SINGLE join whose right output is NULL when no row matches.
query IIT
SELECT ids.id, n.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = ids.id
             AND n.wh <> ev.wh
       )
FROM ids
LEFT JOIN LATERAL (
    SELECT (SELECT nn.wh FROM nn WHERE nn.k = ids.id) AS wh
) n ON true
ORDER BY ids.id;
----
1	5	true
2	NULL	false

# Materialized CTE references must retain nullability introduced inside their definitions.
query IIT
WITH outer_rows AS MATERIALIZED (
    SELECT ids.id, nn.wh
    FROM ids
    LEFT JOIN nn ON ids.id = nn.k
)
SELECT id, wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = outer_rows.id
             AND outer_rows.wh <> ev.wh
       )
FROM outer_rows
ORDER BY id;
----
1	5	true
2	NULL	false

# Recursive CTE output is conservatively nullable even when its seed reads a NOT NULL base column.
query IIT
WITH RECURSIVE outer_rows(id, wh, iteration) AS (
    SELECT ids.id, nn.wh, 0
    FROM ids
    LEFT JOIN nn ON ids.id = nn.k
    UNION ALL
    SELECT id, wh, iteration + 1
    FROM outer_rows
    WHERE iteration < 0
)
SELECT id, wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = outer_rows.id
             AND outer_rows.wh <> ev.wh
       )
FROM outer_rows
ORDER BY id;
----
1	5	true
2	NULL	false

# Explicit null rejection above an outer join still permits the null-safe MARK rewrite.
query II
EXPLAIN
SELECT ids.id, nn.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = ids.id
             AND nn.wh <> ev.wh
       )
FROM ids
LEFT JOIN nn ON ids.id = nn.k
WHERE nn.wh IS NOT NULL;
----
logical_opt	<REGEX>:.*Join Type: MARK.*wh IS DISTINCT FROM wh.*

# INNER joins do not introduce NULLs and retain the same optimization.
query II
EXPLAIN
SELECT ids.id, nn.wh,
       EXISTS (
           SELECT 1
           FROM ev
           WHERE ev.id = ids.id
             AND nn.wh <> ev.wh
       )
FROM ids
JOIN nn ON ids.id = nn.k;
----
logical_opt	<REGEX>:.*Join Type: MARK.*wh IS DISTINCT FROM wh.*

# Nested equality follows PostgreSQL composite semantics: NULL children compare equal.
# Delimiter join elimination must preserve those semantics.
query I
SELECT count(*) FROM nested_outer
WHERE EXISTS (SELECT 1 FROM nested_inner WHERE nested_inner.s = nested_outer.s);
----
2

query I
SELECT count(*) FROM nested_outer
WHERE NOT EXISTS (SELECT 1 FROM nested_inner WHERE nested_inner.s = nested_outer.s);
----
1

# Null-safe nested equality has the same child-NULL semantics.
query I
SELECT count(*) FROM nested_outer
WHERE EXISTS (
    SELECT 1 FROM nested_inner
    WHERE nested_inner.s IS NOT DISTINCT FROM nested_outer.s
);
----
2

query I
SELECT count(*) FROM nested_outer
WHERE NOT EXISTS (
    SELECT 1 FROM nested_inner
    WHERE nested_inner.s IS NOT DISTINCT FROM nested_outer.s
);
----
1

# The same child-NULL semantics apply to LIST values.
query I
SELECT count(*) FROM (VALUES ([NULL]::INTEGER[]), ([1]), ([2])) nested_list_outer(v)
WHERE EXISTS (
    SELECT 1 FROM (VALUES ([NULL]::INTEGER[]), ([1])) nested_list_inner(v)
    WHERE nested_list_inner.v = nested_list_outer.v
);
----
2

query I
SELECT count(*) FROM (VALUES ([NULL]::INTEGER[]), ([1]), ([2])) nested_list_outer(v)
WHERE NOT EXISTS (
    SELECT 1 FROM (VALUES ([NULL]::INTEGER[]), ([1])) nested_list_inner(v)
    WHERE nested_list_inner.v = nested_list_outer.v
);
----
1

# Generated-domain cleanup also eliminates joins on nested correlation columns.
# LATERAL decorrelation routes through RemoveGeneratedDedupJoin, whose rewritten
# equality must retain PostgreSQL nested comparison semantics.
query ITT
SELECT k, a, b FROM lateral_nested, LATERAL (SELECT lateral_nested.a) t2(b) ORDER BY k;
----
1	{'x': 1, 'y': 2}	{'x': 1, 'y': 2}
2	{'x': NULL, 'y': 1}	{'x': NULL, 'y': 1}
3	NULL	NULL
4	{'x': 5, 'y': 5}	{'x': 5, 'y': 5}

# Regular equality accepts equal child-NULL values but still rejects top-level NULL.
query IT
SELECT k, b FROM lateral_nested, LATERAL (SELECT lateral_nested.a) t2(b) WHERE b = b ORDER BY k;
----
1	{'x': 1, 'y': 2}
2	{'x': NULL, 'y': 1}
4	{'x': 5, 'y': 5}

endloop
