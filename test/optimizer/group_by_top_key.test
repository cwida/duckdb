# 19. a prepared statement executed twice: the boundary is rebuilt per execution (a stale boundary from the first
# run would drop every row of the second once the small keys are gone)
statement ok
CREATE TABLE p(k INTEGER, v INTEGER);

statement ok
INSERT INTO p SELECT i % 10, i FROM range(1000) r(i);

statement ok
PREPARE q AS SELECT k, count(*), sum(v) FROM p GROUP BY k ORDER BY k LIMIT 3

query III
EXECUTE q
----
0	100	49500
1	100	49600
2	100	49700

statement ok
DELETE FROM p WHERE k < 5

query III
EXECUTE q
----
5	100	50000
6	100	50100
7	100	50200

statement ok
INSERT INTO p SELECT i % 3, i FROM range(30) r(i);

query III
EXECUTE q
----
0	10	135
1	10	145
2	10	155

# 20. a recursive CTE whose recursive member holds the rewritten shape: every iteration starts from a fresh boundary
query III
WITH RECURSIVE r(lvl, k, c) AS (
	(SELECT 0, k1, count(*) FROM t WHERE k1 >= 0 GROUP BY k1 ORDER BY k1 LIMIT 2)
	UNION ALL
	(SELECT max(l) + 1, k1, count(*) FROM t, (SELECT max(k) m, max(lvl) l FROM r) WHERE k1 > m AND l < 3 GROUP BY k1 ORDER BY k1 LIMIT 2)
)
SELECT * FROM r ORDER BY ALL
----
0	0	4
0	1	5
1	2	5
1	3	5
2	4	5
2	5	5
3	6	5
3	7	5

query II
EXPLAIN WITH RECURSIVE r(lvl, k, c) AS (
	(SELECT 0, k1, count(*) FROM t WHERE k1 >= 0 GROUP BY k1 ORDER BY k1 LIMIT 2)
	UNION ALL
	(SELECT max(l) + 1, k1, count(*) FROM t, (SELECT max(k) m, max(lvl) l FROM r) WHERE k1 > m AND l < 3 GROUP BY k1 ORDER BY k1 LIMIT 2)
)
SELECT * FROM r ORDER BY ALL
----
physical_plan	<REGEX>:.*Top Key Filter.*

# 21. the rule can be disabled on its own
statement ok
SET disabled_optimizers = 'group_by_top_key'

query II
EXPLAIN SELECT k1, count(*), sum(v) FROM t GROUP BY k1 ORDER BY k1 LIMIT 3
----
physical_plan	<!REGEX>:.*Top Key Filter.*

query III
SELECT k1, count(*), sum(v) FROM t GROUP BY k1 ORDER BY k1 LIMIT 3
----
0	4	10000
1	5	14865
2	5	14730

statement ok
SET disabled_optimizers = ''

# 22. EXPLAIN ANALYZE renders the operator
query II
EXPLAIN ANALYZE SELECT k1, count(*), sum(v) FROM t GROUP BY k1 ORDER BY k1 LIMIT 3
----
analyzed_plan	<REGEX>:.*Top Key Filter.*

# the rule disabled again: no filter
statement ok
SET disabled_optimizers = 'group_by_top_key';

query II
EXPLAIN SELECT k1, count(*), sum(v) FROM t GROUP BY k1 ORDER BY k1 LIMIT 3
----
physical_plan	<!REGEX>:.*Top Key Filter.*

# the filter keeps the order of the rows that pass (several keys: the rows are selected key by key): an aggregate
# that depends on the order of its input returns the same lists with one thread
statement ok
CREATE TABLE ordered AS SELECT (i % 50)::INTEGER AS a, (i % 7)::INTEGER AS b, i AS v FROM range(100000) r(i);

statement ok
SET threads = 1;

foreach disabled 'group_by_top_key' ''

statement ok
SET disabled_optimizers = {disabled};

query IIII nosort ordered_lists
SELECT a, b, list(v)[:5], first(v) FROM ordered GROUP BY a, b ORDER BY a, b LIMIT 4
----

query III nosort ordered_lists_desc
SELECT a, b, list(v)[-3:] FROM ordered GROUP BY a, b ORDER BY a DESC, b LIMIT 4
----

endloop

# a limit that covers a large part of the keys: the scans get no dynamic filter, and a thread that still passes too
# many rows after its warm-up stops filtering (100 keys, 6000 rows each; 50 and 90 of them are returned)
statement ok
CREATE TABLE few_keys AS SELECT (hash(i) % 100)::INTEGER AS k, i % 10 AS v FROM range(600000) r(i);

foreach disabled 'group_by_top_key' ''

statement ok
SET disabled_optimizers = {disabled};

foreach threads 1 4

statement ok
SET threads = {threads};

query III nosort few_keys_50
SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 50
----

query III nosort few_keys_90
SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k DESC LIMIT 90
----

query III nosort few_keys_all
SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 100
----

query III nosort few_keys_more
SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 200
----

query III nosort few_keys_5
SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 5
----

endloop

endloop

statement ok
SET disabled_optimizers = '';

# 50 of 100 keys: no dynamic filter of the top-key filter; 5 of 100 keys: with a dynamic filter
query II
EXPLAIN SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 50
----
physical_plan	<REGEX>:.*Top Key Filter.*

query II
EXPLAIN SELECT k, count(*), sum(v) FROM few_keys GROUP BY k ORDER BY k LIMIT 50
----
