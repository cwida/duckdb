logical_opt	<REGEX>:.*col1 < 5.*

query II
EXPLAIN SELECT * FROM (VALUES(5,5)) tbl(col0, col1) WHERE col0<=5 AND col1 <= col0
----
logical_opt	<REGEX>:.*col1 <= 5.*

### constant comparison [=, <, <=] followed by j < i #########################
query II
EXPLAIN SELECT * FROM (VALUES(5,5)) tbl(col0, col1) WHERE col0=5 AND col1 < col0
----
logical_opt	<REGEX>:.*col1 < 5.*

query II
EXPLAIN SELECT * FROM (VALUES(5,5)) tbl(col0, col1) WHERE col0<5 AND col1 < col0
----
logical_opt	<REGEX>:.*col1 < 5.*

query II
EXPLAIN SELECT * FROM (VALUES(5,5)) tbl(col0, col1) WHERE col0<=5 AND col1 < col0
----
logical_opt	<REGEX>:.*col1 < 5.*

