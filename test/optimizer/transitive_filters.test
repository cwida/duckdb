# Check unsatisfiable pruning
query II
EXPLAIN SELECT * FROM (VALUES(1),(2),(3)) tbl(a) WHERE a > 1 AND NOT (a > 1);
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query II
EXPLAIN SELECT * FROM (VALUES(1),(2),(3)) tbl(a) WHERE a > 1 AND a <= 1;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query II
EXPLAIN SELECT * FROM (VALUES(1),(2),(3)) tbl(a) WHERE a >= 2 AND a < 2;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query II
EXPLAIN SELECT * FROM (VALUES(1),(2),(3)) tbl(a) WHERE a <= 2 AND a >= 2;
----
logical_opt	<!REGEX>:.*EMPTY_RESULT.*


### Complex transitive filters #################################################

# Infer both bounds across the join, irrespective of the rendered child order.
query II
EXPLAIN SELECT * FROM (VALUES(5000,5000)) tbl1(i,j), (VALUES(NULL, NULL, 5000, 5000)) tbl2(A, B, k,l) WHERE i>4999 AND j<=l AND k>=i AND l<5001;
----
logical_opt	<REGEX>:.*(j < 5001.*k > 4999|k > 4999.*j < 5001).*

# Propagate the lower bound through a chain.
query II
EXPLAIN SELECT * FROM (VALUES(5000,5000)) tbl1(i,j), (VALUES(NULL, NULL, 5000, 5000)) tbl2(A, B, k,l) WHERE i>4999 AND j>=i AND k>=j;
----
logical_opt	<REGEX>:.*(j > 4999.*k > 4999|k > 4999.*j > 4999).*

# Reordering the comparisons must still infer both bounds.
query II
EXPLAIN SELECT * FROM (VALUES(5000,5000)) tbl1(i,j), (VALUES(NULL, NULL, 5000, 5000)) tbl2(A, B, k,l) WHERE i>4999 AND k>=j AND j>=i;
----
logical_opt	<REGEX>:.*(j > 4999.*k > 4999|k > 4999.*j > 4999).*

# Carry the lower bound to both columns on the other side of the join.
query II
EXPLAIN SELECT * FROM (VALUES(5000,5000)) tbl1(i,j), (VALUES(NULL, NULL, 5000, 5000)) tbl2(A, B, k,l) WHERE i>4999 AND k>=j AND j>=i AND l>=k;
----
logical_opt	<REGEX>:.*(k > 4999.*l > 4999|l > 4999.*k > 4999).*

# Upper bounds propagate in the same way.
query II
EXPLAIN SELECT * FROM (VALUES(5000,5000)) tbl1(i,j), (VALUES(NULL, NULL, 5000, 5000)) tbl2(A, B, k,l) WHERE i<4999 AND k<=j AND j<=i AND l<=k;
----
logical_opt	<REGEX>:.*(k < 4999.*l < 4999|l < 4999.*k < 4999).*

# A column is not mirrored onto itself, which would duplicate the filter.
query II
EXPLAIN SELECT * FROM (VALUES(2)) tbl(i) WHERE i < 1 AND abs(i) = 1;
----
logical_opt	<!REGEX>:.*abs\(i\) = 1.*abs\(i\) = 1.*
