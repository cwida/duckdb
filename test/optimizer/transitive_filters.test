logical_opt	<REGEX>:.*col1 <= 5.*

### j < i followed by constant comparison [=, <, <=]  #########################
query II
EXPLAIN SELECT * FROM (VALUES(5,5)) tbl(col0, col1) WHERE col1 < col0 AND col0=5
----
logical_opt	<REGEX>:.*col1 < 5.*

query II
