# name: test/optimizer/joins/filter_selectivity_sampling.test
# description: Estimate filter selectivity on a row sample of the scanned table
# group: [joins]

statement ok
CREATE TABLE t AS SELECT i, i % 50 AS q, 'v' || (i % 1000) AS s, {'a': i % 10} AS st FROM range(100000) r(i);

statement ok
CREATE TABLE u AS SELECT i AS k FROM range(1000) r(i);

statement ok
SET explain_output = 'optimized_only';

statement ok
SET filter_selectivity_sample_size = 0;

# without sampling, a range filter gets the default selectivity of 0.2
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE i > 99990;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"20000".*

statement ok
SET filter_selectivity_sample_size = 2048;

# 9 of 100000 rows qualify: no sampled row does, so the estimate assumes half a sampled row
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE i > 99990;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"24".*

# 2000 rows qualify
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE q = 7;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"(1[5-9]|2[0-4])[0-9]{2}".*

# the conjunction is evaluated on the same sampled rows, so its correlation is taken into account
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE i > 99990 AND q = 7;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"24".*

# 1900 rows qualify
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE s LIKE '%99%';
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"(1[4-9]|2[0-4])[0-9]{2}".*

# a filter over several columns stays above the scan, and is sampled as well: 33 rows qualify
query II
EXPLAIN (FORMAT JSON) SELECT count(*) FROM t JOIN u ON t.q = u.k WHERE i + q > 99990;
----
logical_opt	<REGEX>:.*"Expressions":\s*"\(\(i \+ q\) > 99990\)",\s*"Estimated Cardinality":\s*"[0-9]{1,3}".*

# 2009 rows qualify
query II
EXPLAIN (FORMAT JSON) SELECT count(*) FROM t JOIN u ON t.q = u.k WHERE i > 99990 OR q = 7;
----
logical_opt	<REGEX>:.*"Expressions":\s*"\(\(i > 99990\) OR \(q = 7\)\)",\s*"Estimated Cardinality":\s*"(1[5-9]|2[0-4])[0-9]{2}".*

# a table spanning several row groups is sampled in runs of consecutive rows: 10000 rows qualify
statement ok
CREATE TABLE big AS SELECT i, i % 100 AS m FROM range(1000000) r(i);

query II
EXPLAIN (FORMAT JSON) SELECT * FROM big WHERE m = 7;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.big",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"([5-9][0-9]{3}|1[0-9]{4})".*

query I
SELECT count(*) FROM big WHERE m = 7;
----
10000

# sampling does not change results
query IIIII
SELECT count(*) FILTER (WHERE i > 99990), count(*) FILTER (WHERE q = 7), count(*) FILTER (WHERE i > 99990 AND q = 7),
       count(*) FILTER (WHERE s LIKE '%99%'), count(*) FILTER (WHERE st.a = 3) FROM t;
----
9	2000	0	1900	10000

query I
SELECT count(*) FROM t JOIN u ON t.q = u.k WHERE i + q > 99990;
----
33

query I
SELECT count(*) FROM t WHERE st.a = 3 AND q = 3;
----
2000

# a filter that fails on sampled rows falls back to the default selectivity instead of failing the query
query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE CAST(s AS INTEGER) > 0;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"20000".*

statement error
SELECT * FROM t WHERE CAST(s AS INTEGER) > 0;
----
Conversion Error

# filters on table functions without a sample keep the default selectivity
query II
EXPLAIN (FORMAT JSON) SELECT * FROM range(100000) r(i) WHERE i > 99990;
----
logical_opt	<REGEX>:.*"Estimated Cardinality":\s*"20000".*

query I
SELECT count(*) FROM range(100000) r(i) WHERE i > 99990;
----
9

# prepared statements
statement ok
PREPARE p AS SELECT count(*) FROM t WHERE i > $1;

query I
EXECUTE p(99990);
----
9

# rows that are deleted or only exist in the transaction are not sampled
statement ok
CREATE TABLE empty_t AS SELECT * FROM t LIMIT 0;

query I
SELECT count(*) FROM empty_t JOIN u ON empty_t.q = u.k WHERE i > 5;
----
0

statement ok
CREATE TABLE deleted_t AS SELECT * FROM t;

statement ok
DELETE FROM deleted_t;

query I
SELECT count(*) FROM deleted_t JOIN u ON deleted_t.q = u.k WHERE i > 5;
----
0

statement ok
BEGIN;

statement ok
INSERT INTO empty_t SELECT * FROM t WHERE i < 100;

query I
SELECT count(*) FROM empty_t JOIN u ON empty_t.q = u.k WHERE i > 5;
----
94

statement ok
ROLLBACK;

# an inner join divides by the largest current (filtered) domain of its keys instead of the total domain:
# the filter keeps the 1000 dim keys the fact table references, so all 100000 fact rows join
statement ok
CREATE TABLE fact AS SELECT i % 1000 AS fk FROM range(100000) r(i);

statement ok
CREATE TABLE dim AS SELECT i AS dk, i // 1000 AS grp FROM range(10000) r(i);

query II
EXPLAIN (FORMAT JSON) SELECT count(*) FROM fact JOIN dim ON fk = dk WHERE grp = 0;
----
logical_opt	<REGEX>:.*"Conditions":\s*"\(fk = dk\)",\s*"Estimated Cardinality":\s*"([5-9][0-9]{4}|1[0-9]{5})".*

query I
SELECT count(*) FROM fact JOIN dim ON fk = dk WHERE grp = 0;
----
100000

statement ok
SET filter_selectivity_sample_size = 0;

query II
EXPLAIN (FORMAT JSON) SELECT * FROM t WHERE i > 99990;
----
logical_opt	<REGEX>:.*"Table":\s*"memory.main.t",\s*"Type":\s*"Sequential Scan",\s*"Estimated Cardinality":\s*"20000".*

# without sampling, the join divides by the total domain of 10000 dim keys
query II
EXPLAIN (FORMAT JSON) SELECT count(*) FROM fact JOIN dim ON fk = dk WHERE grp = 0;
----
logical_opt	<REGEX>:.*"Conditions":\s*"\(fk = dk\)",\s*"Estimated Cardinality":\s*"([5-9][0-9]{3}|1[0-9]{4})".*
