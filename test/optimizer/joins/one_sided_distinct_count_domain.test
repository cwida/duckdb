# name: test/optimizer/joins/one_sided_distinct_count_domain.test
# description: A foreign key's distinct count does not shrink the join domain below a key without a distinct count
# group: [joins]

require parquet

# estimates depend on sampled distinct counts
require vector_size 2048

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# od_fact: 100K rows, 50 distinct keys (HLL) in [0, 1000); joined to a 1000-key dimension it gives 100K rows.

statement ok
CREATE TABLE od_fact AS SELECT ((range % 50) * 20)::BIGINT k FROM range(100000);

statement ok
CREATE TABLE od_dim AS SELECT range::BIGINT k FROM range(1000);

statement ok
COPY (SELECT k, k // 50 AS g FROM od_dim) TO '{TEST_DIR}/od_dim.parquet' (FORMAT parquet);

statement ok
COPY (SELECT (range % 1000)::BIGINT k FROM range(50000)) TO '{TEST_DIR}/od_fk.csv' (HEADER);

# A dimension key without statistics: the domain is its 1000 rows, not the fact's 50, which estimates ~2M.

query II
EXPLAIN SELECT * FROM od_fact JOIN range(1000) d(k) ON od_fact.k = d.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~100.000 rows.*

# The dimension key has only a min/max span (Parquet footer): the same holds.

query II
EXPLAIN SELECT * FROM od_fact JOIN read_parquet('{TEST_DIR}/od_dim.parquet') d ON od_fact.k = d.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~100.000 rows.*

# A reliable key side (od_dim, 1000 rows) blocks the raise to the CSV's 50K rows: ~3.9M (exact count 5M), as on main.

query II
EXPLAIN SELECT *
FROM od_fact
JOIN od_dim ON od_fact.k = od_dim.k
JOIN read_csv('{TEST_DIR}/od_fk.csv', columns = {'k': 'BIGINT'}) f ON f.k = od_dim.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[1-9].[0-9]{3}.[0-9]{3} rows.*

# Two key columns without statistics: the smaller row count is the domain: ~3.9M (exact count 5M).

query II
EXPLAIN SELECT *
FROM od_fact
JOIN range(1000) d(k) ON od_fact.k = d.k
JOIN read_csv('{TEST_DIR}/od_fk.csv', columns = {'k': 'BIGINT'}) f ON f.k = d.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[1-9].[0-9]{3}.[0-9]{3} rows.*

# A computed column is not a key: the domain stays the fact's 50, ~2M (the exact count) as on main, also over a span.

query II
EXPLAIN SELECT * FROM od_fact JOIN (SELECT ((range % 50) * 20)::BIGINT k FROM range(1000)) l ON od_fact.k = l.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[12].[0-9]{3}.[0-9]{3} rows.*

query II
EXPLAIN SELECT * FROM od_fact JOIN (SELECT (k % 50) * 20 AS k FROM read_parquet('{TEST_DIR}/od_dim.parquet')) l ON od_fact.k = l.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[12].[0-9]{3}.[0-9]{3} rows.*

# Nor is a union with a computed branch: ~2M (the exact count) as on main.

query II
EXPLAIN SELECT * FROM od_fact JOIN (SELECT range k FROM range(0) UNION ALL SELECT ((range % 50) * 20)::BIGINT FROM range(1000)) l ON od_fact.k = l.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[12].[0-9]{3}.[0-9]{3} rows.*

query II
EXPLAIN SELECT * FROM od_fact JOIN (SELECT k FROM read_parquet('{TEST_DIR}/od_dim.parquet') WHERE false UNION ALL SELECT (k % 50) * 20 FROM read_parquet('{TEST_DIR}/od_dim.parquet')) l ON od_fact.k = l.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[12].[0-9]{3}.[0-9]{3} rows.*

# Neither are the first rows of a LIMIT: the domain stays the fact's 50, ~20K (the exact count) as on main.

query II
EXPLAIN SELECT * FROM od_fact JOIN (SELECT range k FROM range(0, 20000, 20) LIMIT 10) l ON od_fact.k = l.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[12][0-9].[0-9]{3} rows.*

# The dimension's span of 1000 (~5K) is capped at the 50 rows g = 0 keeps: ~100K (the exact count; main ~111K).

statement ok
CREATE TABLE od_recent AS SELECT (range % 50)::BIGINT k FROM range(100000);

query II
EXPLAIN SELECT * FROM od_recent JOIN read_parquet('{TEST_DIR}/od_dim.parquet') d ON od_recent.k = d.k WHERE d.g = 0;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~10[0-9].[0-9]{3} rows.*

# An equality filter bound on the class wins over a span the filtered rows still cover: ~1.96M as on main, not ~19.6K.

statement ok
COPY (SELECT (range % 100)::BIGINT k FROM range(100000)) TO '{TEST_DIR}/od_fk.parquet' (FORMAT parquet);

query II
EXPLAIN SELECT * FROM od_fact JOIN read_parquet('{TEST_DIR}/od_fk.parquet') d ON od_fact.k = d.k WHERE d.k = 20;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~1.9[0-9]{2}.[0-9]{3} rows.*

# Trade-off: a side without a distinct count or span that is not a key (here 50K rows on the fact's 50 keys) is
# taken as one. The estimate is ~100K, where the exact count is 100M (main ~76M).

statement ok
COPY (SELECT ((range % 50) * 20)::BIGINT k FROM range(50000)) TO '{TEST_DIR}/od_lowndv.csv' (HEADER);

query II
EXPLAIN SELECT * FROM od_fact JOIN read_csv('{TEST_DIR}/od_lowndv.csv', columns = {'k': 'BIGINT'}) f ON od_fact.k = f.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~100.000 rows.*

# The same for a Parquet VARCHAR column: statistics, but no span. ~100K, where the exact count is 100M (main ~106M).

statement ok
CREATE TABLE od_sfact AS SELECT k::VARCHAR k FROM od_fact;

statement ok
COPY (SELECT ((range % 50) * 20)::VARCHAR k FROM range(50000)) TO '{TEST_DIR}/od_lowndv.parquet' (FORMAT parquet);

query II
EXPLAIN SELECT * FROM od_sfact JOIN read_parquet('{TEST_DIR}/od_lowndv.parquet') f ON od_sfact.k = f.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~100.000 rows.*

# Stated trade-off: the raise applies to the whole key class, so two facts joined through a key without statistics are
# under-estimated (od_fact2: 10K rows on the same 50 keys). ~1M, where the exact count is 20M (main ~384M).

statement ok
CREATE TABLE od_fact2 AS SELECT ((range % 50) * 20)::BIGINT k FROM range(10000);

query II
EXPLAIN SELECT * FROM od_fact JOIN range(1000) d(k) ON od_fact.k = d.k JOIN od_fact2 ON od_fact2.k = od_fact.k;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~1.000.000 rows.*
