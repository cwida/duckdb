# name: test/optimizer/joins/aggregate_key_join_ce.test
# description: A join whose equalities cover all groups of an aggregate matches at most one row of that aggregate
# group: [joins]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

require vector_size 2048

statement ok
set disabled_optimizers='statistics_propagation';

# 500K rows, 250K (x, y) combinations, 500 values per column: an aggregate on (x, y) has far more rows than
# either column has values, so the FK/PK heuristic does not accept its row count as a composite-key cap
statement ok
create table t as
select (i % 500)::integer x, ((i // 500) % 500)::integer y, (i % 7)::integer a, (i % 11)::integer b, (i % 13)::integer c
from range(500000) r(i);

statement ok
create table f as select (i % 500)::integer x, ((i // 500) % 500)::integer y, i v from range(1000000) r(i);

# two-sided key: two aggregates joined on all of their groups, at most one row per group of the smaller side
query II
explain select * from
	(select x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~1[0-9]{2},[0-9]{3} rows.*

query I
select count(*) from
	(select x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
142858

# a filter above the aggregate keeps the key
query II
explain select * from
	(select x, y, sum(a) s from t group by x, y having sum(a) >= 0) g1
	join (select x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[0-9]{2},[0-9]{3} rows.*

# one-sided key: the projection of g2 replaces a group by an expression, the key of g1 bounds the join by the rows of g2
query II
explain select * from
	(select x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x % 1000 as x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~2[0-9]{2},[0-9]{3} rows.*

query I
select count(*) from
	(select x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x % 1000 as x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
142858

# no key: both projections replace a group by an expression, the estimate falls back to the general formula
query II
explain select * from
	(select x % 1000 as x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x % 1000 as x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[0-9]{2},[0-9]{3},[0-9]{3} rows.*

query I
select count(*) from
	(select x % 1000 as x, y, sum(a) s from t where a < 2 group by x, y) g1
	join (select x % 1000 as x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y = g2.y;
----
142858

# a table joined to an aggregate on all of the aggregate's groups: at most one match per row of the table
query II
explain select * from f join (select x, y, sum(a) s from t group by x, y) g on f.x = g.x and f.y = g.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~1,000,000 rows.*

query I
select count(*) from f join (select x, y, sum(a) s from t group by x, y) g on f.x = g.x and f.y = g.y;
----
1000000

# several DISTINCT aggregates over one grouped input are rewritten to one aggregate per DISTINCT argument,
# joined on the groups: no operator of that plan is estimated at 1M rows or more
query II
explain select x, y, count(distinct a), count(distinct b), count(distinct c) from t group by x, y;
----
physical_plan	<REGEX>:.*HASH_JOIN.*HASH_JOIN.*

query II
explain select x, y, count(distinct a), count(distinct b), count(distinct c) from t group by x, y;
----
physical_plan	<!REGEX>:.*~[0-9]{1,3},[0-9]{3},[0-9]{3}[ ,].*

query I
select count(*) from (select x, y, count(distinct a), count(distinct b), count(distinct c) from t group by x, y);
----
250000

# equalities that cover only a part of the groups say nothing about uniqueness: every (x, y) has two rows on
# both sides, the estimate must not drop below the 1M rows of the result
query II
explain select * from
	(select x, y, a, count(*) n from t group by x, y, a) g1
	join (select x, y, b, count(*) n from t group by x, y, b) g2 on g1.x = g2.x and g1.y = g2.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[0-9,]{9,} rows.*

query I
select count(*) from
	(select x, y, a, count(*) n from t group by x, y, a) g1
	join (select x, y, b, count(*) n from t group by x, y, b) g2 on g1.x = g2.x and g1.y = g2.y;
----
1000000

# an expression over a group is not the group: 50 rows of g2 match every row of g1
query II
explain select * from
	(select x, y, sum(a) s from t group by x, y) g1
	join (select x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y % 10 = g2.y % 10;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[0-9,]{10,} rows.*

query I
select count(*) from
	(select x, y, sum(a) s from t group by x, y) g1
	join (select x, y, max(b) m from t group by x, y) g2 on g1.x = g2.x and g1.y % 10 = g2.y % 10;
----
12500000

# the fact-to-fact guard of the composite-key cap still holds when neither side has a key
statement ok
create table ff_a as select (range % 1000)::integer x, (range % 1000)::integer y from range(100000);

statement ok
create table ff_b as select (range % 1000)::integer x, (range % 1000)::integer y from range(100000);

query II
explain select count(*) from ff_a join ff_b on ff_a.x = ff_b.x and ff_a.y = ff_b.y;
----
physical_plan	<REGEX>:.*HASH_JOIN[^~]*~[1-9],[0-9]{3},[0-9]{3} rows.*
