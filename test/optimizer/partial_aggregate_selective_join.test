# name: test/optimizer/partial_aggregate_selective_join.test
# description: Partial aggregation must save work before a selective join
# group: [optimizer]

statement ok
CREATE TABLE facts AS SELECT i % 1000 AS k, i % 13 AS v FROM range(100000) r(i);

statement ok
CREATE TABLE dim AS SELECT i AS k, i % 17 AS w, i % 100 = 0 AS keep FROM range(1000) r(i);

statement ok
ANALYZE;

query III
SELECT count(*), sum(v), sum(w) FROM (
    SELECT f.k, sum(f.v) AS v, sum(d.w) AS w
    FROM facts f JOIN dim d USING (k)
    GROUP BY f.k
);
----
1000	599982	797900

query III
SELECT count(*), sum(v), sum(w) FROM (
    SELECT f.k, sum(f.v) AS v, sum(d.w) AS w
    FROM facts f JOIN dim d USING (k)
    WHERE d.keep
    GROUP BY f.k
);
----
10	6002	8000

statement ok
CREATE TABLE dense AS SELECT i % 1000 AS k, i % 17 AS w FROM range(10000) r(i);

statement ok
CREATE TABLE sparse AS SELECT (i % 10) * 100 AS k, i % 17 AS w FROM range(100) r(i);

statement ok
ANALYZE;

query IIII
SELECT count(*), sum(n), sum(v), sum(w) FROM (
    SELECT f.k, count(*) AS n, sum(f.v) AS v, sum(d.w) AS w
    FROM facts f JOIN dense d USING (k)
    GROUP BY f.k
);
----
1000	1000000	5999820	7997400

query IIII
SELECT count(*), sum(n), sum(v), sum(w) FROM (
    SELECT f.k, count(*) AS n, sum(f.v) AS v, sum(d.w) AS w
    FROM facts f JOIN sparse d USING (k)
    GROUP BY f.k
);
----
10	10000	60020	78500

query IIII
SELECT count(*), sum(n), sum(v), sum(w) FROM (
    SELECT f.k, count(*) AS n, sum(f.v) AS v, sum(d.w) AS w
    FROM sparse d JOIN facts f USING (k)
    GROUP BY f.k
);
----
10	10000	60020	78500
