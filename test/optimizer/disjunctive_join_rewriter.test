# Volatile and Throwing Expressions

query II
EXPLAIN SELECT o.o_orderkey, o.o_custkey, l.l_orderkey, l.l_partkey, o.o_comment, l.l_comment
FROM orders o JOIN lineitem l
ON o.o_orderkey + 100 = l.l_orderkey
   OR o.o_custkey + 1000 = l.l_partkey
   OR SUBSTRING(o.o_comment, 1, 2) = SUBSTRING(l.l_comment, 1, 2);
----
physical_plan	<REGEX>:.*Blockwise Nl Join.*

query II
EXPLAIN SELECT o.o_orderkey, o.o_custkey, l.l_orderkey, l.l_partkey
FROM orders o JOIN lineitem l
ON o.o_orderkey = l.l_orderkey OR random() > 10;
----
physical_plan	<REGEX>:.*Blockwise Nl Join.*

# Stable Row Identity tests

query TTTT rowsort
WITH l(k, z) AS (VALUES (true, false)),
     r(p, q) AS (VALUES (0.0::DOUBLE, true), (-1.0::DOUBLE / 'Infinity'::DOUBLE, true))
SELECT l.k, l.z, signbit(r.p), r.q
FROM l FULL JOIN r
  ON l.k = signbit(r.p) OR l.z = r.q;
----
true	false	true	true
NULL	NULL	false	true