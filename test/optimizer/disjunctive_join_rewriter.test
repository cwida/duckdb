# COMPARE EQUAL tests

query II
EXPLAIN SELECT o.o_orderkey, o.o_custkey, l.l_orderkey, l.l_partkey
FROM orders o JOIN lineitem l ON o.o_orderkey = l.l_orderkey OR o.o_custkey = l.l_partkey;
----
physical_plan	<!REGEX>:.*Blockwise Nl Join.*

query IIII rowsort
SELECT o.o_orderkey, o.o_custkey, l.l_orderkey, l.l_partkey
FROM orders o JOIN lineitem l ON o.o_orderkey = l.l_orderkey OR o.o_custkey = l.l_partkey;
----
1	10	1	99
1	10	1	99
2	20	88	20
3	30	3	30
4	NULL	4	77
NULL	40	NULL	40

query IIII rowsort
SELECT o.o_orderkey, o.o_custkey, l.l_orderkey, l.l_partkey
FROM orders o LEFT JOIN lineitem l ON o.o_orderkey = l.l_orderkey OR o.o_custkey = l.l_partkey;
----
1	10	1	99
1	10	1	99
2	20	88	20
3	30	3	30
4	NULL	4	77
5	50	NULL	NULL
NULL	40	NULL	40

