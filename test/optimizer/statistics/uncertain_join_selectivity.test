# name: test/optimizer/statistics/uncertain_join_selectivity.test
# description: Unknown join domains use conservative selectivity without changing predicate combination
# group: [statistics]

require parquet

statement ok
SET explain_output='optimized_only';

statement ok
COPY (SELECT i::VARCHAR AS x, (i%10)::VARCHAR AS y, (i%100)::INTEGER AS n FROM range(1000) r(i))
TO '{TEST_DIR}/uncertain_join_selectivity.parquet';

statement ok
CREATE VIEW p AS FROM read_parquet('{TEST_DIR}/uncertain_join_selectivity.parquet');

# Retain the existing conservative combination of predicates on an uncertain pair.
query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b WHERE lower(a.x)=b.x AND lower(a.y)=b.y;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"200000"\s*}\s*}\s*\]\s*$

query I
SELECT count(*) FROM p a, p b WHERE lower(a.x)=b.x AND lower(a.y)=b.y;
----
1000

query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b WHERE lower(a.x)=b.x AND lower(a.x)=b.x;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"200000"\s*}\s*}\s*\]\s*$

# A redundant transitive predicate does not alter another equality's contribution.
query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b, p c WHERE a.x=b.x AND b.x=c.x AND a.y=c.y;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"40000000"\s*}\s*}\s*\]\s*$

query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b, p c WHERE a.x=b.x AND b.x=c.x AND a.y=c.y AND a.x=c.x;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"40000000"\s*}\s*}\s*\]\s*$

query I
SELECT count(*) FROM p a, p b, p c WHERE a.x=b.x AND b.x=c.x AND a.y=c.y AND a.x=c.x;
----
1000

# Nullable-safe equalities do not rely on FilterCombiner adding transitive predicates.
query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b, p c
WHERE a.x IS NOT DISTINCT FROM b.x AND b.x IS NOT DISTINCT FROM c.x AND a.n=c.n;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"40000000"\s*}\s*}\s*\]\s*$

query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM p a, p b, p c
WHERE a.x IS NOT DISTINCT FROM b.x AND b.x IS NOT DISTINCT FROM c.x AND a.n=c.n
AND a.x IS NOT DISTINCT FROM c.x;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"40000000"\s*}\s*}\s*\]\s*$

statement ok
COPY (SELECT i::VARCHAR AS x FROM range(4) r(i)) TO '{TEST_DIR}/small_unknown_domain.parquet';

query II
EXPLAIN (FORMAT JSON) SELECT a.x FROM read_parquet('{TEST_DIR}/small_unknown_domain.parquet') a,
read_parquet('{TEST_DIR}/small_unknown_domain.parquet') b WHERE a.x=b.x;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"4"\s*}\s*}\s*\]\s*$

# Retain the reliable unused-predicate discount when the composite cap is ineligible.
statement ok
CREATE TABLE limited_domain AS SELECT (i%100)::INTEGER n FROM range(1000) r(i);

statement ok
CREATE VIEW limited_domain_with_row_number AS SELECT row_number() OVER () x, n FROM limited_domain;

query II
EXPLAIN (FORMAT JSON) SELECT a.x
FROM (SELECT * FROM limited_domain_with_row_number LIMIT 100) a,
     (SELECT * FROM limited_domain_with_row_number LIMIT 100) b
WHERE a.x=b.x AND a.n=b.n;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"1000"\s*}\s*}\s*\]\s*$
