# name: test/optimizer/statistics/scan_selectivity_zonemaps_sampled.test_slow
# description: The zonemap bound of a scan estimate checks every k-th row group of a table with more than 16,384 row groups
# group: [statistics]

statement ok
SET explain_output='physical_only';

statement ok
ATTACH '{TEST_DIR}/scan_selectivity_zonemaps_sampled.db' AS rg (ROW_GROUP_SIZE 2048);

# 16,602 row groups of 2,048 rows
statement ok
CREATE TABLE rg.big AS SELECT range AS i, range // 1000000 AS d FROM range(34000000);

query I
SELECT count(DISTINCT row_group_id) > 16384 FROM pragma_storage_info('rg.big');
----
true

# every other row group is checked and the rows are scaled: the estimate is within a few row groups of the actual
# 3,400,000 and 2,000,000 rows
query II
EXPLAIN (FORMAT JSON) SELECT sum(d) FROM rg.big WHERE i < 3400000;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "3(39|40)[0-9]{4}"[\s\S]*

query II
EXPLAIN (FORMAT JSON) SELECT sum(i) FROM rg.big WHERE d >= 3 AND d <= 4;
----
physical_plan	<REGEX>:[\s\S]*"SEQ_SCAN"[^}]*"Estimated Cardinality": "(199|200)[0-9]{4}"[\s\S]*

foreach disabled scan_selectivity_zonemaps extension

statement ok
SET disabled_optimizers = '{disabled}';

query III
SELECT count(*), sum(i), (SELECT count(*) FROM rg.big WHERE i < 3400000) FROM rg.big WHERE d >= 3 AND d <= 4;
----
2000000	7999999000000	3400000

endloop
