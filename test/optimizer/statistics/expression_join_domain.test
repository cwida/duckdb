# name: test/optimizer/statistics/expression_join_domain.test
# description: Expression outputs do not inherit the distinct counts of their inputs
# group: [statistics]

require parquet

statement ok
SET explain_output='optimized_only';

statement ok
CREATE TABLE domain_native AS SELECT i FROM range(1000) t(i);

statement ok
ANALYZE domain_native;

statement ok
COPY domain_native TO '{TEST_DIR}/expression_domain.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW domain_parquet AS FROM read_parquet('{TEST_DIR}/expression_domain.parquet');

statement ok
CREATE VIEW domain_range AS SELECT i FROM range(1000) t(i);

foreach source domain_native domain_parquet domain_range

query II
EXPLAIN (FORMAT JSON)
SELECT a.i FROM {source} a JOIN {source} b ON a.i % 10 = b.i % 10;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"200000"\s*}\s*}\s*\]\s*$

query I
SELECT count(*) FROM {source} a JOIN {source} b ON a.i % 10 = b.i % 10;
----
100000

query II
EXPLAIN (FORMAT JSON)
SELECT a.k FROM (SELECT i % 10 k FROM {source}) a JOIN (SELECT i % 10 k FROM {source}) b USING (k);
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"200000"\s*}\s*}\s*\]\s*$

query I
SELECT count(*) FROM (SELECT i % 10 k FROM {source}) a JOIN (SELECT i % 10 k FROM {source}) b USING (k);
----
100000

query II
EXPLAIN (FORMAT JSON)
SELECT a.i FROM {source} a JOIN {source} b ON a.i % 10 IS NOT DISTINCT FROM b.i % 10;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"200000"\s*}\s*}\s*\]\s*$

# The direct side still provides a known domain for the expression equality.
query II
EXPLAIN (FORMAT JSON)
SELECT a.i FROM {source} a JOIN range(10) b(k) ON a.i % 10 = b.k;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"1000"\s*}\s*}\s*\]\s*$

query I
SELECT count(*) FROM {source} a JOIN range(10) b(k) ON a.i % 10 = b.k;
----
1000

query II
EXPLAIN (FORMAT JSON)
SELECT a.k FROM (SELECT i % 10 k FROM {source}) a JOIN range(10) b(k) USING (k);
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"1000"\s*}\s*}\s*\]\s*$

endloop

# Invertible casts retain the known input domain, including through projections.
query II
EXPLAIN (FORMAT JSON)
SELECT a.i FROM range(1000) a(i) JOIN range(1000) b(i) ON a.i::HUGEINT=b.i::HUGEINT;
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"1000"\s*}\s*}\s*\]\s*$

query II
EXPLAIN (FORMAT JSON)
SELECT a.k FROM (SELECT i::HUGEINT k FROM range(1000) t(i)) a
JOIN (SELECT i::HUGEINT k FROM range(1000) t(i)) b USING (k);
----
logical_opt	<REGEX>:(?s).*"Estimated Cardinality":\s*"1000"\s*}\s*}\s*\]\s*$
