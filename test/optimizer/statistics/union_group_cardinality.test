# name: test/optimizer/statistics/union_group_cardinality.test
# description: Estimate UNION group combinations within each arm
# group: [statistics]

require parquet

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
COPY (SELECT (i % 10)::INTEGER AS k FROM range(10000) t(i))
TO '{TEST_DIR}/union_group_keys.parquet';

statement ok
COPY (SELECT i::INTEGER AS k FROM range(1000) t(i))
TO '{TEST_DIR}/union_group_wide.parquet';

statement ok
COPY (SELECT (i % 50)::INTEGER AS a, (i // 50)::INTEGER AS b FROM range(2500) t(i))
TO '{TEST_DIR}/union_group_grid.parquet';

statement ok
CREATE VIEW keys AS SELECT * FROM read_parquet('{TEST_DIR}/union_group_keys.parquet');

statement ok
CREATE VIEW wide AS SELECT * FROM read_parquet('{TEST_DIR}/union_group_wide.parquet');

statement ok
CREATE VIEW grid AS SELECT * FROM read_parquet('{TEST_DIR}/union_group_grid.parquet');

statement ok
CREATE VIEW labeled AS
SELECT 0 AS a, 0 AS b, k FROM keys
UNION ALL
SELECT 1 AS a, 1 AS b, k FROM keys;

# Two correlated arm labels produce twenty combinations, not 2 * 2 * 20.
query I
SELECT count(*) FROM (SELECT a,b,k FROM labeled GROUP BY ALL);
----
20

query II
EXPLAIN SELECT a,b,k,count(*) FROM labeled GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~20 rows.*

# Direct aliases and reordered projections preserve the same grouping keys.
query II
EXPLAIN SELECT key,b,a,count(*)
FROM (SELECT k AS key,a,b FROM labeled) t
GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~20 rows.*

query II
EXPLAIN SELECT a,b,k,count(*)
FROM (SELECT * FROM labeled UNION ALL SELECT 2,2,k FROM keys) t
GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~30 rows.*

# Constant labels do not add independent dimensions within an arm.
# The cap must not worsen the existing estimate of disjoint, unique inputs.
query I
SELECT count(*) FROM (
    SELECT a,k FROM (SELECT 0 a,k FROM wide UNION ALL SELECT 1,k+1000 FROM wide) t GROUP BY ALL
);
----
2000

query II
EXPLAIN SELECT a,k,count(*)
FROM (SELECT 0 a,k FROM wide UNION ALL SELECT 1,k+1000 FROM wide) t
GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~1,555 rows.*

# Different high-cardinality columns in each arm retain the existing estimate.
query II
EXPLAIN SELECT a,b,count(*)
FROM (SELECT 0 a,k b FROM wide UNION ALL SELECT k+1000,0 FROM wide) t
GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~1,997 rows.*

# A fully populated key grid must not receive another occupancy discount per arm.
query I
SELECT count(*) FROM (
    SELECT label,a,b FROM (
        SELECT 0 label,a,b FROM grid UNION ALL SELECT 1,a+50,b+50 FROM grid
    ) t GROUP BY ALL
);
----
5000

query II
EXPLAIN SELECT label,a,b,count(*)
FROM (SELECT 0 label,a,b FROM grid UNION ALL SELECT 1,a+50,b+50 FROM grid) t
GROUP BY ALL;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~4,367 rows.*

# Overlapping arms are not assumed disjoint or identical.
query I
SELECT count(*) FROM (SELECT k FROM (SELECT k FROM keys UNION ALL SELECT k FROM keys) t GROUP BY k);
----
10

query II
EXPLAIN SELECT k,count(*) FROM (SELECT k FROM keys UNION ALL SELECT k FROM keys) t GROUP BY k;
----
physical_plan	<REGEX>:(?s).*GROUP_BY.*~20 rows.*

query I
SELECT count(*) FROM (
    SELECT a,b,k FROM labeled GROUP BY GROUPING SETS ((a,b,k),(a))
);
----
22

query I
SELECT count(*) FROM (
    SELECT a,k FROM (
        SELECT NULL::INTEGER a,k FROM keys
        UNION ALL SELECT 1,k FROM keys
        UNION ALL SELECT 2,k FROM keys WHERE FALSE
    ) t GROUP BY ALL
);
----
20
