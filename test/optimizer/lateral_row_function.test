# 17: WITH ORDINALITY stays a join
query III
SELECT id, v, o FROM t, UNNEST([a, b, c]) WITH ORDINALITY AS u(v, o) ORDER BY ALL
----
1	10	1
1	20	2
1	30	3
2	10	1
2	20	2
2	30	3
3	5	2
3	NULL	1
3	NULL	3
4	NULL	1
4	NULL	2
4	NULL	3
5	7	1
5	7	2
5	7	3
6	1	1
6	2	2
6	3	3

# 18: LEFT JOIN LATERAL stays a join: rows without a list element are kept
query II
SELECT id, v FROM t LEFT JOIN LATERAL (SELECT unnest(list_reverse(l)) AS v) ON true ORDER BY ALL
----
1	1
1	2
2	1
2	2
3	NULL
4	NULL
5	3
5	NULL
6	4

# 19: a lateral subquery over another table is not a row function
query II
SELECT id, name FROM t, LATERAL (SELECT name FROM names WHERE names.v = t.a) ORDER BY ALL
----
1	ten
2	ten
5	seven

# 20: a lateral aggregate is not a row function
query II
SELECT id, m FROM t, LATERAL (SELECT max(v) AS m FROM (SELECT unnest([a, b, c]) AS v)) ORDER BY ALL
----
1	30
2	30
3	5
4	NULL
5	7
6	3

# 21: a struct list
query III
SELECT id, u.v.x, u.v.y FROM t, UNNEST([{'x': a, 'y': b}, {'x': c, 'y': id}]) AS u(v) ORDER BY ALL
