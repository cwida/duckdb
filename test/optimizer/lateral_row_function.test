----
logical_opt	<REGEX>:(?s).*CTE Name.*Join Type: INNER.*

# without the rule: the CTE of the left rows and the join back on the three columns
statement ok
SET disabled_optimizers = 'lateral_row_function';

query II
EXPLAIN SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v);
