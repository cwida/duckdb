# name: test/optimizer/lateral_row_function.test
# description: A lateral join whose right side is a function of the left row alone (UNNEST of an expression over outer columns, a lateral subquery without a table) runs directly over the left rows
# group: [optimizer]

# t: duplicate rows apart from the id (1, 2), NULL columns, an empty list, a NULL list, a NULL list element
statement ok
CREATE TABLE t(id INTEGER, a INTEGER, b INTEGER, c INTEGER, l INTEGER[]);

statement ok
INSERT INTO t VALUES (1, 10, 20, 30, [1, 2]), (2, 10, 20, 30, [1, 2]), (3, NULL, 5, NULL, []), (4, NULL, NULL, NULL, NULL), (5, 7, 7, 7, [NULL, 3]), (6, 1, 2, 3, [4]);

statement ok
CREATE TABLE empty_t(id INTEGER, a INTEGER, b INTEGER, c INTEGER, l INTEGER[]);

statement ok
CREATE TABLE names(v INTEGER, name VARCHAR);

statement ok
INSERT INTO names VALUES (10, 'ten'), (20, 'twenty'), (7, 'seven'), (NULL, 'null');

query I
SELECT name FROM duckdb_optimizers() WHERE name = 'lateral_row_function';
----
lateral_row_function

# results

# 1: three columns into a list, duplicate rows (ids 1 and 2) and NULL columns keep their rows
query II
SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) ORDER BY ALL
----
1	10
1	20
1	30
2	10
2	20
2	30
3	5
3	NULL
3	NULL
4	NULL
4	NULL
4	NULL
5	7
5	7
5	7
6	1
6	2
6	3

# 2: one column in a list
query II
SELECT id, v FROM t, UNNEST([a]) AS u(v) ORDER BY ALL
----
1	10
2	10
3	NULL
4	NULL
5	7
6	1

# 3: an expression list
query II
SELECT id, v FROM t, UNNEST([a, a + 1, b * 2]) AS u(v) ORDER BY ALL
----
1	10
1	11
1	40
2	10
2	11
2	40
3	10
3	NULL
3	NULL
4	NULL
4	NULL
4	NULL
5	7
5	8
5	14
6	1
6	2
6	4

# 4: a function of a list column: NULL and empty lists produce no row
query II
SELECT id, v FROM t, UNNEST(list_reverse(l)) AS u(v) ORDER BY ALL
----
1	1
1	2
2	1
2	2
5	3
5	NULL
6	4

# 5: a list that is NULL for some rows
query II
SELECT id, v FROM t, UNNEST(CASE WHEN a > 5 THEN [a, b] END) AS u(v) ORDER BY ALL
----
1	10
1	20
2	10
2	20
5	7
5	7

# 6: a lateral subquery with the unnest in its select list
query II
SELECT id, v FROM t, LATERAL (SELECT unnest([a, b, c]) AS v) ORDER BY ALL
----
1	10
1	20
1	30
2	10
2	20
2	30
3	5
3	NULL
3	NULL
4	NULL
4	NULL
4	NULL
5	7
5	7
5	7
6	1
6	2
6	3

# 7: a lateral subquery with a filter on the unnested value and on the outer row
query II
SELECT id, v FROM t, LATERAL (SELECT v FROM (SELECT unnest([a, b, c]) AS v) WHERE v > 5 AND a IS NOT NULL) ORDER BY ALL
----
1	10
1	20
1	30
2	10
2	20
2	30
5	7
5	7
5	7

# 8: a lateral projection without an unnest
query II
SELECT id, s FROM t, LATERAL (SELECT a + b AS s) ORDER BY ALL
----
1	30
2	30
3	NULL
4	NULL
5	14
6	3

# 9: a lateral projection with a filter
query II
SELECT id, s FROM t, LATERAL (SELECT a + b AS s WHERE c > 5) ORDER BY ALL
----
1	30
2	30
5	14

# 10: a filter on the outer table and on the unnested value
query II
SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) WHERE id < 4 AND u.v IS NOT NULL ORDER BY ALL
----
1	10
1	20
1	30
2	10
2	20
2	30
3	5

# 11: an aggregate over the unnested value
query III
SELECT u.v, count(*), sum(id) FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) GROUP BY u.v ORDER BY ALL
----
1	1	6
2	1	6
3	1	6
5	1	3
7	3	15
10	2	3
20	2	3
30	2	3
NULL	5	18

# 12: the unnested value joins another table
query III
SELECT id, u.v, name FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) JOIN names ON names.v = u.v ORDER BY ALL
----
