# 28 an explicitly materialized CTE: left alone
query II
EXPLAIN WITH d AS MATERIALIZED (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d) x ON d.a IS NOT DISTINCT FROM x.a;
