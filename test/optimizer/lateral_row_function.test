# 24: select * through the lateral unnest
query IIIIII
SELECT * FROM t, UNNEST([a, b]) AS u(v) ORDER BY ALL
----
1	10	20	30	[1, 2]	10
1	10	20	30	[1, 2]	20
2	10	20	30	[1, 2]	10
2	10	20	30	[1, 2]	20
3	NULL	5	NULL	[]	5
3	NULL	5	NULL	[]	NULL
4	NULL	NULL	NULL	NULL	NULL
4	NULL	NULL	NULL	NULL	NULL
5	7	7	7	[NULL, 3]	7
5	7	7	7	[NULL, 3]	7
6	1	2	3	[4]	1
6	1	2	3	[4]	2

# 25: a volatile expression in the list stays a join (evaluated once per distinct key there)
query II
SELECT id, v FROM t, UNNEST([a, (random() * 0)::INTEGER]) AS u(v) ORDER BY ALL
----
1	0
1	10
2	0
2	10
3	0
3	NULL
4	0
4	NULL
5	0
5	7
6	0
6	1

# 26: a list column concatenated with another column (the row-number domain of a nested correlated column)
query II
SELECT id, v FROM t, UNNEST(l || [a]) AS u(v) ORDER BY ALL
----
1	1
1	2
1	10
2	1
2	2
2	10
3	NULL
5	3
5	7
5	NULL
6	1
6	4

# 27: a query-written CTE joined with its own distinct keys has the same shape: `=` drops the NULL keys
query II
WITH d AS (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d) x ON d.a = x.a ORDER BY ALL
----
1	10
2	10
5	7
6	1

# 28: the same with a null-safe condition and an explicitly materialized CTE (left alone)
query II
WITH d AS MATERIALIZED (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d) x ON d.a IS NOT DISTINCT FROM x.a ORDER BY ALL
----
1	10
2	10
3	NULL
4	NULL
5	7
6	1

# 29: only some of the distinct keys are joined: rows pair with every group that shares the joined key, a real join
query III
WITH d AS (SELECT * FROM t) SELECT d.id, x.a, x.b FROM d JOIN (SELECT DISTINCT a, b FROM d) x ON d.a IS NOT DISTINCT FROM x.a ORDER BY ALL
----
1	10	20
2	10	20
3	NULL	5
3	NULL	NULL
4	NULL	5
4	NULL	NULL
5	7	7
6	1	2

# 30: a filter on a column that is not a key below the DISTINCT: a real semi-join-like restriction, left alone
query II
WITH d AS (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d WHERE id > 1) x ON d.a IS NOT DISTINCT FROM x.a ORDER BY ALL
----
1	10
2	10
3	NULL
4	NULL
5	7
6	1

# Plans: the decorrelated form is a CTE with an INNER join back; the rewritten one has neither

statement ok
SET explain_output = 'optimized_only';

# 1 the list of three columns: no CTE, no join
query II
EXPLAIN SELECT id, u.v FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 4 a function of a list column (the row-number domain)
query II
EXPLAIN SELECT id, v FROM t, UNNEST(list_reverse(l)) AS u(v);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 6 a lateral subquery with the unnest in its select list
query II
EXPLAIN SELECT id, v FROM t, LATERAL (SELECT unnest([a, b, c]) AS v);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 7 filters on the unnested value and on the outer row inside the lateral subquery
query II
EXPLAIN SELECT id, v FROM t, LATERAL (SELECT v FROM (SELECT unnest([a, b, c]) AS v) WHERE v > 5 AND a IS NOT NULL);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 11 below an aggregate
query II
EXPLAIN SELECT u.v, count(*), sum(id) FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) GROUP BY u.v;
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 12 the join with another table stays, the join back goes
query II
EXPLAIN SELECT id, u.v, name FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) JOIN names ON names.v = u.v;
----
logical_opt	<!REGEX>:(?s).*CTE Name.*

# 12 (one INNER join left: the one with names)
query II
EXPLAIN SELECT id, u.v, name FROM t CROSS JOIN UNNEST([a, b, c]) AS u(v) JOIN names ON names.v = u.v;
----
logical_opt	<REGEX>:(?s).*Join Type: INNER.*

# 13 two lateral unnests, the second over the first: both rewritten
query II
EXPLAIN SELECT id, u.v, w.x FROM t, UNNEST([a, b]) AS u(v), UNNEST([u.v, c]) AS w(x);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 26 a list column concatenated with another column
query II
EXPLAIN SELECT id, v FROM t, UNNEST(l || [a]) AS u(v);
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 27 a query-written CTE joined with its own distinct keys on `=`: the NULL keys are filtered, no join
query II
EXPLAIN WITH d AS (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d) x ON d.a = x.a;
----
logical_opt	<!REGEX>:(?s).*(CTE Name|Join Type).*

# 27 (the IS NOT NULL that replaces the `=`)
query II
EXPLAIN WITH d AS (SELECT * FROM t) SELECT d.id, x.a FROM d JOIN (SELECT DISTINCT a FROM d) x ON d.a = x.a;
----
logical_opt	<REGEX>:(?s).*IS NOT NULL.*

