# an aggregate the query exports itself is combined above the join and returned as a state

query III
SELECT brand, class, finalize(st) FROM (SELECT brand, class, sum(qty) EXPORT_STATE AS st FROM sales JOIN item USING (item_key) GROUP BY brand, class) WHERE brand = 'b3' ORDER BY ALL
----
b3	c0	290019
b3	c1	299461
b3	c2	125252
b3	c3	253869
b3	c4	263069
b3	c5	271719
