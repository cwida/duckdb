# aggregates that stay above the join

query III
SELECT count(*), sum(sq), sum(c) FROM (SELECT brand, class, sum(qty) FILTER (WHERE grp > 3) AS sq, count(*) AS c FROM sales JOIN item USING (item_key) GROUP BY ROLLUP (brand, class))
----
403	162122802	593814

query III
SELECT count(*), sum(sq), count(mb) FROM (SELECT brand, class, sum(qty) AS sq, min(brand) AS mb FROM sales JOIN item USING (item_key) GROUP BY ROLLUP (brand, class))
----
403	269407818	395

# a many-to-many join

query IIII
SELECT g, h, sum(x.v), count(*) FROM x JOIN y ON x.k = y.k WHERE g < 2 AND h < 2 GROUP BY ROLLUP (g, h) ORDER BY ALL
----
0	0	75000	25000
0	1	75200	25000
0	NULL	150200	50000
1	0	59900	20000
1	1	74800	25000
1	NULL	134700	45000
NULL	NULL	284900	95000

endloop

endloop
