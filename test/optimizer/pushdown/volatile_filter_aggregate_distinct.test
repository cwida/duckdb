# name: test/optimizer/pushdown/volatile_filter_aggregate_distinct.test
# description: Volatile filters do not move across GROUP BY or DISTINCT
# group: [pushdown]

statement ok
CREATE TABLE agg(p INTEGER, x INTEGER);

statement ok
INSERT INTO agg VALUES (1, 10), (1, 20), (1, 30), (1, 40);

statement ok
CREATE SEQUENCE s1 START 1;

query I
SELECT SUM(x) FROM agg GROUP BY p HAVING nextval('s1') <= p + 1;
----
100

query I
SELECT currval('s1');
----
1

statement ok
INSERT INTO agg VALUES (2, 50), (2, 60), (3, 70), (3, 80);

statement ok
CREATE SEQUENCE s2 START 1;

query I
SELECT count(*) FROM (SELECT p FROM agg GROUP BY p HAVING nextval('s2') + p - p <= 2);
----
2

query I
SELECT currval('s2');
----
3

statement ok
CREATE TABLE dd(a INTEGER, b VARCHAR);

statement ok
INSERT INTO dd VALUES (1, 'x'), (1, 'x'), (2, 'y'), (2, 'y'), (3, 'z');

statement ok
CREATE SEQUENCE s4 START 1;

query I
SELECT count(*) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s4') <= 2;
----
2

query I
SELECT currval('s4');
----
3

statement ok
CREATE SEQUENCE s5 START 1;

query I
SELECT count(*) FROM (SELECT DISTINCT a, b FROM dd) q WHERE nextval('s5') + a - a <= 2;
----
2

statement ok
CREATE SEQUENCE s6 START 1;

query II
SELECT count(*), min(a) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s6') <= 2 AND a >= 2;
----
2	2

query I
SELECT currval('s6');
----
2

statement ok
CREATE SEQUENCE s9 START 1;

statement ok
CREATE SEQUENCE s11 START 1;

query I
SELECT count(*) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s9') > 0 AND nextval('s11') > 0 AND a >= 1;
----
3

query II
SELECT currval('s9'), currval('s11');
----
3	3

statement ok
CREATE SEQUENCE s10 START 1;

query I
SELECT count(*) FROM (SELECT DISTINCT ON (a) a, b FROM dd) q WHERE nextval('s10') <= 2;
----
2

query I
SELECT currval('s10');
----
3

statement ok
CREATE SEQUENCE s7 START 1;

query I
SELECT count(*) FROM (SELECT a FROM dd UNION SELECT a FROM dd) q WHERE nextval('s7') <= 2;
----
2

statement ok
CREATE SEQUENCE s8 START 1;

query I
SELECT count(*) FROM (SELECT a FROM dd INTERSECT SELECT a FROM dd) q WHERE nextval('s8') <= 2;
----
2

# filters that are not volatile are still pushed below the DISTINCT and the GROUP BY

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

query II
EXPLAIN SELECT * FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s6') <= 9 AND a >= 2;
----
logical_opt	<REGEX>:.*nextval.*Distinct.*Filters: a >= 2.*

query II
EXPLAIN SELECT p FROM agg GROUP BY p HAVING nextval('s1') <= 9 AND p >= 2;
----
logical_opt	<REGEX>:.*nextval.*Aggregate.*Filters: p >= 2.*

# a volatile filter inside a DISTINCT subquery stays below the DISTINCT when it is pulled up through a join

statement ok
CREATE TABLE halves AS SELECT 0.5::DOUBLE AS a FROM range(100);

statement ok
CREATE TABLE half AS SELECT 0.5::DOUBLE AS a;

query II
EXPLAIN SELECT count(*) FROM (SELECT DISTINCT a FROM halves WHERE random() < a) d JOIN half USING (a);
----
logical_opt	<REGEX>:.*Distinct.*random\(\) < a.*

statement ok
SET threads = 1;

statement ok
SELECT setseed(0.42);

query I
SELECT count(*) FROM (SELECT DISTINCT a FROM halves WHERE random() < a) d JOIN half USING (a);
----
1
