# name: test/optimizer/pushdown/mark_to_semi_projection_map.test
# description: A MARK join turned into a SEMI or ANTI join keeps the projection maps above it valid
# group: [pushdown]

statement ok
CREATE TABLE t1 AS SELECT range AS a FROM range(5);

statement ok
CREATE TABLE t2 AS SELECT range AS b FROM range(5);

statement ok
CREATE TABLE t3 AS SELECT range AS c FROM range(3);

# a filter with a projection map above the converted join
query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;
----
5

query III
SELECT t1.a, t2.b, t3.c FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1 ORDER BY ALL;
----
1	2	0
1	2	1
1	2	2
1	3	NULL
1	4	NULL

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) FULL JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;
----
5

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) RIGHT JOIN t3 ON t2.b IN (SELECT 2) WHERE t3.c > 0;
----
2

query I
SELECT count(*) FROM t1 JOIN t2 ON NOT EXISTS (SELECT 1 FROM t3 x WHERE x.c = t1.a) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;
----
10

# a MARK join with a left projection map above the converted join
query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT a FROM t1) LEFT JOIN t3 ON t2.b IN (SELECT c FROM t3) WHERE t2.b IN (SELECT c FROM t3);
----
45

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b NOT IN (SELECT c FROM t3);
----
2

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE EXISTS (SELECT 1 FROM t3 x WHERE x.c = t2.b);
----
5

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE NOT EXISTS (SELECT 1 FROM t3 x WHERE x.c = t2.b);
----
2

# an inner join re-created by the pushdown above the converted join
query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) JOIN t1 t4 ON t4.a = t2.b WHERE t2.b > 1;
----
5

query I
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1
UNION ALL
SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;
----
5
5
