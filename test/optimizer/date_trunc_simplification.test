2025-01-06 03:01:00

query I
select * from test where date_trunc('hour', d) <= '2025-01-06 03:00:00';
----
2025-01-06 00:00:00
2025-01-06 03:01:00

query I
select * from test where date_trunc('hour', d) <= '2025-01-06 04:00:00';
