2025-01-06 00:00:00
2025-01-06 03:01:00

query I
select * from test where date_trunc('minute', d) > '2025-01-10 05:10:00';
----

query I
select * from test where date_trunc('minute', d) > '2025-01-10 05:09:00';
----
2025-01-10 05:10:06

query I
select * from test where date_trunc('minute', d) >= '2025-01-10 05:10:00';
