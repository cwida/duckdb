# name: test/optimizer/join_predicate_derivation_errors.test
# description: Derived input filters preserve fallible join guards
# group: [optimizer]

query I
SELECT count(*) FROM range(1) a(i), range(1) b(j)
WHERE (j<0 AND error(i::VARCHAR)::BOOL) OR (j>0 AND error(i::VARCHAR)::BOOL)
----
0

query I
SELECT count(*) FROM range(4) a(i), range(4) b(j)
WHERE (j<0 AND error(i::VARCHAR)::BOOL) OR (j>10 AND error((i+1)::VARCHAR)::BOOL)
----
0

# Neither branch has a common guard on b or c.
query I
SELECT count(*) FROM range(1) a(i), range(1) b(j), range(1) c(k)
WHERE (j<0 AND error(i::VARCHAR)::BOOL) OR (k>0 AND error(i::VARCHAR)::BOOL)
----
0

query I
SELECT count(*) FROM range(1) a(i), range(1) b(j), range(1) c(k)
WHERE (j<0 AND ('bad' || i)::INT > 0) OR (k>0 AND ('bad' || i)::INT > 0)
----
0

statement error
SELECT count(*) FROM range(1) a(i), range(1) b(j)
WHERE (j=0 AND error(i::VARCHAR)::BOOL) OR (j>0 AND error(i::VARCHAR)::BOOL)
----
Invalid Input Error: 0

query I
SELECT count(*) FROM range(4) a(i), range(4) b(j)
WHERE (j<1 AND i>1) OR (j>2 AND i>1)
----
4
