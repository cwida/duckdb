# name: test/optimizer/partial_aggregate_uncertain_domain.test
# description: Cost partial aggregation from input key domains rather than fallback join selectivity
# group: [optimizer]

require parquet

statement ok
CREATE TABLE unique_native AS
SELECT i::VARCHAR AS k, i % 7 AS g, i AS m FROM range(5000) t(i)

statement ok
CREATE TABLE repeated_native AS
SELECT i % 50 AS k, i % 7 AS g, i AS tag FROM range(5000) t(i)

statement ok
CREATE TABLE asymmetric_native AS
SELECT i % 10 AS k, i % 100 AS g, i AS m FROM range(10000) t(i)

statement ok
CREATE TABLE small_native AS SELECT i % 10 AS k FROM range(100) t(i)

statement ok
ANALYZE

statement ok
COPY unique_native TO '{TEST_DIR}/pap_unique.parquet' (FORMAT PARQUET)

statement ok
COPY repeated_native TO '{TEST_DIR}/pap_repeated.parquet' (FORMAT PARQUET)

statement ok
COPY asymmetric_native TO '{TEST_DIR}/pap_asymmetric.parquet' (FORMAT PARQUET)

statement ok
COPY small_native TO '{TEST_DIR}/pap_small.parquet' (FORMAT PARQUET)

statement ok
CREATE VIEW unique_parquet AS FROM read_parquet('{TEST_DIR}/pap_unique.parquet')

statement ok
CREATE VIEW repeated_parquet AS FROM read_parquet('{TEST_DIR}/pap_repeated.parquet')

statement ok
CREATE VIEW asymmetric_parquet AS FROM read_parquet('{TEST_DIR}/pap_asymmetric.parquet')

statement ok
CREATE VIEW small_parquet AS FROM read_parquet('{TEST_DIR}/pap_small.parquet')

foreach storage native parquet

# Unknown string NDV must not turn a key lookup into a predicted aggregation collapse.
query II
SELECT sum(n), sum(s) FROM (
	SELECT a.g, count(*) AS n, sum(a.m) AS s
	FROM unique_{storage} a JOIN unique_{storage} b USING (k)
	GROUP BY a.g
)
----
5000	12497500

query II
EXPLAIN
SELECT a.g, count(*), sum(a.m)
FROM unique_{storage} a JOIN unique_{storage} b USING (k)
GROUP BY a.g
----
physical_plan	<!REGEX>:.*combine_aggr.*

# Supported small key domains still permit useful partial aggregation.
query I
SELECT sum(n) FROM (
	SELECT a.g, count(*) AS n
	FROM repeated_{storage} a JOIN repeated_{storage} b USING (k)
	GROUP BY a.g
)
----
500000

query II
EXPLAIN
SELECT a.g, count(*)
FROM repeated_{storage} a JOIN repeated_{storage} b USING (k)
GROUP BY a.g
----
physical_plan	<REGEX>:.*combine_aggr.*

# Materialized references retain their producer's supported join-key domain.
query II
WITH a AS MATERIALIZED (SELECT k, g, tag FROM repeated_{storage})
SELECT sum(n), sum(s) FROM (
	SELECT a.g, count(*) AS n, sum(a.tag) AS s
	FROM a JOIN repeated_{storage} b USING (k)
	GROUP BY a.g
)
----
500000	1249750000

query II
EXPLAIN
WITH a AS MATERIALIZED (SELECT k, g, tag FROM repeated_{storage})
SELECT a.g, count(*), sum(a.tag)
FROM a JOIN repeated_{storage} b USING (k)
GROUP BY a.g
----
physical_plan	<REGEX>:.*combine_aggr.*

# A producer can itself be rewritten before its consumers are visited.
query II
WITH a AS MATERIALIZED (
	SELECT x.k, x.g, sum(x.tag) AS m
	FROM repeated_{storage} x JOIN small_{storage} y USING (k)
	GROUP BY x.k, x.g
)
SELECT sum(n), sum(s) FROM (
	SELECT a.g, count(*) AS n, sum(a.m) AS s
	FROM a JOIN repeated_{storage} b USING (k)
	GROUP BY a.g
)
----
7000	2479500000

# Reduction on one input still avoids expanding the other input.
query II
SELECT count(*), sum(n) FROM (
	SELECT a.tag, count(*) AS n
	FROM repeated_{storage} a JOIN repeated_{storage} b USING (k)
	GROUP BY a.tag
)
----
5000	500000

query II
EXPLAIN
SELECT a.tag, count(*)
FROM repeated_{storage} a JOIN repeated_{storage} b USING (k)
GROUP BY a.tag
----
physical_plan	<REGEX>:.*combine_aggr.*

# Computed grouping expressions retain the existing aggregation heuristic.
query II
SELECT count(*), sum(n) FROM (
	SELECT a.g, b.g, count(*) AS n
	FROM (SELECT k, tag % 7 AS g FROM repeated_{storage}) a
	JOIN (SELECT k, tag % 11 AS g FROM repeated_{storage}) b USING (k)
	GROUP BY a.g, b.g
)
----
77	500000

query II
EXPLAIN
SELECT a.g, b.g, count(*)
FROM (SELECT k, tag % 7 AS g FROM repeated_{storage}) a
JOIN (SELECT k, tag % 11 AS g FROM repeated_{storage}) b USING (k)
GROUP BY a.g, b.g
----
physical_plan	<REGEX>:.*combine_aggr.*

# Extra groups on one input do not change the other input's join-key domain.
query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT a.g, count(*) AS n, sum(a.m) AS s
	FROM asymmetric_{storage} a JOIN small_{storage} b USING (k)
	GROUP BY a.g
)
----
100	100000	499950000

query II
EXPLAIN
SELECT a.g, count(*), sum(a.m)
FROM asymmetric_{storage} a JOIN small_{storage} b USING (k)
GROUP BY a.g
----
physical_plan	<REGEX>:.*combine_aggr.*

endloop
