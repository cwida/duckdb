# union intersect unnest, pivot, delim scan, inline cte, materialized
query II
explain
  select b.* from b left join (select distinct a.ida from a ) as a on a.ida=b.idb union all select b.*  from b left join (select distinct a.ida from a ) as a on a.ida=b.idb;
----
physical_plan	<!REGEX>:.*JOIN.*

statement ok
select b.* from b left join (select distinct a.ida from a ) as a on a.ida=b.idb union all select b.*  from b left join (select distinct a.ida from a ) as a on a.ida=b.idb;

# we cannot use distinct statistics from outer child
statement ok
select a.ida from (select ida from a group by ida) as a left join b on ida < idb;

query II
explain select a.ida from (select ida from a group by ida) as a left join b on ida < idb;
----
physical_plan	<REGEX>:.*JOIN.*

statement ok
select a.ida from b right join (select ida from a group by ida) as a on ida < idb;

query II
explain select a.ida from b right join (select ida from a group by ida) as a on ida < idb;
----
physical_plan	<REGEX>:.*JOIN.*

# unnest emits multiple rows per input row, so a distinct group below it does not survive above it
# (issue #25213)

statement ok
create table dup_keys(k int);

statement ok
insert into dup_keys values (1),(1),(2),(3);

statement ok
create table probe_keys(idb int);

statement ok
insert into probe_keys values (1),(1),(2),(3),(4),(NULL),(2),(3);

query I
select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
20

query II
explain select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
physical_plan	<REGEX>:.*JOIN.*

# same through group by instead of distinct
query I
select count(*) from probe_keys left join (select k, unnest([1,2,3]) e from (select k from dup_keys group by k) s) t on t.k=probe_keys.idb;
----
20

# same through a nested unnest
query I
select count(*) from probe_keys left join (select k, unnest([[1,2],[3]], recursive := true) e from (select distinct k from dup_keys) s) t on t.k=probe_keys.idb;
----
20

# a distinct ABOVE the unnest still makes the inner side unique, so the join is still eliminated
query I
select count(*) from probe_keys left join (select distinct k from (select k, unnest([1,2,3]) e from dup_keys) u) t on t.k=probe_keys.idb;
----
8

query II
explain select count(*) from probe_keys left join (select distinct k from (select k, unnest([1,2,3]) e from dup_keys) u) t on t.k=probe_keys.idb;
----
physical_plan	<!REGEX>:.*JOIN.*

# limit/top_n/sample pick rows based on input cardinality, so a distinct group established above them
# does not hold below them: the join duplicates p row 6, which changes which rows the slice keeps
# (issue #27155)

statement ok
create table p(id bigint, g varchar);

statement ok
insert into p values (1,'x'),(2,'y'),(3,'x'),(4,'y'),(5,'x'),(6,'y'),(7,'z');

statement ok
create table k(a bigint, b bigint);

statement ok
insert into k values (1,2),(1,3),(2,3),(3,4),(4,1),(5,1),(6,7),(6,4);

# the joined slice is (6,y),(6,y), so the distinct is y;
# if the join were eliminated the slice would be (6,y),(1,x), giving the wrong distinct {x,y}
query I
select distinct pg from (select p.id as pid, p.g as pg from p left join k on p.id = k.a order by p.g desc, p.id limit 2 offset 3) order by pg;
----
y

query II
explain select distinct pg from (select p.id as pid, p.g as pg from p left join k on p.id = k.a order by p.g desc, p.id limit 2 offset 3) order by pg;
----
physical_plan	<REGEX>:.*JOIN.*

# a plain limit (no order by) covers the LOGICAL_LIMIT case; rows kept are unspecified, plan only
query II
explain select distinct pg from (select p.g as pg from p left join k on p.id = k.a limit 5);
----
physical_plan	<REGEX>:.*JOIN.*

# a sample also picks rows by cardinality, so the join must survive it;
# assert Join Type: LEFT rather than JOIN: sampling itself adds a SEMI join
query II
explain select distinct pg from (select p.g as pg from p left join k on p.id = k.a) using sample 5 rows;
----
physical_plan	<REGEX>:.*Join Type: LEFT.*

# a window function computes values that depend on row multiplicity, so the join's duplicated rows
# shift the row_number values and change which rows a rn-filter keeps
query I
select distinct pg from (select p.g as pg, row_number() over (order by p.id) as rn from p left join k on p.id = k.a) t where rn <= 2;
----
x

query II
explain select distinct pg from (select p.g as pg, row_number() over (order by p.id) as rn from p left join k on p.id = k.a) t where rn <= 2;
----
physical_plan	<REGEX>:.*Join Type: LEFT.*

# group by instead of distinct: the join survives and the result is unchanged
query I
select pg from (select p.id as pid, p.g as pg from p left join k on p.id = k.a order by p.g desc, p.id limit 2 offset 3) group by pg order by pg;
----
y

# still eliminated: a distinct directly above the join absorbs the duplicated rows before any limit
query II
explain select distinct pg from (select p.g as pg from p left join k on p.id = k.a) order by pg limit 2;
----
physical_plan	<!REGEX>:.*JOIN.*

# still eliminated: a distinct join key makes the join non-multiplying, no matter what sits above it
query II
explain select distinct pg from (select p.g as pg from p left join (select distinct a from k) s on p.id = s.a order by pg desc limit 3) order by pg;
----
physical_plan	<!REGEX>:.*JOIN.*
