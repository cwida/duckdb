# name: test/optimizer/zonemaps.test
# description: Test if zonemaps are correctly used
# group: [optimizer]

statement ok
PRAGMA explain_output = PHYSICAL_ONLY;

statement ok
create temporary table t as select range a, length(range::varchar) b, mod(range,10000) c, 5::BIGINT d, 10000 e from range(100000);

# 1) In-clause based on in-clause range/boundary zonemap check
query II
explain select count(*) from t where b in (1,2,3) ;
----
physical_plan	<REGEX>:.*Filters:.*b <= 3.*

query I
select count(*) from t where b in (1,2,3) ;
----
1000

query II
explain select count(*) from t where b <=3 and b>=0;
----
physical_plan	<REGEX>:.*Filters:.*b <= 3.*

query I
select count(*) from t where b <=3 and b>=0;
----
1000


#   2) In-clause based on in-clause range/boundary zonemap check

query II
explain select count(*) from t where b in (1, 3) ;
----
physical_plan	<REGEX>:.*Filters:.*optional:.*b IN.*1, 3.*

query I
select count(*) from t where b in (1, 3) ;
----
910

query II
explain select count(*) from t where b = 1 or b = 3 ;
----
physical_plan	<REGEX>:.*Filters:.*optional:.*b IN.*1, 3.*

query I
select count(*) from t where b = 1 or b = 3 ;
----
910

#   3) Transitive Filters
query II
explain select count(*) from t where b < 5 and d = 5;
----
physical_plan	<REGEX>:.*Filters:.*b < 5.*

query I
select count(*) from t where b < 5 and d = 5;
----
10000

query II
explain select count(*) from t where  d = 5 and b < d;
----
physical_plan	<REGEX>:.*Filters:.*b < 5.*

query I
select count(*) from t where  d = 5 and b < d;
----
10000

#   4)  Check zonemap before joins
statement ok
create temporary table t1 as select range a, length(range::VARCHAR) nationkey from range(100000);

statement ok
create table t2 as select range  nationkey, concat('Nation_',range) n_name from range(25);

query II
explain select count(*) from t1 join t2 using (nationkey)
where t2.n_name = 'Nation_1' and t1.nationkey =1;
----
physical_plan	<REGEX>:.*Filters:.*Filters:.*

query I
select count(*) from t1 join t2 using (nationkey)
where t2.n_name = 'Nation_1' and t1.nationkey =1;
----
10

query II
explain select count(*) from t1 join t2 using (nationkey)
where t2.n_name = 'Nation_1' and t2.nationkey =1;
----
physical_plan	<REGEX>:.*Filters:.*Filters:.*

query I
select count(*) from t1 join t2 using (nationkey)
where t2.n_name = 'Nation_1' and t2.nationkey =1;
----
10

query II
explain select count(*) from t1 join t2 using (nationkey) where t2.n_name = 'Nation_1';
----
physical_plan	<REGEX>:.*Filters:.*n_name = 'Nation_1'.*

query I
select count(*) from t1 join t2 using (nationkey) where t2.n_name = 'Nation_1';
----
10

query II
explain select count(*) from t1 join t2 using (nationkey) where t2.nationkey =2 or n_name= 'Nation_2';
----
physical_plan	<!REGEX>:.*Filters:.*

query I
select count(*) from t1 join t2 using (nationkey) where t2.nationkey =2 or n_name= 'Nation_2';
----
90

query II
explain select count(*) from t1 join t2 using (nationkey) where t2.n_name in ( 'Nation_1', 'Nation_2');
----
physical_plan	<REGEX>:.*Filters:.*optional:.*n_name IN.*'Nation_1'.*'Nation_2'.*

query I
select count(*) from t1 join t2 using (nationkey) where t2.n_name in ( 'Nation_1', 'Nation_2');
----
100



# 5) More General Tests
statement ok
CREATE TABLE test(a tinyint, b smallint, c integer, d bigint, e double, f real, g varchar);

statement ok
INSERT INTO test SELECT range, range, range, range, range / 2.0, range / 2.0, range::VARCHAR FROM range(23);

# 5.1) Flipping filters
query II
explain select count(*) from test where (2 < a and 7 > a) or (a >5 and a < 6)
----
physical_plan	<REGEX>:.*Filters:.*2 < a.*7 > a.*OR.*a > 5.*a < 6.*

query I
select count(*) from test where (2 < a and 7 > a) or (a >5 and a < 6)
----
4

query II
explain select count(*) from test where (2 < a and a < 7) or (a >5 and a < 6)
----
physical_plan	<REGEX>:.*Filters:.*2 < a.*a < 7.*OR.*a > 5.*a < 6.*

query I
select count(*) from test where (2 < a and a < 7) or (a >5 and a < 6)
----
4

query II
explain select count(*) from test where (a >=2 and 7 > a)  or (a >5 and a < 6)
----
physical_plan	<REGEX>:.*Filters:.*a >= 2.*7 > a.*OR.*a > 5.*a < 6.*

query I
select count(*) from test where (a >=2 and 7 > a)  or (a >5 and a < 6)
----
5

query II
explain select count(*) from test where (4=a) or (a >5 and a < 6)
----
physical_plan	<REGEX>:.*Filters:.*4 = a.*OR.*a > 5.*a < 6.*

query I
select count(*) from test where (4=a) or (a >5 and a < 6)
----
1

# 5.2) Strict and inclusive boundaries across integer, floating and string types.

foreach col a b c d

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[abcd] >= 2.*[abcd] < 7.*OR.*[abcd] > 5.*[abcd] < 6.*

query I
SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
5

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} > 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[abcd] > 2.*[abcd] < 7.*OR.*[abcd] > 5.*[abcd] < 6.*

query I
SELECT count(*) FROM test WHERE ({col} > 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
4

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} > 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[abcd] > 2.*[abcd] <= 7.*OR.*[abcd] > 5.*[abcd] < 6.*

query I
SELECT count(*) FROM test WHERE ({col} > 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
5

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[abcd] >= 2.*[abcd] <= 7.*OR.*[abcd] > 5.*[abcd] < 6.*

query I
SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
6

endloop

foreach col e f

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[ef] >= 2[.]0.*[ef] < 7[.]0.*OR.*[ef] > 5[.]0.*[ef] < 6[.]0.*

query I
SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
10

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} > 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[ef] > 2[.]0.*[ef] < 7[.]0.*OR.*[ef] > 5[.]0.*[ef] < 6[.]0.*

query I
SELECT count(*) FROM test WHERE ({col} > 2 AND {col} < 7) OR ({col} > 5 AND {col} < 6);
----
9

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} > 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[ef] > 2[.]0.*[ef] <= 7[.]0.*OR.*[ef] > 5[.]0.*[ef] < 6[.]0.*

query I
SELECT count(*) FROM test WHERE ({col} > 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
10

query II
EXPLAIN SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
physical_plan	<REGEX>:.*Filters:.*[ef] >= 2[.]0.*[ef] <= 7[.]0.*OR.*[ef] > 5[.]0.*[ef] < 6[.]0.*

query I
SELECT count(*) FROM test WHERE ({col} >= 2 AND {col} <= 7) OR ({col} > 5 AND {col} < 6);
----
11

endloop

query II
EXPLAIN SELECT count(*) FROM test WHERE (g >= '2' AND g < '7') OR (g > '5' AND g < '6');
----
physical_plan	<REGEX>:.*Filters:.*g >= '2'.*g < '7'.*OR.*g > '5'.*g < '6'.*

query I
SELECT count(*) FROM test WHERE (g >= '2' AND g < '7') OR (g > '5' AND g < '6');
----
8

query II
EXPLAIN SELECT count(*) FROM test WHERE (g > '2' AND g < '7') OR (g > '5' AND g < '6');
----
physical_plan	<REGEX>:.*Filters:.*g > '2'.*g < '7'.*OR.*g > '5'.*g < '6'.*

query I
SELECT count(*) FROM test WHERE (g > '2' AND g < '7') OR (g > '5' AND g < '6');
----
7

query II
EXPLAIN SELECT count(*) FROM test WHERE (g > '2' AND g <= '7') OR (g > '5' AND g < '6');
----
physical_plan	<REGEX>:.*Filters:.*g > '2'.*g <= '7'.*OR.*g > '5'.*g < '6'.*

query I
SELECT count(*) FROM test WHERE (g > '2' AND g <= '7') OR (g > '5' AND g < '6');
----
8

query II
EXPLAIN SELECT count(*) FROM test WHERE (g >= '2' AND g <= '7') OR (g > '5' AND g < '6');
----
physical_plan	<REGEX>:.*Filters:.*g >= '2'.*g <= '7'.*OR.*g > '5'.*g < '6'.*

query I
SELECT count(*) FROM test WHERE (g >= '2' AND g <= '7') OR (g > '5' AND g < '6');
----
9

# 5.3) Casting
statement ok
CREATE TABLE test_date(a DATE);

statement ok
INSERT INTO test_date VALUES ('1995-12-01'), ('1995-12-10');

query II
EXPLAIN SELECT count(*) FROM test_date WHERE a = '1995-12-01';
----
physical_plan	<REGEX>:.*Filters:.*a = '1995-12-01'::DATE.*

query I
SELECT count(*) FROM test_date WHERE a = '1995-12-01';
----
1

query II
EXPLAIN SELECT count(*) FROM test_date WHERE a IN ('1995-12-01', '1995-12-02');
----
physical_plan	<REGEX>:.*Filters:.*optional:.*a IN.*'1995-12-01'::DATE.*'1995-12-02'::DATE.*

query I
SELECT count(*) FROM test_date WHERE a IN ('1995-12-01', '1995-12-02');
----
1

# 5.4) Test with NULLs
statement ok
CREATE TABLE t0(c0 BOOLEAN);

statement ok
INSERT INTO t0 VALUES (false), (NULL);

query T
SELECT t0.c0 FROM t0 WHERE t0.c0 IN (false, NULL);
----
0
