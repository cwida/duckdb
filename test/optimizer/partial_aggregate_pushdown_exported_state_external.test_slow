# name: test/optimizer/partial_aggregate_pushdown_exported_state_external.test_slow
# description: ROLLUP over a join whose exported finest level is pre-aggregated below the join: the pre-aggregate and the levels that combine its states run as external aggregates under a small memory limit
# group: [optimizer]

load {TEST_DIR}/partial_aggregate_pushdown_exported_state_external.db

statement ok
SET threads=4

# 10M fact rows over 2M join keys; the dimension has one wide (a, b) group per key
statement ok
CREATE TABLE fact AS SELECT (hash(i) % 2000000)::INTEGER AS k, (i % 1000)::INTEGER AS qty FROM range(10000000) t(i);

statement ok
CREATE TABLE dim AS SELECT i::INTEGER AS k, concat('a', i % 2000000, repeat('x', 40)) AS a, concat('b', i % 1000, repeat('y', 40)) AS b FROM range(2000000) t(i);

statement ok
SET explain_output = 'optimized_only';

# the pre-aggregate (EXPORT_STATE) is below the join: in the JSON plan it is printed before the "Join Type" of its parent
query II
EXPLAIN (FORMAT JSON) SELECT a, b, sum(qty), count(*), min(qty), max(qty) FROM fact JOIN dim USING (k) GROUP BY ROLLUP (a, b)
----
logical_opt	<REGEX>:.*EXPORT_STATE.*Join Type.*

# neither the 2M states of the pre-aggregate nor the 2M wide groups above the join fit in memory
statement ok
SET memory_limit='300MB'

foreach pushdown on off

statement ok
SET disabled_optimizers = CASE WHEN '{pushdown}' = 'off' THEN 'partial_aggregate_pushdown' ELSE '' END;

query IIIIIII
SELECT count(*), count(a), count(b), sum(s), sum(c), sum(mn), sum(mx) FROM (SELECT a, b, sum(qty) AS s, count(*) AS c, min(qty) AS mn, max(qty) AS mx FROM fact JOIN dim USING (k) GROUP BY ROLLUP (a, b))
----
3973371	3973370	1986685	14985000000	30000000	765989488	3203048375

endloop
