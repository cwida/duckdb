# name: test/optimizer/distributivity_errors.test
# description: Factoring common predicates preserves fallible evaluation guards
# group: [optimizer]

query I
SELECT i FROM range(1) t(i) WHERE (i>1 AND error('boom')::BOOL) OR (i>2 AND error('boom')::BOOL)
----

query I
SELECT i FROM range(2) t(i) WHERE (i>10 AND error(i::VARCHAR)::BOOL) OR (i>20 AND error(i::VARCHAR)::BOOL)
----

query I
SELECT i FROM range(2) t(i) WHERE (i>10 AND ('bad' || i)::INT > 0) OR (i>20 AND ('bad' || i)::INT > 0)
----

statement error
SELECT i FROM range(2) t(i) WHERE (i>=0 AND error('boom')::BOOL) OR (i>20 AND error('boom')::BOOL)
----
boom
