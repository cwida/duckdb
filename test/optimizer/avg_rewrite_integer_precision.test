# name: test/optimizer/avg_rewrite_integer_precision.test
# description: AVG of integers divides SUM by COUNT with a single rounding, natively and in the optimizer's rewrite (issue #27865)
# group: [optimizer]

statement ok
CREATE TABLE bigints(n HUGEINT);

statement ok
INSERT INTO bigints VALUES (9007199254740992), (1), (0);

# the sum 2^53 + 1 does not fit a DOUBLE, the average 3002399751580331 does
query ITI
SELECT sum(n), avg(n)::VARCHAR, avg(n) = 3002399751580331.0 FROM bigints;
----
9007199254740993	3002399751580331.0	true

statement ok
SET explain_output = 'optimized_only';

# the average is still computed from SUM and COUNT, through an integer division that rounds once
query II
EXPLAIN SELECT avg(n) AS a FROM bigints;
----
logical_opt	<!REGEX>:.*avg\(n\).*

query II
EXPLAIN SELECT avg(n) AS a FROM bigints;
----
logical_opt	<REGEX>:.*__internal_divide_to_double.*

# small sums are unchanged: 5 / 3 is 1.6666666666666667
query TI
SELECT avg(n)::VARCHAR, avg(n) = 5.0 / 3.0 FROM (VALUES (2), (2), (1)) t(n);
----
1.6666666666666667	true

# the sum 2^53 itself is exact in a DOUBLE
query TI
SELECT avg(n)::VARCHAR, avg(n) = 9007199254740992.0 / 3.0 FROM (VALUES (9007199254740992::HUGEINT), (0), (0)) t(n);
----
3002399751580330.5	true

# a representable fraction: (2^53 + 1) / 6
query TI
SELECT avg(n)::VARCHAR, avg(n) = 1501199875790165.5 FROM (VALUES (9007199254740992::HUGEINT), (1), (0), (0), (0), (0)) t(n);
----
1501199875790165.5	true

# above 2^53 a DOUBLE holds even integers only: 9007199254740993.5 rounds to the nearest one, 9007199254740993 to the even one
query T
SELECT avg(n)::VARCHAR FROM (VALUES (9007199254740993::HUGEINT), (9007199254740994)) t(n);
----
9007199254740994.0

query T
SELECT avg(n)::VARCHAR FROM (VALUES (9007199254740993::HUGEINT), (9007199254740993), (9007199254740993)) t(n);
----
9007199254740992.0

# the same sum from BIGINT, UBIGINT and negated values
statement ok
CREATE TABLE int64s(n BIGINT);

statement ok
INSERT INTO int64s VALUES (9007199254740992), (1), (0);

query TTT
SELECT avg(n)::VARCHAR, avg(n::UBIGINT)::VARCHAR, avg(-n)::VARCHAR FROM int64s;
----
3002399751580331.0	3002399751580331.0	-3002399751580331.0

# no rows and only NULL rows give NULL, not a division by zero
query I
SELECT avg(n) FROM bigints WHERE n < 0;
----
NULL

query I
SELECT avg(n) FROM (VALUES (NULL::HUGEINT), (NULL)) t(n);
----
NULL

# grouped: the rewrite applies when the count is shared, also for a group of NULLs
statement ok
CREATE TABLE grouped(g INTEGER, n BIGINT);

statement ok
INSERT INTO grouped VALUES (1, 9007199254740992), (1, 1), (1, 0), (2, -9007199254740992), (2, -1), (2, 0), (3, NULL), (3, NULL), (4, 2), (4, 2), (4, 1);

query II
EXPLAIN SELECT g, count(n) AS c, avg(n) AS a FROM grouped GROUP BY g;
----
logical_opt	<!REGEX>:.*avg\(n\).*

query IIT
SELECT g, count(n), avg(n)::VARCHAR FROM grouped GROUP BY g ORDER BY g;
----
1	3	3002399751580331.0
2	3	-3002399751580331.0
3	0	NULL
4	3	1.6666666666666667

# without a shared count the aggregate itself computes the average, with the same division
query IT
SELECT g, avg(n)::VARCHAR FROM grouped GROUP BY g ORDER BY g;
----
1	3002399751580331.0
2	-3002399751580331.0
3	NULL
4	1.6666666666666667

query T
SELECT DISTINCT avg(n) OVER ()::VARCHAR FROM bigints;
----
3002399751580331.0

statement ok
SET disabled_optimizers = 'aggregate_function_rewriter';

query TT
SELECT avg(n)::VARCHAR, avg(n) = 3002399751580331.0 FROM bigints;
----
3002399751580331.0	true

query TI
SELECT avg(n)::VARCHAR, avg(n) = 5.0 / 3.0 FROM (VALUES (2), (2), (1)) t(n);
----
1.6666666666666667	true

statement ok
SET disabled_optimizers = '';

# small integers are unchanged
query RR
SELECT avg(i), avg(i::TINYINT) FROM range(10) t(i);
----
4.5	4.5

# floating point, DECIMAL and UHUGEINT sums keep the plain division
query II
EXPLAIN SELECT avg(d) AS a FROM (VALUES (1.5::DOUBLE), (2.5)) t(d);
----
logical_opt	<!REGEX>:.*__internal_divide_to_double.*

query II
EXPLAIN SELECT avg(d) AS a FROM (VALUES (1.5::DECIMAL(4,1)), (2.5)) t(d);
----
logical_opt	<!REGEX>:.*__internal_divide_to_double.*

query II
EXPLAIN SELECT avg(d) AS a FROM (VALUES (1::UHUGEINT), (2)) t(d);
----
logical_opt	<!REGEX>:.*__internal_divide_to_double.*

query RRR
SELECT avg(d::DOUBLE), avg(d::DECIMAL(4,1)), avg(d::UHUGEINT) FROM (VALUES (1), (2)) t(d);
----
1.5	1.5	1.5

# the division itself, against exact rational arithmetic rounded to the nearest DOUBLE (ties to even)
query II
SELECT count(*), COALESCE(list(s::VARCHAR || ' / ' || c::VARCHAR) FILTER (WHERE __internal_divide_to_double(s, c) IS DISTINCT FROM expected), []) FROM (VALUES
	(9007199254740993, 3::BIGINT, '3002399751580331.0'::DOUBLE),
	(9007199254740993, 6::BIGINT, '1501199875790165.5'::DOUBLE),
	(9007199254740992, 3::BIGINT, '3002399751580330.5'::DOUBLE),
	(5, 3::BIGINT, '1.6666666666666667'::DOUBLE),
	(10, 3::BIGINT, '3.3333333333333335'::DOUBLE),
	(1, 3::BIGINT, '0.3333333333333333'::DOUBLE),
	(2, 3::BIGINT, '0.6666666666666666'::DOUBLE),
	(1, 10::BIGINT, '0.1'::DOUBLE),
	(18014398509481987, 2::BIGINT, '9007199254740994.0'::DOUBLE),
	(27021597764222979, 3::BIGINT, '9007199254740992.0'::DOUBLE),
	(9007199254740995, 2::BIGINT, '4503599627370498.0'::DOUBLE),
	(27021597764222979, 36028797018963972::BIGINT, '0.75'::DOUBLE),
	(4934439770703641128, 5181598237254894036::BIGINT, '0.9523007274523483'::DOUBLE),
	(170141183460469231731687303715884105727::HUGEINT, 1::BIGINT, '1.7014118346046923e+38'::DOUBLE),
	((-170141183460469231731687303715884105727::HUGEINT - 1), 1::BIGINT, '-1.7014118346046923e+38'::DOUBLE),
	(170141183460469231731687303715884105727::HUGEINT, 9223372036854775807::BIGINT, '1.8446744073709552e+19'::DOUBLE),
	((-170141183460469231731687303715884105727::HUGEINT - 1), (-9223372036854775807::BIGINT - 1)::BIGINT, '1.8446744073709552e+19'::DOUBLE),
	((-170141183460469231731687303715884105727::HUGEINT - 1), 9223372036854775807::BIGINT, '-1.8446744073709552e+19'::DOUBLE),
	(170141183460469231731687303715884105727::HUGEINT, (-9223372036854775807::BIGINT - 1)::BIGINT, '-1.8446744073709552e+19'::DOUBLE),
	(1, 9223372036854775807::BIGINT, '1.0842021724855044e-19'::DOUBLE),
	(1, (-9223372036854775807::BIGINT - 1)::BIGINT, '-1.0842021724855044e-19'::DOUBLE),
	(-1, 9223372036854775807::BIGINT, '-1.0842021724855044e-19'::DOUBLE),
	(-7, 2::BIGINT, '-3.5'::DOUBLE),
	(7, -2::BIGINT, '-3.5'::DOUBLE),
	(-7, -2::BIGINT, '3.5'::DOUBLE),
	(0, 5::BIGINT, '0.0'::DOUBLE),
	(0, -5::BIGINT, '0.0'::DOUBLE),
	(18446744073709551617::HUGEINT, 9223372036854775807::BIGINT, '2.0'::DOUBLE),
	(85070591730234615865843651857942052865::HUGEINT, 4611686018427387905::BIGINT, '1.8446744073709552e+19'::DOUBLE),
	(1267650600228229401496703205376::HUGEINT, 3::BIGINT, '4.2255020007607644e+29'::DOUBLE),
	(-1267650600228229401496703205377::HUGEINT, 7::BIGINT, '-1.8109294288974705e+29'::DOUBLE),
	(123456789012345678901234567890::HUGEINT, 1000000007::BIGINT, '1.2345678814814816e+20'::DOUBLE),
	(138470094359774649058265434943661662543::HUGEINT, 7322491655401553668::BIGINT, '1.891024269828016e+19'::DOUBLE),
	(-107274497586435813429829585189822272859::HUGEINT, 3574779760497460505::BIGINT, '-3.00087011714276e+19'::DOUBLE),
	(-115106557678356935696012400262162123105::HUGEINT, 1315592945542776770::BIGINT, '-8.749405206856532e+19'::DOUBLE),
	(-129706808729099693659222834990813062369::HUGEINT, 6733270352157117419::BIGINT, '-1.9263567619492053e+19'::DOUBLE),
	(158489785915111865523641605674760644665::HUGEINT, 95702228907932611::BIGINT, '1.6560720447543818e+21'::DOUBLE),
	(-90527957662281037670068443985123012379::HUGEINT, 8011562251571634770::BIGINT, '-1.1299663513757518e+19'::DOUBLE),
	(-164837871368513821632318438483046094932::HUGEINT, 6879060063066933112::BIGINT, '-2.3962266626150543e+19'::DOUBLE),
	(118277234918244497366754732339778483571::HUGEINT, 7397034901665462614::BIGINT, '1.5989817067324375e+19'::DOUBLE),
	(130715988003620350829314781836365428138::HUGEINT, 7660305894583688298::BIGINT, '1.7064068955267787e+19'::DOUBLE),
	(-30811100078482028804500929144834714605::HUGEINT, 9036810904173787223::BIGINT, '-3.4095103245163023e+18'::DOUBLE),
	(63902599974903633095493484841619770076::HUGEINT, 6108561690189032298::BIGINT, '1.0461153249469129e+19'::DOUBLE),
	(50454962099591099132873821347320942055::HUGEINT, 3835321219309098288::BIGINT, '1.3155341942566195e+19'::DOUBLE),
	(-980667039434111096, 989492386862183184::BIGINT, '-0.991080934481913'::DOUBLE),
	(840031923627317322, 3156260112743667595::BIGINT, '0.26614787553016217'::DOUBLE),
	(-646436652506654362, 1564813744612663139::BIGINT, '-0.41310772910335486'::DOUBLE),
	(-1130246863865855422, 2037147343657209198::BIGINT, '-0.5548184167360072'::DOUBLE),
	(100409187418951417, 3530416147879688959::BIGINT, '0.02844117611439534'::DOUBLE),
	(1145797041913282880, 49456815791561580::BIGINT, '23.167626616770203'::DOUBLE)
) t(s, c, expected);
----
50	[]

query II
SELECT __internal_divide_to_double(NULL, 3), __internal_divide_to_double(3, NULL);
----
NULL	NULL

# zero keeps the sign of the division, like "/"
query IIII
SELECT signbit(__internal_divide_to_double(0, 1)), signbit(__internal_divide_to_double(0, -1)), signbit(__internal_divide_to_double(-1, 1)), signbit(__internal_divide_to_double(-1, -1));
----
false	true	true	false

# an imported state can hold a count beyond BIGINT
query TTT
SELECT finalize(to_aggregate_state({'count': 3::UBIGINT, 'value': 9007199254740993::HUGEINT}, 'avg', ['BIGINT']))::VARCHAR,
       finalize(to_aggregate_state({'count': 9223372036854775808::UBIGINT, 'value': 9223372036854775808::HUGEINT}, 'avg', ['HUGEINT']))::VARCHAR,
       finalize(to_aggregate_state({'count': 18446744073709551615::UBIGINT, 'value': (-170141183460469231731687303715884105727::HUGEINT - 1)}, 'avg', ['HUGEINT']))::VARCHAR;
----
3002399751580331.0	1.0	-9.223372036854776e+18

statement error
SELECT __internal_divide_to_double(1, 0);
----
Division by zero

query I
SELECT TRY(__internal_divide_to_double(1, 0));
----
NULL

statement ok
SET error_on_division_by_zero = false;

query I
SELECT __internal_divide_to_double(1, 0);
----
NULL

statement ok
RESET error_on_division_by_zero;
