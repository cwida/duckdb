# name: test/optimizer/recursive_cte_cost_alternatives.test
# description: Allow independent builds that enable a compound join key
# group: [optimizer]

statement ok
SET threads=1;

statement ok
SET memory_limit='2GB';

statement ok
SET max_execution_time=10000;

statement ok
CREATE TABLE threshold_build_a AS SELECT i AS x, i % 2 AS g FROM range(100) t(i);

statement ok
CREATE TABLE threshold_build_b AS SELECT i AS y, i % 2 AS g FROM range(100) t(i);

statement ok
CREATE VIEW threshold_walk_result AS
WITH RECURSIVE c(id, g, depth) AS (
 SELECT i, i % 2, 0 FROM range(1000) t(i)
 UNION ALL
 SELECT c.id, c.g, c.depth + 1
 FROM c
 JOIN threshold_build_a a ON c.g = a.g
 JOIN threshold_build_b b ON a.g = b.g AND c.id = a.x * 100 + b.y
 WHERE c.depth < 100
)
SELECT count(*), sum(id) FROM c;

query II
SELECT * FROM threshold_walk_result;
----
51000	25474500

statement ok
SET threads=1;

statement ok
SET memory_limit='2GB';

statement ok
SET max_execution_time=10000;

statement ok
SET prefer_range_joins=true;

statement ok
CREATE TABLE dependency_build_a AS SELECT i AS x, i % 2 AS g FROM range(1000) t(i);

statement ok
CREATE TABLE dependency_build_b AS SELECT i AS y, i % 2 AS g FROM range(1000) t(i);

statement ok
CREATE VIEW dependency_walk_result AS
WITH RECURSIVE c(id, g, depth) AS (
 SELECT i, i % 2, 0 FROM range(100000) t(i)
 UNION ALL
 SELECT c.id, c.g, c.depth + 1
 FROM c
 JOIN dependency_build_a a ON c.g = a.g
 JOIN dependency_build_b b ON a.g = b.g AND c.id = b.y
 WHERE c.depth < 1
)
SELECT count(*), sum(id) FROM c;

query II
SELECT * FROM dependency_walk_result;
----
600000	5249700000

require noforcestorage

statement ok
SET explain_output='physical_only';

loop threshold 0 2

statement ok
SET approximate_join_order_threshold={threshold} * 30;

statement ok
SET prefer_range_joins=false;

query II
SELECT * FROM threshold_walk_result;
----
51000	25474500

query II
EXPLAIN SELECT * FROM threshold_walk_result;
----
physical_plan	<REGEX>:(?s).*\.main\.threshold_build_(a(?:[^\n]*\n){0,6}[^\n]*\.main\.threshold_build_b|b(?:[^\n]*\n){0,6}[^\n]*\.main\.threshold_build_a).*

statement ok
SET prefer_range_joins=true;

query II
SELECT * FROM dependency_walk_result;
----
600000	5249700000

query II
EXPLAIN SELECT * FROM dependency_walk_result;
----
physical_plan	<REGEX>:(?s).*\.main\.dependency_build_a.*id = y.*\.main\.dependency_build_b.*

endloop

statement ok
SET prefer_range_joins=false;

statement ok
CREATE TABLE threshold_build_d AS SELECT i AS z, i % 2 AS g FROM range(100) t(i);

# The three-input walk needs minutes at tiny vector sizes
require vector_size 2048

statement ok
CREATE VIEW three_input_walk AS
WITH RECURSIVE c(id, g, depth) AS (
 SELECT i, i % 2, 0 FROM range(1000) t(i)
 UNION ALL
 SELECT c.id, c.g, c.depth + 1
 FROM c
 JOIN threshold_build_a a ON c.g = a.g
 JOIN threshold_build_b b ON a.g = b.g
 JOIN threshold_build_d d ON b.g = d.g AND c.id = a.x * 10000 + b.y * 100 + d.z
 WHERE c.depth < 5
)
SELECT count(*), sum(id) FROM c;

# The compound build runs about 2 s optimized and 6 s with assertions, so give loaded assert runners headroom
statement ok
SET max_execution_time=60000;

loop threshold 0 2

statement ok
SET approximate_join_order_threshold={threshold} * 30;

query II
SELECT * FROM three_input_walk;
----
2250	1060750

endloop
