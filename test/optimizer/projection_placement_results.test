statement ok
CREATE TABLE placement_ie_right(start DATE, stop DATE, bid DECIMAL);

statement ok
INSERT INTO placement_ie_right VALUES
	('2026-01-01', '2026-01-03', 149.5),
	('2026-01-03', '2026-01-04', 150.5),
	('2026-01-04', '2026-01-05', 379);

query III
SELECT l.id, l.start, l.stop
FROM placement_ie_left l
ANTI JOIN placement_ie_right r
	ON l.start < r.stop
	AND r.start < l.stop
	AND l.price + r.bid > 300
ORDER BY 1;
----
1	2026-01-01	2026-01-02
4	2026-01-05	NULL
5	NULL	2026-01-06
