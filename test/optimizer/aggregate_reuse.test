# Uniform duplication by the added relation does not change MIN.
statement ok
CREATE TABLE payload_unproven_part AS SELECT * FROM payload_part UNION ALL SELECT * FROM payload_part

query II
EXPLAIN WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_unproven_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), minimum_cost AS (
  SELECT f.k, min(f.cost) AS cost
  FROM payload_fact f
  WHERE f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT o.k, o.cost FROM outer_rows o JOIN minimum_cost m ON o.k = m.k AND o.cost = m.cost
----
logical_opt	<!REGEX>:(?s).*payload_fact.*payload_fact.*

query II rowsort
WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_unproven_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), minimum_cost AS (
  SELECT f.k, min(f.cost) AS cost
  FROM payload_fact f
  WHERE f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT o.k, o.cost FROM outer_rows o JOIN minimum_cost m ON o.k = m.k AND o.cost = m.cost
