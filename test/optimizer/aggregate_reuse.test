# Multiple replication-invariant aggregates can be reused together.
query II
EXPLAIN WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_unproven_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), cost_stats AS (
  SELECT f.k, min(f.cost) AS minimum, max(f.cost) AS maximum
  FROM payload_fact f
  WHERE f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT * FROM cost_stats
----
logical_opt	<!REGEX>:(?s).*payload_fact.*payload_fact.*

query III rowsort
WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_unproven_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), cost_stats AS (
  SELECT f.k, min(f.cost) AS minimum, max(f.cost) AS maximum
  FROM payload_fact f
  WHERE f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT * FROM cost_stats
----
1	1	7
2	9	9

# Multiplicity-sensitive aggregates cannot consume the duplicated producer.
query II
EXPLAIN WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_unproven_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), total_cost AS (
  SELECT f.k, sum(f.cost) AS cost
  FROM payload_fact f
  WHERE f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT * FROM total_cost
----
logical_opt	<REGEX>:(?s).*payload_fact.*payload_fact.*

# A different core filter changes the aggregate row domain.
query II
EXPLAIN WITH outer_rows AS MATERIALIZED (
  SELECT p.k, f.cost, f.supplier_id
  FROM payload_part p JOIN payload_fact f USING (k)
  WHERE p.size = 15
), minimum_cost AS (
  SELECT f.k, min(f.cost) AS cost
  FROM payload_fact f
  WHERE f.cost >= 7 AND f.k IN (SELECT k FROM outer_rows)
  GROUP BY f.k
)
SELECT o.k, o.cost FROM outer_rows o JOIN minimum_cost m ON o.k = m.k AND o.cost = m.cost
----
logical_opt	<REGEX>:(?s).*payload_fact.*payload_fact.*

statement ok
RESET delim_join_as_cte

# A changed inner row domain cannot consume the materialized payload.
query II
EXPLAIN SELECT p.k, f.cost
FROM payload_part p JOIN payload_fact f USING (k)
WHERE p.size = 15 AND f.cost = (SELECT min(f2.cost) FROM payload_fact f2
                                WHERE f2.k = p.k AND f2.supplier_id = 10)
----
logical_opt	<REGEX>:(?s).*payload_fact.*payload_fact.*
