statement ok
SET debug_verify_serializer = false

# DISTINCT has a separate state lifecycle and is not reused.
query II
EXPLAIN SELECT o.k, d.label, count(DISTINCT f.w)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING count(DISTINCT w) > 1)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

# Every outer aggregate would have to be available in the retained payload.
query II
EXPLAIN SELECT o.k, d.label, sum(f.v), count(*)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

# A different argument or function is not an exact payload match.
query II
EXPLAIN SELECT o.k, d.label, sum(f.w)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

query II
EXPLAIN SELECT o.k, d.label, max(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

# Filters on either aggregate input change the row domain.
query II
EXPLAIN SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact WHERE w >= 2 GROUP BY k HAVING sum(v) > 15)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

query II
EXPLAIN SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f ON o.k = f.k AND f.w >= 2
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

# The SEMI join must consume the grouped key, not another output of the aggregate.
query II
EXPLAIN SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT CAST(count(*) AS INTEGER) FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

# Duplicate owners repeat the state and are combined by the retained outer aggregate.
statement ok
CREATE TABLE reuse_duplicate_owner AS SELECT * FROM reuse_owner UNION ALL SELECT * FROM reuse_owner

query II
EXPLAIN SELECT o.k, sum(f.v)
FROM reuse_duplicate_owner o JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k
----
physical_plan	<!REGEX>:(?s).*reuse_fact.*reuse_fact.*

query II
EXPLAIN SELECT o.k, sum(f.v)
FROM reuse_duplicate_owner o JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k
----
physical_plan	<REGEX>:.*combine_aggr.*

query II rowsort
SELECT o.k, sum(f.v)
FROM reuse_duplicate_owner o JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
