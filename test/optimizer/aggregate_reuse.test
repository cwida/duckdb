# NULL aggregate results remain NULL when carried through the inner join.
query IIT rowsort
SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) IS NULL)
GROUP BY o.k, d.label
----
4	d	NULL

# A key can determine the output label without making the label a unique grouping key.
query II
EXPLAIN SELECT d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY d.label
----
physical_plan	<!REGEX>:(?s).*reuse_fact.*reuse_fact.*

query IT
