statement ok
SET explain_output = 'physical_only'

# The baseline scans the fact table once for the SEMI join and again for the outer aggregate.
statement ok
SET disabled_optimizers = 'aggregate_reuse'

query II
EXPLAIN SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
physical_plan	<REGEX>:(?s).*reuse_fact.*reuse_fact.*

statement ok
RESET disabled_optimizers

# The grouped state replaces the outer fact scan while an upper combine preserves owner multiplicity.
query II
EXPLAIN SELECT o.k, d.label, sum(f.v)
FROM reuse_owner o JOIN reuse_dim d ON o.dim_id = d.id JOIN reuse_fact f USING (k)
WHERE o.k IN (SELECT k FROM reuse_fact GROUP BY k HAVING sum(v) > 25)
GROUP BY o.k, d.label
----
