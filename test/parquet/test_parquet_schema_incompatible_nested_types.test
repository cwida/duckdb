Binder Error: Failed to map file-column of type 'MAP(INTEGER, INTEGER)' to result-column of type 'INTEGER[]'

# The same check applies recursively, including when projecting a struct child.
statement error
SELECT x.a FROM read_parquet(
	'{TEST_DIR}/incompatible_nested_types.parquet',
	schema=map {
		'nested': {name: 'x', type: 'STRUCT(a STRUCT(b INTEGER))', default_value: NULL,
			children: map {
				'a': {name: 'a', type: 'STRUCT(b INTEGER)', default_value: NULL,
					children: map {'b': {name: 'b', type: 'INTEGER', default_value: NULL}}}
			}}
	}
);
----
Binder Error: Failed to map file-column of type 'INTEGER[]' to result-column of type 'STRUCT(b INTEGER)'
