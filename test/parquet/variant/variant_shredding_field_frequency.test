# name: test/parquet/variant/variant_shredding_field_frequency.test
# description: Only the 32 most frequent object fields are shredded when writing Parquet
# group: [variant]

require parquet

require json

# Every object has the same two fields - both are shredded
statement ok
COPY (SELECT {'a': i, 'b': 'value_' || i::VARCHAR}::VARIANT AS col FROM range(100) t(i))
TO '{TEST_DIR}/variant_frequency_homogeneous.parquet' (FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_homogeneous.parquet') WHERE name IN ('a', 'b')
----
2

query I
SELECT SUM(col.a::BIGINT) FROM '{TEST_DIR}/variant_frequency_homogeneous.parquet'
----
4950

# Every row adds a key that occurs in that single row only - the shredded type is capped at 32 fields, so only the
# keys that sort first are shredded and the rest stay out of it
statement ok
COPY (SELECT json_object('a', i, 'b', 'value_' || i::VARCHAR, 'k' || i::VARCHAR, i)::VARIANT AS col FROM range(1000) t(i))
TO '{TEST_DIR}/variant_frequency_long_tail.parquet' (FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_long_tail.parquet') WHERE regexp_matches(name,
	'^k[0-9]+$')
----
30

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_long_tail.parquet') WHERE name IN ('a', 'b')
----
2

# Keys that did not make the cut are still readable, they are served from the 'value' column
query I
SELECT col.k42::BIGINT FROM '{TEST_DIR}/variant_frequency_long_tail.parquet' WHERE col.a = 42
----
42

query I
SELECT SUM(TRY_CAST(col.k7 AS BIGINT)) FROM '{TEST_DIR}/variant_frequency_long_tail.parquet'
----
7

query I
SELECT COUNT(DISTINCT col::VARCHAR) FROM '{TEST_DIR}/variant_frequency_long_tail.parquet'
----
1000

# 'half' occurs in 50% of the objects - it is shredded like any other field
statement ok
COPY (SELECT CASE WHEN i % 2 = 0 THEN json_object('a', i, 'b', 'value_' || i::VARCHAR, 'half', i)
	ELSE json_object('a', i, 'b', 'value_' || i::VARCHAR) END::VARIANT AS col FROM range(100) t(i))
TO '{TEST_DIR}/variant_frequency_half.parquet' (FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_half.parquet') WHERE name = 'half'
----
1

query I
SELECT SUM(col.half::BIGINT) FROM '{TEST_DIR}/variant_frequency_half.parquet'
----
2450

# There is no presence threshold: a field occurring in 0.9% of the objects is still shredded
statement ok
COPY (SELECT CASE WHEN i < 9 THEN json_object('a', i, 'rare', i) ELSE json_object('a', i) END::VARIANT AS col
	FROM range(1000) t(i)) TO '{TEST_DIR}/variant_frequency_rare.parquet' (FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_rare.parquet') WHERE name = 'rare'
----
1

query I
SELECT SUM(col.rare::BIGINT) FROM '{TEST_DIR}/variant_frequency_rare.parquet'
----
36

# Objects with many frequent fields are capped - only the 32 most frequent fields are shredded
statement ok
COPY (SELECT obj::JSON::VARIANT AS col FROM range(100) t(i), (SELECT '{' || string_agg('"f' || j::VARCHAR || '":' ||
	j::VARCHAR, ',') || '}' AS obj FROM range(40) t2(j)) o) TO '{TEST_DIR}/variant_frequency_cap.parquet'
(FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_cap.parquet') WHERE regexp_matches(name,
	'^f[0-9]+$')
----
32

# The fields that did not make the cut are still readable, they are served from the 'value' column
query I
SELECT COUNT(*) FROM (SELECT col.f39::BIGINT FROM '{TEST_DIR}/variant_frequency_cap.parquet')
----
100

query I
SELECT SUM(col.f39::BIGINT) FROM '{TEST_DIR}/variant_frequency_cap.parquet'
----
3900

query I
SELECT COUNT(DISTINCT col::VARCHAR) FROM '{TEST_DIR}/variant_frequency_cap.parquet'
----
1

# 'inner' is shredded, and so is the nested 'rare' field (0.5% of the inner objects) - there is room left in the cap
statement ok
COPY (SELECT json_object('a', i, 'inner', CASE WHEN i < 5 THEN json_object('x', i, 'rare', i) ELSE json_object('x',
	i) END)::VARIANT AS col FROM range(1000) t(i)) TO '{TEST_DIR}/variant_frequency_nested.parquet' (FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_nested.parquet') WHERE name IN ('inner', 'x', 'rare')
----
3

query II
SELECT col.inner.x::BIGINT, TRY_CAST(col.inner.rare AS BIGINT)
FROM '{TEST_DIR}/variant_frequency_nested.parquet' WHERE col.a = 3
----
3	3

query II
SELECT col.inner.x::BIGINT, TRY_CAST(col.inner.rare AS BIGINT)
FROM '{TEST_DIR}/variant_frequency_nested.parquet' WHERE col.a = 42
----
42	NULL

# An object without any fields cannot be shredded - this must not fail
statement ok
COPY (SELECT '{}'::JSON::VARIANT AS col FROM range(10) t(i)) TO '{TEST_DIR}/variant_frequency_empty.parquet'
(FORMAT parquet);

query I
SELECT COUNT(*) FROM parquet_schema('{TEST_DIR}/variant_frequency_empty.parquet') WHERE name = 'typed_value'
----
0

query I
SELECT COUNT(DISTINCT col::VARCHAR) FROM '{TEST_DIR}/variant_frequency_empty.parquet'
----
1
