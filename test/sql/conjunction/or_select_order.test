# name: test/sql/conjunction/or_select_order.test
# description: Test that OR filters return the correct rows in order
# group: [conjunction]

statement ok
SET threads=1;

statement ok
CREATE TABLE ints AS
SELECT
    i,
    CASE WHEN i % 13 = 0 THEN NULL ELSE i % 1000 END AS v,
    CASE WHEN i % 17 = 0 THEN NULL ELSE i % 7 END AS w
FROM range(10000) t(i);

# v < 250 OR v >= 750
query II
SELECT (SELECT count(*) FROM ints WHERE v < 250 OR v >= 750), sum(((v < 250 OR v >= 750) IS TRUE)::INT) FROM ints
----
4616	4616

query I
SELECT list(i) = list(i ORDER BY i) FROM ints WHERE v < 250 OR v >= 750
----
true

query I
SELECT (SELECT sum(i) FROM ints WHERE v < 250 OR v >= 750) = sum(CASE WHEN (v < 250 OR v >= 750) IS TRUE THEN i ELSE 0 END) FROM ints
----
true

# v < 100 OR v BETWEEN 300 AND 400 OR w = 3
query II
SELECT (SELECT count(*) FROM ints WHERE v < 100 OR v BETWEEN 300 AND 400 OR w = 3), sum(((v < 100 OR v BETWEEN 300 AND 400 OR w = 3) IS TRUE)::INT) FROM ints
----
2947	2947

query I
SELECT list(i) = list(i ORDER BY i) FROM ints WHERE v < 100 OR v BETWEEN 300 AND 400 OR w = 3
----
true

query I
SELECT (SELECT sum(i) FROM ints WHERE v < 100 OR v BETWEEN 300 AND 400 OR w = 3) = sum(CASE WHEN (v < 100 OR v BETWEEN 300 AND 400 OR w = 3) IS TRUE THEN i ELSE 0 END) FROM ints
----
true

