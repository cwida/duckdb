# ONE ROW PER MATCH reports the partitioning followed by the measures
query III
from test MATCH_RECOGNIZE(
    PARTITION BY p
    ORDER BY o
    MEASURES A.v AS a_val, B.v as b_val
    PATTERN (A B)
    DEFINE A as v/10 > 0.12 , B as (v2-10)/10 > 0.22) order by p
----
2	2.1	2.2