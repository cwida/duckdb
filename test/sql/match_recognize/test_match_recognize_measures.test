# name: test/sql/match_recognize/test_match_recognize_measures.test
# description: MATCH_RECOGNIZE MEASURES - variable scoped references, aggregates, CLASSIFIER, MATCH_NUMBER
# group: [match_recognize]

statement ok
pragma threads=1;

statement ok
create table ev(i integer, v integer);

# PATTERN (A B+) matches rows 1-3 and 4-5; row 6 starts no match
statement ok
insert into ev values (1,1),(2,0),(3,0),(4,1),(5,0),(6,1);

# ONE ROW PER MATCH sees the finished match, so a variable reference is the last row it matched
query IIII
SELECT a_val, b_val, mn, cl FROM ev MATCH_RECOGNIZE(
    ORDER BY i
    MEASURES A.i AS a_val, B.i AS b_val, MATCH_NUMBER() AS mn, CLASSIFIER() AS cl
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY a_val
----
1	3	1	B
4	5	2	B

# ALL ROWS PER MATCH reports progress, so a variable reference only sees the match so far
query IIIII
SELECT i, a_val, b_val, mn, cl FROM ev MATCH_RECOGNIZE(
    ORDER BY i
    MEASURES A.i AS a_val, B.i AS b_val, MATCH_NUMBER() AS mn, CLASSIFIER() AS cl
    ALL ROWS PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY i
----
1	1	NULL	1	A
2	1	2	1	B
3	1	3	1	B
4	4	NULL	2	A
5	4	5	2	B

# aggregates span the match
query II
SELECT c, s FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS c, sum(i) AS s
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY s
----
3	6
2	9

# and accumulate row by row under ALL ROWS PER MATCH
query III
SELECT i, c, s FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS c, sum(i) AS s
    ALL ROWS PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY i
----
1	1	1
2	2	3
3	3	6
4	1	4
5	2	9

# inside an aggregate a variable restricts the aggregate to the rows it matched
query III
SELECT bc, bs, asum FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(B.i) AS bc, sum(B.i) AS bs, sum(A.i) AS asum
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY asum
----
2	5	1
1	5	4

# measures may be arbitrary expressions over variable references
query II
SELECT s, d FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES A.i + B.i AS s, B.i - A.i AS d
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY s
----
4	2
9	1

# a measure need not reference any pattern variable at all
query I
SELECT x FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i*10 AS x
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
30
50

# a table qualifier is not a pattern variable
query I
SELECT x FROM ev AS t MATCH_RECOGNIZE(
    ORDER BY i MEASURES t.i AS x
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3
5

statement ok
create table im(i integer);

statement ok
insert into im values (1),(2);

# a symbol used in the pattern but never defined can still be measured
query I
SELECT z_val FROM im MATCH_RECOGNIZE(
    ORDER BY i MEASURES Z.i AS z_val
    ONE ROW PER MATCH PATTERN (A Z) DEFINE A as true
) ORDER BY z_val
----
2

statement ok
create table pv(p integer, i integer);

statement ok
insert into pv values (1,1),(1,2),(1,3),(1,4),(2,1),(2,2);

# measures are scoped to a match, not to the whole partition
query III
SELECT p, s, mn FROM pv MATCH_RECOGNIZE(
    PARTITION BY p ORDER BY i MEASURES sum(i) AS s, MATCH_NUMBER() AS mn
    ONE ROW PER MATCH PATTERN (A B) DEFINE A as true, B as true
) ORDER BY p, mn
----
1	3	1
1	7	2
2	3	1

# the DEFINE columns are an implementation detail and do not reach the output
query I
SELECT count(*) FROM (
    SELECT * FROM ev MATCH_RECOGNIZE(
        ORDER BY i MEASURES A.i AS a_val ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
    )
) WHERE false
----
0

statement error
SELECT __mr_define_A FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES A.i AS a_val ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
)
----
<REGEX>:Binder Error.*__mr_define_A.*

# CLASSIFIER() inside DEFINE
# The row a DEFINE is deciding on is tentatively assigned to the symbol being defined, so
# CLASSIFIER() is that symbol.

query I
SELECT x FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as CLASSIFIER()='A'
) ORDER BY x
----
1
2
3
4
5
6

# ... and it is never any other symbol
query I
SELECT count(*) FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as CLASSIFIER()='B'
)
----
0

query I
SELECT count(*) FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A B) DEFINE A as v=1, B as CLASSIFIER()='A'
)
----
0

# each DEFINE sees its own symbol, so this matches the same rows as the plain conditions
query I
SELECT x FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A B+)
    DEFINE A as v=1 AND CLASSIFIER()='A', B as v=0 AND CLASSIFIER()='B'
) ORDER BY x
----
3
5

query II
SELECT i, cl FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER() AS cl ALL ROWS PER MATCH PATTERN (A B)
    DEFINE A as v=1 AND CLASSIFIER()='A', B as v=0
) ORDER BY i
----
1	A
2	B
4	A
5	B

# MATCH_NUMBER() inside DEFINE
# The conditions are evaluated by the matcher, so they can see the match being assembled. A condition
# that stops holding once enough matches were found bounds how many are reported.

statement ok
create table q(i integer);

statement ok
insert into q values (1),(2),(3),(4),(5),(6);

query I
SELECT x FROM q MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as MATCH_NUMBER()=1
) ORDER BY x
----
1

query I
SELECT x FROM q MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as MATCH_NUMBER()<=2
) ORDER BY x
----
1
2

# it composes with conditions over the input
query I
SELECT x FROM q MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as i%2=1 AND MATCH_NUMBER()<=2
) ORDER BY x
----
1
3

# a multi row pattern is bounded the same way
query I
SELECT x FROM q MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A A) DEFINE A as MATCH_NUMBER()<=2
) ORDER BY x
----
2
4

# DEFINE and MEASURES agree on the number
query I
SELECT mn FROM q MATCH_RECOGNIZE(
    ORDER BY i MEASURES MATCH_NUMBER() AS mn PATTERN (A) DEFINE A as MATCH_NUMBER()<=2
) ORDER BY mn
----
1
2

statement ok
create table mp(p integer, i integer);

statement ok
insert into mp values (1,1),(1,2),(1,3),(2,1),(2,2),(2,3);

# numbering restarts per partition, so each partition reports its own first two matches
query II
SELECT p, x FROM mp MATCH_RECOGNIZE(
    PARTITION BY p ORDER BY i MEASURES i AS x PATTERN (A) DEFINE A as MATCH_NUMBER()<=2
) ORDER BY p, x
----
1	1
1	2
2	1
2	2

# an aggregate over a pattern variable reads the rows that variable matched. Passing the other rows in
# as NULL is not the same thing: an aggregate that keeps NULLs, or an argument that replaces them,
# would see them.
query III
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES list(A.x) AS xs, count(A.x) AS n, sum(coalesce(A.x, 100)) AS s
    PATTERN (A B)
 DEFINE A AS true)
----
[1]	1	1

# an aggregate reads the rows of one variable
statement error
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(A.x + B.x) AS s PATTERN (A B)
 DEFINE A AS true)
----
<REGEX>:Binder Error:.*aggregate in MEASURES reads the rows of one pattern variable.*

# a condition that reads MATCH_NUMBER() has no answer until there is a candidate match to read it
# from, so it must not be evaluated as the rows arrive
query I
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n
    PATTERN (A) DEFINE A AS CAST(1.0 / MATCH_NUMBER() AS INTEGER) = 1
)
----
1

# an ordered aggregate keeps its own ordering
query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES list(x ORDER BY x DESC) AS xs PATTERN (A+)
 DEFINE A AS true)
----
[3, 2, 1]

query I
FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES list(A.x ORDER BY A.x DESC) AS xs PATTERN (A+)
 DEFINE A AS true)
----
[3, 2, 1]

# an empty match covers no rows, so a measure has none to read a column from
query II
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES x AS bare, LAST(x) AS navigated
    PATTERN (A*) DEFINE A AS false
)
----
NULL	NULL

# count() over an empty match is still 0 rather than NULL
query II
FROM (VALUES (1)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n, MATCH_NUMBER() AS mn
    PATTERN (A*) DEFINE A AS false
)
----
0	1

# The filter of an aggregate says which of the match's rows it sees, so it reads the match the way
# every other MEASURES expression does.
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(x) FILTER (WHERE CLASSIFIER()='A') AS s
    PATTERN (A B)
 DEFINE A AS true)
----
10

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(CASE WHEN CLASSIFIER()='A' THEN x END) AS s
    PATTERN (A B)
 DEFINE A AS true)
----
10

query I
FROM (VALUES (10), (20), (30)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(x) FILTER (WHERE MATCH_NUMBER() = 1) AS s
    PATTERN (A+)
 DEFINE A AS true)
----
60

# a variable named in a filter scopes the aggregate the way one named in an argument does - count(*)
# names no column of its own, so the filter is the only thing saying which rows are counted
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES count(*) FILTER (WHERE B.x > 15) AS s
    PATTERN (A B) DEFINE B AS x > 15
)
----
1

query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(B.x) FILTER (WHERE B.x > 15) AS s
    PATTERN (A B) DEFINE B AS x > 15
)
----
20

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x
    MEASURES sum(A.x) FILTER (WHERE B.x > 15) AS s
    PATTERN (A B) DEFINE B AS x > 15
)
----
reads the rows of one pattern variable

statement ok
CREATE MACRO m_two(v) AS sum(v) + count(v);

statement ok
CREATE MACRO m_sum(v) AS sum(v);

# MEASURES are bound by a binder of their own, so what MATCH_RECOGNIZE adds to an expression is
# decided at the same point as what SQL already means by it. Everything else about a measure is
# ordinary binding, and stays available.

query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES (SELECT 42) AS s PATTERN (A+)
 DEFINE A AS true)
----
42

query I
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES (SELECT max(y) FROM (VALUES (5)) u(y) WHERE y > x) AS s PATTERN (A+)
 DEFINE A AS true)
----
5

query I
FROM (VALUES ([1, 2])) t(x) MATCH_RECOGNIZE (
    MEASURES unnest(x) AS u PATTERN (A)
 DEFINE A AS true)
----
1
2

query II
FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES row_number() OVER () AS r ALL ROWS PER MATCH PATTERN (A+)
 DEFINE A AS true)
----
1	1
2	2

# the aggregate reaches the frame only once the ordinary binder has resolved what it is, so a macro
# needs no pass of its own here
query I
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES m_two(x) AS s PATTERN (A+)
 DEFINE A AS true)
----
32

query I
FROM (VALUES (10), (20), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES m_sum(DISTINCT x) AS s PATTERN (A+)
 DEFINE A AS true)
----
30

query I
FROM (VALUES (10), (20), (30)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES list(x ORDER BY x DESC) AS s PATTERN (A+)
 DEFINE A AS true)
----
[30, 20, 10]

statement error
FROM (VALUES (10), (20)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(A.x + B.x) AS s PATTERN (A B) DEFINE B AS x > 15
)
----
reads the rows of one pattern variable
