aggregate functions cannot reference lambda parameters

# a window function in DEFINE is computed below the matcher, over the rows of the input
query I
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda x: lag(list_transform(l, lambda y: y + c)[1]) OVER (ORDER BY c))[1] IS NULL)
----
1

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda x: lag(list_transform(l, lambda y: y + x)[1]) OVER (ORDER BY c))[1] IS NULL)
----
window functions cannot reference lambda parameters

query I rowsort
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda x: m(c, x))[1] < 40)
----
1
2

# A navigation reads a row of the match, which is computed below the matcher - outside the lambda as well
query I
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda x: FIRST(list_transform(l, lambda y: y + c)[1]))[1] < 20)
----
3

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda x: x + LAST(list_transform(l, lambda y: y + c)[1]))[1] < 30)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY c MEASURES list_transform([1], lambda x: x + FIRST(list_transform(l, lambda y: y + c)[1])) AS s
    PATTERN (A+) DEFINE A AS true)
