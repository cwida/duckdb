# single row partition
query III
SELECT p, mno, len
FROM odd MATCH_RECOGNIZE (
  PARTITION BY p ORDER BY k
  MEASURES MATCH_NUMBER() AS mno, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A{2})
  DEFINE A AS 1 = 1
) ORDER BY p, mno
----
2	1	2
3	1	2
4	1	2

# nothing matches
query III
SELECT p, mno, len
FROM odd MATCH_RECOGNIZE (
  PARTITION BY p ORDER BY k
  MEASURES MATCH_NUMBER() AS mno, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+)
  DEFINE A AS v > 100
) ORDER BY p, mno
----

# prev before partition start
query IITT
SELECT g, seq, p2, n2
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES PREV(seq, 2) AS p2, NEXT(seq, 2) AS n2
  ALL ROWS PER MATCH
  PATTERN (A+)
  DEFINE A AS 1 = 1
) ORDER BY g, seq
----
1	1	NULL	3
1	2	NULL	4
1	3	1	5
1	4	2	NULL
1	5	3	NULL
2	1	NULL	3
2	2	NULL	NULL
2	3	1	NULL
3	1	NULL	NULL

# exclusion of whole pattern
query IIIT
SELECT g, seq, mno, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ({- A+ -})
  DEFINE A AS c = 'a'
) ORDER BY g, seq
----

# exclusion then tail
query IIIT
SELECT g, seq, mno, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A {- B -} A)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, seq
----
1	2	1	A
1	4	1	A

# subset of one
query III
SELECT g, first_seq, last_u
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES FIRST(seq) AS first_seq, LAST(U.seq) AS last_u
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B?)
  SUBSET U = (A)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, first_seq
----
1	1	2
1	4	4
3	1	1

# subset with offset
query IIIT
SELECT g, first_seq, u0, u1
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES FIRST(seq) AS first_seq, LAST(U.seq, 0) AS u0, LAST(U.seq, 1) AS u1
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ((A | B)+)
  SUBSET U = (A, B)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, first_seq
----
1	1	4	3
2	1	3	2
3	1	1	NULL

# overlapping matches all rows
query IIIT
SELECT g, seq, mno, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP TO NEXT ROW
  PATTERN (A A)
  DEFINE A AS 1 = 1
) ORDER BY g, mno, seq
----
1	1	1	A
1	2	1	A
1	2	2	A
1	3	2	A
1	3	3	A
1	4	3	A
1	4	4	A
1	5	4	A
2	1	1	A
2	2	1	A
2	2	2	A
2	3	2	A

# navigation far offsets
query IITTT
SELECT g, seq, p9, f9, l9
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES PREV(seq, 9) AS p9, FIRST(seq, 9) AS f9, LAST(seq, 9) AS l9
  ALL ROWS PER MATCH
  PATTERN (A+)
  DEFINE A AS 1 = 1
) ORDER BY g, seq
----
1	1	NULL	NULL	NULL
1	2	NULL	NULL	NULL
1	3	NULL	NULL	NULL
1	4	NULL	NULL	NULL
1	5	NULL	NULL	NULL
2	1	NULL	NULL	NULL
2	2	NULL	NULL	NULL
2	3	NULL	NULL	NULL
3	1	NULL	NULL	NULL

# measure aggregates
query TIIII
SELECT sym, n, mn, mx, sm
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES COUNT(*) AS n, MIN(price) AS mn, MAX(price) AS mx, SUM(price) AS sm
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A{3})
  DEFINE A AS 1 = 1
) ORDER BY sym, n, mn
----
AAA	3	3	15	27
AAA	3	5	9	21
AAA	3	6	10	24
AAA	3	9	12	33
BBB	3	4	5	13
BBB	3	6	7	13

# aggregate over unmatched variable
query IITIT
SELECT g, first_seq, sum_b, cnt_b, min_b
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES FIRST(seq) AS first_seq, SUM(B.seq) AS sum_b, COUNT(B.seq) AS cnt_b, MIN(B.seq) AS min_b
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B?)
  DEFINE A AS c = 'a', B AS c = 'z'
) ORDER BY g, first_seq
----
1	1	NULL	0	NULL
1	4	NULL	0	NULL
3	1	NULL	0	NULL

# aggregate of subset
query IIII
SELECT g, first_seq, sum_u, cnt_u
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES FIRST(seq) AS first_seq, SUM(U.seq) AS sum_u, COUNT(U.seq) AS cnt_u
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ((A | B)+)
  SUBSET U = (A, B)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, first_seq
----
1	1	10	4
2	1	6	3
3	1	1	1

# classifier reports the variable
query IIT
SELECT g, seq, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ((A | B)+)
  SUBSET U = (A, B)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, seq
----
1	1	A
1	2	A
1	3	B
1	4	A
2	1	B
2	2	B
2	3	B
3	1	A

# match number per partition
query III
SELECT g, mno, first_seq
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, FIRST(seq) AS first_seq
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A)
  DEFINE A AS 1 = 1
) ORDER BY g, mno
----
1	1	1
1	2	2
1	3	3
1	4	4
1	5	5
2	1	1
2	2	2
2	3	3
3	1	1

# alternation same variable
query IIT
SELECT g, seq, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ((A | A)+)
  DEFINE A AS 1 = 1
) ORDER BY g, seq
----
