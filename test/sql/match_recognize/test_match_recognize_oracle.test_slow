# exclusion
query TIITI
SELECT sym, ts, mno, cls, fin_cnt
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls, FINAL COUNT(*) AS fin_cnt
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN ({- STRT -} DOWN+ UP+)
  DEFINE DOWN AS price < PREV(price), UP AS price > PREV(price)
) ORDER BY sym, ts
----
AAA	2	1	DOWN	5
AAA	3	1	DOWN	5
AAA	4	1	UP	5
AAA	5	1	UP	5
AAA	7	2	DOWN	4
AAA	8	2	DOWN	4
AAA	9	2	UP	4
AAA	11	3	DOWN	3
AAA	12	3	UP	3

# subset measure
query TIII
SELECT sym, first_ts, last_du, len
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES FIRST(ts) AS first_ts, LAST(DU.ts) AS last_du, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (STRT DOWN+ UP+)
  SUBSET DU = (DOWN, UP)
  DEFINE DOWN AS price < PREV(price), UP AS price > PREV(price)
) ORDER BY sym, first_ts
----
AAA	1	5	5
AAA	6	9	4
AAA	10	12	3

