# exclusion inside quantifier
query IIIT
SELECT g, seq, mno, cls
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A ({- B -})+ A)
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, seq
----
1	2	1	A
1	4	1	A

# exclusion at the end
query IIITI
SELECT g, seq, mno, cls, fin
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, CLASSIFIER() AS cls, FINAL COUNT(*) AS fin
  ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ {- B -})
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, seq
----
1	1	1	A	3
1	2	1	A	3

# permute repeated argument
query IIII
SELECT g, mno, first_seq, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, FIRST(seq) AS first_seq, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (PERMUTE(A, A))
  DEFINE A AS 1 = 1
) ORDER BY g, mno
----
1	1	1	2
1	2	3	2
2	1	1	2

# permute of quantified
query IIII
SELECT g, mno, first_seq, len
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, FIRST(seq) AS first_seq, COUNT(*) AS len
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (PERMUTE(A+, B))
  DEFINE A AS c = 'a', B AS c = 'b'
) ORDER BY g, mno
----
1	1	1	3

# order by varchar
query ITI
SELECT g, c, pos
FROM evt MATCH_RECOGNIZE (
  PARTITION BY g ORDER BY c, seq
  MEASURES COUNT(*) AS pos
  ALL ROWS PER MATCH
  PATTERN (A+)
  DEFINE A AS 1 = 1
) ORDER BY g, pos
----
1	a	1
1	a	2
1	a	3
1	b	4
1	c	5
2	b	1
2	b	2
2	b	3
3	a	1

# measure across variables
query TII
SELECT sym, span, drop_then_rise
FROM ticks MATCH_RECOGNIZE (
  PARTITION BY sym ORDER BY ts
  MEASURES LAST(UP.ts) - FIRST(STRT.ts) AS span,
           (LAST(DOWN.price) - FIRST(STRT.price)) + (LAST(UP.price) - LAST(DOWN.price)) AS drop_then_rise
  ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
  PATTERN (STRT DOWN+ UP+)
  DEFINE DOWN AS price < PREV(price), UP AS price > PREV(price)
) ORDER BY sym, span
----
AAA	2	6
AAA	3	-3
AAA	4	2
