# name: test/sql/match_recognize/test_match_recognize_spec.test
# description: The worked examples of ISO/IEC 19075-5, with the result tables the standard prints
# group: [match_recognize]

# Every query below is copied from the standard and every expected result is the table the standard
# prints for it, so a change here is a change in conformance rather than a change in taste. The
# sample data is the Ticker partition of 4.3, "Example of ONE ROW PER MATCH".

statement ok
pragma threads=1;

statement ok
CREATE TABLE Ticker(Symbol VARCHAR, Tradeday DATE, Price INTEGER);

statement ok
INSERT INTO Ticker VALUES
    ('XYZ','2009-06-08',50),('XYZ','2009-06-09',60),('XYZ','2009-06-10',49),
    ('XYZ','2009-06-11',40),('XYZ','2009-06-12',35),('XYZ','2009-06-15',45),
    ('XYZ','2009-06-16',45),('XYZ','2009-06-17',45),('XYZ','2009-06-18',43),
    ('XYZ','2009-06-19',47),('XYZ','2009-06-22',52),('XYZ','2009-06-23',70),
    ('XYZ','2009-06-24',60);

# 4.3 Example of ONE ROW PER MATCH -> Table 2, "Results of ONE ROW PER MATCH"
query IIIIII
SELECT M.Symbol, M.Matchno, M.Startp, M.Bottomp, M.Endp, M.Avgp
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, A.Price AS Startp,
             LAST(B.Price) AS Bottomp, LAST(C.Price) AS Endp, AVG(U.Price) AS Avgp
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A B+ C+) SUBSET U = (A, B, C)
    DEFINE B AS B.Price < PREV(B.Price), C AS C.Price > PREV(C.Price)
) AS M ORDER BY M.Matchno
----
XYZ	1	60	35	45	45.8
XYZ	2	45	43	70	51.4

# 4.4 Example of ALL ROWS PER MATCH -> Table 3, "Results of ALL ROWS PER MATCH"
query IIIIIIII
SELECT M.Matchno, M.Tradeday, M.Price, M.Classy, M.Startp, M.Bottomp, M.Endp, M.Avgp
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, CLASSIFIER() AS Classy, A.Price AS Startp,
             FINAL LAST(B.Price) AS Bottomp, FINAL LAST(C.Price) AS Endp, FINAL AVG(U.Price) AS Avgp
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A B+ C+) SUBSET U = (A, B, C)
    DEFINE B AS B.Price < PREV(B.Price), C AS C.Price > PREV(C.Price)
) AS M ORDER BY M.Tradeday
----
1	2009-06-09	60	A	60	35	45	45.8
1	2009-06-10	49	B	60	35	45	45.8
1	2009-06-11	40	B	60	35	45	45.8
1	2009-06-12	35	B	60	35	45	45.8
1	2009-06-15	45	C	60	35	45	45.8
2	2009-06-17	45	A	45	43	70	51.4
2	2009-06-18	43	B	45	43	70	51.4
2	2009-06-19	47	C	45	43	70	51.4
2	2009-06-22	52	C	45	43	70	51.4
2	2009-06-23	70	C	45	43	70	51.4

# 4.12.2 Handling empty matches -> Table 6, "Result of query permitting empty matches".
# Note the match numbering: an empty match takes a number of its own, so the two non-empty matches
# are numbered 2 and 6 and the run at the end is 10.
query III
SELECT M.Matchno, M.Firstp, M.Lastp
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, FIRST(A.Price) AS Firstp, LAST(A.Price) AS Lastp
    ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A*) DEFINE A AS A.Price > PREV(A.Price)
) AS M ORDER BY M.Matchno
----
1	NULL	NULL
2	60	60
3	NULL	NULL
4	NULL	NULL
5	NULL	NULL
6	45	45
7	NULL	NULL
8	NULL	NULL
9	NULL	NULL
10	47	70
11	NULL	NULL

# 4.12.2 -> Table 7, "Results of query using SHOW EMPTY ROWS"
query IIIII
SELECT M.Matchno, M.Tradeday, M.Price, M.Classy, M.Lastp
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, CLASSIFIER() AS Classy,
             FINAL FIRST(A.Price) AS Firstp, FINAL LAST(A.Price) AS Lastp
    ALL ROWS PER MATCH SHOW EMPTY MATCHES AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A*) DEFINE A AS A.Price > PREV(A.Price)
) AS M ORDER BY M.Tradeday
----
1	2009-06-08	50	NULL	NULL
2	2009-06-09	60	A	60
3	2009-06-10	49	NULL	NULL
4	2009-06-11	40	NULL	NULL
5	2009-06-12	35	NULL	NULL
6	2009-06-15	45	A	45
7	2009-06-16	45	NULL	NULL
8	2009-06-17	45	NULL	NULL
9	2009-06-18	43	NULL	NULL
10	2009-06-19	47	A	70
10	2009-06-22	52	A	70
10	2009-06-23	70	A	70
11	2009-06-24	60	NULL	NULL

# 4.12.2 -> Table 8, "Results of query using OMIT EMPTY ROWS". Note the gaps in the numbering.
query IIII
SELECT M.Matchno, M.Tradeday, M.Price, M.Classy
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, CLASSIFIER() AS Classy
    ALL ROWS PER MATCH OMIT EMPTY MATCHES AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A*) DEFINE A AS A.Price > PREV(A.Price)
) AS M ORDER BY M.Tradeday
----
