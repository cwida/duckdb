# 4.12.3 Handling unmatched rows -> Table 9, "Results of ALL ROWS PER MATCH"
query IIIIII
SELECT M.Matchno, M.Tradeday, M.Price, M.Classy, M.Startp, M.Avgp
FROM Ticker MATCH_RECOGNIZE (
    PARTITION BY Symbol ORDER BY Tradeday
    MEASURES MATCH_NUMBER() AS Matchno, CLASSIFIER() AS Classy, A.Price AS Startp,
             FINAL AVG(U.Price) AS Avgp
    ALL ROWS PER MATCH WITH UNMATCHED ROWS AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A B+ C+) SUBSET U = (A, B, C)
    DEFINE B AS B.Price < PREV(B.Price), C AS C.Price > PREV(C.Price)
) AS M ORDER BY M.Tradeday
----
NULL	2009-06-08	50	NULL	NULL	NULL
1	2009-06-09	60	A	60	45.8
1	2009-06-10	49	B	60	45.8
1	2009-06-11	40	B	60	45.8
1	2009-06-12	35	B	60	45.8
1	2009-06-15	45	C	60	45.8
NULL	2009-06-16	45	NULL	NULL	NULL
2	2009-06-17	45	A	45	51.4
2	2009-06-18	43	B	45	51.4
2	2009-06-19	47	C	45	51.4
2	2009-06-22	52	C	45	51.4
2	2009-06-23	70	C	45	51.4
NULL	2009-06-24	60	NULL	NULL	NULL

# 5.6.3 FIRST and LAST -> the equalities the standard states for Table 15, with A on rows 1, 3, 5
statement ok
CREATE TABLE Nav(i INTEGER, Price INTEGER);

statement ok
INSERT INTO Nav VALUES (1,10),(2,20),(3,30),(4,40),(5,50);

query IIIIIIII
SELECT M.f0, M.f1, M.f2, M.f3, M.l0, M.l1, M.l2, M.l3
FROM Nav MATCH_RECOGNIZE (
    ORDER BY i
    MEASURES FINAL FIRST(A.Price) AS f0, FINAL FIRST(A.Price, 1) AS f1,
             FINAL FIRST(A.Price, 2) AS f2, FINAL FIRST(A.Price, 3) AS f3,
             FINAL LAST(A.Price) AS l0, FINAL LAST(A.Price, 1) AS l1,
             FINAL LAST(A.Price, 2) AS l2, FINAL LAST(A.Price, 3) AS l3
    ONE ROW PER MATCH PATTERN (A B A C A)
    DEFINE A AS Price IN (10, 30, 50), B AS Price = 20, C AS Price = 40
) AS M
----
10	30	50	NULL	50	30	10	NULL

# 4.10 Row pattern variables: the sets a match maps to each variable, including the empty set for a
# variable no row was mapped to, and the union a SUBSET stands for
query IIIII
SELECT M.a, M.b, M.c, M.d, M.s
FROM Nav MATCH_RECOGNIZE (
    ORDER BY i
    MEASURES count(A.Price) AS a, count(B.Price) AS b, count(C.Price) AS c,
             count(D.Price) AS d, count(S.Price) AS s
    ONE ROW PER MATCH PATTERN (A+ (B+ | C+) D) SUBSET S = (B, D)
    DEFINE A AS Price <= 20, B AS Price IN (30, 40), C AS Price = 99, D AS Price = 50
) AS M
----
2	2	0	1	3

# 5.8 MATCH_NUMBER: a condition that reads it makes the matches alternate between A+ and B+
statement ok
CREATE TABLE Alt(i INTEGER, Price INTEGER);

statement ok
INSERT INTO Alt VALUES (1,10),(2,20),(3,15),(4,12),(5,18),(6,25);

query III
SELECT M.i, M.mn, M.cls FROM Alt MATCH_RECOGNIZE (
    ORDER BY i MEASURES MATCH_NUMBER() AS mn, CLASSIFIER() AS cls
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A+ | B+))
    DEFINE A AS (MOD(MATCH_NUMBER(), 2) = 1 AND A.Price > PREV(A.Price)),
           B AS (MOD(MATCH_NUMBER(), 2) = 0 AND B.Price < PREV(B.Price))
) AS M ORDER BY M.i
----
2	1	A
3	2	B
4	2	B
5	3	A
6	3	A

# 7.2.8 Infinite repetitions of empty matches: Perl's stopping rule, so (A??)* terminates and the
# match is B alone rather than an unbounded run of empty matches
query II
SELECT M.i, M.cls FROM Alt MATCH_RECOGNIZE (
    ORDER BY i MEASURES CLASSIFIER() AS cls
    ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW
    PATTERN ((A??)* B) DEFINE A AS false, B AS true
) AS M ORDER BY M.i
----
1	B
2	B
3	B
4	B
5	B
6	B

# 5.6.4 Nesting FIRST and LAST within PREV or NEXT -> Table 16, "Data set and mappings for nesting
# example". The standard walks the evaluation of PREV (LAST (A.Price + A.Tax, 1), 3) through: the rows
# mapped to A are R2, R4 and R6; LAST offsets one in from the end of that set, arriving at R4; PREV
# steps 3 rows back through the partition, arriving at R1; and A.Price + A.Tax is evaluated there,
# giving 10 + 1 = 11 - on a row that is mapped to no variable at all.
statement ok
CREATE TABLE Nest(rn INTEGER, Price INTEGER, Tax INTEGER)

statement ok
INSERT INTO Nest VALUES (1,10,1),(2,20,2),(3,30,3),(4,40,4),(5,50,5),(6,60,6)

query I
SELECT M.s FROM Nest MATCH_RECOGNIZE (
    ORDER BY rn MEASURES PREV(LAST(A.Price + A.Tax, 1), 3) AS s
    PATTERN (A B A C A) DEFINE A AS Price IN (20,40,60), B AS Price = 30, C AS Price = 50
) AS M
----
11
