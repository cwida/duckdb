# name: test/sql/parser/test_deep_expression_chains.test
# description: Operator chains and nested types count towards max_expression_depth while transforming
# group: [parser]

statement ok
SET max_expression_depth=100

# chains build expression trees as deep as they are long, without nesting
statement error
FROM query('SELECT 1' || repeat('::INTEGER', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT [1]' || repeat('[1]', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT ''a''' || repeat('.lower()', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT 1' || repeat(' IS NULL', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT 1 IN (1)' || repeat('::BOOLEAN', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT ''a''' || repeat(' COLLATE nocase', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT TIMESTAMP ''2020-01-01''' || repeat(' AT TIME ZONE ''UTC''', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT ''a''' || repeat(' || ''a''', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT ' || repeat('- ', 150) || '1')
----
Parser Error: Max expression depth limit of 100 exceeded

# chains below the limit work
query I
FROM query('SELECT 1' || repeat('::INTEGER', 50))
----
1

query I
FROM query('SELECT ''a''' || repeat('.lower()', 50))
----
a

query I
FROM query('SELECT 1 IN (1)' || repeat('::BOOLEAN', 50))
----
true

query I
FROM query('SELECT length(''a''' || repeat(' || ''a''', 50) || ')')
----
51

# nested types
statement error
FROM query('SELECT NULL::' || repeat('STRUCT(a ', 150) || 'INTEGER' || repeat(')', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('SELECT NULL::' || repeat('MAP(INTEGER, ', 150) || 'INTEGER' || repeat(')', 150))
----
Parser Error: Max expression depth limit of 100 exceeded

statement error
FROM query('CREATE TABLE deep_struct(c ' || repeat('STRUCT(a ', 150) || 'INTEGER' || repeat(')', 150) || ')')
----
Parser Error: Max expression depth limit of 100 exceeded

query I
FROM query('SELECT x IS NULL FROM (SELECT NULL::' || repeat('STRUCT(a ', 50) || 'INTEGER' || repeat(')', 50) || ' AS x)')
----
true

# nesting and chains add up: neither reaches the limit alone
statement error
FROM query('SELECT ' || repeat('abs(', 60) || 'length(''a''' || repeat(' || ''a''', 60) || ')' || repeat(')', 60))
----
Parser Error: Max expression depth limit of 100 exceeded

query I
FROM query('SELECT ' || repeat('abs(', 30) || 'length(''a''' || repeat(' || ''a''', 30) || ')' || repeat(')', 30))
----
31
