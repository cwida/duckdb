# name: test/sql/parser/unicode_whitespace_error_position.test
# description: Preserve original UTF-8 byte offsets after normalizing Unicode whitespace
# group: [parser]

statement ok
SET errors_as_json=true;

# ASCII space.
statement error
SELECT );
----
"position":"7"

statement error
PREPARE p AS SELECT );
----
"position":"20"

# ASCII space, following a multibyte comment.
statement error
/* é */ SELECT );
----
"position":"16"

statement error
PREPARE p AS /* é */ SELECT );
----
"position":"29"

