# name: test/sql/parser/call_subquery.test
# description: CALL cannot be used as a subquery
# group: [parser]

statement ok
CALL query('SELECT 42')

statement error
FROM (CALL query('SELECT 42'))
----
Parser Error: CALL cannot be used as a subquery, use FROM query('SELECT 42') instead

statement error
FROM (CALL range(3)) SELECT 1
----
CALL cannot be used as a subquery

statement error
FROM (CALL pragma_version())
----
CALL cannot be used as a subquery

statement error
SELECT * FROM range(1), (CALL range(3))
----
CALL cannot be used as a subquery

statement error
FROM (CALL query('SELECT 42')) t
----
CALL cannot be used as a subquery

statement error
FROM (CALL query('SELECT 42')) AS t(x)
----
CALL cannot be used as a subquery

statement error
FROM t: (CALL query('SELECT 42'))
----
CALL cannot be used as a subquery

statement error
FROM ((CALL query('SELECT 42')))
----
CALL cannot be used as a subquery

# a table named call can still be read
statement ok
CREATE TABLE call (x INTEGER)

statement ok
INSERT INTO call VALUES (7)

query I
FROM call
----
7

query I
FROM (call)
----
7

query I
FROM call c(y) SELECT c.y
----
7
