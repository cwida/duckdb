# name: test/sql/parser/nested_join_backtracking.test
# description: Nested joins whose qualifier is missing must fail fast instead of backtracking exponentially (oss-fuzz)
# group: [parser]

statement ok
CREATE TABLE t(e INTEGER);

# a nested join on the right-hand side of a join is parsed as part of that join's table reference
query III
SELECT * FROM (VALUES (1)) t1(a) LEFT JOIN (VALUES (1)) t2(b) JOIN (VALUES (1)) t3(c) ON t2.b = t3.c ON t1.a = t2.b
----
1	1	1

# every aliased table followed by another JOIN can start a nested join; without memoization each one re-parses the
# remainder of the statement, which is exponential in the number of joins (this statement used to run out of memory)
statement error
