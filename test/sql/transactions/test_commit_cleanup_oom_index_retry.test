# name: test/sql/transactions/test_commit_cleanup_oom_index_retry.test
# description: Test that retrying a partially failed post-commit cleanup does not remove deleted rows from an index twice
# group: [transactions]

require no_alternative_verify

require skip_reload

require no_force_storage

require vector_size 2048

statement ok
SET debug_skip_checkpoint_on_commit = true;

statement ok
SET preserve_insertion_order = false;

statement ok
SET threads = 1;

statement ok
SET temp_directory = '{TEST_DIR}/tmp_cleanup_oom_index_retry';

statement ok
SET memory_limit = '6MB';

statement ok
CREATE TABLE t (id INT, s VARCHAR);

statement ok
INSERT INTO t SELECT range, repeat('a', 100) FROM range(5000);

statement ok
CREATE TABLE d (id INT PRIMARY KEY);

statement ok
INSERT INTO d SELECT range FROM range(10);

statement ok
BEGIN TRANSACTION;

# the delete entry precedes the update entries in the undo buffer
statement ok
DELETE FROM d WHERE id < 5;

statement ok
UPDATE t SET s = repeat('b', 100);

# an open reader defers the cleanup and routes the delete's cleanup through deleted_rows_in_use
statement ok con2
BEGIN TRANSACTION;

query I con2
SELECT count(*) FROM d;
----
10

statement ok
SET memory_limit = '3.3MB';

statement ok
COMMIT;

# the cleanup runs now: it removes the deleted rows from deleted_rows_in_use, then fails on the update entries
statement ok con2
COMMIT;

statement ok
SET memory_limit = '10MB';

# any later commit retries the cleanup
statement ok
INSERT INTO d VALUES (100);

query I
SELECT count(*) FROM t WHERE s = repeat('b', 100);
----
5000

query I
SELECT list(id ORDER BY id) FROM d;
----
[5, 6, 7, 8, 9, 100]

statement ok
INSERT INTO d SELECT range FROM range(5);

statement error
INSERT INTO d VALUES (7);
----
Duplicate key "id: 7" violates primary key constraint

query I
SELECT count(*) FROM d;
----
11
