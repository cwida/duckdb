# name: test/sql/function/string/hex_bignum.test
# description: to_hex and to_binary of a BIGNUM print the number, not its storage bytes
# group: [string]

query IIII
SELECT to_hex(256::BIGNUM), to_hex(-256::BIGNUM), bin(5::BIGNUM), to_hex(4294967296::BIGNUM * 4294967296::BIGNUM)
----
100	-100	101	10000000000000000

statement ok
CREATE TABLE numbers AS SELECT i, s::BIGNUM AS v FROM (VALUES (0, '0'), (1, '1'), (2, '15'), (3, '16'), (4, '255'), (5, '256'), (6, '4096'), (7, '81985529216486895'), (8, '9223372036854775808'), (9, '18446744073709551616'), (10, '170141183460469231731687303715884105728'), (11, '340282366920938463463374607431768211456'), (12, '387165715252267757836693082728079159041'), (13, '1606938044258990275541962092341162602522202993782792835301376'), (14, '-1'), (15, '-15'), (16, '-16'), (17, '-255'), (18, '-256'), (19, '-4096'), (20, '-81985529216486895'), (21, '-9223372036854775808'), (22, '-18446744073709551616'), (23, '-170141183460469231731687303715884105728'), (24, '-340282366920938463463374607431768211456'), (25, '-387165715252267757836693082728079159041'), (26, '-1606938044258990275541962092341162602522202993782792835301376')) t(i, s)

