# name: test/sql/function/string/parse_path_separator.test
# description: Test per-row separator options in parse_path
# group: [string]

statement ok
CREATE TABLE paths (id INTEGER, path VARCHAR, separator VARCHAR);

statement ok
INSERT INTO paths VALUES
	(1, 'a/b\c', 'forward_slash'),
	(2, 'a/b\c', 'backslash'),
	(3, 'a/b\c', NULL),
	(4, 'a/b\c', 'both_slash'),
	(5, '', 'backslash'),
	(6, NULL, 'forward_slash'),
	(7, 'a/b\c', ''),
	(8, 'a/b\c', '@');

query IT
SELECT id, parse_path(path, separator) FROM paths ORDER BY id;
----
1	[a, 'b\\c']
2	[a/b, c]
3	[a, b, c]
4	[a, b, c]
5	[]
6	NULL
7	[a, b, c]
8	[a, b, c]

query T
SELECT parse_path('a/b\c', separator)
FROM (VALUES (1, NULL), (2, 'forward_slash'), (3, 'backslash')) t(id, separator)
ORDER BY id;
----
[a, b, c]
[a, 'b\\c']
[a/b, c]

# Constant options and omitted options keep their existing behavior.
query TTT
SELECT parse_path(path), parse_path(path, 'backslash'), parse_path(path, NULL)
FROM paths WHERE id <= 3 ORDER BY id;
----
[a, b, c]	[a/b, c]	[a, b, c]
[a, b, c]	[a/b, c]	[a, b, c]
[a, b, c]	[a/b, c]	[a, b, c]

# A list column prevents the filter from caching and flattening its output.
statement ok
PRAGMA disable_optimizer;

query IT
SELECT id, parse_path(path[1], separator)
FROM (VALUES (0, ['a/b\c'], 'forward_slash'), (1, ['a/b\c'], 'backslash'), (2, ['a/b\c'], NULL)) t(id, path, separator)
WHERE id <> 0 ORDER BY id;
----
1	[a/b, c]
2	[a, b, c]

query IT
SELECT id, parse_path(path[1], separator)
FROM (VALUES (0, ['a/b\c'], NULL), (1, ['a/b\c'], 'forward_slash'), (2, ['a/b\c'], 'backslash')) t(id, path, separator)
WHERE id <> 0 ORDER BY id;
----
1	[a, 'b\\c']
2	[a/b, c]

statement ok
PRAGMA enable_optimizer;

# Alternating options span several chunks, including a final partial chunk.
query I
WITH inputs AS (
	SELECT i, CASE i % 3 WHEN 0 THEN 'forward_slash' WHEN 1 THEN 'backslash' ELSE NULL END AS separator
	FROM range(8193) t(i)
)
SELECT count(*) FROM inputs
WHERE parse_path('a/b\c', separator) IS DISTINCT FROM
	CASE i % 3 WHEN 0 THEN ['a', 'b\c'] WHEN 1 THEN ['a/b', 'c'] ELSE ['a', 'b', 'c'] END;
----
0

# per-row separator and trim options in parse_dirname, parse_dirpath and parse_filename
query IIII
SELECT sep, parse_dirname('a/b\c.txt', sep), parse_dirpath('a/b\c.txt', sep), parse_filename('a/b\c.txt', sep)
FROM (VALUES (1, NULL), (2, 'backslash'), (3, 'forward_slash')) v(id, sep) ORDER BY id
----
NULL	a	a/b	c.txt
backslash	a/b	a/b	c.txt
forward_slash	a	a	b\c.txt

query IIII
SELECT sep, parse_dirname('a/b\c.txt', sep), parse_dirpath('a/b\c.txt', sep), parse_filename('a/b\c.txt', sep)
FROM (VALUES (1, 'backslash'), (2, NULL), (3, 'forward_slash')) v(id, sep) ORDER BY id
----
backslash	a/b	a/b	c.txt
NULL	a	a/b	c.txt
forward_slash	a	a	b\c.txt

query II
SELECT id, parse_filename('a/b\c.txt', trim, sep) FROM (VALUES (1, NULL, 'backslash'), (2, true, NULL), (3, true, 'backslash'), (4, false, 'forward_slash')) v(id, trim, sep) ORDER BY id
----
1	c.txt
2	c
3	c
4	b\c.txt

query I
SELECT parse_dirname(p, 'backslash') FROM (VALUES ('a\b'), (NULL)) v(p)
----
a
NULL
