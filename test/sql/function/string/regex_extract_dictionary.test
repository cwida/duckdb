# name: test/sql/function/string/regex_extract_dictionary.test
# description: Safe regex dictionary reuse preserves UTF-8, selection and expression lifetimes
# group: [string]

statement ok
ATTACH '{TEST_DIR}/regex_extract_dictionary.db' AS regex_db (ROW_GROUP_SIZE 2048)

statement ok
USE regex_db

statement ok
SET force_compression='dictionary'

# Three small row groups cover cross-chunk and cross-row-group dictionary reuse.
statement ok
CREATE TABLE strings AS
SELECT i, CASE i % 3 WHEN 0 THEN 'abcdefghijklé://foo' WHEN 1 THEN 'äabcdefghijk://bar' ELSE NULL END AS s
FROM range(6144) t(i)

statement ok
CHECKPOINT

query I
SELECT count(*) FROM strings WHERE regexp_extract(s, '^([^:]+)://', 1) = 'abcdefghijklé'
----
2048

query II
SELECT count(*) FILTER (WHERE k = 'abcdefghijklé'), count(*) FILTER (WHERE k = 'äabcdefghijk')
FROM (SELECT regexp_extract(s, '^([^:]+)://', 1) AS k FROM strings)
----
2048	2048

query I
SELECT count(*) FROM strings WHERE regexp_extract(s, '^([^:]+)://', 1, 'i') = 'äabcdefghijk'
----
2048

query I
SELECT count(*) FROM strings WHERE regexp_extract(s, '://', 'l') = '://'
----
4096

query I
SELECT count(*) FROM strings WHERE regexp_extract(s, '(missing)', 1, 'k') = s
----
4096

query I
SELECT count(*) FROM strings WHERE s LIKE 'a%' AND regexp_extract(s, '\C') = 'a'
----
2048

query I
SELECT count(TRY(regexp_extract(s, '\C'))) FROM strings
----
2048

statement ok
PREPARE invalid_constant_pattern AS SELECT regexp_extract(s, '[') FROM strings

statement error
EXECUTE invalid_constant_pattern
----
missing ]: [

query I
SELECT count(TRY(regexp_extract(s, CASE i % 3 WHEN 0 THEN '^a' ELSE '[' END))) FROM strings
----
2048

query I
SELECT count(regexp_extract(s, '^([^:]+)://', NULL)) FROM strings
----
4096

query I
SELECT count(*) FROM strings WHERE regexp_extract(s, '^([^:]+)://', ['protocol']).protocol = 'äabcdefghijk'
----
2048
