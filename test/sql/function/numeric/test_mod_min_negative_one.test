# name: test/sql/function/numeric/test_mod_min_negative_one.test
# description: MIN % -1 is 0 for every integer type
# group: [numeric]

query IIIII
SELECT (-128)::TINYINT % (-1)::TINYINT, (-32768)::SMALLINT % (-1)::SMALLINT, (-2147483648)::INTEGER % (-1)::INTEGER,
       (-9223372036854775808)::BIGINT % (-1)::BIGINT, (-170141183460469231731687303715884105728)::HUGEINT % (-1)::HUGEINT
----
0	0	0	0	0

statement ok
CREATE TABLE t(a BIGINT, b BIGINT);

statement ok
INSERT INTO t VALUES (-9223372036854775808, -1), (7, -1), (-9223372036854775808, 3);

query I
SELECT a % b FROM t
----
0
0
-2

# division still overflows
statement error
SELECT (-9223372036854775808)::BIGINT // (-1)::BIGINT;
----
<REGEX>:Out of Range Error.*Overflow in division.*
