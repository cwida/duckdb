# name: test/sql/function/numeric/test_mod.test
# description: Mod test
# group: [numeric]

statement ok
CREATE TABLE modme(a DOUBLE, b INTEGER)

statement ok
INSERT INTO modme VALUES (42.123456, 3)

query R
select mod(a, 40) from modme
----
2.123456

# mod 0 is an error
statement error
select mod(42, 0)
----
<REGEX>:.*Division by zero.*

# unless error_on_division_by_zero is disabled
statement ok
SET error_on_division_by_zero=false;

query I
select mod(42, 0)
----
NULL

statement ok
SET error_on_division_by_zero=true;

query R
select mod(a, 2) from modme
----
0.123456

query R
select mod(b, 2.1) from modme
----
0.900000

