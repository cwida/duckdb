# name: test/sql/function/numeric/setseed_pinned_values.test
# description: After setseed, samples and random functions return the same values as in earlier releases
# group: [numeric]

# the values depend on the vector size, and a reload starts a connection without the seed
require vector_size 2048

require skip_reload

statement ok
SET threads=1

statement ok
SELECT setseed(0.42)

query I
SELECT list(i ORDER BY i) FROM (SELECT * FROM range(100) t(i) USING SAMPLE 5 ROWS)
----
[5, 23, 30, 56, 71]

query I
SELECT list(i ORDER BY i) FROM (SELECT * FROM range(100) t(i) USING SAMPLE 10 PERCENT (reservoir))
----
[1, 6, 13, 21, 25, 28, 42, 68, 71, 94]

query I
SELECT random()
----
0.44176862017860546

query I
SELECT uuid()
----
098fbc2e-a802-4459-ad75-ee51e5a1a256
