# name: test/sql/function/timestamp/test_timestamp_lower_bound.test
# description: Timestamp constructors accept values below the first midnight of the range
# group: [timestamp]

query I
SELECT time_bucket(INTERVAL '1 hour', TIMESTAMP '290309-12-22 (BC) 00:00:00', TIMESTAMP '2000-01-01 00:00:01')::VARCHAR
----
290309-12-21 (BC) 23:00:01

query II
SELECT epoch_ms(-9223372022400001)::VARCHAR, make_timestamp_ms(-9223372022400001)::VARCHAR
----
290309-12-21 (BC) 23:59:59.999	290309-12-21 (BC) 23:59:59.999

query II
SELECT epoch_us(to_timestamp(-9223372022401)), epoch_us(to_timestamp(-9223372036854.775808))
----
-9223372022401000448	-9223372036854775808

# values below the smallest int64 are still rejected
statement error
SELECT epoch_ms(-9223372036854776)
----
Conversion Error: Could not convert Timestamp(MS) to Timestamp(US)

statement error
SELECT to_timestamp(-9223372036855)
----
Conversion Error: Epoch seconds out of range for TIMESTAMP WITH TIME ZONE

query I
SELECT epoch_ms(-9223372022400000)::VARCHAR
----
290309-12-22 (BC) 00:00:00

query I
SELECT to_timestamp(-9223372022400)::VARCHAR
----
290309-12-22 (BC) 00:00:00+00

query I
SELECT time_bucket(INTERVAL '1 hour', TIMESTAMP '2020-01-01 10:30:00', TIMESTAMP '2000-01-01 00:00:01')::VARCHAR
----
2020-01-01 10:00:01
