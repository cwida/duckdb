# name: test/sql/function/timestamp/test_strptime_edge_paths.test
# description: Exercise strptime duplicate offsets, special values and nanosecond conversion edges
# group: [timestamp]

query I
SELECT try_strptime('infinity trailing', '%Y-%m-%d') IS NULL;
----
true

query I
SELECT try_strptime('2024 2023', '%G %G') IS NULL;
----
true

query I
SELECT try_strptime('2024 01 02', '%G %V %V') IS NULL;
----
true

query I
SELECT try_strptime('2024 01 1 2', '%G %V %u %u') IS NULL;
----
true

query I
SELECT try_strptime('2024 01 002', '%G %V %j') IS NULL;
----
true

query I
SELECT try_strptime('   ', '%Z') IS NULL;
----
true

query T
SELECT strptime('infinity', ['%Y-%m-%d %H:%M:%S.%n', '%Y'])::VARCHAR;
----
infinity

query T
SELECT strptime('-infinity', ['%Y-%m-%d %H:%M:%S.%n', '%Y'])::VARCHAR;
----
-infinity

query T
SELECT strptime('epoch', ['%Y-%m-%d %H:%M:%S.%n', '%Y'])::VARCHAR;
----
1970-01-01 00:00:00

query I
SELECT try_strptime('9999-12-31 23:59:59.123456789', '%Y-%m-%d %H:%M:%S.%n') IS NULL;
----
true
