# Before the epoch
query II
SELECT iv, '1962-07-31 12:20:48.123456789Z'::TIMESTAMPTZ_NS + iv FROM intervals;
----
1 year	1963-07-31 05:20:48.123456789-07
-1 year	1961-07-31 05:20:48.123456789-07
1 month	1962-08-31 05:20:48.123456789-07
-1 month	1962-06-30 05:20:48.123456789-07
