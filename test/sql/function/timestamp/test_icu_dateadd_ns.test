-00:00:00.001	1962-07-31 05:20:48.122456789-07
00:00:00.91	1962-07-31 05:20:49.033456789-07
-00:00:00.15	1962-07-31 05:20:47.973456789-07
00:00:00.000001	1962-07-31 05:20:48.123457789-07
-00:00:00.000001	1962-07-31 05:20:48.123455789-07
00:00:00.000612	1962-07-31 05:20:48.124068789-07
-00:00:00.000485	1962-07-31 05:20:48.122971789-07

# The nanoseconds survive borrowing from the microseconds
query II
SELECT '1962-07-31 12:20:48.000000001Z'::TIMESTAMPTZ_NS + INTERVAL '-1 microsecond',
	'1962-07-31 12:20:48.000000001Z'::TIMESTAMPTZ_NS - INTERVAL '1 microsecond';
----
1962-07-31 05:20:47.999999001-07	1962-07-31 05:20:47.999999001-07

# ms overflow
query I
SELECT '1999-12-31 16:00:00.000000001-08'::TIMESTAMPTZ_NS + INTERVAL 2400 hours;
----
2000-04-09 17:00:00.000000001-07

query I
SELECT INTERVAL 2400 hours + '1999-12-31 16:00:00.000000001-08'::TIMESTAMPTZ_NS;
----
2000-04-09 17:00:00.000000001-07

query I
SELECT '2000-04-09 17:00:00.000000001-07'::TIMESTAMPTZ_NS - INTERVAL 2400 hours;
----
1999-12-31 16:00:00.000000001-08

# Non-constant arguments
query I
SELECT make_timestamp_ns(1638366888123456789 + i * 1000000000)::TIMESTAMPTZ_NS + INTERVAL 1 MONTH FROM range(3) t(i);
----
2022-01-01 13:54:48.123456789-08
2022-01-01 13:54:49.123456789-08
2022-01-01 13:54:50.123456789-08

query I
SELECT make_timestamp_ns(-234000000000000000 + i)::TIMESTAMPTZ_NS - INTERVAL 1 MICROSECOND FROM range(-1, 2) t(i);
----
1962-08-02 15:59:59.999998999-07
1962-08-02 15:59:59.999999-07
1962-08-02 15:59:59.999999001-07

# NULLs
query IIIII
SELECT NULL::TIMESTAMPTZ_NS + INTERVAL 1 day, INTERVAL 1 day + NULL::TIMESTAMPTZ_NS, NULL::TIMESTAMPTZ_NS - INTERVAL 1 day,
	'2021-12-01'::TIMESTAMPTZ_NS + NULL::INTERVAL, '2021-12-01'::TIMESTAMPTZ_NS - NULL::INTERVAL;
----
NULL	NULL	NULL	NULL	NULL

# Infinities
query III
SELECT 'infinity'::TIMESTAMPTZ_NS + INTERVAL '1 microsecond',
	INTERVAL '1 microsecond' + 'infinity'::TIMESTAMPTZ_NS,
	'infinity'::TIMESTAMPTZ_NS - INTERVAL '1 day';
----
infinity	infinity	infinity

query III
SELECT '-infinity'::TIMESTAMPTZ_NS + INTERVAL '1 microsecond',
	INTERVAL '1 microsecond' + '-infinity'::TIMESTAMPTZ_NS,
	'-infinity'::TIMESTAMPTZ_NS - INTERVAL '1 day';
----
-infinity	-infinity	-infinity

#
# Limits testing
#
query II
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS, '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS;
----
2262-04-11 16:47:16.854775806-07	1677-09-20 16:19:45.145224192-07:52:58

# Backward from the maximum
query II
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS - INTERVAL 1 microsecond,
	'2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS + INTERVAL (-1) microsecond;
----
2262-04-11 16:47:16.854774806-07	2262-04-11 16:47:16.854774806-07

query II
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS - INTERVAL 1 month,
	'2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS - INTERVAL 1 year;
----
2262-03-11 16:47:16.854775806-07	2261-04-11 16:47:16.854775806-07

# Forward from the maximum
statement error
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS + INTERVAL 1 microsecond;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT INTERVAL 1 microsecond + '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS - INTERVAL (-1) microsecond;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS + INTERVAL 1 day;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '2262-04-11 23:47:16.854775806+00'::TIMESTAMPTZ_NS + INTERVAL 1 month;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

# Forward from the minimum
query II
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS + INTERVAL 1 microsecond,
	'1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS - INTERVAL (-1) microsecond;
----
1677-09-20 16:19:45.145225192-07:52:58	1677-09-20 16:19:45.145225192-07:52:58

query II
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS + INTERVAL 1 month,
	'1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS + INTERVAL 1 year;
----
1677-10-20 16:19:45.145224192-07:52:58	1678-09-20 16:19:45.145224192-07:52:58

# Backward from the minimum
statement error
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS - INTERVAL 1 microsecond;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS + INTERVAL (-1) microsecond;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS - INTERVAL 1 day;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT '1677-09-21 00:12:43.145224192+00'::TIMESTAMPTZ_NS - INTERVAL 1 month;
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

# Intervals that overflow the microsecond timestamp range
statement error
SELECT '2000-01-01'::TIMESTAMPTZ_NS + INTERVAL '9223372036854775807 microseconds';
----
Conversion Error: ICU date overflows timestamp range

statement error
SELECT '2000-01-01'::TIMESTAMPTZ_NS - INTERVAL '9223372036854775807 microseconds';
----
Out of Range Error: Cannot add interval to timestamp_tz_ns

statement error
SELECT TIMESTAMPTZ_NS '2024-01-01 12:00:00+00' - INTERVAL '-4611686018427387904 microseconds -4611686018427387904 microseconds';
----
Interval micros value out of range

# Month arithmetic clamps the day
statement ok
SET TimeZone = 'Asia/Kolkata';

query II
SELECT '2000-01-31 01:02:03.123456789+05:30'::TIMESTAMPTZ_NS + INTERVAL 1 month,
	'2000-03-31 01:02:03.123456789+05:30'::TIMESTAMPTZ_NS - INTERVAL 1 month;
----
2000-02-29 01:02:03.123456789+05:30	2000-02-29 01:02:03.123456789+05:30

# Months before days
query I
SELECT '1920-12-12 01:02:02.123456789+05:30'::TIMESTAMPTZ_NS + INTERVAL '-1 month 400 day';
----
1921-12-17 01:02:02.123456789+05:30

query II
SELECT '1920-12-12 01:02:02.123456789+05:30'::TIMESTAMPTZ_NS + INTERVAL '1 month -400 day',
	'1920-12-12 01:02:02.123456789+05:30'::TIMESTAMPTZ_NS - INTERVAL '-1 month 400 day';
----
1919-12-09 01:02:02.123456789+05:30	1919-12-09 01:02:02.123456789+05:30

# DST arithmetic: days are calendar days, hours are absolute
statement ok
SET TimeZone = 'Europe/London';

query II
SELECT '2000-03-25 12:00:00.000000123+00'::TIMESTAMPTZ_NS + INTERVAL 1 day,
	'2000-03-25 12:00:00.000000123+00'::TIMESTAMPTZ_NS + INTERVAL 24 hours;
----
2000-03-26 12:00:00.000000123+01	2000-03-26 13:00:00.000000123+01

query II
SELECT '2000-10-28 12:00:00.000000123+01'::TIMESTAMPTZ_NS + INTERVAL 1 day,
	'2000-10-28 12:00:00.000000123+01'::TIMESTAMPTZ_NS + INTERVAL 24 hours;
----
2000-10-29 12:00:00.000000123+00	2000-10-29 11:00:00.000000123+00

query II
SELECT '2000-03-26 12:00:00.000000123+01'::TIMESTAMPTZ_NS - INTERVAL 1 day,
	'2000-03-26 12:00:00.000000123+01'::TIMESTAMPTZ_NS - INTERVAL 24 hours;
----
2000-03-25 12:00:00.000000123+00	2000-03-25 11:00:00.000000123+00

query II
SELECT '2000-10-29 12:00:00.000000123+00'::TIMESTAMPTZ_NS - INTERVAL 1 day,
	'2000-10-29 12:00:00.000000123+00'::TIMESTAMPTZ_NS - INTERVAL 24 hours;
----
2000-10-28 12:00:00.000000123+01	2000-10-28 13:00:00.000000123+01
