-00:00:00.000001	2021-12-01 05:54:48.123455789-08
00:00:00.000612	2021-12-01 05:54:48.124068789-08
-00:00:00.000485	2021-12-01 05:54:48.122971789-08

# interval + timestamp is commutative
query II
SELECT iv, iv + '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS FROM intervals
WHERE iv + '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS IS DISTINCT FROM '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS + iv;
----

# timestamp - interval
query II
SELECT iv, '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS - iv FROM intervals;
----
1 year	2020-12-01 05:54:48.123456789-08
-1 year	2022-12-01 05:54:48.123456789-08
