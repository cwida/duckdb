# name: test/sql/function/timestamp/test_icu_dateadd_ns.test
# description: Test ICU TIMESTAMPTZ_NS +/- INTERVAL functionality
# group: [timestamp]

require icu

# Normalise the testing locale
statement ok
SET Calendar = 'gregorian';

statement ok
SET TimeZone = 'America/Los_Angeles';

# Quick syntax check
query I
SELECT '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS + INTERVAL 1 DAY;
----
2021-12-02 05:54:48.123456789-08

# The result keeps the nanosecond precision
query III
SELECT typeof('2021-12-01'::TIMESTAMPTZ_NS + INTERVAL 1 DAY),
	typeof(INTERVAL 1 DAY + '2021-12-01'::TIMESTAMPTZ_NS),
	typeof('2021-12-01'::TIMESTAMPTZ_NS - INTERVAL 1 DAY);
----
TIMESTAMPTZ_NS	TIMESTAMPTZ_NS	TIMESTAMPTZ_NS

# Various intervals
statement ok
CREATE TABLE intervals AS SELECT iv FROM (VALUES
	(INTERVAL 1 year),
	(INTERVAL (-1) year),
	(INTERVAL 1 month),
	(INTERVAL (-1) month),
	(INTERVAL 13 month),
	(INTERVAL (-15) month),
	(INTERVAL 1 day),
	(INTERVAL (-1) day),
	(INTERVAL 32 day),
	(INTERVAL (-40) day),
	(INTERVAL 1 hour),
	(INTERVAL (-1) hour),
	(INTERVAL 11 hour),
	(INTERVAL (-14) hour),
	(INTERVAL 1 minute),
	(INTERVAL (-1) minute),
	(INTERVAL 6 minute),
	(INTERVAL (-72) minute),
	(INTERVAL 1 second),
	(INTERVAL (-1) second),
	(INTERVAL 23 second),
	(INTERVAL (-118) second),
	(INTERVAL 1 millisecond),
	(INTERVAL (-1) millisecond),
	(INTERVAL 910 millisecond),
	(INTERVAL (-150) millisecond),
	(INTERVAL 1 microsecond),
	(INTERVAL (-1) microsecond),
	(INTERVAL 612 microsecond),
	(INTERVAL (-485) microsecond)
) tbl(iv);

# timestamp + interval
query II
SELECT iv, '2021-12-01 13:54:48.123456789Z'::TIMESTAMPTZ_NS + iv FROM intervals;
----
1 year	2022-12-01 05:54:48.123456789-08
-1 year	2020-12-01 05:54:48.123456789-08
1 month	2022-01-01 05:54:48.123456789-08
-1 month	2021-11-01 05:54:48.123456789-07
