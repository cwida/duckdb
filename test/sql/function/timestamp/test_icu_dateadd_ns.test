-01:00:00	1962-07-31 04:20:48.123456789-07
11:00:00	1962-07-31 16:20:48.123456789-07
-14:00:00	1962-07-30 15:20:48.123456789-07
00:01:00	1962-07-31 05:21:48.123456789-07
-00:01:00	1962-07-31 05:19:48.123456789-07
00:06:00	1962-07-31 05:26:48.123456789-07
-01:12:00	1962-07-31 04:08:48.123456789-07
