# name: test/sql/function/language_function/language_function_storage_version.test
# description: Persistent language functions and RETURNS types require storage version v2.1.0
# group: [language_function]

require noforcestorage

statement ok
ATTACH '{TEST_DIR}/language_function_old_version.db' AS old_db (STORAGE_VERSION 'v2.0.0');

statement ok
USE old_db;

statement error
CREATE FUNCTION gated() RETURNS INTEGER LANGUAGE testlang AS '42';
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

# a RETURNS type on a plain macro is gated by the same storage version
statement error
CREATE MACRO gated_macro(x) RETURNS INTEGER AS x + 1;
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

# a plain macro without RETURNS is not gated
statement ok
CREATE MACRO ungated_macro(x) AS x + 1;

# temporary functions are not gated
statement ok
CREATE TEMPORARY FUNCTION ungated() RETURNS INTEGER LANGUAGE testlang AS '42';

statement ok
USE memory;

# in-memory databases are not gated
statement ok
CREATE FUNCTION memory_fun() RETURNS INTEGER LANGUAGE testlang AS '42';

statement ok
DETACH old_db;

# a v2.1.0 database accepts persistent language functions
statement ok
ATTACH '{TEST_DIR}/language_function_new_version.db' AS new_db (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE FUNCTION new_db.main.allowed() RETURNS INTEGER LANGUAGE testlang AS '42';

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'allowed' AND database_name = 'new_db';
----
1

# the gate examines the resolved destination catalog, not the current database:
# a two-part name targeting the old database is rejected from anywhere
statement ok
ATTACH '{TEST_DIR}/language_function_old_version2.db' AS old_db (STORAGE_VERSION 'v2.0.0');

statement error
CREATE FUNCTION old_db.gated_two_part() LANGUAGE testlang AS '42';
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

statement error
CREATE FUNCTION old_db.main.gated_three_part() LANGUAGE testlang AS '42';
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

# ... and a two-part name targeting a new-enough database is accepted while an old one is current
statement ok
USE old_db;

statement ok
CREATE FUNCTION new_db.allowed_two_part() RETURNS INTEGER LANGUAGE testlang AS '42';

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'allowed_two_part' AND database_name = 'new_db';
----
1

statement ok
USE memory;

# nothing gated slipped into the old database
query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'old_db' AND function_name LIKE 'gated%';
----
0

# a serializer targeting an older compatibility version rejects what it cannot represent,
# instead of silently dropping the RETURNS type or the language member
statement ok
SET storage_compatibility_version = 'v2.0.0';

statement ok
SET debug_verify_serializer = true;

statement error
CREATE MACRO gated_verify() RETURNS VARCHAR AS 42;
----
<REGEX>:.*Cannot write a macro with a declared RETURNS type for a storage version below v2\.1\.0.*

statement error
CREATE FUNCTION gated_verify_fun() LANGUAGE testlang AS '42';
----
<REGEX>:.*Cannot write a LANGUAGE function for a storage version below v2\.1\.0.*

statement ok
SET debug_verify_serializer = false;

statement ok
RESET storage_compatibility_version;

# an in-place storage upgrade is durable only at the next checkpoint: when the upgrade is lost
# across a reopen, checkpointing a RETURNS definition errors instead of corrupting it
statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade.db' AS up (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE TABLE up.main.t(i INTEGER);

statement ok
CHECKPOINT up;

statement ok
DETACH up;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE MACRO up.main.m() RETURNS VARCHAR AS 42;

statement ok
DETACH up;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade.db' AS up;

# the WAL replay preserved the declared type
query T
SELECT typeof(up.main.m());
----
VARCHAR

statement error
CHECKPOINT up;
----
<REGEX>:.*Cannot write a macro with a declared RETURNS type for a storage version below v2\.1\.0.*

statement ok
DETACH up;

# re-attaching at v2.1.0 makes the upgrade durable and the definition checkpointable
statement ok
ATTACH '{TEST_DIR}/language_function_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0');

statement ok
CHECKPOINT up;

statement ok
DETACH up;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade.db' AS up;

query T
SELECT typeof(up.main.m());
----
VARCHAR

statement ok
DETACH up;

# member alters committed after an uncheckpointed in-place upgrade replay on a reopen without the
# version: the WAL holds what the upgraded database accepted
statement ok
ATTACH '{TEST_DIR}/language_function_upgrade_members.db' AS upm (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE TABLE upm.main.t(i INTEGER);

statement ok
CHECKPOINT upm;

statement ok
DETACH upm;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade_members.db' AS upm (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE FUNCTION upm.main.f() LANGUAGE otherlang AS 'one';

statement ok
CREATE FUNCTION upm.main.f(x INTEGER) LANGUAGE otherlang AS 'two';

statement ok
CREATE OR REPLACE FUNCTION upm.main.f(x INTEGER) LANGUAGE otherlang AS 'three';

# a member drop record replays as well
statement ok
CREATE FUNCTION upm.main.f(x DATE) LANGUAGE otherlang AS 'dropped';

statement ok
DROP FUNCTION upm.main.f(DATE);

statement ok
DETACH upm;

statement ok
ATTACH '{TEST_DIR}/language_function_upgrade_members.db' AS upm;

query TT rowsort
SELECT parameter_types, macro_definition FROM duckdb_functions() WHERE database_name = 'upm' AND function_name = 'f';
----
[INTEGER]	three
[]	one

# a new member on the reopened database is rejected by the CREATE binder's storage check
statement error
CREATE FUNCTION upm.main.f(x VARCHAR) LANGUAGE otherlang AS 'four';
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

# a member drop at statement time reaches the overload alter gate, which still applies after the replay
statement error
DROP FUNCTION upm.main.f(INTEGER);
----
<REGEX>:.*Dropping a single overload is only supported for storage versions v2\.1\.0 and higher.*

query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'upm' AND function_name = 'f';
----
2
