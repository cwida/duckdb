# name: test/sql/function/list/aggregates/sum_no_overflow.test
# description: Test the sum_no_overflow aggregate function
# group: [aggregates]

# binding sum_no_overflow by name delegates to the regular sum
query I
SELECT sum_no_overflow(42)
----
42

query I
SELECT sum_no_overflow(42.5)
----
42.5

query II
SELECT typeof(sum_no_overflow(42::BIGINT)), typeof(sum_no_overflow(42.5))
----
HUGEINT	DECIMAL(38,1)

query I
SELECT sum_no_overflow(i::SMALLINT) FROM range(10) t(i)
----
45
