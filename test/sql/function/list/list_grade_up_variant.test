# name: test/sql/function/list/list_grade_up_variant.test
# description: list_grade_up / list_sort should error (not crash) on non-LIST arguments
# group: [list]

# VARIANT is matched by the LIST(ANY) signature without a cast - must not segfault
statement error
SELECT list_grade_up(CAST({'a': 1, 'z': regexp_matches('q', repeat(chr(81), 224) || chr(96)||chr(59)||chr(120)||chr(3)||chr(0)||chr(0)||chr(0))} AS VARIANT))
----
list_grade_up can only operate on LISTs

statement error
SELECT list_grade_up(CAST({'a': 1, 'z': 2} AS VARIANT))
----
list_grade_up can only operate on LISTs

statement error
SELECT list_sort(CAST({'a': 1, 'z': 2} AS VARIANT))
----
list_sort can only operate on LISTs

# prepared parameters bind with an UNKNOWN type and must not segfault
statement ok
PREPARE p AS SELECT list_grade_up(?)

query I
EXECUTE p([3, 1, 2])
----
[2, 3, 1]

# regular list arguments keep working
query I
SELECT list_grade_up([3, 1, 2])
----
[2, 3, 1]

query I
SELECT list_grade_up(NULL)
----
NULL

query I
SELECT list_grade_up(NULL::INT[])
----
NULL
