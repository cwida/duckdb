# name: test/sql/function/autocomplete/create_function.test
# description: Test sql_auto_complete
# group: [autocomplete]

require autocomplete

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MA') LIMIT 1;
----
MACRO 	7

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE F') LIMIT 1;
----
FUNCTION 	7

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO name(a) A') LIMIT 1;
----
AS 	21

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO name(a) AS a+1, (b) A') LIMIT 1;
----
AS 	33

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO name (a) AS TA') LIMIT 1;
----
TABLE 	25

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO name (a) AS TABLE SEL') LIMIT 1;
----
SELECT 	31

# the name of a new macro completes IF NOT EXISTS and the schemas, not the names of existing functions

statement ok
CREATE MACRO my_existing_macro(x) AS x

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO ') LIMIT 1;
----
if 	13

query I
SELECT count(*) FROM sql_auto_complete('CREATE MACRO i') WHERE suggestion IN ('if ', 'information_schema.');
----
2

query I
SELECT count(*) FROM sql_auto_complete('CREATE OR REPLACE FUNCTION ') WHERE suggestion = 'main.';
----
1

query I
SELECT count(*) FROM sql_auto_complete('CREATE MACRO my_') WHERE suggestion = 'my_existing_macro';
----
0

# after a type_function keyword name the definition completes

query II
SELECT suggestion, suggestion_start FROM sql_auto_complete('CREATE MACRO semi(a) A') LIMIT 1;
----
AS 	21
