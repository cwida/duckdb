# replace never grows its input, and on input without a '?' of its own ignore is replace without the marks
query IIII
SELECT
	count(*),
	bool_and(octet_length(encode(decode(b, 'replace'))) <= octet_length(b)),
	count(*) FILTER (WHERE NOT contains(decode(b, 'ignore'), '?')),
	bool_and(replace(decode(b, 'replace'), '?', '') = decode(b, 'ignore')) FILTER (WHERE NOT contains(decode(b, 'ignore'), '?'))
FROM bad_utf8 WHERE b IS NOT NULL;
----
40	true	39	true

# a value that shrinks to the inline limit or below compares equal to the same text
query III
SELECT decode(unhex('41E282'), 'replace') = 'A?', decode(b, 'replace') = '?????', (SELECT decode(b, 'replace') FROM bad_utf8 WHERE id = 41) = repeat('A', 11) || '?'
FROM bad_utf8 WHERE id = 40;
----
true	true	true

# the strict mode still rejects a cut sequence
statement error
SELECT decode(b) FROM bad_utf8 WHERE id = 9;
----
Failure in decode
