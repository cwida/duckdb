# name: test/sql/function/index/index_key_persistence.test
# description: Test that index_key resolves user-defined and constraint indexes after WAL replay and checkpoints
# group: [index]

load {TEST_DIR}/index_key_persistence.db

statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE parent(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
CREATE INDEX PRIMARY_parent_0 ON parent(name);

statement ok
CREATE TABLE child(pid INTEGER REFERENCES parent(id), val INTEGER);

statement ok
ALTER TABLE child ADD PRIMARY KEY (val);

# Replay the WAL
restart

query IIII
SELECT
    index_key({'table': 'parent', 'constraint': 'primary'}, 1),
    index_key({'table': 'parent', 'index': 'PRIMARY_parent_0'}, 'x'),
    index_key({'table': 'child', 'constraint': 'foreign', 'columns': ['pid']}, 1),
    index_key({'table': 'child', 'constraint': 'primary'}, 2);
----
\x80\x00\x00\x01	x\x00	\x80\x00\x00\x01	\x80\x00\x00\x02

statement ok
CHECKPOINT;

# Load from the checkpoint
restart

query IIII
SELECT
    index_key({'table': 'parent', 'constraint': 'primary'}, 1),
    index_key({'table': 'parent', 'index': 'PRIMARY_parent_0'}, 'x'),
    index_key({'table': 'child', 'constraint': 'foreign', 'columns': ['pid']}, 1),
    index_key({'table': 'child', 'constraint': 'primary'}, 2);
----
\x80\x00\x00\x01	x\x00	\x80\x00\x00\x01	\x80\x00\x00\x02
