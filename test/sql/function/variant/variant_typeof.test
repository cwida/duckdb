# name: test/sql/function/variant/variant_typeof.test
# group: [variant]

# TODO: "Force storage" will use default storage version, but variant requires v1.5.0, so skip for now
require no_force_storage

query I
select variant_typeof({'a': 42}::VARIANT);
----
OBJECT(a)

query I
select variant_typeof({'c': [1], 'b': 2, 'a': 3}::VARIANT);
----
OBJECT(a, b, c)

query I
select variant_typeof(({'a': 42}::VARIANT).variant_extract('a'));
----
INT32

query I
select variant_typeof(struct_pack(*COLUMNS(*))::VARIANT) test from test_all_types();
----
OBJECT(array_of_structs, bigint, bignum, bit, blob, bool, date, date_array, dec38_10, dec_18_6, dec_4_1, dec_9_4, double, double_array, empty_struct, fixed_array_of_int_list, fixed_int_array, fixed_nested_int_array, fixed_nested_varchar_array, fixed_struct_array, fixed_varchar_array, float, geometry, hugeint, int, int_array, interval, large_enum, list_of_fixed_int_array, map, medium_enum, nested_int_array, small_enum, smallint, struct, struct_of_arrays, struct_of_fixed_array, time, time_ns, time_tz, timestamp, timestamp_array, timestamp_ms, timestamp_ns, timestamp_s, timestamp_tz, timestamp_tz_ns, timestamptz_array, tinyint, tuple, ubigint, uhugeint, uint, union, usmallint, utinyint, uuid, varchar, varchar_array)
OBJECT(array_of_structs, bigint, bignum, bit, blob, bool, date, date_array, dec38_10, dec_18_6, dec_4_1, dec_9_4, double, double_array, empty_struct, fixed_array_of_int_list, fixed_int_array, fixed_nested_int_array, fixed_nested_varchar_array, fixed_struct_array, fixed_varchar_array, float, geometry, hugeint, int, int_array, interval, large_enum, list_of_fixed_int_array, map, medium_enum, nested_int_array, small_enum, smallint, struct, struct_of_arrays, struct_of_fixed_array, time, time_ns, time_tz, timestamp, timestamp_array, timestamp_ms, timestamp_ns, timestamp_s, timestamp_tz, timestamp_tz_ns, timestamptz_array, tinyint, tuple, ubigint, uhugeint, uint, union, usmallint, utinyint, uuid, varchar, varchar_array)
OBJECT(array_of_structs, bigint, bignum, bit, blob, bool, date, date_array, dec38_10, dec_18_6, dec_4_1, dec_9_4, double, double_array, empty_struct, fixed_array_of_int_list, fixed_int_array, fixed_nested_int_array, fixed_nested_varchar_array, fixed_struct_array, fixed_varchar_array, float, geometry, hugeint, int, int_array, interval, large_enum, list_of_fixed_int_array, map, medium_enum, nested_int_array, small_enum, smallint, struct, struct_of_arrays, struct_of_fixed_array, time, time_ns, time_tz, timestamp, timestamp_array, timestamp_ms, timestamp_ns, timestamp_s, timestamp_tz, timestamp_tz_ns, timestamptz_array, tinyint, tuple, ubigint, uhugeint, uint, union, usmallint, utinyint, uuid, varchar, varchar_array)

statement ok
CREATE TABLE T (v VARIANT);

statement ok
create table all_types as select struct_pack(*COLUMNS(*))::VARIANT test from test_all_types();

query I
select variant_typeof(variant_extract(test, 'bool')) from all_types;
----
BOOL_FALSE
BOOL_TRUE
VARIANT_NULL

query I
select variant_typeof(variant_extract(test, 'struct')) from all_types;
----
OBJECT(a, b)
OBJECT(a, b)
VARIANT_NULL

query I
select variant_typeof(variant_extract(test, 'struct').a) from all_types;
----
VARIANT_NULL
INT32
VARIANT_NULL

query I
select variant_typeof(variant_extract(test, 'struct').variant_extract('a')) from all_types limit 2;
----
VARIANT_NULL
INT32

query I
select variant_typeof(variant_extract(test, 'dec_18_6')) from all_types
----
DECIMAL(18, 6)
DECIMAL(18, 6)
VARIANT_NULL

query I
select variant_typeof(variant_extract(test, 'array_of_structs')) from all_types
----
ARRAY(0)
ARRAY(3)
VARIANT_NULL

query III
with cte as (
	select * from all_types limit 1 offset 1
)
select variant_typeof(variant_extract(test, 'array_of_structs')[1]), variant_typeof(variant_extract(test, 'array_of_structs')[2]), variant_typeof(variant_extract(test, 'array_of_structs')[3]) from cte;
----
OBJECT(a, b)	OBJECT(a, b)	VARIANT_NULL
