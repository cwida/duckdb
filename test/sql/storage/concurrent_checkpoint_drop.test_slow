# name: test/sql/storage/concurrent_checkpoint_drop.test_slow
# description: Tables and indexes dropped while a checkpoint runs, and older snapshots that read dropped tables after later checkpoints
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE a (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO a SELECT i, 'a' || i FROM range(100000) t(i);

statement ok
CREATE INDEX a_s ON a(s)

statement ok
CREATE TABLE keep AS SELECT i FROM range(1000) t(i);

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the drop
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM a
----
100000

onlyif threadid=1
statement ok
BEGIN TRANSACTION

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# the drop commits while the checkpoint waits before its catalog scan, which still writes the table
onlyif threadid=1
statement ok
DROP TABLE a

onlyif threadid=1
statement ok
COMMIT

# the commit did not wait for the running checkpoint
onlyif threadid=1
statement error
CHECKPOINT
----
Cannot CHECKPOINT

sleep 4000 millisecond

# a later checkpoint while the reader still sees the dropped table and its indexes
onlyif threadid=1
statement ok
INSERT INTO keep VALUES (-2)

onlyif threadid=1
statement ok
CHECKPOINT

sleep 2000 millisecond

onlyif threadid=2
query II
SELECT COUNT(*), SUM(i) FROM a WHERE s LIKE 'a%'
----
100000	4999950000

onlyif threadid=2
query II
SELECT i, s FROM a WHERE i = 4242
----
4242	a4242

onlyif threadid=2
query II
SELECT i, s FROM a WHERE s = 'a777'
----
777	a777

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'a'
----
0

query II
SELECT COUNT(*), SUM(i) FROM keep
----
1002	499497

# a table and a unique index dropped while a checkpoint runs: that checkpoint still writes both
statement ok
CREATE TABLE b (i INTEGER PRIMARY KEY, s VARCHAR, t VARCHAR);

statement ok
INSERT INTO b SELECT i, 'b' || i, 't' || i FROM range(100000) t(i);

statement ok
CREATE INDEX b_s ON b(s)

statement ok
CREATE TABLE u AS SELECT i FROM range(1000) t(i);

statement ok
CREATE UNIQUE INDEX u_i ON u(i)

statement ok
CHECKPOINT

# the next checkpoint rewrites the updated column and frees the blocks it replaces, after the table was dropped
statement ok
UPDATE b SET t = 'u' || i WHERE i % 10 = 0

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM b
----
100000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO u VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

onlyif threadid=1
statement ok
DROP TABLE b

onlyif threadid=1
statement ok
DROP INDEX u_i

# the dropped index no longer applies
onlyif threadid=1
statement ok
INSERT INTO u VALUES (5)

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

# replay the WAL on top of the checkpoint that ran during the drops, twice
restart

loop k 0 2

statement ok
PRAGMA disable_checkpoint_on_shutdown

query II
SELECT COUNT(*) FILTER (WHERE table_name = 'b'), COUNT(*) FILTER (WHERE table_name = 'u') FROM duckdb_tables()
----
0	1

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE table_name IN ('b', 'u')
----
0

query III
SELECT COUNT(*), COUNT(DISTINCT i), COUNT(*) FILTER (WHERE i = 5) FROM u
----
1002	1001	2

restart

endloop

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO u VALUES (1000)

# the checkpoint accounts for every block, also those of the dropped table
statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), COUNT(DISTINCT i), COUNT(*) FILTER (WHERE i = 5) FROM u
----
1003	1002	2

# a checkpoint of an empty WAL does nothing
statement ok
CREATE TABLE tick1 AS SELECT 1 AS x

statement ok
CHECKPOINT

# a reader whose snapshot is older than a drop reads the dropped table after checkpoints reused its storage
statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE d AS SELECT i, repeat(md5(i::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM d WHERE i % 3 = 0

statement ok
CREATE TABLE c AS SELECT 1 AS x

# tables the checkpoints below fill while an older reader is open
loop k 0 3

statement ok
CREATE TABLE b{k} (i BIGINT, s VARCHAR);

endloop

statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
SET force_compression='uncompressed'

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM c
----
1

statement ok
DROP TABLE d

statement ok
CHECKPOINT

loop k 0 3

statement ok
INSERT INTO b{k} SELECT i, repeat(md5((i + 7)::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM b{k} WHERE i % 3 = 1

statement ok
CHECKPOINT

endloop

query IIIIII con1
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (WHERE i % 3 = 0), COUNT(*) FILTER (WHERE i % 3 = 1), SUM(length(s)), bool_and(s = repeat(md5(i::VARCHAR), 160)) FROM d
----
13333	133326667	0	6667	68264960	true

# a crash while the old reader still keeps the dropped blocks from reuse: they are free on disk
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick2 AS SELECT 1 AS x

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'd'
----
0

query II
SELECT COUNT(*), SUM(i) FROM b2
----
13333	133320000

# a checkpoint after dropping an indexed table, while an older reader uses its indexes, frees their blocks on disk
statement ok
CREATE TABLE ia (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO ia SELECT i, 'a' || i FROM range(100000) t(i);

statement ok
CREATE INDEX ia_s ON ia(s)

statement ok
CHECKPOINT

statement ok con2
BEGIN TRANSACTION

query I con2
SELECT COUNT(*) FROM ia
----
100000

statement ok
DROP TABLE ia

statement ok
INSERT INTO tick1 VALUES (3)

statement ok
CHECKPOINT

query II con2
SELECT i, s FROM ia WHERE i = 4242
----
4242	a4242

query II con2
SELECT i, s FROM ia WHERE s = 'a777'
----
777	a777

statement ok con2
COMMIT

restart

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick4 AS SELECT 1 AS x

statement ok
CHECKPOINT
