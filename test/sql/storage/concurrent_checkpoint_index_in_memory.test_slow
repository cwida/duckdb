# name: test/sql/storage/concurrent_checkpoint_index_in_memory.test_slow
# description: Inserts and deletes into an indexed table while an in-memory checkpoint writes it
# group: [storage]

# only the explicit checkpoints below checkpoint (some test configurations checkpoint at every commit otherwise)
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO test SELECT i, 'str' || i FROM range(50000) t(i);

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint pauses for eight seconds after it scanned the row groups, before it replaces them
statement ok
SET debug_checkpoint_scan_sleep_ms=8000

concurrentloop threadid 0 5

# thread 4 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=4
statement ok
BEGIN TRANSACTION

onlyif threadid=4
query I
SELECT COUNT(*) FROM test
----
50000

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO test VALUES (-1, 'pre')

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 2000 millisecond

onlyif threadid=4
statement ok
ROLLBACK

# during the pause: new keys, a duplicate key, and deletes
onlyif threadid=1
statement ok
INSERT INTO test SELECT i, 'inserted' FROM range(100000, 101000) t(i)

onlyif threadid=2
statement error
INSERT INTO test VALUES (5, 'duplicate')
----
Constraint Error

onlyif threadid=3
statement ok
DELETE FROM test WHERE i >= 10000 AND i < 11000

onlyif threadid>0&&threadid<4
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

endloop

# the writers ran after the checkpoint started and finished during the pause
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s, mem.timing e WHERE w.who = 'writer' AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND w.t > s.t AND w.t < e.t - INTERVAL 4 SECOND
----
3

statement ok
SET debug_checkpoint_scan_sleep_ms=0

# the index sees the rows added and removed during the checkpoint (index entries added during a checkpoint live in a
# delta index until the checkpoint merges them, which is not observable from SQL: lookups consult the delta as well)
query II
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'inserted') FROM test
----
50001	1000

query I
SELECT s FROM test WHERE i = 100500
----
inserted

query I
SELECT COUNT(*) FROM test WHERE i = 10500
----
0

statement error
INSERT INTO test VALUES (100500, 'duplicate')
----
Constraint Error

statement ok
INSERT INTO test VALUES (10500, 'reinserted')

# and so does the index after the next checkpoint merged the changes into it
statement ok
CHECKPOINT

query I
SELECT s FROM test WHERE i = 100500
----
inserted

query I
SELECT s FROM test WHERE i = 10500
----
reinserted

statement error
INSERT INTO test VALUES (100999, 'duplicate')
----
Constraint Error

query I
SELECT COUNT(*) FROM test
----
50002
