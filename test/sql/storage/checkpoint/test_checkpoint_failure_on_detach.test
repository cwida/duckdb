# name: test/sql/storage/checkpoint/test_checkpoint_failure_on_detach.test
# description: Test failing a CHECKPOINT on DETACH.
# group: [checkpoint]

# Alternative verification disables checkpointing on shutdown.
require no_alternative_verify

statement ok
ATTACH '{TEST_DIR}/fail_detach';

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
SET debug_checkpoint_abort = 'before_header';

statement ok
CREATE TABLE fail_detach.integers AS SELECT * FROM range(100) tbl(i);

statement error
DETACH fail_detach;
----
but CHECKPOINT during DETACH failed
