# name: test/sql/storage/checkpoint/empty_wal_forced_checkpoint_generation.test_slow
# group: [checkpoint]

load {TEST_DIR}/empty_wal_forced_checkpoint_generation.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE t AS SELECT range::BIGINT AS i FROM range(1000);

statement ok
CHECKPOINT;

statement ok
PRAGMA force_checkpoint;

statement ok
SET debug_checkpoint_sleep_ms=6000;

statement ok
SET checkpoint_threshold='1TB';

concurrentloop threadid 0 2

onlyif threadid=1
statement ok
BEGIN TRANSACTION;

onlyif threadid=1
statement ok
INSERT INTO t SELECT range::BIGINT + 1000000 FROM range(10);

onlyif threadid=1
sleep 2000 millisecond

onlyif threadid=0
sleep 500 millisecond

onlyif threadid=0
statement ok
CHECKPOINT;

onlyif threadid=1
statement ok
COMMIT;

endloop

restart

query I
SELECT count(*) FROM t
----
1010
