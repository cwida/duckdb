# name: test/sql/storage/checkpoint/sql_maintenance_checkpoint_lock.test
# description: SQL VACUUM and ANALYZE hold checkpoint exclusion only while executing.
# group: [checkpoint]

require noforcestorage

foreach operation VACUUM ANALYZE

load {TEST_DIR}/sql_maintenance_checkpoint_lock_{operation}.db

statement ok
SET checkpoint_threshold='1TB';

statement ok
CREATE TABLE t(k INTEGER PRIMARY KEY);

statement ok
INSERT INTO t SELECT range FROM range(32);

statement ok
ATTACH '{TEST_DIR}/sql_maintenance_read_only_{operation}.db' AS other;

statement ok
CREATE TABLE other.t(k INTEGER PRIMARY KEY);

statement ok
INSERT INTO other.t VALUES (1), (2), (3);

statement ok
CHECKPOINT other;

statement ok
DETACH other;

statement ok
ATTACH '{TEST_DIR}/sql_maintenance_read_only_{operation}.db' AS other (READ_ONLY);

statement ok maintenance
BEGIN TRANSACTION READ ONLY;

statement ok maintenance
{operation} t;

# Maintenance can still run in a read-only transaction and on multiple databases.
statement ok maintenance
{operation} other.t;

# Repeated maintenance must not retain checkpoint exclusion in the transaction.
statement ok maintenance
{operation} t;

statement ok maintenance
CHECKPOINT;

statement ok
CHECKPOINT;

# An idle maintenance transaction must not prevent automatic checkpoints on another connection.
statement ok
SET checkpoint_threshold='1B';

statement ok
INSERT INTO t VALUES (32);

query I
SELECT wal_size = '0 bytes' FROM pragma_database_size() WHERE database_name = current_database();
----
true

query I maintenance
SELECT count(*) FROM t;
----
32

statement ok
SET checkpoint_threshold='1TB';

statement ok maintenance
COMMIT;

# A lock already held for a write must remain transaction-scoped.
statement ok maintenance
BEGIN;

statement ok maintenance
UPDATE t SET k=k WHERE k=0;

statement ok maintenance
{operation} t;

statement error
CHECKPOINT;
----
Cannot CHECKPOINT

statement ok maintenance
ROLLBACK;

statement ok
CHECKPOINT;

query I
SELECT count(*) FROM t;
----
33

statement ok
DETACH other;

endloop
