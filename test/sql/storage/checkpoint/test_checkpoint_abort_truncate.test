# name: test/sql/storage/checkpoint/test_checkpoint_abort_truncate.test
# description: Test that physical file size is truncated to match database size + headers after checkpoint abort
# group: [checkpoint]

require noforcestorage

load {TEST_DIR}/checkpoint_abort_truncate.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
PRAGMA debug_checkpoint_abort='AFTER_FREE_LIST_WRITE';

statement ok
CREATE TABLE t AS SELECT repeat('a', 100) FROM range(50000);

statement error
CHECKPOINT;
----
<REGEX>:.*Checkpoint aborted after free list write.*

restart

statement ok
PRAGMA debug_checkpoint_abort='none';

statement ok
DROP TABLE t;

statement ok
CHECKPOINT;

# Total blocks should be 1 (only the metadata/catalog block)
query I
SELECT total_blocks
FROM pragma_database_size();
----
1

# Invariant: right after checkpoint, file size = database size + header (12288)
query I
SELECT size = (SELECT total_blocks * block_size + 12288 FROM pragma_database_size())
FROM read_blob('{TEST_DIR}/checkpoint_abort_truncate.db');
----
true
