# name: test/sql/storage/partial_blocks/deferred_checkpoint_colocation.test
# description: Full and concurrent checkpoints pack table and index data across tables before publication.
# group: [partial_blocks]

require noforcestorage

foreach checkpoint_mode full concurrent

load {TEST_DIR}/deferred_checkpoint_colocation_{checkpoint_mode}.db

statement ok
SET threads=1;

statement ok
SET checkpoint_threshold='1TB';

statement ok
SET force_compression='uncompressed';

statement ok
SET debug_verify_blocks=true;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE a(k BIGINT PRIMARY KEY, v VARCHAR);

statement ok
INSERT INTO a SELECT range, 'value-' || range::VARCHAR FROM range(32);

statement ok
CREATE TABLE b(k BIGINT, v BIGINT);

statement ok
INSERT INTO b SELECT range, range * 10 FROM range(32);

statement ok
CREATE TABLE empty_table(k BIGINT);

statement ok
CREATE SEQUENCE checkpoint_marker;

# In concurrent mode, a commit newer than this reader prevents deletion vacuum.
onlyif checkpoint_mode=concurrent
statement ok reader
BEGIN;

onlyif checkpoint_mode=concurrent
query I reader
SELECT count(*) FROM a;
----
32

statement ok
SELECT nextval('checkpoint_marker');

statement ok
CHECKPOINT;

# The two small tables should have column segments in the same physical block.
query I
WITH blocks AS (
    SELECT 'a' AS tbl, block_id FROM pragma_storage_info('a') WHERE block_id >= 0
    UNION ALL
    SELECT 'b', block_id FROM pragma_storage_info('b') WHERE block_id >= 0
)
SELECT EXISTS (SELECT block_id FROM blocks GROUP BY block_id HAVING count(DISTINCT tbl) = 2);
----
true

# With no index-only blocks, the nonempty primary-key index shares column storage too.
query I
WITH accounted AS (
    SELECT block_id FROM pragma_storage_info('a') WHERE block_id >= 0
    UNION
    SELECT block_id FROM pragma_storage_info('b') WHERE block_id >= 0
    UNION
    SELECT block_id FROM pragma_metadata_info()
)
SELECT used_blocks - (SELECT count(*) FROM accounted) FROM pragma_database_size();
----
0

query II
SELECT count(*), sum(k) FROM a;
----
32	496

query III
SELECT count(*), sum(k), sum(v) FROM b;
----
32	496	4960

query I
SELECT count(*) FROM empty_table;
----
0

# Exercise publications whose collection result is empty because metadata was reused.
statement ok
SELECT nextval('checkpoint_marker');

statement ok
CHECKPOINT;

onlyif checkpoint_mode=concurrent
query I reader
SELECT count(*) FROM a;
----
32

onlyif checkpoint_mode=concurrent
statement ok reader
ROLLBACK;

restart

query I
WITH blocks AS (
    SELECT 'a' AS tbl, block_id FROM pragma_storage_info('a') WHERE block_id >= 0
    UNION ALL
    SELECT 'b', block_id FROM pragma_storage_info('b') WHERE block_id >= 0
)
SELECT EXISTS (SELECT block_id FROM blocks GROUP BY block_id HAVING count(DISTINCT tbl) = 2);
----
true

query IT
SELECT k, v FROM a WHERE k=17;
----
17	value-17

query III
SELECT count(*), sum(k), sum(v) FROM b;
----
32	496	4960

statement error
INSERT INTO a VALUES (17, 'duplicate');
----
Duplicate key

# Dropping one owner must not reclaim blocks containing the other table's payloads.
statement ok
SET debug_verify_blocks=true;

statement ok
DROP TABLE a;

statement ok
CHECKPOINT;

restart

query III
SELECT count(*), sum(k), sum(v) FROM b;
----
32	496	4960

endloop
