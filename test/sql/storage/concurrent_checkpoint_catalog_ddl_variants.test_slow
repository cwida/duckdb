read-only mode

statement error
SELECT nextval('ro.s')
----
read-only mode

statement error
SELECT setval('ro.s', 10)
----
read-only mode

statement error
COMMENT ON TABLE ro.t IS 'c'
----
read-only mode

statement error
ALTER TABLE ro.t RENAME TO t2
----
read-only mode

statement error
ALTER TABLE ro.t RENAME COLUMN i TO j
----
read-only mode

