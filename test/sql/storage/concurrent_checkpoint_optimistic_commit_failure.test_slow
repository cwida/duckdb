# name: test/sql/storage/concurrent_checkpoint_optimistic_commit_failure.test_slow
# description: An optimistic insert that fails to commit during a checkpoint does not leak or share its blocks
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_optimistic_commit_failure.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t (i INTEGER, s VARCHAR);

statement ok
INSERT INTO t SELECT i, 'x' || i FROM range(1000) t(i);

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=5000

concurrentloop threadid 0 4

# an open transaction makes the checkpoints concurrent
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
1000

sleep 500 millisecond

# commit after the open transaction started, so the checkpoint cannot be a full one
onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, 'pre')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# the commit writes its row groups to the WAL, then fails and is reverted, freeing their blocks
onlyif threadid=1
statement ok
SET debug_force_commit_failure=true

onlyif threadid=1
statement error
INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)
----
Forced commit failure

sleep 1000 millisecond

# a new optimistic write reuses the freed blocks before the checkpoint ends, and stays uncommitted
onlyif threadid=3
statement ok
BEGIN

onlyif threadid=3
statement ok
INSERT INTO t SELECT i, repeat('z', 50) || i FROM range(2000000) t(i)

sleep 4000 millisecond

onlyif threadid=1
statement ok
SET debug_force_commit_failure=false

# a second checkpoint writes its header while that write is still uncommitted
onlyif threadid=0
statement ok
INSERT INTO t VALUES (-2, 'mid')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 12000 millisecond

onlyif threadid=3
statement ok
ROLLBACK

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM t
----
1002

statement ok
INSERT INTO t VALUES (-3, 'post')

statement ok
CHECKPOINT
