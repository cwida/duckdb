# name: test/sql/storage/concurrent_checkpoint_optimistic_commit.test_slow
# description: Blocks an optimistic insert logs to the WAL during a checkpoint are free in that checkpoint's header
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_optimistic_commit.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t (i INTEGER, s VARCHAR);

statement ok
INSERT INTO t SELECT i, 'x' || i FROM range(1000) t(i);

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
1000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, 'pre')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# an insert large enough to be written optimistically commits after the checkpoint's bound, before its header
onlyif threadid=1
statement ok
INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(500000) t(i)

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM t
----
501001

statement ok
INSERT INTO t VALUES (-2, 'post')

statement ok
CHECKPOINT

statement ok
DELETE FROM t WHERE i >= 0 AND s LIKE 'y%'

statement ok
CHECKPOINT
