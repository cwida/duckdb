# name: test/sql/storage/checkpoint_block_count.test_slow
# description: Blocks allocated by a concurrent writer while WriteHeader flushes metadata must not leak
# group: [storage]

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='1TB'

statement ok
ATTACH '{TEST_DIR}/checkpoint_block_count_race.db' AS w (BLOCK_SIZE 16384)

statement ok
CREATE TABLE w.big(i BIGINT, s VARCHAR)

statement ok
CREATE TABLE w.small(i INT)

# large catalog entry: makes the metadata flush inside WriteHeader slow, widening the window
statement ok
CREATE TYPE w.big_enum AS ENUM (SELECT 'enum_value_' || i::VARCHAR FROM range(1500000) t(i))

statement ok
CHECKPOINT w

concurrentloop threadid 0 2

# thread 0: long optimistic insert that keeps allocating blocks at the end of the file, then rolls back
onlyif threadid=0
statement ok
BEGIN

onlyif threadid=0
statement ok
INSERT INTO w.big SELECT i, 'some_moderately_long_string_value_' || i FROM range(30000000) t(i)

onlyif threadid=0
statement ok
ROLLBACK

# thread 1: concurrent checkpoint while thread 0 is still inserting
onlyif threadid=1
statement ok
SELECT sleep_ms(1500)

onlyif threadid=1
statement ok
INSERT INTO w.small VALUES (1)

onlyif threadid=1
statement ok
CHECKPOINT w

endloop

# restart loads the header written by the concurrent checkpoint
restart

statement ok
ATTACH '{TEST_DIR}/checkpoint_block_count_race.db' AS w (BLOCK_SIZE 16384)

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO w.small VALUES (2)

statement ok
CHECKPOINT w

query I
SELECT count(*) FROM w.small
----
2

query I
SELECT count(*) FROM w.big
----
0
