# name: test/sql/storage/concurrent_checkpoint_drop_free_on_disk.test_slow
# description: Dropped storage freed on disk by a checkpoint while an older snapshot still reads it
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop_free_on_disk.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CREATE TABLE f (i BIGINT, s VARCHAR)

statement ok
CHECKPOINT

# a table dropped before any checkpoint wrote it: only the WAL references its blocks
statement ok
CREATE TABLE n AS SELECT i, i::VARCHAR || 'n' AS s FROM range(1000000) t(i)

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM n
----
1000000

statement ok
DROP TABLE n

# frees n on disk while con1 still reads it
statement ok
CHECKPOINT

statement ok
INSERT INTO f SELECT i, i::VARCHAR || 'f' AS s FROM range(1000000) t(i)

statement ok
CHECKPOINT

query III con1
SELECT COUNT(*), SUM(i), SUM(length(s)) FROM n
----
1000000	499999500000	6888890

# a crash while con1 still reads n: its blocks are free on disk
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'n'
----
0

# the cleanup frees dropped storage in memory while the checkpoint that freed it on disk has not written its header
statement ok
CREATE TABLE p AS SELECT i, i::VARCHAR || 'p' AS s FROM range(1000000) t(i)

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 2

# thread 1: an older reader, which ends while the checkpoint pauses
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
query I
SELECT COUNT(*) FROM p
----
1000000

onlyif threadid=1
statement ok
SELECT sleep_ms(1500)

onlyif threadid=1
query II
SELECT COUNT(*), SUM(i) FROM p
----
1000000	499999500000

onlyif threadid=1
statement ok
COMMIT

# a commit cleans up the drop
onlyif threadid=1
statement ok
INSERT INTO tick VALUES (2)

# thread 0: drops p after the reader started, then checkpoints: it frees p on disk, then pauses
onlyif threadid=0
statement ok
SELECT sleep_ms(500)

onlyif threadid=0
statement ok
DROP TABLE p

onlyif threadid=0
statement ok
CHECKPOINT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
INSERT INTO tick VALUES (3)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (4)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM tick
----
4
