# name: test/sql/storage/concurrent_checkpoint_append_before_snapshot.test_slow
# description: An append that sees the checkpoint before the table is snapshotted starts a row group the checkpoint leaves alone
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_append_before_snapshot.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

statement ok
INSERT INTO test SELECT i, 'str' || i FROM range(50000) t(i);

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for four seconds after it became active, before it writes any table, and again for six
# seconds after it scanned the row groups, before it replaces them
statement ok
SET debug_checkpoint_sleep_ms=4000

statement ok
SET debug_checkpoint_scan_sleep_ms=6000

concurrentloop threadid 0 4

# thread 3 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=3
statement ok
BEGIN TRANSACTION

onlyif threadid=3
query I
SELECT COUNT(*) FROM test
----
50000

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO test VALUES (-1, 'pre')

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 2000 millisecond

# during the first sleep: the append sees the active checkpoint and starts a new row group
onlyif threadid=1
statement ok
INSERT INTO test SELECT i, 'first' FROM range(100000, 101000) t(i)

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('first', now())

sleep 4000 millisecond

# during the pause: the append goes into that row group, which the checkpoint must not be writing
onlyif threadid=2
statement ok
INSERT INTO test SELECT i, 'second' FROM range(110000, 111000) t(i)

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('second', now())

onlyif threadid=3
statement ok
ROLLBACK

endloop

# the first insert ran within the four seconds after the checkpoint started, the second one after that and before the
# checkpoint finished
query I
SELECT COUNT(*) FROM mem.timing f, mem.timing s WHERE f.who = 'first' AND s.who = 'checkpoint start' AND f.t > s.t AND f.t < s.t + INTERVAL 4 SECOND
----
1

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s, mem.timing e WHERE w.who = 'second' AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND w.t > s.t + INTERVAL 4 SECOND AND w.t < e.t - INTERVAL 2 SECOND
----
1

# the base row group, the row group of the insert before the checkpoint, and the row group both appends share
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
3

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
SET debug_checkpoint_scan_sleep_ms=0

query III
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'first'), COUNT(*) FILTER (WHERE s = 'second') FROM test
----
52001	1000	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
1460973999	true

# WAL replay of the two appends
restart

query III
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'first'), COUNT(*) FILTER (WHERE s = 'second') FROM test
----
52001	1000	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
1460973999	true

statement ok
CHECKPOINT

restart

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
1460973999	true
