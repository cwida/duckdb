# name: test/sql/storage/optimistic_commit_failure_frees_blocks.test_slow
# description: A bulk insert whose commit fails before its WAL flush returns its blocks to the free list right away
# group: [storage]

load {TEST_DIR}/optimistic_commit_failure_frees_blocks.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t (i INTEGER, s VARCHAR);

statement ok
CHECKPOINT

statement ok
SET debug_force_commit_failure=true

statement error
INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)
----
Forced commit failure

statement ok
SET debug_force_commit_failure=false

# no checkpoint ran since: the blocks are free already
statement ok
CREATE TEMPORARY TABLE after_failure AS SELECT total_blocks, free_blocks FROM pragma_database_size()

query I
SELECT free_blocks > 0 FROM after_failure
----
true

# the retry reuses them instead of growing the file
statement ok
INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)

query I
SELECT p.total_blocks = a.total_blocks FROM pragma_database_size() p, after_failure a
----
true

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM t
----
200000

statement ok
CHECKPOINT
