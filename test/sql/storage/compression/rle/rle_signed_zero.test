# name: test/sql/storage/compression/rle/rle_signed_zero.test
# description: RLE must not merge +0.0 and -0.0
# group: [rle]

load {TEST_DIR}/rle_signed_zero.db

statement ok
PRAGMA force_compression='rle'

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES (-0e0::DOUBLE), (0e0::DOUBLE), (1.0)) tbl(x);

statement ok
CHECKPOINT

query I
SELECT signbit(x) FROM t WHERE x = 0 ORDER BY signbit(x)
----
false
true
