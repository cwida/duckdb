# name: test/sql/storage/compression/rle/rle_corrupt_run_undercount.test
# description: Run lengths that do not cover segment.count must be rejected
# group: [rle]

require vector_size 2048

unzip data/storage/corrupt/rle_corrupt_run_undercount.db.gz {TEST_DIR}/rle_corrupt_run_undercount.db

load {TEST_DIR}/rle_corrupt_run_undercount.db readonly

statement ok
USE rle_corrupt_run_undercount

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='RLE';
----
RLE

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted RLE segment: run counts do not cover the segment row count

restart

# A pushed rowid filter exercises selected reads and their unselected tail.
statement ok
SET debug_force_fetch_row=false;

statement error
SELECT sum(a) FROM t WHERE rowid%2=1;
----
Data Corruption Error: Corrupted RLE segment: run counts do not cover the segment row count

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted RLE segment: run counts do not cover the segment row count
