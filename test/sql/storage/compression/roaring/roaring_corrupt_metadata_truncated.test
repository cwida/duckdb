# name: test/sql/storage/compression/roaring/roaring_corrupt_metadata_truncated.test
# description: Reject truncated Roaring metadata
# group: [roaring]

require vector_size 2048

require block_size 262144

unzip data/storage/corrupt/roaring_corrupt_metadata_truncated.db.gz {TEST_DIR}/roaring_corrupt_metadata_truncated.db

load {TEST_DIR}/roaring_corrupt_metadata_truncated.db readonly

statement ok
USE roaring_corrupt_metadata_truncated

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='Roaring' LIMIT 1;
----
Roaring

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted Roaring metadata: attempted to read past the end of the segment

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted Roaring metadata: attempted to read past the end of the segment
