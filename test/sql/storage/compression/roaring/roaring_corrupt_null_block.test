# name: test/sql/storage/compression/roaring/roaring_corrupt_null_block.test
# description: Reject a Roaring validity segment without a backing block
# group: [roaring]

require vector_size 2048

require block_size 262144

unzip data/storage/corrupt/roaring_corrupt_null_block.db.gz {TEST_DIR}/roaring_corrupt_null_block.db

load {TEST_DIR}/roaring_corrupt_null_block.db readonly

statement ok
USE roaring_corrupt_null_block

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Persistent Roaring segment is missing its data block

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Persistent Roaring segment is missing its data block
