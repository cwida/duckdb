# name: test/sql/storage/compression/roaring/roaring_corrupt_container_type.test
# description: Reject invalid run data selected by corrupted Roaring container metadata
# group: [roaring]

require vector_size 2048

require block_size 262144

unzip data/storage/corrupt/roaring_corrupt_container_type.db.gz {TEST_DIR}/roaring_corrupt_container_type.db

load {TEST_DIR}/roaring_corrupt_container_type.db readonly

statement ok
USE roaring_corrupt_container_type

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='Roaring' LIMIT 1;
----
Roaring

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted Roaring segment: invalid run bounds or ordering

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted Roaring segment: invalid run bounds or ordering
