# name: test/sql/storage/compression/dict_fsst/dict_fsst_corrupt_fsst_only_dict_count.test
# description: An FSST_ONLY length table that does not cover the segment rows must be rejected
# group: [dict_fsst]

require vector_size 2048

unzip data/storage/corrupt/dict_fsst_corrupt_fsst_only_dict_count.db.gz {TEST_DIR}/dict_fsst_corrupt_fsst_only_dict_count.db

load {TEST_DIR}/dict_fsst_corrupt_fsst_only_dict_count.db readonly

statement ok
USE dict_fsst_corrupt_fsst_only_dict_count

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='s' AND compression='DICT_FSST' LIMIT 1;
----
DICT_FSST

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: dictionary index is out of range

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: dictionary index is out of range
