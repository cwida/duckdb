# name: test/sql/storage/compression/dict_fsst/dict_fsst_corrupt_mode.test
# description: A plain dictionary with too few entries for FSST_ONLY mode must be rejected
# group: [dict_fsst]

require vector_size 2048

unzip data/storage/corrupt/dict_fsst_corrupt_mode.db.gz {TEST_DIR}/dict_fsst_corrupt_mode.db

load {TEST_DIR}/dict_fsst_corrupt_mode.db readonly

statement ok
USE dict_fsst_corrupt_mode

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='s' AND compression='DICT_FSST' LIMIT 1;
----
DICT_FSST

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: dictionary index is out of range

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT count(DISTINCT s) FROM t;
----
Data Corruption Error: Corrupted DICT_FSST segment: dictionary index is out of range
