# name: test/sql/storage/compression/compression_padding_initialization.test
# description: Compressed segments must initialize gaps and padding before they are persisted
# group: [compression]

# scripts/test_zero_initialize.py runs this with one- and zero-initialized buffers and compares the files

require vector_size 2048

statement ok
SET threads=1

# dictionary_gap
statement ok
ATTACH '{TEST_DIR}/padding_dictionary_gap.db' AS dictionary_gap (STORAGE_VERSION 'v1.2.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='dictionary'

statement ok
CREATE TABLE dictionary_gap.t AS SELECT lpad(i::VARCHAR,1000,'x') AS x FROM range(14) r(i)

statement ok
CHECKPOINT dictionary_gap

query I
SELECT count(*) > 0 FROM pragma_storage_info('dictionary_gap.t') WHERE compression = 'Dictionary'
----
true

query I
SELECT count(*) FROM dictionary_gap.t
----
14

statement ok
DETACH dictionary_gap

# dict_fsst_small
statement ok
ATTACH '{TEST_DIR}/padding_dict_fsst_small.db' AS dict_fsst_small (STORAGE_VERSION 'v1.3.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='dict_fsst'

statement ok
CREATE TABLE dict_fsst_small.t AS SELECT * FROM (VALUES ('a'),('b')) v(x)

statement ok
CHECKPOINT dict_fsst_small

query I
SELECT count(*) > 0 FROM pragma_storage_info('dict_fsst_small.t') WHERE compression = 'DICT_FSST'
----
true

query I
SELECT count(*) FROM dict_fsst_small.t
----
2

statement ok
DETACH dict_fsst_small

# zstd_small
statement ok
ATTACH '{TEST_DIR}/padding_zstd_small.db' AS zstd_small (STORAGE_VERSION 'v1.2.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='zstd'

statement ok
CREATE TABLE zstd_small.t AS SELECT * FROM (VALUES ('a'),('b')) v(x)

statement ok
CHECKPOINT zstd_small

query I
