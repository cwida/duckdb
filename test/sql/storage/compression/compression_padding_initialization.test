statement ok
DETACH zstd_overflow

# uncompressed_overflow
statement ok
ATTACH '{TEST_DIR}/padding_uncompressed_overflow.db' AS uncompressed_overflow (STORAGE_VERSION 'v1.2.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE uncompressed_overflow.t AS SELECT * FROM (VALUES (repeat('a',5000)),(repeat('b',5001))) v(x)

statement ok
CHECKPOINT uncompressed_overflow

query I
SELECT count(*) > 0 FROM pragma_storage_info('uncompressed_overflow.t') WHERE compression = 'Uncompressed'
----
true

query I
SELECT count(*) FROM uncompressed_overflow.t
----
2

statement ok
DETACH uncompressed_overflow

