# zstd_multi
statement ok
ATTACH '{TEST_DIR}/padding_zstd_multi.db' AS zstd_multi (STORAGE_VERSION 'v1.2.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='zstd'

statement ok
CREATE TABLE zstd_multi.t AS SELECT CASE WHEN i%2=0 THEN 'a' ELSE 'b' END AS x FROM range(4097) r(i)

statement ok
CHECKPOINT zstd_multi

query I
SELECT count(*) > 0 FROM pragma_storage_info('zstd_multi.t') WHERE compression = 'ZSTD'
----
true

query I
SELECT count(*) FROM zstd_multi.t
----
4097

statement ok
DETACH zstd_multi

# zstd_overflow
statement ok
ATTACH '{TEST_DIR}/padding_zstd_overflow.db' AS zstd_overflow (STORAGE_VERSION 'v1.2.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='zstd'

statement ok
CREATE TABLE zstd_overflow.t AS SELECT CASE WHEN i%2=0 THEN 'a' ELSE 'b' END AS x FROM range(12289) r(i)

statement ok
CHECKPOINT zstd_overflow

query I
SELECT count(*) > 0 FROM pragma_storage_info('zstd_overflow.t') WHERE compression = 'ZSTD'
----
true

query I
