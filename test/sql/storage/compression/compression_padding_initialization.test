# roaring_multi
statement ok
ATTACH '{TEST_DIR}/padding_roaring_multi.db' AS roaring_multi (STORAGE_VERSION 'v1.5.0', BLOCK_SIZE 16384)

statement ok
SET force_compression='roaring'

statement ok
CREATE TABLE roaring_multi.t AS SELECT CASE WHEN i<2048 THEN i<144 AND i%16=0 ELSE i%2=0 END AS x FROM range(4096) r(i)

statement ok
CHECKPOINT roaring_multi

query I
SELECT count(*) > 0 FROM pragma_storage_info('roaring_multi.t') WHERE compression = 'Roaring'
----
true

query I
SELECT count(*) FROM roaring_multi.t
----
