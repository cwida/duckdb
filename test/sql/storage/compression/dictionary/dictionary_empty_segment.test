# name: test/sql/storage/compression/dictionary/dictionary_empty_segment.test
# description: Dictionary compression of a segment without any rows
# group: [dictionary]

statement ok
ATTACH '{TEST_DIR}/dictionary_empty_segment.db' AS d (STORAGE_VERSION 'v1.1.0');

statement ok
USE d;

statement ok
SET force_compression='dictionary';

statement ok
CREATE TABLE t AS SELECT []::VARCHAR[] ls UNION ALL SELECT NULL::VARCHAR[];

statement ok
CHECKPOINT;

query I
SELECT ls FROM t ORDER BY ls NULLS LAST
----
[]
NULL
