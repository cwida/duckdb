# name: test/sql/storage/compression/uncompressed/validity_corrupt_count.test
# description: Reading a corrupted validity segment count must error, not read past the block
# group: [uncompressed]

require vector_size 2048

unzip data/storage/corrupt/validity_corrupt_count.db.gz {TEST_DIR}/validity_corrupt_count.db

load {TEST_DIR}/validity_corrupt_count.db readonly

statement ok
USE validity_corrupt_count

query I
SELECT compression FROM pragma_storage_info('t') WHERE segment_type='VALIDITY' AND compression='Uncompressed';
----
Uncompressed

# Scan starting at row 0 is 64-row aligned: exercises AlignedScan.
statement error
SELECT sum(b) FROM t;
----
<REGEX>:.*Data Corruption Error: Corrupted validity segment: (array count|requested range) extends past the end of the segment.*

restart

# OFFSET 70 is not a multiple of 64: exercises UnalignedScan's separate bit-shifting path.
statement error
SELECT sum(b) FROM t OFFSET 70;
----
<REGEX>:.*Data Corruption Error: Corrupted validity segment: (array count|requested range) extends past the end of the segment.*

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(b) FROM t;
----
<REGEX>:.*Data Corruption Error: Corrupted validity segment: (array count|requested range) extends past the end of the segment.*
