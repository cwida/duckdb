# name: test/sql/storage/compression/zstd/zstd_corrupt_page_offset.test
# description: A Zstd string-length table must fit within the segment
# group: [zstd]

require vector_size 2048

unzip data/storage/corrupt/zstd_corrupt_page_offset.db.gz {TEST_DIR}/zstd_corrupt_page_offset.db

load {TEST_DIR}/zstd_corrupt_page_offset.db readonly

statement ok
USE zstd_corrupt_page_offset;

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='s' AND compression='ZSTD' LIMIT 1;
----
ZSTD

statement error
SELECT sum(length(s)) FROM t;
----
Data Corruption Error

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(length(s)) FROM t;
----
Data Corruption Error
