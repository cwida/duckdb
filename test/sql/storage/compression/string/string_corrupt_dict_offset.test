# name: test/sql/storage/compression/string/string_corrupt_dict_offset.test
# description: A dictionary offset outside the dictionary must be rejected
# group: [string]

require vector_size 2048

unzip data/storage/corrupt/string_corrupt_dict_offset.db.gz {TEST_DIR}/string_corrupt_dict_offset.db

load {TEST_DIR}/string_corrupt_dict_offset.db readonly

statement ok
USE string_corrupt_dict_offset

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='Uncompressed';
----
Uncompressed

statement error
SELECT length(a) FROM t;
----
Data Corruption Error

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT length(a) FROM t;
----
Data Corruption Error
