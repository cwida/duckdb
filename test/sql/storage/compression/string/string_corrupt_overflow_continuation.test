# name: test/sql/storage/compression/string/string_corrupt_overflow_continuation.test
# description: A continuation block must be owned by the string segment
# group: [string]

require vector_size 2048

unzip data/storage/corrupt/string_corrupt_overflow_continuation.db.gz {TEST_DIR}/string_corrupt_overflow_continuation.db

load {TEST_DIR}/string_corrupt_overflow_continuation.db readonly

statement ok
USE string_corrupt_overflow_continuation

query I
SELECT additional_block_ids::VARCHAR FROM pragma_storage_info('t') WHERE len(additional_block_ids) > 1;
----
[1, 2]

statement error
SELECT sum(length(a)) FROM t;
----
Data Corruption Error

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(length(a)) FROM t;
----
Data Corruption Error
