# name: test/sql/storage/compression/string/string_corrupt_overflow_offset.test
# description: An overflow string length header must fit in its block
# group: [string]

require vector_size 2048

unzip data/storage/corrupt/string_corrupt_overflow_offset.db.gz {TEST_DIR}/string_corrupt_overflow_offset.db

load {TEST_DIR}/string_corrupt_overflow_offset.db readonly

statement ok
USE string_corrupt_overflow_offset

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='Uncompressed';
----
Uncompressed

statement error
SELECT length(a) FROM t;
----
Data Corruption Error

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT length(a) FROM t;
----
Data Corruption Error
