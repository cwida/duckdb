# name: test/sql/storage/compression/string/string_corrupt_overflow_block_id.test
# description: An overflow marker must reference a block owned by the string segment
# group: [string]

require vector_size 2048

unzip data/storage/corrupt/string_corrupt_overflow_block_id.db.gz {TEST_DIR}/string_corrupt_overflow_block_id.db

load {TEST_DIR}/string_corrupt_overflow_block_id.db readonly

statement ok
USE string_corrupt_overflow_block_id

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='Uncompressed';
----
Uncompressed

statement error
SELECT length(a) FROM t;
----
Data Corruption Error

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT length(a) FROM t;
----
Data Corruption Error
