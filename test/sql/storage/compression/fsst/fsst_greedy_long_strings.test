# name: test/sql/storage/compression/fsst/fsst_greedy_long_strings.test
# description: Persist and read FSST strings longer than 511 bytes
# group: [fsst]

statement ok
SET force_compression = 'fsst';

statement ok
ATTACH '{TEST_DIR}/fsst_greedy.db' AS db
    (BLOCK_SIZE 262144, STORAGE_VERSION 'v1.2.0');

# Every row has 510+10+8 characters, of which 520 are constant, and the last 8 aren't
statement ok
CREATE TABLE db.t AS SELECT
	repeat('x', 510) || 'abcdefghij' || lpad(i::VARCHAR, 8, '0') AS s
FROM range(3500) t(i);

statement ok
CHECKPOINT db;

# The number of segments depends on the trained dictionary.
# Greedy encoding itself is checked directly in test/common/test_fsst.cpp.
query I
SELECT count(*) > 0
FROM pragma_storage_info('db.t')
WHERE column_name = 's'
  AND compression = 'FSST';
----
true

restart

statement ok
ATTACH '{TEST_DIR}/fsst_greedy.db' AS db (READ_ONLY);

query II
SELECT count(*), count(*) FILTER (
	WHERE s = repeat('x', 510) || 'abcdefghij' || lpad(i::VARCHAR, 8, '0'))
FROM (SELECT row_number() OVER (ORDER BY s) - 1 AS i, s FROM db.t);
----
3500	3500
