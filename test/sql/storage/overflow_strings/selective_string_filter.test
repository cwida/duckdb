# name: test/sql/storage/overflow_strings/selective_string_filter.test
# description: Filter uncompressed strings after selective filters without scanning discarded strings
# group: [overflow_strings]

require vector_size 2048

statement ok
SET threads=1;

statement ok
ATTACH '{TEST_DIR}/selective_string_filter.db' AS db (BLOCK_SIZE 16384);

statement ok
SET force_compression='uncompressed';

# Include NULLs, empty strings, overflow strings, multiple segments and a partial final vector.
statement ok
CREATE TABLE db.t AS SELECT i::INTEGER id, (i%1000)::INTEGER k, CASE WHEN i%11=0 THEN NULL WHEN i%13=0 THEN '' WHEN i%17=0 THEN repeat('x',20000)||i::VARCHAR ELSE 'row'||i::VARCHAR END s, (-i)::INTEGER payload FROM range(8197) r(i);

# The reference reads generated rows, not the storage scan being tested.
statement ok
CREATE VIEW expected AS SELECT i::INTEGER id, (i%1000)::INTEGER k, CASE WHEN i%11=0 THEN NULL WHEN i%13=0 THEN '' WHEN i%17=0 THEN repeat('x',20000)||i::VARCHAR ELSE 'row'||i::VARCHAR END s, (-i)::INTEGER payload FROM range(8197) r(i);

statement ok
CREATE TABLE db.big AS SELECT i::INTEGER id, 'row'||i::VARCHAR||repeat('Y',50000) s FROM range(2500) r(i);

statement ok
CREATE TABLE db.casts AS SELECT i::INTEGER id, (i%1000)::INTEGER k, CASE WHEN i%1000=0 THEN i::VARCHAR ELSE 'not an integer' END s, 'row'||i::VARCHAR s2 FROM range(5001) r(i);

statement ok
CHECKPOINT db;

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/selective_string_filter.db' AS db (BLOCK_SIZE 16384);

query I
SELECT count(*)=0 FROM pragma_storage_info('db.t') WHERE segment_type='VARCHAR' AND compression!='Uncompressed';
----
true

foreach cutoff 0 1 3 100 500 1000

query I
WITH actual AS MATERIALIZED (SELECT id,s,payload FROM db.t WHERE k<{cutoff} AND (contains(s,'7') OR s IS NULL)), ref AS MATERIALIZED (SELECT id,s,payload FROM expected WHERE k<{cutoff} AND (contains(s,'7') OR s IS NULL)) SELECT NOT EXISTS ((SELECT * FROM actual EXCEPT ALL SELECT * FROM ref) UNION ALL (SELECT * FROM ref EXCEPT ALL SELECT * FROM actual));
----
true

query I
WITH actual AS MATERIALIZED (SELECT id,s,payload FROM db.t WHERE k<{cutoff} AND s IS NOT NULL AND NOT contains(s,'7')), ref AS MATERIALIZED (SELECT id,s,payload FROM expected WHERE k<{cutoff} AND s IS NOT NULL AND NOT contains(s,'7')) SELECT NOT EXISTS ((SELECT * FROM actual EXCEPT ALL SELECT * FROM ref) UNION ALL (SELECT * FROM ref EXCEPT ALL SELECT * FROM actual));
----
true

endloop

# Fallible predicates must evaluate only selected rows; a second string filter
# must keep the original row positions after the first one narrows the selection.
query II
SELECT count(*),sum(id) FROM db.casts WHERE k=0 AND CAST(s AS INTEGER)>=1000 AND contains(s2,'0');
----
5	15000

# Neither full-vector overflow materialization nor spilling fits in this limit.
statement ok
SET memory_limit='32MB';

statement ok
SET max_temp_directory_size='0B';

query I
SELECT id FROM db.big WHERE id=1022 AND contains(s,'row1022');
----
1022

query I
SELECT id FROM db.big WHERE id=2048 AND contains(s,'row2048');
----
2048

query I
SELECT count(*) FROM db.big WHERE id=1022 AND contains(s,'missing');
----
0

statement ok
SET memory_limit='1GB';

# Active updates, including validity changes, must retain the ordinary update-aware scan.
statement ok
BEGIN;

statement ok
UPDATE db.t SET s='updated7' WHERE id=1001;

statement ok
UPDATE db.t SET s=NULL WHERE id=2001;

query IT
SELECT id,s FROM db.t WHERE k<3 AND (s='updated7' OR s IS NULL) ORDER BY id;
----
0	NULL
1001	updated7
2001	NULL
2002	NULL

statement ok
ROLLBACK;

query I
SELECT count(*) FROM db.t WHERE k<3 AND s='updated7';
----
0

statement ok
DELETE FROM db.t WHERE id=1001;

query I
WITH actual AS MATERIALIZED (SELECT id,s,payload FROM db.t WHERE k<3 AND contains(s,'row')), ref AS MATERIALIZED (SELECT id,s,payload FROM expected WHERE id<>1001 AND k<3 AND contains(s,'row')) SELECT NOT EXISTS ((SELECT * FROM actual EXCEPT ALL SELECT * FROM ref) UNION ALL (SELECT * FROM ref EXCEPT ALL SELECT * FROM actual));
----
true

statement ok
SET threads=4;

query I
WITH actual AS MATERIALIZED (SELECT id,s,payload FROM db.t WHERE k<100 AND contains(s,'7')), ref AS MATERIALIZED (SELECT id,s,payload FROM expected WHERE id<>1001 AND k<100 AND contains(s,'7')) SELECT NOT EXISTS ((SELECT * FROM actual EXCEPT ALL SELECT * FROM ref) UNION ALL (SELECT * FROM ref EXCEPT ALL SELECT * FROM actual));
----
true
