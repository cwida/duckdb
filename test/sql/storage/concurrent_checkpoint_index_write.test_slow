# name: test/sql/storage/concurrent_checkpoint_index_write.test_slow
# description: Commits that change a table or drop its index, and VACUUM, run while a checkpoint writes its indexes
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_index_write.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
CREATE INDEX t_s ON t(s);

statement ok
INSERT INTO t SELECT i, 's' || i FROM range(100000) t(i);

statement ok
CHECKPOINT

# the next checkpoint copies the buffers that this changes and shares the others
statement ok
DELETE FROM t WHERE i >= 50000 AND i % 10 != 0

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for six seconds after it copied the indexes of t, before it writes and installs the copies
statement ok
SET debug_checkpoint_index_sleep_ms=6000

concurrentloop threadid 0 4

# thread 3 is a reader that needs the state from before the changes below, so that this is a concurrent checkpoint
onlyif threadid=3
statement ok
BEGIN TRANSACTION

onlyif threadid=3
query I
SELECT COUNT(*) FROM t
----
55000

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 3000 millisecond

# during the sleep: the changes go to the checkpoint deltas, and the constraint still holds
onlyif threadid=1
statement ok
INSERT INTO t VALUES (100000, 'during'), (100001, 'during')

onlyif threadid=1
statement error
INSERT INTO t VALUES (10, 'duplicate')
----
Duplicate key

onlyif threadid=1
statement ok
DELETE FROM t WHERE i = 20

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('changes', now())

# during the sleep: vacuuming leaves the indexes that the checkpoint copied alone
onlyif threadid=2
statement ok
VACUUM t

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('vacuum', now())

# during the sleep: the checkpoint still writes the dropped index, and installs its copy
onlyif threadid=2
statement ok
DROP INDEX t_s

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('drop', now())

onlyif threadid=3
statement ok
ROLLBACK

endloop

# the changes, the vacuum and the drop did not wait for the checkpoint to write the indexes
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing e WHERE w.who = 'changes' AND e.who = 'checkpoint end' AND w.t < e.t - INTERVAL 2 SECOND
----
1

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing e WHERE w.who = 'vacuum' AND e.who = 'checkpoint end' AND w.t < e.t - INTERVAL 2 SECOND
----
1

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing e WHERE w.who = 'drop' AND e.who = 'checkpoint end' AND w.t < e.t - INTERVAL 2 SECOND
----
1

statement ok
SET debug_checkpoint_index_sleep_ms=0

query II
SELECT COUNT(*), SUM(i) FROM t
----
55001	1625149981

statement error
INSERT INTO t VALUES (100000, 'again')
----
Duplicate key

statement ok
INSERT INTO t VALUES (20, 'again')

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 't_s'
----
0

query I
SELECT s FROM t WHERE i = 20
----
again

# WAL replay of the changes on top of the checkpoint
restart

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

statement error
INSERT INTO t VALUES (100001, 'again')
----
Duplicate key

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 't_s'
----
0

statement ok
CHECKPOINT

restart

query II
SELECT COUNT(*), SUM(i) FROM t
----
55002	1625150001

statement error
INSERT INTO t VALUES (20, 'third')
----
Duplicate key

query II
SELECT i, s FROM t WHERE s = 'during' ORDER BY i
----
100000	during
100001	during

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 't_s'
----
0
