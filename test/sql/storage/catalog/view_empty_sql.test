unzip data/storage/view_empty_sql.db.gz {TEST_DIR}/view_empty_sql.db

statement ok
ATTACH '{TEST_DIR}/view_empty_sql.db' AS stored;

query I
SELECT answer FROM stored.api_view;
----
42

query T
SELECT sql FROM duckdb_views() WHERE view_name = 'api_view';
----
CREATE VIEW api_view AS SELECT (i + 1) AS answer FROM main."source";
