# name: test/sql/storage/concurrent_checkpoint_unique_check.test_slow
# description: An insert conflicts with rows committed while a checkpoint runs, which are only in the checkpoint deltas
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_unique_check.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, v VARCHAR);

statement ok
INSERT INTO t SELECT i, 'v' || i FROM range(1000) t(i);

statement ok
CHECKPOINT

# the checkpoint waits before it writes any table, so the index of t routes changes through its deltas meanwhile
statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
1000

sleep 300 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, 'pre')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 700 millisecond

onlyif threadid=1
statement ok
INSERT INTO t VALUES (5000, 'during'), (6000, 'during')

# the insert itself fails, not its commit
onlyif threadid=1
statement error
INSERT INTO t VALUES (5000, 'dup')
----
violates primary key constraint

onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement error
INSERT INTO t VALUES (6000, 'dup')
----
violates primary key constraint

onlyif threadid=1
statement ok
ROLLBACK

# deleting the row in the same transaction allows inserting the key again
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
DELETE FROM t WHERE id = 5000

onlyif threadid=1
statement ok
INSERT INTO t VALUES (5000, 'again')

onlyif threadid=1
statement ok
COMMIT

# a key added and deleted during the checkpoint can be inserted again
onlyif threadid=1
statement ok
DELETE FROM t WHERE id = 6000

onlyif threadid=1
statement ok
INSERT INTO t VALUES (6000, 'again')

onlyif threadid=1
statement ok
INSERT INTO t VALUES (6000, 'ignored') ON CONFLICT DO NOTHING

onlyif threadid=1
statement ok
INSERT INTO t VALUES (5000, 'updated') ON CONFLICT (id) DO UPDATE SET v = excluded.v

onlyif threadid=1
statement ok
INSERT OR REPLACE INTO t VALUES (6000, 'replaced')

onlyif threadid=1
query II
SELECT id, v FROM t WHERE id >= 5000 ORDER BY id
----
5000	updated
6000	replaced

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM t
----
1003	1003

query II
SELECT id, v FROM t WHERE id >= 5000 ORDER BY id
----
5000	updated
6000	replaced

statement error
INSERT INTO t VALUES (6000, 'dup')
----
violates primary key constraint
