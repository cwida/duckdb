# name: test/sql/storage/wal/wal_replay_unbound_index_autocheckpoint.test
# description: Test that an automatic checkpoint preserves index entries buffered during WAL replay
# group: [wal]

require skip_reload

load {TEST_DIR}/wal_replay_unbound_index_autocheckpoint.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_skip_checkpoint_on_commit=true

statement ok
CREATE TABLE t(id INTEGER, k VARCHAR)

statement ok
CREATE INDEX idx_k ON t(k)

statement ok
CHECKPOINT

statement ok
INSERT INTO t SELECT i, 'k' || i FROM range(500) r(i)

restart

statement ok
SET debug_skip_checkpoint_on_commit=false

statement ok
SET wal_autocheckpoint='1KB'

statement ok
CREATE TABLE other AS SELECT * FROM range(20000) r(x)

# The automatic checkpoint binds the index and truncates the WAL.
query I
SELECT wal_size FROM pragma_database_size()
----
0 bytes

restart

statement ok
SET index_scan_percentage=1

statement ok
SET index_scan_max_count=999999999

query I
SELECT count(*) FROM t WHERE id=7
----
1

query I
SELECT count(*) FROM t WHERE k='k7'
----
1

statement ok
DELETE FROM t
