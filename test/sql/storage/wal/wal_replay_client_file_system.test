# name: test/sql/storage/wal/wal_replay_client_file_system.test
# description: The WAL of an attached database is replayed through the file system of the client that attaches it
# group: [wal]

require noforcestorage

require notwindows

require no_alternative_verify

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB'

statement ok
ATTACH '{TEST_DIR}/wal_replay_client_file_system.db' AS db

statement ok
CREATE TABLE db.t AS SELECT 42 AS i

statement ok
DETACH db

query I
SELECT count(*) FROM glob('{TEST_DIR}/wal_replay_client_file_system.db.wal')
----
1

statement ok
CALL enable_logging('FileSystem')

statement ok
ATTACH '{TEST_DIR}/wal_replay_client_file_system.db' AS db

query I
SELECT i FROM db.t
----
42

query III
SELECT scope, parse_filename(path, 'both_slash'), op
FROM duckdb_logs_parsed('FileSystem')
WHERE parse_filename(path, 'both_slash') = 'wal_replay_client_file_system.db.wal' AND op = 'OPEN'
----
CONNECTION	wal_replay_client_file_system.db.wal	OPEN
