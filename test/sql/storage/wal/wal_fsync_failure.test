# name: test/sql/storage/wal/wal_fsync_failure.test
# description: A failed WAL fsync fails the commit, and the WAL is not synced again
# group: [wal]

load {TEST_DIR}/wal_fsync_failure.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
SET debug_force_wal_fsync_failure=true

statement error
INSERT INTO t VALUES (2)
----
injected WAL fsync failure

# the commit was alone and synced under the transaction lock, so it was rolled back
query I
SELECT count(*) FROM t
----
1

# the WAL is not synced again until it is reopened
statement error
INSERT INTO t VALUES (3)
----
a previous sync of this WAL has failed

restart

query I
SELECT count(*) FROM t
----
1
