# name: test/sql/storage/wal/wal_replay_unbound_index_shutdown_checkpoint.test
# description: Test that DETACH does not lose index entries buffered during WAL replay
# group: [wal]

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='999999GB';

statement ok
ATTACH '{TEST_DIR}/wal_detach_unbound_idx.db' AS db;

statement ok
CREATE TABLE db.t(a INT, b INT);

statement ok
CREATE INDEX idx ON db.t(a);

statement ok
INSERT INTO db.t SELECT i, i FROM range(100) t(i);

statement ok
CHECKPOINT db;

# insert a row that stays in the WAL because checkpoint_on_shutdown is false
statement ok
INSERT INTO db.t VALUES (1000, 1000);

statement ok
DETACH db;

# re-enable checkpoint on shutdown
statement ok
PRAGMA enable_checkpoint_on_shutdown;

# re-attach without querying the table; DETACH must retain the WAL because the index still has buffered operations
statement ok
ATTACH '{TEST_DIR}/wal_detach_unbound_idx.db' AS db;

statement ok
DETACH db;

# re-attach and verify the index still contains the row
statement ok
ATTACH '{TEST_DIR}/wal_detach_unbound_idx.db' AS db;

statement ok
SET index_scan_max_count = 999999999;

statement ok
SET index_scan_percentage = 1.0;

query II
SELECT * FROM db.t WHERE a = 1000;
----
1000	1000
