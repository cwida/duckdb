# name: test/sql/storage/concurrent_checkpoint_delete_before_and_during.test_slow
# description: A checkpoint writes a delete that committed before it started even when another delete commits while it runs
# group: [storage]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db (BLOCK_SIZE 16384, ROW_GROUP_SIZE 1048576)

statement ok
CREATE TABLE db.test AS SELECT i, 'str' || i AS s FROM range(400000) t(i)

statement ok
CREATE SEQUENCE db.marker

statement ok
CHECKPOINT db

statement ok
DELETE FROM db.test WHERE i % 2 = 0

statement ok
CHECKPOINT db

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db

# a delete that commits before the checkpoint: it lies below the checkpoint's bound, and its WAL is truncated by the
# checkpoint, so the checkpoint has to write it
statement ok
DELETE FROM db.test WHERE i % 8 = 3

query I
SELECT COUNT(*) FROM db.test
----
150000

# the checkpoint pauses for four seconds after it looked at the row groups, before it writes the table
statement ok
SET debug_checkpoint_scan_sleep_ms=4000

concurrentloop threadid 0 2

# a second delete on the same row group commits during the pause: it lies above the bound and is written by the next
# checkpoint; it must not make this checkpoint skip the first delete
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
query I
SELECT COUNT(*) FROM db.test
----
150000

onlyif threadid=1
statement ok
DELETE FROM db.test WHERE i % 8 = 7

sleep 1000 millisecond

# a commit after the transaction's snapshot, so that the checkpoint is concurrent instead of waiting for the
# transaction; it writes no table
onlyif threadid=0
statement ok
SELECT nextval('db.marker')

onlyif threadid=0
statement ok
CHECKPOINT db

sleep 2000 millisecond

onlyif threadid=1
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_scan_sleep_ms=0

query I
SELECT COUNT(*) FROM db.test
----
100000

# reopen without a checkpoint: the first delete has to come from the checkpoint, the second is replayed from the WAL
statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db

query I
SELECT COUNT(*) FROM db.test
----
100000

query I
SELECT COUNT(*) FROM db.test WHERE i % 8 = 3 OR i % 8 = 7
----
0
