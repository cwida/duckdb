# name: test/sql/storage/bc/test_decimal_expression_index_v2_0.test
# description: Decimal index keys of a database written before wide decimals bind as that engine bound them: within 38 digits, casts between BIGNUM and DECIMAL as the null cast; a key that engine computed otherwise is refused by writes and skipped by reads
# group: [bc]

# The databases are written with a vector size of 2048.
require vector_size 2048

# data/storage/decimal_expression_index_v1_4_0.db.gz and decimal_expression_index_v2_0_0.db.gz were written by a DuckDB
# before wide decimals (v2.1.0-dev93298) at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a DECIMAL(38,2), b DECIMAL(38,2));
#   CREATE UNIQUE INDEX ix ON t ((a + b));
#   CREATE UNIQUE INDEX ix_a ON t (a);
#   INSERT INTO t VALUES (1.5, 2.5);
# That engine bound the key (a + b) to DECIMAL(38,2) and stored keys of that type. This engine binds the sum of a query
# to the wide DECIMAL(39,2), but binds the keys of an index stored at these versions within 38 digits as well, so the
# index matches its stored keys and keeps rejecting duplicate sums

unzip data/storage/decimal_expression_index_v1_4_0.db.gz {TEST_DIR}/decimal_expression_index_v1_4_0.db

unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

query I
SELECT typeof(a + b) FROM old.t
----
DECIMAL(39,2)

query II
SELECT a, b FROM old.t WHERE a = 1.5
----
1.50	2.50

query I
SELECT count(*) FROM old.t WHERE a + b = 4
----
1

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement error
INSERT INTO old.t VALUES (1.5, 0)
----
<REGEX>:.*Duplicate key.*1\.50.*

statement ok
INSERT INTO old.t VALUES (2, 3)

# a sum beyond 38 digits overflows in the key, as it did in that engine
statement error
INSERT INTO old.t VALUES (999999999999999999999999999999999999.99, 999999999999999999999999999999999999.99)
----
<REGEX>:.*(Overflow|Out of Range|out of range).*

query I
SELECT count(*) FROM old.t
----
2

statement ok
CHECKPOINT old

statement ok
DETACH old

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DETACH old

endloop

# data/storage/decimal_coalesce_index_v1_4_0.db.gz and decimal_coalesce_index_v2_0_0.db.gz were written by DuckDB
# 2.0.0 at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a DECIMAL(38,0), b DECIMAL(38,1));
#   CREATE UNIQUE INDEX ix ON t ((coalesce(a, b)::DECIMAL(38,1)));
#   INSERT INTO t VALUES (NULL, 0.1);
# That engine combined the types within 38 digits, computed COALESCE in DECIMAL(38,0) and stored the key 0.0; a query
# of this engine combines them to the wide DECIMAL(39,1), the key of the stored index is still computed in DECIMAL(38,0)

unzip data/storage/decimal_coalesce_index_v1_4_0.db.gz {TEST_DIR}/decimal_coalesce_index_v1_4_0.db

unzip data/storage/decimal_coalesce_index_v2_0_0.db.gz {TEST_DIR}/decimal_coalesce_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_coalesce_index_{version}.db' AS old

query II
SELECT typeof(coalesce(a, b)::DECIMAL(38,1)), typeof(coalesce(a, b)) FROM old.t
----
DECIMAL(38,1)	DECIMAL(39,1)

statement error
INSERT INTO old.t VALUES (NULL, 0.1)
----
<REGEX>:.*Duplicate key.*0\.0.*

# the key of 0.2 is 0.0 as well, as it was in that engine
statement error
INSERT INTO old.t VALUES (NULL, 0.2)
----
<REGEX>:.*Duplicate key.*0\.0.*

statement ok
INSERT INTO old.t VALUES (NULL, 1.2)

query I
SELECT count(*) FROM old.t
----
2

query I
SELECT b FROM old.t WHERE b = 0.1
----
0.1

statement ok
DETACH old

endloop

# data/storage/decimal_bignum_cast_index_v1_4_0.db.gz and decimal_bignum_cast_index_v2_0_0.db.gz were written by
# DuckDB 2.0.0 at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a BIGNUM);
#   CREATE UNIQUE INDEX ix ON t ((coalesce(try_cast(a AS DECIMAL(18,0)), -1::DECIMAL(18,0))));
#   CREATE UNIQUE INDEX ix_a ON t (a);
#   CREATE TABLE u (k VARCHAR, d DECIMAL(38,0));
#   CREATE UNIQUE INDEX ux ON u ((k || typeof(d + d)));
#   INSERT INTO t VALUES ('1'::BIGNUM);
#   INSERT INTO u VALUES ('x', 1);
# That engine has no cast from BIGNUM to DECIMAL, its TRY_CAST gave NULL and the stored key is -1 for every row. This
# engine binds the cast of the stored key as that engine did, so the index keeps computing -1 and keeps rejecting every
# further row until it is created again. The key of u folds the type name of the sum, 'DECIMAL(38,0)' in that engine
# and in this one, since the key is bound within 38 digits

unzip data/storage/decimal_bignum_cast_index_v1_4_0.db.gz {TEST_DIR}/decimal_bignum_cast_index_v1_4_0.db

unzip data/storage/decimal_bignum_cast_index_v2_0_0.db.gz {TEST_DIR}/decimal_bignum_cast_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_cast_index_{version}.db' AS old

# a query of this engine casts the BIGNUM, the stored key of the index is still NULL
query I
SELECT try_cast(a AS DECIMAL(18,0)) FROM old.t
----
1

query I
SELECT a FROM old.t WHERE a = '1'::BIGNUM
----
1

query I
SELECT count(*) FROM old.t WHERE coalesce(try_cast(a AS DECIMAL(18,0)), -1::DECIMAL(18,0)) = 1
----
1

statement error
INSERT INTO old.t VALUES ('2'::BIGNUM)
----
<REGEX>:.*Duplicate key.*-1.*

query I
SELECT count(*) FROM old.t
----
1

statement error
INSERT INTO old.u VALUES ('x', 2)
----
<REGEX>:.*Duplicate key.*xDECIMAL\(38,0\).*

statement ok
INSERT INTO old.u VALUES ('y', 2)

# the same key cannot be created again at this storage version, since the engines of that version compute it otherwise
statement ok
DROP INDEX old.ix

statement error
CREATE UNIQUE INDEX ix ON old.t ((coalesce(try_cast(a AS DECIMAL(18,0)), -1::DECIMAL(18,0))))
----
<REGEX>:.*Index key expressions with a cast between BIGNUM and DECIMAL are not supported in storage versions prior to v2\.1\.0.*

statement ok
CREATE UNIQUE INDEX ix ON old.t ((coalesce(try_cast(a AS VARCHAR), '-1')))

statement error
INSERT INTO old.t VALUES ('1'::BIGNUM)
----
<REGEX>:.*Duplicate key.*

statement ok
INSERT INTO old.t VALUES ('2'::BIGNUM)

query I
SELECT count(*) FROM old.t
----
2

statement ok
DETACH old

endloop

# a read-only database binds the index as well
unzip data/storage/decimal_bignum_cast_index_v2_0_0.db.gz {TEST_DIR}/decimal_bignum_cast_index_read_only.db

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_cast_index_read_only.db' AS ro (READ_ONLY)

query I
SELECT a FROM ro.t WHERE a = '1'::BIGNUM
----
1

query I
SELECT count(*) FROM ro.t WHERE coalesce(try_cast(a AS DECIMAL(18,0)), -1::DECIMAL(18,0)) = 1
----
1

query I
SELECT count(*) FROM ro.t
----
1

statement ok
DETACH ro

# data/storage/decimal_bignum_cast_index_wal_v2_0_0.db.gz and .db.wal.gz were written by DuckDB 2.0.0 at storage
# version v2.0.0 with the same schema, checkpointed before the two INSERTs, which its write-ahead log holds. The replay
# buffers the row of t in the index, a CHECKPOINT binds the index and writes it with the key that engine computed

unzip data/storage/decimal_bignum_cast_index_wal_v2_0_0.db.gz {TEST_DIR}/decimal_bignum_cast_index_wal.db

unzip data/storage/decimal_bignum_cast_index_wal_v2_0_0.db.wal.gz {TEST_DIR}/decimal_bignum_cast_index_wal.db.wal

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_cast_index_wal.db' AS wal

query I
SELECT a FROM wal.t
----
1

query II
SELECT k, d FROM wal.u
----
x	1

statement ok
CHECKPOINT wal

statement error
INSERT INTO wal.t VALUES ('2'::BIGNUM)
----
<REGEX>:.*Duplicate key.*-1.*

statement ok
DROP INDEX wal.ix

statement ok
INSERT INTO wal.t VALUES ('2'::BIGNUM)

statement ok
DETACH wal

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_cast_index_wal.db' AS wal

query I
SELECT count(*) FROM wal.t
----
2

statement ok
DETACH wal

# a database upgraded to the storage version of wide decimals keeps the stored keys of its indexes: the index on the sum
# keeps binding within 38 digits, the index on the cast keeps computing -1 until it is created again, and then holds the
# key this engine computes
unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_upgrade.db

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0')

statement ok
CHECKPOINT up

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DROP INDEX up.ix

statement ok
CREATE UNIQUE INDEX ix ON up.t ((a + b))

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

# the new key is the wide sum: a sum beyond 38 digits no longer overflows
statement ok
INSERT INTO up.t VALUES (999999999999999999999999999999999999.99, 999999999999999999999999999999999999.99)

statement ok
DETACH up

unzip data/storage/decimal_bignum_cast_index_v2_0_0.db.gz {TEST_DIR}/decimal_bignum_cast_index_upgrade.db

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_cast_index_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0')

statement ok
CHECKPOINT up

statement error
INSERT INTO up.t VALUES ('2'::BIGNUM)
----
<REGEX>:.*Duplicate key.*-1.*

statement ok
DROP INDEX up.ix

statement ok
CREATE UNIQUE INDEX ix ON up.t ((coalesce(try_cast(a AS DECIMAL(18,0)), -1::DECIMAL(18,0))))

statement error
INSERT INTO up.t VALUES ('1'::BIGNUM)
----
<REGEX>:.*Duplicate key.*1.*

statement ok
INSERT INTO up.t VALUES ('2'::BIGNUM)

query I
SELECT count(*) FROM up.t
----
2

statement ok
DETACH up

# data/storage/decimal_bignum_constant_cast_index_v2_0_0.db.gz was written by DuckDB 2.0.0 at storage version v2.0.0 with:
#   CREATE TABLE t (k INTEGER);
#   CREATE UNIQUE INDEX ix ON t ((k + coalesce(try_cast('1'::BIGNUM AS DECIMAL(18,0)), 0::DECIMAL(18,0))));
#   INSERT INTO t VALUES (1);
#   CREATE TABLE c (a BIGNUM);
#   CREATE UNIQUE INDEX cx ON c ((CAST(a AS DECIMAL(18,0))));
#   CREATE TABLE n (s STRUCT(v BIGNUM));
#   CREATE INDEX nx ON n ((struct_extract(try_cast(s AS STRUCT(v DECIMAL(18,0))), 'v')));
#   INSERT INTO n VALUES ({'v': '1'::BIGNUM});
# The cast of t is folded while binding: that engine folded its TRY_CAST to NULL and stored the key k + 0, this engine
# binds the cast as that engine did before folding, so the stored key is k + 0 as well. Every insert into c failed in
# that engine, since its CAST raises an error, and does so here. The cast between the nested types of n is not bound as
# that engine bound it: the index is refused by writes and skipped by reads until it is created again
unzip data/storage/decimal_bignum_constant_cast_index_v2_0_0.db.gz {TEST_DIR}/decimal_bignum_constant_cast_index.db

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_constant_cast_index.db' AS old

# a query of this engine computes k + 1, the stored key of the index is k + 0
query I
SELECT k + coalesce(try_cast('1'::BIGNUM AS DECIMAL(18,0)), 0::DECIMAL(18,0)) FROM old.t
----
2

statement error
INSERT INTO old.t VALUES (1)
----
<REGEX>:.*Duplicate key.*1.*

statement ok
INSERT INTO old.t VALUES (2)

query I
SELECT count(*) FROM old.t
----
2

statement error
INSERT INTO old.c VALUES ('1'::BIGNUM)
----
<REGEX>:.*Unimplemented type for cast \(BIGNUM -> DECIMAL\(18,0\)\).*

query I
SELECT count(*) FROM old.c
----
0

query I
SELECT s FROM old.n
----
{'v': 1}

query I
SELECT count(*) FROM old.n WHERE struct_extract(try_cast(s AS STRUCT(v DECIMAL(18,0))), 'v') = 1
----
1

statement error
INSERT INTO old.n VALUES ({'v': '2'::BIGNUM})
----
<REGEX>:.*Cannot bind index "nx" on table "n": the index was stored at storage version v2\.0\.0, whose engines compute other keys for its expression \(.*casts STRUCT\(v BIGNUM\) to STRUCT\(v DECIMAL\(18,0\)\), a cast those engines do not have \(a TRY_CAST gives NULL there\)\).*DROP INDEX "nx" and CREATE it again.*

statement ok
DROP INDEX old.nx

statement ok
INSERT INTO old.n VALUES ({'v': '2'::BIGNUM})

statement ok
CHECKPOINT old

statement ok
DETACH old

statement ok
ATTACH '{TEST_DIR}/decimal_bignum_constant_cast_index.db' AS old

statement error
INSERT INTO old.t VALUES (2)
----
<REGEX>:.*Duplicate key.*2.*

statement ok
DETACH old
