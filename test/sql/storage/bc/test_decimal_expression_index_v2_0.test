# name: test/sql/storage/bc/test_decimal_expression_index_v2_0.test
# description: An index whose decimal key binds to a wide type in a database written before wide decimals is refused by writes and skipped by reads
# group: [bc]

# The databases are written with a vector size of 2048.
require vector_size 2048

# data/storage/decimal_expression_index_v1_4_0.db.gz and decimal_expression_index_v2_0_0.db.gz were written by a DuckDB
# before wide decimals (v2.1.0-dev93298) at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a DECIMAL(38,2), b DECIMAL(38,2));
#   CREATE UNIQUE INDEX ix ON t ((a + b));
#   CREATE UNIQUE INDEX ix_a ON t (a);
#   INSERT INTO t VALUES (1.5, 2.5);
# That engine bound the key (a + b) to DECIMAL(38,2), the stored keys have that type; this engine binds it to the wide
# DECIMAL(39,2), whose keys would not match them (the UNIQUE index would accept a duplicate sum)

unzip data/storage/decimal_expression_index_v1_4_0.db.gz {TEST_DIR}/decimal_expression_index_v1_4_0.db

unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

query I
SELECT typeof(a + b) FROM old.t
----
DECIMAL(39,2)

# a read does not need the index: a filtered scan leaves it unbound and uses the other index or a table scan
query II
SELECT a, b FROM old.t WHERE a = 1.5
----
1.50	2.50

query I
SELECT count(*) FROM old.t WHERE a + b = 4
----
1

# the index on the plain column binds, the index on the sum is refused instead of accepting a duplicate
statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Cannot bind index "ix" on table "t": its key expression .* binds to DECIMAL\(39,2\), but the index was stored at storage version v(1\.4\.0|2\.0\.0), whose engines bind decimal keys within 38 digits.*DROP INDEX "ix" and CREATE it again.*

statement error
INSERT INTO old.t VALUES (1.5, 0)
----
<REGEX>:.*Cannot bind index "ix".*

query II
SELECT a, b FROM old.t WHERE a = 1.5
----
1.50	2.50

# the index is dropped and created again: in this storage version every part of the key has to stay within 38 digits,
# a cast of the wide sum is not enough, since the engines of that version compute the sum within 38 digits
statement ok
DROP INDEX old.ix

statement error
CREATE UNIQUE INDEX ix ON old.t ((a + b))
----
<REGEX>:.*DECIMAL index key expressions wider than 38 digits are not supported in storage versions prior to v2.1.0.*

statement error
CREATE UNIQUE INDEX ix ON old.t (((a + b)::DECIMAL(38,2)))
----
<REGEX>:.*DECIMAL index key expressions wider than 38 digits are not supported in storage versions prior to v2.1.0.*

statement ok
CREATE UNIQUE INDEX ix ON old.t ((a::DECIMAL(37,2) + b::DECIMAL(37,2)))

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

# the index on the plain column keeps enforcing uniqueness
statement error
INSERT INTO old.t VALUES (1.5, 0)
----
<REGEX>:.*Duplicate key.*1\.50.*

statement ok
INSERT INTO old.t VALUES (2, 3)

query I
SELECT count(*) FROM old.t
----
2

statement ok
CHECKPOINT old

statement ok
DETACH old

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DETACH old

endloop

# a read-only database cannot drop the index, its filtered reads work without it
unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_read_only.db

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_read_only.db' AS ro (READ_ONLY)

query II
SELECT a, b FROM ro.t WHERE a = 1.5
----
1.50	2.50

query I
SELECT count(*) FROM ro.t WHERE a + b = 4
----
1

query I
SELECT count(*) FROM ro.t
----
1

statement ok
DETACH ro

# data/storage/decimal_coalesce_index_v1_4_0.db.gz and decimal_coalesce_index_v2_0_0.db.gz were written by DuckDB
# 2.0.0 at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a DECIMAL(38,0), b DECIMAL(38,1));
#   CREATE UNIQUE INDEX ix ON t ((coalesce(a, b)::DECIMAL(38,1)));
#   INSERT INTO t VALUES (NULL, 0.1);
# The key binds to DECIMAL(38,1) in both engines, but that engine computed COALESCE in DECIMAL(38,0) and stored the key
# 0.0, while this engine computes it in the wide DECIMAL(39,1) and gets 0.1: a wide intermediate is refused as well

unzip data/storage/decimal_coalesce_index_v1_4_0.db.gz {TEST_DIR}/decimal_coalesce_index_v1_4_0.db

unzip data/storage/decimal_coalesce_index_v2_0_0.db.gz {TEST_DIR}/decimal_coalesce_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_coalesce_index_{version}.db' AS old

query II
SELECT typeof(coalesce(a, b)::DECIMAL(38,1)), typeof(coalesce(a, b)) FROM old.t
----
DECIMAL(38,1)	DECIMAL(39,1)

statement error
INSERT INTO old.t VALUES (NULL, 0.1)
----
<REGEX>:.*Cannot bind index "ix" on table "t": its key expression .* binds to DECIMAL\(39,1\), but the index was stored at storage version v(1\.4\.0|2\.0\.0).*

query I
SELECT count(*) FROM old.t
----
1

query I
SELECT b FROM old.t WHERE b = 0.1
----
0.1

# the same key cannot be created again at this storage version, since the engines of that version compute it otherwise
statement ok
DROP INDEX old.ix

statement error
CREATE UNIQUE INDEX ix ON old.t ((coalesce(a, b)::DECIMAL(38,1)))
----
<REGEX>:.*DECIMAL index key expressions wider than 38 digits are not supported in storage versions prior to v2.1.0.*

statement ok
CREATE UNIQUE INDEX ix ON old.t ((coalesce(a::DECIMAL(37,0), b)))

statement error
INSERT INTO old.t VALUES (NULL, 0.1)
----
<REGEX>:.*Duplicate key.*0\.1.*

statement ok
INSERT INTO old.t VALUES (NULL, 0.2)

statement ok
DETACH old

endloop

# a database upgraded to the storage version of wide decimals keeps the stored keys of its indexes, the index is
# refused until it is created again, and then holds the wide key
unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_upgrade.db

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0')

statement ok
CHECKPOINT up

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Cannot bind index "ix" on table "t".*

query II
SELECT a, b FROM up.t WHERE a = 1.5
----
1.50	2.50

statement ok
DROP INDEX up.ix

statement ok
CREATE UNIQUE INDEX ix ON up.t ((a + b))

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DETACH up
