# name: test/sql/storage/bc/test_decimal_expression_index_v2_0.test
# description: An index whose decimal key binds to a wide type in a database written before wide decimals is refused
# group: [bc]

# data/storage/decimal_expression_index_v1_4_0.db.gz and decimal_expression_index_v2_0_0.db.gz were written by a DuckDB
# before wide decimals (v2.1.0-dev93298) at storage versions v1.4.0 and v2.0.0, with:
#   CREATE TABLE t (a DECIMAL(38,2), b DECIMAL(38,2));
#   CREATE UNIQUE INDEX ix ON t ((a + b));
#   CREATE UNIQUE INDEX ix_a ON t (a);
#   INSERT INTO t VALUES (1.5, 2.5);
# That engine bound the key (a + b) to DECIMAL(38,2), the stored keys have that type; this engine binds it to the wide
# DECIMAL(39,2), whose keys would not match them (the UNIQUE index would accept a duplicate sum)

unzip data/storage/decimal_expression_index_v1_4_0.db.gz {TEST_DIR}/decimal_expression_index_v1_4_0.db

unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_v2_0_0.db

foreach version v1_4_0 v2_0_0

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

query I
SELECT typeof(a + b) FROM old.t
----
DECIMAL(39,2)

# the index on the plain column binds, the index on the sum is refused instead of accepting a duplicate
statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Cannot bind index "ix" on table "t": its key .* binds to DECIMAL\(39,2\), but the index was stored at storage version v(1\.4\.0|2\.0\.0), whose engines bind decimal keys within 38 digits.*DROP INDEX "ix" and CREATE it again.*

statement error
INSERT INTO old.t VALUES (1.5, 0)
----
<REGEX>:.*Cannot bind index "ix".*

query I
SELECT count(*) FROM old.t WHERE a + b = 4
----
1

# the index is dropped and created again: in this storage version the key has to stay within 38 digits
statement ok
DROP INDEX old.ix

statement error
CREATE UNIQUE INDEX ix ON old.t ((a + b))
----
<REGEX>:.*DECIMAL index keys wider than 38 digits are not supported in storage versions prior to v2.1.0.*

statement ok
CREATE UNIQUE INDEX ix ON old.t (((a + b)::DECIMAL(38,2)))

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

# the index on the plain column keeps enforcing uniqueness
statement error
INSERT INTO old.t VALUES (1.5, 0)
----
<REGEX>:.*Duplicate key.*1\.50.*

statement ok
INSERT INTO old.t VALUES (2, 3)

query I
SELECT count(*) FROM old.t
----
2

statement ok
CHECKPOINT old

statement ok
DETACH old

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_{version}.db' AS old

statement error
INSERT INTO old.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DETACH old

endloop

# a database upgraded to the storage version of wide decimals keeps the stored keys of its indexes, the index is
# refused until it is created again, and then holds the wide key
unzip data/storage/decimal_expression_index_v2_0_0.db.gz {TEST_DIR}/decimal_expression_index_upgrade.db

statement ok
ATTACH '{TEST_DIR}/decimal_expression_index_upgrade.db' AS up (STORAGE_VERSION 'v2.1.0')

statement ok
CHECKPOINT up

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Cannot bind index "ix" on table "t".*

statement ok
DROP INDEX up.ix

statement ok
CREATE UNIQUE INDEX ix ON up.t ((a + b))

statement error
INSERT INTO up.t VALUES (1, 3)
----
<REGEX>:.*Duplicate key.*4\.00.*

statement ok
DETACH up
