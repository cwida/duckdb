# name: test/sql/storage/commit_out_of_memory_reverts_index_insert.test
# description: A commit that runs out of memory while it inserts keys into an ART removes the keys it inserted
# group: [storage]

require skip_reload

require no_alternative_verify

require 64bit

require vector_size 2048

load {TEST_DIR}/commit_out_of_memory_reverts_index_insert.db

statement ok
CREATE TABLE t (server_id INTEGER, account VARCHAR, n INTEGER, PRIMARY KEY (server_id, account))

statement ok
INSERT INTO t SELECT 11, 'old' || i, 0 FROM range(100) r(i)

statement ok
CHECKPOINT

restart

statement ok
SET memory_limit = '120MB'

statement ok
SET threads = 1

statement ok
SET max_temp_directory_size = '0KB'

statement ok
INSERT OR REPLACE INTO t SELECT 11, 'old' || i, 1 FROM range(50) r(i)

statement ok con1
BEGIN

statement ok con1
INSERT INTO t SELECT 12, 'key' || i, 0 FROM range(5000) r(i)

# fill the memory from another connection, so that the index insert of the commit runs out of memory
loop i 0 400

statement maybe con2
CREATE TEMP TABLE pad{i} AS SELECT repeat('x', 1000) s FROM range(1000)
----
Out of Memory Error

endloop

statement error con1
COMMIT
----
<REGEX>:.*Failed to commit.*

loop i 0 400

statement ok con2
DROP TABLE IF EXISTS pad{i}

endloop

query I
SELECT count(*) FROM t WHERE server_id = 12
----
0

# none of the keys of the failed commit are left in the index
statement ok
INSERT INTO t SELECT 12, 'key' || i, 1 FROM range(5000) r(i)

loop k 0 2

query III
SELECT count(*), count(DISTINCT account), sum(n) FROM t
----
5100	5100	5050

statement error
INSERT INTO t VALUES (12, 'key0', 2)
----
<REGEX>:Constraint Error.*Duplicate key.*

statement ok
CHECKPOINT

restart

endloop
