# name: test/sql/storage/concurrent_checkpoint_update_mid_checkpoint_reuse.test
# description: An update made through the old column while a checkpoint is paused, still open when the next checkpoint reuses the row group
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_update_mid_checkpoint_reuse.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE test AS SELECT range i FROM range(300000)

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_scan_sleep_ms=2000

# a committed update makes the first checkpoint rewrite column i of the first row group
statement ok
UPDATE test SET i = 5 WHERE i = 7

concurrentloop threadid 0 4

# thread 3 keeps an update transaction open so that the checkpoints run concurrently with it
onlyif threadid=3
statement ok
BEGIN TRANSACTION

onlyif threadid=3
statement ok
UPDATE test SET i = 1 WHERE i = 1

sleep 1500 millisecond

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# thread 1 updates through the old column while the checkpoint is paused, and keeps its transaction open
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
UPDATE test SET i = 10000000 WHERE i = 30000

sleep 2000 millisecond

# the first checkpoint is installed and its statistics cover the open update
onlyif threadid=2
query I
SELECT (stats(i)).max FROM test LIMIT 1
----
10000000

onlyif threadid=2
statement ok
SET debug_checkpoint_scan_sleep_ms=0

# an append to a new row group, then a second checkpoint that reuses the metadata of the first row group
onlyif threadid=2
statement ok
INSERT INTO test VALUES (300000)

onlyif threadid=2
statement ok
CHECKPOINT

sleep 500 millisecond

onlyif threadid=1
statement ok
COMMIT

sleep 500 millisecond

# the reused row group's statistics must cover the value, or the filter is folded away
onlyif threadid=2
query I
SELECT COUNT(*) FROM test WHERE i = 10000000
----
1

onlyif threadid=2
query I
SELECT (stats(i)).max FROM test LIMIT 1
----
10000000

onlyif threadid=3
statement ok
COMMIT

endloop

query I
SELECT COUNT(*) FROM test WHERE i = 10000000
----
1

restart

query I
SELECT COUNT(*) FROM test WHERE i = 10000000
----
1

query II
SELECT COUNT(*), SUM(i) FROM test
----
300001	45010119998
