# name: test/sql/storage/concurrent_wal/concurrent_conflicting_updates.test_slow
# description: Conflicting concurrent updates keep the total conserved and replay
# group: [concurrent_wal]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/concurrent_conflicting_updates.db' AS db

statement ok
CREATE TABLE db.accounts(id INTEGER, balance BIGINT)

statement ok
INSERT INTO db.accounts SELECT i, 1000 FROM range(10) t(i)

# adjacent threads transfer between shared accounts, so their updates conflict and one aborts
concurrentloop threadid 0 10

loop x 0 100

statement maybe
UPDATE db.accounts SET balance = balance + (CASE id WHEN {threadid} THEN -1 WHEN ({threadid} + 1) % 10 THEN 1 ELSE 0 END) WHERE id IN ({threadid}, ({threadid} + 1) % 10)
----

endloop

endloop

# no lost updates
query I
SELECT SUM(balance) FROM db.accounts
----
10000

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_conflicting_updates.db' AS db

query I
SELECT SUM(balance) FROM db.accounts
----
10000
