# name: test/sql/storage/concurrent_wal/concurrent_fsync_failure.test_slow
# description: A failed shared fsync acknowledges no commit and fails stop
# group: [concurrent_wal]

load {TEST_DIR}/concurrent_fsync_failure.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t(i INTEGER)

# acknowledged before the failure is injected
statement ok
INSERT INTO t SELECT range FROM range(50)

statement ok
SET debug_force_wal_fsync_failure=true

# one fsync covers the group: no committer may be acknowledged, nothing may hang
concurrentloop threadid 0 8

loop x 0 20

statement maybe
INSERT INTO t VALUES (1000 + {threadid} * 100 + {x});
----

endloop

endloop

# fail-stop
statement error
INSERT INTO t VALUES (999999)
----

restart

# the acknowledged prefix is intact; the failed group's commits are in doubt and may be replayed
query I
SELECT count(*) FILTER (WHERE i < 1000) FROM t
----
50

query I
SELECT count(*) >= 50 FROM t
----
true
