# name: test/sql/storage/concurrent_wal/concurrent_checkpoint_pending_commits.test_slow
# description: Force checkpoints while commits await their WAL sync
# group: [concurrent_wal]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window so checkpoints drain syncs that are in flight
statement ok
SET debug_wal_fsync_sleep_ms=2

foreach sleep_time 0 25 50

statement ok
SET debug_checkpoint_sleep_ms={sleep_time}

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_pending_commits{sleep_time}.db' AS db

statement ok
CREATE TABLE db.integers(i INTEGER)

# threads 0-8 commit; thread 9 force-checkpoints
concurrentloop threadid 0 10

loop x 0 50

onlyif threadid<>9
statement ok
INSERT INTO db.integers SELECT * FROM range({threadid} * 1000 + {x} * 10, {threadid} * 1000 + {x} * 10 + 10)

endloop

loop x 0 20

onlyif threadid=9
statement maybe
FORCE CHECKPOINT db
----

endloop

endloop

# threads 0-8 each insert 50*10 = 500 rows
query I
SELECT COUNT(*) FROM db.integers
----
4500

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_pending_commits{sleep_time}.db' AS db

query I
SELECT COUNT(*) FROM db.integers
----
4500

statement ok
DETACH db

statement ok
SET debug_checkpoint_sleep_ms=0

endloop
