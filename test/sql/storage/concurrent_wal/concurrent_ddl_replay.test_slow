# name: test/sql/storage/concurrent_wal/concurrent_ddl_replay.test_slow
# description: Concurrent DDL and data commits replay
# group: [concurrent_wal]

# WAL-only, so reopening replays catalog and data
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the publish-to-durable window
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/concurrent_ddl_replay.db' AS db

statement ok
CREATE TABLE db.base(i INTEGER)

statement ok
INSERT INTO db.base SELECT range FROM range(100)

statement ok
CREATE TABLE db.owner(i INTEGER)

statement ok
CREATE VIEW db.owner_view AS SELECT * FROM db.owner

# threads 0-2 churn views, 3-5 append, 6 drops and recreates a dependency pair
concurrentloop threadid 0 7

loop x 0 15

onlyif threadid<3
statement maybe
CREATE OR REPLACE VIEW db.v_{threadid}_{x} AS SELECT count(*) AS c FROM db.base;
----

onlyif threadid<3
statement maybe
DROP VIEW IF EXISTS db.v_{threadid}_{x};
----

onlyif threadid>=3
statement maybe
INSERT INTO db.base VALUES ({threadid} * 1000 + {x});
----

onlyif threadid=6
statement maybe
DROP VIEW IF EXISTS db.owner_view;
----

onlyif threadid=6
statement maybe
CREATE OR REPLACE VIEW db.owner_view AS SELECT * FROM db.owner;
----

endloop

endloop

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM db.base
----
true

# reopen: replayed from the WAL
statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_ddl_replay.db' AS db

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM db.base
----
true

statement ok
CHECKPOINT db

query I
SELECT count(*) >= 100 AND count(*) = count(DISTINCT i) FROM db.base
----
true
