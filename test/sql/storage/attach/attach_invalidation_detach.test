# name: test/sql/storage/attach/attach_invalidation_detach.test
# description: A fatal commit invalidates the attached database it ran on, even if it was detached or replaced meanwhile
# group: [attach]

require no_alternative_verify

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold = '1TB';

# the simulated crash leaves a torn WAL tail behind
statement ok
SET debug_abort_on_wal_failure = false;

statement ok
ATTACH '{TEST_DIR}/attach_invalidation_detach_a.db' AS a;

statement ok
CREATE TABLE a.t(i INTEGER);

statement ok
INSERT INTO a.t VALUES (0);

# --- the database is detached and another one is attached under the same name before the fatal commit ---

statement ok con1
BEGIN;

statement ok con1
INSERT INTO a.t VALUES (1);

statement ok con2
DETACH a;

statement ok con2
ATTACH ':memory:' AS a;

statement ok con2
CREATE TABLE a.healthy AS SELECT 42 AS answer;

statement ok con1
SET debug_checkpoint_abort = 'before_wal_flush';

statement error con1
COMMIT;
----
<REGEX>:FATAL Error: Simulated crash before WAL_FLUSH write.*

statement ok con1
SET debug_checkpoint_abort = 'none';

# the replacement database and the instance are unaffected
query I con2
SELECT answer FROM a.healthy;
----
42

query I con1
SELECT answer FROM a.healthy;
----
42

statement ok con2
INSERT INTO a.healthy VALUES (43);

statement ok con2
DETACH a;

# the original database recovers from its files
statement ok con2
ATTACH '{TEST_DIR}/attach_invalidation_detach_a.db' AS a;

query I con2
SELECT i FROM a.t ORDER BY i;
----
0

# --- the database is detached and nothing replaces it before the fatal commit ---

statement ok con1
BEGIN;

statement ok con1
INSERT INTO a.t VALUES (2);

statement ok con2
DETACH a;

statement ok con1
SET debug_checkpoint_abort = 'before_wal_flush';

statement error con1
COMMIT;
----
<REGEX>:FATAL Error: Simulated crash before WAL_FLUSH write.*

statement ok con1
SET debug_checkpoint_abort = 'none';

query I con2
SELECT 42;
----
42

query I con1
SELECT 42;
----
42

statement ok con2
ATTACH '{TEST_DIR}/attach_invalidation_detach_a.db' AS a;

query I con2
SELECT i FROM a.t ORDER BY i;
----
0

# --- another connection has an open transaction on the database when it is invalidated ---

statement ok
ATTACH '{TEST_DIR}/attach_invalidation_detach_b.db' AS b;

statement ok
CREATE TABLE b.t(i INTEGER);

statement ok con1
BEGIN;

query I con1
SELECT COUNT(*) FROM a.t;
----
1

statement ok con1
INSERT INTO b.t VALUES (1);

statement ok con2
SET debug_checkpoint_abort = 'before_wal_flush';

statement error con2
INSERT INTO a.t VALUES (3);
----
<REGEX>:FATAL Error: Simulated crash before WAL_FLUSH write.*

statement ok con2
SET debug_checkpoint_abort = 'none';

statement error con1
SELECT COUNT(*) FROM a.t;
----
<REGEX>:.*Database "a" has been invalidated because of a simulated crash.*

# the transaction spanning the invalidated database cannot commit
statement error con1
COMMIT;
----
<REGEX>:.*Database "a" has been invalidated.*

query I con1
SELECT COUNT(*) FROM b.t;
----
0

statement ok con1
INSERT INTO b.t VALUES (2);

# detaching and attaching another database under the same name is not affected by the invalidation
statement ok con2
DETACH a;

statement ok con2
ATTACH ':memory:' AS a;

statement ok con1
CREATE TABLE a.t AS SELECT 42 AS answer;

query I con2
SELECT answer FROM a.t;
----
42

statement ok con2
DETACH a;

statement ok con2
ATTACH '{TEST_DIR}/attach_invalidation_detach_a.db' AS a;

query I con1
SELECT i FROM a.t ORDER BY i;
----
0
