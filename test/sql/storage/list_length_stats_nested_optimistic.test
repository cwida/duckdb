# name: test/sql/storage/list_length_stats_nested_optimistic.test
# description: Test the list length statistics of nested lists written through optimistic writes, WAL replay and checkpoints
# group: [storage]

load {TEST_DIR}/list_length_stats_nested_optimistic.db readwrite v2.1.0

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='1TB';

statement ok
CREATE TABLE nested_list(l INTEGER[][]);

statement ok
CREATE TABLE deep_list(l INTEGER[][][]);

statement ok
CREATE TABLE map_list(l MAP(INTEGER, INTEGER[]));

statement ok
CREATE TABLE array_list(l INTEGER[][3]);

statement ok
CREATE TABLE struct_list(l STRUCT(a INTEGER[]));

statement ok
CREATE TABLE tuple_list AS SELECT row([1, 2, 3]) l LIMIT 0;

statement ok
CREATE TABLE union_list(l UNION(a INTEGER[], b VARCHAR));

statement ok
CHECKPOINT;

# large inserts are written to disk optimistically
statement ok
INSERT INTO nested_list SELECT [[1, 2, 3]] FROM range(200000);

statement ok
INSERT INTO deep_list SELECT [[[1, 2, 3]]] FROM range(200000);

statement ok
INSERT INTO map_list SELECT MAP {1: [1, 2, 3]} FROM range(200000);

statement ok
INSERT INTO array_list SELECT [[1, 2, 3], [1, 2, 3], [1, 2, 3]]::INTEGER[][3] FROM range(200000);

statement ok
INSERT INTO struct_list SELECT {'a': [1, 2, 3]} FROM range(200000);

statement ok
INSERT INTO tuple_list SELECT row([1, 2, 3]) FROM range(200000);

statement ok
INSERT INTO union_list SELECT [1, 2, 3]::INTEGER[] FROM range(200000);

# the inserts are only in the WAL: check before and after replaying it
query II
SELECT DISTINCT length(flatten(l)), count(*) FILTER (WHERE length(flatten(l)) = 3) OVER () FROM nested_list
----
3	200000

query II
SELECT s.child_stats.max_list_length, s.child_stats.total_list_length FROM (SELECT stats(l) s FROM nested_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.child_stats.max_list_length, s.child_stats.child_stats.total_list_length FROM (SELECT stats(l) s FROM deep_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.child_stats.value.max_list_length, s.child_stats.child_stats.value.total_list_length FROM (SELECT stats(l) s FROM map_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.max_list_length, s.child_stats.total_list_length FROM (SELECT stats(l) s FROM array_list LIMIT 1)
----
3	1800000

query II
SELECT s.child_stats.a.max_list_length, s.child_stats.a.total_list_length FROM (SELECT stats(l) s FROM struct_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats[1].max_list_length, s.child_stats[1].total_list_length FROM (SELECT stats(l) s FROM tuple_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.a.max_list_length, s.child_stats.a.total_list_length FROM (SELECT stats(l) s FROM union_list LIMIT 1)
----
3	600000

restart

query II
SELECT DISTINCT length(flatten(l)), count(*) FILTER (WHERE length(flatten(l)) = 3) OVER () FROM nested_list
----
3	200000

query II
SELECT s.child_stats.max_list_length, s.child_stats.total_list_length FROM (SELECT stats(l) s FROM nested_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.child_stats.max_list_length, s.child_stats.child_stats.total_list_length FROM (SELECT stats(l) s FROM deep_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.child_stats.value.max_list_length, s.child_stats.child_stats.value.total_list_length FROM (SELECT stats(l) s FROM map_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.max_list_length, s.child_stats.total_list_length FROM (SELECT stats(l) s FROM array_list LIMIT 1)
----
3	1800000

query II
SELECT s.child_stats.a.max_list_length, s.child_stats.a.total_list_length FROM (SELECT stats(l) s FROM struct_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats[1].max_list_length, s.child_stats[1].total_list_length FROM (SELECT stats(l) s FROM tuple_list LIMIT 1)
----
3	600000

query II
SELECT s.child_stats.a.max_list_length, s.child_stats.a.total_list_length FROM (SELECT stats(l) s FROM union_list LIMIT 1)
----
3	600000

statement ok
CHECKPOINT;

restart

query II
SELECT DISTINCT length(flatten(l)), count(*) FILTER (WHERE length(flatten(l)) = 3) OVER () FROM nested_list
----
3	200000

query II
SELECT s.child_stats.max_list_length, s.child_stats.total_list_length FROM (SELECT stats(l) s FROM nested_list LIMIT 1)
----
3	600000

query II
