# name: test/sql/storage/concurrent_checkpoint_drop_index_blocks.test_slow
# description: The index blocks of a table dropped while an older snapshot still uses its index
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop_index_blocks.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE p (i INTEGER PRIMARY KEY, s VARCHAR)

statement ok
INSERT INTO p SELECT i, 'p' || i FROM range(2000) t(i)

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

statement ok
SET debug_verify_blocks=true

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM p
----
2000

statement ok
DROP TABLE p

statement ok
INSERT INTO tick VALUES (1)

# frees the table and its index on disk; each index block holds several buffers of the index
statement ok
CHECKPOINT

# the older reader still uses the index
query II con1
EXPLAIN ANALYZE SELECT s FROM p WHERE i = 42
----
analyzed_plan	<REGEX>:.*Index Scan.*

query I con1
SELECT s FROM p WHERE i = 1234
----
p1234

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

# a crash while the older reader still uses the index: its blocks are free on disk
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (3)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'p'
----
0

# the same without a crash: the reader ends, and the index frees its blocks when it is destroyed
statement ok
CREATE TABLE q (i INTEGER PRIMARY KEY, s VARCHAR)

statement ok
INSERT INTO q SELECT i, 'q' || i FROM range(2000) t(i)

statement ok
CHECKPOINT

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT s FROM q WHERE i = 7
----
q7

statement ok
DROP TABLE q

statement ok
INSERT INTO tick VALUES (4)

statement ok
CHECKPOINT

query I con1
SELECT s FROM q WHERE i = 1999
----
q1999

statement ok con1
COMMIT

statement ok
INSERT INTO tick VALUES (5)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (6)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM tick
----
6
