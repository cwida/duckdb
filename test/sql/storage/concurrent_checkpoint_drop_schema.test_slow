# name: test/sql/storage/concurrent_checkpoint_drop_schema.test_slow
# description: A schema dropped with its tables and indexes while an older snapshot still reads them
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop_schema.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.a (i INTEGER PRIMARY KEY, v VARCHAR)

statement ok
INSERT INTO s.a SELECT i, 'a' || i FROM range(200000) t(i)

statement ok
CREATE INDEX a_v ON s.a(v)

statement ok
CREATE TABLE s.b AS SELECT i, repeat('b', 200) || i AS v FROM range(200000) t(i)

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM s.a
----
200000

statement ok
DROP SCHEMA s CASCADE

statement ok
INSERT INTO tick VALUES (1)

# frees both tables and their indexes on disk while con1 still reads them
statement ok
CHECKPOINT

query II con1
SELECT v, i FROM s.a WHERE i = 4242
----
a4242	4242

query I con1
SELECT i FROM s.a WHERE v = 'a777'
----
777

query II con1
SELECT COUNT(*), SUM(length(v)) FROM s.b
----
200000	41088890

# a crash while con1 still reads the dropped schema
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE schema_name = 's'
----
0
