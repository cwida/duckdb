# name: test/sql/aggregate/aggregate_state_export/test_covar_export_state.test
# description: Test COVAR EXPORT_STATE
# group: [aggregate_state_export]

statement ok
CREATE TABLE integers(x INTEGER, y INTEGER);

statement ok
INSERT INTO integers VALUES (10,NULL), (10,11), (20,22), (25,NULL), (30,35)

# test struct-based state export
statement ok
CREATE TABLE covar_state AS SELECT COVAR_POP(x,y) EXPORT_STATE pop_state, COVAR_SAMP(x, y) EXPORT_STATE samp_state FROM integers;

query T
SELECT pop_state::STRUCT(count UBIGINT, meanx DECIMAL(18,2), meany DECIMAL(18,2), co_moment DOUBLE) FROM covar_state;
----
{'count': 3, 'meanx': 22.67, 'meany': 20.00, 'co_moment': 240.0}

query T
SELECT samp_state::STRUCT(count UBIGINT, meanx DECIMAL(18,2), meany DECIMAL(18,2), co_moment DOUBLE) FROM covar_state;
----
{'count': 3, 'meanx': 22.67, 'meany': 20.00, 'co_moment': 240.0}

# test finalize round-trip for covar_samp
query I
SELECT covar_samp(x, y) FROM integers;
----
120.0

query I
SELECT finalize(covar_samp(x, y) EXPORT_STATE) FROM integers;
----
120.0

# grouped covar_samp
statement ok
CREATE TABLE grouped AS SELECT range % 3 g, range x, range + 1 y FROM range(30);

query II nosort res_covar_samp
SELECT g, covar_samp(x, y) FROM grouped GROUP BY g ORDER BY g;
----

query II nosort res_covar_samp
SELECT g, finalize(covar_samp(x, y) EXPORT_STATE) FROM grouped GROUP BY g ORDER BY g;
----

# combine non-empty covariance states
query II
WITH states AS (
	SELECT
		covar_pop(x, y) EXPORT_STATE AS pop_state,
		covar_samp(x, y) EXPORT_STATE AS samp_state
	FROM (VALUES (0, 1, 2), (0, 2, 4), (1, 3, 6), (1, 4, 8)) t(g, x, y)
	GROUP BY g
)
SELECT finalize(combine_aggr(pop_state)), finalize(combine_aggr(samp_state)) FROM states;
----
2.5	3.3333333333333335
