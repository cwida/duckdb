# name: test/sql/aggregate/aggregate_state_export/avg_timestamp_export_state.test
# description: Exported avg states of timestamps keep their infinities
# group: [aggregate_state_export]

# a state that saw an infinity has the maximum count, and 1 for infinity, 2 for -infinity or 3 for both as its value
query III
SELECT avg(ts) EXPORT_STATE, avg(ts) FILTER (ts < TIMESTAMP '2001-01-01') EXPORT_STATE, avg(ts) FILTER (ts > TIMESTAMP '1999-01-01') EXPORT_STATE
FROM (VALUES ('infinity'::TIMESTAMP), (TIMESTAMP '2000-01-01'), ('-infinity'::TIMESTAMP)) t(ts);
----
{'count': 18446744073709551615, 'value': 3}	{'count': 18446744073709551615, 'value': 2}	{'count': 18446744073709551615, 'value': 1}

query I
SELECT avg(ts) EXPORT_STATE FROM (VALUES (TIMESTAMP '2000-01-01'), (TIMESTAMP '2000-01-03')) t(ts);
----
{'count': 2, 'value': 1893542400000000}

# dates average as timestamps
query II
SELECT avg(d) EXPORT_STATE, finalize(avg(d) EXPORT_STATE) FROM (VALUES ('-infinity'::DATE), (DATE '2000-01-01')) t(d);
----
{'count': 18446744073709551615, 'value': 2}	-infinity

statement ok
CREATE VIEW states AS SELECT g, avg(ts) EXPORT_STATE AS st FROM (VALUES (0, 'infinity'::TIMESTAMP), (0, 'infinity'::TIMESTAMP), (1, TIMESTAMP '2000-01-01'), (1, TIMESTAMP '2000-01-03'), (2, '-infinity'::TIMESTAMP)) t(g, ts) GROUP BY g;

query III
SELECT finalize(combine(s0.st, s1.st)), finalize(combine(s1.st, s2.st)), finalize(combine(s0.st, s2.st))
FROM states s0, states s1, states s2 WHERE s0.g = 0 AND s1.g = 1 AND s2.g = 2;
----
infinity	-infinity	NULL

query II
SELECT finalize(combine_aggr(st)), finalize(combine_aggr(st) FILTER (g < 2)) FROM states;
----
NULL	infinity

# repeated states keep their infinities
query II
SELECT combine_aggr(st, 3), finalize(combine_aggr(st, 3)) FROM states WHERE g = 0;
----
{'count': 18446744073709551615, 'value': 1}	infinity

query III
SELECT finalize(combine_aggr(st, 2)), finalize(combine_aggr(st, 2) FILTER (g > 0)), finalize(combine_aggr(st, 2) FILTER (g <> 1)) FROM states;
----
NULL	-infinity	NULL

query II
SELECT combine_aggr(st, 2), finalize(combine_aggr(st, 2)) FROM (SELECT combine_aggr(st) AS st FROM states WHERE g <> 1);
----
{'count': 18446744073709551615, 'value': 3}	NULL

# a multiplicity of zero adds no infinity
query I
SELECT finalize(combine_aggr(st, CASE WHEN g = 0 THEN 0 ELSE 1 END)) FROM states WHERE g < 2;
----
2000-01-02 00:00:00

# imported states with the maximum count hold the infinities in their value
query I
SELECT finalize(to_aggregate_state({'count': 18446744073709551615, 'value': v}, 'avg', ['TIMESTAMP'])) FROM (VALUES (1::HUGEINT), (2), (3)) t(v) ORDER BY v;
----
infinity
-infinity
NULL

query II
SELECT finalize(combine(a, b)), finalize(combine(b, a)) FROM (SELECT to_aggregate_state({'count': 1, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']) AS a, to_aggregate_state({'count': 18446744073709551615, 'value': 2::HUGEINT}, 'avg', ['TIMESTAMP']) AS b);
----
-infinity	-infinity

# and other values with the maximum count are rejected
statement error
SELECT finalize(to_aggregate_state({'count': 18446744073709551615, 'value': 4::HUGEINT}, 'avg', ['TIMESTAMP']));
----
Invalid avg state - with a count of 18446744073709551615 the value must be 1 (infinity), 2 (-infinity) or 3 (both), not 4

foreach v 0 4 -1 18446744073709551617

statement error
SELECT finalize(to_aggregate_state({'count': 18446744073709551615, 'value': {v}::HUGEINT}, 'avg', ['TIMESTAMP']));
----
Invalid avg state - with a count of 18446744073709551615

statement error
SELECT finalize(combine_aggr(to_aggregate_state({'count': 18446744073709551615, 'value': {v}::HUGEINT}, 'avg', ['TIMESTAMPTZ'])));
----
Invalid avg state - with a count of 18446744073709551615

statement error
SELECT finalize(combine_aggr(to_aggregate_state({'count': 18446744073709551615, 'value': {v}::HUGEINT}, 'avg', ['TIMESTAMP']), 2));
----
Invalid avg state - with a count of 18446744073709551615

statement error
SELECT combine(to_aggregate_state({'count': 18446744073709551615, 'value': {v}::HUGEINT}, 'avg', ['TIMESTAMP']), st) FROM states;
----
Invalid avg state - with a count of 18446744073709551615

statement error
SELECT combine(st, to_aggregate_state({'count': 18446744073709551615, 'value': {v}::HUGEINT}, 'avg', ['TIMESTAMP'])) FROM states;
----
Invalid avg state - with a count of 18446744073709551615

endloop

# states with a count of 0 are empty whatever their value
query I
SELECT finalize(to_aggregate_state({'count': 0, 'value': v}, 'avg', ['TIMESTAMP'])) FROM (VALUES (1::HUGEINT), (2), (3), (5)) t(v) ORDER BY v;
----
NULL
NULL
NULL
NULL

query II
SELECT finalize(combine_aggr(st)), finalize(combine_aggr(st, 2)) FROM (SELECT to_aggregate_state({'count': 0, 'value': 18446744073709551617::HUGEINT}, 'avg', ['TIMESTAMP']) AS st);
----
NULL	NULL

query I
SELECT finalize(combine(to_aggregate_state({'count': 0, 'value': 5::HUGEINT}, 'avg', ['TIMESTAMP']), to_aggregate_state({'count': 0, 'value': -4::HUGEINT}, 'avg', ['TIMESTAMP'])));
----
NULL

query II
SELECT finalize(combine(a, b)), finalize(combine(b, a)) FROM (SELECT to_aggregate_state({'count': 1, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']) AS a, to_aggregate_state({'count': 0, 'value': 5::HUGEINT}, 'avg', ['TIMESTAMP']) AS b);
----
1970-01-01 00:00:00	1970-01-01 00:00:00

# counts that reach the maximum fail instead of turning into an infinity
statement error
SELECT finalize(combine(to_aggregate_state({'count': 18446744073709551614, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']), to_aggregate_state({'count': 1, 'value': 1::HUGEINT}, 'avg', ['TIMESTAMP'])));
----
Overflow in aggregate state combine

statement error
SELECT finalize(combine(to_aggregate_state({'count': 18446744073709551614, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']), to_aggregate_state({'count': 2, 'value': 1::HUGEINT}, 'avg', ['TIMESTAMP'])));
----
Overflow in aggregate state combine

statement error
SELECT finalize(combine_aggr(to_aggregate_state({'count': 6148914691236517205, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']), 3));
----
Overflow in repeated aggregate state combine

query I
SELECT finalize(combine_aggr(to_aggregate_state({'count': 6148914691236517204, 'value': 0::HUGEINT}, 'avg', ['TIMESTAMP']), 3));
----
1970-01-01 00:00:00
