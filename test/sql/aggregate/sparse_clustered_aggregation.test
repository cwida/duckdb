# name: test/sql/aggregate/sparse_clustered_aggregation.test
# description: Sparse and dense clustered aggregate inputs agree with filtered scatter updates
# group: [aggregate]

statement ok
SET threads=1;

# Keep every aggregate state type and hash-table mode in the fast suite. The slow variant also
# crosses the run-length, input-block and dense-transition matrices.
foreach threshold 0 12

statement ok
SET perfect_ht_threshold={threshold};

foreach type INTEGER BIGINT HUGEINT DOUBLE DECIMAL(18,2)

foreach run_length 1 65 64

foreach row_count 16513 16391

statement ok
CREATE OR REPLACE TABLE clustered_inputs AS
SELECT i, CASE WHEN i%257=0 THEN NULL ELSE (i//{run_length})%8 END AS g,
       (i//4096)%7 AS day,
       CASE WHEN (i//{run_length})%8=7 OR i%31=0 THEN NULL ELSE i%101-50 END::{type} AS v
FROM range({row_count}) t(i);

statement ok
CREATE OR REPLACE TABLE scatter_result AS SELECT g,
       sum(v*1) FILTER (WHERE i>=20000 OR day=0) AS s0,
       sum(v*2) FILTER (WHERE i>=20000 OR day=1) AS s1,
       sum(v*3) FILTER (WHERE i>=20000 OR day=2) AS s2,
       sum(v*4) FILTER (WHERE i>=20000 OR day=3) AS s3,
       sum(v*5) FILTER (WHERE i>=20000 OR day=4) AS s4,
       sum(v*6) FILTER (WHERE i>=20000 OR day=5) AS s5,
       sum(v*7) FILTER (WHERE i>=20000 OR day=6) AS s6
FROM clustered_inputs GROUP BY g;

statement ok
CREATE OR REPLACE TABLE clustered_result AS SELECT g,
       sum(CASE WHEN i>=20000 OR day=0 THEN v*1 END) AS s0,
       sum(CASE WHEN i>=20000 OR day=1 THEN v*2 END) AS s1,
       sum(CASE WHEN i>=20000 OR day=2 THEN v*3 END) AS s2,
       sum(CASE WHEN i>=20000 OR day=3 THEN v*4 END) AS s3,
       sum(CASE WHEN i>=20000 OR day=4 THEN v*5 END) AS s4,
       sum(CASE WHEN i>=20000 OR day=5 THEN v*6 END) AS s5,
       sum(CASE WHEN i>=20000 OR day=6 THEN v*7 END) AS s6
FROM clustered_inputs GROUP BY g;

query I
SELECT count(*) FROM (
    (TABLE clustered_result EXCEPT ALL TABLE scatter_result)
    UNION ALL
    (TABLE scatter_result EXCEPT ALL TABLE clustered_result)
);
----
0

endloop

endloop

endloop

endloop

statement ok
RESET perfect_ht_threshold;

# The final matrix entry matches the fixture used by these focused edge cases.
query IIII
SELECT g, sum(v), sum(v*2), count(*) FROM clustered_inputs WHERE g=7 OR g IS NULL GROUP BY g ORDER BY g NULLS LAST;
----
7	NULL	NULL	2048
NULL	-2	-4	64

query I
WITH a AS (
    SELECT g, sum(CASE WHEN day=0 THEN v END), sum(CASE WHEN day=1 THEN v END),
           count(*), count(v), first(NULL::INTEGER), stddev_samp(v),
           sum(v) FILTER (WHERE day=2), sum(DISTINCT v)
    FROM clustered_inputs GROUP BY g
), b AS (
    SELECT g, sum(v) FILTER (WHERE day=0), sum(v) FILTER (WHERE day=1),
           count(*), count(v), first(NULL::INTEGER), stddev_samp(v),
           sum(v) FILTER (WHERE day=2), sum(DISTINCT v)
    FROM clustered_inputs GROUP BY g
)
SELECT count(*) FROM (
    (TABLE a EXCEPT ALL TABLE b)
    UNION ALL
    (TABLE b EXCEPT ALL TABLE a)
);
----
0

query IIII
SELECT g, sum(NULL::BIGINT), sum(3), count(*)
FROM (VALUES (1),(1),(NULL),(NULL)) t(g) GROUP BY g ORDER BY g NULLS LAST;
----
1	NULL	6	2
NULL	NULL	6	2

query III
SELECT g, sum(CASE WHEN i%4=0 THEN 9000000000000000000::BIGINT END),
       sum(CASE WHEN i%4=1 THEN -9000000000000000000::BIGINT END)
FROM (SELECT i, (i//64)%2 AS g FROM range(8192) t(i)) t GROUP BY g ORDER BY g;
----
0	9216000000000000000000	-9216000000000000000000
1	9216000000000000000000	-9216000000000000000000

query I
SELECT count(*) FROM (SELECT g,sum(v),sum(v*2) FROM clustered_inputs WHERE FALSE GROUP BY g);
----
0

query I
WITH a AS (
    SELECT g, min(CASE WHEN i%7=0 THEN v END) AS lo,
           max(CASE WHEN i%7=1 THEN v END) AS hi,
           bit_xor(CASE WHEN i%7=2 THEN v::BIGINT END) AS bits
    FROM clustered_inputs GROUP BY g
), b AS (
    SELECT g, min(v) FILTER (WHERE i%7=0) AS lo,
           max(v) FILTER (WHERE i%7=1) AS hi,
           bit_xor(v::BIGINT) FILTER (WHERE i%7=2) AS bits
    FROM clustered_inputs GROUP BY g
)
SELECT count(*) FROM (
    (TABLE a EXCEPT ALL TABLE b)
    UNION ALL
    (TABLE b EXCEPT ALL TABLE a)
);
----
0

statement ok
CREATE TABLE dictionary_inputs AS
SELECT i, (i//64)%8 AS g, CASE WHEN i%7=0 THEN i%101-50 END::INTEGER AS v
FROM range(16513) t(i);

statement ok
CREATE TABLE flat_inputs AS SELECT * FROM dictionary_inputs WHERE i%3<>0;

foreach threshold 0 12

statement ok
SET perfect_ht_threshold={threshold};

query I
WITH a AS (
    SELECT g, sum(v) AS s, min(v) AS lo, max(v) AS hi, bit_xor(v) AS bits
    FROM dictionary_inputs WHERE i%3<>0 GROUP BY g
), b AS (
    SELECT g, sum(v) AS s, min(v) AS lo, max(v) AS hi, bit_xor(v) AS bits
    FROM flat_inputs GROUP BY g
)
SELECT count(*) FROM (
    (TABLE a EXCEPT ALL TABLE b)
    UNION ALL
    (TABLE b EXCEPT ALL TABLE a)
);
----
0

endloop

statement ok
RESET perfect_ht_threshold;
