# name: test/sql/aggregate/aggregates/test_histogram.test
# description: Test histogram aggregation
# group: [aggregates]

statement ok
SET debug_force_external=true;

query I
select histogram(NULL)
----
NULL

# Empty Table
query I
SELECT histogram(i) FROM range(100) tbl(i) WHERE 1=0;
----
NULL

query I
select histogram(1)
----
{1=1}

# Allow ascii characters in strings
query I
SELECT histogram('、')
----
{、=1}

query I
SELECT histogram(2) FROM range(100);
----
{2=100}

# floating-point buckets use SQL equality, including NaN equality
query T
WITH d(v) AS (
	VALUES (1.0), ('nan'::DOUBLE), ('nan'::DOUBLE), (1.0)
)
SELECT histogram(v)::VARCHAR FROM d;
----
{1.0=2, nan=2}

# window histograms keep the legacy state but use the same equality
query T
WITH d(v) AS (
	VALUES (1.0), ('nan'::DOUBLE), ('nan'::DOUBLE), (1.0)
)
SELECT histogram(v) OVER ()::VARCHAR FROM d LIMIT 1;
----
{1.0=2, nan=2}

statement ok
CREATE TABLE hist_data (g INTEGER, e INTEGER)

statement ok
INSERT INTO hist_data VALUES (1, 1), (1, 2), (2, 3), (2, 4), (2, 5), (3, 6), (5, NULL)


query T
SELECT histogram(g) from hist_data
----
{1=2, 2=3, 3=1, 5=1}

query T
SELECT histogram(e) from hist_data
----
{1=1, 2=1, 3=1, 4=1, 5=1, 6=1}

# frequency-based aggregates over the same value share their count stage
query TII
SELECT histogram(g)::VARCHAR, mode(g), round(entropy(g), 6) FROM hist_data;
----
{1=2, 2=3, 3=1, 5=1}	2	1.842371

query I
select histogram(g)
    from hist_data
    group by g%2==0 ORDER BY g%2==0
----
{1=2, 3=1, 5=1}
{2=3}

query I
select histogram(g)
    from hist_data
    where g < 3
----
{1=2, 2=3}

statement ok
create table names (name string)

statement ok
insert into names values ('pedro'), ('pedro'), ('pedro'),('hannes'),('hannes'),('mark'),(null),('Hubert Blaine Wolfeschlegelsteinhausenbergerdorff Sr.');

query I
select histogram(name) from names;
----
{Hubert Blaine Wolfeschlegelsteinhausenbergerdorff Sr.=1, hannes=2, mark=1, pedro=3}

# Variant time type binding (Issue #3290)
query I
SELECT histogram(CAST('2021-08-20' AS TIMESTAMP_S));
----
{'2021-08-20 00:00:00'=1}

query I
SELECT histogram(CAST('2021-08-20' AS TIMESTAMP_MS));
----
{'2021-08-20 00:00:00'=1}

query I
SELECT histogram(CAST('2021-08-20' AS TIMESTAMP_NS));
----
{'2021-08-20 00:00:00'=1}

query I
SELECT histogram(CAST('15:05:42' AS TIME));
----
{'15:05:42'=1}

query I
SELECT histogram(CAST('15:05:42+00' AS TIME WITH TIME ZONE));
----
{'15:05:42+00'=1}

query I
SELECT histogram(CAST('2022-01-02' AS DATE));
----
{2022-01-02=1}

query II rowsort
select g,histogram(g) over (partition by g%2)
    from hist_data;
----
1	{1=2, 3=1, 5=1}
1	{1=2, 3=1, 5=1}
2	{2=3}
2	{2=3}
2	{2=3}
3	{1=2, 3=1, 5=1}
5	{1=2, 3=1, 5=1}

#Corner cases
statement error
select histogram()
----

statement error
select histogram(*)
----

# enums
statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy')

statement ok
CREATE TABLE enums (e mood)

statement ok
INSERT INTO enums VALUES ('happy'), ('ok')

query I
SELECT histogram(e) FROM enums
----
{ok=1, happy=1}

# nested keys use the same relational rewrite
query TT
SELECT histogram([g])::VARCHAR, histogram({'g': g})::VARCHAR FROM hist_data;
----
{[1]=2, [2]=3, [3]=1, [5]=1}	{{'g': 1}=2, {'g': 2}=3, {'g': 3}=1, {'g': 5}=1}

# DISTINCT and FILTER are preserved by the frequency rewrite
query T
SELECT histogram(DISTINCT e) FILTER (WHERE g < 3)::VARCHAR FROM hist_data;
----
{1=1, 2=1, 3=1, 4=1, 5=1}

statement ok
SET explain_output='optimized_only';

# exact histograms use visible aggregate stages and reconstruct the map in a projection
query II
EXPLAIN (FORMAT JSON)
SELECT histogram(g), mode(g), entropy(g) FROM hist_data;
----
logical_opt	<REGEX>:.*"Groups":\s*"g".*count_star\(\).*row.*arg_max.*sum\(.*map_from_entries.*list_sort.*

statement ok
SET enable_optimizer=false;

# mandatory histogram lowering uses SQL equality without optional optimization
query T
WITH d(v) AS (
	VALUES (1.0), ('nan'::DOUBLE), ('nan'::DOUBLE), (1.0)
)
SELECT histogram(v)::VARCHAR FROM d;
----
{1.0=2, nan=2}

statement ok
SET enable_optimizer=true;

# raw histogram states (via the window self-join) combined into rows copied from another thread's hash table
statement ok
RESET debug_force_external;

statement ok
SET threads=4;

statement ok
CREATE TABLE parallel_hist AS SELECT i % 20000 AS g, md5(((i % 20000 + i // 20000) % 31)::VARCHAR) AS s
FROM range(200000) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT g, histogram(s) OVER (PARTITION BY g) h FROM parallel_hist) w
JOIN (SELECT g, histogram(s) h FROM parallel_hist GROUP BY g) r USING (g) WHERE w.h != r.h;
----
0
