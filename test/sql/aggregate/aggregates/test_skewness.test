# name: test/sql/aggregate/aggregates/test_skewness.test
# description: Test skewness aggregate
# group: [aggregates]

#Corner cases
statement error
select skewness()
----

query I
select skewness(NULL)
----
NULL

query I
select skewness(1)
----
NULL

statement error
select skewness(*)
----

# Constant Value (zero variance → NULL, since skewness is mathematically undefined)
query I
select skewness (10) from range (5)
----
NULL

#Empty Table
query I
select skewness (10) from range (5) where 1 == 0
----
NULL

# out of range
statement error
select skewness(i) from (values (-2e307), (0), (2e307)) tbl(i)
----

statement ok
create table aggr(k int, v decimal(10,2), v2 decimal(10, 2));

statement ok
insert into aggr values
    (1, 10, null),
    (2, 10, 11),
    (2, 10, 15),
    (2, 10, 18),
    (2, 20, 22),
    (2, 20, 25),
    (2, 25, null),
    (2, 30, 35),
    (2, 30, 40),
    (2, 30, 50),
    (2, 30, 51);

query III
select skewness(k), skewness(v), skewness(v2) from aggr
----
-3.316625	-0.163444	0.365401

query I
select skewness(v2) from aggr group by v ORDER BY ALL
----
-0.423273
-0.330141
NULL
NULL

# Window Function
query I
select skewness(v2) over (partition by v)
    from aggr order by v;
----
-0.423273
-0.423273
-0.423273
-0.423273
NULL
NULL
NULL
-0.330141
-0.330141
-0.330141
-0.330141

# Constant input must be NULL for every group size, type and magnitude (issue #27211):
# the raw sums of powers left rounding noise in the variance for n >= 19.
foreach val 69.6::DECIMAL(7,2) 123456.78::DECIMAL(10,2) 123456.78::DOUBLE -123456.78::DOUBLE 1e-6::DOUBLE 1e12::DOUBLE

query I
SELECT count(*) FROM (
    SELECT n, skewness(x) AS sk
    FROM (SELECT {val} AS x, n FROM range(1, 1001) r(n), range(0, 1001) k(k) WHERE k < n)
    GROUP BY n
) WHERE sk IS NOT NULL
----
0

endloop

query II
SELECT n, skewness(x)
FROM (SELECT 69.6::DECIMAL(7,2) AS x, n FROM range(1, 1001) r(n), range(0, 1001) k(k) WHERE k < n)
GROUP BY n HAVING n IN (3, 18, 19, 20, 100, 1000) ORDER BY n
----
3	NULL
18	NULL
19	NULL
20	NULL
100	NULL
1000	NULL

# a small but real variance on large magnitudes must not be mistaken for zero
query I
SELECT skewness(x) FROM (VALUES (1000000.0), (1000000.0), (1000000.001)) t(x)
----
1.7320508

# the result does not depend on the number of threads
statement ok
CREATE TABLE skew_groups AS
SELECT n % 8 AS g,
       (CASE WHEN n % 8 < 4 THEN 123456.78 ELSE 123456.78 + ((n * 7919) % 13) * ((n * 7919) % 13) END)::DOUBLE AS x
FROM range(200000) r(n);

statement ok
PRAGMA verify_parallelism

query II
SELECT g, skewness(x) FROM skew_groups GROUP BY g ORDER BY g
----
0	NULL
1	NULL
2	NULL
3	NULL
4	0.669249
5	0.669162
6	0.669211
7	0.669323

statement ok
PRAGMA disable_verify_parallelism

statement ok
SET threads=1

query II
SELECT g, skewness(x) FROM skew_groups GROUP BY g ORDER BY g
----
0	NULL
1	NULL
2	NULL
3	NULL
4	0.669249
5	0.669162
6	0.669211
7	0.669323
