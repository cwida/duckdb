# name: test/sql/aggregate/aggregates/quantile_infinite_timestamp.test
# description: Continuous quantile interpolation must not treat infinite timestamps as finite microsecond counts
# group: [aggregates]

# interpolating from -infinity used to return a finite nonsense value (144170-06-28 (BC) 09:59:32.612097)

statement error
SELECT median(ts) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

statement error
SELECT quantile_cont(ts, 0.25) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

statement error
SELECT quantile_cont(ts, [0.25, 0.75]) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# interpolating between the two infinities used to return the epoch

statement error
SELECT median(ts) FROM (VALUES ('-infinity'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# a tiny rank fraction used to round one microsecond below -infinity, outside of the timestamp range

statement error
SELECT quantile_cont(ts, 0.000000000000000001) FROM (VALUES ('-infinity'::TIMESTAMP), ('2000-01-01'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# both directions: towards +infinity as well

statement error
SELECT median(ts) FROM (VALUES ('2000-01-01'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# the other timestamp widths interpolate in the same domain

foreach tstype TIMESTAMPTZ TIMESTAMP_S TIMESTAMP_MS TIMESTAMP_NS

statement error
SELECT median(ts) FROM (VALUES ('-infinity'::{tstype}), ('1970-01-01'::{tstype})) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

endloop

# DATE interpolates in the TIMESTAMP domain

statement error
SELECT median(dt) FROM (VALUES ('-infinity'::DATE), ('1970-01-01'::DATE)) t(dt);
----
Cannot interpolate infinite TIMESTAMP values

statement error
SELECT quantile_cont(dt, [0.25, 0.75]) FROM (VALUES ('-infinity'::DATE), ('1970-01-01'::DATE)) t(dt);
----
Cannot interpolate infinite TIMESTAMP values

# mad interpolates its median in the TIMESTAMP domain as well

statement error
SELECT mad(ts) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# the maximum representable interpolation still succeeds across the whole finite range

query I
SELECT median(ts) FROM (VALUES ('290309-12-22 (BC) 00:00:00'::TIMESTAMP), ('294247-01-10 04:00:54.775806'::TIMESTAMP)) t(ts);
----
1970-01-01 02:00:27.387904

query I
SELECT median(ts) FROM (VALUES ('294247-01-10 04:00:54.775804'::TIMESTAMP), ('294247-01-10 04:00:54.775806'::TIMESTAMP)) t(ts);
----
294247-01-10 04:00:54.775805

query I
SELECT median(ts) FROM (VALUES ('2262-04-11 23:47:16.854775806'::TIMESTAMP_NS), ('1677-09-22'::TIMESTAMP_NS)) t(ts);
----
1970-01-01 11:53:38.427387904

# a tiny rank fraction next to an extreme endpoint must round to the endpoint, not past the int64 range

query I
SELECT quantile_cont(ts, -0.00000000000000000001)
FROM (VALUES ('294247-01-10 04:00:54.775806'::TIMESTAMP), ('1969-12-31 23:59:59.999997'::TIMESTAMP)) t(ts);
----
294247-01-10 04:00:54.775806

query I
SELECT quantile_cont(ts, 0.00000000000000000001)
FROM (VALUES ('290309-12-22 (BC) 00:00:00'::TIMESTAMP), ('294247-01-10 04:00:54.775806'::TIMESTAMP)) t(ts);
----
290309-12-22 (BC) 00:00:00

# equal values interpolate to themselves, including the sentinels

query II
SELECT median(ts), quantile_cont(ts, 0.25) FROM (VALUES ('infinity'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
infinity	infinity

query II
SELECT median(ts), quantile_cont(ts, 0.25) FROM (VALUES ('-infinity'::TIMESTAMP), ('-infinity'::TIMESTAMP)) t(ts);
----
-infinity	-infinity

# discrete quantiles do not interpolate and keep returning the sentinels

query II
SELECT quantile_disc(ts, 0.25), median(ts) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
-infinity	1970-01-01 00:00:00

# integral ranks pick an element directly and still pass through the sentinels

query I
SELECT quantile_cont(ts, [0.0, 0.5, 1.0]) FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP), ('infinity'::TIMESTAMP)) t(ts);
----
[-infinity, '1970-01-01 00:00:00', infinity]

# the DOUBLE overload keeps its IEEE infinity propagation

query I
SELECT median(d) FROM (VALUES ('-infinity'::DOUBLE), (0.0::DOUBLE)) t(d);
----
-inf

# descending interpolation (negative quantile) over the finite range

query I
SELECT quantile_cont(ts, -0.25) FROM (VALUES ('2000-01-01'::TIMESTAMP), ('2000-01-03'::TIMESTAMP)) t(ts);
----
2000-01-02 12:00:00

# the error surfaces as a regular error in the windowed path as well

statement error
SELECT median(ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

# the fallible marking survives plan serialization, which rebuilds the implementation in deserialize

statement ok
SET debug_verify_serializer=true;

statement error
SELECT median(ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM (VALUES ('-infinity'::TIMESTAMP), ('1970-01-01'::TIMESTAMP)) t(ts);
----
Cannot interpolate infinite TIMESTAMP values

statement ok
SET debug_verify_serializer=false;

query I
SELECT median(ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM (VALUES ('2000-01-01'::TIMESTAMP), ('2000-01-03'::TIMESTAMP)) t(ts) QUALIFY ts = '2000-01-03';
----
2000-01-02 00:00:00
