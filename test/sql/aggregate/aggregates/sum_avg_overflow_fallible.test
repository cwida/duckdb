# name: test/sql/aggregate/aggregates/sum_avg_overflow_fallible.test
# description: Aggregates with checked HUGEINT/interval accumulation must be registered as fallible
# group: [aggregates]

# accumulation overflow raises as a regular error

statement error
SELECT sum(d) FROM (VALUES ('99999999999999999999999999999999999999'::DECIMAL(38,0)),
                           ('99999999999999999999999999999999999999'::DECIMAL(38,0))) t(d);
----
Overflow in HUGEINT addition

# a sum that fits in HUGEINT but not in DECIMAL(38) raises in finalize

statement error
SELECT sum(d) FROM (VALUES ('60000000000000000000000000000000000000'::DECIMAL(38,0)),
                           ('60000000000000000000000000000000000000'::DECIMAL(38,0))) t(d);
----
Overflow in SUM of DECIMAL

statement error
SELECT sum(h) FROM (VALUES (170141183460469231731687303715884105727::HUGEINT), (1::HUGEINT)) t(h);
----
Overflow in HUGEINT addition

statement error
SELECT avg(d) FROM (VALUES ('99999999999999999999999999999999999999'::DECIMAL(38,0)),
                           ('99999999999999999999999999999999999999'::DECIMAL(38,0))) t(d);
----
Overflow in HUGEINT addition

statement error
SELECT avg(h) FROM (VALUES (170141183460469231731687303715884105727::HUGEINT),
                           (170141183460469231731687303715884105727::HUGEINT)) t(h);
----
Overflow in HUGEINT addition

statement error
SELECT avg(i) FROM (VALUES (INTERVAL '2147483647 months'), (INTERVAL '2147483647 months')) t(i);
----
Overflow in addition

statement error
SELECT decimal_average(d) FROM (VALUES ('99999999999999999999999999999999999999'::DECIMAL(38,0)),
                                       ('99999999999999999999999999999999999999'::DECIMAL(38,0))) t(d);
----
decimal_average: intermediate sum overflowed HUGEINT range

# the EXPLAIN (SQL) pivot default export fixtures live in fallible_pivot_default_export.test,
# which is excluded from the aggregate state export verification config

# the scalarized window form keeps working under dictionary vector verification

statement ok
SET debug_verify_vector='dictionary_expression';

query I rowsort
SELECT sum(d) OVER (ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
FROM (VALUES (1.5::DECIMAL(38,1)), (2.5::DECIMAL(38,1))) t(d);
----
1.5
2.5

statement ok
RESET debug_verify_vector;

# valid aggregation is unaffected

query IIII
SELECT sum(d), avg(h), avg(i), decimal_average(d)
FROM (VALUES (1.0::DECIMAL(38,1), 2::HUGEINT, INTERVAL 1 DAY),
             (2.0::DECIMAL(38,1), 4::HUGEINT, INTERVAL 3 DAY)) t(d, h, i);
----
3.0	3.0	2 days	1.5
