query IIIIRII
SELECT g, sum(v) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q >= 50), sum(i) FILTER (WHERE q < 50), avg(v) FILTER (WHERE q < 50), sum(v + 1) FILTER (WHERE q < 50), max(v + 1) FILTER (WHERE q < 50) FROM t GROUP BY g ORDER BY g
----
