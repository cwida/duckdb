# many groups: the per-group results add up to the ungrouped ones
query IIIIII
SELECT count(*), sum(c), sum(s1), sum(s2), sum(n), sum(d) FROM (SELECT i % 1000 AS k, count(*) FILTER (WHERE q BETWEEN 1 AND 20) c, sum(v) FILTER (WHERE q BETWEEN 1 AND 20) s1, sum(v) FILTER (WHERE q BETWEEN 21 AND 40) s2, count(*) FILTER (WHERE q IS NULL) n, count(DISTINCT v) FILTER (WHERE q BETWEEN 1 AND 20) d FROM t GROUP BY k)
----
1000	16000	80000	80008	20000	1760

