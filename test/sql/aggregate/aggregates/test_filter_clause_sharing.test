12	NULL	0	NULL	142836

# DISTINCT aggregates with filters
query IIIIIII
SELECT g, count(DISTINCT v) FILTER (WHERE q < 50), sum(DISTINCT v) FILTER (WHERE q < 50), count(DISTINCT s) FILTER (WHERE q < 50), count(DISTINCT v), count(*) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q < 50) FROM t GROUP BY g ORDER BY g
