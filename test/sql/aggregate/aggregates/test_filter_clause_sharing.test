# name: test/sql/aggregate/aggregates/test_filter_clause_sharing.test
# description: Aggregates whose FILTER clauses are shared: a filter is evaluated once per chunk and its selection is reused
# group: [aggregates]

statement ok
PRAGMA verify_parallelism

foreach threads 1 8

statement ok
PRAGMA threads={threads}

statement ok
CREATE OR REPLACE TABLE t AS SELECT i::INTEGER AS i, (i % 7)::INTEGER AS g, CASE WHEN i % 5 = 0 THEN NULL ELSE (i % 100)::INTEGER END AS q, ((i * 3) % 11)::INTEGER AS v, CASE WHEN i % 3 = 0 THEN NULL ELSE 'k' || (i % 4) END AS s FROM range(100000) tbl(i)

statement ok
CREATE OR REPLACE TABLE b AS SELECT i::INTEGER AS i, i % 2 = 0 AS flag, CASE WHEN i % 3 = 0 THEN NULL ELSE i % 5 = 0 END AS nflag FROM range(1000) tbl(i)

# ungrouped
# identical filters shared by several aggregates (count(*), count(col), sum, avg, min, max)
query IIIIRII
SELECT count(*) FILTER (WHERE q BETWEEN 1 AND 20), count(q) FILTER (WHERE q BETWEEN 1 AND 20), count(s) FILTER (WHERE q BETWEEN 1 AND 20), sum(v) FILTER (WHERE q BETWEEN 1 AND 20), avg(v) FILTER (WHERE q BETWEEN 1 AND 20), min(i) FILTER (WHERE q BETWEEN 1 AND 20), max(i) FILTER (WHERE q BETWEEN 1 AND 20) FROM t
----
16000	16000	10667	80000	5.0	1	99919

# the same results through a WHERE clause
query IIIIRII
SELECT count(*), count(q), count(s), sum(v), avg(v), min(i), max(i) FROM t WHERE q BETWEEN 1 AND 20
----
16000	16000	10667	80000	5.0	1	99919

# five ranges, three aggregates each
query IRIIRIIRIIRIIRI
SELECT count(*) FILTER (WHERE q BETWEEN 1 AND 20), avg(v) FILTER (WHERE q BETWEEN 1 AND 20), sum(i) FILTER (WHERE q BETWEEN 1 AND 20), count(*) FILTER (WHERE q BETWEEN 21 AND 40), avg(v) FILTER (WHERE q BETWEEN 21 AND 40), sum(i) FILTER (WHERE q BETWEEN 21 AND 40), count(*) FILTER (WHERE q BETWEEN 41 AND 60), avg(v) FILTER (WHERE q BETWEEN 41 AND 60), sum(i) FILTER (WHERE q BETWEEN 41 AND 60), count(*) FILTER (WHERE q BETWEEN 61 AND 80), avg(v) FILTER (WHERE q BETWEEN 61 AND 80), sum(i) FILTER (WHERE q BETWEEN 61 AND 80), count(*) FILTER (WHERE q BETWEEN 81 AND 100), avg(v) FILTER (WHERE q BETWEEN 81 AND 100), sum(i) FILTER (WHERE q BETWEEN 81 AND 100) FROM t
----
16000	5.0	799360000	16000	5.0005	799680000	16000	4.999625	800000000	16000	5.000125	800320000	16000	4.9999375	800640000

# one of the ranges through a WHERE clause
query IRI
SELECT count(*), avg(v), sum(i) FROM t WHERE q BETWEEN 61 AND 80
----
16000	5.000125	800320000

# the same with a WHERE clause on the filtered column
query IIIII
SELECT count(*) FILTER (WHERE q BETWEEN 1 AND 20), sum(v) FILTER (WHERE q BETWEEN 1 AND 20), count(*) FILTER (WHERE q BETWEEN 21 AND 40), sum(v) FILTER (WHERE q BETWEEN 21 AND 40), count(*) FROM t WHERE q BETWEEN 1 AND 40
----
16000	80000	16000	80008	32000

# NULL filter values exclude the row
query IIIIIII
SELECT count(*) FILTER (WHERE q > 50), count(*) FILTER (WHERE q IS NULL), count(*) FILTER (WHERE NULL), sum(v) FILTER (WHERE NULL), count(*) FILTER (WHERE q > 50 OR q IS NULL), count(q) FILTER (WHERE q > 50 OR q IS NULL), count(*) FROM t
----
40000	20000	0	NULL	60000	40000	100000

# filters on different columns mixed with unfiltered aggregates
query IIIIIIIII
SELECT sum(v), sum(v) FILTER (WHERE s = 'k1'), sum(v) FILTER (WHERE v > 5), sum(v) FILTER (WHERE s = 'k1' AND v > 5), count(*), count(*) FILTER (WHERE s = 'k1'), max(q) FILTER (WHERE s = 'k1'), min(q) FILTER (WHERE v > 5), count(s) FILTER (WHERE v > 5) FROM t
----
499997	83346	363632	60617	100000	16667	97	1	30302

# the same child under different filters and different children under the same filter
query IIIRIIII
SELECT sum(v) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q >= 50), sum(i) FILTER (WHERE q < 50), avg(v) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q < 50) * 2, sum(v + 1) FILTER (WHERE q < 50), max(v + 1) FILTER (WHERE q < 50), sum(v + 1) FILTER (WHERE q >= 50) FROM t
----
200004	199999	1999000000	5.0001	400008	240004	11	239999

# filter and child read the same columns
query IIRI
SELECT sum(q) FILTER (WHERE q + v > 60), count(*) FILTER (WHERE q + v > 60), avg(q + v) FILTER (WHERE q + v > 60), sum(q + v) FILTER (WHERE q + v > 60) FROM t
----
2765491	35637	82.83124280943963	2951857

# a filter that shares a sub-expression with the children and is repeated
query IIIII
SELECT sum(v * 2) FILTER (WHERE v * 2 > 10), count(*) FILTER (WHERE v * 2 > 10), max(v * 2) FILTER (WHERE v * 2 > 10), sum(v * 2), sum(v * 2) FILTER (WHERE v * 2 > 10 AND q IS NOT NULL) FROM t
----
727264	45454	20	999994	581824

# the same through a WHERE clause
query III
SELECT sum(v * 2), count(*), max(v * 2) FROM t WHERE v * 2 > 10
----
727264	45454	20

# boolean columns as filters, including NULLs
query IIIIIII
SELECT count(*) FILTER (WHERE flag), count(*) FILTER (WHERE nflag), count(*) FILTER (WHERE NOT nflag), sum(i) FILTER (WHERE flag), sum(i) FILTER (WHERE nflag), sum(i) FILTER (WHERE flag AND nflag), count(*) FROM b
----
500	133	533	249500	66335	32670	1000

# DISTINCT aggregates with and without filters next to regular ones
query IIIIIII
SELECT count(DISTINCT g) FILTER (WHERE q < 50), count(DISTINCT g), count(DISTINCT v) FILTER (WHERE q < 50), sum(DISTINCT v) FILTER (WHERE q < 50), count(DISTINCT s) FILTER (WHERE q < 50), count(*) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q < 50) FROM t
----
7	7	11	55	4	40000	200004

# the same through a WHERE clause
query IIIIII
SELECT count(DISTINCT g), count(DISTINCT v), sum(DISTINCT v), count(DISTINCT s), count(*), sum(v) FROM t WHERE q < 50
----
7	11	55	4	40000	200004

# volatile children are not shared
query III
SELECT a <> b, len(a), len(b) FROM (SELECT list(random()) FILTER (WHERE i < 10) a, list(random()) FILTER (WHERE i < 10) b FROM range(100) t(i))
----
false	10	10

# deterministic children are
query II
SELECT a = b, len(a) FROM (SELECT list(i * 2) FILTER (WHERE i < 10) a, list(i * 2) FILTER (WHERE i < 10) b FROM range(100) t(i))
----
true	10

# no rows pass the filter
query IIII
SELECT count(*) FILTER (WHERE i < 0), sum(i) FILTER (WHERE i < 0), count(*) FILTER (WHERE i >= 0), sum(i) FILTER (WHERE i >= 0) FROM range(1000) t(i)
----
0	NULL	1000	499500

# grouped: perfect hash and hash aggregate
foreach threshold 0 32

statement ok
SET perfect_ht_threshold={threshold}

# identical filters shared by several aggregates
query IIIIIRII
SELECT g, count(*) FILTER (WHERE q BETWEEN 1 AND 20), count(q) FILTER (WHERE q BETWEEN 1 AND 20), count(s) FILTER (WHERE q BETWEEN 1 AND 20), sum(v) FILTER (WHERE q BETWEEN 1 AND 20), avg(v) FILTER (WHERE q BETWEEN 1 AND 20), min(i) FILTER (WHERE q BETWEEN 1 AND 20), max(i) FILTER (WHERE q BETWEEN 1 AND 20) FROM t GROUP BY g ORDER BY g
----
0	2285	2285	1525	11434	5.003938730853392	7	99918
1	2286	2286	1523	11430	5.0	1	99919
2	2285	2285	1520	11416	4.996061269146608	2	99913
3	2286	2286	1522	11430	5.0	3	99914
4	2286	2286	1525	11433	5.001312335958005	4	99908
5	2286	2286	1526	11427	4.998687664041995	12	99916
6	2286	2286	1526	11430	5.0	6	99917

# the same results through a WHERE clause
query IIIIIRII
SELECT g, count(*), count(q), count(s), sum(v), avg(v), min(i), max(i) FROM t WHERE q BETWEEN 1 AND 20 GROUP BY g ORDER BY g
----
0	2285	2285	1525	11434	5.003938730853392	7	99918
1	2286	2286	1523	11430	5.0	1	99919
2	2285	2285	1520	11416	4.996061269146608	2	99913
3	2286	2286	1522	11430	5.0	3	99914
4	2286	2286	1525	11433	5.001312335958005	4	99908
5	2286	2286	1526	11427	4.998687664041995	12	99916
6	2286	2286	1526	11430	5.0	6	99917

# several filters, mixed with unfiltered aggregates
query IIIIIIIIII
SELECT g, count(*), count(*) FILTER (WHERE q BETWEEN 1 AND 20), sum(v) FILTER (WHERE q BETWEEN 1 AND 20), count(*) FILTER (WHERE q BETWEEN 21 AND 40), sum(v) FILTER (WHERE q BETWEEN 21 AND 40), sum(v) FILTER (WHERE s = 'k1'), count(*) FILTER (WHERE q IS NULL), count(*) FILTER (WHERE NULL), sum(v) FROM t GROUP BY g ORDER BY g
----
