# a filter that shares a sub-expression with the children and with the group
query IIIII
SELECT g * 2 AS g2, sum(v * 2) FILTER (WHERE v * 2 > 10 AND g * 2 < 8), count(*) FILTER (WHERE v * 2 > 10 AND g * 2 < 8), max(v * 2) FILTER (WHERE v * 2 > 10 AND g * 2 < 8), sum(v * 2) FROM t GROUP BY g2 ORDER BY g2
----
