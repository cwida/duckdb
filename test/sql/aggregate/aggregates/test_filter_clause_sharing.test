query IIIII
SELECT g, count(*) FILTER (WHERE q < 50), sum(v) FILTER (WHERE q < 50), count(*) FILTER (WHERE q >= 50), sum(v) FILTER (WHERE q < 50) FROM t GROUP BY ROLLUP(g) ORDER BY g NULLS LAST
