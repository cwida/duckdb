# name: test/sql/json/scalar/test_json_structure_deep.test
# description: json_structure on a deeply nested JSON column is supported, including through TRY
# group: [scalar]

require json

statement ok
CREATE TABLE j AS SELECT ('{' || repeat('"k":{', 200) || '"v":1' || repeat('}', 200) || '}')::JSON AS c;

query I
SELECT json_structure(c) = '{' || repeat('"k":{', 200) || '"v":"UBIGINT"' || repeat('}', 200) || '}' FROM j;
----
true

query I
SELECT TRY(json_structure(c)) = '{' || repeat('"k":{', 200) || '"v":"UBIGINT"' || repeat('}', 200) || '}' FROM j;
----
true
