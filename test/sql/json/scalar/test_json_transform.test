# enum tests
statement ok
CREATE OR REPLACE TYPE test_enum AS ENUM ('a', 'b', 'c');

query T
select json_transform('{"test": "a"}', '{"test": "test_enum"}')
----
{'test': a}

query T
select json_transform('{"test": ["a","b"]}', '{"test": "test_enum[]"}')
----
{'test': [a, b]}

query T
select json_transform('{"test": ["a","b"]}', '{"test": "test_enum[2]"}')
----
{'test': [a, b]}

statement ok
DROP TYPE test_enum;

# object keys containing an embedded NUL byte must not be truncated
query T
select to_json(json_transform('{"a\u0000b":1}', '{"a\u0000b":"INTEGER"}'))
----
{"a\u0000b":1}

query T
select to_json(json_transform_strict('{"a\u0000b":1}', '{"a\u0000b":"INTEGER"}'))
----
{"a\u0000b":1}
