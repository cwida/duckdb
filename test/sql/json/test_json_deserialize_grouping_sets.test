Grouping set refers to a group that does not exist

query I
SELECT json_deserialize_sql(json_serialize_sql('SELECT a FROM (SELECT 1 a) GROUP BY GROUPING SETS ((a), ())'));
----
SELECT a FROM (SELECT 1 AS a) GROUP BY GROUPING SETS ((a),())

query I
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT a FROM (SELECT 1 a) GROUP BY ROLLUP (a) ORDER BY a NULLS FIRST'));
----
NULL
1
