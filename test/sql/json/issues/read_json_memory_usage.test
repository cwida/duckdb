# name: test/sql/json/issues/read_json_memory_usage.test
# description: Test JSON memory usage (internal issue #1683)
# group: [issues]

require json

statement ok
SET threads=8;

statement ok
SET memory_limit='200MiB';

query I
SELECT * FROM read_json_objects('{DATA_DIR}/json/example_rn.ndjson', format='nd');
----
{"id":1,"name":"O Brother, Where Art Thou?"}
{"id":2,"name":"Home for the Holidays"}
{"id":3,"name":"The Firm"}
{"id":4,"name":"Broadcast News"}
{"id":5,"name":"Raising Arizona"}

statement ok
SET memory_limit='50MiB';

query I
SELECT * FROM read_json_objects('{DATA_DIR}/json/example_rn.ndjson', format='nd');
----
{"id":1,"name":"O Brother, Where Art Thou?"}
{"id":2,"name":"Home for the Holidays"}
{"id":3,"name":"The Firm"}
{"id":4,"name":"Broadcast News"}
{"id":5,"name":"Raising Arizona"}

statement ok
SET memory_limit='20MiB';

statement error
SELECT * FROM read_json_objects('{DATA_DIR}/json/example_rn.ndjson', format='nd');
----
Out of Memory Error

# union_by_name must not keep a full buffer alive per file
statement ok
SET threads=2;

statement ok
SET memory_limit='500MiB';

statement ok
COPY (SELECT 1 AS a) TO '{TEMP_DIR}/union_by_name_one.json';

query I
SELECT count(*) FROM read_json(list_transform(range(100), lambda i: '{TEMP_DIR}/union_by_name_one.json'), union_by_name = true);
----
100
