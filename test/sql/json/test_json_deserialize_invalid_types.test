# name: test/sql/json/test_json_deserialize_invalid_types.test
# description: Test deserializing corrupted logical types from serialized SQL
# group: [json]

require json

require json

# ENUM with fewer values than values_count
statement error
SELECT json_deserialize_sql($json$
{"error":false,"statements":[{"node":{"type":"SELECT_NODE","modifiers":[],"cte_map":{"map":[]},"select_list":[{"class":"CONSTANT","type":"VALUE_CONSTANT","alias":"","query_location":7,"value":{"type":{"id":"ENUM","type_info":{"type":"ENUM_TYPE_INFO","alias":"","values_count":3,"values":["a"]}},"is_null":false,"value":0}}],"from_table":{"type":"EMPTY","alias":"","sample":null,"query_location":18446744073709551615},"where_clause":null,"group_expressions":[],"group_sets":[],"aggregate_handling":"STANDARD_HANDLING","having":null,"sample":null,"qualify":null},"named_param_map":[]}]}
$json$);
----
