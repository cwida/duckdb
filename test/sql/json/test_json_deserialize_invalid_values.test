# name: test/sql/json/test_json_deserialize_invalid_values.test
# description: Deserialized constants must be within the domain of their type
# group: [json]

require json

# ENUM index beyond the dictionary
statement error
SELECT json_deserialize_sql('{"error":false,"statements":[{"node":{"type":"SELECT_NODE","modifiers":[],"cte_map":{"map":[]},"select_list":[{"class":"CONSTANT","type":"VALUE_CONSTANT","alias":"","query_location":0,"query_location_length":0,"value":{"type":{"id":"ENUM","type_info":{"type":"ENUM_TYPE_INFO","alias":"","extension_info":null,"values_count":2,"values":["a","b"]}},"is_null":false,"value":200}}],"from_table":{"type":"EMPTY","alias":"","sample":null,"query_location":0,"query_location_length":0},"where_clause":null,"group_expressions":[],"group_sets":[],"aggregate_handling":"STANDARD_HANDLING","having":null,"sample":null,"qualify":null},"named_param_map":[]}]}')
----
value is not valid for type ENUM('a', 'b')

