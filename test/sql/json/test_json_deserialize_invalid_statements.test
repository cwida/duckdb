# name: test/sql/json/test_json_deserialize_invalid_statements.test
# description: Deserialized statements must have a valid shape
# group: [json]

require json

# comparison with a type that is not a comparison
statement error
SELECT json_deserialize_sql('{"error":false,"statements":[{"node":{"type":"SELECT_NODE","modifiers":[],"cte_map":{"map":[]},"select_list":[{"class":"COMPARISON","type":"OPERATOR_NOT","alias":"","query_location":7,"query_location_length":5,"left":{"class":"CONSTANT","type":"VALUE_CONSTANT","alias":"","query_location":7,"query_location_length":1,"literal":{"kind":"INTEGER","text":"1"}},"right":{"class":"CONSTANT","type":"VALUE_CONSTANT","alias":"","query_location":11,"query_location_length":1,"literal":{"kind":"INTEGER","text":"2"}}}],"from_table":{"type":"EMPTY","alias":"","sample":null,"query_location":18446744073709551615,"query_location_length":0},"where_clause":null,"group_expressions":[],"group_sets":[],"aggregate_handling":"STANDARD_HANDLING","having":null,"sample":null,"qualify":null},"named_param_map":[]}]}');
----
invalid comparison type OPERATOR_NOT

