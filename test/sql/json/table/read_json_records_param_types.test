# name: test/sql/json/table/read_json_records_param_types.test
# description: Validation of reader named parameters
# group: [table]

require json

require parquet

statement ok
COPY (SELECT 1 i) TO '{TEST_DIR}/r.json'

statement error
SELECT * FROM read_json('{TEST_DIR}/r.json', records := 1)
----
"records" parameter must be a string

statement error
SELECT * FROM read_json('{TEST_DIR}/r.json', records := [1])
----
"records" parameter must be a string

statement error
SELECT * FROM read_ndjson('{TEST_DIR}/r.json', records := {'a': 1})
----
"records" parameter must be a string

query I
SELECT i FROM read_json('{TEST_DIR}/r.json', records := true)
----
1

query I
SELECT i FROM read_json('{TEST_DIR}/r.json', records := 'auto')
----
1

statement ok
COPY (SELECT 1 i) TO '{TEST_DIR}/r.csv'

statement error
SELECT * FROM read_csv('{TEST_DIR}/r.csv', buffer_size := -1)
----
Buffer Size option must be higher than 0

statement error
SELECT * FROM sniff_csv('{TEST_DIR}/r.csv', buffer_size := -1)
----
Buffer Size option must be higher than 0

statement error
SELECT * FROM read_csv('{TEST_DIR}/r.csv', hive_types := {})
----
'hive_types' must specify the type of at least one column

statement ok
COPY (SELECT 1 i) TO '{TEST_DIR}/r.parquet'

statement error
SELECT * FROM read_parquet('{TEST_DIR}/r.parquet', hive_types := {})
----
'hive_types' must specify the type of at least one column
