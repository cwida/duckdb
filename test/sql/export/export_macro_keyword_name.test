# name: test/sql/export/export_macro_keyword_name.test
# description: EXPORT DATABASE writes a keyword macro name quoted and IMPORT DATABASE reads it back
# group: [export]

statement ok
CREATE MACRO semi(x) AS x + 1

statement ok
EXPORT DATABASE '{TEST_DIR}/export_macro_keyword_name'

query I
SELECT contains(content, '"semi"') FROM read_text('{TEST_DIR}/export_macro_keyword_name/schema.sql')
----
true

statement ok
DROP MACRO semi

statement ok
IMPORT DATABASE '{TEST_DIR}/export_macro_keyword_name'

query I
SELECT semi(1)
----
2
