# doesn't work in combination with certain params
statement error
COPY bigdata TO '{TEST_DIR}/row_groups_per_file_error' (FORMAT PARQUET, ROW_GROUPS_PER_FILE 1, USE_TMP_FILE TRUE);
----
Not implemented Error

statement ok
CREATE TABLE partitioned_bigdata AS
SELECT col_a % 4 AS part, col_a, col_b FROM bigdata;

statement ok
COPY partitioned_bigdata
TO '{TEST_DIR}/row_groups_per_file_partitioned'
(FORMAT PARQUET, ROW_GROUP_SIZE 1000, ROW_GROUPS_PER_FILE 1, PARTITION_BY part);

query I
SELECT count(*)
FROM read_parquet('{TEST_DIR}/row_groups_per_file_partitioned/**/*.parquet', hive_partitioning = true);
----
10000

query I
WITH files AS (
	SELECT part, count(DISTINCT filename) file_count
	FROM read_parquet(
		'{TEST_DIR}/row_groups_per_file_partitioned/**/*.parquet',
		filename = true,
		hive_partitioning = true
	)
	GROUP BY part
)
SELECT min(file_count) > 1
FROM files;
----
true

# FILE_SIZE_BYTES next to ROW_GROUPS_PER_FILE: either limit rotates the file (the file size check used to
# shadow the row group count)
statement ok
COPY bigdata TO '{TEST_DIR}/row_groups_per_file_and_size' (FORMAT PARQUET, ROW_GROUP_SIZE 2000, ROW_GROUPS_PER_FILE 1, FILE_SIZE_BYTES '1GB')

query I
SELECT count(*) FROM glob('{TEST_DIR}/row_groups_per_file_and_size/*.parquet')
----
5

query I
SELECT count(*) FROM '{TEST_DIR}/row_groups_per_file_and_size/*.parquet'
----
10000
