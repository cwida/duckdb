# name: test/sql/copy/partitioned/partitioned_order_by_flush_race.test
# description: Cover partitioned COPY ORDER_BY intermediate flushing
# group: [partitioned]

require parquet

statement ok
SET debug_force_external=true;

statement ok
PRAGMA threads=6;

statement ok
SET partitioned_write_flush_threshold=2048;

statement ok
CREATE TABLE large_ordered_source AS
SELECT
	(i % 16)::INTEGER AS p,
	((i * 17) % 65536)::INTEGER AS v
FROM range(131072) tbl(i);

statement ok
COPY (SELECT p, v FROM large_ordered_source ORDER BY v DESC, p DESC)
TO '{TEST_DIR}/large_ordered_partitioned'
(FORMAT PARQUET, PARTITION_BY (p), ORDER_BY (p, v), ROW_GROUP_SIZE 2048);

query I
SELECT count(*)
FROM read_parquet('{TEST_DIR}/large_ordered_partitioned/**/*.parquet', hive_partitioning = true);
----
131072
