# name: test/sql/copy/async_file_lifecycle.test
# description: test async COPY file open/finalize lifecycle paths
# group: [copy]

# simulates filesystem latency, which only a driver that links debug_fs can provide
require debug_fs

require parquet

statement ok
SET threads=1;

statement ok
SET async_threads=2;

statement ok
SET GLOBAL debug_fs_delay_mean_ms=1.0;

statement ok
CREATE TABLE lifecycle AS
SELECT i, i % 3 AS p, repeat('x', 10) AS payload
FROM range(0, 4096) t(i);

# Incomplete CSV and Parquet outputs are aborted by their writers
statement error
COPY (SELECT CASE WHEN i = 4096 THEN error('injected CSV failure') ELSE i::VARCHAR END AS v
      FROM range(8192) t(i))
TO '{TEST_DIR}/async_lifecycle_failed.csv' (FORMAT CSV, PRESERVE_ORDER false);
----
injected CSV failure

query I
SELECT count(*) FROM glob('{TEST_DIR}/async_lifecycle_failed.csv');
----
0

statement error
COPY (SELECT CASE WHEN i = 4096 THEN error('injected compressed CSV failure') ELSE i::VARCHAR END AS v
      FROM range(8192) t(i))
TO '{TEST_DIR}/async_lifecycle_failed.csv.gz' (FORMAT CSV, COMPRESSION GZIP, PRESERVE_ORDER false);
----
injected compressed CSV failure

query I
SELECT count(*) FROM glob('{TEST_DIR}/async_lifecycle_failed.csv.gz');
----
0

statement error
COPY (SELECT CASE WHEN i = 4096 THEN error('injected Parquet failure') ELSE i END AS v
      FROM range(8192) t(i))
TO '{TEST_DIR}/async_lifecycle_failed.parquet' (FORMAT PARQUET, PRESERVE_ORDER false);
----
injected Parquet failure

query I
SELECT count(*) FROM glob('{TEST_DIR}/async_lifecycle_failed.parquet');
----
0

# Non-exclusive abort preserves a pre-existing path
statement ok
COPY (SELECT 'before' AS v) TO '{TEST_DIR}/async_lifecycle_existing.csv' (FORMAT CSV);

statement error
COPY (SELECT CASE WHEN i = 4096 THEN error('injected existing CSV failure') ELSE i::VARCHAR END AS v
      FROM range(8192) t(i))
TO '{TEST_DIR}/async_lifecycle_existing.csv' (FORMAT CSV, USE_TMP_FILE false, PRESERVE_ORDER false);
----
injected existing CSV failure

query I
SELECT count(*) FROM glob('{TEST_DIR}/async_lifecycle_existing.csv');
----
1

statement ok
COPY (SELECT 'before' AS v) TO '{TEST_DIR}/async_lifecycle_existing.parquet' (FORMAT PARQUET);

statement error
COPY (SELECT CASE WHEN i = 4096 THEN error('injected existing Parquet failure') ELSE i END AS v
      FROM range(8192) t(i))
TO '{TEST_DIR}/async_lifecycle_existing.parquet' (FORMAT PARQUET, USE_TMP_FILE false, PRESERVE_ORDER false);
----
injected existing Parquet failure

query I
SELECT count(*) FROM glob('{TEST_DIR}/async_lifecycle_existing.parquet');
----
1

statement ok
SET threads=4;

query II
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_single.parquet' (FORMAT PARQUET, RETURN_FILES);
----
4096	<REGEX>:.*async_lifecycle_single.parquet.*

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_single.parquet');
----
4096

query IIIIIII
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_stats.parquet' (FORMAT PARQUET, RETURN_STATS);
----
<REGEX>:.*async_lifecycle_stats.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:.*	NULL	<REGEX>:.*

statement ok
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_tmp.parquet' (FORMAT PARQUET, USE_TMP_FILE TRUE);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_tmp.parquet');
----
4096

statement ok
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_rotate'
(FORMAT PARQUET, ROW_GROUP_SIZE 1024, ROW_GROUPS_PER_FILE 1);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_rotate/*.parquet');
----
4096

query I
SELECT count(*) > 1 FROM glob('{TEST_DIR}/async_lifecycle_rotate/*.parquet');
----
true

statement ok
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_per_thread' (FORMAT PARQUET, PER_THREAD_OUTPUT TRUE);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_per_thread/*.parquet');
----
4096

statement ok
SET partitioned_write_max_open_files=2;

statement ok
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_partitioned' (FORMAT PARQUET, PARTITION_BY (p));

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_partitioned/**/*.parquet', hive_partitioning=true);
----
4096

statement ok
SET async_threads=0;

statement ok
COPY lifecycle TO '{TEST_DIR}/async_lifecycle_sync.parquet' (FORMAT PARQUET);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/async_lifecycle_sync.parquet');
----
4096

statement ok
SET GLOBAL debug_fs_delay_mean_ms=0.0;
