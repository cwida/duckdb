# name: test/sql/copy/csv/test_csv_sequential_buffer_eviction.test_slow
# description: Evicted buffers of compressed or re-encoded CSV files must be spilled, not re-read from the file
# group: [csv]

require parquet

statement ok
SET threads=8;

statement ok
SET preserve_insertion_order=false;

statement ok
COPY (SELECT i AS id, uuid()::VARCHAR AS u, repeat('é', 60) AS pad FROM range(0, 300000) r(i)) TO '{TEST_DIR}/seq_evict_0.csv';

statement ok
COPY (SELECT i AS id, uuid()::VARCHAR AS u, repeat('é', 60) AS pad FROM range(300000, 600000) r(i)) TO '{TEST_DIR}/seq_evict_1.csv';

statement ok
COPY (FROM '{TEST_DIR}/seq_evict_0.csv') TO '{TEST_DIR}/seq_evict_0.csv.gz' (COMPRESSION gzip);

statement ok
COPY (FROM '{TEST_DIR}/seq_evict_1.csv') TO '{TEST_DIR}/seq_evict_1.csv.gz' (COMPRESSION gzip);

loop i 0 20

statement ok
SET memory_limit='100MB';

# gzip files cannot be seeked, re-reading an evicted buffer used to throw an internal error
statement ok
COPY (SELECT *, id % 4 AS bucket FROM read_csv('{TEST_DIR}/seq_evict_*.csv.gz', buffer_size=262144)) TO '{TEST_DIR}/seq_evict_gz_out' (FORMAT parquet, PARTITION_BY (bucket), OVERWRITE);

statement ok
RESET memory_limit;

query IIIII
SELECT count(*), sum(id), count(DISTINCT u), min(length(pad)), max(length(pad)) FROM read_parquet('{TEST_DIR}/seq_evict_gz_out/**/*.parquet')
----
600000	179999700000	600000	60	60

statement ok
SET memory_limit='100MB';

# re-encoded byte offsets do not match the file offsets, re-reading an evicted buffer used to return wrong data
statement ok
COPY (SELECT *, id % 4 AS bucket FROM read_csv('{TEST_DIR}/seq_evict_[01].csv', encoding='latin-1', buffer_size=262144)) TO '{TEST_DIR}/seq_evict_latin1_out' (FORMAT parquet, PARTITION_BY (bucket), OVERWRITE);

statement ok
RESET memory_limit;

query IIIII
SELECT count(*), sum(id), count(DISTINCT u), min(length(pad)), max(length(pad)) FROM read_parquet('{TEST_DIR}/seq_evict_latin1_out/**/*.parquet')
----
600000	179999700000	600000	120	120

endloop
