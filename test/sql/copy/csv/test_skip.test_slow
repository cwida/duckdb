require tpch

statement ok
CALL dbgen(sf=0.1);

# Lineitem has about 75 mb
statement ok
COPY lineitem TO '{TEST_DIR}/lineitem.csv' (DELIMITER '|', HEADER);

# Lets check skipping ~ 15 mb
query I
select count(*) from read_csv('{TEST_DIR}/lineitem.csv')
----
600572

query I
select count(*) from read_csv('{TEST_DIR}/lineitem.csv', skip=158310)
----
442263

# Lets check skipping ~ 40 mb
query I
select count(*) from read_csv('{TEST_DIR}/lineitem.csv', skip=474930)
----
125643
