statement ok
COPY (SELECT 1 WHERE false) TO '{TEST_DIR}/empty_glob_1.csv' (HEADER 0)

statement ok
COPY (SELECT 1 WHERE false) TO '{TEST_DIR}/empty_glob_2.csv' (HEADER 0)

statement error
