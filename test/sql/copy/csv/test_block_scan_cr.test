# name: test/sql/copy/csv/test_block_scan_cr.test
# description: Carriage return row ends in the block scanner, results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# block_scan_cr.csv ends its rows with a carriage return and holds a quoted value with a carriage return, an empty
# value, a quoted value followed by the delimiter, too few and too many columns, a single space value, an empty line, a
# carriage return ending a 64 byte block and no carriage return after the last row. block_scan_cr_pipe2.csv holds the
# same rows with the delimiter ||. block_scan_cr_lf.csv adds rows with line feeds: inside a value, after a closing
# quote, right after a delimiter and inside a quoted value, which strict mode rejects as a whole and lenient mode reads
# as row ends. Expected results are those of the build before the change.

# file, strict
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_cr.csv', delim=',', quote='"', escape='"', header=false, new_line='\r', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'})
----
Invalid Input Error: CSV Error on Line: 5

# file, ignore_errors, selecting *
query IIII
SELECT a, replace(replace(b, chr(10), '<LF>'), chr(13), '<CR>') AS b, replace(replace(c, chr(10), '<LF>'), chr(13), '<CR>') AS c, d FROM read_csv('{DATA_DIR}/csv/block_scan_cr.csv', delim=',', quote='"', escape='"', header=false, new_line='\r', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, ignore_errors=true) ORDER BY ALL
----
1	ann	x	7
2	q<CR>q	x	8
4	NULL	x	10
5	c	x	11
9	 	x	13
12	pppppppppppppppppppppppppppppppppppppppppppppppp	x	16
13	b	x	17
14	b	x	18

