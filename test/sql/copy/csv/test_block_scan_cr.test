# file, rejects
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_file AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_cr.csv', delim=',', quote='"', escape='"', header=false, new_line='\r', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_file', rejects_scan='scan_rej_file'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_file ORDER BY ALL
----
5	42	47	3	MISSING COLUMNS	7,b,x
6	48	54	4	CAST	8,b,x,y,extra
6	48	55	5	TOO MANY COLUMNS	8,b,x,y,extra

