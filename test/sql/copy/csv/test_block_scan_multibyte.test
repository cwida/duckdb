# name: test/sql/copy/csv/test_block_scan_multibyte.test
# description: Multi byte delimiters in the block scanner, results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# block_scan_multibyte.csv (delimiter ||) holds a quoted value with the delimiter, part of a delimiter inside a value,
# an empty value, a delimiter after a stray first byte, a quoted value followed by the delimiter and by part of one, too
# few and too many columns, a single space value, a quoted newline, a delimiter cut by a block edge and one ending a
# block, and no newline after the last row. The CRLF file holds the same rows. The 3 and 4 byte files (<|>, ::::) hold
# the delimiter in quotes, partial delimiters, empty values and width errors, the UTF-8 files (€, ¢) the same with
# bytes above 0x7F and a stray part of a delimiter inside a value. Expected results are those of the build before
# the change.

# file, strict
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_multibyte.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'})
----
Invalid Input Error: CSV Error on Line: 8

# file, ignore_errors, selecting *
query IIII
SELECT a, replace(replace(b, chr(10), '<LF>'), chr(13), '<CR>') AS b, replace(replace(c, chr(10), '<LF>'), chr(13), '<CR>') AS c, d FROM read_csv('{DATA_DIR}/csv/block_scan_multibyte.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, ignore_errors=true) ORDER BY ALL
----
1	ann	x	7
2	q||q	x	8
3	a|b	x	9
4	NULL	x	10
5	a	|x	11
6	c	x	12
7	c"|	y	13
10	 	x	14
11	m<LF>l	x	15
12	ppppppppppppppppppppppppppppppppppp	x	16
13	qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq	x	17
14	b	x	18

