CREATE OR REPLACE TEMP TABLE t_rej_file_utf8 AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_multibyte_utf8.csv', delim='€', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_file_utf8', rejects_scan='scan_rej_file_utf8'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_file_utf8 ORDER BY ALL
