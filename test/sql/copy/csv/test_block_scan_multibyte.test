# file, rejects
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_file AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_multibyte.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_file', rejects_scan='scan_rej_file'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_file ORDER BY ALL
----
8	97	104	3	MISSING COLUMNS	8||b||x
9	105	114	4	CAST	9||b||x||y||extra
9	105	116	5	TOO MANY COLUMNS	9||b||x||y||extra

