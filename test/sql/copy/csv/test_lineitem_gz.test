# name: test/sql/copy/csv/test_lineitem_gz.test
# description: Stream repeated gzip CSV inputs under a small memory limit
# group: [csv]

require tpch

statement ok
SET threads=2;

statement ok
CALL dbgen(sf=0.01);

statement ok
COPY lineitem TO '{TEST_DIR}/lineitem.csv.gz' (FORMAT CSV, COMPRESSION GZIP, HEADER);

statement ok
SET memory_limit='32MiB';

# Keep all 50 inputs, including their multiplicity. Small reader buffers keep
# the scan within the memory limit while crossing many gzip/CSV buffer boundaries.
query II
SELECT count(*), sum(l_orderkey) = 50 * (SELECT sum(l_orderkey) FROM lineitem)
FROM read_csv(list_transform(range(50), lambda i: '{TEST_DIR}/lineitem.csv.gz'),
              buffer_size=1048576, max_line_size=65536);
----
3008750	true
