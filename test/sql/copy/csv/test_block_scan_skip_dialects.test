# rows after a full chunk with ||, counting
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/skip_after_chunk_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'}, ignore_errors=true)
----
2059

# rows after a full chunk with ||, strict
statement error
SELECT a FROM read_csv('{TEST_DIR}/skip_after_chunk_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'})
----
Conversion Error: CSV Error on Line: 2049

# rows after a full chunk with ||, rejects of selecting b
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_chunk2 AS SELECT b FROM read_csv('{TEST_DIR}/skip_after_chunk_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'}, store_rejects=true, rejects_table='rej_chunk2', rejects_scan='scan_chunk2'); SELECT line, line_byte_position, byte_position, column_idx, error_type, csv_line FROM rej_chunk2 ORDER BY ALL
----
2049	22357	22364	3	TOO MANY COLUMNS	x||bad||extra

