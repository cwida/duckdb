# name: test/sql/copy/csv/test_block_scan_skip_dialects.test
# description: Unprojected columns skipped by the block scanner in multi-byte delimiter, CR, CRLF and comment dialects, results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# Every block_scan_skip_*.csv holds the same rows: a quoted value with the delimiter, the row end or an escaped quote in
# an unprojected column, a closing quote followed by other bytes, too few and too many columns, empty values, a lone CR
# inside a value, quoted values holding only a delimiter or a row end, spaces, delimiters at both sides of a 64 byte
# block edge, a partial match of the delimiter inside a value and an unterminated quote in the last row; the comment
# files add comment lines and comment bytes inside values. Expected results are those of the build before the change.

statement ok
COPY (SELECT line FROM (SELECT i AS o, i || '||v' || i AS line FROM range(2048) t(i) UNION ALL SELECT 5000, 'x||bad||extra' UNION ALL SELECT 5001, 'notanumber||y' UNION ALL SELECT 5002 + i, (3000 + i) || '||w' FROM range(10) t(i)) ORDER BY o) TO '{TEST_DIR}/skip_after_chunk_pipe2.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT string_agg(i::VARCHAR, '||') FROM range(300) t(i)) TO '{TEST_DIR}/skip_wide_pipe2.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

# file pipe2, strict, selecting a, d
statement error
SELECT a, d FROM read_csv('{DATA_DIR}/csv/block_scan_skip_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'})
----
Invalid Input Error: CSV Error on Line: 5

