# empty line and lone carriage return in an LF file, strict_mode=true
statement error
SELECT a, replace(b, chr(13), '<CR>') FROM read_csv('{TEST_DIR}/irregular.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, strict_mode=true, columns={'a':'VARCHAR','b':'VARCHAR'}) WHERE a NOT LIKE 'p%'
----
The CSV Parser state machine reached an invalid state.

# empty line and lone carriage return in an LF file, strict_mode=false
query II
SELECT a, replace(b, chr(13), '<CR>') FROM read_csv('{TEST_DIR}/irregular.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, strict_mode=false, columns={'a':'VARCHAR','b':'VARCHAR'}) WHERE a NOT LIKE 'p%'
----
1	a
2	b
3	c
4	d

# lone line feed and lone carriage return in a CRLF file, strict_mode=true
statement error
SELECT replace(a, chr(13), '<CR>'), replace(replace(b, chr(13), '<CR>'), chr(10), '<LF>') FROM read_csv('{TEST_DIR}/irregular_crlf.csv', delim=',', quote='"', escape='"', header=false, new_line='\r\n', auto_detect=false, strict_mode=true, columns={'a':'VARCHAR','b':'VARCHAR'}) WHERE a NOT LIKE 'p%'
----
The CSV Parser state machine reached an invalid state.

