CSV Error on Line: 152

# rejects table rows
statement ok
CREATE TEMP TABLE w AS SELECT * FROM read_csv('{TEST_DIR}/widths.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, store_rejects=true, columns={'a':'VARCHAR','b':'VARCHAR','c':'VARCHAR'})

query IIIIII
SELECT line, line_byte_position, byte_position, column_idx, error_type, csv_line FROM reject_errors ORDER BY ALL
----
152	5135	5138	2	MISSING COLUMNS	2,b
153	5139	5144	4	TOO MANY COLUMNS	3,c,y,z

