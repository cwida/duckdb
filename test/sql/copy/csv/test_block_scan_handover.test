# name: test/sql/copy/csv/test_block_scan_handover.test
# description: Block scanner and state machine fallback on unquoted rows: canonical rows stay in the blocks, spaces, lone newlines, empty lines, wrong widths, block and buffer edges hand over
# group: [csv]

statement ok
COPY (SELECT i, repeat('x', i % 151) AS s, i * 2 AS d FROM range(6000) t(i)) TO '{TEST_DIR}/blocks.csv' (FORMAT CSV, HEADER false);

statement ok
COPY (SELECT i, repeat('x', i % 151) AS s, i * 2 AS d FROM range(6000) t(i)) TO '{TEST_DIR}/blocks_crlf.csv' (FORMAT CSV, HEADER false, NEW_LINE '\r\n');

statement ok
COPY (SELECT unnest(['1,a"b,3','2,"quoted",4','3, spaced,5','4,  two,6','5, "q",7','6,  "nq",8','7,,9','8, ,10','9,"",11','10,x""y,12']) AS line) TO '{TEST_DIR}/handover.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',' || repeat('q', i % 61) AS line FROM range(200) t(i) UNION ALL SELECT 500 + unnest(range(5)) AS o, unnest(['1,a', '', '2,b', '3,c' || chr(13), '4,d']) AS line UNION ALL SELECT 1000 + i AS o, 'p' || (1000 + i) || ',' || repeat('q', i % 61) AS line FROM range(200) t(i)) ORDER BY o) TO '{TEST_DIR}/irregular.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',' || repeat('q', i % 61) AS line FROM range(200) t(i) UNION ALL SELECT 500 + unnest(range(5)) AS o, unnest(['1,a', '2,b' || chr(10) || '3,c', '4,d', '5,e' || chr(13) || '6,f', '7,g']) AS line UNION ALL SELECT 1000 + i AS o, 'p' || (1000 + i) || ',' || repeat('q', i % 61) AS line FROM range(200) t(i)) ORDER BY o) TO '{TEST_DIR}/irregular_crlf.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r\n');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',' || repeat('q', i % 61) || ',z' AS line FROM range(300) t(i) UNION ALL SELECT 150 + unnest(range(4)) * 0, unnest(['1,a,x', '2,b', '3,c,y,z', '4,d,w'])) ORDER BY o, line) TO '{TEST_DIR}/widths.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT unnest(['1,' || repeat('y', 300), '2,b']) AS line) TO '{TEST_DIR}/longline.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

# rows of every length in blocks.csv, buffer_size None
query IIIIII
SELECT count(*), sum(i), sum(length(s)), sum(d), min(i), max(i) FROM read_csv('{TEST_DIR}/blocks.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'i':'BIGINT','s':'VARCHAR','d':'BIGINT'})
----
6000	17997000	447780	35994000	0	5999

