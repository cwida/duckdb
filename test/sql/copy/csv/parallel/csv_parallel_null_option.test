# name: test/sql/copy/csv/parallel/csv_parallel_null_option.test
# description: Test parallel read CSV function with null option
# group: [parallel]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# Test read_csv with user defined variable

statement ok
SET threads=4

statement ok
PRAGMA enable_profiling

statement ok
SET profiling_output='{TEST_DIR}/test.txt'

statement ok
SET profiling_mode = 'detailed'

statement ok
CREATE TABLE integers(i INTEGER)

statement ok
INSERT INTO integers VALUES (3)

statement ok
SELECT min (i + i) FROM integers

statement ok
CREATE TABLE exprtest (a INTEGER, b INTEGER)

statement ok
INSERT INTO exprtest VALUES (42, 10), (43, 100), (NULL, 1), (45, -1)

statement ok
SELECT min (a + a ) FROM exprtest

statement ok
SELECT a FROM exprtest WHERE a BETWEEN 43 AND 44

statement ok
SELECT CASE a WHEN 42 THEN 100 WHEN 43 THEN 200 ELSE 300 END FROM exprtest

statement ok
SET profiling_output='{TEST_DIR}/test_2.txt'

# At least one of the lines should contain "Total Time" to verify that we're getting profiling timings
query T
SELECT COUNT(*) > 0
FROM read_csv('{TEST_DIR}/test.txt', columns={'c': 'VARCHAR'}, delim=NULL, header=0, quote=NULL, escape=NULL, auto_detect = false)
WHERE contains(c, 'Total Time');
----
true
