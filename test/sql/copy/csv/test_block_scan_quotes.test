# name: test/sql/copy/csv/test_block_scan_quotes.test
# description: Quoted values in the block scanner: canonical quotes, escaped quotes, quoted newlines, quotes the byte loop must handle
# group: [csv]

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i) UNION ALL SELECT 1000 + unnest(range(12)) AS o, unnest(['1,"a",x', '2,"a""b",x', '3,"",x', '4,"a' || chr(10) || 'b",x', '5,"a' || chr(13) || chr(10) || 'b",x', '6,c"d,x', '7,"a" ,x', '8,"a"b,x', '9, "a",x', '10,  "a",x', '11,"a""",x', '12,"""a",x']) AS line UNION ALL SELECT 2000 + i AS o, 'p' || (2000 + i) || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i)) ORDER BY o) TO '{TEST_DIR}/quotes.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i) UNION ALL SELECT 1000 + unnest(range(12)) AS o, unnest(['1,"a",x', '2,"a""b",x', '3,"",x', '4,"a' || chr(10) || 'b",x', '5,"a' || chr(13) || chr(10) || 'b",x', '6,c"d,x', '7,"a" ,x', '8,"a"b,x', '9, "a",x', '10,  "a",x', '11,"a""",x', '12,"""a",x']) AS line UNION ALL SELECT 2000 + i AS o, 'p' || (2000 + i) || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i)) ORDER BY o) TO '{TEST_DIR}/quotes_crlf.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r\n');

statement ok
COPY (SELECT '"' || repeat('z', 5000) || '",1' UNION ALL SELECT '"' || repeat('y', 300) || chr(10) || repeat('w', 300) || '",2') TO '{TEST_DIR}/long_quoted.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i) UNION ALL SELECT 1000 + unnest(range(1)) AS o, unnest(['13,"open,x']) AS line UNION ALL SELECT 2000 + i AS o, 'p' || (2000 + i) || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i)) ORDER BY o) TO '{TEST_DIR}/unterminated.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, 'p' || i || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i) UNION ALL SELECT 1000 + unnest(range(1)) AS o, unnest(['14,"a\\"b",x']) AS line UNION ALL SELECT 2000 + i AS o, 'p' || (2000 + i) || ',"' || repeat('q', i % 61) || '",' || i AS line FROM range(300) t(i)) ORDER BY o) TO '{TEST_DIR}/backslash.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

