# name: test/sql/copy/csv/test_block_scan_utf8.test
# description: UTF-8 validation with the block scanner: values in ASCII blocks skip the check, invalid bytes anywhere else still fail, are ignored or rejected as before
# group: [csv]

statement ok
COPY (SELECT i || ',' || repeat(chr(233), i % 7) || 'x' || repeat('y', i % 50) || ',' || CASE WHEN i % 3 = 0 THEN '"' || chr(8364) || 'q"' ELSE 'plain' END FROM range(600) t(i)) TO '{TEST_DIR}/utf8_valid.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT i || ',' || repeat(chr(233), i % 7) || 'x' || repeat('y', i % 50) || ',' || CASE WHEN i % 3 = 0 THEN '"' || chr(8364) || 'q"' ELSE 'plain' END FROM range(600) t(i)) TO '{TEST_DIR}/utf8_valid_crlf.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r\n');

statement ok
COPY (SELECT string_agg('v' || i || '_' || j, ',') FROM range(40) t(i), range(2) u(j) GROUP BY j ORDER BY j) TO '{TEST_DIR}/ascii_wide.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

