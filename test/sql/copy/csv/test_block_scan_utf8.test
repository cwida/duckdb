# the escaped value with the invalid byte is rejected, the other rows stay intact
statement ok
CREATE OR REPLACE TEMP TABLE r_escaped AS SELECT * FROM read_csv('data/csv/block_scan_utf8_escaped.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'}, store_rejects=true, rejects_table='rej_escaped', rejects_scan='scan_escaped')

query II
SELECT a, length(b) FROM r_escaped ORDER BY ALL
