# invalid bytes, rejects stored
statement ok
CREATE OR REPLACE TEMP TABLE r AS SELECT * FROM read_csv('data/csv/block_scan_invalid_utf8.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'}, store_rejects=true)

query IIII
SELECT line, column_idx, error_type, replace(csv_line, chr(10), '<LF>') FROM reject_errors ORDER BY ALL
----
2	2	INVALID ENCODING	2,?bad,y
3	2	INVALID ENCODING	3,"q?",z
5	3	INVALID ENCODING	5,fine,?
6	1	CAST	?6,a,b
8	2	INVALID ENCODING	8,aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,c
9	2	INVALID ENCODING	9,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?",d
13	3	INVALID ENCODING	13,x,?

