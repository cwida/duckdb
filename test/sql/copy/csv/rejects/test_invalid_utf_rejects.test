# name: test/sql/copy/csv/rejects/test_invalid_utf_rejects.test
# description: Test that invalid unicodes return correct info as rejects tables
# group: [rejects]

require skip_reload

# Test will fail on windows because byte_position is slightly different due to \r\n instead of \n
require notwindows

statement ok
from read_csv('{DATA_DIR}/csv/test/invalid_utf_big.csv',columns = {'col1': 'VARCHAR','col2': 'VARCHAR','col3': 'VARCHAR'},
 auto_detect=false, header = 0, delim = ',', store_rejects=true)

query IIIIIIIII rowsort
SELECT * EXCLUDE (scan_id) FROM reject_errors ORDER BY ALL;
----
0	3001	54001	54007	2	col2	INVALID ENCODING	valid,invalid_??_part,valid	Invalid unicode (byte sequence mismatch) detected. This file is not utf-8 encoded.
0	3012	54209	54221	3	col3	INVALID ENCODING	valid,valid,invalid_??_part	Invalid unicode (byte sequence mismatch) detected. This file is not utf-8 encoded.
0	3023	54417	54423	2	col2	INVALID ENCODING	valid,invalid_??_part,valid	Invalid unicode (byte sequence mismatch) detected. This file is not utf-8 encoded.
0	3034	54625	54637	3	col3	INVALID ENCODING	valid,valid,invalid_??_part	Invalid unicode (byte sequence mismatch) detected. This file is not utf-8 encoded.

# a cut prefix of a multi byte sequence becomes one '?' in the original line, and the byte that cuts it stays
statement ok
from read_csv('{DATA_DIR}/csv/test/invalid_utf_cut.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR'},
 auto_detect=false, header = 1, delim = ',', store_rejects=true)

query II
SELECT line, csv_line FROM reject_errors WHERE scan_id = (SELECT max(scan_id) FROM reject_errors) ORDER BY line;
----
3	valid,cut_?x_part
4	valid,cut4_?😀_part
5	valid,end_?
6	valid,long_????????????????????????????????????????????????????????????

statement error
from read_csv('{DATA_DIR}/csv/test/invalid_utf_cut.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR'},
 auto_detect=false, header = 1, delim = ',')
----
Original Line: valid,cut_?x_part

# the line size error reports the bytes read, not the length of the repaired line it prints
statement ok
from read_csv('{DATA_DIR}/csv/test/invalid_utf_cut.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR'},
 auto_detect=false, header = 1, delim = ',', store_rejects=true, max_line_size=100)

query III
SELECT line, csv_line, error_message FROM reject_errors
WHERE scan_id = (SELECT max(scan_id) FROM reject_errors) AND error_type = 'LINE SIZE OVER MAXIMUM';
----
6	valid,long_????????????????????????????????????????????????????????????	Maximum line size of 100 bytes exceeded. Actual Size:131 bytes.

statement error
from read_csv('{DATA_DIR}/csv/test/invalid_utf_cut.csv', max_line_size=100)
