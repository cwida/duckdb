# name: test/sql/copy/csv/test_block_scan_skip_values.test
# description: Columns that are not projected are skipped by the block scanner: errors, rejects, null padding and chunk edges stay the same
# group: [csv]

statement ok
COPY (SELECT unnest(['1', '2,x'])) TO '{TEST_DIR}/bad_first.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT line FROM (SELECT i AS o, i || ',v' || i AS line FROM range(2048) t(i) UNION ALL SELECT 5000, 'x,bad,extra' UNION ALL SELECT 5001, 'notanumber,y' UNION ALL SELECT 5002 + i, (3000 + i) || ',w' FROM range(10) t(i)) ORDER BY o) TO '{TEST_DIR}/bad_after_chunk.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT unnest(['1,"q",x', '2,"a""b",y', '3,,z', '4,"open,w', '5,"",v', '6,plain,u', '7', '8,"a",t,extra'])) TO '{TEST_DIR}/mixed.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT string_agg(i::VARCHAR, ',') FROM range(300) t(i)) TO '{TEST_DIR}/wide.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

# the first row is removed with ignore_errors, the second is read
query I
SELECT a FROM read_csv('{TEST_DIR}/bad_first.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'}, ignore_errors=true)
----
2

# the first row is removed with ignore_errors, only b projected
query I
SELECT b FROM read_csv('{TEST_DIR}/bad_first.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR'}, ignore_errors=true)
----
x

