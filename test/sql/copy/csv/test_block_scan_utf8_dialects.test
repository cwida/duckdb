# file pipe2, rejects, selecting *
query III
CREATE OR REPLACE TEMP TABLE t_rej_pipe2_star AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_utf8_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_pipe2_star', rejects_scan='scan_rej_pipe2_star'); SELECT line, column_idx, error_type FROM rej_pipe2_star ORDER BY ALL
