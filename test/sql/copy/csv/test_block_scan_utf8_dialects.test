# name: test/sql/copy/csv/test_block_scan_utf8_dialects.test
# description: The UTF-8 check skipped for values in ASCII blocks, in multi-byte delimiter, UTF-8 delimiter, CR, CRLF and comment dialects: results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# Every block_scan_utf8_*.csv holds the same rows: invalid bytes in an unquoted, a quoted and an integer value, valid UTF-8
# in a value and in a quoted value with a row end, an invalid byte as the last and as the first byte of a 64 byte block,
# an ASCII value crossing a block edge and one whose second block holds valid UTF-8; the comment files add comment lines
# with non-ASCII bytes. Expected results are those of the build before the change.

# file pipe2, strict, selecting *
statement error
SELECT a, replace(replace(b, chr(10), '<LF>'), chr(13), '<CR>') AS b, replace(replace(c, chr(10), '<LF>'), chr(13), '<CR>') AS c, d FROM read_csv('{DATA_DIR}/csv/block_scan_utf8_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}) ORDER BY ALL
----
CSV Error on Line: 2

# file pipe2, ignore_errors, selecting *
query IIII
SELECT a, replace(replace(b, chr(10), '<LF>'), chr(13), '<CR>') AS b, replace(replace(c, chr(10), '<LF>'), chr(13), '<CR>') AS c, d FROM read_csv('{DATA_DIR}/csv/block_scan_utf8_pipe2.csv', delim='||', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, ignore_errors=true) ORDER BY ALL
----
1	abc	x	7
4	é	ok	10
7	two<LF>linesé	w	12
8	plain	more	13
13	bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb	x	18
14	ccccccccccccccccccccccccccccccccccccccéé	x	19
15	last	row	20

