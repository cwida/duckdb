# A later file determines a SQLNULL column's type, including during the actual scan.
statement ok
COPY (SELECT 'NULL' AS value) TO '{TEMP_DIR}/exact_sample_null_first.csv' (HEADER false, QUOTE '')

statement ok
COPY (SELECT 42 AS value) TO '{TEMP_DIR}/exact_sample_integer_second.csv' (HEADER false)

query I
SELECT column_type FROM (
    DESCRIBE SELECT * FROM read_csv([
        '{TEMP_DIR}/exact_sample_null_first.csv',
        '{TEMP_DIR}/exact_sample_integer_second.csv'
    ], header=false, nullstr='NULL', sample_size=2)
)
----
BIGINT

query TI
SELECT typeof(column0), column0 FROM read_csv([
    '{TEMP_DIR}/exact_sample_null_first.csv',
    '{TEMP_DIR}/exact_sample_integer_second.csv'
], header=false, nullstr='NULL', sample_size=2) ORDER BY column0 NULLS FIRST
----
BIGINT	NULL
BIGINT	42

# Headers count as logical sample records in each file.
statement ok
COPY (SELECT 1 AS value) TO '{TEMP_DIR}/exact_sample_header_first.csv' (HEADER true)

statement ok
