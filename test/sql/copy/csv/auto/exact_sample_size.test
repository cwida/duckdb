----
Unsupported parameter for SAMPLE_SIZE

statement error
SELECT * FROM read_csv('{TEMP_DIR}/exact_sample_size_one_row.csv', sample_size=-2)
----
Unsupported parameter for SAMPLE_SIZE

# Error diagnostics preserve the requested budget instead of its rounded chunk size.
statement error
SELECT * FROM read_csv('{TEMP_DIR}/exact_sample_size_3000.csv', header=false, sample_size=3000)
