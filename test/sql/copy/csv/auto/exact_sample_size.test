# A file exhausted by skip contributes no type rows and no shared sample
# budget; the remaining data comes exclusively from the second file.
statement ok
COPY (SELECT 0 AS value) TO '{TEMP_DIR}/exact_sample_skip_empty_first.csv' (HEADER false)

statement ok
COPY (SELECT value FROM (VALUES ('0'), ('0'), ('1.5')) tbl(value))
TO '{TEMP_DIR}/exact_sample_skip_second.csv' (HEADER false)

query II
SELECT column0, typeof(column0) FROM read_csv([
    '{TEMP_DIR}/exact_sample_skip_empty_first.csv',
    '{TEMP_DIR}/exact_sample_skip_second.csv'
], header=false, skip=2, sample_size=1, delim=',')
----
1.5	DOUBLE

# The default 20,480-row budget follows the same skip-exhausted semantics.
statement ok
COPY (SELECT 0 AS value FROM range(20480))
TO '{TEMP_DIR}/exact_sample_default_skip_first.csv' (HEADER false)

statement ok
COPY (
    SELECT CASE WHEN i = 20481 THEN '1.5' ELSE '0' END AS value
    FROM range(20482) tbl(i)
) TO '{TEMP_DIR}/exact_sample_default_skip_second.csv' (HEADER false)

query II
SELECT column0, typeof(column0) FROM read_csv([
    '{TEMP_DIR}/exact_sample_default_skip_first.csv',
    '{TEMP_DIR}/exact_sample_default_skip_second.csv'
], header=false, skip=20481, delim=',')
