# name: test/sql/copy/csv/csv_escape_mode.test
# description: Test the escape_mode option: 'quote' limits the escape character to the quote and escape characters
# group: [csv]

# a file whose second line ends in an escape character
statement ok
COPY (SELECT * FROM (VALUES ('1,\'), ('2,b'), ('3,c')) t(line)) TO '{TEST_DIR}/escape_mode_rows.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# with the default escape_mode 'all', the escape character escapes the line break: the second row is joined to the first
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', strict_mode=false, null_padding=true, header=false, auto_detect=false);
----
2

# with escape_mode 'quote', a newline still ends the record: the escape before it is dropped and no row is lost
# (the remaining empty value matches the default nullstr, as in a '1,' line)
query IT
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', escape_mode='quote', header=false) ORDER BY id;
----
1	NULL
2	b
3	c

# escape_mode 'all' set explicitly behaves as the default
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', escape_mode='all', strict_mode=false, null_padding=true, header=false, auto_detect=false);
----
2

# escapes within a line
statement ok
COPY (SELECT * FROM (VALUES
    ('1,a\,7'),
    ('2,a\x,8'),
    ('3,a\\b,9'),
    ('4,"a\"b",10'),
    ('5,\,11'),
    ('6,c\')
) t(line)) TO '{TEST_DIR}/escape_mode_fields.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# escape_mode 'quote': the delimiter still separates values after an escape; before any other character the escape is
# dropped; the escaped quote and escape characters are kept
query ITI
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_fields.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', escape_mode='quote', null_padding=true, header=false, auto_detect=false) ORDER BY id;
----
1	a	7
2	ax	8
3	a\b	9
4	a"b	10
5	NULL	11
6	c	NULL

# escape_mode 'all': the escaped delimiter is part of the value
query ITI
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_fields.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR', 'n': 'INTEGER'}, delim=',', quote='"', escape='\', strict_mode=false, null_padding=true, header=false, auto_detect=false) WHERE id = 1;
----
1	a,7	NULL

# the sniffer detects the columns and types with escape_mode set: under 'quote' every line has two fields
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', delim=',', quote='"', escape='\', escape_mode='quote', header=false);
----
3

# COPY FROM accepts the option
statement ok
CREATE TABLE escape_mode_rows (id INTEGER, val VARCHAR);

statement ok
COPY escape_mode_rows FROM '{TEST_DIR}/escape_mode_rows.csv' (DELIM ',', QUOTE '"', ESCAPE '\', ESCAPE_MODE 'quote', HEADER false);

query IT
SELECT * FROM escape_mode_rows ORDER BY id;
----
1	NULL
2	b
3	c

# a multi-byte delimiter after an escape still separates values
statement ok
COPY (SELECT 'a\¦b' AS line) TO '{TEST_DIR}/escape_mode_multibyte.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_multibyte.csv', columns={'c1': 'VARCHAR', 'c2': 'VARCHAR'}, delim='¦', quote='"', escape='\', escape_mode='quote', header=false);
----
a	b

# '\r\n' newlines: the escape before the carriage return is dropped and the record ends
statement ok
COPY (SELECT '1,\' || chr(13) || chr(10) || '2,b' AS line) TO '{TEST_DIR}/escape_mode_crlf.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IT
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_crlf.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='\', new_line='\r\n', escape_mode='quote', header=false) ORDER BY id;
----
1	NULL
2	b

# an invalid escape_mode is refused
statement error
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, escape_mode='banana', header=false);
----
'banana' is not accepted as an escape_mode

# escape_mode 'quote' governs the escape character outside quotes, which strict mode does not accept
statement error
SELECT * FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, escape='\', escape_mode='quote', strict_mode=true, header=false);
----
ESCAPE_MODE 'quote' is not supported when STRICT_MODE is manually set to true

# without an escape character distinct from the quote there is nothing for the mode to govern: the option is inert,
# so the prompt sniff_csv builds (which can pick escape '' or the quote character) stays runnable
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='', escape_mode='quote', header=false, auto_detect=false);
----
3

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/escape_mode_rows.csv', columns={'id': 'INTEGER', 'val': 'VARCHAR'}, delim=',', quote='"', escape='"', escape_mode='quote', header=false, auto_detect=false);
----
3

# escape_mode is a read option: the CSV writer does not accept it
statement error
COPY escape_mode_rows TO '{TEST_DIR}/escape_mode_write.csv' (FORMAT csv, ESCAPE_MODE 'quote');
----
<REGEX>:.*escape_mode.*
