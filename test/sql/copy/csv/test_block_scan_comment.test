# file, rejects
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_file AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_comment.csv', delim=',', quote='"', escape='"', comment='#', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_file', rejects_scan='scan_rej_file'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_file ORDER BY ALL
----
6	121	123	2	MISSING COLUMNS	4,#x,y,10
6	121	123	3	MISSING COLUMNS	4,#x,y,10
7	131	134	2	MISSING COLUMNS	5,a#b,x,11
7	131	134	3	MISSING COLUMNS	5,a#b,x,11
8	142	147	2	MISSING COLUMNS	6,"c"#x,y,12
8	142	147	3	MISSING COLUMNS	6,"c"#x,y,12
10	157	162	3	MISSING COLUMNS	7,b,x
11	163	169	4	CAST	8,b,x,y,extra
11	163	170	5	TOO MANY COLUMNS	8,b,x,y,extra
17	280	320	2	MISSING COLUMNS	12,ppppppppppppppppppppppppppppppppppppp#tail
17	280	320	3	MISSING COLUMNS	12,ppppppppppppppppppppppppppppppppppppp#tail

