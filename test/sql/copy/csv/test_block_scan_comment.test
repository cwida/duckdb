# sniffed, count
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_comment.csv', comment='#', header=false, ignore_errors=true)
----
7

# The rejects of the CRLF file depend on the vector size: the line start recorded after a CRLF row end points at the
# LF byte, except for the first row of a chunk, which starts after it (main does the same), so a chunk boundary inside
# the file moves line_byte_position and csv_line of that row.
require vector_size 2048

# file_crlf, rejects
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_file_crlf AS SELECT * FROM read_csv('{DATA_DIR}/csv/block_scan_comment_crlf.csv', delim=',', quote='"', escape='"', comment='#', header=false, new_line='\r\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, store_rejects=true, rejects_table='rej_file_crlf', rejects_scan='scan_rej_file_crlf'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_file_crlf ORDER BY ALL
----
