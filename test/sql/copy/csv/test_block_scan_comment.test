7	136	141	3	MISSING COLUMNS	<LF>5,a#b,x,11
8	148	155	2	MISSING COLUMNS	<LF>6,"c"#x,y,12
8	148	155	3	MISSING COLUMNS	<LF>6,"c"#x,y,12
