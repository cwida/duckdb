# name: test/sql/copy/csv/test_block_scan_comment.test
# description: Comment lines in the block scanner, results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# block_scan_comment.csv holds comment lines at the start, between rows, after spaces and without a final newline, a
# comment after the values of a row, the comment byte right after a delimiter, inside a value, inside a quoted value
# and after a closing quote, an empty comment, too few and too many columns, a comment line crossing a 64 byte block
# edge and a comment byte ending a block. The CRLF and CR files hold the same rows with those row ends, the last file
# the same rows with the delimiter ||. Expected results are those of the build before the change.

# file, strict
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_comment.csv', delim=',', quote='"', escape='"', comment='#', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'})
----
Invalid Input Error: CSV Error on Line: 6

# file, ignore_errors, selecting *
query IIII
SELECT a, replace(replace(b, chr(10), '<LF>'), chr(13), '<CR>') AS b, replace(replace(c, chr(10), '<LF>'), chr(13), '<CR>') AS c, d FROM read_csv('{DATA_DIR}/csv/block_scan_comment.csv', delim=',', quote='"', escape='"', comment='#', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'INTEGER'}, ignore_errors=true) ORDER BY ALL
----
1	ann	x	7
2	q#q	x	8
3	bob	x	9
9	 	x	13
10	b	x	14
11	b	x	15
13	b	x	16

