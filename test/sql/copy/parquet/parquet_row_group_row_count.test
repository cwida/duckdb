# name: test/sql/copy/parquet/parquet_row_group_row_count.test
# description: Parquet files whose row groups declare more rows than their columns hold are rejected when the rows are read
# group: [parquet]

require parquet

statement ok
SET max_execution_time=10000;

statement error
SELECT * FROM read_parquet('data/parquet-testing/broken/huge_rg_num_rows.parquet');
----
values but row group has 9223372036854775807 rows

# scans that only produce row numbers do not read a column chunk
statement error
SELECT * FROM read_parquet('data/parquet-testing/broken/huge_rg_num_rows.parquet') USING SAMPLE 10;
----
values but row group has 9223372036854775807 rows

statement error
SELECT file_row_number FROM read_parquet('data/parquet-testing/broken/huge_rg_num_rows.parquet', file_row_number = true);
----
values but row group has 9223372036854775807 rows

query I
SELECT 42;
----
42

# files with nested and repeated columns are still read
statement ok
COPY (SELECT i, [i, i + 1] l, {'a': i} s, CASE WHEN i % 2 = 0 THEN NULL ELSE i END n FROM range(10) t(i)) TO '{TEMP_DIR}/row_group_row_count.parquet';

query IIII
SELECT count(*), sum(len(l)), sum(s.a), count(n) FROM read_parquet('{TEMP_DIR}/row_group_row_count.parquet');
----
10	20	45	5
