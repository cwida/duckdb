# name: test/sql/copy/parquet/parquet_pruned_file_stats.test
# description: Retained Parquet statistics respect file pruning and generated columns
# group: [parquet]

require parquet

statement ok
COPY (SELECT 42 AS i) TO '{TEST_DIR}/metadata_prune_a.parquet';

statement ok
COPY (SELECT 84 AS i) TO '{TEST_DIR}/metadata_prune_b.parquet';

# Pruning the first file must retain the second file's statistics.
query III
SELECT i, stats(i).min::INTEGER, stats(i).max::INTEGER
FROM read_parquet(['{TEST_DIR}/metadata_prune_a.parquet', '{TEST_DIR}/metadata_prune_b.parquet'],
                  union_by_name = true, filename = true)
WHERE filename = '{TEST_DIR}/metadata_prune_b.parquet';
----
84	84	84

# Without union_by_name, only the first file's metadata is cached.
# It must not rule out matching rows from another file.
query I
SELECT i FROM read_parquet(['{TEST_DIR}/metadata_prune_a.parquet', '{TEST_DIR}/metadata_prune_b.parquet'])
WHERE i = 84;
----
84

# The cache may cover a prefix of the list, including repeated files.
query I
SELECT count(*) FROM read_parquet(['{TEST_DIR}/metadata_prune_a.parquet', '{TEST_DIR}/metadata_prune_b.parquet',
                                  '{TEST_DIR}/metadata_prune_a.parquet'])
WHERE i = 42;
----
2

# Pruning can either retain or discard that cached prefix.
query I
SELECT i FROM read_parquet(['{TEST_DIR}/metadata_prune_a.parquet', '{TEST_DIR}/metadata_prune_b.parquet'], filename = true)
WHERE filename = '{TEST_DIR}/metadata_prune_a.parquet';
----
42

query I
SELECT i FROM read_parquet(['{TEST_DIR}/metadata_prune_a.parquet', '{TEST_DIR}/metadata_prune_b.parquet'], filename = true)
WHERE filename = '{TEST_DIR}/metadata_prune_b.parquet';
----
84

# Appended generated columns preserve physical min/max accessors.
statement ok
COPY (SELECT i AS v, 1 AS k FROM range(4096) t(i))
TO '{TEST_DIR}/metadata_generated' (FORMAT PARQUET, PARTITION_BY(k), ROW_GROUP_SIZE 2048);

statement ok
SET VARIABLE metadata_saved_state_export = current_setting('debug_verify_aggregate_state_export');

statement ok
SET debug_verify_aggregate_state_export = false;

foreach options hive_partitioning=false filename=true,hive_partitioning=false file_row_number=true,hive_partitioning=false hive_partitioning=true filename=true,file_row_number=true,hive_partitioning=true

foreach union_by_name false true

query II
EXPLAIN SELECT min(v), max(v)
FROM read_parquet('{TEST_DIR}/metadata_generated/k=1/data_0.parquet', {options}, union_by_name={union_by_name});
----
physical_plan	<REGEX>:.*Column Data Scan.*

endloop

endloop

statement ok
SET debug_verify_aggregate_state_export = getvariable('metadata_saved_state_export');

statement ok
RESET VARIABLE metadata_saved_state_export;

foreach options hive_partitioning=false filename=true,hive_partitioning=false file_row_number=true,hive_partitioning=false hive_partitioning=true filename=true,file_row_number=true,hive_partitioning=true

foreach union_by_name false true

query II
SELECT min(v), max(v)
FROM read_parquet('{TEST_DIR}/metadata_generated/k=1/data_0.parquet', {options}, union_by_name={union_by_name});
----
0	4095

endloop

endloop

# A Hive column overriding a physical column cannot use the stored min/max.
statement ok
COPY (SELECT 900::BIGINT AS k, 42::BIGINT AS v) TO '{TEST_DIR}/metadata_generated/k=1/shadow.parquet';

query II
SELECT min(k), max(v) FROM read_parquet('{TEST_DIR}/metadata_generated/k=1/shadow.parquet', hive_partitioning=true);
----
1	42

# Missing root columns must still report a schema mismatch.
statement error
SELECT min(v), max(missing)
FROM read_parquet('{TEST_DIR}/metadata_generated/k=1/data_0.parquet',
                  bound_schema={'v':'BIGINT','missing':'BIGINT'}, hive_partitioning=false);
----
missing
