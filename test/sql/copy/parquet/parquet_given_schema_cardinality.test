# name: test/sql/copy/parquet/parquet_given_schema_cardinality.test
# description: A Parquet scan has a cardinality estimate when its schema is given and no file is opened at bind
# group: [parquet]

require parquet

statement ok
COPY (SELECT range::BIGINT AS i FROM range(1000)) TO '{TEST_DIR}/given_schema.parquet';

statement ok
CREATE MACRO given_schema() AS MAP {'i': {name: 'i', type: 'BIGINT', default_value: NULL::VARCHAR}};

# explicit_cardinality is the estimate, whether a file is opened at bind or not
query II
EXPLAIN SELECT * FROM read_parquet('{TEST_DIR}/given_schema.parquet', explicit_cardinality = 123456)
----
physical_plan	<REGEX>:.*~123,456 rows.*

query II
EXPLAIN SELECT * FROM read_parquet('{TEST_DIR}/given_schema.parquet', explicit_cardinality = 123456, schema = given_schema())
----
physical_plan	<REGEX>:.*~123,456 rows.*

query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/given_schema.parquet', '{TEST_DIR}/given_schema.parquet'], explicit_cardinality = 123456, schema = given_schema())
----
physical_plan	<REGEX>:.*~123,456 rows.*

# with files opened at bind too: explicit_cardinality is the estimate for the whole scan, not the first file's rows
# times the number of files
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/given_schema.parquet', '{TEST_DIR}/given_schema.parquet'], explicit_cardinality = 123456)
----
physical_plan	<REGEX>:.*~123,456 rows.*

# without it, the sizes of the files give the estimate when the file list knows them
query II
EXPLAIN SELECT * FROM read_parquet([{filename: '{TEST_DIR}/given_schema.parquet', file_size: 100000}, {filename: '{TEST_DIR}/given_schema.parquet', file_size: 100000}], schema = given_schema())
----
physical_plan	<REGEX>:.*~20,000 rows.*

# a local glob carries the sizes of the files it expands to, so such a scan with the schema given is no longer
# estimated at one row (the exact estimate depends on the size of the file); a plain path is not expanded, carries no
# size, and has no estimate without explicit_cardinality
query II
EXPLAIN SELECT * FROM read_parquet('{TEST_DIR}/given_schema*.parquet', schema = given_schema())
----
physical_plan	<REGEX>:.*~([0-9]{2,3}|[0-9]{1,3}(,[0-9]{3})+) rows.*

# the estimate is the opened file's row count when the schema is not given
query II
EXPLAIN SELECT * FROM read_parquet('{TEST_DIR}/given_schema.parquet')
----
physical_plan	<REGEX>:.*~1,000 rows.*

# the results are unaffected
query I
SELECT count(*) FROM read_parquet(['{TEST_DIR}/given_schema.parquet', '{TEST_DIR}/given_schema.parquet'], explicit_cardinality = 123456, schema = given_schema())
----
2000

query I
SELECT count(*) FROM read_parquet([{filename: '{TEST_DIR}/given_schema.parquet', file_size: 100000}], schema = given_schema())
----
1000
