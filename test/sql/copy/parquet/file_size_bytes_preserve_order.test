# name: test/sql/copy/parquet/file_size_bytes_preserve_order.test
# description: a Parquet COPY rotated by FILE_SIZE_BYTES keeps the insertion order when the setting asks for it
# group: [parquet]

require parquet

statement ok
SET threads = 4

statement ok
SET preserve_insertion_order = true

statement ok
CREATE TABLE src AS SELECT range AS i, 'row' || range AS s FROM range(400000)

# small files, so that more than ten are written
statement ok
COPY (FROM src) TO '{TEST_DIR}/rotated_ordered' (FORMAT parquet, FILE_SIZE_BYTES '100KB', ROW_GROUP_SIZE 20000)

query I
SELECT count(*) > 10 FROM glob('{TEST_DIR}/rotated_ordered/*.parquet')
----
true

# the files, in the order of their number, hold every row in the order of the input
query II
SELECT count(*), count(*) FILTER (WHERE i <> pos) FROM (
	SELECT i, row_number() OVER (ORDER BY regexp_extract(filename, 'data_(\d+)', 1)::INTEGER, file_row_number) - 1 AS pos
	FROM read_parquet('{TEST_DIR}/rotated_ordered/*.parquet', filename := true, file_row_number := true)
)
----
400000	0

# every file but the last reached the size
query I
SELECT count(*) FILTER (WHERE size < 100000) <= 1 FROM read_blob('{TEST_DIR}/rotated_ordered/*.parquet')
----
true

# an explicit PRESERVE_ORDER is accepted with rotation by size
statement ok
COPY (FROM src) TO '{TEST_DIR}/rotated_explicit' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000, PRESERVE_ORDER true)

# the files are returned in their order, with a row of statistics per file
query II
COPY (FROM src WHERE i < 50000) TO '{TEST_DIR}/rotated_files' (FORMAT parquet, FILE_SIZE_BYTES '1KB', ROW_GROUP_SIZE 20000, RETURN_FILES)
----
50000	<REGEX>:\[.*data_0.parquet, .*data_1.parquet, .*data_2.parquet\]

query IIIIIII
COPY (FROM src WHERE i < 50000) TO '{TEST_DIR}/rotated_stats' (FORMAT parquet, FILE_SIZE_BYTES '1KB', ROW_GROUP_SIZE 20000, RETURN_STATS)
----
<REGEX>:.*rotated_stats.*data_0.parquet	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:.*min=0,.*	NULL	<REGEX>:.*
<REGEX>:.*rotated_stats.*data_1.parquet	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:.*	NULL	<REGEX>:.*
<REGEX>:.*rotated_stats.*data_2.parquet	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:.*max=49999,.*	NULL	<REGEX>:.*

# without rows and WRITE_EMPTY_FILE false, the output directory is created but holds no file
query I
COPY (FROM src WHERE i < 0) TO '{TEST_DIR}/rotated_empty' (FORMAT parquet, FILE_SIZE_BYTES '1KB', WRITE_EMPTY_FILE false)
----
0

query I
SELECT count(*) FROM glob('{TEST_DIR}/rotated_empt*/')
----
1

query I
SELECT count(*) FROM glob('{TEST_DIR}/rotated_empty/*')
----
0

# a directory with files refuses the copy without an overwrite mode
statement error
COPY (FROM src) TO '{TEST_DIR}/rotated_ordered' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000)
----
is not empty

statement ok
COPY (FROM src) TO '{TEST_DIR}/rotated_ordered' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000, OVERWRITE_OR_IGNORE)

# a file in the way of the directory is replaced with OVERWRITE only
statement ok
COPY (SELECT 1 AS i) TO '{TEST_DIR}/rotated_file' (FORMAT parquet)

statement error
COPY (FROM src) TO '{TEST_DIR}/rotated_file' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000)
----
it exists and is a file

statement ok
COPY (FROM src) TO '{TEST_DIR}/rotated_file' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000, OVERWRITE)

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/rotated_file/*.parquet')
----
400000

# a VARIANT column, shredded by the values of the first batch, keeps that layout in every file
statement ok
CREATE TABLE src_variant AS SELECT range AS i, CASE WHEN range < 200000 THEN range::VARIANT ELSE ('row' || range)::VARIANT END AS v FROM range(400000)

statement ok
COPY (FROM src_variant) TO '{TEST_DIR}/rotated_variant' (FORMAT parquet, FILE_SIZE_BYTES '400KB', ROW_GROUP_SIZE 20000)

query II
SELECT count(*) > 1, count(DISTINCT cols) FROM (
	SELECT file_name, string_agg(name || ' ' || coalesce(type, ''), ',' ORDER BY name) AS cols
	FROM parquet_schema('{TEST_DIR}/rotated_variant/*.parquet') GROUP BY file_name
)
----
true	1
