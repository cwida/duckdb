# name: test/sql/copy/parquet/bigdecimal.test
# description: Read a file created by Google BigQuery with a BIGDECIMAL column (i.e. DECIMAL(77,38))
# group: [parquet]

require parquet

# the column is read exactly as a wide decimal
query I
SELECT typeof(bigdec) FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet' LIMIT 1
----
DECIMAL(77,38)

query I
FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.50000000000000000000000000000000000000
-0.50000000000000000000000000000000000000
123456789123456789123456789.12345678912345678912345678900000000000
-123456789123456789123456789.12345678912345678912345678900000000000
578960446186580977117854925043439539266.34992332820282019728792003956564819967
-578960446186580977117854925043439539266.34992332820282019728792003956564819968

query I
SELECT bigdec::DOUBLE FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.5
-0.5
1.2345678912345679e+26
-1.2345678912345679e+26
5.7896044618658096e+38
-5.7896044618658096e+38

# functions without a wide implementation compute through DOUBLE, as the old DOUBLE mapping did
query I
SELECT avg(bigdec) FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.0

query I
SELECT median(bigdec) FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.0

# rounding a wide decimal is exact
query I
SELECT round(bigdec, 1) FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'
----
0.5
-0.5
123456789123456789123456789.1
-123456789123456789123456789.1
578960446186580977117854925043439539266.3
-578960446186580977117854925043439539266.3

statement ok
SUMMARIZE SELECT * FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet'

query II
SELECT min, max FROM (SUMMARIZE SELECT * FROM '{DATA_DIR}/parquet-testing/bigdecimal.parquet')
----
-578960446186580977117854925043439539266.34992332820282019728792003956564819968	578960446186580977117854925043439539266.34992332820282019728792003956564819967
