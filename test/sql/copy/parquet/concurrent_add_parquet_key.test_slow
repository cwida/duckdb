# name: test/sql/copy/parquet/concurrent_add_parquet_key.test_slow
# description: Concurrently adding parquet keys from multiple connections
# group: [parquet]

require parquet

concurrentloop i 0 16

loop j 0 200

statement ok
PRAGMA add_parquet_key('k{i}_{j}', '0123456789112345');

statement ok
PRAGMA add_parquet_key('shared', '0123456789112345');

endloop

endloop
