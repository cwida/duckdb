# name: test/sql/copy/parquet/cte_batch_exchange.test
# description: Test batch-indexed direct CTE input for Parquet writes
# group: [parquet]

require parquet

statement ok
PRAGMA threads=4;

statement ok
CREATE TABLE cte_parquet_source AS SELECT i FROM range(1000000) t(i);

query II
EXPLAIN ANALYZE
COPY (
	WITH c AS MATERIALIZED (SELECT i FROM cte_parquet_source)
	SELECT i FROM c
) TO '{TEST_DIR}/cte_batch_exchange.parquet' (FORMAT parquet);
----
analyzed_plan	<REGEX>:.*Fanout Mode: DIRECT.*Order Mode: BATCH_INDEX.*Preferred Batch Size: 122880.*

query III
SELECT count(*), min(i), max(i)
FROM read_parquet('{TEST_DIR}/cte_batch_exchange.parquet');
----
1000000	0	999999

query I
SELECT row_group_num_rows
FROM parquet_metadata('{TEST_DIR}/cte_batch_exchange.parquet')
ORDER BY row_group_id;
----
122880
122880
122880
122880
122880
122880
122880
122880
16960

# Propagate batch advances through a buffered CTE into a direct CTE consumer.
query II
EXPLAIN ANALYZE
COPY (
	WITH first AS MATERIALIZED (
		SELECT i FROM cte_parquet_source WHERE i < 500000
		UNION ALL
		SELECT i FROM cte_parquet_source WHERE i >= 500000
	), second AS MATERIALIZED (
		SELECT i FROM first
	)
	SELECT i FROM second
) TO '{TEST_DIR}/cte_nested_batch_exchange.parquet' (FORMAT parquet);
----
analyzed_plan	<REGEX>:.*Fanout Mode: BUFFERED.*Fanout Mode: DIRECT.*Scan Mode: BATCH.*

query III
SELECT count(*), min(i), max(i)
FROM read_parquet('{TEST_DIR}/cte_nested_batch_exchange.parquet');
----
1000000	0	999999

query I
SELECT count(*)
FROM (
	SELECT i, row_number() OVER () - 1 AS expected
	FROM read_parquet('{TEST_DIR}/cte_nested_batch_exchange.parquet')
)
WHERE i != expected;
----
0

# A scalar consumer on the same CTE forces COPY to use the materialized scan with batch indices.
foreach threads 32 192

statement ok
SET threads={threads};

query II
EXPLAIN ANALYZE
COPY (
	WITH c AS MATERIALIZED (SELECT i FROM cte_parquet_source)
	SELECT i FROM c WHERE i < (SELECT count(*) FROM c)
) TO '{TEST_DIR}/cte_materialized_batch_scan.parquet' (FORMAT parquet, ROW_GROUP_SIZE 32768);
----
analyzed_plan	<REGEX>:.*Materialized Consumers: 1.*

query III
SELECT count(*), min(i), max(i)
FROM read_parquet('{TEST_DIR}/cte_materialized_batch_scan.parquet');
----
1000000	0	999999

query I
SELECT count(*)
FROM (
	SELECT i, row_number() OVER () - 1 AS expected
	FROM read_parquet('{TEST_DIR}/cte_materialized_batch_scan.parquet')
)
WHERE i != expected;
----
0

query II
SELECT count(*), count(*) FILTER (WHERE row_group_num_rows NOT IN (32768, 16960))
FROM parquet_metadata('{TEST_DIR}/cte_materialized_batch_scan.parquet');
----
31	0

endloop
