# name: test/sql/copy/parquet/union_by_name_null_nested.test
# description: NULL-typed fields remain NULL when unioned with nested Parquet types
# group: [parquet]

require parquet

statement ok
CREATE TYPE null_target_struct AS STRUCT(n INTEGER, s VARCHAR);

statement ok
CREATE TYPE null_target_nested_struct AS STRUCT(v null_target_struct);

statement ok
CREATE TABLE null_nested_values AS SELECT
    {'n': 42, 's': 'hello'} AS null_target_struct,
    {'v': {'n': 42, 's': 'hello'}} AS null_target_nested_struct,
    [42, NULL, 7] AS "INTEGER[]",
    MAP {1: 'hello', 2: NULL} AS "MAP(INTEGER,VARCHAR)";

statement ok
COPY (SELECT 1 AS id, NULL::"NULL" AS r,
             {'v': NULL::"NULL"} AS s,
             MAP {'key': NULL::"NULL"} AS m,
             [NULL::"NULL", NULL::"NULL"] AS l)
TO '{TEST_DIR}/null_nested_old.parquet' (FORMAT PARQUET);

foreach type null_target_struct null_target_nested_struct INTEGER[] MAP(INTEGER,VARCHAR)

statement ok
COPY (SELECT 2 AS id, v AS r, {'v': v} AS s, MAP {'key': v} AS m, [v, NULL] AS l
      FROM (SELECT "{type}" AS v FROM null_nested_values))
TO '{TEST_DIR}/null_nested_new.parquet' (FORMAT PARQUET);

foreach first,second old,new new,old

# Test name mapping in either file order, including NULL elements in non-NULL containers.
query IIIIIIII
SELECT id, r IS NULL, s.v IS NULL, map_extract_value(m, 'key') IS NULL,
       l[1] IS NULL, l[2] IS NULL, cardinality(m), len(l)
FROM read_parquet(['{TEST_DIR}/null_nested_{first}.parquet',
                   '{TEST_DIR}/null_nested_{second}.parquet'], union_by_name = true)
ORDER BY id;
----
1	true	true	true	true	true	1	2
2	false	false	false	false	true	1	2

query IIII
SELECT r IS NOT DISTINCT FROM v, s.v IS NOT DISTINCT FROM v,
       map_extract_value(m, 'key') IS NOT DISTINCT FROM v, l[1] IS NOT DISTINCT FROM v
FROM read_parquet(['{TEST_DIR}/null_nested_{first}.parquet',
                   '{TEST_DIR}/null_nested_{second}.parquet'], union_by_name = true),
     (SELECT "{type}" AS v FROM null_nested_values) expected
WHERE id = 2;
----
true	true	true	true

endloop

endloop
