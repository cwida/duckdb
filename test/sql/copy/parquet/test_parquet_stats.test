# name: test/sql/copy/parquet/test_parquet_stats.test
# description: Test statistic propagation for parquet reader
# group: [parquet]

require parquet

statement ok
PRAGMA explain_output = PHYSICAL_ONLY

# empty reference result
query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where false;
----

# verify null stats work
query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where id is null;
----

# verify min/max stats on int cols work
query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where id < 1;
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where id > 1000;
----


# verify min/max stats on double cols work
query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where salary < 12380;
----

# max is nan because of parquet's unique setup - so we can't prune here
# query I nosort empty
# explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where salary > 286593 and salary < 286594;
# ----

# verify min/max stats on timestamp cols work
query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/timestamp.parquet') where time < '2020-10-04';
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/timestamp.parquet') where time > '2020-10-06';
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/timestamp-ms.parquet') where time < '2020-10-04';
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/timestamp-ms.parquet') where time > '2020-10-06';
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/data-types.parquet') where timestampval < '2019-11-25';
----

query I nosort empty
explain select * from parquet_scan('{DATA_DIR}/parquet-testing/data-types.parquet') where timestampval > '2019-11-27';
----

# TODO string comparisons are not pruned yet
# verify min/max stats on string cols work
#query I nosort empty
#explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where country < 'Aruba';
#----

#query I nosort empty
#explain select * from parquet_scan('{DATA_DIR}/parquet-testing/userdata1.parquet') where country > 'Zimbabwe';
#----


# see if stats work correctly for globs

query I nosort nostats
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet') where time > '2020-10-06'
----

statement ok
SET parquet_metadata_cache=true;

# Ordinary multi-file scans do not gather global statistics, even with cached metadata.
# Reading every footer solely for statistics would add work to binding.
query I nosort nostats
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet') where time > '2020-10-06'
----

query I
select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet') where time > '2020-10-06'
----
0

# Warming the cache does not change that policy.
query I nosort nostats
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet') where time > '2020-10-06'
----

# union_by_name reads every file's schema, so its statistics can describe the whole scan.
query I nosort empty
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet', union_by_name=true) where time > '2020-10-06'
----

statement ok
SET parquet_metadata_cache=false;

query I nosort nostats
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet') where time > '2020-10-06'
----

query I nosort empty
explain select time from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet', union_by_name=true) where time > '2020-10-06'
----

query I
select count(*) from parquet_scan('{DATA_DIR}/parquet-testing/timestamp*.parquet', union_by_name=true) where time > '2020-10-06'
----
0

# The first file's bounds must never prune rows from a later file.
statement ok
COPY (SELECT i FROM range(10) t(i)) TO '{TEST_DIR}/stats_first.parquet' (FORMAT PARQUET);

statement ok
COPY (SELECT i FROM range(100, 110) t(i)) TO '{TEST_DIR}/stats_second.parquet' (FORMAT PARQUET);

foreach cache false true

statement ok
SET parquet_metadata_cache={cache};

query I
SELECT count(*) FROM parquet_scan('{TEST_DIR}/stats_*.parquet') WHERE i >= 100;
----
10

query I
SELECT count(*) FROM parquet_scan('{TEST_DIR}/stats_*.parquet');
----
20

query I
SELECT count(*) FROM parquet_scan('{TEST_DIR}/stats_*.parquet') WHERE i >= 100;
----
10

query I
SELECT count(*) FROM parquet_scan('{TEST_DIR}/stats_*.parquet', union_by_name=true) WHERE i >= 100;
----
10

query I nosort empty
EXPLAIN SELECT i FROM parquet_scan('{TEST_DIR}/stats_*.parquet', union_by_name=true) WHERE i > 109;
----

query I
SELECT count(*) FROM parquet_scan('{TEST_DIR}/stats_*.parquet', union_by_name=true) WHERE i > 109;
----
0

endloop
