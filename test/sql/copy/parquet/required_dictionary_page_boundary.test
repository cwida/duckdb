# name: test/sql/copy/parquet/required_dictionary_page_boundary.test
# description: Dictionary page skipping cannot expose placeholder NULLs to a NULL-accepting filter
# group: [parquet]

require parquet

statement ok
SET threads=1;

statement ok
SET parquet_use_page_index=false;

statement ok
SET disabled_optimizers='statistics_propagation';

