# name: test/sql/copy/parquet/parquet_encryption.test
# description: Test Parquet encryption
# group: [parquet]

require parquet

# parquet keys are not persisted across restarts
require noforcestorage

# writing encrypted parquet requires httpfs to be loaded
require httpfs

# AES key must have one of the three specified lengths or be valid Base64
statement error
PRAGMA add_parquet_key('my_cool_key', '42')
----
Invalid Input Error: Invalid AES key. Not a plain AES key NOR a base64 encoded string

# Valid Base64 AES key must have one of the three specified lengths
statement error
PRAGMA add_parquet_key('my_invalid_duck_key', 'ZHVjaw==')
----
Invalid Input Error: Invalid AES key. Must have a length of 128, 192, or 256 bits (16, 24, or 32 bytes)

# key name and key cannot be NULL
statement error
PRAGMA add_parquet_key(NULL, 'somekey')
----
Invalid Input Error: add_parquet_key: key name and key cannot be NULL

# we dont support this yet
statement error
COPY (SELECT 42 i) to '{TEST_DIR}/encrypted.parquet' (ENCRYPTION_CONFIG {column_keys: {key_name: ['col0', 'col1']}})
----
Not implemented Error: Parquet encryption_config column_keys not yet implemented

statement error
COPY (SELECT 42 i) to '{TEST_DIR}/encrypted.parquet' (ENCRYPTION_CONFIG {footer_key: 'nonexistant'})
----
Binder Error: No key with name "nonexistant" exists. Add it with PRAGMA add_parquet_key('<key_name>','<key>');

# add keys of 3 different lengths
statement ok
PRAGMA add_parquet_key('key128', '0123456789112345')

statement ok
PRAGMA add_parquet_key('key192', '012345678911234501234567')

statement ok
PRAGMA add_parquet_key('key256', '01234567891123450123456789112345')

# encryption options must survive serialization for both COPY and scans
statement ok
SET debug_verify_serializer=true

# test all valid AES key lengths
foreach key_len 128 192 256

statement ok
COPY (SELECT 42 i) to '{TEST_DIR}/encrypted{key_len}.parquet' (ENCRYPTION_CONFIG {footer_key: 'key{key_len}'})

query I
SELECT * FROM read_parquet('{TEST_DIR}/encrypted{key_len}.parquet', encryption_config={footer_key: 'key{key_len}'})
----
42

statement ok
CREATE OR REPLACE TABLE test (i INTEGER)

statement ok
COPY test FROM '{TEST_DIR}/encrypted{key_len}.parquet' (ENCRYPTION_CONFIG {footer_key: 'key{key_len}'})

query I
SELECT * FROM test
----
42

endloop

statement ok
SET debug_verify_serializer=false

# what happens if we don't try to decrypt even if the file is encrypted?
statement error
SELECT * FROM read_parquet('{TEST_DIR}/encrypted128.parquet')
----
Invalid Input Error

# what if we try to decrypt with the wrong key?
statement error
SELECT * FROM read_parquet('{TEST_DIR}/encrypted128.parquet', encryption_config={footer_key: 'key192'})
----
Invalid Input Error: Computed AES tag differs from read AES tag, are you using the right key?

# what if we don't encrypt, but try to decrypt?
statement ok
COPY (SELECT 42 i) to '{TEST_DIR}/unencrypted.parquet'

statement error
SELECT * FROM read_parquet('{TEST_DIR}/unencrypted.parquet', encryption_config={footer_key: 'key256'})
----
Invalid Input Error

# Use Base64 encoded key
statement ok
PRAGMA add_parquet_key('key256base64', 'MDEyMzQ1Njc4OTExMjM0NTAxMjM0NTY3ODkxMTIzNDU=')

query I
SELECT * FROM read_parquet('{TEST_DIR}/encrypted256.parquet', encryption_config={footer_key: 'key256base64'})
----
42

# encrypted parquet metadata cache hits must initialize encryption state and not skip encryption checks
statement ok
SET parquet_metadata_cache=true

statement ok
COPY (SELECT 84 i) TO '{TEST_DIR}/encrypted_metadata_cache.parquet' (ENCRYPTION_CONFIG {footer_key: 'key256'})

query I
SELECT * FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet', encryption_config={footer_key: 'key256'})
----
84

query I
SELECT * FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet', encryption_config={footer_key: 'key256'})
----
84

query III
SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet',
	encryption_config={footer_key: 'key256'})
----
1	84	84

# with the correct key, the cached metadata can still be used for metadata statistics
query II
EXPLAIN SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet',
	encryption_config={footer_key: 'key256'})
----
physical_plan	<REGEX>:.*Column Data Scan.*

# without a key, cached metadata statistics must not be used to answer the aggregate
statement error
SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet')
----
<REGEX>:.*Invalid Input Error: File '.*encrypted_metadata_cache.parquet' is encrypted, but 'encryption_config' was not set.*

# with the wrong key, cached metadata statistics must not be used to answer the aggregate
statement error
SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet',
	encryption_config={footer_key: 'key192'})
----
Invalid Input Error: Computed AES tag differs from read AES tag, are you using the right key?

# a wrong key must fail before cached row group statistics can prune the scan
statement error
SELECT * FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet', encryption_config={footer_key: 'key192'})
WHERE i > 100
----
Invalid Input Error: Computed AES tag differs from read AES tag, are you using the right key?

statement ok
COPY (SELECT 168 i) TO '{TEST_DIR}/plain_metadata_cache.parquet'

query III
SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/plain_metadata_cache.parquet')
----
1	168	168

# plain parquet metadata cache hits must still support row group scans
query I
SELECT * FROM read_parquet('{TEST_DIR}/plain_metadata_cache.parquet')
----
168

statement error
SELECT count(*), min(i), max(i) FROM read_parquet('{TEST_DIR}/plain_metadata_cache.parquet',
	encryption_config={footer_key: 'key256'})
----
<REGEX>:.*Invalid Input Error: File '.*plain_metadata_cache.parquet' is not encrypted, but 'encryption_config' was set.*

statement error
SELECT * FROM read_parquet('{TEST_DIR}/encrypted_metadata_cache.parquet', encryption_config={footer_key: 'key192'})
----
Invalid Input Error: Computed AES tag differs from read AES tag, are you using the right key?
