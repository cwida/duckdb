# name: test/sql/copy/parquet/parquet_metadata_cache_column_statistics.test
# description: Column statistics cached with the Parquet metadata follow the file and the type it is read as
# group: [parquet]

require parquet

# writer requires vector_size >= 64
require vector_size 64

foreach metadata_cache true false

statement ok
SET parquet_metadata_cache={metadata_cache};

statement ok
COPY (SELECT i FROM range(10) t(i)) TO '{TEMP_DIR}/stats_cache_{metadata_cache}.parquet'

# the statistics (max 9) rule the filter out
query I
SELECT count(*) FROM '{TEMP_DIR}/stats_cache_{metadata_cache}.parquet' WHERE i > 50
----
0

# rewrite the file with a wider range: the cached statistics must not be reused
statement ok
COPY (SELECT i FROM range(100) t(i)) TO '{TEMP_DIR}/stats_cache_{metadata_cache}.parquet'

query I
SELECT count(*) FROM '{TEMP_DIR}/stats_cache_{metadata_cache}.parquet' WHERE i > 50
----
49

# each column, and each field of a struct, has its own statistics
statement ok
COPY (SELECT i AS a, i + 100 AS b, {'x': i + 200, 'y': i + 300} AS s FROM range(10) t(i))
TO '{TEMP_DIR}/stats_cache_columns_{metadata_cache}.parquet'

query IIII
SELECT max(a), max(b), max(s.x), max(s.y) FROM '{TEMP_DIR}/stats_cache_columns_{metadata_cache}.parquet'
----
9	109	209	309

query I
SELECT count(*) FROM '{TEMP_DIR}/stats_cache_columns_{metadata_cache}.parquet' WHERE b > 105
----
4

query I
SELECT count(*) FROM '{TEMP_DIR}/stats_cache_columns_{metadata_cache}.parquet' WHERE s.x > 205
----
4

# each file of a glob has its own statistics
statement ok
COPY (SELECT i + 1000 AS i FROM range(10) t(i)) TO '{TEMP_DIR}/stats_cache_glob_{metadata_cache}_a.parquet'

statement ok
COPY (SELECT i + 2000 AS i FROM range(10) t(i)) TO '{TEMP_DIR}/stats_cache_glob_{metadata_cache}_b.parquet'

query II
SELECT count(*), max(i) FROM '{TEMP_DIR}/stats_cache_glob_{metadata_cache}_*.parquet' WHERE i > 1005
----
14	2009

# the same column read as BLOB and as VARCHAR has statistics of a different type
statement ok
COPY (SELECT ('v' || i)::BLOB AS b FROM range(10) t(i)) TO '{TEMP_DIR}/stats_cache_blob_{metadata_cache}.parquet'

query II
SELECT typeof(b), count(*) FROM '{TEMP_DIR}/stats_cache_blob_{metadata_cache}.parquet' WHERE b > 'v8'::BLOB GROUP BY ALL
----
BLOB	1

query II
SELECT typeof(b), count(*) FROM read_parquet('{TEMP_DIR}/stats_cache_blob_{metadata_cache}.parquet', binary_as_string = true)
WHERE b > 'v8' GROUP BY ALL
----
VARCHAR	1

# the virtual file row number column has statistics too
query I
SELECT count(*) FROM read_parquet('{TEMP_DIR}/stats_cache_{metadata_cache}.parquet', file_row_number = true)
WHERE file_row_number >= 90
----
10

endloop
