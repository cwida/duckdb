# name: test/sql/copy/parquet/read_ahead/readahead_file_descriptor_limit_threads.test_slow
# description: The file descriptor bound holds with many threads and with concurrent scans
# group: [read_ahead]

require parquet

require skip_reload

statement ok
SET async_threads=72

foreach suffix a b c d

statement ok
COPY (SELECT i % 400 AS p, i AS v FROM range(400000) t(i)) TO '{TEST_DIR}/readahead_fd_threads_{suffix}' (FORMAT parquet, PARTITION_BY (p))

endloop

statement ok
SET debug_file_descriptor_limit=256

statement ok
CREATE MACRO peak_open_handles() AS TABLE
WITH events AS (
	SELECT timestamp, CASE op WHEN 'OPEN' THEN 1 ELSE -1 END AS delta
	FROM duckdb_logs_parsed('FileSystem')
	WHERE op IN ('OPEN', 'CLOSE') AND path LIKE '%readahead_fd_threads%'
)
SELECT max(open_handles) AS peak
FROM (SELECT sum(delta) OVER (ORDER BY timestamp, delta DESC ROWS UNBOUNDED PRECEDING) AS open_handles FROM events)

# with many threads the files held by claimed and queued jobs count too
statement ok
SET threads=32

statement ok
CALL enable_logging('FileSystem')

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/readahead_fd_threads_a/**/*.parquet')
----
400000

statement ok
CALL disable_logging()

query I
SELECT peak < 128 FROM peak_open_handles()
----
true

statement ok
CALL truncate_duckdb_logs()

# concurrent scans share one descriptor budget
statement ok
SET threads=2

statement ok
CALL enable_logging('FileSystem')

query I
SELECT count(*) FROM (
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_a/**/*.parquet')
	UNION ALL
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_b/**/*.parquet')
)
----
800000

statement ok
CALL disable_logging()

query I
SELECT peak < 128 FROM peak_open_handles()
----
true

statement ok
CALL truncate_duckdb_logs()

# with many threads concurrent scans stay within the shared budget too
statement ok
SET threads=32

statement ok
CALL enable_logging('FileSystem')

query I
SELECT count(*) FROM (
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_a/**/*.parquet')
	UNION ALL
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_b/**/*.parquet')
	UNION ALL
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_c/**/*.parquet')
	UNION ALL
	SELECT v FROM read_parquet('{TEST_DIR}/readahead_fd_threads_d/**/*.parquet')
)
----
1600000

statement ok
CALL disable_logging()

query I
SELECT peak < 128 FROM peak_open_handles()
----
true
