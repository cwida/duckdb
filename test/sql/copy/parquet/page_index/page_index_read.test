# many row groups scanned by several threads, the page index active in each of them
statement ok
SET threads = 8;

statement ok
COPY data TO '{TEST_DIR}/page_index_read_threads.parquet' (ROW_GROUP_SIZE 5000, DATA_PAGE_SIZE_LIMIT 4096, WRITE_PAGE_INDEX true);

query I
SELECT count(*) FROM (
	(SELECT * FROM '{TEST_DIR}/page_index_read_threads.parquet' WHERE striped >= 1000000 AND v < 500 EXCEPT ALL SELECT * FROM data WHERE striped >= 1000000 AND v < 500)
	UNION ALL
	(SELECT * FROM data WHERE striped >= 1000000 AND v < 500 EXCEPT ALL SELECT * FROM '{TEST_DIR}/page_index_read_threads.parquet' WHERE striped >= 1000000 AND v < 500)
)
----
0

query II
SELECT count(*) = (SELECT count(*) FROM data WHERE id % 5000 < 100), sum(id) = (SELECT sum(id) FROM data WHERE id % 5000 < 100)
FROM '{TEST_DIR}/page_index_read_threads.parquet' WHERE id % 5000 < 100
----
true	true

query I
SELECT bool_and(file_row_number = id) FROM read_parquet('{TEST_DIR}/page_index_read_threads.parquet', file_row_number = true) WHERE striped >= 1000000 AND n IS NULL
----
true

statement ok
SET threads = 1;

# a file without a page index (the default) is unaffected
statement ok
COPY data TO '{TEST_DIR}/page_index_read_none.parquet' (ROW_GROUP_SIZE 100000, DATA_PAGE_SIZE_LIMIT 4096);

