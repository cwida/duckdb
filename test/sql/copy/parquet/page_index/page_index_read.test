# a floating point column with NaN values has no ColumnIndex: no page skipping, correct results
statement ok
COPY (SELECT range AS id, CASE WHEN range = 1500 THEN 'nan'::DOUBLE ELSE range::DOUBLE END AS d FROM range(3000)) TO '{TEST_DIR}/page_index_read_nan.parquet' (ROW_GROUP_SIZE 3000, DATA_PAGE_SIZE_LIMIT 4096, WRITE_PAGE_INDEX true);

query II
SELECT count(*), max(id) FROM '{TEST_DIR}/page_index_read_nan.parquet' WHERE d > 2998.0
