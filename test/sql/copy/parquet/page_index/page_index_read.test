	UNION ALL
	(SELECT * FROM data WHERE s BETWEEN 'str_012345' AND 'str_012400' EXCEPT ALL SELECT * FROM '{TEST_DIR}/page_index_read.parquet' WHERE s BETWEEN 'str_012345' AND 'str_012400')
)
----
0

