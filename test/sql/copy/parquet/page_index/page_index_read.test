# the file row number stays correct across skipped pages
query I
SELECT bool_and(file_row_number = id) FROM read_parquet('{TEST_DIR}/page_index_read.parquet', file_row_number = true) WHERE id IN (5, 5000, 50000, 99999) OR id BETWEEN 70000 AND 70100
----
true

query I
SELECT list(file_row_number ORDER BY file_row_number) FROM read_parquet('{TEST_DIR}/page_index_read.parquet', file_row_number = true) WHERE id IN (5, 5000, 50000, 99999)
----
[5, 5000, 50000, 99999]

statement ok
CALL disable_logging();

query I
SELECT count(*) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
2

