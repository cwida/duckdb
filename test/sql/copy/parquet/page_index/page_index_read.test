# without prefetching, and with whole-row-group prefetching
statement ok
SET disable_parquet_prefetching = true;

query IIIII
SELECT id, v, s, arr, st FROM '{TEST_DIR}/page_index_read.parquet' WHERE id = 77777
----
77777	776	str_077777	[77777, 77778]	{'a': 77777, 'b': t77777}

