# name: test/sql/copy/parquet/page_index/page_index_read.test
# description: Skipping pages with the Parquet page index (ColumnIndex + OffsetIndex)
# group: [page_index]

require parquet

# the page row counts and boundaries below assume the default vector size
require vector_size 2048

statement ok
CREATE TABLE data AS
	SELECT range AS id,
	       ((range // 512) * 7919) % 1000 + range % 10 AS v,
	       CASE WHEN (range // 512) % 2 = 0 THEN range ELSE 1000000 + range END AS striped,
	       'str_' || lpad(range::VARCHAR, 6, '0') AS s,
	       CASE WHEN range % 7 = 0 THEN NULL ELSE range END AS n,
	       (range / 4)::DOUBLE AS d,
	       [range::INTEGER, (range + 1)::INTEGER] AS arr,
	       {'a': range::INTEGER, 'b': 't' || range::VARCHAR} AS st
	FROM range(100000);

# one row group, BIGINT pages of 512 rows: 196 pages for 100000 rows
statement ok
COPY data TO '{TEST_DIR}/page_index_read.parquet' (ROW_GROUP_SIZE 100000, DATA_PAGE_SIZE_LIMIT 4096, WRITE_PAGE_INDEX true);

# the log entries of a query are flushed by disable_logging, so every check disables and re-enables logging
statement ok
CALL enable_logging('PhysicalOperator');

# a point lookup on the sorted column reads one page of 512 rows
query IIIII
SELECT id, v, s, arr, st FROM '{TEST_DIR}/page_index_read.parquet' WHERE id = 77777
----
77777	776	str_077777	[77777, 77778]	{'a': 77777, 'b': t77777}

statement ok
CALL disable_logging();

query III
SELECT event, count(*), sum(info['rows_skipped']::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' GROUP BY event ORDER BY event
----
ReadRowGroup	1	NULL
SkipPages	1	99488

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# a range that spans two pages
query III
SELECT count(*), min(id), max(id) FROM '{TEST_DIR}/page_index_read.parquet' WHERE id BETWEEN 10000 AND 10600
----
601	10000	10600

statement ok
CALL disable_logging();

query I
SELECT sum(info['rows_skipped']::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
98976

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# an IN list reads three pages (the last page holds 160 rows)
query II
SELECT count(*), list(id ORDER BY id) FROM '{TEST_DIR}/page_index_read.parquet' WHERE id IN (1, 50000, 99999)
----
3	[1, 50000, 99999]

statement ok
CALL disable_logging();

query I
SELECT sum(info['rows_skipped']::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
98816

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# only the filter column is projected
query I
SELECT count(*) FROM '{TEST_DIR}/page_index_read.parquet' WHERE id BETWEEN 1000 AND 1999
----
1000

statement ok
CALL disable_logging();

query I
SELECT sum(info['rows_skipped']::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
98464

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# a value inside the bounds of the column chunk that no page holds: the whole row group is skipped by its pages
query I
SELECT count(*) FROM '{TEST_DIR}/page_index_read.parquet' WHERE striped BETWEEN 200000 AND 900000
----
0

statement ok
CALL disable_logging();

query III
SELECT event, count(*), sum(info['rows_skipped']::BIGINT) FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' GROUP BY event ORDER BY event
----
SkipPages	1	100000
SkipRowGroup	1	NULL

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# every other page qualifies for the striped column
query II
SELECT count(*) = (SELECT count(*) FROM data WHERE striped >= 1000000), sum(id) = (SELECT sum(id) FROM data WHERE striped >= 1000000)
FROM '{TEST_DIR}/page_index_read.parquet' WHERE striped >= 1000000
----
true	true

statement ok
CALL disable_logging();

query I
SELECT sum(info['rows_skipped']::BIGINT) = 100000 - (SELECT count(*) FROM data WHERE (id // 512) % 2 = 1)
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# two filters prune to the intersection of their pages
query I
SELECT count(*) = (SELECT count(*) FROM data WHERE id < 20000 AND striped >= 1000000) FROM '{TEST_DIR}/page_index_read.parquet' WHERE id < 20000 AND striped >= 1000000
----
true

statement ok
CALL disable_logging();

query I
SELECT sum(info['rows_skipped']::BIGINT) = 100000 - (SELECT count(*) FROM data WHERE id // 512 <= 39 AND (id // 512) % 2 = 1)
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# strings, doubles, NULLs, struct fields: results match the data
query I
SELECT count(*) FROM (
	(SELECT * FROM '{TEST_DIR}/page_index_read.parquet' WHERE s = 'str_050000' EXCEPT ALL SELECT * FROM data WHERE s = 'str_050000')
	UNION ALL
	(SELECT * FROM data WHERE s = 'str_050000' EXCEPT ALL SELECT * FROM '{TEST_DIR}/page_index_read.parquet' WHERE s = 'str_050000')
)
----
0

query I
SELECT count(*) = (SELECT count(*) FROM data WHERE s = 'str_050000') FROM '{TEST_DIR}/page_index_read.parquet' WHERE s = 'str_050000'
----
true

