# name: test/sql/copy/parquet/page_index/page_index_reference.test
# description: Page indexes written by Spark (parquet-mr) and pyarrow: read like parquet-mr reads them, prune pages without changing results
# group: [page_index]

require parquet

# the files and the CSVs with parquet-mr's view of their page indexes are generated by
# data/parquet-testing/page_index/generate_page_index_files.py

statement ok
CREATE MACRO expected_page_index(file) AS TABLE
	SELECT * FROM read_csv('data/parquet-testing/page_index/' || file || '.expected.csv', header = true, nullstr = '',
	                       columns = {'row_group_id': 'BIGINT', 'column_id': 'BIGINT', 'path_in_schema': 'VARCHAR', 'page_id': 'BIGINT',
	                                  'page_offset': 'BIGINT', 'compressed_page_size': 'BIGINT', 'first_row_index': 'BIGINT',
	                                  'num_rows': 'BIGINT', 'null_page': 'BOOLEAN', 'min_value': 'VARCHAR', 'max_value': 'VARCHAR',
	                                  'null_count': 'BIGINT', 'boundary_order': 'VARCHAR'});

statement ok
CREATE MACRO actual_page_index(file) AS TABLE
	SELECT row_group_id, column_id, path_in_schema, page_id, page_offset, compressed_page_size, first_row_index, num_rows,
	       null_page, min_value, max_value, null_count, boundary_order
	FROM parquet_page_index('data/parquet-testing/page_index/' || file || '.parquet');

foreach file spark_sorted spark_descending spark_row_groups_v2 arrow_sorted arrow_row_groups_v2

# DuckDB reads every ColumnIndex and OffsetIndex entry exactly as parquet-mr does
query III
SELECT (SELECT count(*) FROM (FROM actual_page_index('{file}') EXCEPT ALL FROM expected_page_index('{file}'))),
       (SELECT count(*) FROM (FROM expected_page_index('{file}') EXCEPT ALL FROM actual_page_index('{file}'))),
       (SELECT count(*) FROM actual_page_index('{file}')) = (SELECT count(*) FROM expected_page_index('{file}'))
----
0	0	true

query I
SELECT count(*) > 20 FROM actual_page_index('{file}')
----
true

# the reference result is read without the page index
statement ok
SET parquet_use_page_index = false;

statement ok
CREATE OR REPLACE TABLE ref AS SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet';

statement ok
SET parquet_use_page_index = true;

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# point lookups, ranges and IN lists on the sorted (or descending) key, with payload columns
query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id = 1234 EXCEPT ALL SELECT * FROM ref WHERE id = 1234)
	UNION ALL
	(SELECT * FROM ref WHERE id = 1234 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id = 1234)
)
----
0

query II
SELECT count(*), sum(id) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id = 1234
----
1	1234

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id BETWEEN 2000 AND 2100 EXCEPT ALL SELECT * FROM ref WHERE id BETWEEN 2000 AND 2100)
	UNION ALL
	(SELECT * FROM ref WHERE id BETWEEN 2000 AND 2100 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id BETWEEN 2000 AND 2100)
)
----
0

query III
SELECT count(*), min(id), max(id) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id BETWEEN 2000 AND 2100
----
101	2000	2100

query II
SELECT count(*), sum(id) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id IN (1, 1000, 2999, 3999)
----
4	7999

# a filter on the unsorted column and on the string column (whose page bounds are truncated by both writers)
query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE v = 17 EXCEPT ALL SELECT * FROM ref WHERE v = 17)
	UNION ALL
	(SELECT * FROM ref WHERE v = 17 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE v = 17)
)
----
0

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s = 's_003210' EXCEPT ALL SELECT * FROM ref WHERE s = 's_003210')
	UNION ALL
	(SELECT * FROM ref WHERE s = 's_003210' EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s = 's_003210')
)
----
0

query II
SELECT count(*), any_value(id) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s = 's_003210'
----
1	3210

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s >= 'long_0039' AND s < 'long_004' EXCEPT ALL SELECT * FROM ref WHERE s >= 'long_0039' AND s < 'long_004')
	UNION ALL
	(SELECT * FROM ref WHERE s >= 'long_0039' AND s < 'long_004' EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s >= 'long_0039' AND s < 'long_004')
)
----
0

query I
SELECT count(*) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE s >= 'long_0039' AND s < 'long_004'
----
1

# two filters: the pages that may match are the intersection
query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id < 600 AND v > 900 EXCEPT ALL SELECT * FROM ref WHERE id < 600 AND v > 900)
	UNION ALL
	(SELECT * FROM ref WHERE id < 600 AND v > 900 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id < 600 AND v > 900)
)
----
0

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE id < 600 AND v > 900) FROM 'data/parquet-testing/page_index/{file}.parquet' WHERE id < 600 AND v > 900
----
true

statement ok
CALL disable_logging();

# pages were skipped for the selective filters
query II
SELECT count(*) > 3, sum(info['rows_skipped']::BIGINT) > 10000
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
true	true

endloop

# Spark: NULL pages, dates, timestamps, decimals, booleans, lists and structs
statement ok
SET parquet_use_page_index = false;

statement ok
CREATE OR REPLACE TABLE ref AS SELECT * FROM 'data/parquet-testing/page_index/spark_sorted.parquet';

statement ok
SET parquet_use_page_index = true;

query II
SELECT count(*), bool_and(null_page) FROM parquet_page_index('data/parquet-testing/page_index/spark_sorted.parquet') WHERE path_in_schema = 'n' AND first_row_index BETWEEN 1000 AND 1999
----
4	true

# the all-NULL pages are skipped for a filter that needs a value, and only they are read for IS NULL on that stretch
query II
SELECT count(*), sum(n) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE n BETWEEN 1000 AND 1999
----
0	NULL

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE n IS NULL AND id BETWEEN 900 AND 2100) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE n IS NULL AND id BETWEEN 900 AND 2100
----
true

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE n IS NULL AND id BETWEEN 900 AND 2100 EXCEPT ALL SELECT * FROM ref WHERE n IS NULL AND id BETWEEN 900 AND 2100)
	UNION ALL
	(SELECT * FROM ref WHERE n IS NULL AND id BETWEEN 900 AND 2100 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE n IS NULL AND id BETWEEN 900 AND 2100)
)
----
0

query II
SELECT count(*), list(id ORDER BY id) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE dt = DATE '2024-02-01' AND id < 1000
----
3	[31, 431, 831]

query III
SELECT count(*), min(id), max(id) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE ts BETWEEN TIMESTAMP '2024-01-01 00:10:00' AND TIMESTAMP '2024-01-01 00:10:09'
----
10	600	609

query III
SELECT count(*), min(id), max(dec) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE dec >= 999.00
----
4	3996	999.75

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE dec BETWEEN 100 AND 200) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE dec BETWEEN 100 AND 200
----
true

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE b AND id BETWEEN 0 AND 299) FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE b AND id BETWEEN 0 AND 299
----
true

query II
SELECT arr, st FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE id = 2500
----
[2500, 2501]	{'a': 2500, 'b': t2500}

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE d > 999.0 EXCEPT ALL SELECT * FROM ref WHERE d > 999.0)
	UNION ALL
	(SELECT * FROM ref WHERE d > 999.0 EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/spark_sorted.parquet' WHERE d > 999.0)
)
----
0

# pyarrow: floats, decimals as fixed length byte arrays, timestamps and lists, in several row groups with V2 pages
statement ok
SET parquet_use_page_index = false;

statement ok
CREATE OR REPLACE TABLE ref AS SELECT * FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet';

statement ok
SET parquet_use_page_index = true;

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

query III
SELECT count(*), min(id), max(id) FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE f < 10
----
80	0	79

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE f BETWEEN 100.5 AND 200.25) FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE f BETWEEN 100.5 AND 200.25
----
true

query II
SELECT count(*), any_value(id) FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE dec = 12.25
----
1	49

query II
SELECT count(*), any_value(id) FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE ts = TIMESTAMP '2024-01-01 00:10:00'
----
1	600

query I
SELECT count(*) = (SELECT count(*) FROM ref WHERE n IS NULL) FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE n IS NULL
----
true

query I
SELECT count(*) FROM (
	(SELECT * FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE n IS NULL EXCEPT ALL SELECT * FROM ref WHERE n IS NULL)
	UNION ALL
	(SELECT * FROM ref WHERE n IS NULL EXCEPT ALL SELECT * FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE n IS NULL)
)
----
0

query I
SELECT arr FROM 'data/parquet-testing/page_index/arrow_row_groups_v2.parquet' WHERE id = 3333
----
[3333, 3334]

statement ok
CALL disable_logging();

# the row groups that cannot match are skipped by their statistics, pages are skipped within the others
query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipPages'
----
true

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'ParquetReader' AND event = 'SkipRowGroup'
----
true
