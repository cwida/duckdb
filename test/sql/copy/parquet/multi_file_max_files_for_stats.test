# name: test/sql/copy/parquet/multi_file_max_files_for_stats.test
# description: maximum_files_for_stats gives a multi-file scan their merged statistics and exact count
# group: [parquet]

require parquet

statement ok
COPY (SELECT range AS i FROM range(0, 10)) TO '{TEST_DIR}/sample_stats_0.parquet'

statement ok
COPY (SELECT range AS i FROM range(100, 110)) TO '{TEST_DIR}/sample_stats_1.parquet'

# statistics cover every file: a filter outside the merged min and max empties the scan
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=2) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*Empty Result.*

query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=2)
----
physical_plan	<REGEX>:.*.*20.*.*

# a filter inside the range is kept
query I
SELECT count(*) FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=2) WHERE i > 5
----
14

# by default there are no statistics for several files
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet']) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*Read Parquet.*

# more files than the maximum: no statistics
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=1) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*Read Parquet.*

# an empty file has no statistics and is skipped
statement ok
COPY (SELECT range AS i FROM range(0, 0)) TO '{TEST_DIR}/sample_stats_empty.parquet'

query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_empty.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=3) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*Empty Result.*

# the count is exact: a LIMIT above it is dropped
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], maximum_files_for_stats=2) LIMIT 100
----
physical_plan	<REGEX>:(?s)^([^L]|L[^i]|Li[^m])*$

query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet']) LIMIT 100
----
physical_plan	<REGEX>:(?s).*Limit.*

# the maximum is what the row groups hold, not the footers' totals: this file's footer says 1 row, its row group 5
query II
EXPLAIN SELECT * FROM read_parquet(['{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', '{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet'], maximum_files_for_stats=2) LIMIT 3
----
physical_plan	<REGEX>:(?si).*LIMIT.*

query I
SELECT count(*) FROM (SELECT * FROM read_parquet(['{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', '{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet'], maximum_files_for_stats=2) LIMIT 3)
----
3

query II
EXPLAIN SELECT * FROM read_parquet(['{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', '{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet'], maximum_files_for_stats=2) LIMIT 20
----
physical_plan	<!REGEX>:(?si).*LIMIT.*

# a scan whose schema is given reads the files for their statistics too
query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], schema=map{'i': {name: 'i', type: 'BIGINT', default_value: NULL}}, maximum_files_for_stats=2) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*Empty Result.*

query I
SELECT count(*) FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], schema=map{'i': {name: 'i', type: 'BIGINT', default_value: NULL}}, maximum_files_for_stats=2) WHERE i > 5
----
14

query II
EXPLAIN SELECT * FROM read_parquet(['{TEST_DIR}/sample_stats_0.parquet', '{TEST_DIR}/sample_stats_1.parquet'], schema=map{'i': {name: 'i', type: 'BIGINT', default_value: NULL}}) WHERE i > 1000
----
physical_plan	<REGEX>:(?s).*READ_PARQUET.*
