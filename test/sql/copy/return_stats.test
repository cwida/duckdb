query IIIIIII
COPY floating_point_nan TO '{TEST_DIR}/fp_nan.parquet' (RETURN_STATS);
----
<REGEX>:.*fp_nan.parquet	2500	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"fp"'={column_size_bytes=\d+, has_nan=true, max=249.9, max_is_exact=true, min=0.1, min_is_exact=true, nan_count=250, null_count=500, num_values=2500}}	NULL	{row_group_count=1}

query IIIIIII
COPY fp_nan_only TO '{TEST_DIR}/fp_nan_only.parquet' (RETURN_STATS);
----
<REGEX>:.*fp_nan_only.parquet	1	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"float_val"'={column_size_bytes=\d+, has_nan=true, nan_count=1, null_count=0, num_values=1}}	NULL	{row_group_count=1}

# large strings are truncated to the nearest valid UTF8 string
query IIIIIII
COPY large_string TO '{TEST_DIR}/test_large_string.parquet' (RETURN_STATS);
----
<REGEX>:.*test_large_string.parquet	2	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"val"'={column_size_bytes=\d+, max='ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ\[', max_is_exact=false, min=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, min_is_exact=false, null_count=0, num_values=2}}	NULL	{row_group_count=1}

# large blobs are just truncated to 256 bytes
query IIIIIII
COPY large_blob TO '{TEST_DIR}/test_large_blob.parquet' (RETURN_STATS);
----
<REGEX>:.*test_large_blob.parquet	2	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"val"'={column_size_bytes=\d+, , max_is_exact=false, , min_is_exact=false, null_count=0, num_values=2}}	NULL	{row_group_count=1}

