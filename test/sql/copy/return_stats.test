# name: test/sql/copy/return_stats.test
# description: test RETURN_STATS parameter for COPY
# group: [copy]

require parquet

statement ok
CREATE TABLE integers AS SELECT range i FROM range(200000);

statement ok
CREATE TABLE bools AS SELECT i::bool i FROM range(2) i(i);

statement ok
CREATE TABLE multi_column_test AS SELECT range i, range%10 j, case when range%2=0 then null else range end k FROM range(2500);

statement ok
CREATE TABLE floating_point_test AS SELECT case when i%10=0 then null else i/10.0 end as fp FROM range(2500) t(i)

statement ok
CREATE TABLE floating_point_nan AS SELECT case when i%10=0 then 'nan'::double when i%4=0 then null else i/10.0 end as fp FROM range(2500) t(i)

statement ok
CREATE TABLE fp_nan_only AS SELECT 'nan'::float as float_val

statement ok
CREATE TABLE string_test AS SELECT concat('thisisalongstring_', range) s FROM range(2500);

statement ok
CREATE TABLE date_test AS
SELECT (TIMESTAMP '2000-01-01' + interval (range) day)::DATE dt,
       TIMESTAMP '2000-01-01 12:12:12.123456' + interval (range) day ts,
       (TIMESTAMP '2000-01-01 12:12:12' + interval (range) day)::TIMESTAMP_S ts_s,
       (TIMESTAMP '2000-01-01 12:12:12.123' + interval (range) day)::TIMESTAMP_MS ts_ms,
       concat((TIMESTAMP '2000-01-01 12:12:12.123456' + interval (range) day)::VARCHAR, '789')::TIMESTAMP_NS ts_ns,
       TIME '00:00:00' + interval (10 * range) second t
FROM range(2500);

statement ok
CREATE TABLE empty_test AS FROM range(2500) LIMIT 0;

statement ok
CREATE TABLE blob_test AS SELECT ''::BLOB AS bl UNION ALL SELECT '\x80\x00\x80'::BLOB

statement ok
CREATE TABLE decimal_test AS
SELECT 25.3::DECIMAL(4,1) AS dec_i16,
       123456.789::DECIMAL(9,3) AS dec_i32,
       123456789123.456::DECIMAL(18,3) AS dec_i64,
       12345678912345678912345678912345678.912::DECIMAL(38,3) AS dec_i128
UNION ALL
SELECT 1.1::DECIMAL(4,1),
       2.123::DECIMAL(9,3),
       3.456::DECIMAL(18,3),
       4.567::DECIMAL(38,3)

statement ok
CREATE TABLE struct_test AS SELECT case when i%10=0 then null else {'x': i, 'y': case when i%2=0 then 100 + i else null end} end struct_val FROM range(2500) t(i)

statement ok
CREATE TABLE list_test AS SELECT [i] l1, case when i%10=0 then null else [case when i%2=0 then 100 + i else null end] end l2 FROM range(2500) t(i)

statement ok
CREATE TABLE medium_list_test AS SELECT
	[i, i, i] l1,
	case when i%10=0
		then
			null
		else
			[case when i%2=0 then 100 + i else null end, null, case when i%2=0 then null else 100 + i end]
	end l2
FROM range(2500) t(i)

statement ok
CREATE TABLE nested_struct_test AS SELECT {'s1': {'x': i}, 's2': {'s3': {'y': i}, 'l': [i]}} n FROM range(2500) t(i)

statement ok
CREATE TABLE funky_names AS SELECT {'quoted ''"field name"': 42} """quoted col name"""

statement ok
CREATE TABLE map_test AS SELECT MAP {'key'||i: i} AS map_val FROM range(2500) t(i)

statement ok
CREATE TABLE array_test AS SELECT [i, i + 1, i + 2]::INT[3] AS array_val FROM range(2500) t(i)

statement ok
CREATE TABLE struct_nan_test AS SELECT case when i%10=0 then null else {'x': case when i%10=5 then 'nan'::double else i/10.0 end, 'y': (i/10.0)::float} end struct_val FROM range(2500) t(i)

statement ok
CREATE TABLE list_nan_test AS SELECT case when i%10=0 then null else [i/10.0, case when i%10=5 then 'nan'::double else null end] end l1, [case when i%5=0 then 'nan'::float else (i/10.0)::float end] l2 FROM range(2500) t(i)

statement ok
CREATE TABLE map_nan_test AS SELECT MAP {'key'||i: case when i%10=5 then 'nan'::float else (i/10.0)::float end} map_val, MAP {case when i%5=0 then 'nan'::double else i/10.0 end: case when i%2=0 then 'nan'::double else i/10.0 end} fp_map FROM range(2500) t(i)

statement ok
CREATE TABLE array_nan_test AS SELECT [i/10.0, case when i%10=5 then 'nan'::double else null end, i/10.0]::DOUBLE[3] AS array_val FROM range(2500) t(i)

statement ok
CREATE TABLE nested_nan_test AS SELECT {'s': {'x': case when i%10=5 then 'nan'::double else i/10.0 end}, 'l': [case when i%5=0 then 'nan'::float else (i/10.0)::float end]} n, [{'a': case when i%2=0 then 'nan'::double else i/10.0 end}] ls FROM range(2500) t(i)

statement ok
CREATE TABLE variant_nan_test AS SELECT case when i%10=5 then 'nan'::double::variant when i%10=3 then 'nan'::float::variant when i%10=7 then 'text'::variant else (i/10.0)::variant end v FROM range(2500) t(i)

statement ok
CREATE TABLE variant_struct_nan_test AS SELECT {'a': case when i%10=5 then 'nan'::double else i/10.0 end, 'b': case when i%5=0 then 'nan'::float else (i/10.0)::float end}::variant v FROM range(2500) t(i)

statement ok
CREATE TABLE variant_list_nan_test AS SELECT [i/10.0, case when i%10=5 then 'nan'::double else null end]::variant v FROM range(2500) t(i)

statement ok
CREATE TABLE partitioned_test AS SELECT range%2 as partition_key, range val FROM range(2500)

statement ok
CREATE TABLE multi_partitioned_test AS SELECT range%2 as partition_key, range % 3 as partition_key2, range val FROM range(2500)

statement ok
CREATE TABLE large_string AS SELECT repeat('A', 254) || '🦆' AS val UNION ALL SELECT repeat('Z', 254) || '🦆'

statement ok
CREATE TABLE large_blob AS SELECT repeat('\x81', 4000)::BLOB AS val UNION ALL SELECT repeat('\x80', 4000)::BLOB

statement ok
CREATE TABLE uuids AS SELECT uuid '47183823-2574-4bfd-b411-99ed177d3e43' uuid_val union all select uuid '00112233-4455-6677-8899-aabbccddeeff';

# test all of these with preserve_insertion_order=true/false to test both the batch copy and the regular copy
foreach PRESERVE_INSERTION_ORDER true false

statement ok
SET preserve_insertion_order={PRESERVE_INSERTION_ORDER};

# single column
query IIIIIII
COPY integers TO '{TEST_DIR}/test_copy_to_file.parquet' (RETURN_STATS);
----
<REGEX>:.*test_copy_to_file.parquet	200000	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"i"'={column_size_bytes=\d+, max=199999, max_is_exact=true, min=0, min_is_exact=true, null_count=0, num_values=200000}}	NULL	{row_group_count=2}

# bools
query IIIIIII
COPY bools TO '{TEST_DIR}/test_copy_to_file.parquet' (RETURN_STATS);
----
<REGEX>:.*test_copy_to_file.parquet	2	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"i"'={column_size_bytes=\d+, max=1, max_is_exact=true, min=0, min_is_exact=true, null_count=0, num_values=2}}	NULL	{row_group_count=1}


# multi-column
query IIIIIII
COPY multi_column_test TO '{TEST_DIR}/multi_column_copy.parquet' (RETURN_STATS);
----
<REGEX>:.*multi_column_copy.parquet	2500	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"i"'={column_size_bytes=\d+, max=2499, max_is_exact=true, min=0, min_is_exact=true, null_count=0, num_values=2500}, '"j"'={column_size_bytes=\d+, max=9, max_is_exact=true, min=0, min_is_exact=true, null_count=0, num_values=2500}, '"k"'={column_size_bytes=\d+, max=2499, max_is_exact=true, min=1, min_is_exact=true, null_count=1250, num_values=2500}}	NULL	{row_group_count=1}

# strings
query IIIIIII
COPY string_test TO '{TEST_DIR}/string_test.parquet' (RETURN_STATS);
----
<REGEX>:.*string_test.parquet	2500	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"s"'={column_size_bytes=\d+, max=thisisalongstring_999, max_is_exact=true, min=thisisalongstring_0, min_is_exact=true, null_count=0, num_values=2500}}	NULL	{row_group_count=1}

# timestamps/dates
query IIIIIII
COPY date_test TO '{TEST_DIR}/date_test.parquet' (RETURN_STATS);
----
<REGEX>:.*date_test.parquet	2500	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"dt"'={column_size_bytes=\d+, max=2006-11-04, max_is_exact=true, min=2000-01-01, min_is_exact=true, null_count=0, num_values=2500}, '"t"'={column_size_bytes=\d+, max='06:56:30', max_is_exact=true, min='00:00:00', min_is_exact=true, null_count=0, num_values=2500}, '"ts"'={column_size_bytes=\d+, max='2006-11-04 12:12:12.123456', max_is_exact=true, min='2000-01-01 12:12:12.123456', min_is_exact=true, null_count=0, num_values=2500}, '"ts_ms"'={column_size_bytes=\d+, max='2006-11-04 12:12:12.123', max_is_exact=true, min='2000-01-01 12:12:12.123', min_is_exact=true, null_count=0, num_values=2500}, '"ts_ns"'={column_size_bytes=\d+, max='2006-11-04 12:12:12.123456789', max_is_exact=true, min='2000-01-01 12:12:12.123456789', min_is_exact=true, null_count=0, num_values=2500}, '"ts_s"'={column_size_bytes=\d+, max='2006-11-04 12:12:12', max_is_exact=true, min='2000-01-01 12:12:12', min_is_exact=true, null_count=0, num_values=2500}}	NULL	{row_group_count=1}

# empty table
query IIIIIII
COPY empty_test TO '{TEST_DIR}/empty_test.parquet' (RETURN_STATS);
----
<REGEX>:.*empty_test.parquet	0	<REGEX>:\d+	<REGEX>:\d+	{'"range"'={column_size_bytes=0, null_count=0, num_values=0}}	NULL	{row_group_count=0}

