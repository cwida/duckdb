not supported

# 128-bit decimal stats are big-endian; unifying row-group bounds must decode
# before comparing, otherwise the file-level min/max get swapped
statement ok
SET preserve_insertion_order=true;

statement ok
CREATE TABLE decimal128_multi_rg AS SELECT CASE WHEN i < 2048 THEN 126619 ELSE 19308 END::DECIMAL(38,0) AS c FROM range(4096) t(i);

query IIIIIII
COPY decimal128_multi_rg TO '{TEST_DIR}/decimal128_multi_rg.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048, RETURN_STATS);
----
<REGEX>:.*decimal128_multi_rg.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"c"'={column_size_bytes=\d+, max=126619, max_is_exact=true, min=19308, min_is_exact=true, null_count=0, num_values=4096}}	NULL	{row_group_count=2}

# NaN stats are accumulated over row groups: a NaN that is only in the first row group
# must still be reported, and NaN counts from different row groups are added up
statement ok
CREATE TABLE nan_first_rg AS SELECT CASE WHEN i = 0 THEN 'nan'::double ELSE i::double END AS d FROM range(4096) t(i);

query IIIIIII
COPY nan_first_rg TO '{TEST_DIR}/nan_first_rg.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048, RETURN_STATS);
----
<REGEX>:.*nan_first_rg.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"d"'={column_size_bytes=\d+, has_nan=true, max=4095.0, max_is_exact=true, min=1.0, min_is_exact=true, nan_count=1, null_count=0, num_values=4096}}	NULL	{row_group_count=2}

statement ok
CREATE TABLE nan_every_rg AS SELECT CASE WHEN i % 1000 = 0 THEN 'nan'::float ELSE i::float END AS f FROM range(4096) t(i);

query IIIIIII
COPY nan_every_rg TO '{TEST_DIR}/nan_every_rg.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048, RETURN_STATS);
----
<REGEX>:.*nan_every_rg.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"f"'={column_size_bytes=\d+, has_nan=true, max=4095.0, max_is_exact=true, min=1.0, min_is_exact=true, nan_count=5, null_count=0, num_values=4096}}	NULL	{row_group_count=2}

# the NaN stats of nested and shredded VARIANT fields are accumulated over row groups too: s.x and v only have NaNs
# in the first row group, l has NaNs in both
statement ok
CREATE TABLE nested_nan_rg AS SELECT {'x': CASE WHEN i = 0 THEN 'nan'::double ELSE i::double END} s, [CASE WHEN i % 1000 = 0 THEN 'nan'::float ELSE i::float END] l, (CASE WHEN i IN (1, 2) THEN 'nan'::double ELSE i::double END)::VARIANT v FROM range(4096) t(i);

query IIIIIII
COPY nested_nan_rg TO '{TEST_DIR}/nested_nan_rg.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048, SHREDDING {v: 'DOUBLE'}, RETURN_STATS);
----
<REGEX>:.*nested_nan_rg.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"l"'={null_count=0, num_values=4096}, '"l"."element"'={column_size_bytes=\d+, has_nan=true, max=4095.0, max_is_exact=true, min=1.0, min_is_exact=true, nan_count=5, null_count=0, num_values=4096}, '"s"'={null_count=0, num_values=4096}, '"s"."x"'={column_size_bytes=\d+, has_nan=true, max=4095.0, max_is_exact=true, min=1.0, min_is_exact=true, nan_count=1, null_count=0, num_values=4096}, '"v"'={null_count=0, num_values=4096}, '"v"."metadata"'={column_size_bytes=\d+, max=010000, max_is_exact=true, min=010000, min_is_exact=true, null_count=0, num_values=4096, variant_type='STRUCT\(metadata BLOB, "value" BLOB, typed_value DOUBLE\)'}, '"v"."typed_value"'={column_size_bytes=\d+, has_nan=true, max=4095.0, max_is_exact=true, min=0.0, min_is_exact=true, nan_count=2, null_count=0, num_values=4096}, '"v"."value"'={column_size_bytes=\d+, null_count=4096, num_values=4096}}	NULL	{row_group_count=2}

# a NULL struct inside a list counts once in the null_count of its fields
query IIIIIII
COPY (SELECT [NULL, {'a': 1}] AS l) TO '{TEST_DIR}/list_struct_null.parquet' (RETURN_STATS);
----
<REGEX>:.*list_struct_null.parquet	1	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"l"'={null_count=0, num_values=1}, '"l"."element"'={null_count=1, num_values=2}, '"l"."element"."a"'={column_size_bytes=\d+, max=1, max_is_exact=true, min=1, min_is_exact=true, null_count=1, num_values=2}}	NULL	{row_group_count=1}

# NULL lists, NULL struct elements and NULL fields, accumulated over row groups
statement ok
CREATE TABLE list_struct_nulls AS SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE [NULL, {'a': i}, CASE WHEN i % 3 = 0 THEN NULL ELSE {'a': NULL} END] END ls FROM range(4096) t(i);

query IIIIIII
COPY list_struct_nulls TO '{TEST_DIR}/list_struct_nulls.parquet' (ROW_GROUP_SIZE 2048, RETURN_STATS);
----
<REGEX>:.*list_struct_nulls.parquet	4096	<REGEX>:\d+	<REGEX>:\d+	<REGEX>:{'"ls"'={null_count=410, num_values=4096}, '"ls"."element"'={null_count=4915, num_values=11058}, '"ls"."element"."a"'={column_size_bytes=\d+, max=4095, max_is_exact=true, min=1, min_is_exact=true, null_count=7782, num_values=11468}}	NULL	{row_group_count=2}
