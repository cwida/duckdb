# name: test/sql/pg_catalog/pg_ident_and_array_bounds.test
# description: Test pg_catalog quote_ident, parse_ident, array_lower, and array_upper
# group: [pg_catalog]

# quote_ident leaves a lowercase name bare. A keyword such as select is also left bare.

query I
SELECT quote_ident('foo')
----
foo

query I
SELECT quote_ident('Foo')
----
"Foo"

query I
SELECT quote_ident('foo bar')
----
"foo bar"

query I
SELECT quote_ident('')
----
""

query I
SELECT quote_ident('1foo')
----
"1foo"

query I
SELECT quote_ident('_a')
----
_a

query I
SELECT quote_ident('foo$bar')
----
"foo$bar"

query I
SELECT quote_ident('select')
----
select

query I
SELECT quote_ident('föo')
----
"föo"

query I
SELECT pg_catalog.quote_ident('foo"bar')
----
"foo""bar"

query I
SELECT quote_ident(NULL)
----
NULL

query I
SELECT array_lower([4, 5, 6], 1)
----
1

query I
SELECT array_upper([4, 5, 6], 1)
----
3

query I
SELECT array_lower(NULL::INTEGER[], 1)
----
NULL

query I
SELECT array_upper(NULL::INTEGER[], 1)
----
NULL

query I
SELECT array_lower([]::INTEGER[], 1)
----
NULL

query I
SELECT array_upper([]::INTEGER[], 1)
----
NULL

statement error
SELECT array_lower([1, 2, 3], 2)
----
<REGEX>:Not implemented Error:.*dimensions other than 1.*

query I
SELECT parse_ident('x.y.z')
----
[x, y, z]

query I
SELECT parse_ident('foo')
----
[foo]

query I
SELECT parse_ident('Foo')
----
[foo]

query I
SELECT parse_ident('"SomeSchema".someTable')
----
[SomeSchema, sometable]

query I
SELECT parse_ident('"a.b".c')
----
[a.b, c]

query I
SELECT parse_ident('"foo""bar"')
----
['foo"bar']

query I
SELECT parse_ident('foo . bar')
----
[foo, bar]

query I
SELECT parse_ident('" Foo "')
----
[' Foo ']

# An empty part, a trailing dot, a leading dot, and an empty string do not raise.

query I
SELECT parse_ident('foo..bar')
----
[foo, bar]

query I
SELECT parse_ident('foo.')
----
[foo]

query I
SELECT parse_ident('.foo')
----
[foo]

query I
SELECT parse_ident('')
----
[]

query I
SELECT parse_ident('""')
----
['']

query I
SELECT parse_ident('"foo')
----
[foo]

query I
SELECT parse_ident('foo-bar')
----
[foo-bar]

query I
SELECT parse_ident(NULL)
----
NULL
