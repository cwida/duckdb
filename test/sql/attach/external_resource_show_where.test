# name: test/sql/attach/external_resource_show_where.test
# description: SHOW [ALL] EXTERNAL RESOURCES WHERE <expr> filters the listed resources
# group: [attach]

# Two types with list callbacks, so SHOW ALL has discovered rows of more than one type to filter.
statement ok
CREATE MACRO list_a(opts) AS TABLE
    SELECT * FROM (VALUES
        (MAP {'id': 'a1'}, 'a-1', 'running'),
        (MAP {'id': 'a2'}, 'a-2', 'stopped')
    ) t(handle, reference, state);

statement ok
CREATE MACRO list_b(opts) AS TABLE
    SELECT * FROM (VALUES
        (MAP {'id': 'b1'}, 'b-1', 'running')
    ) t(handle, reference, state);

statement ok
CALL register_external_resource_type('a@show', kind := 'catalog', create_function := 'noop_create', list_function := 'list_a');

statement ok
CALL register_external_resource_type('b@show', kind := 'catalog', create_function := 'noop_create', list_function := 'list_b');

statement ok
CALL register_external_resource('a@show', 'local_a1', MAP {'id': 'a1'});

# Without WHERE: the same rows as before.
query TTTTTTTT rowsort
SHOW ALL EXTERNAL RESOURCES;
----
NULL	a@show	false	stopped	a-2	NULL	NULL	{id=a2}
NULL	b@show	false	running	b-1	NULL	NULL	{id=b1}
local_a1	a@show	true	NULL	NULL	NULL	NULL	{id=a1}

# WHERE on the type.
query TTTTTTTT
SHOW ALL EXTERNAL RESOURCES WHERE type = 'b@show';
----
NULL	b@show	false	running	b-1	NULL	NULL	{id=b1}

query TTTTTTTT rowsort
SHOW ALL EXTERNAL RESOURCES WHERE type LIKE 'a@%';
----
NULL	a@show	false	stopped	a-2	NULL	NULL	{id=a2}
local_a1	a@show	true	NULL	NULL	NULL	NULL	{id=a1}

# WHERE on any other column of the listing.
query TTTTTTTT
SHOW ALL EXTERNAL RESOURCES WHERE reference = 'a-2';
----
NULL	a@show	false	stopped	a-2	NULL	NULL	{id=a2}

query TTTTTTTT rowsort
SHOW ALL EXTERNAL RESOURCES WHERE NOT managed AND state = 'running';
----
NULL	b@show	false	running	b-1	NULL	NULL	{id=b1}

query TTTTTTTT
SHOW ALL EXTERNAL RESOURCES WHERE handle['id'] = 'a1';
----
local_a1	a@show	true	NULL	NULL	NULL	NULL	{id=a1}

# Without ALL only the locally registered resources are listed, and WHERE filters those.
query TTTTTTTT
SHOW EXTERNAL RESOURCES WHERE type = 'a@show';
----
local_a1	a@show	true	NULL	NULL	NULL	NULL	{id=a1}

query TTTTTTTT
SHOW EXTERNAL RESOURCES WHERE type = 'b@show';
----

query TTTTTTTT
SHOW EXTERNAL RESOURCES WHERE false;
----

# The filter is bound against the columns of the listing.
statement error
SHOW ALL EXTERNAL RESOURCES WHERE region = 'us-west-2';
----
<REGEX>:Binder Error.*region.*

statement error
SHOW EXTERNAL RESOURCES WHERE nosuchfunction(type);
----
<REGEX>:.*nosuchfunction.*
