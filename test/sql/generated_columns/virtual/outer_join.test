statement ok
CREATE TABLE grouped_inputs(i INTEGER, j INTEGER, g AS (i + 1), multiple_inputs AS (i + j), wide AS (i::BIGINT + 1), chained AS (g + 1), unit AS (1));

statement ok
INSERT INTO grouped_inputs VALUES (1, 10), (3, 30), (NULL, 99);

query II
SELECT r.g, count(*) FROM (VALUES (1), (2), (3)) l(i) LEFT JOIN grouped_inputs r USING (i) GROUP BY r.i ORDER BY r.g;
----
2	1
4	1
NULL	1

query II
SELECT (SELECT r.g), count(*) FROM (VALUES (1), (2), (3)) l(i) LEFT JOIN grouped_inputs r USING (i) GROUP BY r.i ORDER BY 1;
----
2	1
4	1
NULL	1

statement error
SELECT r, count(*) FROM (VALUES (1), (2), (3)) l(i) LEFT JOIN grouped_inputs r USING (i) GROUP BY r.i;
----
<REGEX>:.*column "r" must appear in the GROUP BY clause.*ANY_VALUE\("r"\).*

query IIII
