# name: test/sql/collate/test_collate_functions.test
# description: Test that collations are registered as collate_<name> functions
# group: [collate]

# built-in collations are scalar functions with the collate_ prefix
query I
SELECT collate_nocase('HeLLo')
----
hello

query I
SELECT collate_noaccent('café')
----
cafe

query I
SELECT collname FROM pragma_collations() WHERE collname IN ('nocase', 'noaccent', 'nfc') ORDER BY 1
----
nfc
noaccent
nocase

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'collate_nocase'
----
1

# nocase and noaccent are combinable
query I
SELECT 'ÀB' = 'ab' COLLATE nocase.noaccent
----
true

# unknown collations are still reported as such
statement error
SELECT 'a' COLLATE does_not_exist
----
Catalog Error: Collation with name does_not_exist does not exist!

# a misspelled collation suggests the closest one
statement error
SELECT 'a' COLLATE nocas
----
<REGEX>:Catalog Error: Collation with name nocas does not exist!.*Did you mean "nocase"\?.*

# only system scalar functions that take a VARCHAR are collations: macros and functions in other schemas are not
statement ok
CREATE MACRO collate_my_macro(s) AS lower(s);

statement ok
CREATE SCHEMA other;

statement ok
CREATE MACRO other.collate_other(s) AS lower(s);

query I
SELECT count(*) FROM pragma_collations() WHERE collname IN ('my_macro', 'other')
----
0

statement error
SELECT 'a' COLLATE my_macro
----
Catalog Error: Collation with name my_macro does not exist!
