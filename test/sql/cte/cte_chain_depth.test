# a side-effecting CTE is force-bound from the defining scope
statement ok
CREATE TABLE depth_t(i INTEGER)

query I
WITH c AS (INSERT INTO depth_t VALUES (1) RETURNING i) SELECT 1 AS one
----
1

# recursive CTEs are unaffected
query I
WITH RECURSIVE r(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM r WHERE x<5) SELECT max(x) FROM r
----
5

# sibling WITH lists are prepared iteratively, not through native recursion: an outer and an
# inner list that each fit the limit must not sum
statement ok
SET max_expression_depth=16

query I
WITH c0 AS (WITH a0 AS (SELECT 1), a1 AS (SELECT 1), a2 AS (SELECT 1), a3 AS (SELECT 1), a4 AS (SELECT 1), a5 AS (SELECT 1), a6 AS (SELECT 1), a7 AS (SELECT 1) SELECT 1 AS x), c1 AS (SELECT 1), c2 AS (SELECT 1), c3 AS (SELECT 1), c4 AS (SELECT 1), c5 AS (SELECT 1), c6 AS (SELECT 1), c7 AS (SELECT 1) SELECT x FROM c0;
