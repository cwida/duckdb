# name: test/sql/cte/cte_chain_depth.test
# description: Binder depth accumulates across lazily bound CTE chains
# group: [cte]

# chained CTEs whose definitions nest the reference to the previous CTE in derived tables:
# every lazy CTE bind continues the native bind recursion from the reference site, so the
# accumulated depth must count against max_expression_depth instead of restarting at the
# defining binder (which exhausted the native stack on long chains)

# 20 chained CTEs with 10 nested derived tables each stay well below the default limit
query I
WITH c0 AS (SELECT 1 AS x), c1 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c0))))))))))), c2 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c1))))))))))), c3 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c2))))))))))), c4 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c3))))))))))), c5 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c4))))))))))), c6 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c5))))))))))), c7 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c6))))))))))), c8 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c7))))))))))), c9 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c8))))))))))), c10 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x+1 AS x FROM c9))))))))))), c11 AS (SELECT x FROM (SELECT x FROM (SEL