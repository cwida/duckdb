# at the boundary, sibling CTE scopes inside a deep definition are charged once, not stacked:
# the inner list of two unused CTEs binds its scopes at the same recursion depth
query I
WITH c0 AS (WITH a AS (SELECT 1), b AS (SELECT 1) SELECT 1 AS x), c1 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c0)))), c2 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c1)))), c3 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c2)))), c4 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c3)))), c5 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c4)))), c6 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c5)))), c7 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c6)))), c8 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c7)))), c9 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c8)))), c10 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c9)))), c11 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c10)))), c12 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c11)))), c13 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c12)))), c14 AS (SELECT x FROM (SELECT x FROM (SELECT x FROM (SELECT x FROM c13)))) SELECT x FROM c14
