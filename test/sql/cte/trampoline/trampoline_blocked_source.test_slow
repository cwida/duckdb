# name: test/sql/cte/trampoline/trampoline_blocked_source.test_slow
# description: Trampoline waves and recursive epochs suspend around a blocked source
# group: [trampoline]

# With threads == external_threads there are zero internal worker threads. An
# async-yielding source (dbgen schedules its continuation as an executor task and returns
# BLOCKED after every generation step; its ~1.6 s per-invocation text-pool setup is
# scale-independent, which makes this a slow test - dsdgen is cheaper but does not
# block in this shape) can then only make progress on the coordinating thread. The
# trampoline source suspends its wave and returns BLOCKED up the stack, so the regular
# executor flow services the continuation and re-enters the operator where it stopped;
# a wave driver that waits inside the operator without servicing executor tasks deadlocks
# both queries below. The recursive query pins the same suspension at
# threads == external_threads == 2; recursive_inline_blocked_source.test keeps the
# single-thread gate.
# query_timeout is the primary bound on a regression: its watchdog calls Interrupt(),
# which the parked client loop observes. max_execution_time additionally bounds
# regressions where tasks still execute without making progress, but cannot fire while
# the query is fully parked. The runner's process timeout remains the last resort.

require tpch

set query_timeout 120

statement ok
SET threads=2;

statement ok
SET external_threads=2;

statement ok
SET max_execution_time=60000;

query II
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
	(VALUES (1, 0::BIGINT))
	BRANCH 1: (SELECT 0, count(*) FROM dbgen(sf = 0.01))
)
SELECT * FROM t;
----
0	0

query I
WITH RECURSIVE t(lvl, n) AS (
	SELECT 1, 0::BIGINT
	UNION ALL
	SELECT lvl + 1, (SELECT count(*) FROM dbgen(sf = 0.01)) FROM t WHERE lvl < 2
)
SELECT count(*) FROM t;
----
2
