# name: test/sql/cte/trampoline/trampoline_explain.test
# description: Trampoline queries plan a dedicated operator
# group: [trampoline]

query II
EXPLAIN WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 0)
    BRANCH 1: (SELECT CASE WHEN n < 3 THEN 1 ELSE 0 END, n + 1 FROM t)
)
SELECT b, n FROM t;
----
physical_plan	<REGEX>:.*Trampoline.*

# a nonlinear branch switches the operator to per-wave evaluation
query II
EXPLAIN WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 0)
    BRANCH 1: (SELECT 0, sum(n)::INT FROM t)
)
SELECT b, n FROM t;
----
physical_plan	<REGEX>:.*Waves: per-batch.*

query II
EXPLAIN WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 0)
    BRANCH 1: (SELECT CASE WHEN n < 3 THEN 1 ELSE 0 END, n + 1 FROM t)
)
SELECT b, n FROM t;
----
physical_plan	<REGEX>:.*Waves: merged.*

# without CTE inlining the export declines with a clear error instead of
# emitting a materialization hint the parser rejects
statement ok
SET disabled_optimizers = 'cte_inlining';

statement error
EXPLAIN (SQL) WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 7)
    BRANCH 1: (SELECT 0, n FROM t)
)
SELECT b, n FROM t;
----
<REGEX>:Not implemented Error.*trampoline.*

statement ok
SET disabled_optimizers = '';
