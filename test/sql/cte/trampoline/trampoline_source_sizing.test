# name: test/sql/cte/trampoline/trampoline_source_sizing.test
# description: Small independent sources keep cheap waves on the inline path
# group: [trampoline]
# Holds with and without optimizer estimates: a missing estimate reads as zero and stays
# below the parallelization threshold as well.

statement ok
SET threads=4;

statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE TABLE lr8 AS SELECT * FROM (VALUES (-2.0, 0),(-1.0, 0),(0.5, 0),(1.0, 1),(1.5, 1),(2.0, 1)) v(f, y);

# A scan-bearing light branch body: the correlated aggregate re-scans a tiny base table
# every wave. The scan's estimated work is far below the parallelization threshold, so
# every one-row wave must run inline instead of through the parallel event machinery.
query II
WITH RECURSIVE t(b, w, n) USING TRAMPOLINE (b) AS (
	(VALUES (1, 0.0, 0))
	BRANCH 1: (SELECT CASE WHEN n < 20 THEN 1 ELSE 0 END,
	                  w - (SELECT avg((w - y) * f) FROM lr8), n + 1 FROM t)
)
SELECT count(*), max(n) FROM t;
----
1	21

statement ok
CALL disable_logging();

# Measured route arbitration may spend at most one probe wave per branch on the parallel
# route (on a slow host an inline wave can cross the probe threshold), so the pins bound
# the estimate policy with a one-probe allowance instead of exact worker counts: the
# median epoch worker count stays 1, and the worker total can exceed the epoch count by
# at most one probe wave's workers. Reverting the estimate-sized policy puts every wave
# on the parallel route and fails both.
query II
SELECT info.epochs::UBIGINT = 21,
       info.scheduled_workers::UBIGINT BETWEEN info.epochs::UBIGINT AND info.epochs::UBIGINT + 3
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalTrampoline' AND event = 'RuntimeMetrics';
----
1	1

query I
SELECT info.workers_p50_upper_bound::UBIGINT = 1
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalTrampoline' AND event = 'EpochSummary';
----
1
