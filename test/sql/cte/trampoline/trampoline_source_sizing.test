# name: test/sql/cte/trampoline/trampoline_source_sizing.test
# description: Independent-source wave parallelism is sized by the source work estimate
# group: [trampoline]
# Skipped under configs that drop optimizer cardinality estimates
# (test/configs/stats_dependent_tests.json): without estimates every independent
# source reads as empty and the parallel-path assertion below cannot hold.

statement ok
SET threads=4;

statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE TABLE lr8 AS SELECT * FROM (VALUES (-2.0, 0),(-1.0, 0),(0.5, 0),(1.0, 1),(1.5, 1),(2.0, 1)) v(f, y);

# A scan-bearing light branch body: the correlated aggregate re-scans a tiny base table
# every wave. The scan's estimated work is far below the parallelization threshold, so
# every one-row wave must run inline instead of through the parallel event machinery.
query II
WITH RECURSIVE t(b, w, n) USING TRAMPOLINE (b) AS (
	(VALUES (1, 0.0, 0))
	BRANCH 1: (SELECT CASE WHEN n < 20 THEN 1 ELSE 0 END,
	                  w - (SELECT avg((w - y) * f) FROM lr8), n + 1 FROM t)
)
SELECT count(*), max(n) FROM t;
----
1	21

statement ok
CALL disable_logging();

query II
SELECT info.epochs::UBIGINT = 21,
       info.scheduled_workers::UBIGINT = info.epochs::UBIGINT
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalTrampoline' AND event = 'RuntimeMetrics';
----
1	1

query I
SELECT info.workers_max::UBIGINT = 1
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalTrampoline' AND event = 'EpochSummary';
----
1

statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE TABLE big AS SELECT i FROM range(1000000) r(i);

# A branch body that scans a large base table every wave keeps the parallel path:
# the independent source work is estimated above the threshold even though every
# wave carries a single row.
query II
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
	(VALUES (1, 0::BIGINT))
	BRANCH 1: (SELECT CASE WHEN n < 2 THEN 1 ELSE 0 END, n + 1 FROM t
	           UNION ALL SELECT 0, i FROM big WHERE sin(i) > 2)
)
SELECT count(*), max(n) FROM t;
----
1	3

statement ok
CALL disable_logging();

query I
SELECT info.workers_max::UBIGINT > 1
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalTrampoline' AND event = 'EpochSummary';
----
1
