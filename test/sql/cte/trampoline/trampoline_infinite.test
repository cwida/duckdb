# name: test/sql/cte/trampoline/trampoline_infinite.test
# description: Non-terminating trampolines are bounded by max_execution_time
# group: [trampoline]

statement ok
SET max_execution_time = 2000;

# a branch that always routes back to itself never terminates on its own
statement error
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 0)
    BRANCH 1: (SELECT 1, n + 1 FROM t)
)
SELECT * FROM t;
----
<REGEX>:INTERRUPT Error.*

# two branches bouncing a row between each other never terminate either
statement error
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 0)
    BRANCH 1: (SELECT 2, n + 1 FROM t)
    BRANCH 2: (SELECT 1, n + 1 FROM t)
)
SELECT * FROM t;
----
<REGEX>:INTERRUPT Error.*

statement ok
SET max_execution_time = 0;

# partial output stays live: a LIMIT can consume an already emitted row even
# when the remaining trampoline work never emits again
statement ok
SET max_execution_time = 60000;

query I
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT * FROM (VALUES (0, 42), (1, 0)) v(b, n))
    BRANCH 1: (SELECT CASE WHEN n < 100000000 THEN 1 ELSE 0 END, n + 1 FROM t)
)
SELECT n FROM t LIMIT 1;
----
42

# the same holds when the prefix row came from a branch instead of the seed
query I
WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT * FROM (VALUES (2, 42), (1, 0)) v(b, n))
    BRANCH 1: (SELECT CASE WHEN n < 100000000 THEN 1 ELSE 0 END, n + 1 FROM t)
    BRANCH 2: (SELECT 0, n FROM t)
)
SELECT n FROM t LIMIT 1;
----
42

statement ok
SET max_execution_time = 0;
