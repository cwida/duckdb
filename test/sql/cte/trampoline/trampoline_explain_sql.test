# name: test/sql/cte/trampoline/trampoline_explain_sql.test
# description: SQL export of trampoline queries (requires the optimizer)
# group: [trampoline]

# EXPLAIN (SQL) renders an executable representation of a trampoline query
statement ok
EXPLAIN (SQL) WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 7)
    BRANCH 1: (SELECT 0, n FROM t)
)
SELECT n FROM t;

statement ok
EXPLAIN (SQL) WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 1)
    BRANCH 1: (SELECT 0, sum(n)::INT FROM t)
)
SELECT n FROM t;

# a trampoline kept materialized by multiple references exports as an
# unhinted trampoline inside a materialized wrapper
statement ok
EXPLAIN (SQL) WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 7)
    BRANCH 1: (SELECT 0, n FROM t)
)
SELECT a.b, a.n, x.b, x.n FROM t AS a CROSS JOIN t AS x;

# without CTE inlining the export declines with a clear error instead of
# emitting a materialization hint the parser rejects
statement ok
SET disabled_optimizers = 'cte_inlining';

statement error
EXPLAIN (SQL) WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
    (SELECT 1, 7)
    BRANCH 1: (SELECT 0, n FROM t)
)
SELECT b, n FROM t;
----
<REGEX>:Not implemented Error.*trampoline.*

statement ok
SET disabled_optimizers = '';
