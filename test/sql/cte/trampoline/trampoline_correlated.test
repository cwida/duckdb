	WITH RECURSIVE t(b, n) USING TRAMPOLINE (b) AS (
		(SELECT 1, o.k)
		BRANCH 1: (SELECT 0, n FROM t UNION ALL SELECT 0, 99)
	) SELECT n FROM t
) q;
----
