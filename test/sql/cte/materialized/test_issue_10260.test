# name: test/sql/cte/materialized/test_issue_10260.test
# description: Issue #10260: MATERIALIZED causes Binder Error: table has duplicate column name
# group: [materialized]

statement ok
CREATE TABLE T0(C1 INT);

statement ok
CREATE TABLE T1(C1 INT);

statement ok
INSERT INTO T0(C1) VALUES (1);

statement ok
INSERT INTO T1(C1) VALUES (1);

query III
WITH CTE AS MATERIALIZED (
SELECT A1, * FROM T0
  LEFT JOIN (
    SELECT C1 AS A1 FROM T1
  ) ON T0.C1 = A1
) SELECT * FROM CTE;
----
1	1	1

# the CTE has two columns named A1, so the name on its own is ambiguous
statement error
WITH CTE AS MATERIALIZED (
SELECT A1, * FROM T0
  LEFT JOIN (
    SELECT C1 AS A1 FROM T1
  ) ON T0.C1 = A1
) SELECT A1 FROM CTE;
----
<REGEX>:Binder Error: Ambiguous reference to column name "A1".*
