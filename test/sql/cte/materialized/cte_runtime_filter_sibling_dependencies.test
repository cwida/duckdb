# name: test/sql/cte/materialized/cte_runtime_filter_sibling_dependencies.test
# description: Small CTE filter producers finalize independently of sibling builds
# group: [materialized]

statement ok
SET disabled_optimizers='cte_filter_pusher';

statement ok
CREATE TABLE facts AS SELECT i%10000 AS k,i AS v FROM range(200000) t(i);

statement ok
CREATE TABLE dates AS SELECT i AS k,i//10 AS g FROM range(10000) t(i);

statement ok
CREATE TABLE b AS SELECT i AS g FROM range(100,300) t(i);

statement ok
CREATE TABLE c AS SELECT i AS g FROM range(500,700) t(i);

# Bound CTE execution without timing the fixture loads.
statement ok
SET max_execution_time=60000;

statement ok
PREPARE consumers AS
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN b USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;

foreach threads 1 4

statement ok
SET threads={threads};

query II
EXECUTE consumers;
----
3879980000	4039980000

# The complete OR reduces the dimension scan unless depth-first dependencies prevent publication.
# Adaptive filters can admit extra rows at small vector sizes.
query II
EXPLAIN (ANALYZE, FORMAT JSON)
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN b USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*[.]dates"(?:[^}]*"Dynamic Filters": "[^"]* OR [^"]*"[^}]*},\s*"intermediate_rows": [4-9][0-9]{3},|(?:,\s*"(?:Type|Projections|Estimated Cardinality)":\s*(?:"[^"]*"|\[[^]]*\]))+\s*},\s*"intermediate_rows": 10000,).*

# Both UNION inputs must finish before the producer publishes its filter.
query II
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN (FROM b WHERE g<200 UNION ALL FROM b WHERE g>=200) t USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;
----
3879980000	4039980000

# Underestimated non-scan builds still produce the complete filter.
query II
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN (SELECT 100+unnest(range(20000))%200 AS g) t USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;
----
387998000000	403998000000

endloop

statement ok
SET debug_force_external=true;

query II
EXECUTE consumers;
----
3879980000	4039980000

statement ok
RESET debug_force_external;

statement ok
SET max_execution_time=0;

statement ok
DELETE FROM b;

statement ok
SET max_execution_time=60000;

query II
EXECUTE consumers;
----
NULL	NULL

statement ok
SET max_execution_time=0;

statement ok
INSERT INTO b SELECT i FROM range(120,140) t(i);

statement ok
SET max_execution_time=60000;

query II
EXECUTE consumers;
----
385198000	401198000

# Keep the native table on the build side as its estimated size grows.
statement ok
SET memory_limit='512MB';

statement ok
SET disabled_optimizers='cte_filter_pusher,build_side_probe_side';

statement ok
SET max_execution_time=0;

statement ok
CREATE OR REPLACE TABLE facts AS SELECT i%200000 AS k,i AS v FROM range(400000) t(i);

statement ok
CREATE OR REPLACE TABLE dates AS SELECT i AS k,i+100000 AS g FROM range(200000) t(i);

statement ok
CREATE OR REPLACE TABLE b AS SELECT 100100+i AS g FROM range(200) t(i);

statement ok
CREATE OR REPLACE TABLE c AS SELECT i AS g FROM range(100500,100700) t(i);

statement ok
SET max_execution_time=60000;

query II
EXPLAIN (ANALYZE, FORMAT JSON)
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN b USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*[.]dates"(?:[^}]*"Dynamic Filters": "[^"]* OR [^"]*"[^}]*},\s*"intermediate_rows": (?:[4-9][0-9]{2}|[1-9][0-9]{3,4}|1[0-9]{5}),|(?:,\s*"(?:Type|Projections|Estimated Cardinality)":\s*(?:"[^"]*"|\[[^]]*\]))+\s*},\s*"intermediate_rows": 200000,).*

statement ok
SET max_execution_time=0;

statement ok
INSERT INTO b SELECT 100100+i%200 FROM range(999800) t(i);

statement ok
SET max_execution_time=60000;

# At one million rows the producer retains its sibling coordination waits.
query II
WITH p AS MATERIALIZED (SELECT d.g,sum(f.v) v FROM facts f JOIN dates d USING(k) GROUP BY d.g)
SELECT sum(x.v),sum(y.v)
FROM (SELECT p.* FROM p JOIN b USING(g)) x
JOIN (SELECT p.* FROM p JOIN c USING(g)) y ON x.g=y.g-400;
----
200399000000	201199000000

query II
