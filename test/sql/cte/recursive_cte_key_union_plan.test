# name: test/sql/cte/recursive_cte_key_union_plan.test
# description: Physical plans for direct recurring-state probes with USING KEY UNION
# group: [cte]

statement ok
SET threads=1;

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output='physical_only';

# Complete-key probes use the specialized recurring-key join.
query II
EXPLAIN WITH RECURSIVE t(k, total) USING KEY (k, sum(total)) AS (
	SELECT i, 1 FROM range(100) r(i)
	UNION
	SELECT n.k, r.total * 0 + 1
	FROM t n JOIN recurring.t r USING (k)
	WHERE n.total < 3
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_KEY_JOIN.*

# Partial-key probes use the partial recurring-key join.
query II
EXPLAIN WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2, sum(v) AS v) AS (
	VALUES (1, 1, 1)
	UNION
	SELECT n.k1, n.k2 + 1, n.v
	FROM t n JOIN recurring.t r ON r.k1 = n.k1
	WHERE n.k2 < 3
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_PARTIAL_KEY_JOIN.*

# Complete and partial probes normalize collated keys before probing recurring state.
query II
EXPLAIN WITH RECURSIVE t(k, v) USING KEY (k, min(v)) AS (
	SELECT 'a' COLLATE nocase, 2
	UNION
	SELECT n.k, r.v - 1
	FROM t n JOIN recurring.t r USING (k)
	WHERE n.v > 0
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_KEY_JOIN.*

query II
EXPLAIN WITH RECURSIVE t(label, id, v) USING KEY (label, id, min(v)) AS (
	SELECT 'a' COLLATE nocase, 1, 2
	UNION
	SELECT upper(n.label), n.id, r.v - 1
	FROM t n JOIN recurring.t r ON r.label = n.label
	WHERE n.v > 0
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_PARTIAL_KEY_JOIN.*

# Preaggregation and partial-key probes share stable recurring group addresses.
query II
EXPLAIN WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2, min(v)) AS (
	SELECT i, i % 4, 2
	FROM range(current_setting('standard_vector_size')::BIGINT) r(i), range(8) duplicates(_)
	UNION
	SELECT n.k1, n.k2, r.v - 1
	FROM (SELECT t.*, duplicates._ FROM t, range(8) duplicates(_)) n
	JOIN recurring.t r ON r.k1 = n.k1
	WHERE n.v > 0
)
TABLE t;
----
physical_plan	<REGEX>:.*RECURSIVE_PARTIAL_KEY_JOIN.*
