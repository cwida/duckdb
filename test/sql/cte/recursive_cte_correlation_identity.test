# name: test/sql/cte/recursive_cte_correlation_identity.test
# description: CTE row identities determine correlation payloads in nested lookups
# group: [cte]

# Nested lookups must retain per-row state, including duplicate and NULL payloads.
query II
SELECT id, (
    WITH RECURSIVE state USING KEY (k) AS (
        SELECT * FROM (
            SELECT 0 AS k, 3.0::DOUBLE AS v
            UNION ALL
            SELECT i, p.lst[i] FROM unnest(range(1, len(p.lst) + 1)) AS u(i)
        )
        UNION
        SELECT * FROM (
            SELECT 0 AS k, s.v + 1 AS v
            FROM state s
            WHERE s.k = 0 AND s.v <= len(p.lst)
            UNION ALL
            SELECT s.v::INT AS k,
                   (SELECT r.v FROM recurring.state r WHERE r.k = s.v::INT - 1)
                 + (SELECT r.v FROM recurring.state r WHERE r.k = s.v::INT - 2) AS v
            FROM state s
            WHERE s.k = 0 AND s.v <= len(p.lst)
        )
    )
    SELECT v FROM state WHERE k = len(p.lst)
)::BIGINT AS result
FROM (VALUES
    (10, [1, 1, 0, 0, 0, 0]::DOUBLE[]),
    (10, [1, 1, 0, 0, 0, 0]),
    (20, [1, 2, 0, 0, 0, 0]),
    (30, [2, 3, 0]),
    (40, NULL)
) p(id, lst) ORDER BY id;
----
10	8
10	8
20	13
30	5
40	NULL

# Materialized CTE readers use the same identity contract across nested scopes.
query IT
SELECT id, (
    WITH m AS MATERIALIZED (
        SELECT i + coalesce(p.lst[1], 0) AS v FROM range(3) u(i)
    )
    SELECT list((SELECT sum(v) FROM m WHERE v >= q.i) ORDER BY q.i)
    FROM range(4) q(i)
) AS result
FROM (VALUES (1, [1, 2]::INTEGER[]), (2, [1, 2]), (3, [2, 1]), (4, [NULL, 2]), (5, []), (6, NULL)) p(id, lst)
ORDER BY id;
----
1	[6, 6, 5, 3]
2	[6, 6, 5, 3]
3	[9, 9, 9, 7]
4	[3, 3, 2, NULL]
5	[3, 3, 2, NULL]
6	[3, 3, 2, NULL]
