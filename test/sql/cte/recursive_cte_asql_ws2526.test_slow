# name: test/sql/cte/recursive_cte_asql_ws2526.test_slow
# description: Recursive workloads adapted from Advanced SQL WS 2025/26
# group: [cte]

statement ok
SET threads=2;

statement ok
SET max_execution_time=30000;

# CYK parsing with two recursive self-references
statement ok
CREATE TABLE asql_cyk_config(token_count INTEGER, max_iterations INTEGER);

statement ok
INSERT INTO asql_cyk_config VALUES (31, 11);

statement ok
CREATE TABLE asql_cyk_grammar(
	lhs VARCHAR,
	terminal VARCHAR,
	left_symbol VARCHAR,
	right_symbol VARCHAR,
	start_symbol BOOLEAN
);

statement ok
INSERT INTO asql_cyk_grammar VALUES
	('expression', NULL, 'expression', 'sum', true),
	('expression', NULL, 'term', 'product', true),
	('expression', 'n', NULL, NULL, true),
	('term', NULL, 'term', 'product', false),
	('term', 'n', NULL, NULL, false),
	('sum', NULL, 'plus', 'term', false),
	('product', NULL, 'multiply', 'number', false),
	('number', 'n', NULL, NULL, false),
	('plus', '+', NULL, NULL, false),
	('multiply', '*', NULL, NULL, false);

statement ok
CREATE TABLE asql_cyk_tokens(position INTEGER, token VARCHAR);

statement ok
INSERT INTO asql_cyk_tokens
SELECT position::INTEGER + 1,
       CASE
	       WHEN position % 2 = 0 THEN 'n'
	       WHEN (position // 2) % 2 = 0 THEN '+'
	       ELSE '*'
       END
FROM asql_cyk_config, range(token_count) positions(position);

statement ok
SET VARIABLE asql_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_cyk.sql')
);

query IIIT
SELECT * FROM query(getvariable('asql_sql'));
----
212	11	1	c3bfde6e8a8587e43d92d2363461eede

statement ok
SET VARIABLE asql_keyed_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_cyk_using_key.sql')
);

query IIIT
SELECT * FROM query(getvariable('asql_keyed_sql'));
----
212	11	1	c3bfde6e8a8587e43d92d2363461eede

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output='physical_only';

query II
EXPLAIN SELECT * FROM query(getvariable('asql_keyed_sql'));
----
physical_plan	<REGEX>:.*RECURSIVE_PARTIAL_KEY_JOIN.*

# An invalid token must not be accepted.
statement ok
UPDATE asql_cyk_tokens SET token = '?' WHERE position = 16;

query IIIT
SELECT * FROM query(getvariable('asql_sql'));
----
144	11	0	cc5b637f0454f358d342287d818682fa

query IIIT
SELECT * FROM query(getvariable('asql_keyed_sql'));
----
144	7	0	cc5b637f0454f358d342287d818682fa

# One-dimensional diffusion, ordinary and keyed
statement ok
CREATE TABLE asql_fluid_config(width INTEGER, iterations INTEGER, rate DOUBLE);

statement ok
INSERT INTO asql_fluid_config VALUES (64, 60, 0.125);

statement ok
CREATE TABLE asql_fluid_initial(x INTEGER PRIMARY KEY, value DOUBLE);

statement ok
INSERT INTO asql_fluid_initial
SELECT x::INTEGER,
       CASE
	       WHEN x BETWEEN 8 AND 15 THEN 8.0
	       WHEN x BETWEEN 40 AND 51 THEN 5.0
	       ELSE 0.0
       END
FROM asql_fluid_config, range(width) cells(x);

statement ok
SET VARIABLE asql_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_fluid.sql')
);

query IIRRRT
SELECT * FROM query(getvariable('asql_sql'));
----
60	64	124.0	0.010751	5.570112	01e7dfe76b584e74d7b94e6b02ae4675

