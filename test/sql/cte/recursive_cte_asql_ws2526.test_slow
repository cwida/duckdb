CALL enable_logging('PhysicalOperator', storage='memory');

statement ok
CALL truncate_duckdb_logs();

statement ok
SET VARIABLE asql_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_fluid_using_key.sql')
);

query IIRRRT
SELECT * FROM query(getvariable('asql_sql'));
----
60	64	124.0	0.010751	5.570112	01e7dfe76b584e74d7b94e6b02ae4675

statement ok
CALL disable_logging();

query II
SELECT info.final_state_rows::UBIGINT,
       info.retained_build_executions::UBIGINT >= 1
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalRecursiveCTE' AND event = 'RuntimeMetrics';
----
64	1

# The keyed final state is stable in single-threaded execution.
statement ok
SET threads=1;

query IIRRRT
SELECT * FROM query(getvariable('asql_sql'));
----
60	64	124.0	0.010751	5.570112	01e7dfe76b584e74d7b94e6b02ae4675

statement ok
SET threads=2;

# Marching Squares over loop-invariant spatial CTEs
statement ok
CREATE TABLE asql_marching_config(
	width INTEGER,
	height INTEGER,
	min_x INTEGER,
	max_x INTEGER,
	min_y INTEGER,
	max_y INTEGER
);

statement ok
INSERT INTO asql_marching_config VALUES (64, 64, 16, 47, 16, 47);

statement ok
CREATE TABLE asql_marching_map(x INTEGER, y INTEGER, altitude INTEGER, PRIMARY KEY (x, y));

statement ok
INSERT INTO asql_marching_map
SELECT x::INTEGER,
       y::INTEGER,
       CASE
	       WHEN x BETWEEN min_x AND max_x AND y BETWEEN min_y AND max_y THEN 200
	       ELSE 100
       END
FROM asql_marching_config, range(width) xs(x), range(height) ys(y);

statement ok
CREATE TABLE asql_marching_directions(
	lower_left BOOLEAN,
	lower_right BOOLEAN,
	upper_left BOOLEAN,
	upper_right BOOLEAN,
	delta_x INTEGER,
	delta_y INTEGER,
	PRIMARY KEY (lower_left, lower_right, upper_left, upper_right)
);

statement ok
INSERT INTO asql_marching_directions VALUES
	(false, false, false, false, 1, 0),
	(false, false, false, true, 1, 0),
	(false, false, true, false, 0, 1),
	(false, false, true, true, 1, 0),
	(false, true, false, false, 0, -1),
	(false, true, false, true, 0, -1),
	(false, true, true, false, 0, 1),
	(false, true, true, true, 0, -1),
	(true, false, false, false, -1, 0),
	(true, false, false, true, -1, 0),
	(true, false, true, false, 0, 1),
	(true, false, true, true, 1, 0),
	(true, true, false, false, -1, 0),
	(true, true, false, true, -1, 0),
	(true, true, true, false, 0, 1),
	(true, true, true, true, NULL, NULL);

statement ok
CALL enable_logging('PhysicalOperator', storage='memory');

statement ok
CALL truncate_duckdb_logs();

statement ok
SET VARIABLE asql_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_marching_squares.sql')
);

query IIIIIT
SELECT * FROM query(getvariable('asql_sql'));
