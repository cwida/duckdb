statement ok
CALL disable_logging();

# The invariant spatial hash builds are retained across the 128 recursion epochs.
query II
SELECT info.epochs::UBIGINT,
       info.retained_build_executions::UBIGINT >= 1
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalRecursiveCTE' AND event = 'RuntimeMetrics';
----
128	1

# Branching Sudoku search with list-valued state
statement ok
CREATE TABLE asql_sudoku_config(puzzle_count INTEGER);

statement ok
INSERT INTO asql_sudoku_config VALUES (4);

statement ok
CREATE TABLE asql_sudoku_puzzles(puzzle INTEGER PRIMARY KEY, board INTEGER[]);

statement ok
INSERT INTO asql_sudoku_puzzles
SELECT puzzle::INTEGER,
       list(
	       CASE
		       WHEN (position * 17 + 5) % 81 < 24 THEN 0
		       ELSE ((position // 9) * 3 + (position // 9) // 3 + position % 9) % 9 + 1
	       END
	       ORDER BY position
       )::INTEGER[]
FROM asql_sudoku_config,
     range(puzzle_count) puzzles(puzzle),
     range(81) cells(position)
GROUP BY puzzle;

statement ok
SET VARIABLE asql_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/asql_sudoku.sql')
);

query IIT
SELECT * FROM query(getvariable('asql_sql'));
----
4	4	23348c17008a2919983afe2935dcd1df

# A blank with no valid candidate must exhaust its recursive branch.
statement ok
INSERT INTO asql_sudoku_puzzles
SELECT 4,
       list(
	       CASE
		       WHEN position = 0 THEN 0
		       WHEN position = 9 THEN 1
		       ELSE ((position // 9) * 3 + (position // 9) // 3 + position % 9) % 9 + 1
	       END
	       ORDER BY position
       )::INTEGER[]
FROM range(81) cells(position);

query IIT
SELECT * FROM query(getvariable('asql_sql'));
----
4	4	23348c17008a2919983afe2935dcd1df

statement ok
RESET max_execution_time;
