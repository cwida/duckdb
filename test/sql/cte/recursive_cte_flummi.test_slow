# Handwritten USING KEY k-core
statement ok
CREATE TABLE key_nodes(node INTEGER PRIMARY KEY);

statement ok
CREATE TABLE key_edges("from" INTEGER, "to" INTEGER, PRIMARY KEY ("from", "to"));

statement ok
INSERT INTO key_nodes
SELECT (copy * 16 + node)::INTEGER
FROM range(50) copies(copy), range(1, 17) base_nodes(node);

statement ok
INSERT INTO key_edges
SELECT (copy * 16 + base_edge."from")::INTEGER,
       (copy * 16 + base_edge."to")::INTEGER
FROM range(50) copies(copy),
     (VALUES
         (1, 2), (1, 3),
         (2, 3), (2, 9),
         (4, 5), (4, 6), (4, 10), (4, 13),
         (5, 6), (5, 7), (5, 10), (5, 14),
         (6, 7), (6, 8), (6, 9), (6, 11),
         (7, 8),
         (11, 12), (11, 15),
         (15, 16)
     ) AS base_edge("from", "to");

statement ok
INSERT INTO key_edges SELECT "to", "from" FROM key_edges;

statement ok
CREATE VIEW nodes AS SELECT * FROM key_nodes;

statement ok
CREATE VIEW edges AS SELECT * FROM key_edges;

statement ok
SET VARIABLE flummi_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/flummi_k_core_using_key.sql')
);

