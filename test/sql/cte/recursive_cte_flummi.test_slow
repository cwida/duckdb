# name: test/sql/cte/recursive_cte_flummi.test_slow
# description: Generated recursive CTE programs from Flummi
# group: [cte]

statement ok
SET threads=4;

statement ok
SET max_execution_time=30000;

# Counter
statement ok
SET VARIABLE flummi_sql = (SELECT content FROM read_text('benchmark/recursive_cte/queries/smoke/flummi_counter.sql'));

query IIII
SELECT * FROM query(getvariable('flummi_sql'));
----
10	0	9	45

# Breadth-first search, including unreachable nodes and a cycle
statement ok
CREATE TABLE nodes(node INTEGER);

statement ok
INSERT INTO nodes SELECT * FROM range(1, 9);

statement ok
CREATE TABLE edges(here INTEGER, there INTEGER);

statement ok
