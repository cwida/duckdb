# High thread counts must retain the frontier parallelism that the available work can amortize.
statement ok
SET threads=32;

statement ok
CREATE TABLE nodes AS SELECT i::INTEGER id FROM range(120000) nodes(i);

statement ok
CREATE TABLE edges AS
SELECT (i * 2)::INTEGER here,
       (i * 2 + 1)::INTEGER there
FROM range(60000) pairs(i);

statement ok
INSERT INTO edges SELECT there, here FROM edges;

statement ok
INSERT INTO edges SELECT id, id FROM nodes;

statement ok
CALL enable_logging('PhysicalOperator', storage='memory');

statement ok
CALL truncate_duckdb_logs();

