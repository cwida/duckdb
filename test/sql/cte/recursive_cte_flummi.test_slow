# Connected components
statement ok
CREATE TABLE nodes(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE edges(here INTEGER, there INTEGER, PRIMARY KEY (here, there));

statement ok
INSERT INTO nodes SELECT i::INTEGER FROM range(10000) nodes(i);

statement ok
INSERT INTO edges
SELECT (component + here_level * 100)::INTEGER,
       (component + there_level * 100)::INTEGER
FROM range(100) components(component),
     range(100) here_levels(here_level),
     range(100) there_levels(there_level)
WHERE here_level < there_level
  AND ((here_level * 17 + there_level * 31) % 7 = 0
       OR there_level = here_level + 1);

statement ok
INSERT INTO edges SELECT there, here FROM edges;

statement ok
INSERT INTO edges SELECT id, id FROM nodes;

statement ok
SET VARIABLE flummi_sql = (
	SELECT content FROM read_text('benchmark/recursive_cte/queries/performance/flummi_connected_components.sql')
);

