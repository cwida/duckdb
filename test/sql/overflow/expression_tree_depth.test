# name: test/sql/overflow/expression_tree_depth.test
# description: Test handling of deep expression trees
# group: [overflow]

statement ok
CREATE TABLE integers(x INTEGER)

statement ok
SET max_expression_depth=250

# expression tree depth limit exceeded
# Error depends on if PostgreSQL or PEG parser was used
statement error
