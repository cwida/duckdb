# name: test/sql/types/geo/geography_blob_cast.test
# description: Test casting GEOGRAPHY to and from BLOB (WKB)
# group: [geo]

statement ok
create table t1(id INT, g GEOGRAPHY);

statement ok
insert into t1 values
	(1, 'POINT(0 1)'),
	(2, 'LINESTRING Z (0 0 1, 1 1 2)'),
	(3, 'POLYGON M ((0 0 1, 4 0 2, 4 4 3, 0 4 4, 0 0 1))'),
	(4, 'MULTIPOINT ZM ((1 1 1 1), (2 2 2 2))'),
	(5, 'GEOMETRYCOLLECTION(POINT(1 1), LINESTRING(0 0, 1 1))'),
	(6, 'POINT EMPTY'),
	(7, NULL);

# GEOGRAPHY -> BLOB produces the same WKB as ST_AsWKB
query I
select count(*) from t1 where g::BLOB IS NOT DISTINCT FROM ST_AsWKB(g);
----
7

query II
select typeof(g::BLOB), hex(g::BLOB) from t1 where id = 1;
----
BLOB	01010000000000000000000000000000000000F03F

# BLOB -> GEOGRAPHY roundtrip
query III
select id, g::BLOB::GEOGRAPHY, typeof(g::BLOB::GEOGRAPHY) from t1 order by id;
----
1	POINT (0 1)	GEOGRAPHY
2	LINESTRING Z (0 0 1, 1 1 2)	GEOGRAPHY
3	POLYGON M ((0 0 1, 4 0 2, 4 4 3, 0 4 4, 0 0 1))	GEOGRAPHY
4	MULTIPOINT ZM (1 1 1 1, 2 2 2 2)	GEOGRAPHY
5	GEOMETRYCOLLECTION (POINT (1 1), LINESTRING (0 0, 1 1))	GEOGRAPHY
6	POINT EMPTY	GEOGRAPHY
7	NULL	GEOGRAPHY

# Casting matches ST_GeogFromWKB
query I
select count(*) from t1 where g::BLOB::GEOGRAPHY IS NOT DISTINCT FROM ST_GeogFromWKB(g::BLOB);
----
7

# Big endian WKB is normalized to little endian
query II
select '\x00\x00\x00\x00\x01\x3F\xF0\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00'::BLOB::GEOGRAPHY,
	hex('\x00\x00\x00\x00\x01\x3F\xF0\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00'::BLOB::GEOGRAPHY::BLOB);
----
POINT (1 2)	0101000000000000000000F03F0000000000000040

# Casting to a GEOGRAPHY with a CRS
query II
select g, typeof(g) from (select ST_AsWKB('POINT(1 2)'::GEOGRAPHY)::GEOGRAPHY('OGC:CRS84') as g);
----
POINT (1 2)	GEOGRAPHY('OGC:CRS84')

query I
select hex('POINT(1 2)'::GEOGRAPHY('OGC:CRS84')::BLOB);
----
0101000000000000000000F03F0000000000000040

# Invalid WKB
statement error
select '\x01\x02'::BLOB::GEOGRAPHY;
----
Conversion Error: Could not convert BLOB to GEOGRAPHY

statement error
select (ST_AsWKB('POINT(1 2)'::GEOGRAPHY) || ST_AsWKB('POINT(9 9)'::GEOGRAPHY))::GEOGRAPHY;
----
Could not convert BLOB to GEOGRAPHY: Unexpected trailing data at position 21

# Valid WKB outside the canonical GEOGRAPHY ranges is rejected, unlike for GEOMETRY
statement error
select ST_AsWKB('POINT(200 1)'::GEOMETRY)::GEOGRAPHY;
----
Could not convert BLOB to GEOGRAPHY: coordinates are outside the canonical ranges

statement error
select ST_AsWKB('LINESTRING(0 0, 10 95)'::GEOMETRY)::GEOGRAPHY;
----
Could not convert BLOB to GEOGRAPHY: coordinates are outside the canonical ranges

query I
select ST_AsWKB('POINT(200 1)'::GEOMETRY)::GEOMETRY;
----
POINT (200 1)

query II
select TRY_CAST('\x01\x02'::BLOB AS GEOGRAPHY), TRY_CAST(ST_AsWKB('POINT(200 1)'::GEOMETRY) AS GEOGRAPHY);
----
NULL	NULL

query II
select id, TRY_CAST(b AS GEOGRAPHY) from (values
	(1, ST_AsWKB('POINT(1 2)'::GEOGRAPHY)),
	(2, '\x01\x02'::BLOB),
	(3, NULL::BLOB),
	(4, ST_AsWKB('POINT(-181 0)'::GEOMETRY)),
	(5, ST_AsWKB('LINESTRING(170 10, -170 20)'::GEOGRAPHY))) t(id, b)
order by id;
----
1	POINT (1 2)
2	NULL
3	NULL
4	NULL
5	LINESTRING (170 10, -170 20)

# BLOB is not implicitly cast to GEOGRAPHY
statement error
select ST_AsText(ST_AsWKB('POINT(1 2)'::GEOGRAPHY));
----
No function matches

# Storage roundtrip through a BLOB column
statement ok
create table t2 as select id, g::BLOB as b from t1;

query II
select id, b::GEOGRAPHY from t2 order by id;
----
1	POINT (0 1)
2	LINESTRING Z (0 0 1, 1 1 2)
3	POLYGON M ((0 0 1, 4 0 2, 4 4 3, 0 4 4, 0 0 1))
4	MULTIPOINT ZM (1 1 1 1, 2 2 2 2)
5	GEOMETRYCOLLECTION (POINT (1 1), LINESTRING (0 0, 1 1))
6	POINT EMPTY
7	NULL

statement ok
insert into t1 select id + 100, b from t2;

query I
select count(*) from t1 where g IS NOT NULL;
----
12

# Geographies cast through BLOB keep their coverage extent for pruning
statement ok
create table t3 as select ST_AsWKB('LINESTRING(0 45, 90 45)'::GEOGRAPHY)::GEOGRAPHY as g;

query I
select count(*) from t3 where g && 'POINT(45 54)'::GEOGRAPHY;
----
1
