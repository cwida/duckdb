# name: test/sql/types/geo/geometry_blob_cast_invalid_parts.test
# description: Casting WKB to GEOMETRY validates the parts of collections
# group: [geo]

# MULTIPOINT containing a LINESTRING
statement error
SELECT from_hex('0104000000020000000101000000000000000000f03f000000000000004001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f')::GEOMETRY
----
Unexpected geometry type 2 in a collection of type 4

# MULTIPOINT containing a POINT Z
statement error
SELECT from_hex('0104000000020000000101000000000000000000f03f000000000000004001e9030000000000000000f03f00000000000000400000000000000840')::GEOMETRY
----
Geometry has inconsistent Z/M dimensions

# collections nested too deeply
statement error
SELECT from_hex('')::GEOMETRY
----
Geometry exceeds maximum recursion depth of 16

query I
SELECT TRY_CAST(from_hex(x) AS GEOMETRY) IS NULL FROM (VALUES ('0104000000020000000101000000000000000000f03f000000000000004001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f'), ('0104000000020000000101000000000000000000f03f000000000000004001e9030000000000000000f03f00000000000000400000000000000840'), ('')) t(x)
----
true
true
true

statement ok
CREATE TABLE geometries(g GEOMETRY)

statement error
INSERT INTO geometries SELECT from_hex('0104000000020000000101000000000000000000f03f000000000000004001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f')::GEOMETRY
----
Unexpected geometry type 2 in a collection of type 4

query I
SELECT from_hex('0104000000020000000101000000000000000000f03f00000000000000400101000000000000000000f03f0000000000000040')::GEOMETRY
----
MULTIPOINT (1 2, 1 2)

query I
SELECT from_hex('0107000000020000000104000000010000000101000000000000000000f03f000000000000004001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f')::GEOMETRY
----
GEOMETRYCOLLECTION (MULTIPOINT (1 2), LINESTRING (0 0, 1 1))

query I
SELECT from_hex('')::GEOMETRY IS NOT NULL
----
true
