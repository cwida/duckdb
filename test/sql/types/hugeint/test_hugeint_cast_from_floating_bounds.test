# name: test/sql/types/hugeint/test_hugeint_cast_from_floating_bounds.test
# description: Casts from DOUBLE and FLOAT to HUGEINT and UHUGEINT at the bounds of the destination range
# group: [hugeint]

# -2**127 is exactly representable as DOUBLE and FLOAT and is the HUGEINT minimum
query IIII
SELECT CAST(-1.7014118346046923e38::DOUBLE AS HUGEINT),
       TRY_CAST(-1.7014118346046923e38::DOUBLE AS HUGEINT),
       CAST('-1.7014118346046923e38'::FLOAT AS HUGEINT),
       TRY_CAST('-1.7014118346046923e38'::FLOAT AS HUGEINT)
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728

# the minimum round trips through DOUBLE
query I
SELECT CAST('-170141183460469231731687303715884105728'::HUGEINT::DOUBLE AS HUGEINT) = '-170141183460469231731687303715884105728'::HUGEINT
----
true

# the BIGINT and INTEGER minima cast the same way
query II
SELECT CAST(-9223372036854775808::DOUBLE AS BIGINT), CAST(-2147483648::DOUBLE AS INTEGER)
----
-9223372036854775808	-2147483648

# the next double and float above the minimum
query II
SELECT CAST(-1.7014118346046921e38::DOUBLE AS HUGEINT), CAST('-1.7014117331926443e38'::FLOAT AS HUGEINT)
----
-170141183460469212842221372237303250944	-170141173319264429905852091742258462720

# the next double and float below the minimum
statement error
SELECT CAST(-1.7014118346046927e38::DOUBLE AS HUGEINT)
----
Conversion Error: Type DOUBLE with value -1.7014118346046927e+38 can't be cast because the value is out of range for the destination type INT128

statement error
SELECT CAST('-1.7014120374287884e38'::FLOAT AS HUGEINT)
----
out of range for the destination type INT128

query II
SELECT TRY_CAST(-1.7014118346046927e38::DOUBLE AS HUGEINT), TRY_CAST('-1.7014120374287884e38'::FLOAT AS HUGEINT)
----
NULL	NULL

# 2**127 is one above the HUGEINT maximum
statement error
SELECT CAST(1.7014118346046923e38::DOUBLE AS HUGEINT)
----
out of range for the destination type INT128

statement error
SELECT CAST('1.7014118346046923e38'::FLOAT AS HUGEINT)
----
out of range for the destination type INT128

query II
SELECT TRY_CAST(1.7014118346046923e38::DOUBLE AS HUGEINT), TRY_CAST('1.7014118346046923e38'::FLOAT AS HUGEINT)
----
NULL	NULL

# the largest double and float below 2**127
query II
SELECT CAST(1.7014118346046921e38::DOUBLE AS HUGEINT), CAST('1.7014117331926443e38'::FLOAT AS HUGEINT)
----
170141183460469212842221372237303250944	170141173319264429905852091742258462720

# 2**127 and the largest double below it fit UHUGEINT
query III
SELECT CAST(1.7014118346046923e38::DOUBLE AS UHUGEINT), CAST('1.7014118346046923e38'::FLOAT AS UHUGEINT),
       CAST(1.7014118346046921e38::DOUBLE AS UHUGEINT)
----
170141183460469231731687303715884105728	170141183460469231731687303715884105728	170141183460469212842221372237303250944

# the largest double and float below 2**128
query II
SELECT CAST(3.4028236692093843e38::DOUBLE AS UHUGEINT), CAST('3.4028234663852886e38'::FLOAT AS UHUGEINT)
----
340282366920938425684442744474606501888	340282346638528859811704183484516925440

# 2**128 is one above the UHUGEINT maximum; FLOAT cannot hold it, its largest finite value is tested above
statement error
SELECT CAST(3.402823669209385e38::DOUBLE AS UHUGEINT)
----
Conversion Error: Type DOUBLE with value 3.402823669209385e+38 can't be cast because the value is out of range for the destination type UINT128

query I
SELECT TRY_CAST(3.402823669209385e38::DOUBLE AS UHUGEINT)
----
NULL

# the casts round half to even before the range check, so -0.5 rounds to zero and fits UHUGEINT
query IIII
SELECT CAST(-0.0::DOUBLE AS UHUGEINT), CAST(0.0::DOUBLE AS UHUGEINT), CAST(-0.5::DOUBLE AS UHUGEINT), CAST('-0.5'::FLOAT AS UHUGEINT)
----
0	0	0	0

query II
SELECT TRY_CAST(-0.5000000000000001::DOUBLE AS UHUGEINT), TRY_CAST('-0.50000006'::FLOAT AS UHUGEINT)
----
NULL	NULL

statement error
SELECT CAST(-0.5000000000000001::DOUBLE AS UHUGEINT)
----
out of range for the destination type UINT128

statement error
SELECT CAST('-0.50000006'::FLOAT AS UHUGEINT)
----
out of range for the destination type UINT128

query II
SELECT CAST('0.0'::FLOAT AS UHUGEINT), CAST('-0.0'::FLOAT AS UHUGEINT)
----
0	0

query IIII
SELECT CAST(-0.0::DOUBLE AS HUGEINT), CAST(0.0::DOUBLE AS HUGEINT), CAST('-0.0'::FLOAT AS HUGEINT), CAST('0.0'::FLOAT AS HUGEINT)
----
0	0	0	0

# NaN and the infinities raise, and give NULL under TRY_CAST
foreach type DOUBLE FLOAT

foreach target HUGEINT UHUGEINT

foreach value nan inf -inf

statement error
SELECT CAST('{value}'::{type} AS {target})
----
can't be cast because the value is out of range for the destination type

query I
SELECT TRY_CAST('{value}'::{type} AS {target})
----
NULL

endloop

endloop

endloop

# a column with NULLs between the edges
statement ok
CREATE TABLE doubles AS SELECT * FROM (VALUES
    (1, -1.7014118346046923e38::DOUBLE),
    (2, NULL),
    (3, -1.7014118346046927e38::DOUBLE),
    (4, -0.0::DOUBLE),
    (5, 1.7014118346046921e38::DOUBLE),
    (6, NULL),
    (7, 1.7014118346046923e38::DOUBLE),
    (8, 'nan'::DOUBLE)
) t(id, d);

query III
SELECT id, TRY_CAST(d AS HUGEINT), TRY_CAST(d::FLOAT AS HUGEINT) FROM doubles ORDER BY id
----
1	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728
2	NULL	NULL
3	NULL	-170141183460469231731687303715884105728
4	0	0
5	170141183460469212842221372237303250944	NULL
6	NULL	NULL
7	NULL	NULL
8	NULL	NULL

query II
SELECT id, CAST(d AS HUGEINT) FROM doubles WHERE id IN (1, 2, 4, 5) ORDER BY id
----
1	-170141183460469231731687303715884105728
2	NULL
4	0
5	170141183460469212842221372237303250944

statement error
SELECT CAST(d AS HUGEINT) FROM doubles
----
out of range for the destination type INT128

# fill() converts its interpolated DOUBLE back to HUGEINT, which can land on the minimum
query II
SELECT i, fill(x) OVER (ORDER BY i)
FROM (VALUES (1, 0::HUGEINT), (2, '-85070591730234615865843651857942052864'::HUGEINT), (3, NULL)) t(i, x)
ORDER BY i
----
1	0
2	-85070591730234615865843651857942052864
3	-170141183460469231731687303715884105728

query II
SELECT i, fill(x) OVER (ORDER BY i)
FROM (VALUES
    (0::BIGINT, '-170141183460469231731687303715884105728'::HUGEINT),
    (1, NULL),
    (4611686018427387904, '170141183460469231731687303715884105727'::HUGEINT)
) t(i, x)
ORDER BY i
----
0	-170141183460469231731687303715884105728
1	-170141183460469231731687303715884105728
4611686018427387904	170141183460469231731687303715884105727

# between two negative endpoints the offset rounds to -2**127 in DOUBLE, which no longer wraps to the maximum
statement error
SELECT i, fill(x) OVER (ORDER BY i)
FROM (VALUES
    (0::BIGINT, -1::HUGEINT),
    (18014398509481983, NULL),
    (18014398509481984, '-170141183460469231731687303715884105728'::HUGEINT)
) t(i, x)
ORDER BY i
----
Overflow in HUGEINT addition
