<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

# products at and next to the minimum -2**127

# a negative product of magnitude 2**127 is the minimum
query IIII
SELECT (-9223372036854775808)::HUGEINT * 18446744073709551616::HUGEINT,
       18446744073709551616::HUGEINT * (-9223372036854775808)::HUGEINT,
       (-85070591730234615865843651857942052864)::HUGEINT * 2::HUGEINT,
       85070591730234615865843651857942052864::HUGEINT * (-2)::HUGEINT
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	-170141183460469231731687303715884105728

query II
SELECT (-18446744073709551616)::HUGEINT * 9223372036854775808::HUGEINT,
       (-2)::HUGEINT * 85070591730234615865843651857942052864::HUGEINT
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728

# a positive product of magnitude 2**127 overflows
statement error
SELECT (-85070591730234615865843651857942052864)::HUGEINT * (-2)::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT (-9223372036854775808)::HUGEINT * (-18446744073709551616)::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

# one step past the minimum overflows
statement error
SELECT (-85070591730234615865843651857942052865)::HUGEINT * 2::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT (-9223372036854775809)::HUGEINT * 18446744073709551616::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT 18446744073709551616::HUGEINT * (-9223372036854775809)::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT (-9223372036854775808)::HUGEINT * 18446744073709551617::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

# just inside the range on both sides
query IIII
SELECT (-85070591730234615865843651857942052863)::HUGEINT * 2::HUGEINT,
       170141183460469231731687303715884105727::HUGEINT * (-1)::HUGEINT,
       (-1)::HUGEINT * 170141183460469231731687303715884105727::HUGEINT,
       (-170141183460469231731687303715884105727)::HUGEINT * (-1)::HUGEINT
----
-170141183460469231731687303715884105726	-170141183460469231731687303715884105727	-170141183460469231731687303715884105727	170141183460469231731687303715884105727

# the minimum as an operand
query IIII
SELECT (-170141183460469231731687303715884105728)::HUGEINT * 1::HUGEINT,
       1::HUGEINT * (-170141183460469231731687303715884105728)::HUGEINT,
       (-170141183460469231731687303715884105728)::HUGEINT * 0::HUGEINT,
       0::HUGEINT * (-170141183460469231731687303715884105728)::HUGEINT
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728	0	0

statement error
SELECT (-170141183460469231731687303715884105728)::HUGEINT * (-1)::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT (-1)::HUGEINT * (-170141183460469231731687303715884105728)::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

statement error
SELECT (-170141183460469231731687303715884105728)::HUGEINT * 2::HUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

# the non-throwing form
query III
SELECT TRY((-9223372036854775808)::HUGEINT * 18446744073709551616::HUGEINT),
       TRY(85070591730234615865843651857942052864::HUGEINT * 2::HUGEINT),
       TRY((-170141183460469231731687303715884105728)::HUGEINT * (-1)::HUGEINT)
----
-170141183460469231731687303715884105728	NULL	NULL

# through a column with NULLs
statement ok
CREATE TABLE products(a HUGEINT, b HUGEINT);

statement ok
INSERT INTO products VALUES
	(-85070591730234615865843651857942052864, 2),
	(85070591730234615865843651857942052864, -2),
	(-9223372036854775808, 18446744073709551616),
	(NULL, 2),
	(-85070591730234615865843651857942052864, NULL),
	(5, 7);

query I
SELECT a * b FROM products
----
-170141183460469231731687303715884105728
-170141183460469231731687303715884105728
-170141183460469231731687303715884105728
NULL
NULL
35

statement error
SELECT a * (-b) FROM products
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of INT128.*

# DECIMAL(38) stays below 10**38, so a product at the HUGEINT minimum still overflows
statement error
SELECT CAST(-9223372036854775808 AS DECIMAL(38,0)) * CAST(18446744073709551616 AS DECIMAL(38,0))
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of DECIMAL\(38\).*

# UHUGEINT has its own multiplication
query II
SELECT 340282366920938463463374607431768211455::UHUGEINT * 1::UHUGEINT,
       1::UHUGEINT * 340282366920938463463374607431768211455::UHUGEINT
----
340282366920938463463374607431768211455	340282366920938463463374607431768211455

statement error
SELECT 340282366920938463463374607431768211455::UHUGEINT * 2::UHUGEINT
----
<REGEX>:.*Out of Range Error.*Overflow in multiplication of UINT128.*
