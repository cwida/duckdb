# name: test/sql/types/hugeint/hugeint_division.test
# description: Division, modulo, decimal scale-down and text conversion of 128-bit integers
# group: [hugeint]

# signs of // and %
query IIIIIIII
SELECT 7::HUGEINT // 2, -7::HUGEINT // 2, 7::HUGEINT // -2, -7::HUGEINT // -2, 7::HUGEINT % 2, -7::HUGEINT % 2, 7::HUGEINT % -2, -7::HUGEINT % -2
----
3	-3	-3	3	1	-1	1	-1

# values above 64 bits
query IIII
SELECT '85070591730234615865843651857942052869'::HUGEINT // 3, '85070591730234615865843651857942052869'::HUGEINT % 3, -'85070591730234615865843651857942052869'::HUGEINT // 1000000007, -'85070591730234615865843651857942052869'::HUGEINT % 1000000007
----
28356863910078205288614550619314017623	0	-85070591134740477922660306399	-319908076

# divisor above 64 bits
query III
SELECT '170141183460469231731687303715884105727'::HUGEINT // '18446744073709551617'::HUGEINT, '170141183460469231731687303715884105727'::HUGEINT % '18446744073709551617'::HUGEINT, -'170141183460469231731687303715884105727'::HUGEINT // '-18446744073709551617'::HUGEINT
----
9223372036854775807	9223372036854775808	9223372036854775807

# maximum and minimum
query IIIII
SELECT '170141183460469231731687303715884105727'::HUGEINT // 1, '170141183460469231731687303715884105727'::HUGEINT % 10, ('-170141183460469231731687303715884105727'::HUGEINT - 1) // 1, ('-170141183460469231731687303715884105727'::HUGEINT - 1) // 7, ('-170141183460469231731687303715884105727'::HUGEINT - 1) % 7
----
170141183460469231731687303715884105727	7	-170141183460469231731687303715884105728	-24305883351495604533098186245126300818	-2

# dividend smaller than divisor
query II
SELECT 5::HUGEINT // '100000000000000000000'::HUGEINT, -5::HUGEINT % '100000000000000000000'::HUGEINT
----
0	-5

# division by zero
statement error
SELECT 5::HUGEINT // 0::HUGEINT
----
Division by zero

statement error
SELECT 5::HUGEINT % 0::HUGEINT
----
Division by zero

query II
SELECT TRY(5::HUGEINT // 0::HUGEINT), TRY(5::HUGEINT % 0::HUGEINT)
----
NULL	NULL

# minimum modulo -1 is 0: only the division overflows
query I
SELECT ('-170141183460469231731687303715884105727'::HUGEINT - 1) % -1
----
0

# minimum divided by -1
statement error
SELECT ('-170141183460469231731687303715884105727'::HUGEINT - 1) // -1
----
Out of Range Error: Overflow in division of -170141183460469231731687303715884105728 / -1

# decimal scale-down rounds half away from zero
query IIIII
SELECT CAST(2.5::DECIMAL(38, 1) AS DECIMAL(38, 0)), CAST(-2.5::DECIMAL(38, 1) AS DECIMAL(38, 0)), CAST(1.15::DECIMAL(38, 2) AS DECIMAL(38, 1)), CAST(-1.15::DECIMAL(38, 2) AS DECIMAL(38, 1)), CAST(1.14999::DECIMAL(38, 5) AS DECIMAL(38, 1))
----
3	-3	1.2	-1.2	1.1

# decimal scale-down by 10^19 and 10^20
query III
SELECT CAST('1.5000000000000000000'::DECIMAL(38, 19) AS DECIMAL(38, 0)), CAST('-1.50000000000000000000'::DECIMAL(38, 20) AS DECIMAL(38, 0)), CAST('9.5000000000000000000000000000000000000'::DECIMAL(38, 37) AS DECIMAL(38, 0))
----
2	-2	10

# decimal product scaled down
query I
SELECT CAST(CAST('123456.7890123456' AS DECIMAL(28, 10)) * CAST('-98765.432109876543' AS DECIMAL(28, 12)) AS DECIMAL(38, 2))
----
-12193263113.70

# to text at the limits
query III
SELECT CAST('170141183460469231731687303715884105727'::HUGEINT AS VARCHAR), CAST('-170141183460469231731687303715884105727'::HUGEINT - 1 AS VARCHAR), CAST('-99999999999999999999.999999999999999999'::DECIMAL(38, 18) AS VARCHAR)
----
170141183460469231731687303715884105727	-170141183460469231731687303715884105728	-99999999999999999999.999999999999999999

# column inputs (no constant folding); expectations from exact integer arithmetic: the quotient
# truncates toward zero, the remainder has the sign of the dividend
statement ok
CREATE TABLE div_inputs AS SELECT * FROM (VALUES
    (0, '7'::HUGEINT, '2'::HUGEINT),
    (1, '-7'::HUGEINT, '2'::HUGEINT),
    (2, '7'::HUGEINT, '-2'::HUGEINT),
    (3, '-7'::HUGEINT, '-2'::HUGEINT),
    (4, '36893488147419103232'::HUGEINT, '18446744073709551615'::HUGEINT),
    (5, '36893488147419103232'::HUGEINT, '9223372036854775808'::HUGEINT),
    (6, '-1267650600228229401496703193031'::HUGEINT, '18446744073709551617'::HUGEINT),
    (7, '170141183460469231731687303715884105727'::HUGEINT, '18446744073709551615'::HUGEINT),
    (8, '170141183460469231731687303715884105727'::HUGEINT, '-1180591620717411303424'::HUGEINT),
    (9, ('-170141183460469231731687303715884105727'::HUGEINT - 1), '7'::HUGEINT),
    (10, ('-170141183460469231731687303715884105727'::HUGEINT - 1), '-7'::HUGEINT),
    (11, ('-170141183460469231731687303715884105727'::HUGEINT - 1), '18446744073709551616'::HUGEINT),
    (12, ('-170141183460469231731687303715884105727'::HUGEINT - 1), ('-170141183460469231731687303715884105727'::HUGEINT - 1)),
    (13, '5'::HUGEINT, ('-170141183460469231731687303715884105727'::HUGEINT - 1)),
    (14, '-5'::HUGEINT, ('-170141183460469231731687303715884105727'::HUGEINT - 1)),
    (15, '170141183460469231731687303715884105727'::HUGEINT, ('-170141183460469231731687303715884105727'::HUGEINT - 1)),
    (16, '-170141183460469231731687303715884105727'::HUGEINT, ('-170141183460469231731687303715884105727'::HUGEINT - 1)),
    (17, ('-170141183460469231731687303715884105727'::HUGEINT - 1), '170141183460469231731687303715884105727'::HUGEINT),
    (18, '10000000000000000000000000000000000003'::HUGEINT, '1000000000000000000'::HUGEINT),
    (19, '-10000000000000000000000000000000000003'::HUGEINT, '100000000000000'::HUGEINT),
    (20, '3'::HUGEINT, '1000000000000000000000000000000'::HUGEINT),
    (21, '-170141183460469231731687303715884093383'::HUGEINT, '-18446744073709551619'::HUGEINT)) t(id, a, b);

query III
SELECT id, a // b, a % b FROM div_inputs ORDER BY id
----
0	3	1
1	-3	-1
2	-3	1
3	3	-1
4	2	2
5	4	0
6	-68719476735	-18446744004990062536
7	9223372036854775808	9223372036854775807
8	-144115188075855871	1180591620717411303423
9	-24305883351495604533098186245126300818	-2
10	24305883351495604533098186245126300818	-2
11	-9223372036854775808	0
12	1	0
13	0	5
14	0	-5
15	0	170141183460469231731687303715884105727
16	0	-170141183460469231731687303715884105727
17	-1	-1
18	10000000000000000000	3
19	-100000000000000000000000	-3
20	0	3
21	9223372036854775806	-9223372036854763469
