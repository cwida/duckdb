# name: test/sql/types/timestamp/timestamp_time_of_day_overflow.test
# description: Test time of day extraction below the minimum timestamp
# group: [timestamp]

# Values below the minimum timestamp are rejected at construction (#26797),
# so there is no time of day to extract.
statement error
SELECT make_timestamp(-9223372036854775806)::TIME;
----
Conversion Error: Timestamp units out of range
