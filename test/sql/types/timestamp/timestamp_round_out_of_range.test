# name: test/sql/types/timestamp/timestamp_round_out_of_range.test
# description: Rounding timestamps to a lower precision cannot go past the largest timestamp
# group: [timestamp]

statement error
SELECT TIMESTAMP '294247-01-10 04:00:54.775806'::TIMESTAMP_S
----
can't be cast

statement error
SELECT TIMESTAMP '294247-01-10 04:00:54.6'::TIMESTAMP_S::TIMESTAMPTZ
----
can't be cast

query II
SELECT TRY_CAST(TIMESTAMP '294247-01-10 04:00:54.775806' AS TIMESTAMP_S)::VARCHAR, TRY_CAST(TIMESTAMP '294247-01-10 04:00:54.775806' AS TIMESTAMP_MS)
----
NULL	NULL

query II
SELECT TIMESTAMP '294247-01-10 04:00:54.4'::TIMESTAMP_S, TIMESTAMP '2024-01-01 10:00:00.6'::TIMESTAMP_S
----
294247-01-10 04:00:54	2024-01-01 10:00:01

# #28532: CAST of a TIMESTAMP_MS value whose rounding to seconds goes past the
# largest TIMESTAMP used to fail while building the error message
# ("INTERNAL Error: Unrecognized type for ConvertToString INT64") and invalidated the
# database, because ConvertToString/StringCast had no specialization for timestamp_ms_t.
# It must raise a regular Conversion Error, exactly like the TIMESTAMP (us) source.

statement error
SELECT TIMESTAMP_MS '294247-01-10 04:00:54.775'::TIMESTAMP_S
----
can't be cast

# the database must remain usable after the failed cast
query I
SELECT 42
----
42

# the failed ms -> s cast surfaces through TRY_CAST as NULL, and the value is rendered in the error
query II
SELECT TRY_CAST(TIMESTAMP_MS '294247-01-10 04:00:54.775' AS TIMESTAMP_S)::VARCHAR, TRY_CAST(TIMESTAMP_MS '294247-01-10 04:00:54.775' AS TIMESTAMP_S)
----
NULL	NULL

# in-range ms -> s still rounds correctly
query II
SELECT TIMESTAMP_MS '2024-01-01 10:00:00.600'::TIMESTAMP_S, TIMESTAMP_MS '2024-01-01 10:00:00.400'::TIMESTAMP_S
----
2024-01-01 10:00:01	2024-01-01 10:00:00

# TIMESTAMP_MS string rendering works (finite and infinity)
query II
SELECT CAST(TIMESTAMP_MS '2020-05-17 00:00:00.775' AS VARCHAR), CAST(TIMESTAMP_MS 'infinity' AS VARCHAR)
----
2020-05-17 00:00:00.775	infinity
