# The nanoseconds survive borrowing from the microseconds
query II
SELECT '1962-07-31 12:20:48.000000001'::TIMESTAMP_NS + INTERVAL '-1 microsecond',
	'1962-07-31 12:20:48.000000001'::TIMESTAMP_NS - INTERVAL '1 microsecond';
----
1962-07-31 12:20:47.999999001	1962-07-31 12:20:47.999999001

# ms overflow
query I
SELECT '1999-12-31 16:00:00.000000001'::TIMESTAMP_NS + INTERVAL 2400 hours;
----
2000-04-09 16:00:00.000000001

query I
SELECT '2000-04-09 16:00:00.000000001'::TIMESTAMP_NS - INTERVAL 2400 hours;
----
1999-12-31 16:00:00.000000001

# Month arithmetic clamps the day
query II
SELECT '2000-01-31 01:02:03.123456789'::TIMESTAMP_NS + INTERVAL 1 month,
	'2000-03-31 01:02:03.123456789'::TIMESTAMP_NS - INTERVAL 1 month;
----
2000-02-29 01:02:03.123456789	2000-02-29 01:02:03.123456789

# Months before days
query II
SELECT '2000-01-31 01:02:03.123456789'::TIMESTAMP_NS + INTERVAL '-1 month 400 day',
	'2000-01-31 01:02:03.123456789'::TIMESTAMP_NS - INTERVAL '1 month -400 day';
----
2001-02-03 01:02:03.123456789	2001-02-03 01:02:03.123456789

# Non-constant arguments
query I
SELECT make_timestamp_ns(1638366888123456789 + i * 1000000000) + INTERVAL 1 MONTH FROM range(3) t(i);
----
2022-01-01 13:54:48.123456789
2022-01-01 13:54:49.123456789
2022-01-01 13:54:50.123456789

query I
SELECT INTERVAL (-1) MICROSECOND + make_timestamp_ns(-234000000000000000 + i) FROM range(-1, 2) t(i);
----
1962-08-02 15:59:59.999998999
1962-08-02 15:59:59.999999
1962-08-02 15:59:59.999999001

query I
SELECT make_timestamp_ns(-234000000000000000 + i) - INTERVAL 1 MICROSECOND FROM range(-1, 2) t(i);
----
1962-08-02 15:59:59.999998999
1962-08-02 15:59:59.999999
1962-08-02 15:59:59.999999001

# NULLs
query IIIIII
SELECT NULL::TIMESTAMP_NS + INTERVAL 1 day, INTERVAL 1 day + NULL::TIMESTAMP_NS, NULL::TIMESTAMP_NS - INTERVAL 1 day,
	'2021-12-01'::TIMESTAMP_NS + NULL::INTERVAL, NULL::INTERVAL + '2021-12-01'::TIMESTAMP_NS, '2021-12-01'::TIMESTAMP_NS - NULL::INTERVAL;
----
NULL	NULL	NULL	NULL	NULL	NULL

# Infinities
query III
SELECT 'infinity'::TIMESTAMP_NS + INTERVAL '1 microsecond',
	INTERVAL '1 microsecond' + 'infinity'::TIMESTAMP_NS,
	'infinity'::TIMESTAMP_NS - INTERVAL '1 day';
----
infinity	infinity	infinity

query III
SELECT '-infinity'::TIMESTAMP_NS + INTERVAL '1 microsecond',
	INTERVAL '1 microsecond' + '-infinity'::TIMESTAMP_NS,
	'-infinity'::TIMESTAMP_NS - INTERVAL '1 day';
----
-infinity	-infinity	-infinity

#
# Limits testing
#

# The largest finite value is INT64_MAX - 1 (INT64_MAX is infinity),
# and the smallest is INT64_MIN (INT64_MIN + 1 is -infinity)
query II
SELECT make_timestamp_ns(9223372036854775806), make_timestamp_ns(-9223372036854775807::BIGINT - 1);
----
2262-04-11 23:47:16.854775806	1677-09-21 00:12:43.145224192

# Backward from the maximum
query II
SELECT make_timestamp_ns(9223372036854775806) + INTERVAL (-1) microsecond,
	make_timestamp_ns(9223372036854775806) - INTERVAL 1 microsecond;
----
2262-04-11 23:47:16.854774806	2262-04-11 23:47:16.854774806

query II
SELECT make_timestamp_ns(9223372036854775806) + INTERVAL (-1) month,
	make_timestamp_ns(9223372036854775806) - INTERVAL 1 month;
----
2262-03-11 23:47:16.854775806	2262-03-11 23:47:16.854775806

# Forward from the maximum
statement error
SELECT make_timestamp_ns(9223372036854775806) + INTERVAL 1 microsecond;
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT INTERVAL 1 microsecond + make_timestamp_ns(9223372036854775806);
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT make_timestamp_ns(9223372036854775806) + INTERVAL 1 day;
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT make_timestamp_ns(9223372036854775806) - INTERVAL (-1) microsecond;
----
Out of Range Error: Cannot add interval to timestamp_ns

# Forward from the minimum
query II
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) + INTERVAL 1 microsecond,
	make_timestamp_ns(-9223372036854775807::BIGINT - 1) - INTERVAL (-1) microsecond;
----
1677-09-21 00:12:43.145225192	1677-09-21 00:12:43.145225192

query II
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) + INTERVAL 1 month,
	make_timestamp_ns(-9223372036854775807::BIGINT - 1) - INTERVAL (-1) month;
----
1677-10-21 00:12:43.145224192	1677-10-21 00:12:43.145224192

# Backward from the minimum
statement error
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) + INTERVAL (-1) microsecond;
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT INTERVAL (-1) microsecond + make_timestamp_ns(-9223372036854775807::BIGINT - 1);
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) + INTERVAL (-1) month;
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) - INTERVAL 1 microsecond;
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT make_timestamp_ns(-9223372036854775807::BIGINT - 1) - INTERVAL 1 month;
----
Out of Range Error: Cannot add interval to timestamp_ns

# Intervals that overflow the microsecond timestamp range
statement error
SELECT '2000-01-01'::TIMESTAMP_NS + INTERVAL '9223372036854775807 microseconds';
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT '2000-01-01'::TIMESTAMP_NS + INTERVAL '-9223372036854775807 microseconds';
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT '2000-01-01'::TIMESTAMP_NS - INTERVAL '9223372036854775807 microseconds';
----
Out of Range Error: Cannot add interval to timestamp_ns

statement error
SELECT TIMESTAMP_NS '2024-01-01 12:00:00' - INTERVAL '-4611686018427387904 microseconds -4611686018427387904 microseconds';
----
Interval micros value out of range
