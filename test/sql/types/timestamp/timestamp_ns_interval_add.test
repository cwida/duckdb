# name: test/sql/types/timestamp/timestamp_ns_interval_add.test
# description: Test TIMESTAMP_NS +/- INTERVAL arithmetic
# group: [timestamp]

# Quick syntax check
query I
SELECT '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS + INTERVAL 1 DAY;
----
2021-12-02 13:54:48.123456789

# The result keeps the nanosecond precision
query III
SELECT typeof('2021-12-01'::TIMESTAMP_NS + INTERVAL 1 DAY),
	typeof(INTERVAL 1 DAY + '2021-12-01'::TIMESTAMP_NS),
	typeof('2021-12-01'::TIMESTAMP_NS - INTERVAL 1 DAY);
----
TIMESTAMP_NS	TIMESTAMP_NS	TIMESTAMP_NS

# Various intervals
statement ok
CREATE TABLE intervals AS SELECT iv FROM (VALUES
	(INTERVAL 1 year),
	(INTERVAL (-1) year),
	(INTERVAL 1 month),
	(INTERVAL (-1) month),
	(INTERVAL 13 month),
	(INTERVAL (-15) month),
	(INTERVAL 1 day),
	(INTERVAL (-1) day),
	(INTERVAL 32 day),
	(INTERVAL (-40) day),
	(INTERVAL 1 hour),
	(INTERVAL (-1) hour),
	(INTERVAL 11 hour),
	(INTERVAL (-14) hour),
	(INTERVAL 1 minute),
	(INTERVAL (-1) minute),
	(INTERVAL 6 minute),
	(INTERVAL (-72) minute),
	(INTERVAL 1 second),
	(INTERVAL (-1) second),
	(INTERVAL 23 second),
	(INTERVAL (-118) second),
	(INTERVAL 1 millisecond),
	(INTERVAL (-1) millisecond),
	(INTERVAL 910 millisecond),
	(INTERVAL (-150) millisecond),
	(INTERVAL 1 microsecond),
	(INTERVAL (-1) microsecond),
	(INTERVAL 612 microsecond),
	(INTERVAL (-485) microsecond)
) tbl(iv);

# timestamp + interval
query II
SELECT iv, '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS + iv FROM intervals;
----
