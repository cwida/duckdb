# interval + timestamp is commutative
query II
SELECT iv, iv + '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS FROM intervals
WHERE iv + '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS IS DISTINCT FROM '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS + iv;
----

# timestamp - interval
query II
SELECT iv, '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS - iv FROM intervals;
----
1 year	2020-12-01 13:54:48.123456789
-1 year	2022-12-01 13:54:48.123456789
