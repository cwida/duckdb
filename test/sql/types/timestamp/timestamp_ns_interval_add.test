# subtracting an interval is adding its negation
query II
SELECT iv, '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS - iv FROM intervals
WHERE '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS - iv IS DISTINCT FROM '2021-12-01 13:54:48.123456789'::TIMESTAMP_NS + (-iv);
----

# Before the epoch
query II
SELECT iv, '1962-07-31 12:20:48.123456789'::TIMESTAMP_NS + iv FROM intervals;
