# name: test/sql/types/time/time_parsing.test
# description: Test time parsing
# group: [time]

query I
SELECT '14:42:04'::TIME::VARCHAR
----
14:42:04

# microseconds
query I
SELECT '14:42:04.35'::TIME::VARCHAR
----
14:42:04.35

# we support up until microsecond precision (max 0-999999)
query I
SELECT '14:42:04.999999'::TIME::VARCHAR
----
14:42:04.999999

# nanosecond precision gets truncated
query I
SELECT '14:42:04.999999999'::TIME::VARCHAR
----
14:42:04.999999

# trailing zeros get truncated
query I
SELECT '14:42:04.000000'::TIME::VARCHAR
----
14:42:04

query I
SELECT '14:42:04.500'::TIME::VARCHAR
----
14:42:04.5

# out of range
statement error
SELECT '50:42:04.500'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

statement error
SELECT '100:42:04.500'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

statement error
SELECT '14:70:04.500'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

statement error
SELECT '14:100:04.500'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

statement error
SELECT '14:42:70.500'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

# invalid separator
statement error
SELECT '14-42-04'::TIME::VARCHAR
----
<REGEX>:.*Conversion Error.*time field value out of range.*

# strict parsing rejects a single-digit minute at the end of the value, instead of looking past the end of the
# value for a seconds separator. strict parsing is reached via CSV type detection, where the value is followed
# by ':45' in the next column.
foreach value 1:2 123:4 12:3

statement ok
COPY (SELECT '{value}' AS t, ':45' AS s) TO '{TEST_DIR}/strict_time.csv' (DELIMITER '|', HEADER false);

query I
SELECT typeof(column0) FROM read_csv('{TEST_DIR}/strict_time.csv', header = false, delim = '|', auto_type_candidates = ['TIME', 'VARCHAR']);
----
VARCHAR

endloop

# well-formed strict times still parse
foreach value 11:22 11:22:33

statement ok
COPY (SELECT '{value}' AS t, ':45' AS s) TO '{TEST_DIR}/strict_time.csv' (DELIMITER '|', HEADER false);

query I
SELECT typeof(column0) FROM read_csv('{TEST_DIR}/strict_time.csv', header = false, delim = '|', auto_type_candidates = ['TIME', 'VARCHAR']);
----
TIME

endloop
