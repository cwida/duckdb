# name: test/sql/types/bignum/test_double_bignum.test
# description: Test double of bignum type
# group: [bignum]

query I
select ::double::bignum
----



query I
select (-)::double::bignum
----
-


query I
select 33999999014383402399481480781255147520::float::bignum
----
33999999014383402399481480781255147520

query I
select 33999999014383402399481480781255147520::double::bignum
----
33999999014383402399481480781255147520

query I
select  0::double::bignum
----
0

query I
select  (-0)::double::bignum
----
0

query I
select 1::double::bignum
----
1

query I
select 100000::double::bignum
----
100000


query I
select 100000.595::double::bignum
----
100001
