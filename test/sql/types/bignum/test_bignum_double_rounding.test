# name: test/sql/types/bignum/test_bignum_double_rounding.test
# description: BIGNUM to DOUBLE rounds to the nearest double, ties to even, like the conversion of an integer
# group: [bignum]

# values that a double holds exactly come back unchanged
query IIII
SELECT 9007199254740992::BIGNUM::DOUBLE = 9007199254740992::DOUBLE,
       (-9007199254740992)::BIGNUM::DOUBLE = -9007199254740992::DOUBLE,
       18446744073709551616::BIGNUM::DOUBLE = 18446744073709551616::DOUBLE,
       ('1' || repeat('0', 300))::BIGNUM::DOUBLE = 1e300
----
true	true	true	true

# 2^53 + 1 is a tie and rounds to the even neighbour 2^53, 2^53 + 3 rounds to 2^53 + 4
query IIII
SELECT 9007199254740993::BIGNUM::DOUBLE = 9007199254740992::DOUBLE,
       9007199254740995::BIGNUM::DOUBLE = 9007199254740996::DOUBLE,
       (-9007199254740993)::BIGNUM::DOUBLE = -9007199254740992::DOUBLE,
       18014398509481986::BIGNUM::DOUBLE = 18014398509481984::DOUBLE
----
true	true	true	true

# the bytes below the top 64 bits break ties: 2^64 + 2^11 is a tie (rounds down to 2^64), one more rounds up
query III
SELECT (18446744073709551616::BIGNUM + 2048::BIGNUM)::DOUBLE = 18446744073709551616::DOUBLE,
       (18446744073709551616::BIGNUM + 2049::BIGNUM)::DOUBLE = 18446744073709555712::DOUBLE,
       (18446744073709551616::BIGNUM + 2047::BIGNUM)::DOUBLE = 18446744073709551616::DOUBLE
----
true	true	true

# values beyond 64 bits are rounded to nearest, not accumulated byte by byte
query II
SELECT 69827500863905533396944704757::BIGNUM::DOUBLE = 6.982750086390553e+28,
       (-3740935189843246846)::BIGNUM::DOUBLE = -3.7409351898432466e+18
----
true	true

# the largest double, the largest value that still rounds to it, and the first value that overflows
query II
SELECT ::BIGNUM::DOUBLE = 1.7976931348623157e308,
       (::BIGNUM + 9979201547673599058281863565184192830337256302177287707512736212186059459344820328924789827463178505446712234220962476219862189941967968303695858991424157101600028364755428382587688607221814935913266783722719619966654052275604351944444276342240220787535604534378780208211792476151720049639423::BIGNUM)::DOUBLE = 1.7976931348623157e308
----
true	true

statement error
SELECT (::BIGNUM + 9979201547673599058281863565184192830337256302177287707512736212186059459344820328924789827463178505446712234220962476219862189941967968303695858991424157101600028364755428382587688607221814935913266783722719619966654052275604351944444276342240220787535604534378780208211792476151720049639424::BIGNUM)::DOUBLE
----
Could not convert bignum

query I
SELECT TRY_CAST((('1' || repeat('0', 308))::BIGNUM * 2::BIGNUM) AS DOUBLE)
----
NULL
