# name: test/sql/types/bignum/test_bignum_to_integral_cast.test
# description: Test casting BIGNUM to integral types, including HUGEINT/UHUGEINT and overflow handling
# group: [bignum]

query IIII
SELECT 42::BIGNUM::HUGEINT, (-42)::BIGNUM::HUGEINT, 7::BIGNUM::UHUGEINT, 0::BIGNUM::UHUGEINT;
----
42	-42	7	0

query II
SELECT (-1)::BIGNUM::HUGEINT, (-0)::BIGNUM::UTINYINT;
----
-1	0

# limits of the 128-bit types
query IIII
SELECT '170141183460469231731687303715884105727'::BIGNUM::HUGEINT,
       '-170141183460469231731687303715884105728'::BIGNUM::HUGEINT,
       '340282366920938463463374607431768211455'::BIGNUM::UHUGEINT,
       '0'::BIGNUM::UHUGEINT;
----
170141183460469231731687303715884105727	-170141183460469231731687303715884105728	340282366920938463463374607431768211455	0

# limits of the 64-bit types
query IIII
SELECT '9223372036854775807'::BIGNUM::BIGINT, '-9223372036854775808'::BIGNUM::BIGINT,
       '18446744073709551615'::BIGNUM::UBIGINT, '255'::BIGNUM::UTINYINT;
----
9223372036854775807	-9223372036854775808	18446744073709551615	255

# out of range
statement error
SELECT '170141183460469231731687303715884105728'::BIGNUM::HUGEINT;
----
BIGNUM value 170141183460469231731687303715884105728 is out of range

statement error
SELECT '-170141183460469231731687303715884105729'::BIGNUM::HUGEINT;
----
BIGNUM value -170141183460469231731687303715884105729 is out of range

statement error
SELECT '340282366920938463463374607431768211456'::BIGNUM::UHUGEINT;
----
BIGNUM value

statement error
SELECT '9223372036854775808'::BIGNUM::BIGINT;
----
BIGNUM value 9223372036854775808 is out of range

statement error
SELECT '256'::BIGNUM::UTINYINT;
----
BIGNUM value 256 is out of range

# negative values do not fit in unsigned types
statement error
SELECT (-100)::BIGNUM::UTINYINT;
----
BIGNUM value -100 is out of range

statement error
SELECT (-1)::BIGNUM::UHUGEINT;
----
BIGNUM value -1 is out of range

# values with more than 16 bytes must not wrap around
statement error
SELECT '340282366920938463463374607431768211461'::BIGNUM::BIGINT;
----
BIGNUM value

statement error
SELECT ('-' || '340282366920938463463374607431768211461')::BIGNUM::BIGINT;
----
BIGNUM value

statement error
SELECT repeat('9', 60)::BIGNUM::HUGEINT;
----
BIGNUM value

# TRY_CAST returns NULL on overflow
query IIIIII
SELECT TRY_CAST(42::BIGNUM AS HUGEINT), TRY_CAST((-42)::BIGNUM AS UHUGEINT), TRY_CAST(repeat('9', 60)::BIGNUM AS HUGEINT),
       TRY_CAST(repeat('9', 60)::BIGNUM AS BIGINT), TRY_CAST('300'::BIGNUM AS UTINYINT), TRY_CAST('127'::BIGNUM AS TINYINT);
----
42	NULL	NULL	NULL	NULL	127

# per-row overflow
query II
SELECT i, TRY_CAST(b AS INTEGER) FROM (SELECT i, (i::HUGEINT * 1000000000)::BIGNUM AS b FROM range(0, 6) t(i)) ORDER BY i;
----
0	0
1	1000000000
2	2000000000
3	NULL
4	NULL
5	NULL
