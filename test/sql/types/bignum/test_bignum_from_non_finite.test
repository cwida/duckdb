# name: test/sql/types/bignum/test_bignum_from_non_finite.test
# description: Casting non-finite floating point values to BIGNUM fails with a conversion error
# group: [bignum]

statement error
SELECT 'nan'::FLOAT::BIGNUM
----
Conversion Error

statement error
SELECT 'inf'::DOUBLE::BIGNUM
----
Conversion Error

statement ok
CREATE TABLE f AS SELECT * FROM (VALUES ('nan'::FLOAT), (1::FLOAT), ('inf'::FLOAT)) t(x);

query II
SELECT TRY(x::BIGNUM), TRY_CAST(x AS BIGNUM) FROM f
----
NULL	NULL
1	1
NULL	NULL

statement error
SELECT x = 1::BIGNUM FROM f
----
Conversion Error

query II
SELECT 1.5::DOUBLE::BIGNUM, 2::FLOAT::BIGNUM
----
2	2
