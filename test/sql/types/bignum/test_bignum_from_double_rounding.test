# name: test/sql/types/bignum/test_bignum_from_double_rounding.test
# description: DOUBLE and FLOAT cast to BIGNUM round half to even, as the casts to BIGINT and HUGEINT do
# group: [bignum]

query IIIIII
SELECT 1.5::DOUBLE::BIGNUM, 2.5::DOUBLE::BIGNUM, (-1.5)::DOUBLE::BIGNUM, 1.5::DOUBLE::BIGINT, 2.5::DOUBLE::BIGINT, 1.5::DOUBLE::HUGEINT
----
2	2	-2	2	2	2

query IIII
SELECT x, x::BIGINT, x::HUGEINT, x::BIGNUM
FROM (VALUES (0.5::DOUBLE), (1.5), (2.5), (3.5), (-0.5), (-1.5), (-2.5), (-3.5), (0.49999999999999994), (2.7), (-2.7),
             (4503599627370495.5), (-4503599627370495.5), (255.5), (-255.5), (65535.5)) t(x)
----
0.5	0	0	0
1.5	2	2	2
2.5	2	2	2
3.5	4	4	4
-0.5	0	0	0
-1.5	-2	-2	-2
-2.5	-2	-2	-2
-3.5	-4	-4	-4
0.49999999999999994	0	0	0
2.7	3	3	3
-2.7	-3	-3	-3
4503599627370495.5	4503599627370496	4503599627370496	4503599627370496
-4503599627370495.5	-4503599627370496	-4503599627370496	-4503599627370496
255.5	256	256	256
-255.5	-256	-256	-256
65535.5	65536	65536	65536

# rounding up adds a byte to the magnitude
query II
SELECT hex(255.5::DOUBLE::BIGNUM) = hex(256::BIGNUM), hex((-255.5)::DOUBLE::BIGNUM) = hex((-256)::BIGNUM)
----
true	true

query IIII
SELECT x, x::BIGINT, x::HUGEINT, x::BIGNUM
FROM (VALUES (0.5::FLOAT), (1.5), (2.5), (3.5), (-0.5), (-1.5), (-2.5), (-3.5), (2.7), (-2.7), (8388607.5), (-8388607.5)) t(x)
----
0.5	0	0	0
1.5	2	2	2
2.5	2	2	2
3.5	4	4	4
-0.5	0	0	0
-1.5	-2	-2	-2
-2.5	-2	-2	-2
-3.5	-4	-4	-4
2.7	3	3	3
-2.7	-3	-3	-3
8388607.5	8388608	8388608	8388608
-8388607.5	-8388608	-8388608	-8388608

# an input that rounds to zero gives the one BIGNUM zero, whatever its sign
query IIII
SELECT x::BIGNUM, x::BIGNUM = 0::BIGNUM, hex(x::BIGNUM) = hex(0::BIGNUM), x::FLOAT::BIGNUM = 0::BIGNUM
FROM (VALUES (1e-10::DOUBLE), (-1e-10), (-0.3), (-0.5), ('-0.0'::DOUBLE)) t(x)
----
0	true	true	true
0	true	true	true
0	true	true	true
0	true	true	true
0	true	true	true

# values beyond every fixed width integer keep every digit of the double
query I
SELECT x::BIGNUM FROM (VALUES (1e300::DOUBLE), (-1e300), (1.7976931348623157e308), (-1.7976931348623157e308)) t(x)
----

-

-

# large values that HUGEINT or UHUGEINT hold give the same number through them
query IIII
SELECT x::BIGNUM, x::BIGNUM = x::HUGEINT::BIGNUM, (-x)::BIGNUM, (-x)::BIGNUM = (-x)::HUGEINT::BIGNUM
FROM (VALUES (1e30::DOUBLE)) t(x)
----
1000000000000000019884624838656	true	-1000000000000000019884624838656	true

query III
SELECT x::BIGNUM, x::BIGNUM = x::UHUGEINT::BIGNUM, (-x)::BIGNUM
FROM (VALUES (3.4028235e38::FLOAT)) t(x)
----
340282346638528859811704183484516925440	true	-340282346638528859811704183484516925440

statement error
SELECT 'inf'::DOUBLE::BIGNUM
----
Conversion Error

statement error
SELECT '-inf'::DOUBLE::BIGNUM
----
Conversion Error

statement error
SELECT 'nan'::DOUBLE::BIGNUM
----
Conversion Error

statement error
SELECT '-inf'::FLOAT::BIGNUM
----
Conversion Error

query IIII
SELECT TRY_CAST(x AS BIGNUM), TRY_CAST(x AS BIGINT), TRY_CAST(x::FLOAT AS BIGNUM), TRY_CAST(x::FLOAT AS BIGINT)
FROM (VALUES ('inf'::DOUBLE), ('-inf'::DOUBLE), ('nan'::DOUBLE), (2.5::DOUBLE), (NULL::DOUBLE)) t(x)
----
NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL
2	2	2	2
NULL	NULL	NULL	NULL

# a column with NULLs, and the assignment cast of an INSERT into a BIGNUM column
statement ok
CREATE TABLE d AS SELECT * FROM (VALUES (1.5::DOUBLE), (NULL), (-2.5), (NULL), (4503599627370495.5)) t(x)

statement ok
CREATE TABLE b (x BIGNUM)

statement ok
INSERT INTO b SELECT x FROM d

query III
SELECT d.x::BIGNUM, b.x, d.x::HUGEINT FROM d POSITIONAL JOIN b
----
2	2	2
NULL	NULL	NULL
-2	-2	-2
NULL	NULL	NULL
4503599627370496	4503599627370496	4503599627370496

# a DOUBLE or FLOAT inside a VARIANT takes the same cast
query IIII
SELECT (1.5::DOUBLE::VARIANT)::BIGNUM, (2.5::DOUBLE::VARIANT)::BIGNUM, ((-0.3)::DOUBLE::VARIANT)::BIGNUM = 0::BIGNUM, (1.5::FLOAT::VARIANT)::BIGNUM
----
2	2	true	2

# BIGNUM to DOUBLE is unchanged
query IIII
SELECT 2::BIGNUM::DOUBLE, (-3)::BIGNUM::DOUBLE, 1000000000000000019884624838656::BIGNUM::DOUBLE = 1e30::DOUBLE, 9007199254740993::BIGNUM::DOUBLE
----
2.0	-3.0	true	9007199254740992.0
