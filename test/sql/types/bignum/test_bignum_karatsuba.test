# name: test/sql/types/bignum/test_bignum_karatsuba.test
# description: Test BIGNUM multiplication of operands above the Karatsuba threshold
# group: [bignum]

# the kernel multiplies 64-bit limbs and switches from schoolbook to Karatsuba when the shorter operand has 16 limbs,
# i.e. around 308 decimal digits; the values below sit on both sides of that threshold and of its multiples

query I
SELECT repeat('7', 310)::BIGNUM * repeat('3', 305)::BIGNUM
----


query I
SELECT repeat('7', 617)::BIGNUM * repeat('3', 617)::BIGNUM
----


query I
SELECT -(repeat('9', 620)::BIGNUM) * repeat('9', 640)::BIGNUM
----
-

query I
SELECT ''::BIGNUM * '-'::BIGNUM
----
-

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('1234567890', 123)::BIGNUM * repeat('1234567890', 123)::BIGNUM AS p)
----
2459	6c7fb4f4b66d717d239a3f9eb1680be9

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('1234567890', 123)::BIGNUM * -(repeat('9876543210', 125)::BIGNUM) AS p)
----
2481	d37fc5b35a7dac4d2c182fa0a3b4c6d4

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('31415926535897932384', 123)::BIGNUM * repeat('27182818284590452353', 93)::BIGNUM AS p)
----
4319	72fcea0c76b01d8f94b06947262b260e

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('8', 50000)::BIGNUM * repeat('5', 620)::BIGNUM AS p)
----
50620	453f4169e0140c1add852d55c2b0a51b

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('1234567890', 300)::BIGNUM * -(repeat('4', 700)::BIGNUM) AS p)
----
3700	506b08ebd9cb72c5b8cac8111720afbe

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT repeat('2718281828', 4000)::BIGNUM * repeat('1414213562', 4000)::BIGNUM AS p)
----
79999	268cdd8c6ec1ea795d366bf60efc8bad

# powers of 2^64 are built by folding a list; all-ones limbs exercise every carry and borrow
statement ok
CREATE MACRO pow64(k) AS list_reduce(list_transform(range(k), lambda x: '18446744073709551616'::BIGNUM), lambda p, q: p * q);

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT (pow64(32) - 1::BIGNUM) * (pow64(32) - 1::BIGNUM) AS p)
----
1234	80e3b4dc491f76f4926d8d580e25ff80

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT (pow64(33) - 1::BIGNUM) * (pow64(33) - 1::BIGNUM) AS p)
----
1272	a05716aeff1a2afc2c2427bee62c47fa

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT (pow64(40) - 1::BIGNUM) * (pow64(40) - 1::BIGNUM) AS p)
----
1542	33cb393439016aa412cd3bdc19957ff5

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT (pow64(64) - 1::BIGNUM) * (pow64(64) - 1::BIGNUM) AS p)
----
2467	6958768b0b305b0ad197cd2ca34c819d

query II
SELECT length(p::VARCHAR), md5(p::VARCHAR) FROM (SELECT (pow64(65) - 1::BIGNUM) * (pow64(65) - 1::BIGNUM) AS p)
----
2505	b5be5daf5fd52337c8442eca77e9c400

query I
SELECT (pow64(48) - 1::BIGNUM) * (pow64(48) - 1::BIGNUM) = pow64(96) - 2::BIGNUM * pow64(48) + 1::BIGNUM
----
true

query I
SELECT pow64(33) * (pow64(33) - 1::BIGNUM) = pow64(66) - pow64(33)
----
true

query I
SELECT (pow64(32) + 1::BIGNUM) * (pow64(32) - 1::BIGNUM) = pow64(64) - 1::BIGNUM
----
true

# pseudo-random operands of 15 to 17, 30 to 34 and 62 to 66 limbs (290 to 330, 580 to 660 and 1190 to 1280 digits), both signs
statement ok
CREATE MACRO digits(n, s) AS substr(list_aggregate(list_transform(range((n + 19) // 20), lambda x: lpad(hash(s * 1000003 + x)::VARCHAR, 20, '7')), 'string_agg', ''), 1, n);

statement ok
CREATE TABLE pairs AS
SELECT i, n_a, n_b,
       ((CASE WHEN i % 3 = 0 THEN '-' ELSE '' END) || digits(n_a, i))::BIGNUM AS a,
       ((CASE WHEN i % 5 = 0 THEN '-' ELSE '' END) || digits(n_b, i + 1000))::BIGNUM AS b
FROM (SELECT i, (CASE i % 3 WHEN 0 THEN 290 + (i * 7) % 41 WHEN 1 THEN 580 + (i * 7) % 81 ELSE 1190 + (i * 7) % 81 END) AS n_a,
               (CASE (i // 3) % 3 WHEN 0 THEN 290 + (i * 13) % 41 WHEN 1 THEN 580 + (i * 13) % 81 ELSE 1190 + (i * 13) % 81 END) AS n_b FROM range(270) t(i));

query IIIII
SELECT count(*), min(n_a), max(n_a), min(n_b), max(n_b) FROM pairs
----
270	290	1270	290	1268

query I
SELECT count(*) FROM pairs WHERE a * b <> b * a
----
0

query I
SELECT count(*) FROM pairs WHERE (a * b) // b <> a OR (a * b) // a <> b
----
0

query I
SELECT count(*) FROM pairs WHERE (a * b) % a <> 0 OR (a * b) % b <> 0
----
0

query I
SELECT count(*) FROM pairs WHERE (a + 1::BIGNUM) * b <> a * b + b
----
0

query I
SELECT count(*) FROM pairs WHERE (a * b) * a <> a * (b * a)
----
0

# the same products with one operand kept below the threshold agree with the schoolbook path
query I
SELECT count(*) FROM pairs WHERE (a * b) * '123456789012345678901234567890'::BIGNUM <> a * (b * '123456789012345678901234567890'::BIGNUM)
----
0

query II
SELECT length(f::VARCHAR), md5(f::VARCHAR) FROM (SELECT list_reduce(list_transform(range(1, 10001), lambda x: x::BIGNUM), lambda a, b: a * b) AS f)
----
35660	19b7ef180d483270f3acb82f431acd44

query II
SELECT length((f * f)::VARCHAR), md5((f * f)::VARCHAR) FROM (SELECT list_reduce(list_transform(range(1, 10001), lambda x: x::BIGNUM), lambda a, b: a * b) AS f)
----
71319	097de895802b7c26dcbdc394d4511705
