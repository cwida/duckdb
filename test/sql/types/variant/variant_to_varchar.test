# name: test/sql/types/variant/variant_to_varchar.test
# description: Test casting VARIANT values to VARCHAR
# group: [variant]

require json

query I
SELECT '[1, "a", null]'::JSON::VARIANT::VARCHAR
----
[1, a, NULL]

query I
SELECT '["{a}", 1, "x,y", "", " a ", "NULL", "\"q\"", "it''s"]'::JSON::VARIANT::VARCHAR
----
['{a}', 1, 'x,y', '', ' a ', 'NULL', '"q"', 'it\'s']

query I
SELECT '[{"a": 1}, {"a": 1, "b": 2}, {"b": "{x}"}]'::JSON::VARIANT::VARCHAR
----
[{'a': 1}, {'a': 1, 'b': 2}, {'b': '{x}'}]

query I
SELECT '[[1, "a"], [1, 2], [], [null]]'::JSON::VARIANT::VARCHAR
----
[[1, a], [1, 2], [], [NULL]]

query I
SELECT '{"k": [1.5, 2, "z"], "m": [true, 1], "n": {"x y": [[{"q": "c]d"}]]}}'::JSON::VARIANT::VARCHAR
----
{'k': [1.5, 2, z], 'm': [true, 1], 'n': {'x y': [[{'q': 'c]d'}]]}}

# struct names that only differ in case are unified within a list
query I
SELECT '[{"a": 1}, {"A": 1}]'::JSON::VARIANT::VARCHAR
----
[{'a': 1}, {'a': 1}]

query I
SELECT '[[{"a": 1}], [{"A": 2}]]'::JSON::VARIANT::VARCHAR
----
[[{'a': 1}], [{'a': 2}]]

query I
SELECT '[[{"a": 1}], [{"A": [1, "y"]}]]'::JSON::VARIANT::VARCHAR
----
[[{'a': 1}], [{'A': [1, y]}]]

query I
SELECT '[{"a": 1}, {"A": 1}, 3]'::JSON::VARIANT::VARCHAR
----
[{'a': 1}, {'A': 1}, 3]

query I
SELECT '[[{"a": 1}, 2], [{"A": 1}, 2]]'::JSON::VARIANT::VARCHAR
----
[[{'a': 1}, 2], [{'A': 1}, 2]]

# an object with a single empty key becomes a MAP
query I
SELECT '[{"": 1}, {"": 2}]'::JSON::VARIANT::VARCHAR
----
[{''=1}, {''=2}]

query I
SELECT '{"": 1, "b": 2}'::JSON::VARIANT::VARCHAR
----
{'': 1, 'b': 2}

statement error
SELECT '{"b": 1, "B": 2}'::JSON::VARIANT::VARCHAR
----
duplicate name "b" in struct

query I
SELECT [1::VARIANT, NULL::VARIANT, [2, 3]::VARIANT, {'a': 'b c'}::VARIANT, MAP {'k': 1}::VARIANT]::VARIANT::VARCHAR
----
[1, NULL, [2, 3], {'a': b c}, [{'key': k, 'value': 1}]]

query I
SELECT {'x': {'a': 1}::VARIANT, 'y': 'q, r'::VARIANT}::VARIANT::STRUCT(x VARCHAR, y VARCHAR)
----
{'x': '{\'a\': 1}', 'y': 'q, r'}

query I
SELECT [{'a': 1}::VARIANT, 'q, r'::VARIANT, NULL::VARIANT, [{'b': 2}, {'B': 3}]::VARIANT]::VARIANT::VARCHAR[]
----
['{\'a\': 1}', 'q, r', NULL, '[{\'b\': 2}, {\'b\': 3}]']

query I
SELECT (repeat('[', 127) || '1' || repeat(']', 127))::JSON::VARIANT::VARCHAR = repeat('[', 127) || '1' || repeat(']', 127)
----
true

statement error
SELECT (repeat('[', 128) || '1' || repeat(']', 128))::JSON::VARIANT::VARCHAR
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT (repeat('[', 128) || 'null' || repeat(']', 128))::JSON::VARIANT::VARCHAR
----
VARIANT exceeds maximum recursion depth of 128

query I
SELECT {'d': DATE '2024-01-01', 'i': INTERVAL 1 DAY, 'u': '00000000-0000-0000-0000-000000000001'::UUID, 'n': 1.50::DECIMAL(4,2), 'h': 170141183460469231731687303715884105727::HUGEINT}::VARIANT::VARCHAR
----
{'d': 2024-01-01, 'h': 170141183460469231731687303715884105727, 'i': 1 day, 'n': 1.50, 'u': 00000000-0000-0000-0000-000000000001}
