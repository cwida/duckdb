# name: test/sql/types/variant/test_variant_list_copy_shredded.test
# description: Copying from lists of shredded VARIANT values
# group: [variant]

statement ok
CREATE TABLE t AS SELECT [NULL::INT] x FROM range(3000);

query I
SELECT count(list_concat(x::VARIANT[], [])) FROM t;
----
3000

statement ok
CREATE TABLE t2 AS SELECT ['a' || i, NULL] x FROM range(100000) t(i);

query IIIII
SELECT max(length(list_concat(x::VARIANT[], [])::VARCHAR)), max(length(list_resize(x::VARIANT[], 3)::VARCHAR)), max(length(list_append(x::VARIANT[], 1::VARIANT)::VARCHAR)), max(length(list_prepend(1::VARIANT, x::VARIANT[])::VARCHAR)), max(length((x::VARIANT[] || x::VARIANT[])::VARCHAR)) FROM t2;
----
14	20	17	17	28

query I
SELECT list_concat(x::VARIANT[], [42::VARIANT]) FROM t2 WHERE x[1] = 'a99999'
----
[a99999, NULL, 42]
