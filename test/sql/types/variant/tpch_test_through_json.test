# name: test/sql/types/variant/tpch_test_through_json.test
# group: [variant]

require json

set variable sf 0.01

include test/sql/tpch/tpch_setup.test_template

query IIIII
select count(*),
       bool_and(list_sort(json_keys(lineitem::json)) = variant_keys(lineitem::json::variant)),
       bool_and(lineitem::json::variant = lineitem::json::variant::JSON::variant),
       bool_and(lineitem::json::variant::JSON = lineitem::json::variant::JSON::variant::JSON),
       bool_and(json_keys(lineitem::json::variant::JSON) = list_sort(json_keys(lineitem::json)))
from lineitem;
----
60175	true	true	true	true
