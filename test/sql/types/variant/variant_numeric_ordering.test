# name: test/sql/types/variant/variant_numeric_ordering.test
# description: NUMERIC values inside a VARIANT: typed as DECIMAL, ordered and compared by numeric value
# group: [variant]

# a NUMERIC enters a VARIANT as the smallest DECIMAL that holds it
query II
SELECT variant_typeof(('1.5'::NUMERIC)::VARIANT), variant_typeof(('12345678901234567890123456789012345.678'::NUMERIC)::VARIANT);
----
DECIMAL(2, 1)	DECIMAL(38, 3)

# ordering follows the numeric value across representations, up to the full 38 digits
query I
SELECT v::VARCHAR FROM (VALUES
	(('12345678901234567890123456789012345.678'::NUMERIC)::VARIANT),
	(('12345678901234567890123456789012345.677'::NUMERIC)::VARIANT),
	(('-12345678901234567890123456789012345.678'::NUMERIC)::VARIANT),
	((9::NUMERIC)::VARIANT),
	(('1234567890123456789012345678901234560'::NUMERIC)::VARIANT),
	((1.5::DECIMAL(3,1))::VARIANT),
	((1::BIGINT)::VARIANT),
	(('-99999999999999999999999999999999999999999999999999'::BIGNUM)::VARIANT),
	(('100000000000000000000000000000000000000000000000000'::BIGNUM)::VARIANT)) t(v)
ORDER BY v;
----
-99999999999999999999999999999999999999999999999999
-12345678901234567890123456789012345.678
1
1.5
9
12345678901234567890123456789012345.677
12345678901234567890123456789012345.678
1234567890123456789012345678901234560
100000000000000000000000000000000000000000000000000

# equal numbers compare equal whatever representation they came from
query III
SELECT ('1.50'::NUMERIC)::VARIANT = ('1.5'::NUMERIC)::VARIANT, ('1.5'::NUMERIC)::VARIANT = (1.5::DECIMAL(3,1))::VARIANT, (2::NUMERIC)::VARIANT = (2::BIGINT)::VARIANT;
----
true	true	true

# NUMERIC values wider than 38 digits are not supported in VARIANT
statement error
SELECT ('123456789012345678901234567890123456789012345.678'::NUMERIC)::VARIANT;
----
not supported in VARIANT
