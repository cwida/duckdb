# name: test/sql/types/variant/variant_to_map_cast.test
# description: Casting VARIANT to MAP verifies the keys, and TRY_CAST fails per row
# group: [variant]

# rows that fail do not affect the other rows of the vector
query I
SELECT count(TRY_CAST(MAP{'k': i}::VARIANT AS MAP(VARCHAR, TINYINT))) FROM range(129) t(i)
----
128

query II
SELECT i, TRY_CAST(MAP{'k': i}::VARIANT AS MAP(VARCHAR, TINYINT)) FROM range(126, 130) t(i) ORDER BY i
----
126	{k=126}
127	{k=127}
128	NULL
129	NULL

# map keys can not be NULL or duplicated
statement error
SELECT CAST([{'key': NULL, 'value': 1}]::VARIANT AS MAP(VARCHAR, INT))
----
Conversion Error

statement error
SELECT CAST([{'value': 1}]::VARIANT AS MAP(VARCHAR, INT))
----
Conversion Error

statement error
SELECT CAST([{'key': 'a', 'value': 1}, {'key': 'a', 'value': 2}]::VARIANT AS MAP(VARCHAR, INT))
----
Map keys must be unique

query IIII
SELECT TRY_CAST([{'key': 'a', 'value': 1}, {'key': 'a', 'value': 2}]::VARIANT AS MAP(VARCHAR, INT)), TRY_CAST([{'key': NULL, 'value': 1}]::VARIANT AS MAP(VARCHAR, INT)), CAST([{'key': 'a', 'value': 1}, {'key': 'b', 'value': 2}]::VARIANT AS MAP(VARCHAR, INT)), CAST(MAP{'x': 1}::VARIANT AS MAP(VARCHAR, INT))
----
NULL	NULL	{a=1, b=2}	{x=1}

query I
SELECT TRY_CAST(v AS MAP(VARCHAR, TINYINT)) FROM (VALUES (1, MAP{'a': 1}::VARIANT), (2, MAP{'a': 1000}::VARIANT), (3, [{'key': 'b', 'value': 2}, {'key': 'b', 'value': 3}]::VARIANT), (4, MAP{'c': 3}::VARIANT), (5, [{'key': NULL, 'value': 2}]::VARIANT)) t(i, v) ORDER BY i
----
{a=1}
NULL
NULL
{c=3}
NULL

# a NULL entry has no key
query I
SELECT TRY_CAST(x AS MAP(VARCHAR, INT)) FROM (VALUES ([NULL]::VARIANT), (1::VARIANT)) t(x);
----
NULL
NULL

query I
SELECT TRY_CAST(x AS MAP(VARCHAR, INT)) FROM (VALUES ([{'key': 'a', 'value': 1}, NULL]::VARIANT), ([{'key': 'b', 'value': 2}]::VARIANT)) t(x);
----
NULL
{b=2}

statement error
SELECT CAST(x AS MAP(VARCHAR, INT)) FROM (VALUES ([{'key': 'b', 'value': 2}]::VARIANT), ([NULL]::VARIANT)) t(x);
----
Map keys can not be NULL

statement error
SELECT CAST([NULL]::VARIANT AS MAP(VARCHAR, INT))
----
Conversion Error
