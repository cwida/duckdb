# name: test/sql/types/variant/variant_wide_decimal.test
# description: VARIANT holds decimals wider than 38 digits exactly
# group: [variant]

# wide decimal columns need the latest storage version, the configs that force the default one on disk cannot hold them
require no_force_storage

load {TEST_DIR}/variant_wide_decimal.db readwrite v2.1.0

# the widest decimals of this test exceed the default bound of max_decimal_width
statement ok
SET max_decimal_width = 4294967295;

# round trip through VARIANT, the type survives
query III
SELECT v, variant_typeof(v), v::DECIMAL(40,2)
FROM (SELECT '123456789012345678901234567890.12'::DECIMAL(40,2)::VARIANT v);
----
123456789012345678901234567890.12	DECIMAL(40, 2)	123456789012345678901234567890.12

# negative values, zero and the widest decimal
query II
SELECT v::DECIMAL(255,10) = d, variant_typeof(v)
FROM (SELECT d, d::VARIANT v FROM (VALUES
	('-98765432109876543210987654321098765432109876543210.0123456789'::DECIMAL(255,10)),
	('0'::DECIMAL(255,10)),
	(('-' || repeat('9', 245) || '.' || repeat('9', 10))::DECIMAL(255,10)),
	((repeat('9', 245) || '.' || repeat('9', 10))::DECIMAL(255,10))) t(d));
----
true	DECIMAL(255, 10)
true	DECIMAL(255, 10)
true	DECIMAL(255, 10)
true	DECIMAL(255, 10)

# NULLs stay NULL
query II
SELECT v IS NULL, v::DECIMAL(40,2) FROM (SELECT NULL::DECIMAL(40,2)::VARIANT v);
----
true	NULL

# the value is rendered as a number in JSON and in the VARIANT itself
require json

query II
SELECT v::JSON, v::VARCHAR FROM (SELECT '-123456789012345678901234567890.12'::DECIMAL(40,2)::VARIANT v);
----
-123456789012345678901234567890.12	-123456789012345678901234567890.12

# a cast to a different decimal type goes through the value
query I
SELECT v::DECIMAL(45,3) FROM (SELECT '123456789012345678901234567890.12'::DECIMAL(40,2)::VARIANT v);
----
123456789012345678901234567890.120

query I
SELECT v::DOUBLE FROM (SELECT '12345678901234567890.5'::DECIMAL(40,2)::VARIANT v);
----
1.2345678901234567e+19

# extraction from nested values
query II
SELECT variant_extract(v, 'a')::DECIMAL(40,2), variant_typeof(variant_extract(v, 'b')[1])
FROM (SELECT {'a': '123456789012345678901234567890.12'::DECIMAL(40,2), 'b': ['7'::DECIMAL(50,5)]}::VARIANT v);
----
123456789012345678901234567890.12	DECIMAL(50, 5)

# mixed widths in one column
query II
SELECT variant_typeof(v), v::VARCHAR FROM (VALUES
	('1.5'::DECIMAL(40,2)::VARIANT),
	('2.5'::DECIMAL(18,2)::VARIANT),
	('3.5'::DECIMAL(60,3)::VARIANT)) t(v) ORDER BY ALL;
----
DECIMAL(18, 2)	2.50
DECIMAL(40, 2)	1.50
DECIMAL(60, 3)	3.500

# wide decimals compare by value with the other numbers in a VARIANT
query I
SELECT list(v::VARCHAR ORDER BY v) FROM (VALUES
	('100000000000000000000000000000000000000.0'::DECIMAL(40,1)::VARIANT),
	(5::INTEGER::VARIANT),
	('-7.5'::DECIMAL(40,1)::VARIANT),
	('99999999999999999999999999999999999999'::BIGNUM::VARIANT)) t(v);
----
[-7.5, 5, 99999999999999999999999999999999999999, 100000000000000000000000000000000000000.0]

query I
SELECT '10'::DECIMAL(40,2)::VARIANT = 10::INTEGER::VARIANT;
----
true

# digit strings far beyond the inline capacity of the number sort key still order by value
query I
SELECT list(label ORDER BY v) FROM (VALUES
	('huge', repeat('9', 3000)::DECIMAL(4294967295,0)::VARIANT),
	('-huge', ('-' || repeat('9', 3000))::DECIMAL(4294967295,0)::VARIANT),
	('wide', (repeat('7', 200) || '.' || repeat('3', 100))::DECIMAL(300,100)::VARIANT),
	('-wide', ('-' || repeat('7', 200) || '.' || repeat('3', 100))::DECIMAL(300,100)::VARIANT),
	('hugeint', 170141183460469231731687303715884105727::HUGEINT::VARIANT),
	('narrow', '1.5'::DECIMAL(18,2)::VARIANT),
	('int', -2::INTEGER::VARIANT),
	('zero', 0::TINYINT::VARIANT),
	('double', 1e300::DOUBLE::VARIANT)) t(label, v);
----
[-huge, -wide, int, zero, narrow, hugeint, wide, huge, double]

# values that differ only in the last of thousands of digits
query III
SELECT (repeat('9', 2999) || '8')::DECIMAL(4294967295,0)::VARIANT < repeat('9', 3000)::DECIMAL(4294967295,0)::VARIANT,
	repeat('9', 3000)::DECIMAL(4294967295,0)::VARIANT < ('1' || repeat('0', 3000))::DECIMAL(4294967295,0)::VARIANT,
	repeat('9', 3000)::DECIMAL(4294967295,0)::VARIANT = repeat('9', 3000)::DECIMAL(4294967295,0)::VARIANT;
----
true	true	true

# trailing zeros of a long fraction are stripped, so the value compares equal to its narrow forms
query III
SELECT ('1.5' || repeat('0', 99))::DECIMAL(300,100)::VARIANT = '1.5'::DECIMAL(18,2)::VARIANT,
	(repeat('9', 50) || '.' || repeat('0', 100))::DECIMAL(300,100)::VARIANT = repeat('9', 50)::DECIMAL(60,0)::VARIANT,
	(repeat('9', 50) || '.' || repeat('0', 99) || '1')::DECIMAL(300,100)::VARIANT > repeat('9', 50)::DECIMAL(60,0)::VARIANT;
----
true	true	true

# ordering a column of long decimals through VARIANT agrees with ordering the decimals
query I
SELECT list(i ORDER BY v) = list(i ORDER BY d) FROM (
	SELECT i, d, d::VARIANT v FROM (
		SELECT i, ((CASE WHEN i % 3 = 0 THEN '-' ELSE '' END) || repeat(((i * 7) % 9 + 1)::VARCHAR, 40 + i) || '.' || repeat('5', i % 90 + 1))::DECIMAL(300,100) d
		FROM range(100) t(i)));
----
true

# a VARIANT to VARIANT cast keeps the value
query I
SELECT v::VARIANT::DECIMAL(40,2) FROM (SELECT '123456789012345678901234567890.12'::DECIMAL(40,2)::VARIANT v);
----
123456789012345678901234567890.12

# shredded storage: a column of a single wide decimal type is shredded into that type
statement ok
SET variant_minimum_shredding_size = 0;

statement ok
CREATE TABLE t(v VARIANT);

statement ok
INSERT INTO t SELECT (range + 0.25)::DECIMAL(40,2)::VARIANT FROM range(2000);

statement ok
INSERT INTO t VALUES (NULL), ('123456789012345678901234567890.12'::DECIMAL(40,2));

statement ok
CHECKPOINT;

restart

query I
SELECT s.shredding_state FROM (SELECT stats(v) s FROM t LIMIT 1);
----
SHREDDED

query I
SELECT s.fully_shredded.type FROM (SELECT stats(v) s FROM t LIMIT 1);
----
DECIMAL(40,2)

query IIII
SELECT count(*), count(v), min(v::DECIMAL(40,2)), max(v::DECIMAL(40,2)) FROM t;
----
2002	2001	0.25	123456789012345678901234567890.12

query I
SELECT v FROM t WHERE v::DECIMAL(40,2) > '1998.00'::DECIMAL(40,2) ORDER BY ALL;
----
1998.25
1999.25
123456789012345678901234567890.12

query I
SELECT variant_typeof(v) FROM t WHERE v IS NOT NULL LIMIT 1;
----
DECIMAL(40, 2)

# mixed widths are not shredded on a single decimal type
statement ok
CREATE TABLE mixed(v VARIANT);

statement ok
INSERT INTO mixed VALUES ('1.5'::DECIMAL(40,2)), ('2.5'::DECIMAL(10,2)), (3), ('x');

statement ok
CHECKPOINT;

restart

query II
SELECT variant_typeof(v), v::VARCHAR FROM mixed ORDER BY ALL;
----
DECIMAL(10, 2)	2.50
DECIMAL(40, 2)	1.50
INT32	3
VARCHAR	x

# the Parquet VARIANT specification holds decimals of at most 38 digits
require parquet

statement error
COPY (SELECT v FROM t) TO '{TEST_DIR}/variant_wide_decimal.parquet' (FORMAT PARQUET);
----
Parquet VARIANT specification holds decimals of at most 38 digits
