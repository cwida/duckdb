# name: test/sql/types/numeric/postgres_numeric_big.test
# description: PostgreSQL's big numeric regression test (numeric_big.sql) adapted to NUMERIC, within 255 digits
# group: [numeric]

# PostgreSQL's numeric holds up to 131072 digits before and 16383 after the decimal point; NUMERIC tops out at the
# widest DECIMAL, 255 digits. The five values of numeric_big.sql that fit are loaded (ids 0, 2, 6, 7, 8), their
# sums and differences are checked against PostgreSQL's expected results (bc at a scale of 1000), and so are the
# products that fit. The other values and products are rejected with a clear error.

statement ok
CREATE TABLE num_data (id INTEGER, val NUMERIC);

statement ok
CREATE TABLE num_exp_add (id1 INTEGER, id2 INTEGER, expected NUMERIC);

statement ok
CREATE TABLE num_exp_sub (id1 INTEGER, id2 INTEGER, expected NUMERIC);

statement ok
CREATE TABLE num_result (id1 INTEGER, id2 INTEGER, result NUMERIC);

statement ok
