query I
SELECT typeof(val) FROM num_data LIMIT 1;
----
NUMERIC

# values with more than 255 digits are rejected
statement error
INSERT INTO num_data VALUES (1, '85243.');
----
more than the maximum of 255

statement error
INSERT INTO num_data VALUES (3, '-60302029489319384367663884408085757480.');
----
more than the maximum of 255

#----------------------------------------------------------------------------------------------------------------------
# addition and subtraction: every pair fits
#----------------------------------------------------------------------------------------------------------------------
statement ok
DELETE FROM num_result;

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val + t2.val FROM num_data t1, num_data t2;

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result != t2.expected;
----
0

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result = t2.expected;
----
25

query I
SELECT typeof(result) FROM num_result LIMIT 1;
----
NUMERIC

# (the rounded variants of the checks are left out: rounding decimals wider than 38 digits is not supported yet)
statement ok
DELETE FROM num_result;

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val - t2.val FROM num_data t1, num_data t2;

query I
SELECT count(*) FROM num_result t1, num_exp_sub t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result != t2.expected;
----
0

query I
SELECT count(*) FROM num_result t1, num_exp_sub t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result = t2.expected;
----
25

#----------------------------------------------------------------------------------------------------------------------
# multiplication: the result representation is sized from the operand representations, so each value gets its own
# table - a product over the whole column would have to hold every pair. The expected products are compared as
# literals: together they would need 282 digits, more than one column representation holds.
#----------------------------------------------------------------------------------------------------------------------
# each value takes the narrowest representation that holds it, whatever the representation it arrived in
statement ok
CREATE TABLE big_0 AS SELECT val FROM num_data WHERE id = 0;

query I
SELECT typeof(val) FROM big_0;
----
NUMERIC

statement ok
CREATE TABLE big_2 AS SELECT val FROM num_data WHERE id = 2;

query I
SELECT typeof(val) FROM big_2;
----
NUMERIC

statement ok
CREATE TABLE big_6 AS SELECT val FROM num_data WHERE id = 6;

query I
SELECT typeof(val) FROM big_6;
----
NUMERIC

statement ok
CREATE TABLE big_7 AS SELECT val FROM num_data WHERE id = 7;

query I
SELECT typeof(val) FROM big_7;
----
NUMERIC

statement ok
CREATE TABLE big_8 AS SELECT val FROM num_data WHERE id = 8;

query I
SELECT typeof(val) FROM big_8;
----
NUMERIC

query I
SELECT a.val * b.val = '0'::NUMERIC FROM big_0 a, big_0 b;
----
true

