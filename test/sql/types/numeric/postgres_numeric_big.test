# products that need more than 255 digits are rejected when the expression is bound
statement error
SELECT a.val * b.val FROM big_2 a, big_2 b;
----
more than 255 digits

statement error
SELECT a.val * b.val FROM big_2 a, big_6 b;
----
more than 255 digits

statement error
SELECT a.val * b.val FROM big_2 a, big_8 b;
----
more than 255 digits

# values that together need more than 255 digits have no common representation: the column keeps them as
# canonical values (which carry no trailing zeros)
statement ok
CREATE TABLE too_wide (v NUMERIC);

statement ok
