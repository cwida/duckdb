# name: test/sql/types/numeric/numeric_magnitude_overflow.test
# description: NUMERIC values beyond 128 bits do not wrap when cast to HUGEINT or summed
# group: [numeric]

statement ok
CREATE TABLE w(x NUMERIC);

statement ok
INSERT INTO w VALUES ('340282366920938463463374607431768211457'), ('170141183460469231731687303715884105727'), ('-170141183460469231731687303715884105728'), ('99999999999999999999999999999999999999'), ('-99999999999999999999999999999999999999');

# 2^128 + 1 fits neither HUGEINT nor UHUGEINT
query II
SELECT TRY_CAST(x AS HUGEINT), TRY_CAST(x AS UHUGEINT) FROM w ORDER BY x;
----
-170141183460469231731687303715884105728	NULL
-99999999999999999999999999999999999999	NULL
99999999999999999999999999999999999999	99999999999999999999999999999999999999
170141183460469231731687303715884105727	170141183460469231731687303715884105727
NULL	NULL

statement error
SELECT x::HUGEINT FROM w WHERE x > 0 ORDER BY x DESC LIMIT 1;
----
<REGEX>:Conversion Error.*

# the sum of the 38-digit values is exact
query I
SELECT sum(x) FROM w WHERE x BETWEEN -99999999999999999999999999999999999999 AND 99999999999999999999999999999999999999;
----
0

# a sum over 39-digit values is an overflow, not a wrapped value
statement error
SELECT sum(x) FROM w;
----
<REGEX>:Out of Range Error.*

statement error
SELECT sum(x) OVER () FROM w;
----
<REGEX>:Out of Range Error.*
