# the values decide the representation
query I
SELECT typeof(val) FROM num_data LIMIT 1;
----
NUMERIC

#----------------------------------------------------------------------------------------------------------------------
# addition
#----------------------------------------------------------------------------------------------------------------------
statement ok
DELETE FROM num_result;

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val + t2.val FROM num_data t1, num_data t2;

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result != t2.expected;
----
0

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result = t2.expected;
----
100

query I
SELECT typeof(result) FROM num_result LIMIT 1;
----
NUMERIC

statement ok
DELETE FROM num_result;

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val + t2.val, 10) FROM num_data t1, num_data t2;

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result != round(t2.expected, 10);
----
0

query I
SELECT count(*) FROM num_result t1, num_exp_add t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result = round(t2.expected, 10);
----
100

#----------------------------------------------------------------------------------------------------------------------
# subtraction
#----------------------------------------------------------------------------------------------------------------------
statement ok
DELETE FROM num_result;

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val - t2.val FROM num_data t1, num_data t2;

query I
SELECT count(*) FROM num_result t1, num_exp_sub t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result != t2.expected;
----
0

query I
SELECT count(*) FROM num_result t1, num_exp_sub t2 WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2 AND t1.result = t2.expected;
----
100

