# name: test/sql/types/numeric/postgres_numeric.test
# description: PostgreSQL's numeric regression test (src/test/regress/sql/numeric.sql) adapted to NUMERIC
# group: [numeric]

# The expected results of the arithmetic checks are PostgreSQL's, computed with bc(1) at a scale of 200. Division,
# sqrt, ln, log and the variance checks are not adapted: those return DOUBLE here. NaN and infinities are rejected by
# NUMERIC, so the Inf/NaN sections are reduced to that.

statement ok
CREATE TABLE num_data (id INTEGER, val NUMERIC);

statement ok
CREATE TABLE num_exp_add (id1 INTEGER, id2 INTEGER, expected NUMERIC);

statement ok
CREATE TABLE num_exp_sub (id1 INTEGER, id2 INTEGER, expected NUMERIC);

statement ok
CREATE TABLE num_exp_mul (id1 INTEGER, id2 INTEGER, expected NUMERIC);

statement ok
CREATE TABLE num_result (id1 INTEGER, id2 INTEGER, result NUMERIC);

