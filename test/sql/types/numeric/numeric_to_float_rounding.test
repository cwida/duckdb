# name: test/sql/types/numeric/numeric_to_float_rounding.test
# description: A wide DECIMAL or NUMERIC cast to FLOAT or DOUBLE rounds once, to the nearest value
# group: [numeric]

# Results are compared as text, because the test runner accepts a DOUBLE or FLOAT result within a tolerance.

# 1152921573326323713 lies just above the midpoint of two floats: rounding through a DOUBLE first lands on the
# midpoint, which then rounds down to 1.152921504606847e+18 instead of up to 1.1529216420458004e+18
query IIII
SELECT '1152921573326323713'::DECIMAL(40,0)::FLOAT::DOUBLE::VARCHAR,
       '-1152921573326323713'::DECIMAL(40,0)::FLOAT::DOUBLE::VARCHAR,
       '1152921573326323713'::DECIMAL(40,0)::DOUBLE::VARCHAR,
       '-1152921573326323713'::DECIMAL(40,0)::DOUBLE::VARCHAR
----
1.1529216420458004e+18	-1.1529216420458004e+18	1.1529215733263237e+18	-1.1529215733263237e+18

# the same value with a scale
query III
SELECT '1152921573326323713.25'::DECIMAL(40,2)::FLOAT::DOUBLE::VARCHAR,
       '-1152921573326323713.25'::DECIMAL(40,2)::FLOAT::DOUBLE::VARCHAR,
       '1152921573326323713.000000000000000000001'::DECIMAL(45,21)::FLOAT::DOUBLE::VARCHAR
----
1.1529216420458004e+18	-1.1529216420458004e+18	1.1529216420458004e+18

# 2**127 + 2**105 + 2**103 + 1 is a 39-digit value just above a midpoint: a DOUBLE holds the midpoint only
query III
SELECT '170141234166493240860863363584012320769'::DECIMAL(39,0)::FLOAT::DOUBLE::VARCHAR,
       '-170141234166493240860863363584012320769'::DECIMAL(39,0)::FLOAT::DOUBLE::VARCHAR,
       '170141234166493240860863363584012320769'::DECIMAL(39,0)::DOUBLE::VARCHAR
----
1.7014124430769804e+38	-1.7014124430769804e+38	1.7014123416649324e+38

query II
SELECT '0'::DECIMAL(40,0)::FLOAT::VARCHAR, '0.00'::DECIMAL(40,2)::DOUBLE::VARCHAR
----
0.0	0.0

# NUMERIC values, in their canonical form and from a table
statement ok
CREATE TABLE numerics AS
SELECT i, v::NUMERIC AS n
FROM (VALUES
	(1, '1152921573326323713'),
	(2, '-1152921573326323713.25'),
	(3, '1152921573326323713.000000000000000000001'),
	(4, '170141234166493240860863363584012320769'),
	(5, '9007199254740993.000000000000000000000000000000'),
	(6, NULL),
	(7, '0')
) t(i, v);

query III
SELECT i, n::FLOAT::DOUBLE::VARCHAR, n::DOUBLE::VARCHAR FROM numerics ORDER BY i
----
1	1.1529216420458004e+18	1.1529215733263237e+18
2	-1.1529216420458004e+18	-1.1529215733263237e+18
3	1.1529216420458004e+18	1.1529215733263237e+18
4	1.7014124430769804e+38	1.7014123416649324e+38
5	9007199254740992.0	9007199254740992.0
6	NULL	NULL
7	0.0	0.0

query II
SELECT '170141234166493240860863363584012320769'::NUMERIC::FLOAT::DOUBLE::VARCHAR,
       ('1152921573326323713.' || repeat('0', 20) || '1')::NUMERIC::FLOAT::DOUBLE::VARCHAR
----
1.7014124430769804e+38	1.1529216420458004e+18

# the largest value that rounds to the maximum FLOAT, and the first value that does not
query I
SELECT '340282356779733661637539395458142568447'::NUMERIC::FLOAT::DOUBLE::VARCHAR
----
3.4028234663852886e+38

statement error
SELECT '340282356779733661637539395458142568448'::NUMERIC::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

statement error
SELECT ('1' || repeat('0', 44))::NUMERIC::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

statement error
SELECT ('1' || repeat('0', 44))::DECIMAL(45,0)::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

query II
SELECT TRY_CAST('340282356779733661637539395458142568448'::NUMERIC AS FLOAT),
       TRY_CAST(('1' || repeat('0', 44))::DECIMAL(45,0) AS FLOAT)
----
NULL	NULL

statement ok
CREATE TABLE large AS SELECT ('1' || repeat('0', 44))::NUMERIC AS n UNION ALL SELECT 1::NUMERIC

statement error
SELECT n::FLOAT FROM large
----
<REGEX>:Conversion Error.*out of range.*

query I
SELECT TRY_CAST(n AS FLOAT) FROM large ORDER BY 1
----
1.0
NULL

query I
SELECT n::DOUBLE::VARCHAR FROM large ORDER BY 1
----
1.0
1e+44

# small values become subnormal or zero, like a DOUBLE cast to FLOAT
query III
SELECT ('0.' || repeat('0', 44) || '1')::NUMERIC::FLOAT::DOUBLE::VARCHAR,
       ('0.' || repeat('0', 99) || '1')::NUMERIC::FLOAT::VARCHAR,
       ('0.' || repeat('0', 99) || '1')::NUMERIC::DOUBLE::VARCHAR
----
1.401298464324817e-45	0.0	1e-100

# UHUGEINT values: a value beyond the FLOAT range is out of range whatever representation holds it, instead of rounding
# to infinity. The representation a value takes depends on the vector size and on the verification mode, so this file
# asserts the results and numeric_to_float_rounding_representation.test the representations they are computed from
statement ok
CREATE TABLE unsigned AS
SELECT i, v::UHUGEINT AS u
FROM (VALUES
	(1, '340282356779733661637539395458142568447'),
	(2, '340282356779733661637539395458142568448'),
	(3, '340282366920938463463374607431768211455'),
	(4, '170141183460469231731687303715884105727'),
	(5, NULL),
	(6, '1')
) t(i, v);

query III
SELECT i, TRY_CAST(u::NUMERIC AS FLOAT)::DOUBLE::VARCHAR, (u::NUMERIC)::DOUBLE::VARCHAR FROM unsigned ORDER BY i
----
1	3.4028234663852886e+38	3.4028235677973366e+38
2	NULL	3.4028235677973366e+38
3	NULL	3.402823669209385e+38
4	1.7014118346046923e+38	1.7014118346046923e+38
5	NULL	NULL
6	1.0	1.0

statement error
SELECT (u::NUMERIC)::FLOAT FROM unsigned
----
<REGEX>:Conversion Error.*out of range.*

query II
SELECT i, (u::NUMERIC)::FLOAT::DOUBLE::VARCHAR FROM unsigned WHERE i IN (1, 4, 6) ORDER BY i
----
1	3.4028234663852886e+38
4	1.7014118346046923e+38
6	1.0

# the same values through their text, held as a wide decimal, and from a table
query III
SELECT i, TRY_CAST(u::VARCHAR::NUMERIC AS FLOAT)::DOUBLE::VARCHAR, (u::VARCHAR::NUMERIC)::DOUBLE::VARCHAR
FROM unsigned ORDER BY i
----
1	3.4028234663852886e+38	3.4028235677973366e+38
2	NULL	3.4028235677973366e+38
3	NULL	3.402823669209385e+38
4	1.7014118346046923e+38	1.7014118346046923e+38
5	NULL	NULL
6	1.0	1.0

statement ok
CREATE TABLE unsigned_numerics AS SELECT i, u::NUMERIC AS n FROM unsigned;

statement error
SELECT n::FLOAT FROM unsigned_numerics
----
<REGEX>:Conversion Error.*out of range.*

query II
SELECT i, TRY_CAST(n AS FLOAT)::DOUBLE::VARCHAR FROM unsigned_numerics ORDER BY i
----
1	3.4028234663852886e+38
2	NULL
3	NULL
4	1.7014118346046923e+38
5	NULL
6	1.0

query II
SELECT TRY_CAST(n AS FLOAT), TRY_CAST(n::VARCHAR::NUMERIC AS FLOAT)
FROM (SELECT ('340282366920938463463374607431768211455'::UHUGEINT - i::UHUGEINT)::NUMERIC AS n FROM range(2) t(i))
----
NULL	NULL
NULL	NULL

# the HUGEINT range fits a FLOAT
statement ok
CREATE TABLE signed AS
SELECT i, v::HUGEINT AS h
FROM (VALUES
	(1, '170141183460469231731687303715884105727'),
	(2, '-170141183460469231731687303715884105728')
) t(i, v);

query III
SELECT i, (h::NUMERIC)::FLOAT::DOUBLE::VARCHAR, (h::NUMERIC)::DOUBLE::VARCHAR FROM signed ORDER BY i
----
1	1.7014118346046923e+38	1.7014118346046923e+38
2	-1.7014118346046923e+38	-1.7014118346046923e+38

# canonical values: 10^-255 and 10^254 have no common representation, so the table holds canonical values
statement ok
CREATE TABLE canonical AS
SELECT i, v::NUMERIC AS n
FROM (VALUES
	(1, '1e-255'),
	(2, '1e254'),
	(3, '1152921573326323713'),
	(4, '-1152921573326323713.25'),
	(5, '170141234166493240860863363584012320769'),
	(6, '340282356779733661637539395458142568447'),
	(7, '340282356779733661637539395458142568448')
) t(i, v);

query III
SELECT i, TRY_CAST(n AS FLOAT)::DOUBLE::VARCHAR, n::DOUBLE::VARCHAR FROM canonical ORDER BY i
----
1	0.0	1e-255
2	NULL	1e+254
3	1.1529216420458004e+18	1.1529215733263237e+18
4	-1.1529216420458004e+18	-1.1529215733263237e+18
5	1.7014124430769804e+38	1.7014123416649324e+38
6	3.4028234663852886e+38	3.4028235677973366e+38
7	NULL	3.4028235677973366e+38

statement error
SELECT n::FLOAT FROM canonical
----
<REGEX>:Conversion Error.*out of range.*

query II
SELECT i, n::FLOAT::DOUBLE::VARCHAR FROM canonical WHERE i NOT IN (2, 7) ORDER BY i
----
1	0.0
3	1.1529216420458004e+18
4	-1.1529216420458004e+18
5	1.7014124430769804e+38
6	3.4028234663852886e+38
