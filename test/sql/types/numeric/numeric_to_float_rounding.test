# name: test/sql/types/numeric/numeric_to_float_rounding.test
# description: A wide DECIMAL or NUMERIC cast to FLOAT or DOUBLE rounds once, to the nearest value
# group: [numeric]

# Results are compared as text, because the test runner accepts a DOUBLE or FLOAT result within a tolerance.

# 1152921573326323713 lies just above the midpoint of two floats: rounding through a DOUBLE first lands on the
# midpoint, which then rounds down to 1.152921504606847e+18 instead of up to 1.1529216420458004e+18
query IIII
SELECT '1152921573326323713'::DECIMAL(40,0)::FLOAT::DOUBLE::VARCHAR,
       '-1152921573326323713'::DECIMAL(40,0)::FLOAT::DOUBLE::VARCHAR,
       '1152921573326323713'::DECIMAL(40,0)::DOUBLE::VARCHAR,
       '-1152921573326323713'::DECIMAL(40,0)::DOUBLE::VARCHAR
----
1.1529216420458004e+18	-1.1529216420458004e+18	1.1529215733263237e+18	-1.1529215733263237e+18

# the same value with a scale
query III
SELECT '1152921573326323713.25'::DECIMAL(40,2)::FLOAT::DOUBLE::VARCHAR,
       '-1152921573326323713.25'::DECIMAL(40,2)::FLOAT::DOUBLE::VARCHAR,
       '1152921573326323713.000000000000000000001'::DECIMAL(45,21)::FLOAT::DOUBLE::VARCHAR
----
1.1529216420458004e+18	-1.1529216420458004e+18	1.1529216420458004e+18

# 2**127 + 2**105 + 2**103 + 1 is a 39-digit value just above a midpoint: a DOUBLE holds the midpoint only
query III
SELECT '170141234166493240860863363584012320769'::DECIMAL(39,0)::FLOAT::DOUBLE::VARCHAR,
       '-170141234166493240860863363584012320769'::DECIMAL(39,0)::FLOAT::DOUBLE::VARCHAR,
       '170141234166493240860863363584012320769'::DECIMAL(39,0)::DOUBLE::VARCHAR
----
1.7014124430769804e+38	-1.7014124430769804e+38	1.7014123416649324e+38

query II
SELECT '0'::DECIMAL(40,0)::FLOAT::VARCHAR, '0.00'::DECIMAL(40,2)::DOUBLE::VARCHAR
----
0.0	0.0

# NUMERIC values, in their canonical form and from a table
statement ok
CREATE TABLE numerics AS
SELECT i, v::NUMERIC AS n
FROM (VALUES
	(1, '1152921573326323713'),
	(2, '-1152921573326323713.25'),
	(3, '1152921573326323713.000000000000000000001'),
	(4, '170141234166493240860863363584012320769'),
	(5, '9007199254740993.000000000000000000000000000000'),
	(6, NULL),
	(7, '0')
) t(i, v);

query III
SELECT i, n::FLOAT::DOUBLE::VARCHAR, n::DOUBLE::VARCHAR FROM numerics ORDER BY i
----
1	1.1529216420458004e+18	1.1529215733263237e+18
2	-1.1529216420458004e+18	-1.1529215733263237e+18
3	1.1529216420458004e+18	1.1529215733263237e+18
4	1.7014124430769804e+38	1.7014123416649324e+38
5	9007199254740992.0	9007199254740992.0
6	NULL	NULL
7	0.0	0.0

query II
SELECT '170141234166493240860863363584012320769'::NUMERIC::FLOAT::DOUBLE::VARCHAR,
       ('1152921573326323713.' || repeat('0', 20) || '1')::NUMERIC::FLOAT::DOUBLE::VARCHAR
----
1.7014124430769804e+38	1.1529216420458004e+18

# the largest value that rounds to the maximum FLOAT, and the first value that does not
query I
SELECT '340282356779733661637539395458142568447'::NUMERIC::FLOAT::DOUBLE::VARCHAR
----
3.4028234663852886e+38

statement error
SELECT '340282356779733661637539395458142568448'::NUMERIC::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

statement error
SELECT ('1' || repeat('0', 44))::NUMERIC::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

statement error
SELECT ('1' || repeat('0', 44))::DECIMAL(45,0)::FLOAT
----
<REGEX>:Conversion Error.*out of range.*

query II
SELECT TRY_CAST('340282356779733661637539395458142568448'::NUMERIC AS FLOAT),
       TRY_CAST(('1' || repeat('0', 44))::DECIMAL(45,0) AS FLOAT)
----
NULL	NULL

statement ok
CREATE TABLE large AS SELECT ('1' || repeat('0', 44))::NUMERIC AS n UNION ALL SELECT 1::NUMERIC

statement error
SELECT n::FLOAT FROM large
----
<REGEX>:Conversion Error.*out of range.*

query I
SELECT TRY_CAST(n AS FLOAT) FROM large ORDER BY 1
----
1.0
NULL

query I
SELECT n::DOUBLE::VARCHAR FROM large ORDER BY 1
----
1.0
1e+44

# small values become subnormal or zero, like a DOUBLE cast to FLOAT
query III
SELECT ('0.' || repeat('0', 44) || '1')::NUMERIC::FLOAT::DOUBLE::VARCHAR,
       ('0.' || repeat('0', 99) || '1')::NUMERIC::FLOAT::VARCHAR,
       ('0.' || repeat('0', 99) || '1')::NUMERIC::DOUBLE::VARCHAR
----
1.401298464324817e-45	0.0	1e-100
