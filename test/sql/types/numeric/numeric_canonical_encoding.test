# name: test/sql/types/numeric/numeric_canonical_encoding.test
# description: The canonical encoding of every representation orders and compares as numbers
# group: [numeric]

# values around the digit-group and inline-string boundaries of the encoder, in several representations
statement ok
CREATE TABLE v AS SELECT n::NUMERIC AS n, n::VARCHAR AS text FROM (VALUES
	(0::BIGINT), (1), (9), (10), (99), (100), (1000), (9999), (10000), (10001), (99999), (100000), (120000), (1000000),
	(12345678), (123456789), (100000000), (1000000000000), (1234567890123456789), (-1), (-10), (-120000), (-123456789012),
	(9223372036854775807), (-9223372036854775808)) t(n);

statement ok
INSERT INTO v SELECT n, n::VARCHAR FROM (VALUES (1.50::DECIMAL(5,2)), (0.01), (100.10), (-0.50), (12345.60), (0.00)) t(n);

statement ok
INSERT INTO v SELECT n::NUMERIC, n::VARCHAR FROM (VALUES (12345678901234567890::HUGEINT), ('-170141183460469231731687303715884105728'::HUGEINT), (99999999999999999999999999999999999999::HUGEINT)) t(n);

statement ok
INSERT INTO v VALUES ('123456789012345678901234567890123456789012345.5', '123456789012345678901234567890123456789012345.5');

# grouping and sorting go through the canonical blobs: the text of every value survives, the order is numeric
query I
SELECT count(*) FROM (SELECT n, text FROM v GROUP BY ALL) WHERE n::VARCHAR <> CASE WHEN text LIKE '%.%' THEN rtrim(rtrim(text, '0'), '.') ELSE text END AND NOT (text = '-0.50' AND n::VARCHAR = '-0.5') AND NOT (text = '0.00' AND n::VARCHAR = '0');
----
0

query I
SELECT list(n::VARCHAR ORDER BY n) FROM (SELECT n FROM v GROUP BY n);
----
[-170141183460469231731687303715884105728, -9223372036854775808, -123456789012, -120000, -10, -1, -0.5, 0, 0.01, 1, 1.5, 9, 10, 99, 100, 100.1, 1000, 9999, 10000, 10001, 12345.6, 99999, 100000, 120000, 1000000, 12345678, 100000000, 123456789, 1000000000000, 1234567890123456789, 9223372036854775807, 12345678901234567890, 99999999999999999999999999999999999999, 123456789012345678901234567890123456789012345.5]

# equal numbers of different representations are one group
query II
SELECT n, count(*) FROM (SELECT 1::NUMERIC AS n UNION ALL SELECT 1.0::DECIMAL(3,1)::NUMERIC UNION ALL SELECT 1::BIGINT::NUMERIC UNION ALL SELECT 1.00::NUMERIC) GROUP BY n;
----
1	4

query II
SELECT n, count(*) FROM (SELECT 120000::NUMERIC AS n UNION ALL SELECT 120000.0::DECIMAL(8,1)::NUMERIC UNION ALL SELECT 120000::HUGEINT::NUMERIC) GROUP BY n;
----
120000	3

# the canonical order between representations
query I
SELECT list(n::VARCHAR ORDER BY n) FROM (SELECT 10000::NUMERIC AS n UNION ALL SELECT 9999.99::NUMERIC UNION ALL SELECT 10000.01::NUMERIC UNION ALL SELECT -10000::NUMERIC UNION ALL SELECT -9999.99::NUMERIC UNION ALL SELECT 0.0001::NUMERIC UNION ALL SELECT -0.0001::NUMERIC);
----
[-10000, -9999.99, -0.0001, 0.0001, 9999.99, 10000, 10000.01]

# hashing agrees with equality across representations
query I
SELECT hash(1::NUMERIC) = hash(1.0::DECIMAL(3,1)::NUMERIC) AND hash(120000::NUMERIC) = hash(120000::HUGEINT::NUMERIC) AND hash(-0.5::NUMERIC) = hash(-0.50::DECIMAL(4,2)::NUMERIC);
----
true
