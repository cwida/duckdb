# name: test/sql/types/numeric/test_empty_numeric.test
# description: Test NUMERIC without type modifiers
# group: [numeric]

# a bare NUMERIC (with or without empty parentheses) takes the representation of its values
statement ok
CREATE TABLE numerics(i NUMERIC(), j NUMERIC)

statement ok
INSERT INTO numerics VALUES (0176030871715840, 2.2)

query II
SELECT * FROM numerics
----
176030871715840	2.2

query II
SELECT typeof(i), typeof(j) FROM numerics
----
NUMERIC	NUMERIC

# Test cast: exact numbers keep their type, floating point values must be made exact first
query II
SELECT 1.25::NUMERIC, 1.25::NUMERIC()
----
1.25	1.25

query I
SELECT 1.25::FLOAT::NUMERIC
----
1.25

query I
SELECT 1.25::FLOAT::DECIMAL(4,2)::NUMERIC
----
1.25
