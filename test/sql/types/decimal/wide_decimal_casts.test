# name: test/sql/types/decimal/wide_decimal_casts.test
# description: Decimals wider than 38 digits are stored as BIGNUM blobs: type binding and casts
# group: [decimal]

# the type binds up to 255 digits
query II
SELECT typeof('1'::DECIMAL(39,0)), typeof('1'::DECIMAL(255,100))
----
DECIMAL(39,0)	DECIMAL(255,100)

# the width parameter is a UTINYINT, so 256 cannot even be expressed
statement error
SELECT '1'::DECIMAL(256,0)
----
<REGEX>:.*does not accept type parameters.*

statement error
SELECT '1'::DECIMAL(0,0)
----
DECIMAL type width must be between 1 and 255

statement error
SELECT '1'::DECIMAL(50,51)
----
scale cannot be greater than width

# string casts
query I
SELECT '123456789012345678901234567890123456789012345.678'::DECIMAL(50,3)
----
123456789012345678901234567890123456789012345.678

query I
SELECT '-123456789012345678901234567890123456789012345.678'::DECIMAL(50,3)
----
-123456789012345678901234567890123456789012345.678

query IIIIIIIIII
SELECT '.5'::DECIMAL(40,2), '5.'::DECIMAL(40,2), '+7'::DECIMAL(40,2), ' 7 '::DECIMAL(40,2), '1E+2'::DECIMAL(40,2), '1.5e-3'::DECIMAL(40,4), '-0'::DECIMAL(40,2), '0.0049'::DECIMAL(40,2), '-0.005'::DECIMAL(40,2), '999.995'::DECIMAL(40,2)
----
0.50	5.00	7.00	7.00	100.00	0.0015	0.00	0.00	-0.01	1000.00

query I
SELECT '1e40'::DECIMAL(45,2)
----
10000000000000000000000000000000000000000.00

query I
SELECT repeat('9', 255)::DECIMAL(255,0) = -(('-' || repeat('9', 255))::DECIMAL(255,0))
----
true

# strings that do not fit or are not numbers
statement error
SELECT '12345678901234567890123456789012345678901'::DECIMAL(40,0)
----
Could not convert string "12345678901234567890123456789012345678901" to DECIMAL(40,0)

statement error
SELECT 'abc'::DECIMAL(40,2)
----
Could not convert string "abc" to DECIMAL(40,2)

query IIIIII
SELECT TRY_CAST('abc' AS DECIMAL(40,2)), TRY_CAST('1.2.3' AS DECIMAL(40,2)), TRY_CAST('' AS DECIMAL(40,2)), TRY_CAST('1e500' AS DECIMAL(40,2)), TRY_CAST(repeat('9', 39) AS DECIMAL(40,2)), TRY_CAST(repeat('9', 38) AS DECIMAL(40,2))
----
NULL	NULL	NULL	NULL	NULL	99999999999999999999999999999999999999.00

# rescaling between wide decimals rounds half away from zero
query II
SELECT ('123456789012345678901234567890123456789012345.678'::DECIMAL(50,3))::DECIMAL(60,5), ('123456789012345678901234567890123456789012345.678'::DECIMAL(50,3))::DECIMAL(50,1)
----
123456789012345678901234567890123456789012345.67800	123456789012345678901234567890123456789012345.7

query II
SELECT ('-1.5'::DECIMAL(40,1))::DECIMAL(40,0), ('1.5'::DECIMAL(40,1))::DECIMAL(40,0)
----
-2	2

statement error
SELECT ('123456789012345678901234567890123456789012345.678'::DECIMAL(50,3))::DECIMAL(45,3)
----
value is out of range

# fixed-size decimals <-> wide decimals
query IIII
SELECT ('12345.678'::DECIMAL(50,3))::DECIMAL(10,2), (12345.678::DECIMAL(10,3))::DECIMAL(50,5), ('1'::DECIMAL(45,5))::DECIMAL(38,5), typeof(('1'::DECIMAL(45,5))::DECIMAL(38,5))
----
12345.68	12345.67800	1.00000	DECIMAL(38,5)

query I
SELECT TRY_CAST('99999999999999999999999999999999999.5'::DECIMAL(45,1) AS DECIMAL(38,4))
----
NULL

statement error
SELECT ('99999999999999999999999999999999999.5'::DECIMAL(45,1))::DECIMAL(38,4)
----
value is out of range

# integers
query IIII
SELECT 42::DECIMAL(40,2), (-42)::DECIMAL(40,2), 255::UTINYINT::DECIMAL(40,2), true::DECIMAL(45,2)
----
42.00	-42.00	255.00	1.00

query II
SELECT ('170141183460469231731687303715884105727'::HUGEINT)::DECIMAL(45,5), (('170141183460469231731687303715884105727'::HUGEINT)::DECIMAL(45,5))::HUGEINT
----
170141183460469231731687303715884105727.00000	170141183460469231731687303715884105727

query II
SELECT ('-170141183460469231731687303715884105728'::HUGEINT)::DECIMAL(45,5), (('-170141183460469231731687303715884105728'::HUGEINT)::DECIMAL(45,5))::HUGEINT
----
-170141183460469231731687303715884105728.00000	-170141183460469231731687303715884105728

query II
SELECT ('340282366920938463463374607431768211455'::UHUGEINT)::DECIMAL(45,5), (('340282366920938463463374607431768211455'::UHUGEINT)::DECIMAL(45,5))::UHUGEINT
----
340282366920938463463374607431768211455.00000	340282366920938463463374607431768211455

# casting to integers rounds, then range checks
query IIIII
SELECT ('-123.5'::DECIMAL(45,2))::INTEGER, ('123.5'::DECIMAL(45,2))::UINTEGER, ('-12345.678'::DECIMAL(50,3))::BIGINT, TRY_CAST('1e40'::DECIMAL(45,2) AS INTEGER), TRY_CAST('-1'::DECIMAL(45,2) AS UINTEGER)
----
-124	124	-12346	NULL	NULL

statement error
SELECT ('1e40'::DECIMAL(45,2))::BIGINT
----
Failed to cast decimal value 10000000000000000000000000000000000000000.00 to type BIGINT

# floating point: a DOUBLE is converted exactly, so 1e40 shows the binary value of the double
query IIII
SELECT ('123456789012345678901234567890123456789012345.678'::DECIMAL(50,3))::DOUBLE, ('1e30'::DECIMAL(45,2))::FLOAT = 1e30::FLOAT, 1.5::DOUBLE::DECIMAL(40,3), 1e40::DOUBLE::DECIMAL(45,2)
----
1.2345678901234567e+44	true	1.500	10000000000000000303786028427003666890752.00

query I
SELECT TRY_CAST('1e40'::DECIMAL(45,2) AS FLOAT)
----
NULL

statement error
SELECT ('1e200'::DECIMAL(255,2))::FLOAT
----
value is out of range

query I
SELECT TRY_CAST('1e200'::DECIMAL(255,2) AS FLOAT)
----
NULL

query I
SELECT TRY_CAST('inf'::DOUBLE AS DECIMAL(45,2))
----
NULL

# booleans
query II
SELECT ('0.4'::DECIMAL(45,2))::BOOLEAN, ('0'::DECIMAL(45,2))::BOOLEAN
----
true	false

# BIGNUM <-> DECIMAL in both tiers
query IIII
SELECT ('1.5'::DECIMAL(45,2))::BIGNUM, ('-1.5'::DECIMAL(45,2))::BIGNUM, ('1.5'::DECIMAL(10,2))::BIGNUM, ('-1.5'::DECIMAL(10,2))::BIGNUM
----
2	-2	2	-2

query III
SELECT ('12345678901234567890123456789012345678901234567890'::BIGNUM)::DECIMAL(55,3), TRY_CAST('12345678901234567890123456789012345678901234567890'::BIGNUM AS DECIMAL(50,3)), ('123'::BIGNUM)::DECIMAL(10,2)
----
12345678901234567890123456789012345678901234567890.000	NULL	123.00

query I
SELECT TRY_CAST('123456'::BIGNUM AS DECIMAL(5,2))
----
NULL

# varchar round trip and json
query II
SELECT ('-0.001'::DECIMAL(50,3))::VARCHAR, ('5'::DECIMAL(50,3))::VARCHAR
----
-0.001	5.000

query I
SELECT ('123456789012345678901234567890123456789012345.678'::DECIMAL(50,3))::VARCHAR::DECIMAL(50,3) = '123456789012345678901234567890123456789012345.678'::DECIMAL(50,3)
----
true

# the minimum and maximum values of the type
statement ok
CREATE TABLE minmax(d DECIMAL(42,2));

statement ok
INSERT INTO minmax VALUES (repeat('9', 40) || '.99'), ('-' || repeat('9', 40) || '.99');

query II
SELECT min(d), max(d) FROM minmax
----
-9999999999999999999999999999999999999999.99	9999999999999999999999999999999999999999.99

statement error
INSERT INTO minmax VALUES ('1' || repeat('0', 40))
----
Could not convert string

# wide decimals in nested types
query I
SELECT [d, NULL] FROM minmax ORDER BY d LIMIT 1
----
[-9999999999999999999999999999999999999999.99, NULL]
