# name: test/sql/types/decimal/wide_decimal_literals.test
# description: Unquoted decimal literals wider than 38 digits are exact wide decimals
# group: [decimal]

# 39, 50 and 255 digits
query III
SELECT typeof(12345678901234567890123456789012345678.5), typeof(1234567890123456789012345678901234567890.0123456789), typeof(1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45)
----
DECIMAL(39,1)	DECIMAL(50,10)	DECIMAL(255,2)

# every digit is kept
query III
SELECT 12345678901234567890123456789012345678.5, 1234567890123456789012345678901234567890.0123456789, 1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45
----
12345678901234567890123456789012345678.5	1234567890123456789012345678901234567890.0123456789	1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45

# negative literals
query II
SELECT typeof(-12345678901234567890123456789012345678.5), -12345678901234567890123456789012345678.5
----
DECIMAL(39,1)	-12345678901234567890123456789012345678.5

query II
SELECT typeof(-1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45), -1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45
----
DECIMAL(255,2)	-1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45

# underscores do not count towards the width
query II
SELECT typeof(1_234_567_890_123_456_789_012_345_678_901_234_567_890.5), 1_234_567_890_123_456_789_012_345_678_901_234_567_890.5
----
DECIMAL(41,1)	1234567890123456789012345678901234567890.5

query II
SELECT typeof(-1_234_567_890_123_456_789_012_345_678_901_234_567_890.12_5), -1_234_567_890_123_456_789_012_345_678_901_234_567_890.12_5
----
DECIMAL(43,3)	-1234567890123456789012345678901234567890.125

# a cast of the literal is exact as well
query II
SELECT 123456789012345678901234567890123456789.5::DECIMAL(50,2), typeof(123456789012345678901234567890123456789.5::DECIMAL(50,2))
----
123456789012345678901234567890123456789.50	DECIMAL(50,2)

query I
SELECT 123456789012345678901234567890123456789.5::DECIMAL(40,0)
----
123456789012345678901234567890123456790

# arithmetic between literals
query II
SELECT 12345678901234567890123456789012345678.5 + 12345678901234567890123456789012345678.5, typeof(12345678901234567890123456789012345678.5 + 12345678901234567890123456789012345678.5)
----
24691357802469135780246913578024691357.0	DECIMAL(40,1)

query II
SELECT 12345678901234567890123456789012345678.5 - 12345678901234567890123456789012345678.25, 12345678901234567890123456789012345678.5 * 2
----
0.25	24691357802469135780246913578024691357.0

query II
SELECT 12345678901234567890123456789012345678.5 * 1234567890123456789012345678901234567890.0123456789, typeof(12345678901234567890123456789012345678.5 * 1234567890123456789012345678901234567890.0123456789)
----
15241578753238836750495351562566681944511659817363496419058832495117131534832.88256363365	DECIMAL(89,11)

query I
SELECT 12345678901234567890123456789012345678.5 % 7
----
2.5

# literals in comparisons against a wide decimal column
statement ok
CREATE TABLE t(w DECIMAL(50,2))

statement ok
INSERT INTO t VALUES (123456789012345678901234567890123456789.50), (1.50), (-123456789012345678901234567890123456789.50), (NULL)

query I
SELECT w FROM t WHERE w = 123456789012345678901234567890123456789.5
----
123456789012345678901234567890123456789.50

query I
SELECT w FROM t WHERE w > 123456789012345678901234567890123456789.49 OR w < -123456789012345678901234567890123456789.49 ORDER BY w
----
-123456789012345678901234567890123456789.50
123456789012345678901234567890123456789.50

query I
SELECT count(*) FROM t WHERE w BETWEEN -12345678901234567890123456789012345678.5 AND 12345678901234567890123456789012345678.5
----
1

# the literal text survives views, macros and prepared statements
statement ok
CREATE VIEW v AS SELECT 12345678901234567890123456789012345678.5 AS x, -1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45 AS y

query IIII
SELECT typeof(x), x, typeof(y), y FROM v
----
DECIMAL(39,1)	12345678901234567890123456789012345678.5	DECIMAL(255,2)	-1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45

statement ok
CREATE MACRO m(a) AS a + 12345678901234567890123456789012345678.5

query II
SELECT typeof(m(1)), m(1)
----
DECIMAL(40,1)	12345678901234567890123456789012345679.5

statement ok
PREPARE p AS SELECT 12345678901234567890123456789012345678.5 + ?::DECIMAL(50,2)

query I
EXECUTE p(1.25)
----
12345678901234567890123456789012345679.75

# an exponent still makes the literal a DOUBLE
query I
SELECT typeof(12345678901234567890123456789012345678.5e0)
----
DOUBLE

# more than 255 digits do not fit any decimal: the literal falls back to DOUBLE
query I
SELECT typeof(12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234.45)
----
DOUBLE

# malformed literals are still rejected
statement error
SELECT 12345678901234567890123456789012345678.5.5
----
syntax error

statement error
SELECT 1234567890123456789012345678901234567890.1_2.
----
<REGEX>:.*(Parser|Invalid Input|Conversion) Error.*

statement error
SELECT -1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123.45.
----
<REGEX>:.*(Parser|Invalid Input|Conversion) Error.*
