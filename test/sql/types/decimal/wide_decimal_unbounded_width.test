# name: test/sql/types/decimal/wide_decimal_unbounded_width.test
# description: DECIMAL widths beyond 255 digits, the width is bounded only by its uint32_t range
# group: [decimal]

# wide decimal columns need the latest storage version, the configs that force the default one on disk cannot hold them
require no_force_storage

require parquet

# the type binds any width
query IIII
SELECT typeof('1'::DECIMAL(300,100)), typeof('1'::DECIMAL(1000,0)), typeof(1::DECIMAL(4294967295,0)), typeof(NULL::DECIMAL(4294967295,4294967295))
----
DECIMAL(300,100)	DECIMAL(1000,0)	DECIMAL(4294967295,0)	DECIMAL(4294967295,4294967295)

statement error
SELECT NULL::DECIMAL(4294967296,0)
----
<REGEX>:.*does not accept type parameters.*

# a literal of any length is an exact decimal
query II
SELECT typeof(.5), (.5)::VARCHAR = '.5'
----
DECIMAL(1001,1)	true

query I
SELECT -.5 = -(.5)
----
true

# casts to and from VARCHAR keep every digit
query II
SELECT repeat('9', 300)::DECIMAL(300,0)::VARCHAR = repeat('9', 300), (repeat('9', 500) || '.' || repeat('9', 500))::DECIMAL(1000,500)::VARCHAR = repeat('9', 500) || '.' || repeat('9', 500)
----
true	true

query I
SELECT (repeat('9', 200) || '.' || repeat('9', 100))::DECIMAL(300,100)::VARCHAR = repeat('9', 200) || '.' || repeat('9', 100)
----
true

# the integer digits are checked against the width
statement error
SELECT ('1' || repeat('0', 200))::DECIMAL(300,100)
----
<REGEX>:.*Could not convert string.*

query I
SELECT TRY_CAST(('1' || repeat('0', 200)) AS DECIMAL(300,100))
----
NULL

# a small value in a huge type is cheap
query II
SELECT 1::DECIMAL(4294967295,0)::VARCHAR, (-1)::DECIMAL(4294967295,10)::VARCHAR
----
1	-1.0000000000

# DOUBLE, integer, fixed-size decimal and BIGNUM casts
query II
SELECT 1e300::DOUBLE::DECIMAL(400,50)::DOUBLE = 1e300, ('1' || repeat('0', 299))::DECIMAL(300,0)::DOUBLE
----
true	1e+299

query III
SELECT ('42.' || repeat('0', 300))::DECIMAL(400,300)::INTEGER, TRY_CAST(repeat('9', 300)::DECIMAL(300,0) AS BIGINT), ('-7.5' || repeat('0', 299))::DECIMAL(400,300)::HUGEINT
----
42	NULL	-8

query II
SELECT 1.5::DECIMAL(4,1)::DECIMAL(500,400)::DECIMAL(4,1), typeof(1.5::DECIMAL(4,1)::DECIMAL(500,400))
----
1.5	DECIMAL(500,400)

query I
SELECT repeat('7', 300)::BIGNUM::DECIMAL(300,0)::BIGNUM = repeat('7', 300)::BIGNUM
----
true

# arithmetic grows to the exact width of the result
query II
SELECT repeat('9', 300)::DECIMAL(300,0) * repeat('9', 300)::DECIMAL(300,0) AS r, typeof(r)
----
	DECIMAL(600,0)

query II
SELECT repeat('9', 300)::DECIMAL(300,0) + 1 = ('1' || repeat('0', 300))::DECIMAL(301,0), typeof(repeat('9', 300)::DECIMAL(300,0) + 1)
----
true	DECIMAL(301,0)

query III
SELECT typeof('1'::DECIMAL(300,100) + '1'::DECIMAL(200,150)), typeof('1'::DECIMAL(300,100) * '1'::DECIMAL(200,150)), typeof('1'::DECIMAL(300,100) % '1'::DECIMAL(200,150))
----
DECIMAL(351,150)	DECIMAL(500,250)	DECIMAL(350,150)

query I
SELECT '2.5'::DECIMAL(300,100) % '1'::DECIMAL(300,100) = '0.5'::DECIMAL(300,100)
----
true

query I
SELECT -(repeat('9', 300)::DECIMAL(300,0)) = ('-' || repeat('9', 300))::DECIMAL(300,0)
----
true

# only the uint32_t range of the width bounds a result
statement error
SELECT 1::DECIMAL(4294967295,0) + 1::DECIMAL(4294967295,0)
----
<REGEX>:.*Addition needs a DECIMAL of 4294967296 digits.*

statement error
SELECT NULL::DECIMAL(3000000000,0) * NULL::DECIMAL(3000000000,0)
----
<REGEX>:.*Multiplication needs a DECIMAL of 6000000000 digits.*

# comparisons and common types
query III
SELECT ('1' || repeat('0', 299))::DECIMAL(300,0) > repeat('9', 299)::DECIMAL(299,0), ('1' || repeat('0', 299))::DECIMAL(300,0) = ('1' || repeat('0', 299))::DECIMAL(400,100), typeof(CASE WHEN true THEN '1'::DECIMAL(300,100) ELSE '1'::DECIMAL(400,50) END)
----
true	true	DECIMAL(450,100)

query I
SELECT typeof(col0) FROM (VALUES ('1'::DECIMAL(300,100)), (1::DECIMAL(38,2)), (NULL)) LIMIT 1
----
DECIMAL(300,100)

# rounding
query III
SELECT round((repeat('9', 300) || '.5')::DECIMAL(301,1)) = ('1' || repeat('0', 300))::DECIMAL(301,0), typeof(round('1.5'::DECIMAL(301,1))), round('123.456'::DECIMAL(300,100), 2)
----
true	DECIMAL(301,0)	123.46

query II
SELECT round(repeat('9', 300)::DECIMAL(300,0), -1) = ('1' || repeat('0', 300))::DECIMAL(301,0), typeof(round(repeat('9', 300)::DECIMAL(300,0), -1))
----
true	DECIMAL(301,0)

query III
SELECT round(('1' || repeat('0', 299))::DECIMAL(300,0), -2000000000), trunc(('-1' || repeat('0', 299))::DECIMAL(300,0), -301), ceil(('-0.' || repeat('0', 99) || '1')::DECIMAL(300,100))
----
0	0	0

# aggregates
statement ok
CREATE TABLE wide(i INTEGER, d DECIMAL(300,100));

statement ok
INSERT INTO wide SELECT i, (repeat('9', 200) || '.' || repeat('9', 100))::DECIMAL(300,100) FROM range(3) t(i);

statement ok
INSERT INTO wide VALUES (3, NULL), (4, '-1.5');

query II
SELECT typeof(sum(d)), typeof(avg(d)) FROM wide
----
DECIMAL(320,100)	DOUBLE

query I
SELECT sum(d) = '299999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999998.4999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999997'::DECIMAL(320,100) FROM wide
----
true

query IIII
SELECT avg(d), count(d), min(d) = '-1.5'::DECIMAL(300,100), max(d) = (repeat('9', 200) || '.' || repeat('9', 100))::DECIMAL(300,100) FROM wide
----
7.5e+199	4	true	true

query I
SELECT sum(d) OVER (ORDER BY i) = sum(d) FILTER (WHERE true) OVER (ORDER BY i) FROM wide ORDER BY i LIMIT 1
----
true

# the average of a scale beyond the range of a DOUBLE
query II
SELECT avg(x), typeof(avg(x)) FROM (VALUES ('12.5'::DECIMAL(500,400)), ('-2.5'), (NULL)) t(x);
----
5.0	DOUBLE

query I
SELECT avg(x) FROM (VALUES ('12.5'::DECIMAL(6000,5000)), ('-2.5'), (NULL)) t(x);
----
5.0

query I
SELECT abs(avg(x) / 1e300 - 1) < 1e-14 FROM (VALUES (1e300::DOUBLE::DECIMAL(400,50)), (1e300::DOUBLE::DECIMAL(400,50))) t(x);
----
true

# a primary key on a wide column
statement ok
CREATE TABLE pk(d DECIMAL(300,100) PRIMARY KEY);

statement ok
INSERT INTO pk VALUES ((repeat('9', 200) || '.' || repeat('9', 100))::DECIMAL(300,100)), ('-1.5');

statement error
INSERT INTO pk VALUES ('-1.5')
----
<REGEX>:.*Duplicate key.*

query I
SELECT count(*) FROM pk WHERE d = (repeat('9', 200) || '.' || repeat('9', 100))::DECIMAL(300,100)
----
1

# FILL scales the exact delta, also beyond the range of a DOUBLE
query II
SELECT k, (fill(v) OVER (ORDER BY k))::DOUBLE FROM (VALUES (1, ('1' || repeat('0', 299))::DECIMAL(400,50)), (2, NULL), (3, ('3' || repeat('0', 299))::DECIMAL(400,50)), (5, NULL), (0, NULL)) t(k, v) ORDER BY k
----
0	0.0
1	1e+299
2	2e+299
3	3e+299
5	5e+299

query II
SELECT k, f = ('2' || repeat('0', 299))::DECIMAL(400,50) FROM (SELECT k, fill(v) OVER (ORDER BY k) f FROM (VALUES (1, ('1' || repeat('0', 299))::DECIMAL(400,50)), (2, NULL), (3, ('3' || repeat('0', 299))::DECIMAL(400,50))) t(k, v)) WHERE k = 2
----
2	true

# VARIANT
query II
SELECT (('1' || repeat('0', 299))::DECIMAL(300,0))::VARIANT::DECIMAL(300,0) = ('1' || repeat('0', 299))::DECIMAL(300,0), variant_typeof('1'::DECIMAL(300,100)::VARIANT)
----
true	DECIMAL(300, 100)

# Parquet round trip
statement ok
COPY wide TO '{TEST_DIR}/wide_unbounded.parquet' (FORMAT PARQUET);

query II
SELECT typeof(d), count(*) FROM '{TEST_DIR}/wide_unbounded.parquet' GROUP BY ALL
----
DECIMAL(300,100)	5

query I
SELECT bool_and(w.d IS NOT DISTINCT FROM p.d) FROM wide w JOIN '{TEST_DIR}/wide_unbounded.parquet' p USING (i)
----
true

# the catalog and the table data survive a restart
statement ok
ATTACH '{TEST_DIR}/wide_unbounded.db' AS db (STORAGE_VERSION 'latest');

statement ok
CREATE TABLE db.t AS SELECT * FROM wide;

statement ok
CREATE TABLE db.huge(d DECIMAL(4294967295,10));

statement ok
INSERT INTO db.huge VALUES (1), (-1), (NULL);

statement ok
CREATE VIEW db.v AS SELECT d * d AS p FROM db.t;

statement ok
CHECKPOINT db;

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/wide_unbounded.db' AS db;

query III
SELECT typeof(d), count(*), sum(d) = '299999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999998.4999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999997'::DECIMAL(320,100) FROM db.t GROUP BY ALL
----
DECIMAL(300,100)	5	true

query II
SELECT typeof(d), list(d ORDER BY d) FROM db.huge GROUP BY ALL
----
DECIMAL(4294967295,10)	[-1.0000000000, 1.0000000000, NULL]

query I
SELECT typeof(p) FROM db.v LIMIT 1
----
DECIMAL(600,200)
