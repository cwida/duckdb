# name: test/sql/types/decimal/decimal_values_warning.test
# description: Warn when VALUES type resolution reduces a decimal scale
# group: [decimal]

statement ok
SET enable_logging=true;

statement ok
SET warnings_as_errors=true;

# Mixing DECIMAL types that need 39 digits widens the column instead of reducing the scale
query I
SELECT typeof(col0) FROM (VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::NUMERIC)) LIMIT 1;
----
DECIMAL(39,24)

# Mixing wide DECIMAL types widens the column as well
query I
SELECT typeof(col0) FROM (VALUES (32942348563242.111222333444555666777888::DECIMAL(255,24)), (NULL::DECIMAL(240,0))) LIMIT 1;
----
DECIMAL(264,24)

# Beyond the maximum width the common type is an error instead of a reduced scale
statement ok
SET max_decimal_width = 4294967295;

statement error
VALUES (NULL::DECIMAL(4294967295,24)), (NULL::DECIMAL(4294967290,0));
----
Combining DECIMAL(4294967295,24) and DECIMAL(4294967290,0) needs a DECIMAL of 4294967314 digits

# The scale is only reduced within the fixed-size tiers, under the 38-digit bound of the engines before wide decimals
statement ok
SET max_decimal_width = 38;

statement error
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(38,0));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a VALUES column: type DECIMAL\(38,24\) is being cast to DECIMAL\(38,0\), reducing the scale from 24 to 0\..*

# The warning is independent of row order
statement error
VALUES (NULL::DECIMAL(38,0)), (32942348563242.111222333444555666777888::DECIMAL(38,24));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a VALUES column: type DECIMAL\(38,24\) is being cast to DECIMAL\(38,0\), reducing the scale from 24 to 0\..*

statement ok
RESET max_decimal_width;

# Untyped NULL does not affect the common DECIMAL type
statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL);

# Compatible DECIMAL scales do not lose precision
statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(38,24));

statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(10,2));

# Only one warning is emitted per affected column and query execution
statement ok
SET warnings_as_errors=false;

statement ok
CALL truncate_duckdb_logs();

statement ok
SET max_decimal_width = 38;

statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)),
       (32942348563242.111222333444555666777888::DECIMAL(38,24)),
       (NULL::DECIMAL(38,0));

query I
SELECT count(*) > 0 AND count(*) = count(DISTINCT query_id)
FROM duckdb_logs
WHERE log_level = 'WARNING'
  AND starts_with(message, 'Potential loss of decimal precision while resolving a VALUES column');
----
true
