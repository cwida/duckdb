# name: test/sql/types/decimal/decimal_values_warning.test
# description: Warn when VALUES type resolution reduces a decimal scale
# group: [decimal]

statement ok
SET enable_logging=true;

statement ok
SET warnings_as_errors=true;

# Mixing DECIMAL types that need 39 digits widens the column instead of reducing the scale
query I
SELECT typeof(col0) FROM (VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(18,3))) LIMIT 1;
----
DECIMAL(39,24)

# Mixing DECIMAL types that need more than 255 digits reduces the scale to fit the maximum width
statement error
VALUES (32942348563242.111222333444555666777888::DECIMAL(255,24)), (NULL::DECIMAL(240,0));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a VALUES column: type DECIMAL\(255,24\) is being cast to DECIMAL\(255,15\), reducing the scale from 24 to 15\..*

# The warning is independent of row order
statement error
VALUES (NULL::DECIMAL(240,0)), (32942348563242.111222333444555666777888::DECIMAL(255,24));
----
<REGEX>:Invalid Input Error: Potential loss of decimal precision while resolving a VALUES column: type DECIMAL\(255,24\) is being cast to DECIMAL\(255,15\), reducing the scale from 24 to 15\..*

# Untyped NULL does not affect the common DECIMAL type
statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL);

# Compatible DECIMAL scales do not lose precision
statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(38,24));

statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(38,24)), (NULL::DECIMAL(10,2));

# Only one warning is emitted per affected column and query execution
statement ok
SET warnings_as_errors=false;

statement ok
CALL truncate_duckdb_logs();

statement ok
VALUES (32942348563242.111222333444555666777888::DECIMAL(255,24)),
       (32942348563242.999888777666555444333222::DECIMAL(255,24)),
       (NULL::DECIMAL(240,0));

query I
SELECT count(*) > 0 AND count(*) = count(DISTINCT query_id)
FROM duckdb_logs
WHERE log_level = 'WARNING'
  AND starts_with(message, 'Potential loss of decimal precision while resolving a VALUES column');
----
true
