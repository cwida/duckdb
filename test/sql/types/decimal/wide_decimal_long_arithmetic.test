# name: test/sql/types/decimal/wide_decimal_long_arithmetic.test
# description: Decimals of thousands of digits: multiplication, parsing, printing, rescaling and powers of ten
# group: [decimal]

# products above the Karatsuba threshold, checked against the exact values
query I
SELECT (repeat('1234567890', 150)::DECIMAL(1500,0) * repeat('9876543210', 150)::DECIMAL(1500,0))::VARCHAR = ''
----
true

query I
SELECT (repeat('1234567890', 150)::DECIMAL(1502,2) * repeat('9876543210', 150)::DECIMAL(1503,3))::VARCHAR = '.00000'
----
true

# an unbalanced product
query I
SELECT (repeat('2718281828', 50)::DECIMAL(500,0) * repeat('1414213562', 300)::DECIMAL(3000,0))::VARCHAR = ''
----
true

query I
SELECT (repeat('1234567890', 400)::DECIMAL(4000,0) * repeat('0987654321', 400)::DECIMAL(4000,0))::VARCHAR = ''
----
true

# (10^3000 - 1)^2 = 10^6000 - 2 * 10^3000 + 1
query I
SELECT (('-' || repeat('9', 3000))::DECIMAL(3000,0) * repeat('9', 3000)::DECIMAL(3000,0))::VARCHAR = '-' || repeat('9', 2999) || '8' || repeat('0', 2999) || '1'
----
true

# parsing and printing keep every digit
query II
SELECT repeat('123456789', 2000)::DECIMAL(18000,0)::VARCHAR = repeat('123456789', 2000), (repeat('1234567890', 1000) || '5')::DECIMAL(10001,0)::VARCHAR = repeat('1234567890', 1000) || '5'
----
true	true

query II
SELECT ('-' || repeat('9', 20001))::DECIMAL(20001,0)::VARCHAR = '-' || repeat('9', 20001), (repeat('7', 5000) || '.' || repeat('3', 5000))::DECIMAL(10000,5000)::VARCHAR = repeat('7', 5000) || '.' || repeat('3', 5000)
----
true	true

query I
SELECT repeat('123456789', 2000)::DECIMAL(18000,0) = repeat('123456789', 2000)::BIGNUM::DECIMAL(18000,0)
----
true

# powers of ten of thousands of digits: rescaling in both directions
query II
SELECT 1::DECIMAL(20000,19999)::VARCHAR = '1.' || repeat('0', 19999), ('1' || repeat('0', 9999))::DECIMAL(20000,0)::DECIMAL(20000,10000)::VARCHAR = '1' || repeat('0', 9999) || '.' || repeat('0', 10000)
----
true	true

query I
SELECT ('1' || repeat('0', 9999) || '.' || repeat('9', 10000))::DECIMAL(20000,10000)::DECIMAL(20000,0)::VARCHAR = '1' || repeat('0', 9998) || '1'
----
true

query II
SELECT typeof(1::DECIMAL(100000,99990)), 1::DECIMAL(100000,99990) = '1'::DECIMAL(100000,99990)
----
DECIMAL(100000,99990)	true

# a long conversion checks for interrupts
statement ok
SET max_execution_time = 1;

statement error
SELECT length(1::DECIMAL(1000000,999990)::VARCHAR)
----
<REGEX>:.*maximum execution time.*

statement ok
RESET max_execution_time;
