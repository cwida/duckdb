query III
SELECT count(DISTINCT x),bool_and(x=x),bool_and(x IS NOT DISTINCT FROM x) FROM (VALUES ([[1],[2,3]]),([[1],[2,3]]),([[1],[2,4]])) t(x);
----
2	true	true
