# name: test/sql/select/test_positional_reference.test
# description: Positional reference
# group: [select]

query I
SELECT #1 FROM range(1)
----
0

# multiple tables
query I
SELECT #1+#2 FROM range(1) tbl, range(1) tbl2
----
0

# subqueries
query I
SELECT #1 FROM (SELECT * FROM range(1)) tbl
----
0

# positional references only consider the inner-most table
statement error
select (select #1) from range(1);
----
<REGEX>:.*Binder Error.*out of range.*

# out of range
statement error
SELECT #2 FROM range(1)
----
<REGEX>:.*Binder Error.*out of range.*

# no from clause
statement error
SELECT #1
----
<REGEX>:.*Binder Error.*out of range.*

# zero always fails
statement error
SELECT #0 FROM range(1)
----
<REGEX>:.*Parser Error.*Positional reference node needs.*

# as do negative numbers
statement error
SELECT #-1 FROM range(1)
----
<REGEX>:.*Parser Error.*syntax error.*

# a positional reference reused as an alias inside a subquery binds as a correlated reference to the outer position
statement ok
CREATE TABLE t(a INT, b INT);

statement ok
INSERT INTO t VALUES (1, 2), (3, NULL);

query I
SELECT #2 AS x FROM t WHERE (SELECT x) IS NULL
----
NULL

query II
SELECT #1 AS x, (SELECT x + 100) AS y FROM t ORDER BY 1
----
1	101
3	103

query I
SELECT #2 AS x FROM t ORDER BY (SELECT x) NULLS LAST
----
2
NULL

# an out-of-range position reused this way still produces a regular binder error
statement error
SELECT 42 AS a, #1 AS x WHERE (SELECT x) IS NULL
----
<REGEX>:.*Binder Error.*out of range.*
