# name: test/sql/settings/test_external_access_secrets.test
# description: Test that persistent secrets fail when external access is disabled
# group: [settings]

require skip_reload

statement ok
SET secret_directory='{TEST_DIR}/external_access_secrets';

statement ok
SET enable_external_access=false;

statement error
CREATE PERSISTENT SECRET my_secret (TYPE S3)
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "s3")
