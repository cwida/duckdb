# name: test/sql/settings/pragma_assignment_deprecated.test
# description: Setting a setting through PRAGMA name=value emits a deprecation warning
# group: [settings]

statement ok
SET enable_logging=true;

statement ok
PRAGMA threads=2;

statement ok
SET threads=2;

statement ok
SET warnings_as_errors=true;

statement error
PRAGMA threads=2;
----
Using "PRAGMA threads=..." to set a setting is deprecated

# SET does not warn
statement ok
SET threads=2;
