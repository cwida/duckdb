# name: test/sql/settings/generic_migrated_settings.test
# description: Settings migrated to generic settings keep their defaults, normalization, validation and RESET behavior
# group: [settings]

# defaults
query IIIII
SELECT current_setting('debug_verification_mode'), current_setting('profiling_coverage'),
       current_setting('debug_force_variant_shredding'), current_setting('checkpoint_threshold'),
       current_setting('allocator_bulk_deallocation_flush_threshold')
----
NONE	SELECT	INVALID	16.0 MiB	512.0 MiB

query IIIII
SELECT current_setting('disabled_optimizers'), current_setting('disabled_compression_methods'),
       current_setting('extension_directories'), current_setting('profiling_output'),
       current_setting('custom_user_agent')
----
(empty)	(empty)	[]	(empty)	(empty)

# enums are normalized
statement ok
SET debug_verification_mode='verify_vectors'

statement ok
SET profiling_coverage='all'

query II
SELECT current_setting('debug_verification_mode'), current_setting('profiling_coverage')
----
VERIFY_VECTORS	ALL

statement error
SET profiling_coverage='does_not_exist'
----
unrecognized value

statement ok
RESET debug_verification_mode

statement ok
RESET profiling_coverage

query II
SELECT current_setting('debug_verification_mode'), current_setting('profiling_coverage')
----
NONE	SELECT

# lists of optimizers and compression methods are normalized
statement ok
SET disabled_optimizers='Join_Order , extension'

statement ok
SET disabled_compression_methods='rle,bitpacking'

query II
SELECT current_setting('disabled_optimizers'), current_setting('disabled_compression_methods')
----
join_order,extension	RLE,BitPacking

statement ok
RESET disabled_optimizers

statement ok
RESET disabled_compression_methods

query II
SELECT current_setting('disabled_optimizers'), current_setting('disabled_compression_methods')
----
(empty)	(empty)

# thresholds and lists
statement ok
SET checkpoint_threshold='1GB'

statement ok
SET allocator_bulk_deallocation_flush_threshold='1GiB'

statement ok
SET extension_directories=['/tmp/a', '/tmp/b']

query III
SELECT current_setting('checkpoint_threshold'), current_setting('allocator_bulk_deallocation_flush_threshold'),
       current_setting('extension_directories')
----
1GB	1GiB	[/tmp/a, /tmp/b]

statement error
SET extension_directories=NULL
----
cannot be NULL

statement ok
RESET checkpoint_threshold

statement ok
RESET allocator_bulk_deallocation_flush_threshold

statement ok
RESET extension_directories

query III
SELECT current_setting('checkpoint_threshold'), current_setting('allocator_bulk_deallocation_flush_threshold'),
       current_setting('extension_directories')
----
16.0 MiB	512.0 MiB	[]

# progress bar printing
statement ok
SET enable_progress_bar_print=false

query I
SELECT current_setting('enable_progress_bar_print')
----
false

statement ok
RESET enable_progress_bar_print

query I
SELECT current_setting('enable_progress_bar_print')
----
true

# variant shredding schema
statement ok
SET force_variant_shredding='STRUCT(a INTEGER)'

query I
SELECT current_setting('debug_force_variant_shredding')
----
STRUCT(a INTEGER)

statement error
SET force_variant_shredding='MAP(VARCHAR, INTEGER)'
----
Shredding can consist of the nested types LIST

statement ok
RESET force_variant_shredding

query I
SELECT current_setting('debug_force_variant_shredding')
----
INVALID

# settings that cannot be changed by the user, or while the database is running
statement error
SET debug_delta_only_variant_encoding_enabled=true
----
This setting is not adjustable by a user

statement error
RESET debug_delta_only_variant_encoding_enabled
----
This setting is not adjustable by a user

statement error
SET custom_user_agent='my_agent'
----
Cannot change custom_user_agent setting while database is running
