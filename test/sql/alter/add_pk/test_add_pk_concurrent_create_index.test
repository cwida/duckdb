# name: test/sql/alter/add_pk/test_add_pk_concurrent_create_index.test
# description: Adding a constraint must not succeed while another transaction creates an index on the same table
# group: [add_pk]

load {TEST_DIR}/add_pk_concurrent_create_index.db

statement ok
CREATE TABLE t (id BIGINT, c INTEGER);

statement ok
INSERT INTO t SELECT range, range % 10 FROM range(2000);

statement ok con1
BEGIN

statement ok con1
CREATE INDEX ix ON t(c);

statement error con2
ALTER TABLE t ADD PRIMARY KEY (id);
----
<REGEX>:.*depend on it.*

statement error con2
ALTER TABLE t ADD UNIQUE (id);
----
<REGEX>:.*depend on it.*

statement ok con1
COMMIT

statement ok
INSERT INTO t VALUES (5000, 1);

restart

query I
SELECT count(*) FROM t WHERE c = 1;
----
201

# after the index exists, the constraint is rejected by the dependency check
statement error
ALTER TABLE t ADD PRIMARY KEY (id);
----
<REGEX>:.*depend on it.*
