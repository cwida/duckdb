# name: test/sql/optimizer/pushdown/pushdown_safe_decimal_cast.test
# description: A cast into a DECIMAL that holds every value of its source cannot throw, so a filter over it is pushed down
# group: [pushdown]

# every integer type, and a DECIMAL of every storage width: DECIMAL(4,1) is stored as INT16, DECIMAL(9,3) as INT32,
# DECIMAL(10,2) and DECIMAL(18,1) as INT64 and DECIMAL(20,2) as HUGEINT
statement ok
CREATE TABLE casts(t TINYINT, ut UTINYINT, s SMALLINT, us USMALLINT, i INTEGER, ui UINTEGER, b BIGINT, u UBIGINT,
                   h HUGEINT, d2 DECIMAL(4,1), d4 DECIMAL(9,3), d DECIMAL(10,2), d8 DECIMAL(18,1), d16 DECIMAL(20,2),
                   v VARCHAR);

# the extremes of every source type, a row inside the filter range and a NULL row. The TINYINT types hold 50 and
# are filtered with BETWEEN 10 AND 90: 150 does not fit them, and their extreme 127 lies inside BETWEEN 100 AND 200
statement ok
INSERT INTO casts VALUES
    (127, 255, 32767, 65535, 2147483647, 4294967295, 9223372036854775807, 18446744073709551615,
     170141183460469231731687303715884105727, 999.9, 999999.999, 99999999.99, 99999999999999999.9,
     999999999999999999.99, '150'),
    (-128, 0, -32768, 0, -2147483648, 0, -9223372036854775808, 0,
     -170141183460469231731687303715884105728, -999.9, -999999.999, -99999999.99, -99999999999999999.9,
     -999999999999999999.99, '-150'),
    (50, 50, 150, 150, 150, 150, 150, 150, 150, 150.5, 150.125, 150.25, 150.5, 150.25, '150.25'),
    (NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'OPTIMIZED_ONLY';

# Filter pushdown keeps a filter that can throw above a projection. The projection below computes a column, so the
# filter crosses it only if the cast cannot throw, and then ends up in the scan. A filter that can throw is left as a
# FILTER operator over a scan without filters.

# a DECIMAL column compared with integer literals is cast to a wider DECIMAL of the same scale
query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE d BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(d AS DECIMAL\(12,2\)\) BETWEEN 100.00 AND 200.00[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE d BETWEEN 100 AND 200
----
logical_opt	<!REGEX>:[\s\S]*FILTER[\s\S]*

# an integer column compared with decimal literals is cast to a DECIMAL that holds every value of its type
query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE i BETWEEN 100.5 AND 200.5
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(i AS DECIMAL\(11,1\)\) BETWEEN 100.5 AND 200.5[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT b, d, b // 2 AS j FROM casts) WHERE b BETWEEN 100.5 AND 200.5
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(b AS DECIMAL\(20,1\)\) BETWEEN 100.5 AND 200.5[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT u, d, u // 2 AS j FROM casts) WHERE u BETWEEN 100.5 AND 200.5
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(u AS DECIMAL\(21,1\)\) BETWEEN 100.5 AND 200.5[\s\S]*

# no DECIMAL holds every HUGEINT: the filter stays above the projection
query II
EXPLAIN SELECT * FROM (SELECT h, d, h // 2 AS j FROM casts) WHERE h BETWEEN 100.5 AND 200.5
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(h AS DECIMAL\(38,1\)\) BETWEEN 100.5 AND 200.5[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# explicit casts: more digits on both sides of the decimal point
query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE CAST(d AS DECIMAL(18,4)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(d AS DECIMAL\(18,4\)\) BETWEEN 100.0000 AND 200.0000[\s\S]*

# the digit table at its boundaries: TINYINT and UTINYINT have 3 digits, SMALLINT and USMALLINT 5, INTEGER and
# UINTEGER 10, BIGINT 19 and UBIGINT 20. The integer literals bind as DECIMAL(10,0), so a narrower target is widened
# once more, and the filter only reaches the scan when both casts are safe
query II
EXPLAIN SELECT * FROM (SELECT t, d, t // 2 AS j FROM casts) WHERE CAST(t AS DECIMAL(3,0)) BETWEEN 10 AND 90
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(t AS DECIMAL\(3,0\)\) AS DECIMAL\(10,0\)\) BETWEEN 10 AND 90[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT ut, d, ut // 2 AS j FROM casts) WHERE CAST(ut AS DECIMAL(3,0)) BETWEEN 10 AND 90
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(ut AS DECIMAL\(3,0\)\) AS DECIMAL\(10,0\)\) BETWEEN 10 AND 90[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT s, d, s // 2 AS j FROM casts) WHERE CAST(s AS DECIMAL(5,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(s AS DECIMAL\(5,0\)\) AS DECIMAL\(10,0\)\) BETWEEN 100 AND 200[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT us, d, us // 2 AS j FROM casts) WHERE CAST(us AS DECIMAL(5,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(us AS DECIMAL\(5,0\)\) AS DECIMAL\(10,0\)\) BETWEEN 100 AND 200[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE CAST(i AS DECIMAL(10,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(i AS DECIMAL\(10,0\)\) BETWEEN 100 AND 200[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT ui, d, ui // 2 AS j FROM casts) WHERE CAST(ui AS DECIMAL(10,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(ui AS DECIMAL\(10,0\)\) BETWEEN 100 AND 200[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT b, d, b // 2 AS j FROM casts) WHERE CAST(b AS DECIMAL(19,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(b AS DECIMAL\(19,0\)\) BETWEEN 100 AND 200[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT u, d, u // 2 AS j FROM casts) WHERE CAST(u AS DECIMAL(20,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(u AS DECIMAL\(20,0\)\) BETWEEN 100 AND 200[\s\S]*

# one digit short: these casts overflow for the extremes, so the filter stays above the projection
query II
EXPLAIN SELECT * FROM (SELECT t, d, t // 2 AS j FROM casts) WHERE CAST(t AS DECIMAL(2,0)) BETWEEN 10 AND 90
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(t AS DECIMAL\(2,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT ut, d, ut // 2 AS j FROM casts) WHERE CAST(ut AS DECIMAL(2,0)) BETWEEN 10 AND 90
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(ut AS DECIMAL\(2,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT s, d, s // 2 AS j FROM casts) WHERE CAST(s AS DECIMAL(4,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(s AS DECIMAL\(4,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT us, d, us // 2 AS j FROM casts) WHERE CAST(us AS DECIMAL(4,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(us AS DECIMAL\(4,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

