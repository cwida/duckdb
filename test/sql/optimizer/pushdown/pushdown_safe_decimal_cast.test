EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE CAST(i AS DECIMAL(9,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(i AS DECIMAL\(9,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT ui, d, ui // 2 AS j FROM casts) WHERE CAST(ui AS DECIMAL(9,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(ui AS DECIMAL\(9,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT b, d, b // 2 AS j FROM casts) WHERE CAST(b AS DECIMAL(18,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(b AS DECIMAL\(18,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT u, d, u // 2 AS j FROM casts) WHERE CAST(u AS DECIMAL(19,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(u AS DECIMAL\(19,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# the smallest DECIMAL targets with one more digit on both sides of the decimal point, for a source of every storage
# width: DECIMAL(4,1) -> DECIMAL(5,2) stays in INT16, DECIMAL(9,3) -> DECIMAL(10,4) widens INT32 to INT64,
# DECIMAL(18,1) -> DECIMAL(19,2) widens INT64 to HUGEINT and DECIMAL(20,2) -> DECIMAL(21,3) stays in HUGEINT. The
# literals again widen the targets with fewer than ten integral digits
query II
EXPLAIN SELECT * FROM (SELECT d2, d, d2 // 2 AS j FROM casts) WHERE CAST(d2 AS DECIMAL(5,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(d2 AS DECIMAL\(5,2\)\) AS DECIMAL\(12,2\)\) BETWEEN 100.00 AND 200.00[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d4, d, d4 // 2 AS j FROM casts) WHERE CAST(d4 AS DECIMAL(10,4)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(CAST\(d4 AS DECIMAL\(10,4\)\) AS DECIMAL\(14,4\)\) BETWEEN 100.0000 AND 200.0000[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d8, d, d8 // 2 AS j FROM casts) WHERE CAST(d8 AS DECIMAL(19,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(d8 AS DECIMAL\(19,2\)\) BETWEEN 100.00 AND 200.00[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d16, d, d16 // 2 AS j FROM casts) WHERE CAST(d16 AS DECIMAL(21,3)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(d16 AS DECIMAL\(21,3\)\) BETWEEN 100.000 AND 200.000[\s\S]*

# the same targets one integral digit short: the filter stays above the projection
query II
EXPLAIN SELECT * FROM (SELECT d2, d, d2 // 2 AS j FROM casts) WHERE CAST(d2 AS DECIMAL(4,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d2 AS DECIMAL\(4,2\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d4, d, d4 // 2 AS j FROM casts) WHERE CAST(d4 AS DECIMAL(9,4)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d4 AS DECIMAL\(9,4\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d8, d, d8 // 2 AS j FROM casts) WHERE CAST(d8 AS DECIMAL(18,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d8 AS DECIMAL\(18,2\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT d16, d, d16 // 2 AS j FROM casts) WHERE CAST(d16 AS DECIMAL(20,3)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d16 AS DECIMAL\(20,3\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# a DECIMAL that loses integral digits, or scale: DECIMAL(10,2) -> DECIMAL(10,4) drops two integral digits,
# DECIMAL(10,2) -> DECIMAL(10,1) rounds, which can carry into another integral digit
query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE CAST(d AS DECIMAL(10,4)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d AS DECIMAL\(10,4\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE CAST(d AS DECIMAL(10,1)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d AS DECIMAL\(10,1\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# HUGEINT and VARCHAR sources
query II
EXPLAIN SELECT * FROM (SELECT h, d, h // 2 AS j FROM casts) WHERE CAST(h AS DECIMAL(38,0)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(h AS DECIMAL\(38,0\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT v, d, v || 'x' AS j FROM casts) WHERE CAST(v AS DECIMAL(18,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(v AS DECIMAL\(18,2\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# a safe cast of a group column is pushed through the aggregate into the scan, a narrowing one is not
query II
EXPLAIN SELECT * FROM (SELECT i, d, count(*) AS c FROM casts GROUP BY ALL) WHERE d BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*AGGREGATE[\s\S]*SEQ_SCAN[\s\S]*Filters:[\s\S]*CAST\(d AS DECIMAL\(12,2\)\) BETWEEN 100.00 AND 200.00[\s\S]*

query II
EXPLAIN SELECT * FROM (SELECT i, d, count(*) AS c FROM casts GROUP BY ALL) WHERE CAST(d AS DECIMAL(5,2)) BETWEEN 100 AND 200
----
logical_opt	<REGEX>:[\s\S]*FILTER[\s\S]*CAST\(d AS DECIMAL\(5,2\)\)[\s\S]*SEQ_SCAN[^│]*│ Table:[\s\S]*

# the pushed-down filters return the row inside the range
query II
SELECT i, d FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE d BETWEEN 100 AND 200
----
150	150.25

query I
SELECT i FROM (SELECT i, d, i // 2 AS j FROM casts) WHERE i BETWEEN 100.5 AND 200.5
----
150

