query III
SELECT i, d, c FROM (SELECT i, d, count(*) AS c FROM casts GROUP BY ALL) WHERE d BETWEEN 100 AND 200
----
150	150.25	1

# every extreme survives the widening casts, and NULL stays NULL
query IIII
SELECT CAST(i AS DECIMAL(10,0)), CAST(b AS DECIMAL(19,0)), CAST(u AS DECIMAL(20,0)), CAST(d AS DECIMAL(18,4)) FROM casts ORDER BY i NULLS LAST
----
-2147483648	-9223372036854775808	0	-99999999.9900
150	150	150	150.2500
2147483647	9223372036854775807	18446744073709551615	99999999.9900
NULL	NULL	NULL	NULL

query IIIII
SELECT CAST(t AS DECIMAL(3,0)), CAST(ut AS DECIMAL(3,0)), CAST(s AS DECIMAL(5,0)), CAST(us AS DECIMAL(5,0)), CAST(ui AS DECIMAL(10,0)) FROM casts ORDER BY i NULLS LAST
----
-128	0	-32768	0	0
50	50	150	150	150
127	255	32767	65535	4294967295
NULL	NULL	NULL	NULL	NULL

query IIII
SELECT CAST(d2 AS DECIMAL(5,2)), CAST(d4 AS DECIMAL(10,4)), CAST(d8 AS DECIMAL(19,2)), CAST(d16 AS DECIMAL(21,3)) FROM casts ORDER BY i NULLS LAST
----
-999.90	-999999.9990	-99999999999999999.90	-999999999999999999.990
150.50	150.1250	150.50	150.250
999.90	999999.9990	99999999999999999.90	999999999999999999.990
NULL	NULL	NULL	NULL

