# name: test/sql/optimizer/scalar_aggregate_merge_files_plan.test
# description: The plans of sibling scalar aggregates over the same Parquet or CSV scan read the files once
# group: [optimizer]

require parquet

require json

# sam_a: the sales table of scalar_aggregate_merge.test; sam_b holds 3000 more rows; sam_sales.csv is sam_a as CSV
statement ok
COPY (SELECT
    (i % 100 + 1)::INTEGER AS q,
    CASE WHEN i % 17 = 0 THEN NULL ELSE ((i % 1000) / 10)::DECIMAL(7,2) END AS disc,
    (((i * 7) % 5000) / 100)::DECIMAL(7,2) AS paid,
    (i % 50)::INTEGER AS k,
    i AS v,
    'n' || (i % 7) AS name
FROM range(5000) r(i)) TO '{TEST_DIR}/sam_a.parquet' (FORMAT parquet);

statement ok
COPY (SELECT
    (i % 100 + 1)::INTEGER AS q,
    CASE WHEN i % 17 = 0 THEN NULL ELSE ((i % 1000) / 10)::DECIMAL(7,2) END AS disc,
    (((i * 7) % 5000) / 100)::DECIMAL(7,2) AS paid,
    (i % 50)::INTEGER AS k,
    i AS v,
    'n' || (i % 7) AS name
FROM range(5000, 8000) r(i)) TO '{TEST_DIR}/sam_b.parquet' (FORMAT parquet);

statement ok
COPY (FROM read_parquet('{TEST_DIR}/sam_a.parquet')) TO '{TEST_DIR}/sam_sales.csv' (FORMAT csv, HEADER);

statement ok
COPY (FROM read_parquet('{TEST_DIR}/sam_a.parquet')) TO '{TEST_DIR}/sam_sales.json' (FORMAT json);

# sam_bad.csv: x and y count 1 to 30, except that y is not a number where x is a multiple of 7
statement ok
COPY (SELECT i AS x, CASE WHEN i % 7 = 0 THEN 'oops' ELSE i::VARCHAR END AS y FROM range(1, 31) r(i)) TO '{TEST_DIR}/sam_bad.csv' (FORMAT csv, HEADER);

statement ok
CREATE TABLE dim1 AS SELECT i::INTEGER AS dk, CASE WHEN i % 3 = 0 THEN 'a' WHEN i % 3 = 1 THEN 'b' ELSE 'c' END AS dname FROM range(50) r(i);

# ---- a file scan is the expensive part: the merge needs no threshold ---------------------------------------------

# one file, read once
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q > 90) AS b,
       (SELECT avg(disc) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q BETWEEN 30 AND 40) AS c
----
physical_plan	<REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*

query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q > 90) AS b,
       (SELECT avg(disc) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q BETWEEN 30 AND 40) AS c
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*Function: READ_PARQUET\b[\s\S]*

# disabled, every subquery reads the file
statement ok
SET disabled_optimizers = 'scalar_aggregate_merge'

query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q > 90) AS b,
       (SELECT avg(disc) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q BETWEEN 30 AND 40) AS c
----
physical_plan	<REGEX>:([\s\S]*Function: READ_PARQUET\b){3}[\s\S]*

statement ok
RESET disabled_optimizers

# the file named directly (a replacement scan, bound as parquet_scan)
query II
EXPLAIN SELECT (SELECT count(*) FROM '{TEST_DIR}/sam_a.parquet' WHERE q < 10) AS a,
       (SELECT sum(paid) FROM '{TEST_DIR}/sam_a.parquet' WHERE q > 90) AS b
----
physical_plan	<REGEX>:[\s\S]*Function: PARQUET_SCAN\b[\s\S]*

query II
EXPLAIN SELECT (SELECT count(*) FROM '{TEST_DIR}/sam_a.parquet' WHERE q < 10) AS a,
       (SELECT sum(paid) FROM '{TEST_DIR}/sam_a.parquet' WHERE q > 90) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: PARQUET_SCAN\b[\s\S]*Function: PARQUET_SCAN\b[\s\S]*

# a glob, and a list of files
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_*.parquet') WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_*.parquet') WHERE q > 90) AS b,
       (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_*.parquet')) AS c
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*Function: READ_PARQUET\b[\s\S]*

# the branch without a condition first: its scan reads no column of its own and gains the others' columns
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_*.parquet')) AS c,
       (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_*.parquet') WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_*.parquet') WHERE q > 90) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*Function: READ_PARQUET\b[\s\S]*

query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet(['{TEST_DIR}/sam_a.parquet', '{TEST_DIR}/sam_b.parquet']) WHERE q < 10) AS a,
       (SELECT sum(paid) FROM read_parquet(['{TEST_DIR}/sam_a.parquet', '{TEST_DIR}/sam_b.parquet']) WHERE q > 90) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*Function: READ_PARQUET\b[\s\S]*

# a CSV file
query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_sales.csv') WHERE q < 10) AS a,
       (SELECT max(v) FROM read_csv('{TEST_DIR}/sam_sales.csv') WHERE q > 90) AS b
----
physical_plan	<REGEX>:[\s\S]*Function: READ_CSV\b[\s\S]*

query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_sales.csv') WHERE q < 10) AS a,
       (SELECT max(v) FROM read_csv('{TEST_DIR}/sam_sales.csv') WHERE q > 90) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_CSV\b[\s\S]*Function: READ_CSV\b[\s\S]*

# a CSV scan that drops the rows it fails to parse returns a row when every column it reads parses: scans that read
# different columns stay apart
query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE x > 0) AS a,
       (SELECT sum(y) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE x > 10) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: READ_CSV\b){2}[\s\S]*

# the same columns read by both branches are one scan
query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE y > 0) AS a,
       (SELECT sum(y) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE y > 10) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_CSV\b[\s\S]*Function: READ_CSV\b[\s\S]*

# ignore_errors = false reads every row, whichever columns: one scan
query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = false, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE x > 0) AS a,
       (SELECT sum(y) FROM read_csv('{TEST_DIR}/sam_bad.csv', ignore_errors = false, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE x > 10) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_CSV\b[\s\S]*Function: READ_CSV\b[\s\S]*

# a scan that stores its rejects writes them per scan: never shared, even over the same columns
query II
EXPLAIN SELECT (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_bad.csv', store_rejects = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE y > 0) AS a,
       (SELECT sum(y) FROM read_csv('{TEST_DIR}/sam_bad.csv', store_rejects = true, columns = {'x': 'INTEGER', 'y': 'INTEGER'}) WHERE y > 10) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: READ_CSV\b){2}[\s\S]*

# a JSON file
query II
EXPLAIN SELECT (SELECT count(*) FROM read_json('{TEST_DIR}/sam_sales.json') WHERE q < 10) AS a,
       (SELECT max(v) FROM read_json('{TEST_DIR}/sam_sales.json') WHERE q > 90) AS b
----
physical_plan	<REGEX>:[\s\S]*Function: READ_JSON\b[\s\S]*

query II
EXPLAIN SELECT (SELECT count(*) FROM read_json('{TEST_DIR}/sam_sales.json') WHERE q < 10) AS a,
       (SELECT max(v) FROM read_json('{TEST_DIR}/sam_sales.json') WHERE q > 90) AS b
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_JSON\b[\s\S]*Function: READ_JSON\b[\s\S]*

# derived tables with DISTINCT aggregates
query II
EXPLAIN SELECT * FROM
    (SELECT avg(paid) AS a1, count(paid) AS c1, count(DISTINCT paid) AS d1 FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q BETWEEN 1 AND 5) b1,
    (SELECT avg(paid) AS a2, count(paid) AS c2, count(DISTINCT k) AS d2 FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q BETWEEN 6 AND 10) b2
----
physical_plan	<!REGEX>:[\s\S]*Function: READ_PARQUET\b[\s\S]*Function: READ_PARQUET\b[\s\S]*

# a file joined with a catalog table: the file makes the merge worthwhile, the table is read once as well
query II
EXPLAIN SELECT (SELECT sum(paid) FROM read_parquet('{TEST_DIR}/sam_a.parquet') s, dim1 WHERE s.k = dim1.dk AND dim1.dname = 'a') AS a,
       (SELECT avg(disc) FROM read_parquet('{TEST_DIR}/sam_a.parquet') s, dim1 WHERE s.k = dim1.dk AND dim1.dname = 'b') AS b,
       (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') s, dim1 WHERE dim1.dk = s.k AND dim1.dname = 'c') AS c
----
physical_plan	<!REGEX>:[\s\S]*(Function: READ_PARQUET|Table: (\S*\.)?dim1)\b[\s\S]*(Function: READ_PARQUET|Table: (\S*\.)?dim1)\b[\s\S]*(Function: READ_PARQUET|Table: (\S*\.)?dim1)\b[\s\S]*

# ---- different scans stay apart ----------------------------------------------------------------------------------

# different files
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_b.parquet') WHERE q < 10) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: READ_PARQUET\b){2}[\s\S]*

# the same files, named differently
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_*.parquet') WHERE q < 10) AS a,
       (SELECT count(*) FROM read_parquet(['{TEST_DIR}/sam_a.parquet', '{TEST_DIR}/sam_b.parquet']) WHERE q < 10) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: READ_PARQUET\b){2}[\s\S]*

# the file named directly binds parquet_scan, a function of its own next to read_parquet
query II
EXPLAIN SELECT (SELECT count(*) FROM '{TEST_DIR}/sam_a.parquet' WHERE q < 10) AS a,
       (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q > 90) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: (PARQUET_SCAN|READ_PARQUET)\b){2}[\s\S]*

# the same file with different options
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT max(file_row_number) FROM read_parquet('{TEST_DIR}/sam_a.parquet', file_row_number := true) WHERE q > 90) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: READ_PARQUET\b){2}[\s\S]*

# a Parquet file and its CSV copy
query II
EXPLAIN SELECT (SELECT count(*) FROM read_parquet('{TEST_DIR}/sam_a.parquet') WHERE q < 10) AS a,
       (SELECT count(*) FROM read_csv('{TEST_DIR}/sam_sales.csv') WHERE q < 10) AS b
----
physical_plan	<REGEX>:([\s\S]*Function: (READ_PARQUET|READ_CSV)\b){2}[\s\S]*
