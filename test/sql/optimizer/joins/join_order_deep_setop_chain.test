# name: test/sql/optimizer/joins/join_order_deep_setop_chain.test
# description: Deeply nested set operations must not exhaust the stack in the join order optimizer (oss-fuzz)
# group: [joins]

# every EXCEPT nests three operators (set op, projection, distinct), each of which starts a nested join order
# optimizer; the recursion stops at 128 nested optimizers, so this 48-deep chain (144 levels) runs past the
# point where join order optimization stops and the rest of the plan keeps its original join order. The fuzzer case
# had ~200 EXCEPTs, which overflowed the stack in sanitizer builds; the chain is kept short here because debug
# verification re-plans every statement several times and its cost grows faster than linearly with the depth.

# the chain keeps its first value: the result survives the depth at which join order optimization stops
query I
SELECT 1 EXCEPT SELECT 2 EXCEPT SELECT 3 EXCEPT SELECT 4 EXCEPT SELECT 5 EXCEPT SELECT 6 EXCEPT SELECT 7 EXCEPT SELECT 8 EXCEPT SELECT 9 EXCEPT SELECT 10 EXCEPT SELECT 11 EXCEPT SELECT 12 EXCEPT SELECT 13 EXCEPT SELECT 14 EXCEPT SELECT 15 EXCEPT SELECT 16 EXCEPT SELECT 17 EXCEPT SELECT 18 EXCEPT SELECT 19 EXCEPT SELECT 20 EXCEPT SELECT 21 EXCEPT SELECT 22 EXCEPT SELECT 23 EXCEPT SELECT 24 EXCEPT SELECT 25 EXCEPT SELECT 26 EXCEPT SELECT 27 EXCEPT SELECT 28 EXCEPT SELECT 29 EXCEPT SELECT 30 EXCEPT SELECT 31 EXCEPT SELECT 32 EXCEPT SELECT 33 EXCEPT SELECT 34 EXCEPT SELECT 35 EXCEPT SELECT 36 EXCEPT SELECT 37 EXCEPT SELECT 38 EXCEPT SELECT 39 EXCEPT SELECT 40 EXCEPT SELECT 41 EXCEPT SELECT 42 EXCEPT SELECT 43 EXCEPT SELECT 44 EXCEPT SELECT 45 EXCEPT SELECT 46 EXCEPT SELECT 47 EXCEPT SELECT 48
----
1

# the same chain without the join order optimizer must agree
statement ok
SET disabled_optimizers='join_order'

query I
SELECT 1 EXCEPT SELECT 2 EXCEPT SELECT 3 EXCEPT SELECT 4 EXCEPT SELECT 5 EXCEPT SELECT 6 EXCEPT SELECT 7 EXCEPT SELECT 8 EXCEPT SELECT 9 EXCEPT SELECT 10 EXCEPT SELECT 11 EXCEPT SELECT 12 EXCEPT SELECT 13 EXCEPT SELECT 14 EXCEPT SELECT 15 EXCEPT SELECT 16 EXCEPT SELECT 17 EXCEPT SELECT 18 EXCEPT SELECT 19 EXCEPT SELECT 20 EXCEPT SELECT 21 EXCEPT SELECT 22 EXCEPT SELECT 23 EXCEPT SELECT 24 EXCEPT SELECT 25 EXCEPT SELECT 26 EXCEPT SELECT 27 EXCEPT SELECT 28 EXCEPT SELECT 29 EXCEPT SELECT 30 EXCEPT SELECT 31 EXCEPT SELECT 32 EXCEPT SELECT 33 EXCEPT SELECT 34 EXCEPT SELECT 35 EXCEPT SELECT 36 EXCEPT SELECT 37 EXCEPT SELECT 38 EXCEPT SELECT 39 EXCEPT SELECT 40 EXCEPT SELECT 41 EXCEPT SELECT 42 EXCEPT SELECT 43 EXCEPT SELECT 44 EXCEPT SELECT 45 EXCEPT SELECT 46 EXCEPT SELECT 47 EXCEPT SELECT 48
----
1

statement ok
SET disabled_optimizers=''
