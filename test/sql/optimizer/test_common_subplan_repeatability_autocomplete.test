# name: test/sql/optimizer/test_common_subplan_repeatability_autocomplete.test
# description: Preserve sharing of bound autocomplete results
# group: [optimizer]

require autocomplete

statement ok
SET explain_output='optimized_only';

query II
EXPLAIN (FORMAT JSON) SELECT * FROM sql_tokenize('SELECT 42') INTERSECT ALL SELECT * FROM sql_tokenize('SELECT 42');
----
logical_opt	<REGEX>:.*__common_subplan_.*

query II
EXPLAIN (FORMAT JSON) SELECT * FROM sql_auto_complete('SELECT ') INTERSECT ALL SELECT * FROM sql_auto_complete('SELECT ');
----
logical_opt	<REGEX>:.*__common_subplan_.*

query II
EXPLAIN (FORMAT JSON) SELECT * FROM check_peg_parser('SELECT 42') INTERSECT ALL SELECT * FROM check_peg_parser('SELECT 42');
----
logical_opt	<REGEX>:.*__common_subplan_.*
