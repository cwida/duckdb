# name: test/sql/optimizer/test_window_join_pushdown.test
# description: Test pushing filtering joins below window operators
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET explain_output = 'optimized_only';

statement ok
CREATE TABLE r (id INTEGER, b INTEGER, v INTEGER);

statement ok
INSERT INTO r VALUES (1, 10, 100), (2, 10, 200), (3, 20, 300), (4, 30, 400), (5, NULL, 500), (6, 20, 600);

# x is unique
statement ok
CREATE TABLE s (x INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO s VALUES (10, 'ten'), (20, 'twenty'), (40, 'forty');

# x is not unique
statement ok
CREATE TABLE s2 (x INTEGER, name VARCHAR);

statement ok
INSERT INTO s2 VALUES (10, 'a'), (10, 'b'), (20, 'c');

# count(*) detects any change in partition contents caused by a bad pushdown
statement ok
CREATE VIEW w AS
SELECT r.*,
	row_number() OVER (PARTITION BY b ORDER BY v) AS rn,
	count(*) OVER (PARTITION BY b) AS cnt
FROM r;

#
# Rule 9: Inner join, FD P → b and x unique
#

query II
EXPLAIN SELECT * FROM w JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query II
EXPLAIN SELECT * FROM w JOIN s ON w.b = s.x;
----
logical_opt	<!REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM w JOIN s ON w.b = s.x ORDER BY id;
----
1	10	100	1	2	10	ten
2	10	200	2	2	10	ten
3	20	300	1	2	20	twenty
6	20	600	2	2	20	twenty

# Window on the right side of an inner join is symmetric
query II
EXPLAIN SELECT * FROM s JOIN w ON s.x = w.b;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIIIII
SELECT * FROM s JOIN w ON s.x = w.b ORDER BY id;
----
10	ten	1	10	100	1	2
10	ten	2	10	200	2	2
20	twenty	3	20	300	1	2
20	twenty	6	20	600	2	2

# Uniqueness derived from GROUP BY instead of a primary key
query II
EXPLAIN SELECT * FROM w JOIN (SELECT x, count(*) AS n FROM s2 GROUP BY x) g ON w.b = g.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIIIII
SELECT * FROM w JOIN (SELECT x, count(*) AS n FROM s2 GROUP BY x) g ON w.b = g.x ORDER BY id;
----
1	10	100	1	2	10	2
2	10	200	2	2	10	2
3	20	300	1	2	20	1
6	20	600	2	2	20	1

# Uniqueness derived from DISTINCT
query II
EXPLAIN SELECT * FROM w JOIN (SELECT DISTINCT x FROM s2) d ON w.b = d.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIIII
SELECT * FROM w JOIN (SELECT DISTINCT x FROM s2) d ON w.b = d.x ORDER BY id;
----
1	10	100	1	2	10
2	10	200	2	2	10
3	20	300	1	2	20
6	20	600	2	2	20

# b only needs to be one of the partition keys
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY b, v ORDER BY id) AS rn FROM r) w2 JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY b, v ORDER BY id) AS rn FROM r) w2 JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1	10	ten
2	10	200	1	10	ten
3	20	300	1	20	twenty
6	20	600	1	20	twenty

# Inner join: x not unique, no pushdown
query II
EXPLAIN SELECT * FROM w JOIN s2 ON w.b = s2.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM w JOIN s2 ON w.b = s2.x ORDER BY id, name;
----
1	10	100	1	2	10	a
1	10	100	1	2	10	b
2	10	200	2	2	10	a
2	10	200	2	2	10	b
3	20	300	1	2	20	c
6	20	600	2	2	20	c

# Inner join: partition does not determine the join key, no pushdown
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1	10	ten
2	10	200	1	10	ten
3	20	300	1	20	twenty
6	20	600	1	20	twenty

# Inner join: every window expression must be partitioned by the join key
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY b ORDER BY v) AS rn, row_number() OVER (ORDER BY id) AS total FROM r) w2 JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY b ORDER BY v) AS rn, row_number() OVER (ORDER BY id) AS total FROM r) w2 JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1	1	10	ten
2	10	200	2	2	10	ten
3	20	300	1	3	20	twenty
6	20	600	2	6	20	twenty

#
# Rule 10: Left join, x unique
#

query II
EXPLAIN SELECT * FROM w LEFT JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIIIII
SELECT * FROM w LEFT JOIN s ON w.b = s.x ORDER BY id;
----
1	10	100	1	2	10	ten
2	10	200	2	2	10	ten
3	20	300	1	2	20	twenty
4	30	400	1	1	NULL	NULL
5	NULL	500	1	1	NULL	NULL
6	20	600	2	2	20	twenty

# Left join on a window output column must not be pushed below the window
statement ok
CREATE TABLE s1 (x BIGINT PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO s1 VALUES (1, 'one'), (2, 'two');

query IIIII
SELECT id, b, rn, cnt, name 
FROM w 
LEFT JOIN s1 
ON w.rn = s1.x 
ORDER BY id;
----
1	10	1	2	one
2	10	2	2	two
3	20	1	2	one
4	30	1	1	one
5	NULL	1	1	one
6	20	2	2	two

query IIIIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 LEFT JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1	10	ten
2	10	200	1	10	ten
3	20	300	1	20	twenty
4	30	400	1	NULL	NULL
5	NULL	500	1	NULL	NULL
6	20	600	1	20	twenty

# Left join without partitions
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (ORDER BY id) AS total FROM r) w2 LEFT JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIII
SELECT * FROM (SELECT r.*, row_number() OVER (ORDER BY id) AS total FROM r) w2 LEFT JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1	10	ten
2	10	200	2	10	ten
3	20	300	3	20	twenty
4	30	400	4	NULL	NULL
5	NULL	500	5	NULL	NULL
6	20	600	6	20	twenty

# Left join: x not unique, no pushdown
query II
EXPLAIN SELECT * FROM w LEFT JOIN s2 ON w.b = s2.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM w LEFT JOIN s2 ON w.b = s2.x ORDER BY id, name;
----
1	10	100	1	2	10	a
1	10	100	1	2	10	b
2	10	200	2	2	10	a
2	10	200	2	2	10	b
3	20	300	1	2	20	c
4	30	400	1	1	NULL	NULL
5	NULL	500	1	1	NULL	NULL
6	20	600	2	2	20	c

# Left join: window on the preserved side only
query II
EXPLAIN SELECT * FROM s LEFT JOIN w ON s.x = w.b;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM s LEFT JOIN w ON s.x = w.b ORDER BY x, id;
----
10	ten	1	10	100	1	2
10	ten	2	10	200	2	2
20	twenty	3	20	300	1	2
20	twenty	6	20	600	2	2
40	forty	NULL	NULL	NULL	NULL	NULL

#
# Rule 11: Semi join, FD P → b
#

query II
EXPLAIN SELECT * FROM w SEMI JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIII
SELECT * FROM w SEMI JOIN s ON w.b = s.x ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
6	20	600	2	2

# Semi join does not need x to be unique
query II
EXPLAIN SELECT * FROM w SEMI JOIN s2 ON w.b = s2.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIII
SELECT * FROM w SEMI JOIN s2 ON w.b = s2.x ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
6	20	600	2	2

# IS NOT DISTINCT FROM is also an equality
query II
EXPLAIN SELECT * FROM w SEMI JOIN s ON w.b IS NOT DISTINCT FROM s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIII
SELECT * FROM w SEMI JOIN s ON w.b IS NOT DISTINCT FROM s.x ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
6	20	600	2	2

# Semi join: partition does not determine the join key, no pushdown
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 SEMI JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 SEMI JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1
2	10	200	1
3	20	300	1
6	20	600	1

# Semi join: no partitions, no pushdown (filtering would change the window)
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (ORDER BY id) AS total FROM r) w2 SEMI JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIII
SELECT * FROM (SELECT r.*, row_number() OVER (ORDER BY id) AS total FROM r) w2 SEMI JOIN s ON w2.b = s.x ORDER BY id;
----
1	10	100	1
2	10	200	2
3	20	300	3
6	20	600	6

#
# Rule 12: Anti join, FD P → b
#

query II
EXPLAIN SELECT * FROM w ANTI JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIII
SELECT * FROM w ANTI JOIN s ON w.b = s.x ORDER BY id;
----
4	30	400	1	1
5	NULL	500	1	1

# Anti join does not need x to be unique
query II
EXPLAIN SELECT * FROM w ANTI JOIN s2 ON w.b = s2.x;
----
logical_opt	<REGEX>:.*WINDOW.*COMPARISON_JOIN.*

query IIIII
SELECT * FROM w ANTI JOIN s2 ON w.b = s2.x ORDER BY id;
----
4	30	400	1	1
5	NULL	500	1	1

# Anti join: partition does not determine the join key, no pushdown
query II
EXPLAIN SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 ANTI JOIN s ON w2.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIII
SELECT * FROM (SELECT r.*, row_number() OVER (PARTITION BY v ORDER BY id) AS rn FROM r) w2 ANTI JOIN s ON w2.b = s.x ORDER BY id;
----
4	30	400	1
5	NULL	500	1

#
# Unsupported join shapes
#

# Non-equality condition
query II
EXPLAIN SELECT * FROM w SEMI JOIN s ON w.b < s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIII
SELECT * FROM w SEMI JOIN s ON w.b < s.x ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
4	30	400	1	1
6	20	600	2	2

# Multiple conditions
query II
EXPLAIN SELECT * FROM w SEMI JOIN s ON w.b = s.x AND w.v < s.x * 100;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIII
SELECT * FROM w SEMI JOIN s ON w.b = s.x AND w.v < s.x * 100 ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
6	20	600	2	2

# Full outer join
query II
EXPLAIN SELECT * FROM w FULL JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIIIII
SELECT * FROM w FULL JOIN s ON w.b = s.x ORDER BY id, x;
----
1	10	100	1	2	10	ten
2	10	200	2	2	10	ten
3	20	300	1	2	20	twenty
4	30	400	1	1	NULL	NULL
5	NULL	500	1	1	NULL	NULL
6	20	600	2	2	20	twenty
NULL	NULL	NULL	NULL	NULL	40	forty

#
# Disabling the optimizer
#

statement ok
SET disabled_optimizers = 'window_join_pushdown';

query II
EXPLAIN SELECT * FROM w SEMI JOIN s ON w.b = s.x;
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*WINDOW.*

query IIIII
SELECT * FROM w SEMI JOIN s ON w.b = s.x ORDER BY id;
----
1	10	100	1	2
2	10	200	2	2
3	20	300	1	2
6	20	600	2	2
