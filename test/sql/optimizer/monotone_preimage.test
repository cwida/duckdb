# name: test/sql/optimizer/monotone_preimage.test
# description: Rewrite f(col) OP const into a range on col via the monotone preimage (bisection)
# group: [optimizer]

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

# 500k rows -> 5 row groups; dt increases with the row id
statement ok
CREATE TABLE d AS SELECT (DATE '1970-01-01' + INTERVAL (range) DAY)::DATE AS dt FROM range(500000);

# year() is strictly increasing on finite dates: year(dt) = 2020 becomes a direct date range,
# and year() is dropped from the plan entirely (full replacement).
query II
EXPLAIN SELECT count(*) FROM d WHERE year(dt) = 2020;
----
logical_opt	<REGEX>:.*dt >= '2020-01-01'.*dt <= '2020-12-31'.*

query II
EXPLAIN SELECT count(*) FROM d WHERE year(dt) = 2020;
----
logical_opt	<!REGEX>:.*year.*

# ordering comparisons rewrite to a single-sided date bound
query II
EXPLAIN SELECT count(*) FROM d WHERE year(dt) < 1975;
----
logical_opt	<REGEX>:.*dt <= '1974-12-31'.*

query II
EXPLAIN SELECT count(*) FROM d WHERE year(dt) >= 2020;
----
logical_opt	<REGEX>:.*dt >= '2020-01-01'.*

# the rewritten range is sargable: it prunes row groups on the base column zonemap
query II
EXPLAIN ANALYZE SELECT count(*) FROM d WHERE year(dt) = 2020;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 5.*

# non-monotone functions (month cycles 1..12) must NOT be rewritten
query II
EXPLAIN SELECT count(*) FROM d WHERE month(dt) = 6;
----
logical_opt	<REGEX>:.*month.*

# ---------------------------------------------------------------------------
# correctness, including infinity (year(±inf) = NULL) and NULL rows
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE e(dt DATE);

statement ok
INSERT INTO e VALUES ('2020-06-15'), ('2019-01-01'), ('2021-12-31'), ('infinity'), ('-infinity'), (NULL);

query I
SELECT count(*) FROM e WHERE year(dt) = 2020;
----
1

# > must exclude +infinity AND -infinity (both have year = NULL)
query I
SELECT count(*) FROM e WHERE year(dt) > 2020;
----
1

query I
SELECT count(*) FROM e WHERE year(dt) < 2020;
----
1

query I
SELECT count(*) FROM e WHERE year(dt) >= 2020;
----
2

query I
SELECT count(*) FROM e WHERE year(dt) <= 2020;
----
2

# Infinity-domain rewrites are only safe in root filter predicates: projections and nested boolean
# contexts must preserve the NULL result of year(±infinity).
query I
SELECT year(dt) = 2020 FROM e ORDER BY dt NULLS LAST;
----
NULL
false
true
false
NULL
NULL

query I
SELECT count(*) FROM e WHERE (year(dt) = 2020) IS FALSE;
----
2

# empty preimage over a type without infinity folds to false-or-null (preserves NULL rows)
statement ok
CREATE TABLE ints(x INTEGER);

statement ok
INSERT INTO ints VALUES (1), (2), (3), (NULL);

# differential vs a pushdown barrier (OFFSET 0) on a mixed dataset across every operator
statement ok
CREATE TABLE big AS
  SELECT (DATE '1900-01-01' + INTERVAL (range) DAY)::DATE AS dt FROM range(200000)
  UNION ALL SELECT 'infinity'::DATE UNION ALL SELECT '-infinity'::DATE UNION ALL SELECT NULL::DATE;

query I
SELECT count(*) FROM (
  SELECT 1 FROM big WHERE year(dt) > 2000
  EXCEPT ALL SELECT 1 FROM (SELECT dt FROM big OFFSET 0) WHERE year(dt) > 2000
);
----
0

query I
SELECT count(*) FROM (
  SELECT 1 FROM (SELECT dt FROM big OFFSET 0) WHERE year(dt) > 2000
  EXCEPT ALL SELECT 1 FROM big WHERE year(dt) > 2000
);
----
0

# ---------------------------------------------------------------------------
# TIMESTAMP columns (int64 domain) rewrite too, via the overflow-safe bisection
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE ts AS SELECT ('2020-01-01'::TIMESTAMP + INTERVAL (range) MINUTE) AS t FROM range(1000000);

query II
EXPLAIN SELECT count(*) FROM ts WHERE year(t) = 2020;
----
logical_opt	<REGEX>:.*t <= '2020-12-31 23:59:59.999999'.*

query II
EXPLAIN SELECT count(*) FROM ts WHERE year(t) = 2020;
----
logical_opt	<!REGEX>:.*year.*

# correctness on TIMESTAMP with ±infinity and NULL, differential vs a pushdown barrier
statement ok
CREATE TABLE ets AS
  SELECT ('2000-01-01'::TIMESTAMP + INTERVAL (range) HOUR) AS t FROM range(200000)
  UNION ALL SELECT 'infinity'::TIMESTAMP UNION ALL SELECT '-infinity'::TIMESTAMP UNION ALL SELECT NULL::TIMESTAMP;

query I
SELECT count(*) FROM (
  SELECT 1 FROM ets WHERE year(t) > 2010
  EXCEPT ALL SELECT 1 FROM (SELECT t FROM ets OFFSET 0) WHERE year(t) > 2010
);
----
0

query I
SELECT count(*) FROM (
  SELECT 1 FROM (SELECT t FROM ets OFFSET 0) WHERE year(t) > 2010
  EXCEPT ALL SELECT 1 FROM ets WHERE year(t) > 2010
);
----
0

query I
SELECT count(*) FROM ets WHERE year(t) = 2005;
----
8760

# ---------------------------------------------------------------------------
# bounds on the edge of the TIMESTAMP domain.  Every int64 except the two infinity sentinels is a valid
# timestamp that renders. The rewrite searches between the sentinels, and a bound on its edge is written as a
# strict comparison against the adjacent sentinel (t > '-infinity', t < 'infinity'), or as t != '-infinity'
# when the finite INT64_MIN below -infinity satisfies the comparison too.
# ---------------------------------------------------------------------------
query II
EXPLAIN SELECT count(*) FROM ets WHERE epoch(t) > -9223372036854775807;
----
logical_opt	<REGEX>:.*t != '-infinity'.*

query II
EXPLAIN SELECT count(*) FROM ets WHERE epoch(t) < 9223372036854775807;
----
logical_opt	<REGEX>:.*t != '-infinity'.*t < 'infinity'.*

query II
EXPLAIN SELECT count(*) FROM ets WHERE epoch(t) > -9223372036854775807;
----
logical_opt	<!REGEX>:.*epoch.*

statement ok
EXPLAIN ANALYZE SELECT count(*) FROM ets WHERE epoch(t) > -9223372036854775807;

statement ok
EXPLAIN SELECT count(*) FROM ets WHERE epoch_ms(t) > -9223372036854775807;

statement ok
EXPLAIN SELECT count(*) FROM ets WHERE year(t) > -1000000000;

# the rewrite stays exact: every finite row passes, ±infinity (epoch = NULL) and NULL do not
query I
SELECT count(*) FROM ets WHERE epoch(t) > -9223372036854775807;
----
200000

query I
SELECT count(*) FROM ets WHERE epoch(t) < 9223372036854775807;
----
200000

# the smallest finite timestamp above the -infinity sentinel (INT64_MIN + 2) is a valid row that the rewrite
# must keep
statement ok
CREATE TABLE ts_min(t TIMESTAMP);

statement ok
INSERT INTO ts_min VALUES (make_timestamp(-9223372036854775806));

query I
SELECT count(*) FROM ts_min WHERE epoch(t) > -9223372036854775807;
----
1

# both ends of the finite domain, the first midnight of the range, ±infinity and NULL
statement ok
CREATE TABLE edge(t TIMESTAMP);

statement ok
INSERT INTO edge VALUES
  (make_timestamp(-9223372036854775806)), ('290309-12-22 (BC) 00:00:00'), ('2000-01-01'),
  (make_timestamp(9223372036854775806)), ('-infinity'), ('infinity'), (NULL);

query I
SELECT count(*) FROM edge WHERE epoch(t) > -9223372036854775807;
----
4

query I
SELECT count(*) FROM edge WHERE epoch(t) < 9223372036854775807;
----
4

query I
SELECT count(*) FROM edge WHERE year(t) > -1000000000;
----
4

# epoch_us is the identity on the internal value: bounds land exactly on the domain edges...
query I
SELECT count(*) FROM edge WHERE epoch_us(t) >= -9223372036854775806;
----
4

query I
SELECT count(*) FROM edge WHERE epoch_us(t) <= 9223372036854775806;
----
4

query II
EXPLAIN SELECT count(*) FROM edge WHERE epoch_us(t) <= 9223372036854775806;
----
logical_opt	<REGEX>:.*t != '-infinity'.*t < 'infinity'.*

# ... or one step inside the domain, below the first midnight of the range
query I
SELECT count(*) FROM edge WHERE epoch_us(t) > -9223372036854775806;
----
3

query I
SELECT count(*) FROM edge WHERE epoch_us(t) < -9223372036854775805;
----
1

query I
SELECT count(*) FROM edge WHERE epoch_us(t) = -9223372036854775806;
----
1

query II
EXPLAIN SELECT count(*) FROM edge WHERE epoch_us(t) > -9223372036854775806;
----
logical_opt	<REGEX>:.*t >= '290309-12-21 \(BC\) 19:59:05.224195'.*

query I
SELECT count(*) FROM edge WHERE epoch_us(t) >= -9223372036854775000;
----
3

statement ok
EXPLAIN SELECT count(*) FROM edge WHERE epoch_us(t) >= -9223372036854775000;

# the top of the domain renders, so a preimage ending there is a plain range
query I
SELECT count(*) FROM edge WHERE epoch_us(t) = 9223372036854775806;
----
1

query II
EXPLAIN SELECT count(*) FROM edge WHERE epoch_us(t) = 9223372036854775806;
----
logical_opt	<REGEX>:.*t >= '294247-01-10 04:00:54.775806'.*t < 'infinity'.*

# differential check of every operator against a pushdown barrier on the edge rows
foreach op > >= < <= =

foreach c -9223372036854775806 -9223372036854775805 -9223372022400000000 946684800000000 9223372036854775806

query I
SELECT count(*) FROM (
  SELECT 1 FROM edge WHERE epoch_us(t) {op} {c}
  EXCEPT ALL SELECT 1 FROM (SELECT t FROM edge OFFSET 0) WHERE epoch_us(t) {op} {c}
) UNION ALL SELECT count(*) FROM (
  SELECT 1 FROM (SELECT t FROM edge OFFSET 0) WHERE epoch_us(t) {op} {c}
  EXCEPT ALL SELECT 1 FROM edge WHERE epoch_us(t) {op} {c}
);
----
0
0

endloop

endloop

# INT64_MIN is finite but sorts below the -infinity sentinel, outside the searched domain
statement ok
CREATE TABLE below(t TIMESTAMP);

statement ok
INSERT INTO below VALUES (make_timestamp(-9223372036854775807 - 1)), (make_timestamp(-9223372036854775806)), ('-infinity'), (NULL);

query IIII
SELECT count(*) FILTER (epoch_us(t) <= -9223372036854775806), count(*) FILTER (epoch(t) > -9223372036854775807),
       count(*) FILTER (epoch_us(t) >= -9223372036854775806), count(*) FILTER (year(t) < 2000) FROM below;
----
2	2	1	2

query I
SELECT count(*) FROM below WHERE epoch_us(t) <= -9223372036854775806;
----
2

query I
SELECT count(*) FROM below WHERE epoch(t) > -9223372036854775807;
----
2

query I
SELECT count(*) FROM below WHERE epoch_us(t) >= -9223372036854775806;
----
1

query I
SELECT count(*) FROM below WHERE year(t) < 2000;
----
2

query III
SELECT (SELECT count(*) FROM below WHERE year(t) = -290308), (SELECT count(*) FROM below WHERE epoch_us(t) = -9223372036854775806),
       (SELECT count(*) FROM below WHERE epoch_us(t) = -9223372036854775807 - 1);
----
2	1	1

query II
EXPLAIN SELECT count(*) FROM below WHERE year(t) < 2000;
----
logical_opt	<REGEX>:.*t != '-infinity'.*

# DATE: every non-sentinel int32 renders, the domain edges are still written against the sentinels
statement ok
CREATE TABLE edge_d(dt DATE);

statement ok
INSERT INTO edge_d VALUES
  (make_date(-2147483646)), ('2000-01-01'), (make_date(2147483646)), ('-infinity'), ('infinity'), (NULL);

query I
SELECT count(*) FROM edge_d WHERE epoch(dt) > -9223372036854775807;
----
3

query I
SELECT count(*) FROM edge_d WHERE year(dt) > -1000000000;
----
3

# the smallest finite DATE sorts below its -infinity sentinel too
statement ok
CREATE TABLE below_d(dt DATE);

statement ok
INSERT INTO below_d VALUES (make_date(-2147483647 - 1)), (make_date(-2147483646)), ('-infinity'), (NULL);

query I
SELECT count(*) FROM below_d WHERE year(dt) < 2000;
----
2

query II
EXPLAIN SELECT count(*) FROM edge_d WHERE year(dt) > -1000000000;
----
logical_opt	<REGEX>:.*dt != '-infinity'.*dt < 'infinity'.*
