# name: test/sql/optimizer/test_common_subplan_repeatability.test
# description: Preserve common subplan sharing for repeatable table functions
# group: [optimizer]

statement ok
SET explain_output='optimized_only';

statement ok
CREATE TABLE repeatable_input AS SELECT * FROM (VALUES (1), (1), (NULL::INTEGER)) t(i);

# Repeated bound values retain their scan and window sharing.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM repeat(7, 10) INTERSECT ALL SELECT * FROM repeat(7, 10);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM repeat(7, 10) INTERSECT ALL SELECT * FROM repeat(7, 10));
----
10

# NULL rows still participate in ALL multiplicity.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM repeat(NULL::INTEGER, 3) INTERSECT ALL SELECT * FROM repeat(NULL::INTEGER, 3);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM repeat(NULL::INTEGER, 3) INTERSECT ALL SELECT * FROM repeat(NULL::INTEGER, 3));
----
3

# Nested bound values.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM repeat_row([1,NULL], {'a': 'x'}, num_rows=3) INTERSECT ALL SELECT * FROM repeat_row([1,NULL], {'a': 'x'}, num_rows=3);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM repeat_row([1,NULL], {'a': 'x'}, num_rows=3) INTERSECT ALL SELECT * FROM repeat_row([1,NULL], {'a': 'x'}, num_rows=3));
----
3

# Unnest with duplicates and NULLs.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM unnest([1,1,NULL]) INTERSECT ALL SELECT * FROM unnest([1,1,NULL]);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM unnest([1,1,NULL]) INTERSECT ALL SELECT * FROM unnest([1,1,NULL]));
----
3

# Summary depends only on its input rows.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM summary((SELECT 7 i)) INTERSECT ALL SELECT * FROM summary((SELECT 7 i));
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM summary((SELECT 7 i)) INTERSECT ALL SELECT * FROM summary((SELECT 7 i)));
----
1

# Existing range capability.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM range(3) INTERSECT ALL SELECT * FROM range(3);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM range(3) INTERSECT ALL SELECT * FROM range(3));
----
3

# Existing generate_series capability.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM generate_series(1,3) INTERSECT ALL SELECT * FROM generate_series(1,3);
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM generate_series(1,3) INTERSECT ALL SELECT * FROM generate_series(1,3));
----
3

# Catalog rows retain duplicates and NULLs.
query II
EXPLAIN (FORMAT JSON) SELECT * FROM repeatable_input INTERSECT ALL SELECT * FROM repeatable_input;
----
logical_opt	<REGEX>:.*__common_subplan_.*

query I
SELECT count(*) FROM (SELECT * FROM repeatable_input INTERSECT ALL SELECT * FROM repeatable_input);
----
3

# Empty inputs must remain empty.
query I
SELECT count(*) FROM (SELECT * FROM repeat_row(1, num_rows=0) INTERSECT ALL SELECT * FROM repeat_row(1, num_rows=0));
----
0

# A repeatable function cannot make its volatile input repeatable.
statement ok
CREATE SEQUENCE repeatability_seq;

query I
SELECT count(*) FROM (
    SELECT * FROM unnest([nextval('repeatability_seq')])
    INTERSECT ALL
    SELECT * FROM unnest([nextval('repeatability_seq')]));
----
0

# Live execution statistics do not promise repeatability.
query II
EXPLAIN (FORMAT JSON)
SELECT * FROM duckdb_memory() INTERSECT ALL SELECT * FROM duckdb_memory();
----
logical_opt	<!REGEX>:.*__common_subplan_.*

# The capability is also consumed by disjunctive join rewriting.
query I
SELECT count(*) FROM unnest([1,1,NULL,3]) a(i)
JOIN repeat_row(1, num_rows=2) b ON a.i=b.column0 OR a.i=b.column0+2;
----
6

query II
EXPLAIN (FORMAT JSON)
SELECT * FROM unnest([1,1,NULL]::INTEGER[3])
INTERSECT ALL SELECT * FROM unnest([1,1,NULL]::INTEGER[3]);
----
logical_opt	<REGEX>:.*__common_subplan_.*
