# name: test/sql/optimizer/statistics/struct_default_null_handling.test
# description: DEFAULT_NULL_HANDLING nested functions with all-NULL inputs
# group: [statistics]

# The column statistics say every value is NULL, so the NULL reaches the
# function through statistics rather than through a literal.
