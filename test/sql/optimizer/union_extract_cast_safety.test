# name: test/sql/optimizer/union_extract_cast_safety.test
# description: Extract pushdown preserves conditional evaluation of throwing casts
# group: [optimizer]

statement ok
CREATE TABLE guarded_casts(id INTEGER, v VARIANT, s STRUCT(k VARCHAR));

statement ok
INSERT INTO guarded_casts VALUES (1, {'k': 1}::VARIANT, {'k': '1'}), (2, {'k': 'bad'}::VARIANT, {'k': 'bad'});

foreach FIELD v s

query I rowsort
SELECT CASE WHEN id = 1 THEN {FIELD}.k::INTEGER END
FROM (SELECT id, {FIELD} FROM guarded_casts UNION ALL SELECT id, {FIELD} FROM guarded_casts);
----
1
1
NULL
NULL

query I rowsort
SELECT id FROM (SELECT id, {FIELD} FROM guarded_casts UNION ALL SELECT id, {FIELD} FROM guarded_casts)
WHERE CASE WHEN id = 1 THEN {FIELD}.k::INTEGER = 1 ELSE false END;
----
1
1

query I rowsort
SELECT CASE WHEN id = 1 THEN {FIELD}.k::INTEGER END FROM (SELECT id, {FIELD} FROM guarded_casts);
----
1
NULL

query I rowsort
SELECT IF(id = 1, {FIELD}.k::INTEGER, NULL)
FROM (SELECT id, {FIELD} FROM guarded_casts UNION ALL SELECT id, {FIELD} FROM guarded_casts);
----
1
1
NULL
NULL

query I rowsort
SELECT COALESCE(CASE WHEN id = 2 THEN 42 END, {FIELD}.k::INTEGER)
FROM (SELECT id, {FIELD} FROM guarded_casts UNION ALL SELECT id, {FIELD} FROM guarded_casts);
----
1
1
42
42

query I rowsort
SELECT COALESCE(CASE WHEN id = 2 THEN 42 END, {FIELD}.k::INTEGER) FROM (SELECT id, {FIELD} FROM guarded_casts);
----
1
42

query I rowsort
SELECT {FIELD}.k::INTEGER
FROM (SELECT id, {FIELD} FROM guarded_casts UNION ALL SELECT id, {FIELD} FROM guarded_casts)
WHERE id + random() * 0 = 1;
----
1
1

query I rowsort
SELECT TRY({FIELD}.k::INTEGER)
FROM (SELECT {FIELD} FROM guarded_casts UNION ALL SELECT {FIELD} FROM guarded_casts);
----
1
1
NULL
NULL

query I rowsort
SELECT has_error({FIELD}.k::INTEGER)
FROM (SELECT {FIELD} FROM guarded_casts UNION ALL SELECT {FIELD} FROM guarded_casts);
----
false
false
true
true

endloop

# A throwing conversion beneath an extract must stay inside the guard as well.
query I rowsort
SELECT CASE WHEN id = 1 THEN (s::STRUCT(k INTEGER)).k END
FROM (SELECT id, s FROM guarded_casts UNION ALL SELECT id, s FROM guarded_casts);
----
1
1
NULL
NULL

query I rowsort
SELECT TRY((s::STRUCT(k INTEGER)).k)
FROM (SELECT s FROM guarded_casts UNION ALL SELECT s FROM guarded_casts);
----
1
1
NULL
NULL

# Constant-key VARIANT extracts return NULL for missing keys and non-object values.
statement ok
CREATE TABLE guarded_extracts AS SELECT id, v FROM (VALUES
    (1, {'k': {'x': 1}}::VARIANT), (2, 42::VARIANT), (3, {'other': 3}::VARIANT)) t(id, v);

query I rowsort
SELECT TRY(v.k.x::INTEGER)
FROM (SELECT v FROM guarded_extracts UNION ALL SELECT v FROM guarded_extracts);
----
1
1
NULL
NULL
NULL
NULL
