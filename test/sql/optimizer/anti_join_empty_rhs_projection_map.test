# k is only ever 1: the ANTI join condition k = 1000 is proven false by the statistics
statement ok
CREATE TABLE t_mid(dec DECIMAL(18,3), k BIGINT);

statement ok
INSERT INTO t_mid VALUES (-615.000, 1);

statement ok
CREATE TABLE t_small(i BIGINT, g BIGINT);

statement ok
INSERT INTO t_small VALUES (0, 0);

# the IN never matches either: no row of t_big has i = 0
query I
SELECT t1.i32
FROM t_del t1
JOIN t_big t2 ON t1.i = t2.i
ANTI JOIN t_mid t3 ON t2.dec = t3.dec AND t3.k = 1000
WHERE t1.tsz IS NULL
  AND t2.i IN (SELECT i FROM t_small WHERE g = t2.g);
----

query I
SELECT t1.i32
FROM t_del t1
JOIN t_big t2 ON t1.i = t2.i
ANTI JOIN t_mid t3 ON t2.dec = t3.dec AND t3.k = 1000
WHERE t1.tsz IS NULL
  AND EXISTS (SELECT 1 FROM t_small s WHERE s.g = t2.g AND s.i = t2.i);
----

# the only t_del row with a NULL tsz is i = 35, which matches t_big (35, -610.695, 0)
statement ok
INSERT INTO t_small VALUES (35, 0);

query I
SELECT t1.i32
FROM t_del t1
JOIN t_big t2 ON t1.i = t2.i
ANTI JOIN t_mid t3 ON t2.dec = t3.dec AND t3.k = 1000
WHERE t1.tsz IS NULL
  AND t2.i IN (SELECT i FROM t_small WHERE g = t2.g);
----
27159

query II
SELECT t1.i32, t2.g
FROM t_del t1
JOIN t_big t2 ON t1.i = t2.i
ANTI JOIN t_mid t3 ON t2.dec = t3.dec AND t3.k = 1000
WHERE t1.tsz IS NULL
  AND t2.i IN (SELECT i FROM t_small WHERE g = t2.g);
----
27159	0

query I
SELECT t1.i32
FROM t_del t1
JOIN t_big t2 ON t1.i = t2.i
ANTI JOIN t_mid t3 ON t2.dec = t3.dec AND t3.k = 1000
WHERE t1.tsz IS NULL
  AND EXISTS (SELECT 1 FROM t_small s WHERE s.g = t2.g AND s.i = t2.i);
