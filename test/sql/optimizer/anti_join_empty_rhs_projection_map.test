# name: test/sql/optimizer/anti_join_empty_rhs_projection_map.test
# description: Issue #27091: an ANTI join whose right side becomes empty during filter pushdown must keep its output layout
# group: [optimizer]

# the row counts drive the plan: the join with t_big on i and a correlated IN on (i, g) under an ANTI join on dec
statement ok
CREATE TABLE t_del(i BIGINT, i32 INTEGER, tsz TIMESTAMPTZ);

