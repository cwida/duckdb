# name: test/sql/optimizer/plan/test_except_empty_rhs.test
# description: EXCEPT with an empty RHS returns the distinct rows of its LHS
# group: [plan]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
pragma explain_output='OPTIMIZED_ONLY'

query I
SELECT * FROM (SELECT 1) lhs
EXCEPT
SELECT * FROM (SELECT 1 WHERE 1=0) rhs
----
1

query II
EXPLAIN SELECT * FROM (SELECT 1) lhs
EXCEPT
SELECT * FROM (SELECT 1 WHERE 1=0) rhs
----
logical_opt	<REGEX>:.*DISTINCT.*

query II
EXPLAIN SELECT * FROM (SELECT 1) lhs
EXCEPT
SELECT * FROM (SELECT 1 WHERE 1=0) rhs
----
logical_opt	<!REGEX>:.*ANTI.*

query I
SELECT * FROM (SELECT 1 UNION ALL SELECT 1) lhs
EXCEPT
SELECT * FROM (SELECT 1 WHERE 1=0) rhs
----
1

query I
SELECT * FROM (SELECT 42 EXCEPT SELECT 43) tbl(i) WHERE i = 42
----
42
