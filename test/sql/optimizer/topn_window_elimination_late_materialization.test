# name: test/sql/optimizer/topn_window_elimination_late_materialization.test
# description: Top-N window elimination must not drop value-transforming expressions during late materialization
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY

# Issue #22849: a payload that is a scalar function of a base column (parse_filename(path))
# was rebuilt by the rowid semi-join as the raw base column, dropping the function.

statement ok
CREATE TABLE sample_table AS
SELECT generate_series AS id, id % 4 AS partition_key, id % 7 AS sort_key, 'C:/file.txt' AS path
FROM generate_series(10);

statement ok
CREATE VIEW sample_view AS SELECT *, parse_filename(path) AS filename FROM sample_table;

# The window should still be eliminated (no FILTER over WINDOW left in the plan)...
query II
EXPLAIN SELECT * FROM sample_view
QUALIFY row_number() OVER (PARTITION BY partition_key ORDER BY sort_key) = 1
----
logical_opt	<!REGEX>:.*FILTER.*WINDOW.*

# ...but late materialization must not be used, because parse_filename cannot be
# reconstructed from a plain rowid re-scan.
query II
EXPLAIN SELECT * FROM sample_view
QUALIFY row_number() OVER (PARTITION BY partition_key ORDER BY sort_key) = 1
----
logical_opt	<!REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

# filename must be the parsed file name, not the original path
query IIIII
SELECT id, partition_key, sort_key, path, filename FROM sample_view
QUALIFY row_number() OVER (PARTITION BY partition_key ORDER BY sort_key) = 1
ORDER BY partition_key
----
0	0	0	C:/file.txt	file.txt
1	1	1	C:/file.txt	file.txt
2	2	2	C:/file.txt	file.txt
7	3	0	C:/file.txt	file.txt

# Differential check against the same query with the optimizer disabled
statement ok
SET disabled_optimizers = 'top_n_window_elimination'

query IIIII
SELECT id, partition_key, sort_key, path, filename FROM sample_view
QUALIFY row_number() OVER (PARTITION BY partition_key ORDER BY sort_key) = 1
ORDER BY partition_key
----
0	0	0	C:/file.txt	file.txt
1	1	1	C:/file.txt	file.txt
2	2	2	C:/file.txt	file.txt
7	3	0	C:/file.txt	file.txt

statement ok
SET disabled_optimizers = ''

# A few more value-transforming payloads, checked against the disabled-optimizer result.

statement ok
CREATE TABLE t(id INTEGER, g INTEGER, s INTEGER, v VARCHAR, n INTEGER)

statement ok
INSERT INTO t VALUES (1, 0, 5, 'aa', 10), (2, 0, 3, 'bb', 20), (3, 1, 2, 'cc', 30), (4, 1, 9, 'dd', 40), (5, 0, 1, 'ee', 50)

# upper() payload, single row per group
query II
SELECT id, upper(v) FROM (SELECT *, upper(v) AS uv FROM t)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) = 1
ORDER BY g
----
5	EE
3	CC

# arithmetic payload
query II
SELECT id, np FROM (SELECT *, n + 1 AS np FROM t)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) = 1
ORDER BY g
----
5	51
3	31

# A value-transforming partition projection must also not be reconstructed by
# the rowid semi-join, because the join outputs the LHS group columns.
query II
EXPLAIN SELECT id, gp, v FROM (SELECT id, g + 1 AS gp, s, v FROM t)
QUALIFY row_number() OVER (PARTITION BY gp ORDER BY s) = 1
----
logical_opt	<!REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

query III
SELECT id, gp, v FROM (SELECT id, g + 1 AS gp, s, v FROM t)
QUALIFY row_number() OVER (PARTITION BY gp ORDER BY s) = 1
ORDER BY gp
----
5	1	ee
3	2	cc

# top-2 (limit > 1) with a function payload
query II
SELECT id, uv FROM (SELECT *, upper(v) AS uv FROM t)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) <= 2
ORDER BY g, id
----
2	BB
5	EE
3	CC
4	DD

# single function payload (no extra columns), exercises the min/max arg path
query I
SELECT uv FROM (SELECT *, upper(v) AS uv FROM t)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) = 1
ORDER BY uv
----
CC
EE

# a cast wrapping a function must also be preserved
query II
SELECT id, cf FROM (SELECT *, CAST(upper(v) AS VARCHAR) AS cf FROM t)
QUALIFY row_number() OVER (PARTITION BY g ORDER BY s) = 1
ORDER BY g
----
5	EE
3	CC

# A plain cast of a base column should still use late materialization (issue #22096 behaviour).
statement ok
CREATE TABLE casted (a VARCHAR, b BOOLEAN, c VARCHAR)

statement ok
INSERT INTO casted VALUES ('x', false, '2024-01-01')

query II
EXPLAIN WITH cte AS (SELECT a, b, c::TIMESTAMPTZ AS c FROM casted)
SELECT * FROM cte QUALIFY row_number() OVER (PARTITION BY a ORDER BY c DESC) = 1
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

query III
WITH cte AS (SELECT a, b, c::TIMESTAMPTZ AS c FROM casted)
SELECT * FROM cte QUALIFY row_number() OVER (PARTITION BY a ORDER BY c DESC) = 1
----
x	false	2024-01-01 00:00:00+00

# Issue #24609: a TRY_CAST payload must keep its NULL semantics. The rowid late-materialization
# path reconstructs the payload with a strict default cast, turning TRY_CAST failures of winning
# rows into Conversion Errors.

statement ok
CREATE TABLE try_cast_t (key VARCHAR, ts INTEGER, val VARCHAR, note VARCHAR);

statement ok
INSERT INTO try_cast_t VALUES ('a', 1, '100', 'n1'), ('a', 2, 'oops', 'n2'), ('b', 1, '7', 'n3'), ('b', 2, '8', 'n4');

# The window is still eliminated ...
query II
EXPLAIN SELECT key, v, note FROM (
  SELECT key, ts, TRY_CAST(val AS INTEGER) AS v, note FROM try_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
----
logical_opt	<!REGEX>:.*FILTER.*WINDOW.*

# ... but late materialization must not be used, because a TRY_CAST cannot be
# reconstructed as a strict cast.
query II
EXPLAIN SELECT key, v, note FROM (
  SELECT key, ts, TRY_CAST(val AS INTEGER) AS v, note FROM try_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
----
logical_opt	<!REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

# Un-castable winning rows must yield NULL, not a Conversion Error
query III
SELECT key, v, note FROM (
  SELECT key, ts, TRY_CAST(val AS INTEGER) AS v, note FROM try_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
ORDER BY key
----
a	NULL	n2
b	8	n4

# Issue #24609: a nested cast payload must not be reconstructed as a plain raw-column
# projection, which would silently drop the intermediate conversion.

statement ok
CREATE TABLE nested_cast_t (key VARCHAR, ts INTEGER, x DOUBLE, note VARCHAR);

statement ok
INSERT INTO nested_cast_t VALUES ('a', 1, 1.1, 'n1'), ('a', 2, 3.7, 'n2'), ('b', 1, 2.2, 'n3'), ('b', 2, 8.9, 'n4');

# The window is still eliminated ...
query II
EXPLAIN SELECT key, r, note FROM (
  SELECT key, ts, CAST(CAST(x AS INTEGER) AS DOUBLE) AS r, note FROM nested_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
----
logical_opt	<!REGEX>:.*FILTER.*WINDOW.*

# ... but late materialization must not be used, because the cast chain cannot be
# reconstructed from a single default cast.
query II
EXPLAIN SELECT key, r, note FROM (
  SELECT key, ts, CAST(CAST(x AS INTEGER) AS DOUBLE) AS r, note FROM nested_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
----
logical_opt	<!REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

# The intermediate integer truncation must be preserved
query III
SELECT key, r, note FROM (
  SELECT key, ts, CAST(CAST(x AS INTEGER) AS DOUBLE) AS r, note FROM nested_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
ORDER BY key
----
a	4	n2
b	9	n4

# Differential check of both shapes against the same queries with the optimizer disabled
statement ok
SET disabled_optimizers = 'top_n_window_elimination'

query III
SELECT key, v, note FROM (
  SELECT key, ts, TRY_CAST(val AS INTEGER) AS v, note FROM try_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
ORDER BY key
----
a	NULL	n2
b	8	n4

query III
SELECT key, r, note FROM (
  SELECT key, ts, CAST(CAST(x AS INTEGER) AS DOUBLE) AS r, note FROM nested_cast_t)
QUALIFY row_number() OVER (PARTITION BY key ORDER BY ts DESC) = 1
ORDER BY key
----
a	4	n2
b	9	n4

statement ok
SET disabled_optimizers = ''

require icu

statement ok
SET TimeZone = 'UTC'

statement ok
CREATE TABLE tstz_t AS SELECT TIMESTAMPTZ '2026-10-27 00:31:02+00' AS ts

query II
SELECT * FROM (SELECT ts, ts::DATE AS d FROM tstz_t) QUALIFY row_number() OVER (ORDER BY d) = 1
----
2026-10-27 00:31:02+00	2026-10-27

# Issue #27813: the row id semi-join used for late materialization expects the row id columns to be
# the last columns of its LHS. When a row id is also requested as a payload column it is already
# projected earlier, so the LHS must keep a projection map that re-appends the join key.

statement ok
CREATE TABLE rowid_payload (id INTEGER, p1 INTEGER, ord BIGINT)

statement ok
INSERT INTO rowid_payload VALUES (1, 100, 1), (1, 300, 0), (2, 210, 5), (2, 220, 2), (2, 230, 9)

# late materialization is still used
query II
EXPLAIN SELECT id, p1, rowid FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 1
----
logical_opt	<REGEX>:.*COMPARISON_JOIN.*rowid = rowid.*

# the payload row id must hold the row id of the winning row, not of another row of the group
query III
SELECT id, p1, rowid FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 1 ORDER BY id
----
1	300	1
2	220	3

# ... also when the row id is the leading payload column
query II
SELECT rowid, p1 FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 1 ORDER BY rowid
----
1	300
3	220

# ... and for top-n with n > 1
query IIII
SELECT id, p1, ord, rowid FROM (SELECT id, p1, ord, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 2 ORDER BY id, ord
----
1	300	0	1
1	100	1	0
2	220	2	3
2	210	5	2

# an INTEGER sort key must not make the row id columns disagree on type
statement ok
CREATE TABLE rowid_payload_int (id INTEGER, p1 INTEGER, ord INTEGER)

statement ok
INSERT INTO rowid_payload_int VALUES (1, 100, 1), (1, 300, 0), (2, 210, 5), (2, 220, 2), (2, 230, 9)

query III
SELECT id, p1, rowid FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload_int) WHERE rn <= 1 ORDER BY id
----
1	300	1
2	220	3

# Differential check against the same queries with the optimizer disabled
statement ok
SET disabled_optimizers = 'top_n_window_elimination'

query III
SELECT id, p1, rowid FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 1 ORDER BY id
----
1	300	1
2	220	3

query II
SELECT rowid, p1 FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 1 ORDER BY rowid
----
1	300
3	220

query IIII
SELECT id, p1, ord, rowid FROM (SELECT id, p1, ord, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload) WHERE rn <= 2 ORDER BY id, ord
----
1	300	0	1
1	100	1	0
2	220	2	3
2	210	5	2

query III
SELECT id, p1, rowid FROM (SELECT id, p1, rowid, ROW_NUMBER() OVER (PARTITION BY id ORDER BY ord ASC) rn FROM rowid_payload_int) WHERE rn <= 1 ORDER BY id
----
1	300	1
2	220	3

statement ok
SET disabled_optimizers = ''
