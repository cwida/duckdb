----
1	1.0
2	1.0
3	1.0

# a projected array constant is folded by the optimizer and survives CTAS
query II
EXPLAIN SELECT list_transform(range(2048), lambda x: x::FLOAT)::FLOAT[2048]
----
logical_opt	<!REGEX>:.*(list_transform|range|CAST).*

statement ok
CREATE TABLE arr AS SELECT list_transform(range(2048), lambda x: x::FLOAT)::FLOAT[2048] AS v

query IIII
SELECT typeof(v), v[1], v[2048], len(v) FROM arr
----
FLOAT[2048]	0.0	2047.0	2048

# the 100000-element array below exhausts the address space of 32-bit builds when the suite runs with many threads
require 64bit

# an array with more elements than the limit (32 * 2048) is not folded but still evaluates correctly
query II
EXPLAIN SELECT list_transform(range(100000), lambda x: x::FLOAT)::FLOAT[100000]
----
logical_opt	<REGEX>:.*list_transform.*

statement ok
CREATE TABLE big_arr AS SELECT list_transform(range(100000), lambda x: x::FLOAT)::FLOAT[100000] AS v

# no correlated UNNEST here: it would flatten the 400 KB array once per unnested row (~40 GB)
query IIIII
SELECT typeof(v), v[1], v[50000], v[100000], len(v) FROM big_arr
----
FLOAT[100000]	0.0	49999.0	99999.0	100000

query I
SELECT array_distance(v, list_transform(range(100000), lambda x: x::FLOAT)::FLOAT[100000]) FROM big_arr
----
0.0
