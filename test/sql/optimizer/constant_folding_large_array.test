# name: test/sql/optimizer/constant_folding_large_array.test
# description: ARRAY constants with more elements than a vector are still constant folded
# group: [optimizer]

# the fold limit is 32 vectors worth of nested elements
require vector_size 2048

statement ok
PRAGMA explain_output='optimized_only';

statement ok
CREATE TABLE vecs AS SELECT i, list_transform(range(2048), lambda x: (i * i)::FLOAT)::FLOAT[2048] AS vec FROM range(4) t(i);

# a FLOAT[2048] literal (list literal cast to an array) is folded into a constant when binding the function arguments
