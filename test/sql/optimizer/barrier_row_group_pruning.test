# name: test/sql/optimizer/barrier_row_group_pruning.test
# description: Filters wrapped in an optimizer barrier are still used for row group pruning
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/barrier_row_group_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

# 3 row groups: [0, 2047], [2048, 4095] and [4096, 6143]
statement ok
CREATE TABLE t AS SELECT range::INTEGER AS i FROM range(6144);

statement ok
CHECKPOINT;

# a barrier only prevents the expression from being evaluated on rows that other operators filter out - pruning does
# not evaluate it at all, so the zonemap of the column is used as it is without the barrier
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE i = 42;
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i = 42);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE __internal_barrier(i = 42);
----
1

# the same holds for the expressions that pruning derives statistics for - a comparison against a monotone function,
# a BETWEEN, and a conjunction
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i BETWEEN 100 AND 200);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i + 1000 = 1042);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i > 5000 AND i < 5010);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM t WHERE __internal_barrier(i > 5000 AND i < 5010);
----
9

# a filter that no row group can satisfy is resolved before the scan is even reached
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i = 1000000);
----
analyzed_plan	<REGEX>:.*Empty Result.*

query I
SELECT count(*) FROM t WHERE __internal_barrier(i = 1000000);
----
0

# a filter that every row group can satisfy prunes none of them
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier(i % 2048 = 42);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 3 / 3.*

query I
SELECT count(*) FROM t WHERE __internal_barrier(i % 2048 = 42);
----
3

# a throwing expression is the reason the barrier exists in the first place - it still prunes: no row group holds an
# i > 5000 for which 100 // (i + 1) is 1, and the division is never evaluated to find that out
query II
EXPLAIN ANALYZE SELECT count(*) FROM t WHERE __internal_barrier((100 // (i + 1)) = 1 AND i > 5000);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 0 / 3.*

query I
SELECT count(*) FROM t WHERE __internal_barrier((100 // (i + 1)) = 1 AND i > 5000);
----
0
