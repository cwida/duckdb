# name: test/sql/projection/test_simple_case_order.test
# description: Set-operation ordering matches CASE expressions by structure
# group: [projection]

query I
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY CASE i WHEN 1 THEN 1 ELSE 0 END
----
0
0
1
1

query I
SELECT CASE WHEN i=1 THEN 1 ELSE 0 END FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY CASE WHEN i=1 THEN 1 ELSE 0 END
----
0
0
1
1

# A different spelling cannot reference a UNION branch's input columns.
statement error
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY CASE WHEN i=1 THEN 1 ELSE 0 END
----
Referenced column "i" not found

statement error
SELECT CASE WHEN i=1 THEN 1 ELSE 0 END FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY CASE i WHEN 1 THEN 1 ELSE 0 END
----
Referenced column "i" not found

# Each spelling selects its own output when both are present.
query II
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS a, CASE WHEN i=1 THEN 1 ELSE 0 END AS b
FROM range(2) t(i) UNION ALL SELECT -1, 9
ORDER BY CASE i WHEN 1 THEN 1 ELSE 0 END
----
-1	9
0	0
1	1

query II
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS a, CASE WHEN i=1 THEN 1 ELSE 0 END AS b
FROM range(2) t(i) UNION ALL SELECT -1, 9
ORDER BY CASE WHEN i=1 THEN 1 ELSE 0 END
----
0	0
1	1
-1	9

# Aliases and result expressions remain valid alternatives.
query I
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS k FROM range(3) t(i) UNION ALL SELECT 1 ORDER BY k
----
0
0
1
1

query I
SELECT CASE i WHEN 1 THEN 1 ELSE 0 END AS k FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY CASE k WHEN 0 THEN 1 ELSE 0 END
----
1
1
0
0

query II
SELECT 7 AS extra, CASE i WHEN 1 THEN 1 ELSE 0 END AS k FROM range(3) t(i)
UNION ALL BY NAME SELECT 1 AS k, 8 AS extra
ORDER BY CASE i WHEN 1 THEN 1 ELSE 0 END, extra
----
7	0
7	0
7	1
8	1

# Exact volatile matches reuse the projection.
statement ok
CREATE SEQUENCE order_case_seq

query I
SELECT CASE nextval('order_case_seq') WHEN 1 THEN 1 WHEN 2 THEN 2 ELSE 3 END FROM range(2)
UNION ALL SELECT 4
ORDER BY CASE nextval('order_case_seq') WHEN 1 THEN 1 WHEN 2 THEN 2 ELSE 3 END
----
1
2
4

query I
SELECT currval('order_case_seq')
----
2

# A distinct expression that needs no input columns is evaluated over the result.
statement ok
CREATE SEQUENCE order_fallback_seq

query I
SELECT CASE nextval('order_fallback_seq') WHEN -1 THEN 1 WHEN -2 THEN 2 ELSE 3 END AS k
UNION ALL SELECT 4
ORDER BY CASE WHEN nextval('order_fallback_seq')=-1 THEN 1 WHEN nextval('order_fallback_seq')=-2 THEN 2 ELSE 3 END, k DESC
----
4
3

query I
SELECT currval('order_fallback_seq')
----
5

# Group and window references do not make different CASE spellings match.
statement ok
CREATE SEQUENCE grouped_order_seq

query I
SELECT list(k) IN ([1, 0], [1, 1]) FROM (
SELECT CASE WHEN nextval('grouped_order_seq')%2=0 THEN 1 WHEN nextval('grouped_order_seq')%2=1 THEN 1 ELSE 0 END AS k
GROUP BY k UNION ALL SELECT 1
ORDER BY CASE nextval('grouped_order_seq')%2 WHEN 0 THEN 1 WHEN 1 THEN 1 ELSE 0 END, k DESC
) ordered
----
true

statement ok
CREATE SEQUENCE window_order_seq

query I
SELECT sum(CASE WHEN nextval('window_order_seq')%2=0 THEN 1
                WHEN nextval('window_order_seq')%2=1 THEN 1 ELSE 0 END) OVER () AS k
UNION ALL SELECT 1
ORDER BY sum(CASE nextval('window_order_seq')%2 WHEN 0 THEN 1 WHEN 1 THEN 1 ELSE 0 END) OVER (), k DESC
----
1
0

# A correlated aggregate cannot expose its input through a different CASE spelling.
statement ok
CREATE SEQUENCE correlated_order_seq

statement error
SELECT (SELECT sum(CASE WHEN i+nextval('correlated_order_seq')%2=0 THEN 1
                       WHEN i+nextval('correlated_order_seq')%2=1 THEN 1 ELSE 0 END)) AS k
FROM range(1) t(i) UNION ALL SELECT 1
ORDER BY (SELECT sum(CASE i+nextval('correlated_order_seq')%2 WHEN 0 THEN 1 WHEN 1 THEN 1 ELSE 0 END)), k DESC
----
Referenced column "i" not found

# Identical expressions with volatile result arms still match through registered expressions.
statement ok
CREATE SEQUENCE result_order_seq

query I
SELECT sum(CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END) OVER () AS k
FROM range(3) t(i) UNION ALL SELECT 2
ORDER BY sum(CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END) OVER ()
----
1
1
1
2

query I
SELECT sum(CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END) AS k
FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY sum(CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END)
----
1
2

query I
SELECT unnest([CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END]) AS k
FROM range(3) t(i) UNION ALL SELECT 1
ORDER BY unnest([CASE i WHEN 1 THEN nextval('result_order_seq') ELSE 0 END])
----
0
0
1
3

query I
SELECT currval('result_order_seq')
----
3
