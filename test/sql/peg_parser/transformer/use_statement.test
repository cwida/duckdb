# name: test/sql/peg_parser/transformer/use_statement.test
# description: Test USE statements in the PEG transformer
# group: [transformer]

require skip_reload

require no_extension_autoloading "FIXME: to be reviewed whether this can be lifted"

statement ok
ATTACH ':memory:' AS trampoline_use_catalog

statement ok
ATTACH ':memory:' AS "my""db"

query I
SELECT 1;
----
1

statement ok
USE main

statement ok
USE MAIN

statement ok
USE "main"

statement ok
USE trampoline_use_catalog.main

statement ok
USE "trampoline_use_catalog"."main"

statement ok
USE "my""db"

statement ok
USE 'main'

statement ok
USE 'my"db'

statement ok
USE 'trampoline_use_catalog'

statement error
USE temp
----
Catalog Error: SET schema cannot be set to internal schema "temp"

statement error
USE main.temp
----
Catalog Error: SET schema: No catalog + schema named "main.temp" found.

statement error
USE main.extra
----
Catalog Error: SET schema: No catalog + schema named "main.extra" found.

statement error
USE main.main.extra
----
Parser Error: Expected "USE database" or "USE database.schema"
