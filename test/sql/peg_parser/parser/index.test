# name: test/sql/peg_parser/parser/index.test
# description: Test index syntax in peg parser
# group: [parser]

require autocomplete

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$create unique index part_comp_key_index on insertconflicttest(key, fruit) where 1;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE INDEX my_ip_idx ON t1 USING HNSW (vec) WITH (metric = 'ip');$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE INDEX idx ON embeddings USING HNSW (vec) WITH (ef_construction = 100, ef_search = 100, M = 3, M0 = 3);$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$DROP INDEX simple.new_schema.i_index$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$DROP INDEX s.i_index;$TEST_PEG_PARSER$);

statement ok
CREATE TABLE create_index_syntax(a INTEGER, b INTEGER);

statement error
CREATE INDEX duplicate_index_list ON create_index_syntax(a) (b);
----
<REGEX>:.*Parser Error: syntax error.*

statement error
CREATE INDEX missing_index_list ON create_index_syntax;
----
<REGEX>:.*Parser Error: syntax error.*

statement ok
CREATE INDEX plain_index ON create_index_syntax(a, b);

statement ok
CREATE INDEX expression_index ON create_index_syntax((a + b));

statement ok
CREATE INDEX using_index ON create_index_syntax USING ART(a);

query III
SELECT index_name, sql, expressions
FROM duckdb_indexes()
WHERE table_name = 'create_index_syntax'
ORDER BY index_name;
----
expression_index	CREATE INDEX expression_index ON create_index_syntax(((a + b)));	['((a + b))']
plain_index	CREATE INDEX plain_index ON create_index_syntax(a, b);	[a, b]
using_index	CREATE INDEX using_index ON create_index_syntax(a);	[a]

statement error
CREATE INDEX missing_column_index ON create_index_syntax(missing);
----
<REGEX>:.*Binder Error: Table "create_index_syntax" does not have a column named "missing".*
