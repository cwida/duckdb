# name: test/sql/peg_parser/parser/load_extension.test
# description: Test loading extensions in peg parser
# group: [parser]

require autocomplete

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL tpch;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$FORCE INSTALL tpch;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$FORCE INSTALL tpch;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$FORCE INSTALL tpch FROM '{LOCAL_EXTENSION_REPO_UPDATED}'$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD tpch;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD '{SPATIAL_EXTENSION}'$TEST_PEG_PARSER$);

# INSTALL AND LOAD combines install and load in a single statement
statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL AND LOAD tpch;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL AND LOAD tpch FROM core;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$FORCE INSTALL AND LOAD tpch;$TEST_PEG_PARSER$);

# LOAD with an explicit FROM repository
statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL tpch FROM core;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL my_package FROM my_repo;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD tpch FROM core;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD shellfs FROM community;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD my_package FROM my_repo AS mp;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY acme WITH PREFIX 'http://acme.com' USING PUBLIC KEY 'mykey';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE OR REPLACE EXTENSION REPOSITORY acme WITH PREFIX 'http://acme.com' USING PUBLIC KEY 'mykey';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY IF NOT EXISTS acme WITH PREFIX 'http://acme.com' USING PUBLIC KEY 'mykey';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY acme WITH PREFIX 'http://acme.com';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY acme.example.com;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE OR REPLACE EXTENSION REPOSITORY IF NOT EXISTS 'acme.example.com';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$DROP EXTENSION REPOSITORY acme.example.com;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$INSTALL AND LOAD x FROM acme.example.com;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$LOAD x FROM acme.example.com;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY acme PREFIX 'http://acme.com' PUBLIC KEY 'mykey';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$CREATE EXTENSION REPOSITORY acme WITH PREFIX 'http://acme.com' USING PUBLIC KEYS 'key1', 'key2';$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$DROP EXTENSION REPOSITORY acme;$TEST_PEG_PARSER$);

statement ok
CALL check_peg_parser($TEST_PEG_PARSER$DROP EXTENSION REPOSITORY IF EXISTS acme;$TEST_PEG_PARSER$);

