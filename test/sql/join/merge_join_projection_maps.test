3	1	4
3	2	4
3	3	4
3	4	4
4	NULL	NULL

# FULL/RIGHT OUTER: the source side of the join emits the RHS tuples that found no match, with NULLs for
# the projected LHS columns

query II
explain
SELECT x1.c0, x2.c0, x3.c0 FROM t0 AS x1 LEFT JOIN t0 AS x2 ON ((SELECT 3) = x1.c0) FULL JOIN t0 AS x3 ON (x1.c0 < x3.c0) ORDER BY ALL;
----
physical_plan	<REGEX>:.*PIECEWISE_MERGE_JOIN.*

