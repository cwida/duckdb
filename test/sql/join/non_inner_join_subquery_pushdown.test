# name: test/sql/join/non_inner_join_subquery_pushdown.test
# description: Single-side conjuncts of non-inner join conditions with subqueries
# group: [join]

statement ok
CREATE TABLE l(i INTEGER, j INTEGER);

statement ok
CREATE TABLE r(i INTEGER, j INTEGER);

statement ok
CREATE TABLE s(i INTEGER, j INTEGER);

statement ok
INSERT INTO l VALUES (1, 10), (2, 20), (2, 20), (3, 30), (NULL, 40);

statement ok
INSERT INTO r VALUES (1, 100), (2, 200), (2, 250), (4, 400), (NULL, 999);

statement ok
INSERT INTO s VALUES (1, 10), (2, 20), (2, 20), (NULL, 99);

# right-only IN subquery and range next to a pair predicate
query IIII
SELECT l.i, l.j, r.i, r.j FROM l LEFT JOIN r ON r.i IN (SELECT i FROM s) AND r.j >= 150 AND l.i <= r.i ORDER BY ALL;
----
1	10	2	200
1	10	2	250
2	20	2	200
2	20	2	200
2	20	2	250
2	20	2	250
3	30	NULL	NULL
NULL	40	NULL	NULL

# only right-only conjuncts
query II
SELECT l.i, r.i FROM l LEFT JOIN r ON r.i IN (SELECT i FROM s) AND r.j > 200 ORDER BY ALL;
----
1	2
2	2
2	2
3	2
NULL	2

# left-only conjuncts of a LEFT join stay at the join
query II
SELECT l.i, r.i FROM l LEFT JOIN r ON l.i IN (SELECT i FROM s) AND r.j < 150 ORDER BY ALL;
----
1	1
2	1
2	1
3	NULL
NULL	NULL

# RIGHT join: left-only conjuncts move into the left side
query III
SELECT l.i, l.j, r.i FROM l RIGHT JOIN r ON l.i IN (SELECT i FROM s) AND l.j > 15 AND l.i = r.i ORDER BY ALL;
----
2	20	2
2	20	2
2	20	2
2	20	2
NULL	NULL	1
NULL	NULL	4
NULL	NULL	NULL

# FULL join: nothing moves
query II
SELECT l.i, r.i FROM l FULL JOIN r ON r.i IN (SELECT i FROM s) AND l.i = r.i AND l.j < 25 ORDER BY ALL;
----
1	1
2	2
2	2
2	2
2	2
3	NULL
NULL	4
NULL	NULL
NULL	NULL

# NOT IN over a subquery with a NULL is never true
query II
SELECT l.i, r.i FROM l LEFT JOIN r ON r.i NOT IN (SELECT i FROM s) AND l.i < r.i ORDER BY ALL;
----
1	NULL
2	NULL
2	NULL
3	NULL
NULL	NULL

# SEMI: conjuncts move into both sides
query II
SELECT l.i, l.j FROM l SEMI JOIN r ON l.i IN (SELECT i FROM s) AND r.j > 200 ORDER BY ALL;
----
1	10
2	20
2	20

# ANTI: every conjunct moves into the right side
query II
SELECT l.i, l.j FROM l ANTI JOIN r ON r.i IN (SELECT i FROM s WHERE i > 5) ORDER BY ALL;
----
1	10
2	20
2	20
3	30
NULL	40

# correlated subquery that only depends on the right side
query III
SELECT l.i, r.i, r.j FROM l LEFT JOIN r ON EXISTS (SELECT 1 FROM s WHERE s.i = r.i AND s.j * 10 = r.j) AND l.i = r.i ORDER BY ALL;
----
1	1	100
2	2	200
2	2	200
3	NULL	NULL
NULL	NULL	NULL

# a pair-dependent subquery next to a right-only predicate
query III
SELECT l.i, r.i, r.j FROM l LEFT JOIN r ON EXISTS (SELECT 1 FROM s WHERE s.i = l.i AND s.i = r.i) AND r.j < 220 ORDER BY ALL;
----
1	1	100
2	2	200
2	2	200
3	NULL	NULL
NULL	NULL	NULL

# a right-only conjunct that references an enclosing query, without a subquery
query II
SELECT o.k, (SELECT count(r.i) FROM l LEFT JOIN r ON r.j > o.k AND l.i = r.i) FROM (VALUES (0), (150), (210)) o(k) ORDER BY ALL;
----
0	5
150	4
210	2

# a right-only subquery that references an earlier FROM item
query III
SELECT x.k, l.i, r.i FROM (VALUES (1), (2)) x(k), l LEFT JOIN r ON r.i IN (SELECT i FROM s WHERE s.i = x.k) AND l.i = r.i ORDER BY ALL;
----
1	1	1
1	2	NULL
1	2	NULL
1	3	NULL
1	NULL	NULL
2	1	NULL
2	2	2
2	2	2
2	2	2
2	2	2
2	3	NULL
2	NULL	NULL
