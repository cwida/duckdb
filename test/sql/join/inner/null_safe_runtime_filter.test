# name: test/sql/join/inner/null_safe_runtime_filter.test
# description: Direct NULL-safe runtime filters retain reconstructed NULLs across executions
# group: [inner]

statement ok
SET threads=1;

statement ok
SET disabled_optimizers='statistics_propagation,join_order,build_side_probe_side,compressed_materialization';

foreach type INTEGER BIGINT HUGEINT VARCHAR

statement ok
CREATE OR REPLACE TABLE probe(id INTEGER,k {type});

statement ok
INSERT INTO probe VALUES (0,NULL),(1,'1'),(2,'2'),(3,'3'),(4,'4'),(5,NULL),(6,'6');

statement ok
CREATE OR REPLACE TABLE build(k {type},tag INTEGER);

statement ok
PREPARE null_keys AS SELECT id,tag FROM probe p JOIN build b ON p.k IS NOT DISTINCT FROM b.k ORDER BY id,tag;

query II
EXECUTE null_keys;
----

statement ok
INSERT INTO build VALUES ('1',11),('3',31);

query II
EXECUTE null_keys;
----
1	11
3	31

statement ok
INSERT INTO build VALUES (NULL,0),(NULL,1);

query II
EXECUTE null_keys;
----
0	0
0	1
1	11
3	31
5	0
5	1

statement ok
DELETE FROM build WHERE k IS NOT NULL;

query II
EXECUTE null_keys;
----
0	0
0	1
5	0
5	1

statement ok
DELETE FROM build;

query II
EXECUTE null_keys;
----

statement ok
INSERT INTO build VALUES ('6',61);

query II
EXECUTE null_keys;
----
6	61

statement ok
DEALLOCATE null_keys;

endloop

statement ok
CREATE TABLE cast_probe(id INTEGER,k BIGINT,g INTEGER);

statement ok
INSERT INTO cast_probe VALUES (0,NULL,0),(1,1,1),(2,128,0),(3,3,1),(4,-129,0),(5,7,NULL);

statement ok
CREATE TABLE cast_build(k TINYINT,g INTEGER);

statement ok
INSERT INTO cast_build VALUES (NULL,0),(1,1),(3,1);

query I
SELECT id FROM cast_probe p JOIN cast_build b ON TRY_CAST(p.k AS TINYINT) IS NOT DISTINCT FROM b.k ORDER BY id;
----
0
1
2
3
4

query I
SELECT id FROM cast_probe p JOIN cast_build b ON TRY_CAST(p.k AS TINYINT) IS NOT DISTINCT FROM b.k AND p.g=b.g ORDER BY id;
----
0
1
2
3
4

statement error
SELECT id FROM cast_probe p JOIN cast_build b ON p.k::TINYINT IS NOT DISTINCT FROM b.k;
----
out of range

query I
SELECT id FROM (SELECT id,TRY_CAST(k AS TINYINT)::BIGINT AS k FROM cast_probe) p
JOIN cast_build b ON p.k IS NOT DISTINCT FROM b.k ORDER BY id;
----
0
1
2
3
4

statement ok
CREATE TABLE variant_probe(id INTEGER,k VARIANT);

statement ok
INSERT INTO variant_probe VALUES (0,NULL),(1,1::VARIANT),(2,'bad'::VARIANT),(3,3::VARIANT),(4,128::VARIANT);

query I
SELECT id FROM variant_probe p JOIN cast_build b ON TRY_CAST(p.k AS TINYINT) IS NOT DISTINCT FROM b.k ORDER BY id;
----
0
1
2
3
4

statement error
SELECT id FROM variant_probe p JOIN cast_build b ON p.k::TINYINT IS NOT DISTINCT FROM b.k;
----
Conversion Error

statement ok
CREATE TABLE date_probe AS SELECT i id,CASE WHEN i=0 THEN NULL ELSE DATE '2020-01-01'+i::INTEGER END k FROM range(6)t(i);

statement ok
CREATE TABLE date_build AS SELECT k FROM date_probe WHERE id IN (0,2,4);

query I
SELECT id FROM date_probe p JOIN date_build b ON p.k IS NOT DISTINCT FROM b.k ORDER BY id;
----
0
2
4

statement ok
CREATE TABLE timestamp_probe AS SELECT id,k::TIMESTAMP k FROM date_probe;

statement ok
CREATE TABLE timestamp_build AS SELECT k FROM timestamp_probe WHERE id IN (0,2,4);

query I
SELECT id FROM timestamp_probe p JOIN timestamp_build b ON p.k IS NOT DISTINCT FROM b.k ORDER BY id;
----
0
2
4

statement ok
RESET disabled_optimizers;
