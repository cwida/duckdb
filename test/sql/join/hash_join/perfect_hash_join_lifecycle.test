# name: test/sql/join/hash_join/perfect_hash_join_lifecycle.test
# description: Parallel direct lookup, external fallback and changing recursive domains
# group: [hash_join]

# Keep the operator logs across statements.
require skip_reload

statement ok
SET VARIABLE check_perfect_activation =
    NOT current_setting('debug_force_external') AND NOT current_setting('debug_disable_optimizer');

statement ok
SET VARIABLE initial_force_external=current_setting('debug_force_external');

statement ok
SET threads=4;

statement ok
PRAGMA verify_parallelism;

statement ok
SET disabled_optimizers='join_order,build_side_probe_side,join_filter_pushdown';

statement ok
CREATE TABLE p AS SELECT (i%128)::BIGINT k FROM range(10000) t(i);

statement ok
CREATE TABLE b AS SELECT (i%64)::BIGINT k, i::BIGINT v FROM range(1000000) t(i);

statement ok
CALL enable_logging('PhysicalOperator');

query I
SELECT count(*) FROM p SEMI JOIN b USING(k);
----
5008

query II
SELECT count(*),sum(b.v) FROM (VALUES (0::BIGINT),(63),(127)) p(k) LEFT JOIN b USING(k);
----
31251	15624984375

statement ok
PRAGMA disable_verify_parallelism;

# Keep the probe partition buffers smaller than the build.
statement ok
SET threads=1;

statement ok
SET debug_force_external=true;

query I
SELECT count(*) FROM p SEMI JOIN b USING(k);
----
5008

query II
SELECT count(*),sum(b.v) FROM (VALUES (0::BIGINT),(63),(127)) p(k) LEFT JOIN b USING(k);
----
31251	15624984375

statement ok
SET debug_force_external=getvariable('initial_force_external');

statement ok
SET threads=4;

statement ok
CREATE TABLE keys(k BIGINT);

statement ok
INSERT INTO keys VALUES (0),(1),(100000000);

query II
WITH RECURSIVE r(iter,k) AS (
    SELECT 0,k FROM keys WHERE k<2
    UNION ALL
    SELECT b.iter+1,CASE WHEN p.k=0 THEN 0 WHEN b.iter%2=0 THEN 100000000 ELSE 1 END
    FROM keys p JOIN r b ON p.k=b.k WHERE b.iter<3
)
SELECT * FROM r ORDER BY ALL;
----
0	0
0	1
1	0
1	100000000
2	0
2	1
3	0
3	100000000

statement ok
CALL disable_logging();

query I
SELECT NOT getvariable('check_perfect_activation') OR list_sort(list(info['backend'])) = ['bitmap','direct','direct','direct','hash','hash']
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class='PhysicalHashJoin' AND event='Lookup';
----
true

query I
SELECT NOT getvariable('check_perfect_activation') OR count(*)=2
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class='PhysicalHashJoin' AND event='Finalize' AND info['external']::INTEGER=1;
----
true
