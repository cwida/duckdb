# name: test/sql/join/hash_join/perfect_hash_join_backend.test
# description: Direct integer lookup uses actual bounds and preserves the hash join executor
# group: [hash_join]

# Keep the operator logs across statements.
require skip_reload

statement ok
SET VARIABLE check_perfect_activation =
    NOT current_setting('debug_force_external') AND NOT current_setting('debug_disable_optimizer');

statement ok
SET disabled_optimizers='join_order,build_side_probe_side,join_filter_pushdown';

statement ok
CREATE TABLE p AS SELECT i::BIGINT k, i::INTEGER v FROM range(8) t(i);

statement ok
INSERT INTO p VALUES (NULL, 10);

statement ok
CREATE TABLE b(k BIGINT, v INTEGER, nested INTEGER[]);

statement ok
INSERT INTO b VALUES (1, 0, [0]), (1, 10, [10]), (2, 20, [20]), (NULL, 30, [30]);

statement ok
CALL enable_logging('PhysicalOperator');

query I
SELECT count(*) FROM p SEMI JOIN b USING(k);
----
2

query I
SELECT count(*) FROM p ANTI JOIN b ON p.k IS NOT DISTINCT FROM b.k;
----
6

query IIT
SELECT p.v, b.v, b.nested FROM p LEFT JOIN b ON p.k=b.k AND p.v+b.v>5
ORDER BY p.v NULLS LAST, b.v;
----
0	NULL	NULL
1	10	[10]
2	20	[20]
3	NULL	NULL
4	NULL	NULL
5	NULL	NULL
6	NULL	NULL
7	NULL	NULL
10	NULL	NULL

query IIT
SELECT p.v, b.v, b.nested FROM p FULL OUTER JOIN b
ON p.k IS NOT DISTINCT FROM b.k AND p.v < b.v
ORDER BY p.v NULLS LAST, b.v;
----
0	NULL	NULL
1	10	[10]
2	20	[20]
3	NULL	NULL
4	NULL	NULL
5	NULL	NULL
6	NULL	NULL
7	NULL	NULL
10	30	[30]
NULL	0	[0]

query I
SELECT count(*) FROM p JOIN b ON p.k=b.k AND p.v=b.v;
----
0

statement ok
CALL disable_logging();

query I
SELECT NOT getvariable('check_perfect_activation') OR list_sort(list(info['backend'])) = ['bitmap','bitmap','direct','direct','hash']
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class='PhysicalHashJoin' AND event='Lookup';
----
true
