# name: test/sql/join/hash_join/hash_join_nested_dictionary.test_slow
# description: Reusable nested dictionaries emitted by hash joins
# group: [hash_join]

statement ok
CREATE TABLE list_build AS
SELECT i % 2049 AS k,
       CASE WHEN i % 11 = 0 THEN NULL
            WHEN i % 13 = 0 THEN []::BIGINT[]
            ELSE [i + 2, NULL, i] END AS vals,
       CASE WHEN i % 11 = 0 OR i % 13 = 0 THEN NULL ELSE i END AS expected
FROM range(4099) t(i);

# Duplicate build keys and more than one vector of dictionary entries.
statement ok
CREATE TABLE list_probe AS SELECT i * 37 % 2049 AS k FROM range(411849) t(i);

query II
SELECT count(*), count(*) FILTER (
    WHERE list_sort(vals)[1] IS DISTINCT FROM expected
       OR (expected IS NOT NULL AND expected % 2049 <> list_probe.k))
FROM list_probe JOIN list_build USING (k);
----
823899	0

# A volatile filter stays above a left join; every selected row must retain its dictionary mapping.
query I
SELECT count(*) FILTER (WHERE list_sort(vals)[1] IS DISTINCT FROM expected)
FROM list_probe LEFT JOIN list_build USING (k)
WHERE random() < 0.5;
----
0

# Unmatched probe rows produce NULL lists.
statement ok
INSERT INTO list_probe VALUES (3000);

query III
SELECT count(*), count(*) FILTER (WHERE vals IS NULL),
       count(*) FILTER (WHERE list_sort(vals)[1] IS DISTINCT FROM expected)
FROM list_probe LEFT JOIN list_build USING (k);
----
823900	74974	0

# Re-execution must not reuse dictionaries from a previous build.
statement ok
PREPARE list_query AS
SELECT count(*) FILTER (WHERE list_sort(vals)[1] IS DISTINCT FROM expected)
FROM list_probe JOIN list_build USING (k);

query I
EXECUTE list_query;
----
0

statement ok
UPDATE list_build SET vals = [42, NULL, -7], expected = -7;

query I
EXECUTE list_query;
----
0

# Below the fan-out ratio, the ordinary gather path remains correct.
query I
SELECT count(*) FILTER (WHERE list_sort(vals)[1] IS DISTINCT FROM expected)
FROM (SELECT * FROM list_probe LIMIT 100) p JOIN list_build USING (k);
----
0

# Each type crosses the gather batch boundary and contains NULL parents and children.
statement ok
CREATE MACRO expected_strings(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [repeat('a', 40) || i, NULL, repeat('z', 40) || i] END;

statement ok
CREATE MACRO expected_lists(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [[i, NULL], [i + 1], [], NULL] END;

statement ok
CREATE MACRO expected_structs(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [{'n': i, 's': repeat('x', 40) || i}, NULL, {'n': NULL, 's': NULL}] END;

statement ok
CREATE MACRO expected_arrays(i) AS
CASE WHEN i % 11 = 0 THEN NULL ELSE [i, NULL, i + 1]::BIGINT[3] END;

statement ok
CREATE MACRO expected_list_arrays(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [[i, NULL]::BIGINT[2], NULL, [i + 1, i + 2]::BIGINT[2]] END;

statement ok
CREATE MACRO expected_array_lists(i) AS
CASE WHEN i % 11 = 0 THEN NULL ELSE [[i, NULL], [], NULL]::BIGINT[][3] END;

statement ok
CREATE MACRO expected_array_structs(i) AS
CASE WHEN i % 11 = 0 THEN NULL
ELSE [{'n': i, 's': repeat('x', 40) || i}, NULL]::STRUCT(n BIGINT, s VARCHAR)[2] END;

statement ok
CREATE MACRO expected_nested_arrays(i) AS
CASE WHEN i % 11 = 0 THEN NULL
ELSE [CASE WHEN i % 7 = 0 THEN NULL ELSE [i, NULL]::BIGINT[2] END,
      [i + 1, i + 2]::BIGINT[2]]::BIGINT[2][2] END;

statement ok
CREATE MACRO expected_maps(i) AS
CASE WHEN i % 11 = 0 THEN NULL
WHEN i % 13 = 0 THEN MAP([]::VARCHAR[], []::BIGINT[][])
ELSE MAP([i::VARCHAR, 'other' || i], [[i, NULL], [i + 1]]) END;

statement ok
CREATE MACRO expected_unions(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [union_value(n := i)::UNION(n BIGINT, s VARCHAR),
      union_value(s := repeat('x', 40) || i)::UNION(n BIGINT, s VARCHAR), NULL] END;

statement ok
CREATE MACRO expected_variants(i) AS
CASE WHEN i % 11 = 0 THEN NULL WHEN i % 13 = 0 THEN []
ELSE [i::VARIANT, (repeat('x', 40) || i)::VARIANT, NULL, {'n': i, 'a': [i, NULL]}::VARIANT] END;

statement ok
CREATE TABLE nested_build AS
SELECT i AS k,
       expected_strings(i) AS val_strings,
       expected_lists(i) AS val_lists,
       expected_structs(i) AS val_structs,
       expected_arrays(i) AS val_arrays,
       expected_list_arrays(i) AS val_list_arrays,
       expected_array_lists(i) AS val_array_lists,
       expected_array_structs(i) AS val_array_structs,
       expected_nested_arrays(i) AS val_nested_arrays,
       expected_maps(i) AS val_maps,
       expected_unions(i) AS val_unions,
       expected_variants(i) AS val_variants
FROM range(4099) t(i);

statement ok
CREATE TABLE nested_probe AS SELECT i % 4099 AS k FROM range(413999) t(i);

foreach type strings lists structs arrays list_arrays array_lists array_structs nested_arrays maps unions variants

# The expected value is derived independently from the probe key.
query II
SELECT count(*), count(*) FILTER (WHERE b.val_{type} IS DISTINCT FROM expected_{type}(p.k))
FROM nested_probe p JOIN nested_build b USING (k);
----
413999	0

# Unary function execution over the emitted dictionary.
query I
SELECT count(*) FILTER (WHERE hash(b.val_{type}) <> hash(expected_{type}(p.k)))
FROM nested_probe p JOIN nested_build b USING (k);
----
0

# String keys exercise the ordinary hash table instead of perfect dictionary lookup.
query II
SELECT count(*), count(*) FILTER (WHERE b.val_{type} IS DISTINCT FROM expected_{type}(p.k))
FROM nested_probe p JOIN nested_build b ON 'key' || p.k = 'key' || b.k;
----
413999	0

endloop

# Full joins combine matched dictionaries with unmatched rows from both sides.
statement ok
CREATE TABLE outer_probe AS SELECT k FROM nested_probe WHERE k <> 4098 UNION ALL SELECT 5000;

query II
SELECT count(*), count(*) FILTER (
    WHERE b.val_arrays IS DISTINCT FROM
              CASE WHEN p.k = 5000 THEN NULL ELSE expected_arrays(coalesce(p.k, 4098)) END
       OR b.val_structs IS DISTINCT FROM
              CASE WHEN p.k = 5000 THEN NULL ELSE expected_structs(coalesce(p.k, 4098)) END)
FROM outer_probe p FULL JOIN nested_build b USING (k);
----
413900	0

# Compact strings expand when gathered into string_t entries. Abandoning an oversized
# dictionary must leave duplicate chains and previously gathered columns intact.
statement ok
CREATE TABLE budget_build AS
SELECT i % 2049 AS k, i AS row_id, list_resize([''], 100 + i % 2, '') AS vals FROM range(4099) t(i);

query II
SELECT count(*), count(*) FILTER (
    WHERE row_id % 2049 <> p.k OR vals IS DISTINCT FROM list_resize([''], 100 + row_id % 2, ''))
FROM nested_probe p JOIN budget_build b USING (k);
----
413999	0

# NULL arrays still allocate their fixed-size children in the dictionary.
statement ok
CREATE TABLE wide_array_build AS
SELECT i AS k, CASE WHEN i = 0 THEN list_resize([i], 512, i)::BIGINT[512] ELSE NULL END AS vals
FROM range(4099) t(i);

query II
SELECT count(*), count(vals) FROM nested_probe p JOIN wide_array_build b USING (k);
----
413999	101

# Top-level STRUCT continues to use ordinary gathering.
statement ok
CREATE TABLE struct_build AS SELECT k, {'k': k, 's': repeat('x', 40) || k} AS val FROM nested_build;

query II
SELECT count(*), count(*) FILTER (WHERE b.val IS DISTINCT FROM {'k': p.k, 's': repeat('x', 40) || p.k})
FROM nested_probe p JOIN struct_build b USING (k);
----
413999	0

# The same fan-out rule applies to scalar strings below 262,144 probe rows.
statement ok
CREATE TABLE scalar_build AS SELECT 'key' || i AS k, repeat('value', 10) || i AS val FROM range(17) t(i);

query II
SELECT count(*), count(*) FILTER (WHERE upper(b.val) IS DISTINCT FROM repeat('VALUE', 10) || (p.i % 17))
FROM range(1700) p(i) JOIN scalar_build b ON 'key' || (p.i % 17) = b.k;
----
1700	0
