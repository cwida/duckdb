# name: test/sql/outofcore/out_of_core_sort.test_slow
# description: Test out of core sort
# group: [outofcore]

require tpch

load {TEST_DIR}/out_of_core_sort.db

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CALL dbgen(sf=1);

query I
SELECT bit_xor(hash(*COLUMNS(*)))
FROM lineitem;
----
340647416945014523

foreach mem 300MiB 600MiB

foreach threads 1 2 8

statement ok
SET memory_limit='{mem}';

statement ok
SET threads={threads};

query I
WITH cte AS (
    FROM lineitem
    ORDER BY ALL
)
SELECT bit_xor(hash(*COLUMNS(*)))
FROM cte;
----
340647416945014523

endloop

endloop

# the sort should not be optimized away, of course!
query II
EXPLAIN
WITH cte AS (
    FROM lineitem
    ORDER BY ALL
)
SELECT bit_xor(hash(*COLUMNS(*)))
FROM cte;
----
physical_plan	<REGEX>:.*ORDER_BY.*
