# name: test/sql/index/art/issues/test_art_issue_23929.test
# description: Test issue 23929: DROP and CREATE INDEX with same name in a single transaction on reopened database
# group: [issues]

load {TEST_DIR}/test_art_issue_23929.db

statement ok
CREATE TABLE t(x INT);

statement ok
CREATE INDEX i1 ON t(x);

restart

statement ok
BEGIN TRANSACTION;

statement ok
DROP INDEX i1;

statement ok
CREATE INDEX i1 ON t(x);

statement ok
COMMIT;

# Verify rollback correctly removes only the newly created index with same name
statement ok
CREATE TABLE t_rollback(a INT, b INT);

statement ok
INSERT INTO t_rollback SELECT range, range FROM range(1000);

statement ok
CREATE INDEX i2 ON t_rollback(a);

statement ok
BEGIN TRANSACTION;

statement ok
DROP INDEX i2;

statement ok
CREATE INDEX i2 ON t_rollback(b);

statement ok
ROLLBACK;

query II
EXPLAIN ANALYZE SELECT * FROM t_rollback WHERE a = 1;
----
analyzed_plan	<REGEX>:.*Index Scan.*
