# name: test/sql/index/art/scan/test_art_scan_local_storage_pushed_cast.test
# description: Index scans over transaction-local rows with a cast pushed into the scan
# group: [scan]

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, s STRUCT(a INTEGER), v VARIANT);

statement ok
INSERT INTO t VALUES (0, {'a': 10}, {'x': 0}::VARIANT), (2, {'a': 12}, {'x': 2}::VARIANT);

statement ok
BEGIN;

statement ok
INSERT INTO t VALUES (1, {'a': 11}, {'x': 42}::VARIANT);

query I
SELECT s.a::BIGINT FROM t WHERE id = 1;
----
11

query I
SELECT v.x::INTEGER FROM t WHERE id = 1;
----
42

# rows in the base table are found as well
query I
SELECT s.a::BIGINT FROM t WHERE id = 2;
----
12

# a filter on the pushed down column over the transaction-local rows
query II
SELECT id, s.a::BIGINT FROM t WHERE id = 1 AND s.a > 5;
----
1	11

query I
SELECT count(*) FROM t WHERE id = 1 AND s.a > 100;
----
0

statement ok
COMMIT;

query I
SELECT s.a::BIGINT FROM t WHERE id = 1;
----
11
