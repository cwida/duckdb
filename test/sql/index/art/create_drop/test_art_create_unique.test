# name: test/sql/index/art/create_drop/test_art_create_unique.test
# description: Test unique ART creation
# group: [create_drop]

statement ok
CREATE TABLE t0(c0 INTEGER);

statement ok
CREATE UNIQUE INDEX i0 ON t0(c0);

statement ok
INSERT INTO t0(c0) VALUES (1);

statement error
INSERT INTO t0(c0) VALUES (1);
----
<REGEX>:.*Constraint Error.*Duplicate key.*

query I
SELECT * FROM t0 WHERE t0.c0 = 1;
----
1

statement ok
CREATE TABLE merge_violation (id INT);

statement ok
INSERT INTO merge_violation SELECT range FROM range(2048);

statement ok
INSERT INTO merge_violation SELECT range + 10000 FROM range(2048);

statement ok
INSERT INTO merge_violation VALUES (2047);

statement error
CREATE UNIQUE INDEX idx ON merge_violation(id);
----
<REGEX>:.*Constraint Error.*contains duplicates on indexed column.*

# CREATE UNIQUE INDEX after local rows exist must also create its local delete index.
statement ok
CREATE TABLE local_index(i INTEGER);

statement ok
INSERT INTO local_index VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_index VALUES (2);

statement ok
CREATE UNIQUE INDEX local_idx ON local_index(i);

statement ok
DELETE FROM local_index WHERE i = 1;

statement ok
INSERT INTO local_index VALUES (1);

statement ok
COMMIT;

query I rowsort
SELECT i FROM local_index;
----
1
2
