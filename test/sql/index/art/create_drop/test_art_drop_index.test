# name: test/sql/index/art/create_drop/test_art_drop_index.test
# description: Test the DROP INDEX statement
# group: [create_drop]

statement ok
CREATE TABLE A (A1 INTEGER,A2 VARCHAR, A3 INTEGER)

statement ok
INSERT INTO A VALUES (1, 1, 1)

statement ok
INSERT INTO A VALUES (2, 2, 2)

statement ok
CREATE TABLE B (B1 INTEGER,B2 INTEGER, B3 INTEGER)

statement ok
INSERT INTO B VALUES (1, 1, 1)

statement ok
INSERT INTO B VALUES (2, 2, 2)

statement ok
CREATE TABLE C (C1 VARCHAR, C2 INTEGER, C3 INTEGER)

statement ok
INSERT INTO C VALUES ('t1', 1, 1)

statement ok
INSERT INTO C VALUES ('t2', 2, 2)

query T
SELECT A2 FROM A WHERE A1=1
----
1

statement ok
CREATE INDEX A_index ON A (A1)

query T
SELECT A2 FROM A WHERE A1=1
----
1

statement ok
CREATE INDEX B_index ON B (B1)

query T
SELECT A2 FROM A WHERE A1=1
----
1

statement ok
CREATE INDEX C_index ON C (C2)

query T
SELECT A2 FROM A WHERE A1=1
----
1

statement ok
DROP INDEX IF EXISTS A_index

query T
SELECT A2 FROM A WHERE A1=1
----
1

# test drop index on temporary table (issue #27494)
statement ok
CREATE TEMPORARY TABLE t0 (a INT, b INT)

statement ok
CREATE UNIQUE INDEX ix1 ON t0 (a)

statement ok
INSERT INTO t0 VALUES (1, 1)

statement error
INSERT INTO t0 VALUES (1, 2)
----
Constraint Error: Duplicate key "a: 1" violates unique constraint

statement ok
DROP INDEX ix1

query I
SELECT count(*) FROM duckdb_indexes() WHERE index_name = 'ix1'
----
0

# duplicate insert succeeds after dropping unique index
statement ok
INSERT INTO t0 VALUES (1, 2)

query II
SELECT * FROM t0 ORDER BY b
----
1	1
1	2

statement ok
CREATE TEMPORARY TABLE t9 (a INT, b INT)

statement ok
CREATE INDEX ix9 ON t9 (a)

statement ok
DROP INDEX ix9

# alter column type succeeds after dropping index
statement ok
ALTER TABLE t9 ALTER COLUMN a SET DATA TYPE BIGINT

# rollback of DROP INDEX on temporary table keeps the index intact
statement ok
CREATE TEMPORARY TABLE t_rb (a INT)

statement ok
CREATE UNIQUE INDEX ix_rb ON t_rb (a)

statement ok
INSERT INTO t_rb VALUES (1)

statement ok
BEGIN TRANSACTION

statement ok
DROP INDEX ix_rb

statement ok
ROLLBACK

statement error
INSERT INTO t_rb VALUES (1)
----
Constraint Error: Duplicate key "a: 1" violates unique constraint

# dropping temporary table with an index succeeds
statement ok
DROP TABLE t_rb

statement ok
DROP TABLE t0

statement ok
DROP TABLE t9
