# name: test/sql/index/art/index_bind_failure_retry.test
# description: An index whose bind throws stays unbound, so later statements fail with the same error instead of waiting for the failed bind forever
# group: [art]

statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure.db' AS w;

# the macro lives in another catalog, so the index cannot register a dependency on it
statement ok
CREATE MACRO m(x) AS x + 1;

statement ok
CREATE TABLE w.t(v BIGINT);

statement ok
CREATE INDEX i ON w.t(m(v));

statement ok
INSERT INTO w.t VALUES (1), (2);

statement ok
DETACH w;

statement ok
DROP MACRO m;

# the index is loaded unbound and bound on first use, which fails without the macro
statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure.db' AS w;

statement error
INSERT INTO w.t VALUES (3);
----
Scalar Function with name m does not exist

# the second attempt binds again and fails the same way, instead of waiting for the first attempt
statement error
INSERT INTO w.t VALUES (3);
----
Scalar Function with name m does not exist

statement error
DELETE FROM w.t WHERE v = 1;
----
Scalar Function with name m does not exist

# once the macro exists again the index binds and the table is usable
statement ok
CREATE MACRO m(x) AS x + 1;

statement ok
INSERT INTO w.t VALUES (3);

query I
SELECT count(*) FROM w.t WHERE m(v) = 4;
----
1

query I
SELECT count(*) FROM w.t;
----
3

statement ok
DETACH w;

# A bind can also fail while the rows buffered from the WAL are replayed into the index that was just created from
# its storage. The failed bind must leave the storage with the unbound index: the retry binds from it again, and
# the blocks of the index must not be freed while the index still uses them.
statement ok
SET checkpoint_threshold = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure_replay.db' AS w;

statement ok
CREATE TABLE w.t(v BIGINT);

statement ok
CREATE INDEX i ON w.t(m(v));

statement ok
INSERT INTO w.t SELECT range FROM range(1, 200001);

statement ok
CHECKPOINT w;

# these rows stay in the WAL and are replayed into the index when it is bound
statement ok
INSERT INTO w.t SELECT range FROM range(200001, 200011);

statement ok
DETACH w;

# The key is deterministic, but casting a buffered row fails during replay.
statement ok
CREATE OR REPLACE MACRO m(x) AS CASE WHEN x > 200000 THEN CAST('boom' || x::VARCHAR AS BIGINT) ELSE x + 1 END;

statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure_replay.db' AS w;

statement error
INSERT INTO w.t VALUES (0);
----
boom

statement error
INSERT INTO w.t VALUES (0);
----
boom

statement ok
CREATE OR REPLACE MACRO m(x) AS x + 1;

statement ok
INSERT INTO w.t VALUES (0);

statement ok
CHECKPOINT w;

statement ok
INSERT INTO w.t SELECT range FROM range(300001, 500001);

statement ok
CHECKPOINT w;

statement ok
DETACH w;

statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure_replay.db' AS w;

statement ok
INSERT INTO w.t VALUES (100000);

query I
SELECT count(*) FROM w.t WHERE m(v) = 100001;
----
2

query I
SELECT count(*) FROM w.t WHERE m(v) = 200011;
----
1

query I
SELECT count(*) FROM w.t;
----
400012

statement ok
CHECKPOINT w;

statement ok
DETACH w;

statement ok
ATTACH '{TEMP_DIR}/idx_bind_failure_replay.db' AS w;

query I
SELECT count(*) FROM w.t WHERE m(v) = 400001;
----
1
