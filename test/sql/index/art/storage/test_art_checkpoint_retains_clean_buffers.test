# name: test/sql/index/art/storage/test_art_checkpoint_retains_clean_buffers.test
# description: Checkpoints retain loaded clean ART buffers and leave cold buffers lazy.
# group: [storage]

require noforcestorage

load {TEST_DIR}/art_checkpoint_retains_clean_buffers.db

statement ok
SET threads=1;

statement ok
SET checkpoint_threshold='1TB';

statement ok
SET debug_verify_blocks=true;

statement ok
CREATE TABLE art AS
SELECT hash(i) AS k, 'common-prefix-' || md5(i::VARCHAR) AS s
FROM range(100000) t(i);

statement ok
CREATE UNIQUE INDEX art_k ON art(k);

statement ok
CREATE UNIQUE INDEX art_s ON art(s);

statement ok
CREATE TABLE cold_art AS
SELECT hash(i) AS k FROM range(100000) t(i);

statement ok
CREATE INDEX cold_art_k ON cold_art(k);

statement ok
CREATE TABLE checkpoint_trigger(i BIGINT);

statement ok
INSERT INTO checkpoint_trigger VALUES(0);

statement ok
CHECKPOINT;

# the blocks written by the checkpoint stay cached as ART_INDEX memory, restart so that all buffers start on disk
restart

statement ok
SET threads=1;

statement ok
SET checkpoint_threshold='1TB';

statement ok
SET debug_verify_blocks=true;

query TT
EXPLAIN ANALYZE SELECT k FROM art WHERE k=hash(42);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query TT
EXPLAIN ANALYZE SELECT s FROM art WHERE s='common-prefix-' || md5('42');
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

statement ok
CREATE TEMP TABLE warm_memory AS
SELECT memory_usage_bytes FROM duckdb_memory() WHERE tag='ART_INDEX';

# a checkpoint that rewrites the loaded buffers grows the file
statement ok
CREATE TEMP TABLE warm_blocks AS
SELECT total_blocks FROM pragma_database_size() WHERE database_name = current_database();

query I
SELECT memory_usage_bytes > 0 FROM warm_memory;
----
1

loop checkpoint_number 0 2

statement ok
UPDATE checkpoint_trigger SET i=i+1;

statement ok
CHECKPOINT;

query I
SELECT memory_usage_bytes = (SELECT memory_usage_bytes FROM warm_memory)
FROM duckdb_memory() WHERE tag='ART_INDEX';
----
1

query I
SELECT total_blocks = (SELECT total_blocks FROM warm_blocks)
FROM pragma_database_size() WHERE database_name = current_database();
----
1

endloop

query TT
EXPLAIN ANALYZE SELECT k FROM cold_art WHERE k=hash(42);
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

query I
SELECT memory_usage_bytes > (SELECT memory_usage_bytes FROM warm_memory)
FROM duckdb_memory() WHERE tag='ART_INDEX';
----
1
