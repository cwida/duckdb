# name: test/sql/index/art/storage/test_art_checkpoint_delta_revert_stress.test_slow
# description: Stress reverting index appends while checkpoints are active
# group: [storage]

load {TEST_DIR}/checkpoint_delta_revert_stress.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
CREATE TABLE t(i BIGINT UNIQUE);

statement ok
CREATE TABLE checkpoint_data(i BIGINT, payload VARCHAR);

statement ok
CHECKPOINT;

loop run 0 5

statement ok
INSERT INTO checkpoint_data
SELECT {run} * 1000000 + i, md5(i::VARCHAR)
FROM range(1000000) t(i);

concurrentloop role 0 3

onlyif role=0
statement ok
BEGIN TRANSACTION;

onlyif role=0
statement maybe
INSERT INTO t SELECT {run} * 10000 + range FROM range(2049);
----

onlyif role=1
statement ok
SELECT sum(hash(i)) FROM range(500000) t(i);

onlyif role=1
statement maybe
INSERT INTO t VALUES ({run} * 10000 + 2048);
----

onlyif role=0
statement maybe
SELECT sum(hash(i)) FROM range(1200000) t(i);
----

onlyif role=2
statement ok
SELECT sum(hash(i)) FROM range(1000000) t(i);

onlyif role=2
statement ok
CHECKPOINT;

onlyif role=0
statement maybe
COMMIT;
----

onlyif role=0
statement maybe
ROLLBACK;
----

endloop

statement ok
INSERT OR IGNORE INTO t VALUES ({run} * 10000);

query I
SELECT count(*) FROM t WHERE i = {run} * 10000;
----
1

endloop
