# name: test/sql/extensions/extension_repository_from_host.test
# description: CREATE EXTENSION REPOSITORY <host> without a prefix: the host's .well-known metadata file names the repository
# group: [extensions]

statement ok
SET extension_repository_directory='{TEST_DIR}/extension_repositories'

# Hosts are directories here: '<base>/<host>/.well-known/duckdb-extension-repo.json' stands in for
# 'https://<host>/.well-known/duckdb-extension-repo.json'.
statement ok
SET debug_extension_repository_host_base='{TEST_DIR}/hosts'

# The repository itself: a prefix serving its signing key, as for WITH PREFIX. PER_THREAD_OUTPUT creates directories.
statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/repo' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/repo/.well-known' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT '{"version": 1, "repository_url": "{TEST_DIR}/repo", "signature_keys":[""]}') TO '{TEST_DIR}/repo/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

# The host's file names the prefix; the keys are fetched from the prefix.
statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/pointing.example' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/pointing.example/.well-known' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT '{"version": 1, "repository_url": "{TEST_DIR}/repo/"}') TO '{TEST_DIR}/hosts/pointing.example/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

# The name is the host, spelled as dotted words or as a string.
query III
CREATE EXTENSION REPOSITORY pointing.example
----
pointing.example	{TEST_DIR}/repo	['sha256:172c29bbb3cd41c70a8225d36ba3a53c94ca9236389fba11a71d45ef0524fa3b']

# It is stored like any other repository, and remembers it was resolved from its host.
query III
SELECT repository_name, prefix, host FROM duckdb_extension_repositories() WHERE type='USER_PROVIDED'
----
pointing.example	{TEST_DIR}/repo	pointing.example

# The name is what INSTALL and LOAD take, as dotted words or as a string; an extension that is not served fails on
# the download, not on the name.
statement error
INSTALL nonexistent_extension FROM pointing.example
----
<REGEX>:IO Error.*

statement error
INSTALL nonexistent_extension FROM 'pointing.example'
----
<REGEX>:IO Error.*

statement error
LOAD nonexistent_extension FROM pointing.example
----
<REGEX>:IO Error.*

statement error
INSTALL nonexistent_extension FROM unknown.example
----
<REGEX>:Binder Error.*not a known repository name.*

statement ok
DROP EXTENSION REPOSITORY pointing.example

# ...the string form works too (names are case insensitive); IF NOT EXISTS and OR REPLACE as with WITH PREFIX
statement ok
CREATE EXTENSION REPOSITORY 'POINTING.example'

statement ok
CREATE EXTENSION REPOSITORY IF NOT EXISTS 'pointing.example'

statement error
CREATE EXTENSION REPOSITORY pointing.example
----
<REGEX>:Catalog Error.*already exists.*

statement ok
CREATE OR REPLACE EXTENSION REPOSITORY pointing.example

statement ok
DROP EXTENSION REPOSITORY 'pointing.example'

# Only the url is taken from the host's file: keys in it are ignored, they come from the prefix, which here serves none.
statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/keyed.example' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/keyed.example/.well-known' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT '{"version": 1, "repository_url": "{TEST_DIR}/nowhere", "signature_keys":[""]}') TO '{TEST_DIR}/hosts/keyed.example/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY keyed.example
----
<REGEX>:IO Error.*Failed to read the metadata file.*nowhere.*

# A repository added by prefix has no host.
statement ok
CREATE EXTENSION REPOSITORY byprefix WITH PREFIX '{TEST_DIR}/repo'

query II
SELECT repository_name, host FROM duckdb_extension_repositories() WHERE type='USER_PROVIDED' ORDER BY 1
----
byprefix	NULL

# A host reached over https needs httpfs: when it is not there, that is the error, not a missing file.
statement ok
RESET debug_extension_repository_host_base

statement ok
SET autoload_known_extensions=false

statement error
CREATE EXTENSION REPOSITORY 'needs-httpfs.example'
----
<REGEX>:Missing Extension Error.*requires the httpfs extension.*INSTALL AND LOAD httpfs;.*

statement error
CREATE EXTENSION REPOSITORY byurl WITH PREFIX 'https://needs-httpfs.example/repo'
----
<REGEX>:Missing Extension Error.*requires the httpfs extension.*

statement ok
RESET autoload_known_extensions

statement ok
SET debug_extension_repository_host_base='{TEST_DIR}/hosts'

# A host that serves no metadata file.
statement error
CREATE EXTENSION REPOSITORY unknown.example
----
<REGEX>:IO Error.*does not serve a metadata file.*WITH PREFIX.*

# The built-in names stay reserved.
statement error
CREATE EXTENSION REPOSITORY core_nightly
----
<REGEX>:Invalid Input Error.*built-in repository name.*

# A file of a version this DuckDB does not understand, one that is not json, one without the url.
statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/future.example' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/hosts/future.example/.well-known' (FORMAT csv, PER_THREAD_OUTPUT true)

statement ok
COPY (SELECT '{"version": 2, "repository_url": "{TEST_DIR}/repo"}') TO '{TEST_DIR}/hosts/future.example/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY future.example
----
<REGEX>:IO Error.*version 2.*understands version 1.*

statement ok
COPY (SELECT 'not json') TO '{TEST_DIR}/hosts/future.example/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY future.example
----
<REGEX>:IO Error.*not valid json.*

statement ok
COPY (SELECT '{"version": 1}') TO '{TEST_DIR}/hosts/future.example/.well-known/duckdb-extension-repo.json' (FORMAT csv, HEADER false, QUOTE '', USE_TMP_FILE false)

statement error
CREATE EXTENSION REPOSITORY future.example
----
<REGEX>:IO Error.*repository_url.*

# Names: dots are allowed, but not at the ends or doubled.
statement error
CREATE EXTENSION REPOSITORY 'bad..name' WITH PREFIX '{TEST_DIR}/repo'
----
<REGEX>:Invalid Input Error.*Invalid extension repository name.*

statement error
CREATE EXTENSION REPOSITORY '.hidden' WITH PREFIX '{TEST_DIR}/repo'
----
<REGEX>:Invalid Input Error.*Invalid extension repository name.*

# 'known_hosts': only repositories resolved from their host can be added, and only those are trusted. The runner
# starts in 'allowed'; the setting can only be tightened.
statement ok
CREATE EXTENSION REPOSITORY pointing.example

statement ok
SET allow_extension_repositories='known_hosts'

statement error
CREATE EXTENSION REPOSITORY other WITH PREFIX '{TEST_DIR}/repo'
----
<REGEX>:Permission Error.*by prefix is not permitted.*known_hosts.*

statement ok
CREATE OR REPLACE EXTENSION REPOSITORY pointing.example

# the repository added by prefix is distrusted: installing from it is refused before anything is fetched
statement error
INSTALL nonexistent_extension FROM byprefix
----
<REGEX>:Permission Error.*'byprefix' is not permitted while allow_extension_repositories='known_hosts'.*

# ...while the one resolved from its host is still consulted (and fails on the download, not on permission)
statement error
INSTALL nonexistent_extension FROM pointing.example
----
<REGEX>:IO Error.*

# the ratchet only tightens
statement error
SET allow_extension_repositories='allowed'
----
<REGEX>:Invalid Input Error.*can only be tightened.*

statement ok
DROP EXTENSION REPOSITORY byprefix

statement ok
DROP EXTENSION REPOSITORY pointing.example
