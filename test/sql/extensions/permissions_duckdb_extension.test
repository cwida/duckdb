# name: test/sql/extensions/permissions_duckdb_extension.test
# description: Test that writing (but not reading) into file ending with '.duckdb_extension' is forbidden
# group: [extensions]

statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extension';
----
reserved for DuckDB extensions

statement ok
COPY (SELECT 42) TO '{TEMP_DIR}/name_duckdb_extension';

statement error
COPY (SELECT NULL::BLOB) TO '{TEMP_DIR}/name.duckdb_extension' (FORMAT BLOB);
----
reserved for DuckDB extensions

statement ok
COPY (SELECT NULL::BLOB) TO '{TEMP_DIR}/name.duckdb_extensionz' (FORMAT BLOB);

# what is reserved is a '.duckdb_extension' segment: either at the end of the file name, or followed by a '.'. The
# trust domain is not just the loadable binary - the install metadata and the trusted repository files decide which
# extensions may be loaded, so they are reserved too and can only be written through INSTALL / CREATE EXTENSION
# REPOSITORY. Anything that merely starts with the same text keeps being writable

statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extension.info' (FORMAT CSV);
----
reserved for DuckDB extensions

statement error
COPY (SELECT 42) TO '{TEMP_DIR}/acme.duckdb_extension.repo.json' (FORMAT CSV);
----
reserved for DuckDB extensions

# any future file in the trust domain is covered by the same rule
statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extension.anything' (FORMAT CSV);
----
reserved for DuckDB extensions

# the character right after the segment decides: 'z' and '_' do not close the segment, '.' does
statement ok
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extensionz.info' (FORMAT CSV);

statement ok
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extension_repo.json' (FORMAT CSV);

# the segment must be preceded by a '.' - a name that merely starts with the marker text is not reserved
statement ok
COPY (SELECT 42) TO '{TEMP_DIR}/duckdb_extension.csv' (FORMAT CSV);

statement error
ATTACH '{TEMP_DIR}/my_name.duckdb_extension.info'
----
reserved for DuckDB extensions

statement error
ATTACH '{TEMP_DIR}/my_name.duckdb_extension'
----
reserved for DuckDB extensions

statement ok
ATTACH '{TEMP_DIR}/my_name_duckdb_extension'

statement ok
FROM read_blob('build/*/repository/*/*/parquet.duckdb_extension');

# the trust-domain marker is matched case-insensitively, since the default filesystems on macOS and
# Windows are case-insensitive and would still resolve a differently-cased name to the same file
statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.DUCKDB_EXTENSION';
----
reserved for DuckDB extensions

statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.Duckdb_Extension.Info' (FORMAT CSV);
----
reserved for DuckDB extensions

statement error
COPY (SELECT 42) TO '{TEMP_DIR}/name.duckdb_extension.';
----
reserved for DuckDB extensions
