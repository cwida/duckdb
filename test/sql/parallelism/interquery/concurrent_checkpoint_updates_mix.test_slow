# name: test/sql/parallelism/interquery/concurrent_checkpoint_updates_mix.test_slow
# description: Test concurrent updates, inserts and deletes to a persistent indexed table while checkpointing
# group: [interquery]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

foreach sleep_time 0 25 50 75 100

statement ok
SET debug_checkpoint_sleep_ms={sleep_time}

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates_mix{sleep_time}.db' AS ccu

statement ok
CREATE TABLE ccu.integers AS SELECT i, i AS j, 'str' || i AS s FROM range(20000) t(i)

# updates of the indexed column run as a delete and an insert, the others in place
statement ok
CREATE UNIQUE INDEX integers_i ON ccu.integers(i)

statement ok
CHECKPOINT ccu

concurrentloop threadid 0 23

loop x 0 10

# threads 0-9 update their own 1000 rows ten times
onlyif threadid<10
statement ok
UPDATE ccu.integers SET j = j + 1, s = s || 'x' WHERE i >= {threadid} * 1000 AND i < ({threadid} + 1) * 1000

# threads 11-15 append 100 rows per iteration
onlyif threadid>10&&threadid<16
statement ok
INSERT INTO ccu.integers SELECT i, i, 'str' || i FROM range(100000 + {threadid} * 10000 + {x} * 100, 100000 + {threadid} * 10000 + ({x} + 1) * 100) t(i)

# threads 16-19 delete 100 of their own rows per iteration
onlyif threadid>=16&&threadid<20
statement ok
DELETE FROM ccu.integers WHERE i >= {threadid} * 1000 + {x} * 100 AND i < {threadid} * 1000 + ({x} + 1) * 100

# thread 20 moves 100 of its own rows to new keys per iteration, through the index
onlyif threadid=20
statement ok
UPDATE ccu.integers SET i = i + 1000000, j = j + 1000000, s = 'str' || (i + 1000000) WHERE i >= 10000 + {x} * 100 AND i < 10000 + ({x} + 1) * 100

# threads 21-22 read in a transaction, so that a checkpoint runs while they still see older values: every statement
# above changes whole blocks or slices of rows at once, so every snapshot must show that
onlyif threadid>20
statement ok
BEGIN TRANSACTION

onlyif threadid>20
query IIIIII
SELECT COUNT(*) FILTER (WHERE j - i <> length(s) - length('str' || i)),
       (SELECT COUNT(*) FROM (SELECT i // 1000 AS block, COUNT(DISTINCT j - i) AS c FROM ccu.integers WHERE i < 10000 GROUP BY block) WHERE c > 1),
       COUNT(*) FILTER (WHERE i >= 100000 AND i < 1000000) % 100,
       COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000) % 100,
       COUNT(*) FILTER (WHERE i >= 10000 AND i < 11000) + COUNT(*) FILTER (WHERE i >= 1010000 AND i < 1011000),
       (SELECT COUNT(*) FROM ccu.integers WHERE i = 10500) + (SELECT COUNT(*) FROM ccu.integers WHERE i = 1010500)
FROM ccu.integers
----
0	0	0	0	1000	1

onlyif threadid>20
query IIIIII
SELECT COUNT(*) FILTER (WHERE j - i <> length(s) - length('str' || i)),
       (SELECT COUNT(*) FROM (SELECT i // 1000 AS block, COUNT(DISTINCT j - i) AS c FROM ccu.integers WHERE i < 10000 GROUP BY block) WHERE c > 1),
       COUNT(*) FILTER (WHERE i >= 100000 AND i < 1000000) % 100,
       COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000) % 100,
       COUNT(*) FILTER (WHERE i >= 10000 AND i < 11000) + COUNT(*) FILTER (WHERE i >= 1010000 AND i < 1011000),
       (SELECT COUNT(*) FROM ccu.integers WHERE i = 10500) + (SELECT COUNT(*) FROM ccu.integers WHERE i = 1010500)
FROM ccu.integers
----
0	0	0	0	1000	1

onlyif threadid>20
statement ok
COMMIT

endloop

# thread 10 checkpoints while the others modify the table
loop x 0 3

onlyif threadid=10
statement ok
CHECKPOINT ccu

endloop

endloop

# 20000 original rows + 5 threads * 10 * 100 inserted - 4 threads * 10 * 100 deleted
# 10 threads * 10 iterations * 1000 rows incremented once each
query IIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000) FROM ccu.integers
----
21000	100000	100000	0

# thread 20 moved its 1000 rows to new keys: the lookups go through the index
query III
SELECT COUNT(*) FILTER (WHERE i >= 1010000 AND i < 1011000), (SELECT COUNT(*) FROM ccu.integers WHERE i = 1010500), (SELECT COUNT(*) FROM ccu.integers WHERE i = 10500) FROM ccu.integers
----
1000	1	0

statement ok
DETACH ccu

# replay the WAL of the commits that ran concurrently with the checkpoints
statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates_mix{sleep_time}.db' AS ccu

query IIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000) FROM ccu.integers
----
21000	100000	100000	0

# thread 20 moved its 1000 rows to new keys: the lookups go through the index
query III
SELECT COUNT(*) FILTER (WHERE i >= 1010000 AND i < 1011000), (SELECT COUNT(*) FROM ccu.integers WHERE i = 1010500), (SELECT COUNT(*) FROM ccu.integers WHERE i = 10500) FROM ccu.integers
----
1000	1	0

statement ok
CHECKPOINT ccu

statement ok
DETACH ccu

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates_mix{sleep_time}.db' AS ccu

query IIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000) FROM ccu.integers
----
21000	100000	100000	0

# thread 20 moved its 1000 rows to new keys: the lookups go through the index
query III
SELECT COUNT(*) FILTER (WHERE i >= 1010000 AND i < 1011000), (SELECT COUNT(*) FROM ccu.integers WHERE i = 1010500), (SELECT COUNT(*) FROM ccu.integers WHERE i = 10500) FROM ccu.integers
----
1000	1	0

statement ok
DETACH ccu

endloop
