# name: test/sql/parallelism/interquery/concurrent_reads_during_dbgen.test_slow
# description: Concurrent readers never see the rows that dbgen appends before its transaction commits
# group: [interquery]

require tpch

load {TEST_DIR}/concurrent_reads_during_dbgen.db

# keep the commits free of automatic checkpoints
statement ok
SET checkpoint_threshold = '10GB';

statement ok
SET threads = 4;

statement ok
CALL dbgen(sf=0.1);

statement ok
CHECKPOINT

concurrentloop threadid 0 2

loop i 0 3

onlyif threadid=0
statement ok
BEGIN

onlyif threadid=0
statement ok
DELETE FROM lineitem

onlyif threadid=0
statement ok
CALL dbgen(sf=0.1)

onlyif threadid=0
statement ok
COMMIT

# keep reading for longer than the writer runs, so that the reads overlap its commits
loop j 0 4000

onlyif threadid=1
query I
SELECT count(*) FROM lineitem
----
600572

endloop

endloop

endloop

query I
SELECT count(*) FROM lineitem
----
600572
