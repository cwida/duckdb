# name: test/sql/parallelism/interquery/concurrent_checkpoint_updates.test_slow
# description: Test concurrent updates to a persistent table while checkpointing
# group: [interquery]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

foreach sleep_time 0 25 50 75 100

statement ok
SET debug_checkpoint_sleep_ms={sleep_time}

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates{sleep_time}.db' AS ccu

statement ok
CREATE TABLE ccu.integers AS SELECT i, i AS j, 'str' || i AS s, {'a': i, 'b': 'b' || i} AS st FROM range(20000) t(i)

# make the base data persistent, so that the updates land on persistent segments
statement ok
CHECKPOINT ccu

concurrentloop threadid 0 22

loop x 0 10

# threads 0-19 except 10 increment their own 1000 rows ten times
onlyif threadid<>10&&threadid<20
statement ok
UPDATE ccu.integers SET j = j + 1, s = s || 'x', st = {'a': st.a + 1, 'b': st.b} WHERE i >= {threadid} * 1000 AND i < ({threadid} + 1) * 1000

# the table statistics must cover the updated values
onlyif threadid<>10&&threadid<20
query I
SELECT CASE WHEN MAX(j) <= ANY_VALUE(s.max::INT) THEN NULL ELSE CONCAT('Stats ', ANY_VALUE(s), ' but got value ', MAX(j)) END
FROM (SELECT stats(j) s, j FROM ccu.integers)
----
NULL

# threads 20-21 read in a transaction, so that a checkpoint runs while they still see older values: an update moves
# the three columns of a row and all rows of a block together, so every snapshot must show that
onlyif threadid>=20
statement ok
BEGIN TRANSACTION

onlyif threadid>=20
query II
SELECT COUNT(*) FILTER (WHERE j - i <> length(s) - length('str' || i) OR st.a <> j),
       (SELECT COUNT(*) FROM (SELECT i // 1000 AS block, COUNT(DISTINCT j - i) AS c FROM ccu.integers GROUP BY block) WHERE c > 1)
FROM ccu.integers
----
0	0

onlyif threadid>=20
query II
SELECT COUNT(*) FILTER (WHERE j - i <> length(s) - length('str' || i) OR st.a <> j),
       (SELECT COUNT(*) FROM (SELECT i // 1000 AS block, COUNT(DISTINCT j - i) AS c FROM ccu.integers GROUP BY block) WHERE c > 1)
FROM ccu.integers
----
0	0

onlyif threadid>=20
statement ok
COMMIT

endloop

# thread 10 checkpoints while the others update
loop x 0 3

onlyif threadid=10
statement ok
CHECKPOINT ccu

endloop

endloop

query IIII
SELECT SUM(j - i), SUM(length(s) - length('str' || i)), SUM(st.a - i), COUNT(*) FROM ccu.integers
----
190000	190000	190000	20000

statement ok
DETACH ccu

# replay the WAL of the commits that ran concurrently with the checkpoints
statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates{sleep_time}.db' AS ccu

query IIII
SELECT SUM(j - i), SUM(length(s) - length('str' || i)), SUM(st.a - i), COUNT(*) FROM ccu.integers
----
190000	190000	190000	20000

statement ok
CHECKPOINT ccu

statement ok
DETACH ccu

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_updates{sleep_time}.db' AS ccu

query IIII
SELECT SUM(j - i), SUM(length(s) - length('str' || i)), SUM(st.a - i), COUNT(*) FROM ccu.integers
----
190000	190000	190000	20000

statement ok
DETACH ccu

endloop
