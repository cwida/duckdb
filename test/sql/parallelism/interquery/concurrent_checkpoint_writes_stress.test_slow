# name: test/sql/parallelism/interquery/concurrent_checkpoint_writes_stress.test_slow
# description: Inserts and deletes hitting a table while a checkpoint writes it
# group: [interquery]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# the timing table lives in a database the checkpoints do not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

foreach scan_sleep 0 20 100

statement ok
SET debug_checkpoint_scan_sleep_ms={scan_sleep}

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_stress{scan_sleep}.db' AS ccw

statement ok
CREATE TABLE ccw.integers AS SELECT i, i AS j, 'str' || i AS s FROM range(20000) t(i)

statement ok
CHECKPOINT ccw

concurrentloop threadid 0 20

loop x 0 10

# threads 0-9 append 100 rows per iteration
onlyif threadid<10
statement ok
INSERT INTO ccw.integers SELECT i, i, 'str' || i FROM range(100000 + {threadid} * 10000 + {x} * 100, 100000 + {threadid} * 10000 + ({x} + 1) * 100) t(i)

# threads 11-19 delete 100 of their own rows per iteration
onlyif threadid>10
statement ok
DELETE FROM ccw.integers WHERE i >= {threadid} * 1000 + {x} * 100 AND i < {threadid} * 1000 + ({x} + 1) * 100

onlyif threadid<10
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

onlyif threadid>10
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

# thread 10 checkpoints while the others modify the table
onlyif threadid=10
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=10
statement ok
CHECKPOINT ccw

onlyif threadid=10
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 20 millisecond

endloop

endloop

# 20000 original rows + 10 threads * 10 * 100 inserted - 9 threads * 10 * 100 deleted
query IIII
SELECT COUNT(*), SUM(j - i), COUNT(*) FILTER (WHERE i >= 11000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	0	0	true

statement ok
DETACH ccw

# replay the WAL of the commits that ran concurrently with the checkpoints
statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_stress{scan_sleep}.db' AS ccw

query IIII
SELECT COUNT(*), SUM(j - i), COUNT(*) FILTER (WHERE i >= 11000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	0	0	true

statement ok
CHECKPOINT ccw

statement ok
DETACH ccw

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_stress{scan_sleep}.db' AS ccw

query IIII
SELECT COUNT(*), SUM(j - i), COUNT(*) FILTER (WHERE i >= 11000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	0	0	true

statement ok
DETACH ccw

endloop

# over the three rounds, writes finished while a checkpoint ran (thread 10 alternates start and end rows)
query I
WITH checkpoints AS (SELECT who, t AS start_t, LEAD(t) OVER (ORDER BY t) AS end_t FROM mem.timing WHERE who <> 'writer')
SELECT COUNT(*) > 0 FROM mem.timing w, checkpoints c WHERE w.who = 'writer' AND c.who = 'checkpoint start' AND w.t > c.start_t AND w.t < c.end_t
----
true
