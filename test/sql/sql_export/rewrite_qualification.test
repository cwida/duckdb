foreach disable_optimizer true false

statement ok
SET debug_disable_optimizer={disable_optimizer};

query R rowsort
SELECT avg(i) FROM (VALUES (1),(2),(NULL)) v(i);
----
1.5

endloop

query TT
EXPLAIN (SQL) SELECT avg(i) FROM (VALUES (1),(2),(NULL)) v(i);
----
sql	<REGEX>:.*"?system"?[.]main[.]"?count"?[(].*

query I rowsort
SELECT system.main.count(i) FROM (VALUES (1),(2),(NULL)) v(i);
----
2

query I rowsort
SELECT count(i) FROM (VALUES (1),(2),(NULL)) v(i);
----
999
999
999

endloop

statement ok
SET search_path='main';

foreach disable_optimizer true false

statement ok
SET debug_disable_optimizer={disable_optimizer};

