# name: test/sql/sql_export/rewrite_qualification.test
# description: SQL export qualifies optimizer-produced calls despite search-path shadowing
# group: [sql_export]

statement ok
CREATE SCHEMA shadow;

statement ok
CREATE MACRO shadow.prefix(a,b) AS false;

statement ok
CREATE MACRO shadow.suffix(a,b) AS false;

statement ok
CREATE MACRO shadow.contains(a,b) AS false;

statement ok
CREATE MACRO shadow.count(a) AS 999::BIGINT;

statement ok
SET search_path='shadow,main';

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

foreach disable_optimizer true false

statement ok
SET debug_disable_optimizer={disable_optimizer};

query I rowsort
SELECT s LIKE 'a%' FROM (VALUES ('abc'),('cab'),(NULL)) v(s);
----
0
1
NULL

endloop

query TT
EXPLAIN (SQL) SELECT s LIKE 'a%' FROM (VALUES ('abc'),('cab'),(NULL)) v(s);
----
sql	<REGEX>:.*"?system"?[.]main[.]"?prefix"?[(].*

query I rowsort
SELECT system.main.prefix(s, 'a') FROM (VALUES ('abc'),('cab'),(NULL)) v(s);
----
0
1
NULL

query I rowsort
SELECT prefix(s, 'a') FROM (VALUES ('abc'),('cab'),(NULL)) v(s);
----
0
0
0

foreach disable_optimizer true false

statement ok
SET debug_disable_optimizer={disable_optimizer};

query I rowsort
SELECT s LIKE '%a' FROM (VALUES ('bca'),('abc'),(NULL)) v(s);
----
0
1
NULL

endloop

query TT
EXPLAIN (SQL) SELECT s LIKE '%a' FROM (VALUES ('bca'),('abc'),(NULL)) v(s);
----
sql	<REGEX>:.*"?system"?[.]main[.]"?suffix"?[(].*

query I rowsort
SELECT system.main.suffix(s, 'a') FROM (VALUES ('bca'),('abc'),(NULL)) v(s);
----
0
1
NULL

query I rowsort
SELECT suffix(s, 'a') FROM (VALUES ('bca'),('abc'),(NULL)) v(s);
----
0
0
0

