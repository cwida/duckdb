query IT
WITH RECURSIVE c(k,v) USING KEY(k,list(v)) AS (SELECT 1,1 UNION SELECT 2,count(*)::INTEGER FROM recurring.c WHERE false HAVING nextval('seq')<3) SELECT * FROM c ORDER BY k;
----
1	[1]
2	[0, 0]

query I
SELECT currval('seq');
----
3

