query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN d PRECEDING AND d FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*ASC NULLS FIRST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	5
2	5
2	5
4	8

query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*DESC NULLS LAST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	4
2	4
2	4
4	NULL

query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*DESC NULLS LAST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN 1 FOLLOWING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
