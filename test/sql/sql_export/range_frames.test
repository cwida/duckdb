----
sql	<REGEX>:.*ORDER BY.*DESC NULLS LAST.*RANGE BETWEEN.*

query T rowsort
SELECT sum(x) OVER (ORDER BY x RANGE BETWEEN 0.25 PRECEDING AND 0.5 FOLLOWING) FROM (VALUES (1.00::DECIMAL(9,2)),(1.25),(NULL),(1.25),(2.00)) t(x);
----
2.00
3.50
3.50
3.50
NULL

query T rowsort
SELECT count(*) OVER (ORDER BY x RANGE BETWEEN INTERVAL '1 month' PRECEDING AND INTERVAL '1 day' FOLLOWING) FROM (VALUES (TIMESTAMP '2024-02-29'),(TIMESTAMP '2024-03-30'),(NULL),(TIMESTAMP '2024-03-30')) t(x);
----
1
1
3
3

statement error
SELECT sum(x) OVER (ORDER BY x RANGE BETWEEN -1 PRECEDING AND CURRENT ROW) FROM (VALUES (1),(2)) t(x);
----
<REGEX>:Out\ of\ Range\ Error:\ Invalid\ RANGE\ PRECEDING\ value.*

statement error
SELECT sum(x) OVER (ORDER BY x DESC RANGE BETWEEN CURRENT ROW AND -1 FOLLOWING) FROM (VALUES (1),(2)) t(x);
----
<REGEX>:Out\ of\ Range\ Error:\ Invalid\ RANGE\ FOLLOWING\ value.*

statement error
SELECT sum(x) OVER (ORDER BY x RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM (VALUES (2147483647::INTEGER),(2147483646)) t(x);
----
<REGEX>:Out\ of\ Range\ Error:\ Overflow\ in\ addition\ of\ INT32\ \(2147483647\ \+\ 1\)!.*

query I rowsort
SELECT count(*) OVER (ORDER BY x RANGE BETWEEN 0 PRECEDING AND CURRENT ROW) FROM (VALUES (1),(2)) t(x);
----
1
1

query I rowsort
SELECT count(*) OVER (ORDER BY x RANGE BETWEEN INTERVAL 1 DAY PRECEDING AND CURRENT ROW) FROM (VALUES (DATE '2024-02-28'),(DATE '2024-02-29')) t(x);
----
1
2

query I rowsort
SELECT count(*) OVER (ORDER BY CAST(x AS TIMESTAMP) RANGE BETWEEN INTERVAL 1 DAY PRECEDING AND CURRENT ROW) FROM (VALUES (DATE '2024-02-28'),(DATE '2024-02-29')) t(x);
----
1
2

query I rowsort
SELECT count(*) OVER (ORDER BY x RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) FROM (VALUES (1),(2)) t(x);
----
1
2
