# name: test/sql/sql_export/range_frames.test
# description: SQL export preserves RANGE offsets and ordering types
# group: [sql_export]

statement ok
CREATE TABLE frame_values(id INTEGER,k INTEGER,d DATE,v INTEGER);

statement ok
INSERT INTO frame_values VALUES (1,1,'2024-02-28',10),(2,1,'2024-02-29',20),
    (3,2,'2024-03-01',NULL),(4,4,'2024-03-03',40),(5,NULL,NULL,50);

statement ok
CREATE SEQUENCE range_seq;

query II
SELECT id,sum(v) OVER (ORDER BY k RANGE BETWEEN 0 PRECEDING AND 0 FOLLOWING)
FROM frame_values ORDER BY id
----
1	30
2	30
3	NULL
4	40
5	50

query II
SELECT id,sum(v) OVER (ORDER BY d RANGE BETWEEN INTERVAL 1 DAY PRECEDING AND CURRENT ROW)
FROM frame_values ORDER BY id
----
1	10
2	30
3	20
4	40
5	50

query II
SELECT id,sum(v) OVER (ORDER BY d DESC RANGE BETWEEN INTERVAL 1 DAY PRECEDING AND CURRENT ROW)
FROM frame_values ORDER BY id
----
1	30
2	20
3	NULL
4	40
5	50

query II
SELECT id,sum(v) OVER (ORDER BY d RANGE BETWEEN INTERVAL 1 DAY FOLLOWING AND INTERVAL 2 DAY FOLLOWING)
FROM frame_values ORDER BY id
----
1	20
2	NULL
3	40
4	NULL
5	50

query I
SELECT count(*) OVER (ORDER BY id RANGE BETWEEN (nextval('range_seq') + 1000) PRECEDING AND CURRENT ROW)
FROM frame_values ORDER BY id
----
1
2
3
4
5

query I
SELECT currval('range_seq')
----
5

query II
SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	5
2	9
2	9
4	4

query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*ASC NULLS FIRST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	NULL
2	1
2	1
4	4

query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*ASC NULLS FIRST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 1 FOLLOWING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	4
2	4
2	4
4	NULL

query TT
EXPLAIN (SQL) SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN 1 FOLLOWING AND 2 FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
sql	<REGEX>:.*ORDER BY.*ASC NULLS FIRST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x ASC NULLS FIRST RANGE BETWEEN d PRECEDING AND d FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
----
NULL	NULL
1	5
2	5
2	9
