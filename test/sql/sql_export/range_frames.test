----
sql	<REGEX>:.*ORDER BY.*DESC NULLS LAST.*RANGE BETWEEN.*

query II
SELECT x, sum(x) OVER (ORDER BY x DESC NULLS LAST RANGE BETWEEN d PRECEDING AND d FOLLOWING) FROM (VALUES (1,1),(2,2),(2,1),(4,NULL),(NULL,1)) t(x,d) ORDER BY x NULLS FIRST, 2;
