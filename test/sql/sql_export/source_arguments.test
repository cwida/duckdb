# name: test/sql/sql_export/source_arguments.test
# description: SQL export preserves runtime settings and named or nested source arguments
# group: [sql_export]

statement ok
SET threads=1;

statement ok
SET default_collation='nocase';

foreach mode none explain_sql_strict

statement ok
SET debug_verify_statement='{mode}';

query TTT nosort settings_values
SELECT name,value,typed_value FROM system.main.duckdb_settings() WHERE name IN ('threads','default_collation') ORDER BY name;

endloop

statement ok
SET default_collation='';

foreach mode none explain_sql_strict

statement ok
SET debug_verify_statement='{mode}';

query IT nosort named_type_values
SELECT bigint,varchar FROM test_all_types(use_large_enum := true,use_large_bignum := true) ORDER BY bigint NULLS LAST;

endloop

statement ok
RESET debug_verify_statement;

query TT
EXPLAIN (SQL) SELECT bigint,varchar FROM test_all_types(use_large_enum := true,use_large_bignum := true) ORDER BY bigint NULLS LAST;
----
sql	<REGEX>:.*use_large_enum.*TRUE.*

query TT
EXPLAIN (SQL) SELECT bigint,varchar FROM test_all_types(use_large_enum := true,use_large_bignum := true) ORDER BY bigint NULLS LAST;
----
sql	<REGEX>:.*use_large_bignum.*TRUE.*

query T
SELECT * FROM repeat('a''b',3);
----
a'b
a'b
a'b

query R
SELECT * FROM repeat(NULL::DECIMAL(9,2),2);
----
NULL
NULL

query T
SELECT * FROM repeat([1,NULL,2],2);
----
[1, NULL, 2]
[1, NULL, 2]

query I
SELECT * FROM repeat(42::BIGINT,0);
----

query ITT
SELECT * FROM repeat_row(1::SMALLINT,NULL::VARCHAR,{'a''b':[1,NULL]},num_rows=3);
----
1	NULL	{'a\'b': [1, NULL]}
1	NULL	{'a\'b': [1, NULL]}
1	NULL	{'a\'b': [1, NULL]}

query RIR
SELECT c,a,c FROM repeat_row(NULL::INTEGER,'text',4.50::DECIMAL(8,2),num_rows=2) t(a,b,c);
----
4.50	NULL	4.50
4.50	NULL	4.50

query II
SELECT * FROM repeat_row(NULL::INTEGER,1::BIGINT,num_rows=0);
----

query I
SELECT * FROM unnest([1,NULL,2,2]);
----
1
NULL
2
2

query I
SELECT * FROM unnest([]::INTEGER[]);
----

query I
SELECT * FROM unnest(NULL::INTEGER[]);
----

query I
SELECT * FROM unnest([1,NULL]::INTEGER[2]);
----
1
NULL

query T
SELECT * FROM unnest([{'x':1},{'x':NULL}]);
----
{'x': 1}
{'x': NULL}

query II
SELECT i,j FROM range(4) t(i), range(i) u(j) ORDER BY i,j;
----
1	0
2	0
2	1
3	0
3	1
3	2

query II
SELECT i,j FROM range(3) t(i), generate_series(0,i) u(j) ORDER BY i,j;
----
0	0
1	0
1	1
2	0
2	1
2	2
