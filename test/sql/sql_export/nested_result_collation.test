----
3	2

# unnest nested
query TT
EXPLAIN (SQL) SELECT unnest([CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END]) FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY ALL;
----
sql	<REGEX>:.*SELECT.*

query T
SELECT unnest([CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END]) FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY ALL;
----
{'v': A}
{'v': a}
{'v': B}
{'v': NULL}
NULL

# struct window
query TT
EXPLAIN (SQL) SELECT first_value(v) OVER (ORDER BY i), last_value(v) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT i, CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) ORDER BY i;
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT first_value(v) OVER (ORDER BY i), last_value(v) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT i, CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) ORDER BY i;
----
{'v': A}	NULL
{'v': A}	NULL
{'v': A}	NULL
{'v': A}	NULL
{'v': A}	NULL

# An explicit cast to an uncollated list still clears its element collation.
query TT
EXPLAIN (SQL) SELECT cast_to_type(['A'], array_value('x' COLLATE nocase))[1]='a', (array_value('A' COLLATE nocase)::VARCHAR[])[1]='a';
----
sql	<REGEX>:.*SELECT.*

query II
SELECT cast_to_type(['A'], array_value('x' COLLATE nocase))[1]='a', (array_value('A' COLLATE nocase)::VARCHAR[])[1]='a';
----
true	false
