# struct extracted collation
query TT
EXPLAIN (SQL) SELECT count(v.v), count(*) FILTER (WHERE v.v='a') FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s));
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT count(v.v), count(*) FILTER (WHERE v.v='a') FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s));
----
3	2

# list extracted collation
query TT
EXPLAIN (SQL) SELECT count(v[1]), count(*) FILTER (WHERE v[1]='a') FROM (SELECT CASE WHEN i=4 THEN NULL ELSE [s COLLATE NOCASE] END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s));
----
