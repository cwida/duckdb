# name: test/sql/sql_export/nested_result_collation.test
# description: Preserve nested collations in exported CASE, aggregate, window and UNNEST results
# group: [sql_export]

statement ok
SET debug_verify_statement='explain_sql';

# EXPLAIN must succeed explicitly. Verification can skip unsupported exports.

# struct case
query TT
EXPLAIN (SQL) SELECT i,CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY i;
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT i,CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY i;
----
0	{'v': A}
1	{'v': a}
2	{'v': B}
3	{'v': NULL}
4	NULL

# struct case group
query TT
EXPLAIN (SQL) SELECT v,count(*) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) GROUP BY v ORDER BY v;
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT v,count(*) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) GROUP BY v ORDER BY v;
----
{'v': A}	2
{'v': B}	1
{'v': NULL}	1
NULL	1

# struct case min
query TT
EXPLAIN (SQL) SELECT min(v),max(v) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s));
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT min(v),max(v) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE struct_pack(v := s COLLATE NOCASE) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s));
----
{'v': A}	{'v': NULL}

# tuple case
query TT
EXPLAIN (SQL) SELECT i,CASE WHEN i=4 THEN NULL ELSE row(s COLLATE NOCASE,i % 2) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY i;
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT i,CASE WHEN i=4 THEN NULL ELSE row(s COLLATE NOCASE,i % 2) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s) ORDER BY i;
----
0	(A, 0)
1	(a, 1)
2	(B, 0)
3	(NULL, 1)
4	NULL

# tuple case group
query TT
EXPLAIN (SQL) SELECT v,count(*) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE row(s COLLATE NOCASE,i % 2) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) GROUP BY v ORDER BY v;
----
sql	<REGEX>:.*SELECT.*

query TT
SELECT v,count(*) FROM (SELECT CASE WHEN i=4 THEN NULL ELSE row(s COLLATE NOCASE,i % 2) END v FROM (VALUES (0,'A'),(1,'a'),(2,'B'),(3,NULL),(4,'A')) t(i,s)) GROUP BY v ORDER BY v;
----
(A, 0)	1
(a, 1)	1
(B, 0)	1
(NULL, 1)	1
NULL	1

