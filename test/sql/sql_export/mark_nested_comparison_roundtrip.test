# Empty build: =
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,NULL::INTEGER))) p(id,k) JOIN BY(TYPE MARK) (SELECT row(1,2) k WHERE false) b ON p.k = b.k;
----
[false, false]

