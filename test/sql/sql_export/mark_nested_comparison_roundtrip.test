# Constant operand: p.k IS DISTINCT FROM 2
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::INTEGER),(1,1)) p(id,k) JOIN BY(TYPE MARK) (VALUES (2),(2)) b(k) ON p.k IS DISTINCT FROM 2;
----
[true, true]

# Constant operand: p.k IS DISTINCT FROM NULL::INTEGER
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::INTEGER),(1,1)) p(id,k) JOIN BY(TYPE MARK) (VALUES (2),(2)) b(k) ON p.k IS DISTINCT FROM NULL::INTEGER;
----
[false, true]

# Constant operand: 2 IS DISTINCT FROM p.k
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::INTEGER),(1,1)) p(id,k) JOIN BY(TYPE MARK) (VALUES (2),(2)) b(k) ON 2 IS DISTINCT FROM p.k;
----
[true, true]

# Constant operand: p.k < row(1,NULL::INTEGER)
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2))) p(id,k) JOIN BY(TYPE MARK) (VALUES (2),(2)) b(k) ON p.k < row(1,NULL::INTEGER);
----
[NULL, true]

# Constant operand: row(1,NULL::INTEGER) > p.k
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2))) p(id,k) JOIN BY(TYPE MARK) (VALUES (2),(2)) b(k) ON row(1,NULL::INTEGER) > p.k;
----
[NULL, true]

