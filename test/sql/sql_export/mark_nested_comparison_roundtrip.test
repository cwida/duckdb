[NULL, true, true, true, true]

# TUPLE(INTEGER,INTEGER): IS DISTINCT FROM, duplicate build rows and nested/top-level NULLs
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2)),(2,row(2,1)),(3,row(1,2)),(4,row(1,NULL::INTEGER))) p(id,k) JOIN BY(TYPE MARK) (VALUES (row(1,2)),(row(1,2)),(row(1,NULL::INTEGER))) b(k) ON p.k IS DISTINCT FROM b.k;
----
[true, true, true, true, true]

# TUPLE(INTEGER,INTEGER): IS NOT DISTINCT FROM, duplicate build rows and nested/top-level NULLs
