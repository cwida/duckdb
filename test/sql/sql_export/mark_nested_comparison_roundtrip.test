# name: test/sql/sql_export/mark_nested_comparison_roundtrip.test
# description: SQL export preserves MARK operators on nested values and NULLs
# group: [sql_export]

statement ok
SET debug_verify_statement='explain_sql_strict';

foreach external false true

statement ok
SET debug_force_external={external};

# TUPLE(INTEGER,INTEGER): =, duplicate build rows and nested/top-level NULLs
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2)),(2,row(2,1)),(3,row(1,2)),(4,row(1,NULL::INTEGER))) p(id,k) JOIN BY(TYPE MARK) (VALUES (row(1,2)),(row(1,2)),(row(1,NULL::INTEGER))) b(k) ON p.k = b.k;
----
[NULL, true, false, true, true]

# TUPLE(INTEGER,INTEGER): <>, duplicate build rows and nested/top-level NULLs
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2)),(2,row(2,1)),(3,row(1,2)),(4,row(1,NULL::INTEGER))) p(id,k) JOIN BY(TYPE MARK) (VALUES (row(1,2)),(row(1,2)),(row(1,NULL::INTEGER))) b(k) ON p.k <> b.k;
----
[NULL, NULL, true, NULL, NULL]

# TUPLE(INTEGER,INTEGER): <, duplicate build rows and nested/top-level NULLs
query T
SELECT list(__mark_join_marker ORDER BY id) AS markers FROM (VALUES (0,NULL::TUPLE(INTEGER,INTEGER)),(1,row(1,2)),(2,row(2,1)),(3,row(1,2)),(4,row(1,NULL::INTEGER))) p(id,k) JOIN BY(TYPE MARK) (VALUES (row(1,2)),(row(1,2)),(row(1,NULL::INTEGER))) b(k) ON p.k < b.k;
----
[NULL, true, false, true, false]

