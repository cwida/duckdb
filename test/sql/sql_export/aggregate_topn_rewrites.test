# name: test/sql/sql_export/aggregate_topn_rewrites.test
# description: SQL export preserves aggregate and TopN optimizer rewrites
# group: [sql_export]

statement ok
CREATE TEMP TABLE reuse_owner AS FROM (VALUES (1,10),(2,20),(3,30),(4,40)) t(k,dim_id);

statement ok
CREATE TEMP TABLE reuse_dim AS FROM (VALUES (10,'x'),(20,'b'),(30,'x'),(40,'d')) t(id,label);

statement ok
CREATE TEMP TABLE reuse_fact AS FROM (VALUES (1,10),(1,20),(2,5),(3,40),(3,50),(4,NULL)) t(k,v);

statement ok
SET disabled_optimizers='grouping_sets';

query TTT
SELECT i,j,sum(k) FROM (VALUES (1,1,2),(1,2,3),(2,1,4),(2,2,5)) t(i,j,k) GROUP BY ROLLUP(i,j) ORDER BY ALL;
----
1	1	2
1	2	3
1	NULL	5
2	1	4
2	2	5
2	NULL	9
NULL	NULL	14

query TT
EXPLAIN SELECT i,j,sum(k) FROM (VALUES (1,1,2),(1,2,3),(2,1,4),(2,2,5)) t(i,j,k) GROUP BY ROLLUP(i,j) ORDER BY ALL;
----
physical_plan	<!REGEX>:.*combine_aggr[(].*

