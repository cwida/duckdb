statement ok
CREATE TABLE computed_groups(i INTEGER);

statement ok
INSERT INTO computed_groups VALUES (3),(4),(4),(NULL);

query I
SELECT i*2 FROM computed_groups GROUP BY i*2 ORDER BY 1;
----
6
8
NULL

query II
SELECT CAST(i AS SMALLINT),count(*) FROM computed_groups GROUP BY CAST(i AS SMALLINT) ORDER BY 1;
----
3	1
4	2
NULL	1

query T
SELECT string_agg(DISTINCT v, '|' ORDER BY length(v), v) FROM (VALUES ('aa'),('b'),('b'),(NULL)) t(v);
----
b|aa
