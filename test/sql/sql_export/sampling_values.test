# The invalid method/count combination fails during generated preparation.
statement ok
SET debug_verify_statement='none';

statement error
SELECT * FROM range(10000) USING SAMPLE 31 (bernoulli,42);
----
<REGEX>:Parser Error:.*cannot be used with a discrete sample count.*

statement ok
SET debug_verify_statement='explain_sql_strict';

query TT
EXPLAIN (SQL) SELECT * FROM range(10000) USING SAMPLE 31 (bernoulli,42);
----
sql	<REGEX>:.*USING SAMPLE 31[[:space:]]*[(](?i:Bernoulli), 42[)].*

statement ok
CREATE TABLE sample_source AS SELECT i FROM range(10000) t(i);

