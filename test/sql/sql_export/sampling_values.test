query II nosort sample_result
SELECT * FROM (SELECT i,CASE WHEN i%5=0 THEN NULL ELSE i%3 END v FROM range(10000)t(i) WHERE i%2=0) USING SAMPLE 31 (reservoir,42);

query I nosort sample_result_effects
SELECT last_value FROM duckdb_sequences() WHERE sequence_name='seq';

endloop

reset label sample_result

reset label sample_result_effects

