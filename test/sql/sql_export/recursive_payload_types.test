# name: test/sql/sql_export/recursive_payload_types.test
# description: SQL export preserves recursive key collations and polymorphic payload aggregates
# group: [sql_export]

statement ok
SET threads=1;

query T
WITH RECURSIVE c(x) USING KEY(x) AS (SELECT (x) COLLATE nocase FROM (VALUES ('A'),('a'),(NULL))v(x) UNION SELECT x FROM c WHERE false) SELECT x FROM c ORDER BY x NULLS LAST;
----
A
NULL

query T
WITH RECURSIVE c(x) USING KEY(x) AS (SELECT (x || '') COLLATE nocase FROM (VALUES ('A'),('a'),(NULL))v(x) UNION SELECT x FROM c WHERE false) SELECT x FROM c ORDER BY x NULLS LAST;
----
A
NULL

query T
WITH RECURSIVE c(x) USING KEY(x) AS (SELECT (CASE WHEN true THEN x ELSE NULL END) COLLATE nocase FROM (VALUES ('A'),('a'),(NULL))v(x) UNION SELECT x FROM c WHERE false) SELECT x FROM c ORDER BY x NULLS LAST;
----
A
NULL

query T
WITH RECURSIVE c(x) USING KEY(x) AS (SELECT (replace(x,'z','z')) COLLATE nocase FROM (VALUES ('A'),('a'),(NULL))v(x) UNION SELECT x FROM c WHERE false) SELECT x FROM c ORDER BY x NULLS LAST;
----
A
NULL

statement ok
SET disabled_optimizers='compressed_materialization';

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query III
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,3::INTEGER UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
3	1	3
3	2	3
3	3	3

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query RIR
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,3.25::DECIMAL(9,2) UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
3.25	1	3.25
3.25	2	3.25
3.25	3	3.25

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,'a'::VARCHAR UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
a	1	a
a	2	a
a	3	a

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,'a' COLLATE "binary" UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
a	1	a
a	2	a
a	3	a

endloop

endloop

foreach aggregate min max last

