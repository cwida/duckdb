query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,[3,NULL]::INTEGER[] UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
[3, NULL]	1	[3, NULL]
[3, NULL]	2	[3, NULL]
[3, NULL]	3	[3, NULL]

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,{'n':3}::STRUCT(n INTEGER) UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
{'n': 3}	1	{'n': 3}
{'n': 3}	2	{'n': 3}
{'n': 3}	3	{'n': 3}

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,DATE '2001-02-03' UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
2001-02-03	1	2001-02-03
2001-02-03	2	2001-02-03
2001-02-03	3	2001-02-03

endloop

endloop

foreach aggregate min max last

foreach quantifier DISTINCT ALL

query TIT
WITH RECURSIVE r(k,v) USING KEY(k,system.main.{aggregate}(v)) AS (SELECT 1,[3]::INTEGER[1] UNION {quantifier} SELECT k+1,v FROM r WHERE k<3) SELECT v,k,v FROM r ORDER BY k;
----
[3]	1	[3]
[3]	2	[3]
[3]	3	[3]

endloop

endloop

query II
WITH RECURSIVE r(k,v) USING KEY(k,last(v)) AS (SELECT 1,'a' COLLATE nocase UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v='A' FROM r ORDER BY k;
----
1	true
2	true
3	true

query II
WITH RECURSIVE r(k,v) USING KEY(k,max(v+1) AS v) AS (VALUES(1,3),(1,1),(1,NULL) UNION ALL SELECT k+1,v FROM r WHERE k<3) SELECT k,v FROM r ORDER BY k;
----
1	4
2	4
3	4

query II
WITH RECURSIVE r(k,v) USING KEY(k,last(v)) AS MATERIALIZED (VALUES(1,3),(1,NULL),(NULL,4) UNION SELECT d.k+1,d.v FROM r d,recurring.r a WHERE d.k=a.k AND d.k<3) SELECT * FROM r ORDER BY ALL;
----
1	NULL
2	NULL
3	NULL
NULL	4

query III
WITH RECURSIVE r(a,b,c) USING KEY(c,a,max(b+1) AS b) AS (VALUES(1,3,1),(1,1,1) UNION ALL SELECT a+1,b,c FROM r WHERE a<3) SELECT c,b,a FROM r ORDER BY a;
----
1	4	1
1	4	2
1	4	3
