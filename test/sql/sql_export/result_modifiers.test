statement ok
SET disabled_optimizers='grouping_sets,compressed_materialization';

query II rowsort
SELECT grouping(1+1,2+0),count(*) FROM (VALUES(1),(2))t(x) GROUP BY GROUPING SETS ((1+1),(2+0),());
----
1	2
2	2
3	2

statement ok
SET disabled_optimizers='';

query I rowsort
SELECT 1;
----
1

statement ok
SET disabled_optimizers='distinct_aggregate_rewrite';

query IIT rowsort
SELECT x,sum(DISTINCT y) FILTER (WHERE y>5), list(y ORDER BY y DESC NULLS FIRST) FROM (VALUES (1,10),(1,20),(NULL,5),(2,NULL),(2,NULL)) t(x,y) GROUP BY x;
----
1	30	[20, 10]
2	NULL	[NULL, NULL]
NULL	NULL	[5]

statement ok
SET disabled_optimizers='';

query II rowsort
SELECT x,sum(y) FROM (VALUES (1,10),(1,20),(NULL,5),(2,NULL),(2,NULL)) t(x,y) WHERE false GROUP BY x;
----

query RTT rowsort
SELECT NULL::DECIMAL(9,2) a, [1,NULL] b, {'x': 2} c WHERE false;
----

query TT
EXPLAIN (SQL) SELECT NULL::DECIMAL(9,2) a, [1,NULL] b, {'x': 2} c WHERE false;
----
sql	<REGEX>:.*WHERE .*FALSE.*

# A typed empty relation retains COUNT's canonical ANY signature under strict SQL export.
query T
SELECT * FROM (SELECT count(x) EXPORT_STATE s FROM (VALUES(1))t(x))t WHERE false;
----

query TT
EXPLAIN (SQL) SELECT * FROM (SELECT count(x) EXPORT_STATE s FROM (VALUES(1))t(x))t WHERE false;
----
sql	<REGEX>:.*to_aggregate_state.*ANY.*

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) UNION (VALUES (1),(1),(NULL),(3));
----
1
2
3
NULL

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) UNION ALL (VALUES (1),(1),(NULL),(3));
----
1
1
1
1
1
2
3
NULL
NULL
NULL

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) EXCEPT (VALUES (1),(1),(NULL),(3));
----
2

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) EXCEPT ALL (VALUES (1),(1),(NULL),(3));
----
1
2
NULL

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) INTERSECT (VALUES (1),(1),(NULL),(3));
----
1
NULL

query I rowsort
(VALUES (1),(1),(1),(NULL),(NULL),(2)) INTERSECT ALL (VALUES (1),(1),(NULL),(3));
----
1
1
NULL


statement ok
SET debug_verify_serializer=true;

query T
