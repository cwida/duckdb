DROP TABLE IF EXISTS r;

statement ok
CREATE TABLE l(g DOUBLE,k INTEGER,x INTEGER);

statement ok
CREATE TABLE r(g DOUBLE,k INTEGER,y INTEGER);

statement ok
INSERT INTO l SELECT g,k,v FROM (VALUES (1,1,10),(1,1,10),(1,1,20),(1,1,NULL),(1,2,10),(1,2,NULL),(1,3,NULL),(2,1,20),(NULL,1,10),(NULL,1,NULL),(1,NULL,20),(NULL,NULL,NULL)) t(g,k,v);

statement ok
INSERT INTO r SELECT g,k,v FROM (VALUES (1,1,10),(1,1,10),(1,1,NULL),(1,2,NULL),(2,1,10),(NULL,1,10),(1,NULL,NULL)) t(g,k,v);

query TTTT rowsort
SELECT o.g,o.k,o.x,o.x=ANY(SELECT r.y FROM r WHERE r.g=o.g AND r.k=o.k) m FROM l o;
----
1.0	1	10	true
