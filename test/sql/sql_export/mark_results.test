# name: test/sql/sql_export/mark_results.test
# description: SQL export preserves scalar and grouped MARK results
# group: [sql_export]

statement ok
SET debug_verify_statement='explain_sql_strict';

statement ok
SET threads=1;

query I rowsort
SELECT 1 = ANY(SELECT 1);
----
1

query I rowsort
SELECT 1 = ANY(SELECT 2);
----
0

query I rowsort
SELECT 'ABC' COLLATE nocase IN (SELECT 'aBc');
----
1

query I rowsort
SELECT NULL::INTERVAL IN (SELECT INTERVAL 1 DAY);
----
NULL

query I rowsort
SELECT 1 = ANY(SELECT 1 WHERE false);
----
0

query I rowsort
SELECT 1 = ANY(SELECT NULL::INTEGER);
----
NULL

query I rowsort
SELECT 1 NOT IN (VALUES (2),(NULL));
----
NULL

query I rowsort
SELECT 1 WHERE (1,2) IN (SELECT 1,2);
----
1

query I rowsort
SELECT 1 WHERE (1,2) IN (VALUES (1,2),(1,2),(NULL,2));
----
1

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a IS DISTINCT FROM 2;
----
true

query I
SELECT __mark_join_marker FROM (VALUES (NULL::INTEGER)) l(a) JOIN BY (TYPE MARK) (VALUES (2)) r(b) ON a IS DISTINCT FROM NULL::INTEGER;
----
false

statement ok
CREATE TABLE mark_probe(id INTEGER,label VARCHAR,a INTEGER,c INTEGER);

statement ok
INSERT INTO mark_probe VALUES (0,'null',NULL,NULL),(1,'one',1,NULL),(2,'two',2,2);

statement ok
CREATE TABLE mark_build(b INTEGER,d INTEGER);

statement ok
INSERT INTO mark_build VALUES (1,NULL);

query TTT rowsort
SELECT label,id,a IN (SELECT b FROM mark_build WHERE c+d>0) FROM mark_probe;
----
null	0	false
one	1	false
two	2	false

statement ok
DELETE FROM mark_build;

query TTT rowsort
SELECT label,id,a IN (SELECT b FROM mark_build WHERE c+d>0) FROM mark_probe;
----
null	0	false
one	1	false
two	2	false

