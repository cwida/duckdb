statement ok
SET pivot_limit=3;

statement error
FROM (VALUES ('a',1),('b',2)) t(k,v) PIVOT (sum(v) FOR k IN ('a','b','z'));
----
<REGEX>:Binder Error: Pivot column limit of 3 exceeded.*

statement error
EXPLAIN (SQL) FROM (VALUES ('a',1),('b',2)) t(k,v) PIVOT (sum(v) FOR k IN ('a','b','z'));
----
<REGEX>:Binder Error: Pivot column limit of 3 exceeded.*

statement ok
RESET pivot_limit;
