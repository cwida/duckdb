# name: test/sql/timezone/test_icu_calendar_range_error.test
# description: Date parts that cannot be represented in a non-Gregorian calendar throw a conversion error
# group: [timezone]

require icu

statement ok
SET Calendar='chinese';

statement error
SELECT era(TIMESTAMPTZ '294247-01-10 04:00:54.775806+00');
----
Conversion Error: Unable to extract calendar part

statement error
SELECT year(TIMESTAMPTZ '294247-01-10 04:00:54.775806+00');
----
Conversion Error: Unable to extract calendar part

statement error
SELECT month(TIMESTAMPTZ '294247-01-10 04:00:54.775806+00');
----
Conversion Error: Unable to extract calendar part

