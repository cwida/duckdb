# name: test/sql/subquery/any_all/test_correlated_tuple_in.test
# description: Correlated IN with a tuple on both sides
# group: [any_all]

statement ok
CREATE TABLE t1(a INTEGER, b INTEGER, c INTEGER);

statement ok
CREATE TABLE t2(a INTEGER, b INTEGER, c INTEGER);

statement ok
INSERT INTO t1 VALUES (1, 1, 1), (1, 2, 1), (2, 2, 2), (3, NULL, 3), (4, 4, 5);

statement ok
INSERT INTO t2 VALUES (1, 1, 1), (2, 2, 3), (3, NULL, 3), (4, 4, 5);

query I
SELECT t1.a FROM t1 WHERE (a, b) IN (SELECT (t2.a, t2.b) FROM t2 WHERE t2.c = t1.c) ORDER BY ALL
----
1
3
4

query III
SELECT a, b, (a, b) IN (SELECT (t2.a, t2.b) FROM t2 WHERE t2.c = t1.c) FROM t1 ORDER BY ALL
----
1	1	true
1	2	false
2	2	false
3	NULL	true
4	4	true

query I
SELECT t1.a FROM t1 WHERE (a, b) NOT IN (SELECT (t2.a, t2.b) FROM t2 WHERE t2.c = t1.c) ORDER BY ALL
----
1
2

statement error
SELECT t1.a FROM t1 WHERE (a, b) IN (SELECT t2.a, t2.b FROM t2 WHERE t2.c = t1.c)
----
Correlated IN/ANY/ALL with multiple columns not yet supported
