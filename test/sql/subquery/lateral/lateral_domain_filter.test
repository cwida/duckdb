# name: test/sql/subquery/lateral/lateral_domain_filter.test
# description: Restrict a generated correlation domain through its outer-row consumer
# group: [lateral]

# Plan assertions use the original planner metadata; disabled and serialized paths are checked below.
statement ok
SET enable_optimizer=true;

statement ok
SET debug_verify_serializer=false;

statement ok
SET max_execution_time=10000;

statement ok
CREATE TABLE vertices AS SELECT i::INTEGER AS id FROM range(100) t(i);

statement ok
CREATE VIEW joined_walk AS
SELECT input.id, expanded.depth
FROM vertices input
CROSS JOIN LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + input.id * 0
        UNION ALL
        SELECT depth + 1 FROM walk WHERE depth < 7
    )
    SELECT depth FROM walk
) expanded
JOIN vertices target ON target.id = expanded.depth + 1;

query I
SELECT count(*) FROM joined_walk WHERE id = 3;
----
8

# The predicate must reach the producer, not just its outer-row CTE scan.
query II
EXPLAIN SELECT count(*) FROM joined_walk WHERE id = 3;
----
physical_plan	<REGEX>:[\s\S]*Filters: id = 3[\s\S]*

query II
SELECT count(*), sum(depth) FROM joined_walk WHERE id = 3 AND depth > 4;
----
3	18

query I
SELECT count(*) FROM (SELECT depth, id AS selected FROM joined_walk) q,
    (VALUES (1), (2)) v(x) WHERE selected = 3;
----
16

# Non-key filters retain every needed key, without losing duplicate outer rows.
statement ok
CREATE TABLE owners(person INTEGER, class INTEGER);

statement ok
INSERT INTO owners VALUES (1,10), (1,10), (1,NULL), (2,10), (3,20);

statement ok
CREATE VIEW owner_walk AS
SELECT o.person, o.class, w.depth
FROM owners o, LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + coalesce(o.class, 0) * 0
        UNION ALL SELECT depth + 1 FROM walk WHERE depth < 2
    ) SELECT depth FROM walk
) w JOIN vertices v ON v.id = w.depth;

query II
SELECT count(*), sum(depth) FROM owner_walk WHERE person = 1;
----
9	9

query II
EXPLAIN SELECT count(*) FROM owner_walk WHERE person = 1;
----
physical_plan	<REGEX>:[\s\S]*Filters: person = 1[\s\S]*

# Shared consumers and global windows must retain their complete input.
query II
WITH shared AS MATERIALIZED (SELECT * FROM owner_walk)
SELECT (SELECT count(*) FROM shared WHERE person = 1), (SELECT count(*) FROM shared);
----
9	15

query I
SELECT count(*) FROM (SELECT *, count(*) OVER () AS n FROM owner_walk) q
WHERE person = 1 AND n = 15;
----
9

query II
EXPLAIN SELECT count(*) FROM (SELECT * FROM owner_walk LIMIT 1) q WHERE person = 1;
----
physical_plan	<!REGEX>:[\s\S]*Filters: person = 1[\s\S]*

# A user CTE's unfiltered aggregate consumer needs all rows, including matching keys.
query II rowsort
WITH r AS MATERIALIZED (SELECT * FROM owners), d AS (SELECT class, sum(person) AS total FROM r GROUP BY class)
SELECT r.class, d.total FROM r JOIN d ON r.class IS NOT DISTINCT FROM d.class WHERE r.person = 1;
----
10	4
10	4
NULL	1

# Lowering remains correct when optional optimizations are disabled.
foreach setting enable_optimizer debug_disable_optimizer

statement ok
SET {setting} = false;

query I
SELECT count(*) FROM joined_walk WHERE id = 3;
----
8

statement ok
SET {setting} = true;

query I
SELECT count(*) FROM joined_walk WHERE id = 3;
----
8

statement ok
RESET {setting};

endloop

foreach disabled filter_pushdown cte_filter_pusher cte_inlining unused_columns deliminator

statement ok
SET disabled_optimizers = '{disabled}';

query II
SELECT count(*), sum(depth) FROM owner_walk WHERE person = 1;
----
9	9

statement ok
RESET disabled_optimizers;

endloop

statement ok
PREPARE selected_walk AS SELECT count(*) FROM joined_walk WHERE id = $1;

query I
EXECUTE selected_walk(3);
----
8

query I
EXECUTE selected_walk(1000);
----
0

# All correlation keys survive, including strings, NULLs and shared tuples.
statement ok
CREATE TABLE keys(person INTEGER, k VARCHAR, s BIGINT);

statement ok
INSERT INTO keys VALUES (1,'a',2), (1,NULL,2), (1,'a',NULL), (2,'a',2);

query II
SELECT count(*), sum(w.n) FROM keys input, LATERAL (
    WITH RECURSIVE walk(n, depth) AS (
        SELECT coalesce(length(input.k), 0) + coalesce(input.s, 0), 0
        UNION ALL SELECT n, depth + 1 FROM walk WHERE depth < 1
    ) SELECT * FROM walk
) w JOIN vertices target ON target.id = w.depth WHERE person = 1;
----
6	12

# An observable recursive body must still evaluate the original domain.
statement ok
CREATE SEQUENCE body_calls;

query I
SELECT count(w.value) FROM owners input, LATERAL (
    WITH RECURSIVE walk(value, depth) AS (
        SELECT nextval('body_calls') + coalesce(input.class, 0) * 0, 0
        UNION ALL SELECT value, depth + 1 FROM walk WHERE depth < 2
    ) SELECT * FROM walk
) w JOIN vertices target ON target.id = w.depth WHERE person = 1;
----
9

query I
SELECT currval('body_calls');
----
3

# Restricting a producer must not change sequence values assigned to retained rows.
statement ok
CREATE SEQUENCE producer_calls;

query III
WITH input AS MATERIALIZED (SELECT *, nextval('producer_calls') AS value FROM owners)
SELECT count(*), sum(input.value), (SELECT count(value) FROM input) FROM input,
LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + coalesce(input.class, 0) * 0
        UNION ALL SELECT depth + 1 FROM walk WHERE depth < 2
    ) SELECT * FROM walk
) w JOIN vertices target ON target.id = w.depth WHERE person = 1;
----
9	18	5

query I
SELECT currval('producer_calls');
----
5

# Explicit barriers cannot be copied into the producer.
query II
EXPLAIN SELECT count(*) FROM owner_walk WHERE __internal_barrier(person = 1);
----
physical_plan	<!REGEX>:[\s\S]*Filters: person = 1[\s\S]*

# A throwing predicate still cannot cross the producer projection.
query II
EXPLAIN SELECT count(*) FROM owner_walk WHERE person::VARCHAR::INTEGER = 1;
----
physical_plan	<!REGEX>:[\s\S]*Filters: person = 1[\s\S]*

statement ok
SET debug_verify_serializer=true;

query II
SELECT count(*), sum(depth) FROM owner_walk WHERE person = 1;
----
9	9

statement ok
RESET debug_verify_serializer;

# External CTE consumers cannot inherit a generated domain's restriction permission.
query II
WITH input AS MATERIALIZED (SELECT * FROM owners), walks AS MATERIALIZED (
    SELECT input.person, w.depth FROM input, LATERAL (
        WITH RECURSIVE walk(depth) AS (
            SELECT 0 + coalesce(input.class, 0) * 0
            UNION ALL SELECT depth + 1 FROM walk WHERE depth < 2
        ) SELECT * FROM walk
    ) w JOIN vertices target ON target.id = w.depth
)
SELECT (SELECT count(*) FROM walks WHERE person = 1), (SELECT sum(person) FROM input);
----
9	8

# LEFT correlations retain unmatched rows when their recursive results are empty.
query II
SELECT count(*), count(w.depth) FROM owners input LEFT JOIN LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + coalesce(input.class, 0) * 0
        UNION ALL SELECT depth + 1 FROM walk WHERE depth < 2
    ) SELECT * FROM walk WHERE depth > 2
) w ON true JOIN vertices target ON target.id = input.person WHERE person = 1;
----
3	0

# Separate generated domains must not share their consumer identities.
query I
SELECT count(*) FROM owner_walk a JOIN owner_walk b ON a.person = b.person WHERE a.person = 1;
----
81

query II
WITH copied AS NOT MATERIALIZED (SELECT * FROM owner_walk)
SELECT (SELECT count(*) FROM copied WHERE person = 1),
       (SELECT count(*) FROM copied WHERE person = 2);
----
9	3

# A nested domain keeps its enclosing correlation's rows and multiplicity.
query I
SELECT count(*) FROM owners input, LATERAL (
    WITH RECURSIVE outer_walk(depth) AS (
        SELECT 0 + coalesce(input.class, 0) * 0
        UNION ALL SELECT depth + 1 FROM outer_walk WHERE depth < 2
    )
    SELECT w.depth, inner_walk.step FROM outer_walk w, LATERAL (
        WITH RECURSIVE inner_steps(step) AS (
            SELECT 0 + w.depth * 0
            UNION ALL SELECT step + 1 FROM inner_steps WHERE step < 1
        ) SELECT * FROM inner_steps
    ) inner_walk
) w JOIN vertices target ON target.id = w.depth WHERE person = 1;
----
18

statement ok
RESET max_execution_time;
