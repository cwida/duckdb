# name: test/sql/constraints/deferred/test_deferred_alter.test
# description: Adding deferred constraints to tables with committed and local rows
# group: [deferred]

statement ok
CREATE TABLE with_duplicates(i INTEGER);

statement ok
INSERT INTO with_duplicates VALUES (1), (1);

statement error
ALTER TABLE with_duplicates ADD UNIQUE(i) DEFERRED;
----
Data contains duplicates on indexed column(s)

statement ok
CREATE TABLE without_duplicates(i INTEGER);

statement ok
INSERT INTO without_duplicates VALUES (1), (2);

statement ok
ALTER TABLE without_duplicates ADD UNIQUE(i) DEFERRED;

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO without_duplicates VALUES (2);

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
CREATE TABLE altered_in_transaction(i INTEGER);

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO altered_in_transaction VALUES (2);

statement ok
ALTER TABLE altered_in_transaction ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM altered_in_transaction WHERE i = 1;

statement ok
INSERT INTO altered_in_transaction VALUES (1);

statement ok
COMMIT;

query I rowsort
SELECT i FROM altered_in_transaction;
----
1
2

statement ok
CREATE TABLE local_duplicates(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1), (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (1);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

query I
SELECT count(*) FROM local_duplicates;
----
1

# the local duplicates can still be resolved before the commit
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_duplicates VALUES (2), (2);

statement ok
ALTER TABLE local_duplicates ADD UNIQUE(i) DEFERRED;

statement ok
DELETE FROM local_duplicates WHERE rowid = (SELECT max(rowid) FROM local_duplicates);

statement ok
COMMIT;

query I rowsort
SELECT i FROM local_duplicates;
----
1
2

statement ok
CREATE TABLE local_nulls(i INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO local_nulls VALUES (NULL);

statement error
ALTER TABLE local_nulls ADD PRIMARY KEY(i) DEFERRED;
----
NOT NULL constraint failed

statement ok
ROLLBACK;

# FIXME: deletes made before the constraint is added are not in its delete index, so reinserting the key is a false duplicate
statement ok
CREATE TABLE deleted_before_alter(i INTEGER);

statement ok
INSERT INTO deleted_before_alter VALUES (1);

statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM deleted_before_alter WHERE i = 1;

statement ok
ALTER TABLE deleted_before_alter ADD UNIQUE(i) DEFERRED;

statement ok
INSERT INTO deleted_before_alter VALUES (1);

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

# ALTER statements that rebuild the transaction-local storage keep its rows and delete index
statement ok
CREATE TABLE add_column(i INTEGER PRIMARY KEY DEFERRED, j INTEGER);

statement ok
CREATE TABLE alter_type(i INTEGER PRIMARY KEY DEFERRED, j INTEGER);

statement ok
CREATE TABLE drop_column(i INTEGER PRIMARY KEY DEFERRED, j INTEGER);

statement ok
INSERT INTO add_column VALUES (1, 10); INSERT INTO alter_type VALUES (1, 10); INSERT INTO drop_column VALUES (1, 10);

statement ok
BEGIN; INSERT INTO add_column VALUES (2, 20), (2, 21); ALTER TABLE add_column ADD COLUMN k INTEGER;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN; DELETE FROM add_column WHERE i = 1; ALTER TABLE add_column ADD COLUMN k INTEGER; INSERT INTO add_column VALUES (1, 11, 0);

statement ok
COMMIT;

statement ok
BEGIN; INSERT INTO alter_type VALUES (2, 20), (2, 21); ALTER TABLE alter_type ALTER j TYPE BIGINT;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN; DELETE FROM alter_type WHERE i = 1; ALTER TABLE alter_type ALTER j TYPE BIGINT; INSERT INTO alter_type VALUES (1, 11);

statement ok
COMMIT;

statement ok
BEGIN; INSERT INTO drop_column VALUES (2, 20), (2, 21); ALTER TABLE drop_column DROP COLUMN j;

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN; DELETE FROM drop_column WHERE i = 1; ALTER TABLE drop_column DROP COLUMN j; INSERT INTO drop_column VALUES (1);

statement ok
COMMIT;

query III
SELECT (SELECT count(*) FROM add_column), (SELECT count(*) FROM alter_type), (SELECT count(*) FROM drop_column);
----
1	1	1
