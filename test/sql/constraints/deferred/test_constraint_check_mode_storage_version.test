# name: test/sql/constraints/deferred/test_constraint_check_mode_storage_version.test
# description: Require compatible storage for explicit constraint check mode
# group: [deferred]

load {TEST_DIR}/constraint_check_mode_old.db readwrite v1.5.0

statement ok
CREATE TABLE t1(i INTEGER UNIQUE, j INTEGER PRIMARY KEY);

statement ok
INSERT INTO t1 VALUES (1, 2);

statement error
CREATE TABLE t2(i INTEGER UNIQUE IMMEDIATE);
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

statement error
CREATE TABLE t2(i INTEGER, PRIMARY KEY(i) IMMEDIATE);
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

statement error
CREATE TABLE t2(i INTEGER UNIQUE DEFERRED);
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

statement ok
CREATE TABLE t2(i INTEGER, j INTEGER);

statement error
ALTER TABLE t2 ADD UNIQUE(i) IMMEDIATE;
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

statement error
ALTER TABLE t2 ADD PRIMARY KEY(j) IMMEDIATE;
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

statement error
ALTER TABLE t2 ADD UNIQUE(i) DEFERRED;
----
Binder Error: Explicit constraint check mode is only supported for storage versions v2.0.0 and higher.

# Failed ALTER statements leave the table available for ordinary constraints.
statement ok
ALTER TABLE t2 ADD UNIQUE(i);

statement ok
ALTER TABLE t2 ADD PRIMARY KEY(j);

statement ok
CREATE TEMP TABLE t3(i INTEGER UNIQUE IMMEDIATE, j INTEGER);

statement ok
ALTER TABLE t3 ADD PRIMARY KEY(j) IMMEDIATE;

# Check the target database, even when the default database uses older storage.
statement ok
ATTACH ':memory:' AS mem;

statement ok
CREATE TABLE mem.t(i INTEGER UNIQUE IMMEDIATE, j INTEGER);

statement ok
ALTER TABLE mem.t ADD PRIMARY KEY(j) IMMEDIATE;

statement ok
ATTACH '{TEST_DIR}/constraint_check_mode_new.db' AS db (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE TABLE db.t(i INTEGER UNIQUE IMMEDIATE, j INTEGER);

statement ok
ALTER TABLE db.t ADD PRIMARY KEY(j) IMMEDIATE;

restart

statement ok
INSERT INTO t1 VALUES (3, 4);

query I
SELECT count(*) FROM t1;
----
2

query I rowsort
SELECT constraint_text FROM duckdb_constraints() WHERE table_name = 't2' AND constraint_type <> 'NOT NULL';
----
PRIMARY KEY(j)
UNIQUE(i)
