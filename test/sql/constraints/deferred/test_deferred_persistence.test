# name: test/sql/constraints/deferred/test_deferred_persistence.test
# description: Deferred constraint check mode survives checkpoints and WAL replay
# group: [deferred]

load {TEST_DIR}/deferred_constraint.db readwrite v2.0.0

statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE checkpointed(i INTEGER PRIMARY KEY DEFERRED);

statement ok
CREATE TABLE altered(i INTEGER);

statement ok
CHECKPOINT;

# replayed from the WAL: ALTER TABLE ADD CONSTRAINT and CREATE TABLE
statement ok
ALTER TABLE altered ADD UNIQUE(i) DEFERRED;

statement ok
CREATE TABLE created(i INTEGER, j VARCHAR, PRIMARY KEY(i, j) DEFERRED);

statement ok
INSERT INTO checkpointed VALUES (1);

statement ok
INSERT INTO altered VALUES (1);

statement ok
INSERT INTO created VALUES (1, 'a');

statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM altered WHERE i = 1;

statement ok
INSERT INTO altered VALUES (1);

statement ok
COMMIT;

restart

statement ok
SET checkpoint_threshold = '10.0 GB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

query I rowsort
SELECT constraint_text FROM duckdb_constraints()
WHERE table_name IN ('checkpointed', 'altered', 'created') AND constraint_type <> 'NOT NULL';
----
PRIMARY KEY(i) DEFERRED
PRIMARY KEY(i, j) DEFERRED
UNIQUE(i) DEFERRED

# the constraints are still deferred: duplicates are visible until the commit fails

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO checkpointed VALUES (1);

query I
SELECT count(*) FROM checkpointed WHERE i = 1;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO altered VALUES (1);

query I
SELECT count(*) FROM altered WHERE i = 1;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO created VALUES (1, 'a');

query I
SELECT count(*) FROM created;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

query I
SELECT count(*) FROM altered;
----
1

# the indexes are now read from a checkpoint instead of the WAL
statement ok
CHECKPOINT;

restart

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO checkpointed VALUES (1);

query I
SELECT count(*) FROM checkpointed WHERE i = 1;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO altered VALUES (1);

query I
SELECT count(*) FROM altered WHERE i = 1;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO created VALUES (1, 'a');

query I
SELECT count(*) FROM created;
----
2

statement error
COMMIT;
----
Failed to commit: PRIMARY KEY or UNIQUE constraint violation: duplicate key

query I
SELECT count(*) FROM altered;
----
1
