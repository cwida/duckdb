# name: test/sql/constraints/foreignkey/fk_update_key_values.test
# description: Check changed referenced keys per constraint and row during UPDATE rewrites
# group: [foreignkey]

foreach storage committed local

statement ok
CREATE TABLE p (id INTEGER PRIMARY KEY, code VARCHAR UNIQUE, payload INTEGER[]);

statement ok
CREATE TABLE c1 (pid INTEGER REFERENCES p(id));

statement ok
CREATE TABLE c2 (code VARCHAR REFERENCES p(code));

statement ok
BEGIN;

statement ok
INSERT INTO p VALUES (1, 'A', [1]), (2, 'B', [2]);

statement ok
INSERT INTO c1 VALUES (1);

onlyif storage=committed
statement ok
COMMIT;

# Assigning a referenced key to itself must succeed.
statement ok
UPDATE p SET id = id WHERE id = 1;

# The other key changes, but nothing references its old value.
statement ok
UPDATE p SET code = 'C' WHERE id = 1;

# A single chunk contains both unchanged and changed keys.
statement ok
UPDATE p SET id = CASE WHEN id = 1 THEN id ELSE id + 100 END, payload = [3];

query IT rowsort
SELECT id, code FROM p;
----
1	C
102	B

# Explicit MERGE and ON CONFLICT share the update path.
query I
MERGE INTO p USING (SELECT 1 AS id) s ON p.id = s.id
WHEN MATCHED THEN UPDATE SET id = p.id, payload = [4]
RETURNING p.id;
----
1

statement ok
INSERT INTO p VALUES (1, 'C', [5]) ON CONFLICT (id) DO UPDATE SET id = EXCLUDED.id, payload = EXCLUDED.payload;

onlyif storage=local
statement ok
COMMIT;

# A real change to a referenced key is still rejected.
statement error
UPDATE p SET id = id + 1000;
----
foreign key

query IT rowsort
SELECT id, code FROM p;
----
1	C
102	B

statement ok
INSERT INTO c2 VALUES ('C');

statement error
UPDATE p SET code = 'D' WHERE id = 1;
----
foreign key

statement error
DELETE FROM p WHERE id = 1;
----
foreign key

# Changed referenced keys must also be rejected for transaction-local rows.
statement ok
BEGIN;

statement ok
INSERT INTO p VALUES (5, 'E', [5]);

statement ok
INSERT INTO c1 VALUES (5);

statement error
UPDATE p SET id = 6 WHERE id = 5;
----
foreign key

statement ok
ROLLBACK;

query I
SELECT count(*) FROM p WHERE id = 5;
----
0

statement ok
DROP TABLE c2;

statement ok
DROP TABLE c1;

statement ok
DROP TABLE p;

endloop

# Composite keys must compare every component, including nullable UNIQUE keys.
statement ok
CREATE TABLE composite_p (a INTEGER, b VARCHAR, payload INTEGER[], UNIQUE(a, b));

statement ok
CREATE TABLE composite_c (a INTEGER, b VARCHAR, FOREIGN KEY(a, b) REFERENCES composite_p(a, b));

statement ok
INSERT INTO composite_p VALUES (1, 'A', [1]), (1, 'B', [2]), (2, NULL, [3]), (NULL, 'D', [4]);

statement ok
INSERT INTO composite_c VALUES (1, 'A');

statement ok
UPDATE composite_p SET a = a, b = CASE WHEN b = 'B' THEN 'C' ELSE b END, payload = [5];

query IT rowsort
SELECT a, b FROM composite_p;
----
1	A
1	C
2	NULL
NULL	D

# Different rows change different components of the same composite key.
statement ok
UPDATE composite_p SET a = CASE WHEN a = 2 THEN 3 ELSE a END, b = CASE WHEN b = 'C' THEN 'E' ELSE b END;

query IT rowsort
SELECT a, b FROM composite_p;
----
1	A
1	E
3	NULL
NULL	D

statement error
UPDATE composite_p SET b = 'F' WHERE b = 'A';
----
foreign key

statement error
UPDATE composite_p SET a = NULL WHERE b = 'A';
----
foreign key

# The replacement rows must stay aligned across committed/local delete batches and deduplication.
statement ok
CREATE TABLE mixed_p (id INTEGER PRIMARY KEY, payload INTEGER[]);

statement ok
CREATE TABLE mixed_c (pid INTEGER REFERENCES mixed_p(id));

statement ok
INSERT INTO mixed_p VALUES (1, [1]), (2, [2]);

statement ok
INSERT INTO mixed_c VALUES (1);

statement ok
BEGIN;

statement ok
INSERT INTO mixed_p VALUES (3, [3]), (4, [4]);

statement ok
INSERT INTO mixed_c VALUES (3);

statement ok
UPDATE mixed_p SET id = CASE WHEN id % 2 = 1 THEN id ELSE id + 100 END, payload = [5];

# Force another rewrite with duplicate source matches, for all now transaction-local rows.
statement ok
UPDATE mixed_p SET id = mixed_p.id, payload = [6] FROM range(2) source;

query I
SELECT id FROM mixed_p ORDER BY id;
----
1
3
102
104

query I rowsort
SELECT pid FROM mixed_c;
----
1
3

statement ok
ROLLBACK;

query I
SELECT id FROM mixed_p ORDER BY id;
----
1
2

# Exercise independent selections across multiple vectors of rows.
statement ok
CREATE TABLE bulk_p (id INTEGER PRIMARY KEY, payload INTEGER[]);

statement ok
CREATE TABLE bulk_c (pid INTEGER REFERENCES bulk_p(id));

statement ok
INSERT INTO bulk_p SELECT i, [i::INTEGER] FROM range(5000) t(i);

statement ok
INSERT INTO bulk_c SELECT id FROM bulk_p WHERE id % 2 = 0;

statement ok
UPDATE bulk_p SET id = CASE WHEN id % 2 = 0 THEN id ELSE id + 10000 END, payload = [];

query III
SELECT count(*), min(id), max(id) FROM bulk_p;
----
5000	0	14999

query I
SELECT count(*) FROM bulk_c JOIN bulk_p ON pid = id;
----
2500

statement error
UPDATE bulk_p SET id = id + 20000;
----
foreign key

query I
SELECT count(*) FROM bulk_c JOIN bulk_p ON pid = id;
----
2500
