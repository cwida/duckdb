# name: test/sql/logging/file_system_logging_wal_replay.test
# description: the WAL of an attached database is replayed through the file system of the attaching client, like its database file
# group: [logging]

require noforcestorage

require no_alternative_verify

statement ok
SET checkpoint_threshold = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
ATTACH '{TEST_DIR}/wal_replay_logging.db' AS db;

statement ok
CREATE TABLE db.t AS SELECT 42 AS i;

statement ok
DETACH db;

statement ok
CALL enable_logging('FileSystem');

statement ok
ATTACH '{TEST_DIR}/wal_replay_logging.db' AS db;

query I
SELECT i FROM db.t;
----
42

# the client's file system opens the database file and its WAL, so the session settings apply to both
query III
SELECT DISTINCT scope, fs, regexp_extract(path, 'wal_replay_logging.*$') AS file
FROM duckdb_logs_parsed('FileSystem')
WHERE path LIKE '%wal_replay_logging.db%' AND op = 'OPEN'
ORDER BY file;
----
CONNECTION	LocalFileSystem	wal_replay_logging.db
CONNECTION	LocalFileSystem	wal_replay_logging.db.wal
