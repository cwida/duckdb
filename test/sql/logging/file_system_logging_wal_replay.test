# name: test/sql/logging/file_system_logging_wal_replay.test
# description: the WAL of an attached database is replayed through the attaching client's file system
# group: [logging]

require noforcestorage

require no_alternative_verify

statement ok
SET checkpoint_threshold = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
ATTACH '{TEST_DIR}/wal_replay_logging.db' AS db;

statement ok
CREATE TABLE db.t AS SELECT 42 AS i;

statement ok
DETACH db;

statement ok
CALL enable_logging('FileSystem');

statement ok
ATTACH '{TEST_DIR}/wal_replay_logging.db' AS db;

query I
SELECT i FROM db.t;
----
42

# the attaching connection opens both files
query IIII
SELECT DISTINCT scope, fs, parse_filename(path) AS file, connection_id = current_connection_id() AS attaching_connection
FROM duckdb_logs_parsed('FileSystem')
WHERE parse_filename(path) LIKE 'wal_replay_logging.db%' AND op = 'OPEN'
ORDER BY file;
----
CONNECTION	LocalFileSystem	wal_replay_logging.db	true
CONNECTION	LocalFileSystem	wal_replay_logging.db.wal	true
