# name: test/sql/logging/logging_call_functions.test
# description: Test logging
# group: [logging]

require noforcestorage

# Create test view to get log settings 
statement ok 
CREATE VIEW log_settings AS select name, value from duckdb_settings() where name in ['logging_level', 'logging_mode', 'logging_sink', 'enable_logging', 'enabled_log_types', 'disabled_log_types'] ORDER BY name

#### 
# Most simple way to enable logging: turns on default behaviour
###

statement ok
CALL enable_logging();

query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	memory

statement ok
CALL disable_logging()

# Logging now disabled again
query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	0
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	memory

#### 
# Enabling logging at a specific level
###

statement ok
CALL enable_logging(level='DEBUG');

query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	(empty)
logging_level	DEBUG
logging_mode	LEVEL_ONLY
logging_sink	memory

# Note: disable_logging resets the log config
statement ok
CALL disable_logging()

# disable logging turns off logging only
query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	0
enabled_log_types	(empty)
logging_level	DEBUG
logging_mode	LEVEL_ONLY
logging_sink	memory

#### 
# Enabling logging of a specific type
###

statement ok
CALL enable_logging('QueryLog');

query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	QueryLog
logging_level	INFO
logging_mode	ENABLE_SELECTED
logging_sink	memory

#### 
# Enabling logging of multiple types (note that log level will match lowest level of the types)
###

statement ok
CALL enable_logging(['QueryLog', 'filesystem']);

# Use sorted list to avoid indeterministic result
query II
SELECT name, list_sort(split(value, ',')) FROM log_settings;
----
disabled_log_types	['']
enable_logging	[1]
enabled_log_types	[FileSystem, QueryLog]
logging_level	[TRACE]
logging_mode	[ENABLE_SELECTED]
logging_sink	[memory]


# Due to different file locking behaviour, this currently fails on windows
require notwindows

#### 
# Configuring a different log storage, using the config param to pass arbitrary (extensible!) options
###

statement ok
CALL enable_logging('FileSystem', sink='file', sink_config={'path': '{TEST_DIR}/logging_call_functions_test_log'});

query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	FileSystem
logging_level	TRACE
logging_mode	ENABLE_SELECTED
logging_sink	file

#### 
# Syntactic sugar exists to easily pass some log_storage related settings
###

statement ok
CALL enable_logging(sink='file', sink_path='{TEST_DIR}/logging_call_functions');

statement ok
CALL disable_logging()

#### 
# For the sink_path setting we can even omit the sink and it will automatically set it to sink='file'
###

statement ok
CALL enable_logging(sink_path='{TEST_DIR}/logging_call_functions');

query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	file

statement ok
CALL enable_logging(sink='memory')

#### 
# Some invalid invocations throw nice errors
###

statement error
CALL enable_logging(hocus_pocus='this is bogus');
----
Binder Error: Invalid named parameter "hocus_pocus" for function enable_logging

# enable_logging is currently not atomic TODO: fix this
query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	memory

# Unknown storage option: this error is thrown by the log storage, because not all log storages implement the same params
statement error
CALL enable_logging(sink='file', level='DEBUG', sink_config={'hocus_pocus': 'this is bogus', 'path': '{TEST_DIR}/hi.csv'});
----
Invalid Input Error: Unrecognized log sink config option for sink: 'FileLogSink': 'hocus_pocus'

# a failing enable_logging leaves the previous settings in place
query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	1
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	memory

statement ok
CALL disable_logging();

# The path param does not exist for the memory storage
statement error
CALL enable_logging(sink='memory', sink_config={'path': 'bla'});
----
Invalid Input Error: Unrecognized log sink config option for sink: 'InMemoryLogSink': 'path'

# sink_config should be a struct
statement error
CALL enable_logging(sink_config='hi')
----
Invalid Input Error: EnableLogging: sink_config must be a struct

# Logging config remains untouched
query II
FROM log_settings;
----
disabled_log_types	(empty)
enable_logging	0
enabled_log_types	(empty)
logging_level	INFO
logging_mode	LEVEL_ONLY
logging_sink	memory

# Explicitly passing sink= still works and overrides the current setting
statement ok
CALL enable_logging(sink='memory')

query I
SELECT value FROM duckdb_settings() WHERE name = 'logging_sink';
----
memory

statement ok
RESET logging_sink

# Same regression with file storage: storage configured via a prior enable_logging(sink='file', ...)
# must survive a subsequent no-arg enable_logging() call.
statement ok
CALL disable_logging()

statement ok
CALL enable_logging(sink='file', sink_path='{TEST_DIR}/preserve_storage.log')

statement ok
CALL disable_logging()

statement ok
CALL enable_logging()

query I
SELECT value FROM duckdb_settings() WHERE name = 'logging_sink';
----
file

statement ok
CALL disable_logging()

statement ok
RESET logging_sink

# sink_config={path:...} without an explicit sink= must auto-promote to the file sink
# (mirroring the sink_path= sugar) — not silently apply a file-only config to the current sink.
statement ok
CALL enable_logging(sink_config:={path:'{TEST_DIR}/auto_promote.csv'})

query I
SELECT value FROM duckdb_settings() WHERE name = 'logging_sink';
----
file

statement ok
CALL disable_logging()

statement ok
RESET logging_sink

# sink_config keys that no sink recognises must error, not silently pass.
statement error
CALL enable_logging(sink_config:={aaaargh:'blaargh'})
----
Unrecognized log sink config option

