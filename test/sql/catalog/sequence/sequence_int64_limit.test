# name: test/sql/catalog/sequence/sequence_int64_limit.test
# description: A sequence that does not cycle returns the last value of the int64 range once, also after a restart
# group: [sequence]

statement ok
SET storage_compatibility_version = 'v2.0.0';

load {TEST_DIR}/sequence_int64_limit.db

statement ok
CREATE SEQUENCE up INCREMENT BY 1 NO MAXVALUE START 9223372036854775806;

query I
SELECT nextval('up');
----
9223372036854775806

query I
SELECT nextval('up');
----
9223372036854775807

statement error
SELECT nextval('up');
----
Sequence Error: nextval: reached maximum value of sequence "up" (9223372036854775807)

statement error
SELECT nextval('up');
----
Sequence Error: nextval: reached maximum value of sequence "up" (9223372036854775807)

query I
SELECT currval('up');
----
9223372036854775807

statement ok
CREATE SEQUENCE down INCREMENT BY -1 NO MINVALUE START -9223372036854775807;

query I
SELECT nextval('down');
----
-9223372036854775807

query I
SELECT nextval('down');
----
-9223372036854775808

statement error
SELECT nextval('down');
----
Sequence Error: nextval: reached minimum value of sequence "down" (-9223372036854775808)

# the last value before an increment overflows
statement ok
CREATE SEQUENCE step INCREMENT BY 5 START 9223372036854775800;

query I
SELECT nextval('step') FROM range(2);
----
9223372036854775800
9223372036854775805

statement error
SELECT nextval('step');
----
reached maximum value of sequence "step"

statement ok
CREATE TEMPORARY SEQUENCE temp_down INCREMENT BY -2 START -9223372036854775807;

query I
SELECT nextval('temp_down');
----
-9223372036854775807

statement error
SELECT nextval('temp_down');
----
reached minimum value of sequence "temp_down"

statement ok
CREATE SEQUENCE edge;

query I
SELECT setval('edge', 9223372036854775807, false);
----
9223372036854775807

query I
SELECT nextval('edge');
----
9223372036854775807

statement error
SELECT nextval('edge');
----
reached maximum value of sequence "edge"

statement ok
CREATE SEQUENCE edge_called;

query I
SELECT setval('edge_called', 9223372036854775807);
----
9223372036854775807

query I
SELECT currval('edge_called');
----
9223372036854775807

statement error
SELECT nextval('edge_called');
----
reached maximum value of sequence "edge_called"

statement ok
CREATE SEQUENCE edge_called_down INCREMENT BY -1;

query I
SELECT setval('edge_called_down', -9223372036854775808);
----
-9223372036854775808

query I
SELECT currval('edge_called_down');
----
-9223372036854775808

statement error
SELECT nextval('edge_called_down');
----
reached minimum value of sequence "edge_called_down"

# setval makes an exhausted sequence usable again
query I
SELECT setval('up', 9223372036854775805);
----
9223372036854775805

query I
SELECT nextval('up');
----
9223372036854775806

# a range of every int64 has no counter outside of it, so it stops before its last value
statement ok
CREATE SEQUENCE whole MINVALUE -9223372036854775808 MAXVALUE 9223372036854775807 START 9223372036854775807;

statement error
SELECT nextval('whole');
----
reached maximum value of sequence "whole"

statement ok
CREATE SEQUENCE nearly_whole INCREMENT BY 2 MINVALUE -9223372036854775808 MAXVALUE 9223372036854775806 START 9223372036854775806;

query I
SELECT nextval('nearly_whole');
----
9223372036854775806

statement error
SELECT nextval('nearly_whole');
----
reached maximum value of sequence "nearly_whole" (9223372036854775806)

statement ok
CREATE SEQUENCE nearly_whole_down INCREMENT BY -2 MINVALUE -9223372036854775807 MAXVALUE 9223372036854775807 START -9223372036854775807;

query I
SELECT nextval('nearly_whole_down');
----
-9223372036854775807

statement error
SELECT nextval('nearly_whole_down');
----
reached minimum value of sequence "nearly_whole_down" (-9223372036854775807)

# exhausted sequences stay exhausted after a checkpoint and after replaying the WAL
statement ok
CHECKPOINT

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
CREATE SEQUENCE wal_up START 9223372036854775807;

query I
SELECT nextval('wal_up');
----
9223372036854775807

restart

statement error
SELECT nextval('edge');
----
reached maximum value of sequence "edge"

statement error
SELECT nextval('down');
----
reached minimum value of sequence "down"

statement error
SELECT nextval('wal_up');
----
reached maximum value of sequence "wal_up"

query III
SELECT currval('edge'), currval('down'), currval('wal_up');
----
9223372036854775807	-9223372036854775808	9223372036854775807

query II
SELECT sequence_name, last_value FROM duckdb_sequences() WHERE sequence_name IN ('edge', 'down', 'wal_up') ORDER BY sequence_name;
----
down	-9223372036854775808
edge	9223372036854775807
wal_up	9223372036854775807

query I
SELECT nextval('up');
----
9223372036854775807

statement error
SELECT nextval('up');
----
reached maximum value of sequence "up"

# storage before v2.0.0 derives the last value from the counter, so there a sequence stops before its last value
statement ok
SET storage_compatibility_version = 'v1.5.2';

load {TEST_DIR}/sequence_int64_limit_v1_5.db

statement ok
CREATE SEQUENCE up START 9223372036854775806;

query I
SELECT nextval('up');
----
9223372036854775806

statement error
SELECT nextval('up');
----
reached maximum value of sequence "up" (9223372036854775807)

statement ok
CREATE TEMPORARY SEQUENCE temp_up START 9223372036854775807;

query I
SELECT nextval('temp_up');
----
9223372036854775807

statement ok
CREATE SEQUENCE down INCREMENT BY -1 NO MINVALUE START -9223372036854775807;

query I
SELECT nextval('down');
----
-9223372036854775807

statement error
SELECT nextval('down');
----
reached minimum value of sequence "down" (-9223372036854775808)

statement ok
CHECKPOINT

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE SEQUENCE wal_up START 9223372036854775806;

query I
SELECT nextval('wal_up');
----
9223372036854775806

restart

statement error
SELECT nextval('up');
----
reached maximum value of sequence "up"

statement error
SELECT nextval('down');
----
reached minimum value of sequence "down"

query III
SELECT currval('up'), currval('down'), currval('wal_up');
----
9223372036854775806	-9223372036854775807	9223372036854775806
