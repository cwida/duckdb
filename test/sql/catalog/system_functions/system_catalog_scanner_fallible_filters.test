# name: test/sql/catalog/system_functions/system_catalog_scanner_fallible_filters.test
# description: Filters that can throw are not pushed into the system catalog scan
# group: [system_functions]

# The fixture and expected output name the default catalog 'memory'.
require noforcestorage

# The scan evaluates a pushed filter on the names of catalogs, schemas and entries to decide what to list, before any
# row exists. Those names are a superset of the values the function emits: the empty schema 'main' of every catalog
# produces no duckdb_tables() row, and neither does a view, although views share the catalog set duckdb_tables()
# scans. A filter that throws on such a name must therefore stay above the scan, where it only sees rows.
#
# Every table the filters below are evaluated on as a row has a numeric name, catalog and schema, so the casts only
# fail on names the function never emits.

# ------------------------------------------------------------------------------------------------
# 1. Catalog level: the cast runs on the catalog name 'memory', which has no tables
# ------------------------------------------------------------------------------------------------

statement ok
ATTACH ':memory:' AS "2";

statement ok
CREATE SCHEMA "2"."1";

statement ok
CREATE TABLE "2"."1"."3"(j INTEGER);

query II
SELECT database_name, table_name FROM duckdb_tables() WHERE database_name::INTEGER = 2;
----
2	3

# ------------------------------------------------------------------------------------------------
# 2. Schema level: the cast runs on the schema name 'main' of every catalog, none of which has a table
# ------------------------------------------------------------------------------------------------

statement ok
CREATE SCHEMA "1";

statement ok
CREATE TABLE "1"."2"(i INTEGER);

statement ok
CREATE VIEW "1".v AS SELECT 1 AS c1;

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name::INTEGER = 1 ORDER BY ALL;
----
2
3

# ------------------------------------------------------------------------------------------------
# 3. Entry level: the cast runs on the view v, which duckdb_tables() never emits
# ------------------------------------------------------------------------------------------------

query I
SELECT table_name FROM duckdb_tables() WHERE table_name::INTEGER = 2;
----
2

# ------------------------------------------------------------------------------------------------
# 4. EXPLAIN: a filter that can throw is applied above the scan; its TRY_CAST form is a table filter on it
# ------------------------------------------------------------------------------------------------

foreach function duckdb_tables duckdb_views duckdb_columns

query II
EXPLAIN SELECT database_name FROM {function}() WHERE schema_name::INTEGER = 1;
----
physical_plan	<REGEX>:.*Filter.*CAST\(schema_name AS INTEGER\) = 1.*

query II
EXPLAIN SELECT database_name FROM {function}() WHERE schema_name::INTEGER = 1;
----
physical_plan	<!REGEX>:.*Filters:.*

query II
EXPLAIN SELECT database_name FROM {function}() WHERE TRY_CAST(schema_name AS INTEGER) = 1;
----
physical_plan	<REGEX>:.*Filters:.*schema_name.*

endloop

# ------------------------------------------------------------------------------------------------
# 5. EXPLAIN ANALYZE: a filter that can throw prunes nothing, its TRY_CAST form prunes to the two schemas named 1
# ------------------------------------------------------------------------------------------------

# without a pushed schema filter the scan lists every schema and does not count them
query II
EXPLAIN ANALYZE SELECT table_name FROM duckdb_tables() WHERE schema_name::INTEGER = 1;
----
analyzed_plan	<REGEX>:.*Schemas Scanned: 0/0.*

query II
EXPLAIN ANALYZE SELECT table_name FROM duckdb_tables() WHERE TRY_CAST(schema_name AS INTEGER) = 1;
----
analyzed_plan	<REGEX>:.*Schemas Scanned: 2/.*

# both forms return the same rows
query I
SELECT table_name FROM duckdb_tables() WHERE TRY_CAST(schema_name AS INTEGER) = 1 ORDER BY ALL;
----
2
3
