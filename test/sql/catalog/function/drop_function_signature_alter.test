# name: test/sql/catalog/function/drop_function_signature_alter.test
# description: A member drop is an alter internally: oid preserved, WAL replay, rollback
# group: [function]

load {TEST_DIR}/drop_function_signature_alter.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
CREATE MACRO alt(x INTEGER) AS x + 1, (x VARCHAR) AS concat(x, '!'), (x DATE) AS year(x);

# a member drop preserves the entry's oid: the altered entry is the same logical object
statement ok
CREATE TABLE oid_before AS SELECT DISTINCT function_oid FROM duckdb_functions() WHERE function_name = 'alt';

query I
SELECT count(*) FROM oid_before;
----
1

statement ok
DROP MACRO alt(VARCHAR);

query I
SELECT (SELECT DISTINCT function_oid FROM duckdb_functions() WHERE function_name = 'alt')
     = (SELECT function_oid FROM oid_before);
----
true

# the member drop rolls back like any alter
statement ok
BEGIN;

statement ok
DROP MACRO alt(INTEGER);

statement error
SELECT alt(1);
----
<REGEX>:.*(no overload|No function matches|Binder Error).*

statement ok
ROLLBACK;

query I
SELECT alt(1);
----
2

# the member drop replays from the WAL: a default database predates the ALTER_MACRO record's
# storage version, so this replays the legacy drop+create (the ALTER_MACRO replay is pinned below)
statement ok
DROP MACRO alt(DATE);

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

query I
SELECT alt(1);
----
2

statement error
SELECT alt(DATE '2024-01-01');
----
<REGEX>:.*(No function matches|Binder Error).*

# this database predates the ALTER_MACRO record's storage version, so the WAL carried the member
# drop as the legacy drop+create: the member removal survives the replay either way
query I
SELECT count(DISTINCT function_oid) FROM duckdb_functions() WHERE function_name = 'alt';
----
1

# dropping the last member falls through to a real entry drop, replayed from the WAL too
statement ok
DROP MACRO alt(INTEGER);

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement error
SELECT alt(1);
----
<REGEX>:.*(Catalog Error|not exist).*

# the replacement keeps its dependency on the containing schema
statement ok
CREATE SCHEMA s;

statement ok
CREATE MACRO s.sf(x INTEGER) AS x, (x VARCHAR) AS x;

statement ok
DROP MACRO s.sf(INTEGER);

statement error
DROP SCHEMA s;
----
<REGEX>:.*depend.*

query I
SELECT s.sf('a') = 'a';
----
true

statement ok
DROP SCHEMA s CASCADE;

statement error
SELECT s.sf('a');
----
<REGEX>:.*(Catalog Error|not exist).*

# a table macro member drop replays from the WAL too
statement ok
CREATE MACRO tm(x INTEGER) AS TABLE (SELECT x AS v), (x VARCHAR) AS TABLE (SELECT concat(x, '?') AS v);

statement ok
DROP MACRO TABLE tm(VARCHAR);

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

query I
SELECT v FROM tm(7);
----
7

statement error
SELECT v FROM tm('a');
----
<REGEX>:.*(No function matches|Binder Error|does not support).*

# two connections racing member drops of the same entry conflict on the alter path
statement ok con1
CREATE MACRO ww(x INTEGER) AS 1, (x VARCHAR) AS 2, (x DATE) AS 3;

statement ok con1
BEGIN;

statement ok con1
DROP MACRO ww(INTEGER);

statement error con2
DROP MACRO ww(VARCHAR);
----
<REGEX>:.*write-write conflict on alter.*

statement ok con1
COMMIT;

statement ok con1
DROP MACRO ww;

# a database pinned to a storage version that predates the ALTER_MACRO record gets the member
# drop written to its WAL as the legacy drop+create, which such releases replay correctly
statement ok
ATTACH '{TEST_DIR}/alter_old_pin.db' AS odb (STORAGE_VERSION 'v1.4.0');

statement ok
CREATE MACRO odb.om(x INTEGER) AS x + 1, (x VARCHAR) AS x;

statement ok
CHECKPOINT odb;

statement ok
DROP MACRO odb.om(VARCHAR);

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
ATTACH '{TEST_DIR}/alter_old_pin.db' AS odb;

query I
SELECT odb.om(1);
----
2

statement error
SELECT odb.om('a');
----
<REGEX>:.*(No function matches|Binder Error|does not support).*

# a v2.1.0 database carries the member drop as the ALTER_MACRO record: the replay goes through
# MacroCatalogEntry::AlterEntry, keeps the oid, and re-derives the dependency list
statement ok
SET enable_macro_dependencies = true;

statement ok
ATTACH '{TEST_DIR}/alter_new_pin.db' AS ndb (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE TABLE ndb.nsrc(i INTEGER);

statement ok
CREATE MACRO ndb.nm(x INTEGER) AS (SELECT count(*) FROM ndb.nsrc), (x VARCHAR) AS x, (x DATE) AS 42;

statement ok
CHECKPOINT ndb;

statement ok
DROP MACRO ndb.nm(VARCHAR);

restart

statement ok
SET enable_macro_dependencies = true;

statement ok
ATTACH '{TEST_DIR}/alter_new_pin.db' AS ndb;

query TT
SELECT ndb.nm(1), ndb.nm(DATE '2024-01-01');
----
0	42

statement error
SELECT ndb.nm('a');
----
<REGEX>:.*(No function matches|Binder Error|does not support).*

# the re-derived dependency list still protects the surviving member's reference
statement error
DROP TABLE ndb.nsrc;
----
<REGEX>:.*depend.*

# a dependency-blocked member drop names every blocking dependent, like a drop does
statement ok
SET enable_view_dependencies = true;

statement ok
CREATE MACRO blk(x INTEGER) AS x, (x VARCHAR) AS x;

statement ok
CREATE VIEW blk_v1 AS SELECT blk(1) AS a;

statement ok
CREATE VIEW blk_v2 AS SELECT blk('b') AS b;

statement error
DROP MACRO blk(INTEGER);
----
<REGEX>:.*Cannot drop entry "blk" because there are entries that depend on it\.\n(view "blk_v1" depends on macro function "blk"\.\nview "blk_v2" depends on macro function "blk"\.|view "blk_v2" depends on macro function "blk"\.\nview "blk_v1" depends on macro function "blk"\.)\nUse DROP\.\.\.CASCADE to drop all dependents\.\nDependencies block dropping a single overload of "blk".*

# the blocked alter changed nothing
query II
SELECT blk(1), blk('b');
----
1	b

statement ok
DROP VIEW blk_v1;

statement ok
DROP VIEW blk_v2;

statement ok
DROP MACRO blk(INTEGER);

query I
SELECT blk('b');
----
b
