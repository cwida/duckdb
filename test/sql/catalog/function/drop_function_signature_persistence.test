# name: test/sql/catalog/function/drop_function_signature_persistence.test
# description: Member drops and their dependency attribution survive checkpoint and restart
# group: [function]

load {TEST_DIR}/drop_function_signature_base.db

statement ok
SET enable_macro_dependencies = true;

# member dependency attribution is stored from v2.1.0
statement ok
ATTACH '{TEST_DIR}/drop_function_signature_persistence.db' AS pdb (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE TABLE pdb.src(i INTEGER);

statement ok
CREATE MACRO pdb.main.pf(x INTEGER) AS (SELECT count(*) FROM pdb.src), (x VARCHAR) AS x, (x) AS 42;

statement ok
DROP MACRO pdb.main.pf(VARCHAR);

restart

statement ok
SET enable_macro_dependencies = true;

statement ok
ATTACH '{TEST_DIR}/drop_function_signature_persistence.db' AS pdb;

# the replacement entry with the surviving members was persisted
query TT
SELECT pdb.main.pf(1), pdb.main.pf(DATE '2024-01-01');
----
0	42

statement error
DROP MACRO pdb.main.pf(VARCHAR);
----
<REGEX>:.*has no overload with signature \(VARCHAR\).*

# the surviving member's recorded dependency survived the restart
statement error
DROP TABLE pdb.src;
----
<REGEX>:.*depend.*

# the recorded attribution survived too: a member drop after restart works and keeps protection
statement ok
DROP MACRO pdb.main.pf(ANY);

statement error
SELECT pdb.main.pf(DATE '2024-01-01');
----
<REGEX>:.*does not support the supplied arguments.*

statement error
DROP TABLE pdb.src;
----
<REGEX>:.*depend.*

statement ok
CHECKPOINT pdb;

restart

statement ok
ATTACH '{TEST_DIR}/drop_function_signature_persistence.db' AS pdb;

query T
SELECT pdb.main.pf(1);
----
0

statement ok
DROP MACRO pdb.main.pf;

statement ok
DROP TABLE pdb.src;

# the default database of this test file is on an older storage version: attribution does not fit
# in its format, so a member drop on an entry with dependencies is rejected instead of guessed
statement ok
SET enable_macro_dependencies = true;

statement ok
CREATE TABLE old_src(i INTEGER);

statement ok
CREATE MACRO old_pf(x INTEGER) AS (SELECT count(*) FROM old_src), (x VARCHAR) AS x;

restart

statement ok
SET enable_macro_dependencies = true;

statement error
DROP MACRO old_pf(VARCHAR);
----
<REGEX>:.*before member dependency tracking.*

# without dependencies the member drop works even without attribution
statement ok
CREATE MACRO old_plain(x INTEGER) AS 1, (x VARCHAR) AS 2;

restart

statement ok
DROP MACRO old_plain(VARCHAR);

query T
SELECT old_plain(1);
----
1

statement ok
DROP MACRO old_plain;

statement ok
DROP MACRO old_pf;

statement ok
DROP TABLE old_src;
