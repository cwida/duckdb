# name: test/sql/catalog/function/drop_function_signature.test
# description: DROP MACRO/FUNCTION with a parameter type list drops a single overload member
# group: [function]

statement ok
CREATE MACRO f(a INTEGER) AS a + 1, (a VARCHAR) AS a || '!', (a INTEGER, b INTEGER) AS a + b;

query TTT
SELECT f(1), f('x'), f(1, 2);
----
2	x!	3

# dropping one overload keeps the siblings
statement ok
DROP MACRO f(VARCHAR);

statement error
SELECT f('x');
----
<REGEX>:.*does not support the supplied arguments.*

query TT
SELECT f(1), f(1, 2);
----
2	3

# the dropped signature no longer exists
statement error
DROP MACRO f(VARCHAR);
----
<REGEX>:.*has no overload with signature \(VARCHAR\).*

# IF EXISTS at member granularity leaves siblings untouched
statement ok
DROP MACRO IF EXISTS f(VARCHAR);

query TT
SELECT f(1), f(1, 2);
----
2	3

# both keyword spellings work
statement ok
DROP FUNCTION f(INTEGER, INTEGER);

query T
SELECT f(1);
----
2

# dropping the last member drops the whole entry
statement ok
DROP MACRO f(INTEGER);

statement error
SELECT f(1);
----
<REGEX>:.*(Catalog Error|not exist).*

# an untyped member is named by ANY in each untyped slot, a type list never falls back to it
statement ok
CREATE MACRO g(x) AS x + 1, (x, y) AS x + y;

statement error
DROP MACRO g(BIGINT);
----
<REGEX>:.*has no overload with signature \(BIGINT\).*

# a typed signature on an untyped entry does nothing under IF EXISTS, repeatably
statement ok
DROP MACRO IF EXISTS g(BIGINT);

statement ok
DROP MACRO IF EXISTS g(BIGINT);

query TT
SELECT g(1), g(1, 2);
----
2	3

statement ok
DROP MACRO g(ANY);

statement error
SELECT g(1);
----
<REGEX>:.*does not support the supplied arguments.*

query T
SELECT g(1, 2);
----
3

statement ok
DROP MACRO g(ANY, ANY);

# a typed drop only ever names the typed member: repeating it cannot reach the untyped sibling
statement ok
CREATE MACRO r(x) AS x, (x INTEGER) AS x + 1;

statement ok
DROP MACRO IF EXISTS r(INTEGER);

query T
SELECT r(1);
----
1

statement ok
DROP MACRO IF EXISTS r(INTEGER);

query T
SELECT r(1);
----
1

statement ok
DROP MACRO r(ANY);

# empty parentheses name the zero-parameter overload
statement ok
CREATE MACRO h() AS 42, (x INTEGER) AS x;

statement ok
DROP MACRO h();

statement error
SELECT h();
----
<REGEX>:.*does not support the supplied arguments.*

query T
SELECT h(7);
----
7

# a signature naming no overload of that arity errors with the signature
statement error
DROP MACRO h(VARCHAR, VARCHAR);
----
<REGEX>:.*has no overload with signature \(VARCHAR, VARCHAR\).*

# type modifiers are part of the declared identity
statement ok
CREATE MACRO dm(x DECIMAL(10,2)) AS 1, (x INTEGER) AS 2;

statement error
DROP MACRO dm(DECIMAL);
----
<REGEX>:.*has no overload with signature \(DECIMAL\(18,3\)\).*

statement ok
DROP MACRO dm(DECIMAL(10,2));

query T
SELECT dm(1);
----
2

statement ok
DROP MACRO dm;

# a schema-qualified name drops a member in that schema
statement ok
CREATE SCHEMA qs;

statement ok
CREATE MACRO qs.q(x INTEGER) AS 1, (x VARCHAR) AS 2;

statement ok
DROP MACRO qs.q(INTEGER);

query T
SELECT qs.q('x');
----
2

statement ok
DROP SCHEMA qs CASCADE;

# the unquoted ANY keyword names untyped slots, a user type named "any" is quoted
statement ok
CREATE TYPE "any" AS STRUCT(i INTEGER);

statement ok
CREATE MACRO anyt(x "any") AS 1, (x INTEGER) AS 2;

statement error
DROP MACRO anyt(ANY);
----
<REGEX>:.*has no overload with signature \(ANY\).*

statement ok
DROP MACRO anyt("any");

query T
SELECT anyt(1);
----
2

statement ok
DROP MACRO anyt;

statement ok
DROP TYPE "any";

# user types resolve before matching
statement ok
CREATE TYPE mood AS ENUM ('ok', 'sad');

statement ok
CREATE MACRO m(a mood) AS a = 'ok', (a INTEGER) AS a > 0;

statement ok
DROP MACRO m(mood);

query T
SELECT m(1);
----
true

statement ok
DROP MACRO m(INTEGER);

# a DROP without a type list keeps dropping the whole entry
statement ok
CREATE MACRO whole(a INTEGER) AS a, (a VARCHAR) AS a;

statement ok
DROP MACRO whole;

statement error
SELECT whole(1);
----
<REGEX>:.*(Catalog Error|not exist).*

# internal entries refuse member drops
statement error
DROP MACRO current_role(VARCHAR);
----
<REGEX>:.*(internal|no overload|Cannot alter).*

# table functions reject the member path through the macro entry check
statement error
DROP TABLE wrong_entry(INTEGER);
----
<REGEX>:.*syntax error.*

# member drops are transactional
statement ok
CREATE MACRO txn_f(a INTEGER) AS a, (a VARCHAR) AS a;

statement ok
BEGIN;

statement ok
DROP MACRO txn_f(INTEGER);

statement ok
ROLLBACK;

query TT
SELECT txn_f(1), txn_f('x');
----
1	x

# a partially typed member is named by its declared shape: ANY for untyped slots, the type otherwise
statement ok
CREATE MACRO pt(x INTEGER, y) AS 1, (x VARCHAR, y) AS 2;

statement ok
DROP MACRO pt(VARCHAR, ANY);

query T
SELECT pt(1, NULL);
----
1

# the typed slot must match the declaration exactly
statement error
DROP MACRO pt(INTEGER, DATE);
----
<REGEX>:.*has no overload with signature \(INTEGER, DATE\).*

statement ok
DROP MACRO pt(INTEGER, ANY);

# ANY does not match a typed slot, so same-arity members stay apart
statement ok
CREATE MACRO amb(x, y) AS 1, (x INTEGER, y) AS 2;

statement error
DROP MACRO amb(INTEGER, VARCHAR);
----
<REGEX>:.*has no overload with signature \(INTEGER, VARCHAR\).*

statement ok
DROP MACRO amb(ANY, ANY);

query T
SELECT amb(1, 'x');
----
2

statement ok
DROP MACRO amb(INTEGER, ANY);

# a member drop replaces the entry like any overload mutation: EXPORT's naive order treats the
# replacement as newest, so exports taken after mutating a callee entry may need reordering, the
# same caveat as adding an overload to a called entry

# a member-granular CASCADE has no well-defined scope and is rejected
statement ok
CREATE MACRO casc(x INTEGER) AS x, (x VARCHAR) AS x;

statement error
DROP MACRO casc(INTEGER) CASCADE;
----
<REGEX>:.*Cannot drop an overload.*CASCADE.*

# dependencies stay entry-level but are rebuilt from the surviving members on a member drop
statement ok
DROP MACRO casc;

statement ok
SET enable_macro_dependencies = true;

# a dependency owned only by the removed member does not tie the survivor to a later cascade
statement ok
CREATE TABLE dep_source(i INTEGER);

statement ok
CREATE MACRO dep_survivor(x INTEGER) AS x + 1, (x VARCHAR) AS (SELECT count(*) FROM dep_source);

statement ok
DROP MACRO dep_survivor(VARCHAR);

statement ok
DROP TABLE dep_source CASCADE;

query T
SELECT dep_survivor(1);
----
2

statement ok
DROP MACRO dep_survivor;

# a dependency of a surviving member is retained: RESTRICT still blocks the referenced table
statement ok
CREATE TABLE dep_kept(i INTEGER);

statement ok
CREATE MACRO dep_holder(x INTEGER) AS (SELECT count(*) FROM dep_kept), (x VARCHAR) AS x;

statement ok
DROP MACRO dep_holder(VARCHAR);

statement error
DROP TABLE dep_kept;
----
<REGEX>:.*depend.*

statement ok
DROP TABLE dep_kept CASCADE;

statement error
SELECT dep_holder(1);
----
<REGEX>:.*(Catalog Error|not exist).*

# disabling dependency tracking after CREATE does not strip registered protection on a member drop
statement ok
CREATE TABLE dep_toggled(i INTEGER);

statement ok
CREATE MACRO dep_toggle_holder(x INTEGER) AS (SELECT count(*) FROM dep_toggled), (x VARCHAR) AS x;

statement ok
SET enable_macro_dependencies = false;

statement ok
DROP MACRO dep_toggle_holder(VARCHAR);

statement error
DROP TABLE dep_toggled;
----
<REGEX>:.*depend.*

statement ok
DROP TABLE dep_toggled CASCADE;

statement ok
SET enable_macro_dependencies = true;

# the rebuild resolves unqualified references from the entry's schema, not the session's path
statement ok
CREATE SCHEMA dep_s1;

statement ok
CREATE SCHEMA dep_s2;

statement ok
USE dep_s1;

statement ok
CREATE TABLE dep_src(i INTEGER);

statement ok
CREATE MACRO dep_path_holder(x INTEGER) AS TABLE (SELECT i FROM dep_src), (x VARCHAR) AS TABLE (SELECT 0 AS i);

statement ok
USE dep_s2;

statement ok
DROP MACRO TABLE dep_s1.dep_path_holder(VARCHAR);

statement error
DROP TABLE dep_s1.dep_src;
----
<REGEX>:.*depend.*

statement ok
USE memory.main;

statement ok
DROP SCHEMA dep_s1 CASCADE;

statement ok
DROP SCHEMA dep_s2 CASCADE;

# a create-time dependency resolved outside the entry's schema survives the rebuild: the rebind's
# own resolution does not replace it
statement ok
CREATE SCHEMA amb_s1;

statement ok
CREATE SCHEMA amb_s2;

statement ok
CREATE TABLE amb_s1.src(i INTEGER);

statement ok
CREATE TABLE amb_s2.src(i INTEGER);

statement ok
USE amb_s2;

statement ok
CREATE MACRO amb_s1.holder(x INTEGER) AS TABLE (SELECT i FROM src), (x VARCHAR) AS TABLE (SELECT 0 AS i);

statement ok
DROP MACRO TABLE amb_s1.holder(VARCHAR);

# the macro bound amb_s2.src at CREATE, the registered dependency must still block its drop
statement error
DROP TABLE amb_s2.src;
----
<REGEX>:.*depend.*

statement ok
USE memory.main;

statement ok
DROP SCHEMA amb_s2 CASCADE;

statement ok
DROP SCHEMA amb_s1 CASCADE;

# a dependency shared by the removed member and a drifting survivor is kept: the rebind's
# attribution is only trusted when rebinding all original members reproduces the registered list
statement ok
CREATE SCHEMA sh_s1;

statement ok
CREATE SCHEMA sh_s2;

statement ok
CREATE TABLE sh_s1.src(i INTEGER);

statement ok
CREATE TABLE sh_s2.src(i INTEGER);

statement ok
USE sh_s2;

statement ok
CREATE MACRO sh_s1.holder(x INTEGER) AS TABLE (SELECT i FROM src), (x VARCHAR) AS TABLE (SELECT i FROM sh_s2.src);

statement ok
DROP MACRO TABLE sh_s1.holder(VARCHAR);

# both members bound sh_s2.src at CREATE, the survivor's protection must not be subtracted
statement error
DROP TABLE sh_s2.src;
----
<REGEX>:.*depend.*

statement ok
USE memory.main;

statement ok
DROP SCHEMA sh_s2 CASCADE;

statement ok
DROP SCHEMA sh_s1 CASCADE;

statement ok
SET enable_macro_dependencies = false;

# table macro members drop by signature too
statement ok
CREATE MACRO tmm(x INTEGER) AS TABLE (SELECT x AS v), (x VARCHAR) AS TABLE (SELECT 0 AS v);

statement ok
DROP MACRO tmm(VARCHAR);

query T
SELECT v FROM tmm(7);
----
7

statement ok
DROP MACRO tmm;

# DROP MACRO TABLE accepts a signature and targets the table entry past a same-named scalar macro
statement ok
CREATE MACRO shared() AS 42;

statement ok
CREATE MACRO shared(x INTEGER) AS TABLE (SELECT x AS v), (x VARCHAR) AS TABLE (SELECT 0 AS v);

statement ok
DROP MACRO TABLE shared(VARCHAR);

query T
SELECT v FROM shared(7);
----
7

query T
SELECT shared();
----
42

statement error
DROP MACRO TABLE shared(VARCHAR);
----
<REGEX>:.*has no overload with signature \(VARCHAR\).*

statement ok
DROP MACRO TABLE IF EXISTS shared(VARCHAR);

query T
SELECT v FROM shared(7);
----
7

statement ok
DROP MACRO TABLE shared(INTEGER);

statement error
SELECT v FROM shared(7);
----
<REGEX>:.*(Catalog Error|not exist|does not support).*

query T
SELECT shared();
----
42

statement ok
DROP MACRO shared;
