# name: test/sql/catalog/function/drop_function_signature_upgrade_replay.test
# description: A member drop committed after an in-place storage upgrade replays from the WAL on the next attach
# group: [function]

# keep the member drops in the WAL across DETACH
statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold = '10GB';

# a v2.0.0 database that is not upgraded rejects a member drop at statement time
statement ok
ATTACH '{TEST_DIR}/drop_function_signature_no_upgrade.db' AS nu (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE MACRO nu.f(x INTEGER) AS x + 1, (x VARCHAR) AS 42;

statement error
DROP MACRO nu.f(VARCHAR);
----
Dropping a single overload is only supported for storage versions v2.1.0 and higher

statement ok
DETACH nu;

statement ok
ATTACH '{TEST_DIR}/drop_function_signature_no_upgrade.db' AS nu;

statement error
DROP MACRO nu.f(VARCHAR);
----
Dropping a single overload is only supported for storage versions v2.1.0 and higher

query II
SELECT nu.f(1), nu.f('a');
----
2	42

statement ok
DETACH nu;

# a v2.0.0 database with a checkpointed table
statement ok
ATTACH '{TEST_DIR}/drop_function_signature_upgrade.db' AS u (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE TABLE u.t AS SELECT 7 AS i;

statement ok
CHECKPOINT u;

statement ok
DETACH u;

# upgrade in place without a checkpoint, then commit member drops to the WAL
statement ok
ATTACH '{TEST_DIR}/drop_function_signature_upgrade.db' AS u (STORAGE_VERSION 'v2.1.0');

statement ok
CREATE MACRO u.f(x INTEGER) AS x + 1, (x VARCHAR) AS 42, (x DATE) AS 43;

statement ok
DROP MACRO u.f(VARCHAR);

statement ok
DROP MACRO IF EXISTS u.f(DOUBLE);

statement ok
DROP MACRO u.f(DATE);

statement ok
DETACH u;

# the WAL replays on an attach without STORAGE_VERSION, where the file header still says v2.0.0
statement ok
ATTACH '{TEST_DIR}/drop_function_signature_upgrade.db' AS u;

query II
SELECT u.f(1), i FROM u.t;
----
2	7

statement error
SELECT u.f('a');
----
<REGEX>:.*does not support the supplied arguments.*

statement error
SELECT u.f(DATE '2024-01-01');
----
<REGEX>:.*does not support the supplied arguments.*

# replay does not bypass the gate for new statements on the non-upgraded attach
statement ok
CREATE MACRO u.g(x INTEGER) AS x, (x VARCHAR) AS 1;

statement error
DROP MACRO u.g(VARCHAR);
----
Dropping a single overload is only supported for storage versions v2.1.0 and higher

# the replayed state survives a checkpoint
statement ok
CHECKPOINT u;

statement ok
DETACH u;

statement ok
ATTACH '{TEST_DIR}/drop_function_signature_upgrade.db' AS u;

query III
SELECT u.f(1), u.g('a'), i FROM u.t;
----
2	1	7

statement error
SELECT u.f('a');
----
<REGEX>:.*does not support the supplied arguments.*
