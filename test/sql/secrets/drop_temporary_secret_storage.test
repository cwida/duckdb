# name: test/sql/secrets/drop_temporary_secret_storage.test
# description: DROP TEMPORARY SECRET cannot be combined with a FROM storage
# group: [secrets]

# temporary secrets do not survive the restarts forced by the storage configs
require noforcestorage

statement ok
CREATE TEMPORARY SECRET s (TYPE http)

statement error
DROP TEMPORARY SECRET s FROM local_file
----
Can not combine TEMPORARY with specifying a storage for drop secret

statement error
DROP TEMP SECRET IF EXISTS s FROM memory
----
Can not combine TEMPORARY with specifying a storage for drop secret

# the secret is still there
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's'
----
1

statement ok
DROP TEMPORARY SECRET s

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's'
----
0
