# name: test/sql/secrets/http_secret_scope_authority.test
# description: HTTP secret scopes must not match a different URL authority
# group: [secrets]

require noforcestorage

statement ok
SET secret_directory='{TEST_DIR}/http_secret_scope_authority';

statement ok
CREATE SECRET port_scope (TYPE http, SCOPE 'http://127.0.0.1:18081');

statement ok
CREATE SECRET host_scope (TYPE http, SCOPE 'https://trusted.example');

statement ok
CREATE SECRET file_scope (TYPE http, SCOPE 'https://trusted.example/data/file.csv');

# An authority-only scope matches the authority itself and paths under it.
foreach url http://127.0.0.1:18081 http://127.0.0.1:18081/file.csv

query T
SELECT name FROM which_secret('{url}', 'http');
----
port_scope

endloop

# An @ in the path does not change the destination host.
foreach url https://trusted.example https://trusted.example/file.csv https://trusted.example/path@other.example/file.csv

query T
SELECT name FROM which_secret('{url}', 'http');
----
host_scope

endloop

# File scopes must still work, and take precedence over the host scope.
foreach url https://trusted.example/data/file.csv https://trusted.example/data/file.csv?token=x

query T
SELECT name FROM which_secret('{url}', 'http');
----
file_scope

endloop

# HTTP secrets can also be scoped to object-store URIs.
statement ok
CREATE SECRET bucket_scope (TYPE http, SCOPE 's3://trusted-bucket');

statement ok
CREATE SECRET key_prefix_scope (TYPE http, SCOPE 's3://trusted-bucket/data/file');

query T
SELECT name FROM which_secret('s3://trusted-bucket/other.csv', 'http');
----
bucket_scope

# A key-prefix scope still matches a longer object key.
query T
SELECT name FROM which_secret('s3://trusted-bucket/data/file.parquet', 'http');
----
key_prefix_scope

# A bucket scope must not match a neighboring bucket.
query I
SELECT count(*) FROM which_secret('s3://trusted-bucket-other/file.csv', 'http');
----
0

# A matching textual prefix must not select credentials for a different host.
foreach url http://127.0.0.1:18081@127.0.0.1:18082/steal https://trusted.example@other.example/steal https://trusted.example.other.example/steal

query I
SELECT count(*) FROM which_secret('{url}', 'http');
----
0

endloop

# A scheme-only scope still matches any host using that scheme.
statement ok
CREATE SECRET scheme_scope (TYPE http, SCOPE 'https://');

query T
SELECT name FROM which_secret('https://unrelated.example/file.csv', 'http');
----
scheme_scope
