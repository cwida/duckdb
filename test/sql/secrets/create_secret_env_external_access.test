# name: test/sql/secrets/create_secret_env_external_access.test
# description: CREATE SECRET ... PROVIDER env reads the process environment, which enable_external_access forbids
# group: [secrets]

require noforcestorage

# keep the secret manager away from the persistent secret directory, so that disabling external access below
# does not fail every CREATE SECRET on the local file system before the provider runs
statement ok
SET allow_persistent_secrets=false;

# with external access enabled the env provider reads the proxy settings from the host environment
statement ok
CREATE SECRET s1 (TYPE http, PROVIDER env);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's1' AND provider = 'env'
----
1

statement ok
SET enable_external_access=false;

# without external access the env provider refuses to read the host environment
statement error
CREATE SECRET s2 (TYPE http, PROVIDER env);
----
Permission Error: Cannot create a secret with PROVIDER env: reading environment variables is disabled through configuration

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's2'
----
0

# the config provider reads no process state and keeps working
statement ok
CREATE SECRET s3 (TYPE http, PROVIDER config, HTTP_PROXY 'http://proxy/');

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's3' AND provider = 'config'
----
1
