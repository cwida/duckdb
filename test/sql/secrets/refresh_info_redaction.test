# name: test/sql/secrets/refresh_info_redaction.test
# description: Refresh metadata is redacted, including in persisted secrets without the extension loaded
# group: [secrets]

require noforcestorage

require skip_reload

require httpfs

load {TEST_DIR}/refresh_info_redaction.db

statement ok
SET secret_directory = '{TEST_DIR}/refresh_info_redaction';

foreach type s3 r2 gcs aws

statement ok
CREATE PERSISTENT SECRET refresh_auto_{type} (
    TYPE {type},
    KEY_ID 'dummy-key-id',
    SECRET 'dummy-secret',
    SESSION_TOKEN 'dummy-session-token',
    REFRESH 'auto'
);

statement ok
CREATE PERSISTENT SECRET refresh_explicit_{type} (
    TYPE {type},
    KEY_ID 'dummy-key-id',
    REFRESH_INFO MAP {
        'SeCrEt': 'dummy-secret',
        'SeSsIoN_ToKeN': 'dummy-session-token'
    }
);

endloop

# Explicit unredacted inspection still exposes the original refresh metadata.
query III
SELECT count(*),
       bool_and(contains(regexp_extract(secret_string, 'refresh_info=([^;]*)', 1), 'dummy-secret')),
       bool_and(contains(regexp_extract(secret_string, 'refresh_info=([^;]*)', 1), 'dummy-session-token'))
FROM duckdb_secrets(redact = false);
----
8	true	true

# Default inspection redacts even when unredacted inspection is allowed.
query IIII
SELECT count(*),
       bool_and(contains(secret_string, 'refresh_info=redacted')),
       bool_and(NOT contains(secret_string, 'dummy-secret') AND NOT contains(secret_string, 'dummy-session-token')),
       bool_and(contains(secret_string, 'key_id=dummy-key-id'))
FROM duckdb_secrets();
----
8	true	true	true

statement ok
SET allow_unredacted_secrets = false;

statement error
SELECT * FROM duckdb_secrets(redact = false);
----
Displaying unredacted secrets is disabled

query III
SELECT count(*),
       bool_and(contains(secret_string, 'refresh_info=redacted')),
       bool_and(NOT contains(secret_string, 'dummy-secret') AND NOT contains(secret_string, 'dummy-session-token'))
FROM duckdb_secrets();
----
8	true	true

query III
SELECT count(*),
       bool_and(contains(secret_string, 'refresh_info=redacted')),
       bool_and(NOT contains(secret_string, 'dummy-secret') AND NOT contains(secret_string, 'dummy-session-token'))
FROM duckdb_secrets(redact = true);
----
8	true	true

# Persisted redaction lists may omit refresh_info, and inspection does not load HTTPFS.
restart no_extension_load

statement ok
SET secret_directory = '{TEST_DIR}/refresh_info_redaction';

query III
SELECT count(*),
       bool_and(contains(secret_string, 'refresh_info=redacted')),
       bool_and(NOT contains(secret_string, 'dummy-secret') AND NOT contains(secret_string, 'dummy-session-token'))
FROM duckdb_secrets();
----
8	true	true

query I
SELECT loaded FROM duckdb_extensions() WHERE extension_name = 'httpfs';
----
false

statement error
SELECT * FROM duckdb_secrets(redact = false);
----
Displaying unredacted secrets is disabled
