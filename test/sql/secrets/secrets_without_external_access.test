# name: test/sql/secrets/secrets_without_external_access.test
# description: Secret statements keep reporting the permission error when external access is disabled
# group: [secrets]

require noforcestorage

statement ok
SET enable_external_access=false;

# loading the persistent secrets fails every time, instead of failing once and then breaking the secret manager
statement error
SELECT count(*) FROM duckdb_secrets();
----
Permission Error

statement error
SELECT count(*) FROM duckdb_secrets();
----
Permission Error

statement error
CREATE TEMPORARY SECRET temp_secret (TYPE HTTP, BEARER_TOKEN 'x');
----
Permission Error

statement error
CREATE TEMPORARY SECRET temp_secret (TYPE HTTP, BEARER_TOKEN 'x');
----
Permission Error
