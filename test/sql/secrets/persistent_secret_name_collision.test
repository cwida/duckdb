# name: test/sql/secrets/persistent_secret_name_collision.test
# description: Persistent secrets whose names look like the escaped file name of another secret do not overwrite each other
# group: [secrets]

require noforcestorage

load {TEST_DIR}/persistent_secret_name_collision.db

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_collision'

statement ok
CREATE PERSISTENT SECRET "lit/name" (TYPE HTTP, BEARER_TOKEN 'tok');

restart

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_collision'

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
lit/name

# the escaped file name of "lit/name" is the plain name of "lit%2Fname": creating it must not touch the other secret
statement ok
CREATE PERSISTENT SECRET "lit%2Fname" (TYPE HTTP, BEARER_TOKEN 'tok2');

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
lit%2Fname
lit/name

restart

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_collision'

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
lit%2Fname
lit/name

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_name_collision/*.duckdb_secret');
----
2

statement ok
DROP PERSISTENT SECRET "lit/name";

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
lit%2Fname

restart

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_collision'

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
lit%2Fname

statement ok
DROP PERSISTENT SECRET "lit%2Fname";

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_name_collision/*.duckdb_secret');
----
0
