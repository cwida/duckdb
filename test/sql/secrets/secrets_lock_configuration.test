# name: test/sql/secrets/secrets_lock_configuration.test
# description: Test that secrets cannot be created or dropped when the configuration is locked
# group: [secrets]

require skip_reload

statement ok
SET secret_directory='{TEST_DIR}/secrets_lock_configuration'

# secrets can be created as usual while the configuration is unlocked
statement ok
CREATE SECRET s1 (TYPE HTTP, BEARER_TOKEN 'token')

statement ok
SET lock_configuration=true

# already existing secrets remain available
query I
SELECT name FROM duckdb_secrets()
----
s1

statement error
CREATE SECRET s2 (TYPE HTTP, BEARER_TOKEN 'token')
----
Cannot create secrets - the configuration has been locked

statement error
CREATE OR REPLACE SECRET s1 (TYPE HTTP, BEARER_TOKEN 'other')
----
Cannot create secrets - the configuration has been locked

statement error
CREATE TEMPORARY SECRET s2 (TYPE HTTP, BEARER_TOKEN 'token')
----
Cannot create secrets - the configuration has been locked

statement error
CREATE PERSISTENT SECRET s2 (TYPE HTTP, BEARER_TOKEN 'token')
----
Cannot create secrets - the configuration has been locked

statement error
DROP SECRET s1
----
Cannot drop secrets - the configuration has been locked

statement error
DROP SECRET IF EXISTS s3
----
Cannot drop secrets - the configuration has been locked

# the secret was not modified
query I
SELECT count(*) FROM duckdb_secrets() WHERE secret_string LIKE '%token%'
----
1

# and the configuration cannot be unlocked
statement error
SET lock_configuration=false
----
the configuration has been locked
