# name: test/sql/secrets/create_secret_external_access.test
# description: CREATE SECRET is refused for every provider and persistence once enable_external_access is false
# group: [secrets]

require noforcestorage

statement ok
SET secret_directory='{TEST_DIR}/create_secret_external_access';

# secrets created while external access is still enabled
statement ok
CREATE SECRET temp_before (TYPE http, PROVIDER config, HTTP_PROXY 'http://proxy/');

statement ok
CREATE PERSISTENT SECRET persistent_before (TYPE http, PROVIDER config, BEARER_TOKEN 'token');

statement ok
SET enable_external_access=false;

# the config provider reads no process state, but secret creation as a whole is off
statement error
CREATE SECRET temp_after (TYPE http, PROVIDER config, HTTP_PROXY 'http://proxy/');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "config")

statement error
CREATE TEMPORARY SECRET temp_after (TYPE http, PROVIDER env);
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "env")

statement error
CREATE PERSISTENT SECRET persistent_after (TYPE http, PROVIDER config, BEARER_TOKEN 'token');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "config")

statement error
CREATE OR REPLACE SECRET temp_before (TYPE http, PROVIDER config, HTTP_PROXY 'http://other/');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "config")

statement error
CREATE SECRET IF NOT EXISTS temp_before (TYPE http, PROVIDER config, HTTP_PROXY 'http://other/');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "config")

statement error
CREATE SECRET temp_after IN memory (TYPE http, PROVIDER config, HTTP_PROXY 'http://proxy/');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http", provider "config")

# the default provider is left out of the message
statement error
CREATE SECRET temp_after (TYPE http, HTTP_PROXY 'http://proxy/');
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "http")

# the gate fires before the type is looked up, so no extension is autoloaded for an unknown secret type
statement error
CREATE SECRET s3_after (TYPE s3, PROVIDER credential_chain);
----
Permission Error: Creating secrets is disabled when enable_external_access is false (secret type "s3", provider "credential_chain")

# the secrets created before remain listed and unchanged
query III
SELECT name, provider, persistent FROM duckdb_secrets() ORDER BY name
----
persistent_before	config	true
temp_before	config	false

query I
SELECT secret_string LIKE '%http://proxy/%' FROM duckdb_secrets() WHERE name = 'temp_before'
----
true
