# name: test/sql/secrets/http_env_scope_lookup.test
# description: Test the HTTP environment provider and SQL secret scope lookup
# group: [secrets]

require noforcestorage

statement ok
SET secret_directory = '{TEST_DIR}/http_env_scope_lookup'

# Explicit options override any proxy values inherited from the process environment.
statement ok
CREATE SECRET env_secret (
	TYPE HTTP,
	PROVIDER ENV,
	SCOPE 'https://env.example/',
	VERIFY_SSL false,
	HTTP_PROXY 'http://proxy/',
	HTTP_PROXY_USERNAME 'user',
	HTTP_PROXY_PASSWORD 'password',
	BEARER_TOKEN 'token',
	EXTRA_HTTP_HEADERS MAP {'x': 'y'}
)

query TIII
SELECT provider,
       secret_string LIKE '%http_proxy=http://proxy/%',
       secret_string LIKE '%http_proxy_password=redacted%',
       secret_string LIKE '%bearer_token=redacted%'
FROM duckdb_secrets()
WHERE name = 'env_secret'
----
env	true	true	true

# Scope selection uses the longest matching prefix and the secret name as a tie-breaker.
statement ok
CREATE SECRET z_catchall (TYPE HTTP)

statement ok
CREATE SECRET a_empty (TYPE HTTP, SCOPE '')

statement ok
CREATE SECRET b_same (TYPE HTTP, SCOPE 'https://example.com/data/')

statement ok
CREATE SECRET a_same (TYPE HTTP, SCOPE 'https://example.com/data/')

statement ok
CREATE SECRET nested (TYPE HTTP, SCOPE 'https://example.com/data/nested/')

query T
SELECT name FROM which_secret('https://example.com/data/nested/file.csv', 'http')
----
nested

query T
SELECT name FROM which_secret('https://example.com/data/file.csv', 'http')
----
a_same

query T
SELECT name FROM which_secret('https://unrelated.example/file.csv', 'http')
----
a_empty

query I
SELECT count(*) FROM which_secret('anything', 'missing')
----
0

statement error
CREATE TEMPORARY SECRET invalid_storage IN local_file (TYPE HTTP)
----
Cannot create temporary secrets in a persistent secret storage
