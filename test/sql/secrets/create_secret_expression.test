# name: test/sql/secrets/create_secret_expression.test
# description: Test secrets with expressions as params
# group: [secrets]

require noforcestorage

statement ok
set allow_parser_override_extension=strict;

statement ok
CREATE SECRET a (TYPE http);

statement error
CREATE SECRET a (TYPE http);
----
Invalid Input Error: Temporary secret with name "a" already exists!

statement ok
CREATE PERSISTENT SECRET a (TYPE http);

statement ok
CREATE PERSISTENT SECRET b (TYPE http);

statement error
CREATE PERSISTENT SECRET b (TYPE http);
----
Invalid Input Error: Persistent secret with name "b" already exists in secret storage 'local_file'!

statement ok
CREATE OR REPLACE SECRET a (TYPE http);

statement ok
CREATE SECRET IF NOT EXISTS a (TYPE http);

statement error
CREATE OR REPLACE SECRET IF NOT EXISTS a (TYPE http);
----
Parser Error

statement ok
CREATE TABLE bearer_tokens AS SELECT 'blablab'

statement ok
SET VARIABLE my_bearer_token='hocus pocus this token is bogus';

statement ok
CREATE SECRET http (TYPE HTTP, BEARER_TOKEN getvariable('my_bearer_token'));

query I
SELECT sum(#1 == 'bearer_token=redacted') FROM (SELECT unnest(secret_string.split(';')) FROM duckdb_secrets() where name='http');
----
1

# Test "old" syntax from before expressions were allowed
statement ok
CREATE SECRET scope_as_struct (TYPE HTTP, BEARER_TOKEN some_field, scope ('hi', 'hello'));

query I
select scope from duckdb_secrets() where name='scope_as_struct'
----
[hi, hello]

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, SCOPE 'https://duckdb.org');

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, SCOPE ['https://duckdb.org', 'http://extensions.duckdb.org']);

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, BEARER_TOKEN getvariable('my_bearer_token'));

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, HTTP_PROXY 'http://some-proxy/');

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, VERIFY_SSL 0);

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, VERIFY_SSL 1);

statement error
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, VERIFY_SSL something);
----
Binder Error: Failed to cast option "verify_ssl" to type 'BOOLEAN'

statement ok
CREATE OR REPLACE SECRET my_secret (TYPE HTTP, SCOPE ['https://duckdb.org', 'http://extensions.duckdb.org'], BEARER_TOKEN getvariable('my_bearer_token'), HTTP_PROXY 'http://some-proxy/', VERIFY_SSL 1);

# bearer token should also be redacted
statement ok
CREATE SECRET test_redacted (TYPE HTTP, BEARER_TOKEN super_secret);

query I
SELECT l[2] secret_value FROM (SELECT unnest(list_transform(split(secret_string, ';'), lambda x : split(x, '='))) l FROM duckdb_secrets() WHERE name='test_redacted') where l[1]='bearer_token'
----
redacted

# option values that are not a constant or a column reference are evaluated as expressions
statement ok
SET VARIABLE proxy_url='http://from-variable/';

statement ok
CREATE OR REPLACE SECRET coalesce_secret (TYPE HTTP, HTTP_PROXY COALESCE(getvariable('proxy_url'), 'http://unused/'));

query I
SELECT sum(#1 == 'http_proxy=http://from-variable/') FROM (SELECT unnest(secret_string.split(';')) FROM duckdb_secrets() WHERE name='coalesce_secret');
----
1

statement ok
CREATE OR REPLACE SECRET coalesce_fallback_secret (TYPE HTTP, HTTP_PROXY COALESCE(NULL, 'http://from-fallback/'));

query I
SELECT sum(#1 == 'http_proxy=http://from-fallback/') FROM (SELECT unnest(secret_string.split(';')) FROM duckdb_secrets() WHERE name='coalesce_fallback_secret');
----
1

statement ok
CREATE OR REPLACE SECRET case_secret (TYPE HTTP, HTTP_PROXY CASE WHEN 1 = 2 THEN 'http://wrong/' ELSE 'http://from-case/' END);

query I
SELECT sum(#1 == 'http_proxy=http://from-case/') FROM (SELECT unnest(secret_string.split(';')) FROM duckdb_secrets() WHERE name='case_secret');
----
1

statement ok
CREATE OR REPLACE SECRET operator_secret (TYPE HTTP, VERIFY_SSL COALESCE(NULL, 'http://a/' IS DISTINCT FROM 'http://b/'));

query I
SELECT sum(#1 == 'verify_ssl=true') FROM (SELECT unnest(secret_string.split(';')) FROM duckdb_secrets() WHERE name='operator_secret');
----
1

# subqueries are rejected by the binder rather than by the parser
statement error
CREATE OR REPLACE SECRET subquery_secret (TYPE HTTP, HTTP_PROXY (SELECT 'http://from-subquery/'));
----
Secret Parameter cannot contain subqueries