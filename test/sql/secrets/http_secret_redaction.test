# name: test/sql/secrets/http_secret_redaction.test
# description: HTTP secret inspection redacts headers and credentials
# group: [secrets]

require noforcestorage

require skip_reload

statement ok
SET allow_unredacted_secrets = false;

foreach provider config env

statement ok
CREATE SECRET http_header_redaction_{provider} (
    TYPE HTTP,
    PROVIDER {provider},
    BEARER_TOKEN 'dummy-bearer-token',
    HTTP_PROXY_PASSWORD 'dummy-proxy-password',
    VERIFY_SSL true,
    EXTRA_HTTP_HEADERS MAP {
        'Authorization': 'Bearer dummy-header-token',
        'X-API-Key': 'dummy-api-key'
    }
);

endloop

statement error
SELECT * FROM duckdb_secrets(redact = false);
----
Displaying unredacted secrets is disabled

# Both providers must hide credentials while keeping connection settings visible.
query TT rowsort
SELECT name, field
FROM duckdb_secrets(), UNNEST(string_split(secret_string, ';')) AS fields(field)
WHERE name IN ('http_header_redaction_config', 'http_header_redaction_env')
  AND split_part(field, '=', 1) IN ('extra_http_headers', 'bearer_token', 'http_proxy_password', 'verify_ssl');
----
http_header_redaction_config	bearer_token=redacted
http_header_redaction_config	extra_http_headers=redacted
http_header_redaction_config	http_proxy_password=redacted
http_header_redaction_config	verify_ssl=true
http_header_redaction_env	bearer_token=redacted
http_header_redaction_env	extra_http_headers=redacted
http_header_redaction_env	http_proxy_password=redacted
http_header_redaction_env	verify_ssl=true
