# name: test/sql/secrets/persistent_secret_map_value.test
# description: Persistent secrets with MAP values can be read back after a restart
# group: [secrets]

require noforcestorage

load {TEST_DIR}/persistent_secret_map_value.db

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_map_value'

statement ok
CREATE PERSISTENT SECRET map_secret (TYPE HTTP, EXTRA_HTTP_HEADERS MAP {'a': 'b'});

restart

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_map_value'

query II
SELECT name, type FROM duckdb_secrets()
----
map_secret	http
