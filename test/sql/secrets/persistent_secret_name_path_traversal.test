# name: test/sql/secrets/persistent_secret_name_path_traversal.test
# description: Persistent secret names are escaped in file names and cannot escape the secret directory
# group: [secrets]

require noforcestorage

load {TEST_DIR}/persistent_secret_name_path_traversal.db

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_path_traversal'

statement ok
CREATE PERSISTENT SECRET "../escaped_secret" (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET "a/b%c" (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE OR REPLACE PERSISTENT SECRET "..\escaped_secret" (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET regular_secret (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET "." (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET ".." (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET ".hidden" (TYPE HTTP, BEARER_TOKEN 'x');

statement ok
CREATE PERSISTENT SECRET "my.secret:1" (TYPE HTTP, BEARER_TOKEN 'x');

# nothing was written outside of the secret directory
query I
SELECT count(*) FROM glob('{TEST_DIR}/*escaped_secret*');
----
0

# the files are in the secret directory under escaped names
query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_name_path_traversal/*.duckdb_secret');
----
8

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
.
..
../escaped_secret
..\escaped_secret
.hidden
a/b%c
my.secret:1
regular_secret

# the original names are restored when the secrets are loaded again
restart

statement ok
set secret_directory='{TEST_DIR}/persistent_secret_name_path_traversal'

query I
SELECT name FROM duckdb_secrets() ORDER BY name;
----
.
..
../escaped_secret
..\escaped_secret
.hidden
a/b%c
my.secret:1
regular_secret

statement ok
DROP PERSISTENT SECRET "../escaped_secret";

statement ok
DROP PERSISTENT SECRET "a/b%c";

statement ok
DROP PERSISTENT SECRET "..\escaped_secret";

statement ok
DROP PERSISTENT SECRET regular_secret;

statement ok
DROP PERSISTENT SECRET ".";

statement ok
DROP PERSISTENT SECRET "..";

statement ok
DROP PERSISTENT SECRET ".hidden";

statement ok
DROP PERSISTENT SECRET "my.secret:1";

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_name_path_traversal/*.duckdb_secret');
----
0
