# name: test/sql/delete/delete_using_duplicate_local_rows.test
# description: DELETE USING with duplicate matches on rows inserted in the same transaction
# group: [delete]

statement ok
CREATE TABLE w(id INT PRIMARY KEY, v INT);

statement ok
BEGIN;

statement ok
INSERT INTO w VALUES (1,1),(2,2),(3,3);

query I
DELETE FROM w USING (VALUES (2),(2)) d(x) WHERE w.id = d.x RETURNING id;
----
2

statement ok
COMMIT;

query II
SELECT id, v FROM w ORDER BY id;
----
1	1
3	3

# the same with a UNIQUE index and committed + local rows
statement ok
CREATE TABLE u(id INT UNIQUE, v INT);

statement ok
INSERT INTO u VALUES (1,1);

statement ok
BEGIN;

statement ok
INSERT INTO u VALUES (2,2),(3,3);

statement ok
DELETE FROM u USING (VALUES (1),(1),(2),(2)) d(x) WHERE u.id = d.x;

statement ok
COMMIT;

query II
SELECT id, v FROM u ORDER BY id;
----
3	3

# the same row matched in multiple input chunks
statement ok
CREATE TABLE c(id INT PRIMARY KEY, v INT);

statement ok
BEGIN;

statement ok
INSERT INTO c VALUES (1,1),(2,2);

query I
DELETE FROM c USING (SELECT 2 FROM range(5000)) d(x) WHERE c.id = d.x;
----
1

statement ok
COMMIT;

query II
SELECT id, v FROM c ORDER BY id;
----
1	1

# the first skipped row comes after rows spanning multiple vectors were deleted
statement ok
CREATE TABLE l(id INT PRIMARY KEY);

statement ok
BEGIN;

statement ok
INSERT INTO l SELECT range FROM range(5000);

query I
DELETE FROM l USING (SELECT range FROM range(5000) UNION ALL SELECT 4999) d(x) WHERE l.id = d.x;
----
5000

# all deleted rows were removed from the index, so they can be inserted again
statement ok
INSERT INTO l SELECT range FROM range(5000);

statement ok
COMMIT;

query II
SELECT count(*), count(DISTINCT id) FROM l;
----
5000	5000
