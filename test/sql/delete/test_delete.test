# name: test/sql/delete/test_delete.test
# description: Test deletions
# group: [delete]

statement ok
CREATE TABLE a(i INTEGER);

statement ok
INSERT INTO a VALUES (42);

query I
SELECT COUNT(*) FROM a;
----
1

statement error
DELETE FROM a AS WHERE i = 42;
----
Parser Error: syntax error at or near "WHERE"

statement error
DELETE FROM a AS;
----
Parser Error: syntax error at or near ";"

# delete everything
statement ok
DELETE FROM a;

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

query I
SELECT COUNT(*) FROM a;
----
1

# now test rollback of deletion
statement ok
BEGIN TRANSACTION

statement ok
DELETE FROM a;

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM a;
----
1
