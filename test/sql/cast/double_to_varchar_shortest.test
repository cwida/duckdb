# name: test/sql/cast/double_to_varchar_shortest.test
# description: DOUBLE to VARCHAR gives the shortest text that reads back as the value, also for powers of two
# group: [cast]

query III
SELECT (2::DOUBLE ^ 81)::VARCHAR, (2::DOUBLE ^ 91)::VARCHAR, (2::DOUBLE ^ 807)::VARCHAR
----
2.4178516392292583e+24	2.4758800785707605e+27	8.535058474086213e+242

query III
SELECT (-(2::DOUBLE ^ 81))::VARCHAR, (-(2::DOUBLE ^ 91))::VARCHAR, (-(2::DOUBLE ^ 807))::VARCHAR
----
-2.4178516392292583e+24	-2.4758800785707605e+27	-8.535058474086213e+242

query IIII
SELECT k, (2::DOUBLE ^ k)::VARCHAR, nextafter(2::DOUBLE ^ k, 0)::VARCHAR, nextafter(2::DOUBLE ^ k, 'inf'::DOUBLE)::VARCHAR
FROM (VALUES (80), (81), (82), (90), (91), (92), (806), (807), (808)) t(k)
ORDER BY k
----
80	1.2089258196146292e+24	1.208925819614629e+24	1.2089258196146294e+24
81	2.4178516392292583e+24	2.417851639229258e+24	2.417851639229259e+24
82	4.835703278458517e+24	4.835703278458516e+24	4.835703278458518e+24
90	1.2379400392853803e+27	1.2379400392853801e+27	1.2379400392853805e+27
91	2.4758800785707605e+27	2.4758800785707603e+27	2.475880078570761e+27
92	4.951760157141521e+27	4.9517601571415205e+27	4.951760157141522e+27
806	4.267529237043107e+242	4.2675292370431063e+242	4.267529237043108e+242
807	8.535058474086213e+242	8.5350584740862125e+242	8.535058474086215e+242
808	1.7070116948172427e+243	1.7070116948172425e+243	1.707011694817243e+243

query II
SELECT count(*), count(*) FILTER (TRY_CAST(v::VARCHAR AS DOUBLE) IS DISTINCT FROM v)
FROM (SELECT s * (2::DOUBLE ^ k) AS v FROM range(-1074, 1024) t(k), (VALUES (1), (-1)) u(s))
----
4196	0

statement ok
CREATE TABLE powers AS SELECT * FROM (VALUES (1, 2::DOUBLE ^ 81), (2, 2::DOUBLE ^ 91), (3, 2::DOUBLE ^ 807), (4, NULL)) t(id, v)

query II
SELECT id, v::VARCHAR FROM powers ORDER BY id
----
1	2.4178516392292583e+24
2	2.4758800785707605e+27
3	8.535058474086213e+242
4	NULL

query I
SELECT format('{}', v) FROM powers WHERE v IS NOT NULL ORDER BY id
----
2.4178516392292583e+24
2.4758800785707605e+27
8.535058474086213e+242

query III
SELECT list(v ORDER BY id)::VARCHAR, {'a': max(v)}::VARCHAR, MAP {'a': max(v)}::VARCHAR FROM powers
----
[2.4178516392292583e+24, 2.4758800785707605e+27, 8.535058474086213e+242, NULL]	{'a': 8.535058474086213e+242}	{a=8.535058474086213e+242}

statement ok
COPY powers TO '{TEST_DIR}/double_powers_of_two.csv'

query II
SELECT * FROM read_csv('{TEST_DIR}/double_powers_of_two.csv', header = true, all_varchar = true) ORDER BY id
----
1	2.4178516392292583e+24
2	2.4758800785707605e+27
3	8.535058474086213e+242
4	NULL

query I
SELECT 'POINT(2.4178516392292583e+24 8.535058474086213e+242)'::GEOMETRY::VARCHAR
----
POINT (2.4178516392292583e+24 8.535058474086213e+242)

query III
SELECT (2::DOUBLE ^ 81)::FLOAT::VARCHAR, (2::DOUBLE ^ 91)::FLOAT::VARCHAR, (2::DOUBLE ^ 127)::FLOAT::VARCHAR
----
2.4178516e+24	2.4758801e+27	1.7014118e+38

query II
SELECT count(*), count(*) FILTER (TRY_CAST(v::VARCHAR AS FLOAT) IS DISTINCT FROM v)
FROM (SELECT (s * (2::DOUBLE ^ k))::FLOAT AS v FROM range(-149, 128) t(k), (VALUES (1), (-1)) u(s))
----
554	0
