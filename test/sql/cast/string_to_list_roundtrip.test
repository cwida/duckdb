# name: test/sql/cast/string_to_list_roundtrip.test
# group: [cast]

query III
select $$[\"abc\", def, ghi]$$::VARCHAR[] a, a::VARCHAR::VARCHAR[] b, a == b
----
['"abc"', def, ghi]	['"abc"', def, ghi]	true

statement ok
COPY (select $$[\"abc\", def, ghi]$$::VARCHAR[] a) TO '{TEST_DIR}/copy_test.csv' (FORMAT CSV);

query II
select a, a::VARCHAR[] from read_csv('{TEST_DIR}/copy_test.csv') t(a);
----
['"abc"', def, ghi]	['"abc"', def, ghi]

# Leading and trailing whitespace preservation
query III
select $$["  \"abc\"  ", def, ghi]$$::VARCHAR[] a, a::VARCHAR::VARCHAR[] b, a == b
----
['  "abc"  ', def, ghi]	['  "abc"  ', def, ghi]	true

# Escaping backslashes
query III
select $$[\  \\abc\\ \ , def, ghi]$$::VARCHAR[] a, a::VARCHAR::VARCHAR[] b, a == b
----
['\\  \\\\abc\\\\ \\', def, ghi]	['\\  \\\\abc\\\\ \\', def, ghi]	true

# Escaping backslashes
query III
select $$["\  \\abc\\ \ ", def, ghi]$$::VARCHAR[] a, a::VARCHAR::VARCHAR[] b, a == b
----
['  \\abc\\  ', def, ghi]	['  \\abc\\  ', def, ghi]	true

# Escaping '{' and '}'
query III
select $$[{}]$$::VARCHAR[] a, a::VARCHAR::VARCHAR[] b, a == b
----
['{}']	['{}']	true
