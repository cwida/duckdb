# name: test/sql/cast/test_float_to_decimal_cast.test
# description: FLOAT/DOUBLE to DECIMAL casts: rounding of halves and their neighbours, decimal and hugeint bounds, NULLs, failures, constant, dictionary and nested inputs
# group: [cast]

statement ok
CREATE TABLE halves AS SELECT (k + 0.5) * s AS x FROM range(-6, 6) a(k), (VALUES (1.0), (0.1), (0.01), (0.001), (1e-6)) b(s)

statement ok
CREATE TABLE near AS SELECT nextafter(nextafter(x, 1e308), 1e308) AS x FROM halves UNION ALL SELECT nextafter(x, 1e308) FROM halves UNION ALL SELECT nextafter(x, -1e308) FROM halves UNION ALL SELECT nextafter(nextafter(x, -1e308), -1e308) FROM halves

statement ok
CREATE TABLE anchors AS SELECT a::DOUBLE AS a FROM (VALUES (9999.0), (9999.5), (99999999.0), (1e15), (1e18), (18446744073709551616.0), (1e19), (1e37), (1e38), (1.7014118346046923e38)) t(a)

statement ok
CREATE TABLE bounds AS SELECT DISTINCT v * sgn AS x FROM (SELECT a AS v FROM anchors UNION ALL SELECT nextafter(a, 0::DOUBLE) FROM anchors UNION ALL SELECT nextafter(a, 1e308::DOUBLE) FROM anchors UNION ALL SELECT nextafter(nextafter(a, 0::DOUBLE), 0::DOUBLE) FROM anchors) t, (VALUES (1.0::DOUBLE), (-1.0::DOUBLE)) u(sgn)

statement ok
CREATE TABLE mixed AS SELECT i, CASE WHEN i % 7 = 0 THEN NULL WHEN i % 11 = 0 THEN 'nan'::DOUBLE WHEN i % 13 = 0 THEN 1e30 WHEN i % 17 = 0 THEN '-inf'::DOUBLE ELSE (i * 37.25) % 9999 END AS x FROM range(5000) r(i)

