# name: test/sql/pragma/profiling/test_cumulative_vacuum_time_checkpoint_latency.test_slow
# description: Test cumulative vacuum time relative to checkpoint latency
# group: [profiling]

require json

require skip_reload

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
PRAGMA disable_profiling;

statement ok
SET force_compression = 'uncompressed';

statement ok
SET max_vacuum_tasks = 1000;

# With one execution thread, checkpoint latency should include the vacuum task
# time plus the checkpoint work that follows it.

statement ok
SET threads = 1;

statement ok
ATTACH '{TEST_DIR}/single_thread_vacuum_latency.db' AS single_thread_vacuum (ROW_GROUP_SIZE 2048);

statement ok
CREATE TABLE single_thread_vacuum.tbl AS
SELECT
	i AS id,
	i % 1024 AS group_id,
	repeat('payload-' || (i % 1024)::VARCHAR, 8) AS payload
FROM range(524288) tbl(i);

statement ok
CHECKPOINT single_thread_vacuum;

statement ok
DELETE FROM single_thread_vacuum.tbl WHERE id % 2 = 0;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/single_thread_vacuum_latency.json';

statement ok
SET tracked_metrics = ['storage.total_vacuum_time', 'storage.checkpoint_latency'];

statement ok
SET profiling_coverage='ALL';

statement ok
CHECKPOINT single_thread_vacuum;

statement ok
PRAGMA disable_profiling;

statement ok
CREATE OR REPLACE TABLE single_thread_vacuum_metrics AS SELECT * FROM '{TEST_DIR}/single_thread_vacuum_latency.json';

query T
SELECT CASE
	WHEN storage.total_vacuum_time > 0 AND storage.total_vacuum_time < storage.checkpoint_latency THEN 'true'
	ELSE printf('single_thread vacuum=%.9f checkpoint=%.9f', storage.total_vacuum_time, storage.checkpoint_latency)
	END
FROM single_thread_vacuum_metrics;
----
true
