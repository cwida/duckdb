# name: test/sql/pragma/profiling/test_attach_and_checkpoint_latency.test
# group: [profiling]

# the disk is finicky on windows so checkpoint_latency sometimes == 0 when it should be > 0
require notwindows

require json

require noforcestorage

require skip_reload

# Setup.

statement ok
SET threads = 1;

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

# Finished setup.

# CHECKPOINT_LATENCY.

statement ok
ATTACH '{TEST_DIR}/profile_fs.db';

statement ok
CREATE TABLE profile_fs.tbl AS SELECT range AS id FROM range(100_000);

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/profile_fs.json';

statement ok
SET tracked_metrics = ['storage.waiting_to_attach_latency', 'storage.attach_load_storage_latency', 'storage.attach_replay_wal_latency', 'storage.checkpoint_latency'];

statement ok
SET profiling_coverage='ALL';

statement ok
CHECKPOINT profile_fs;

statement ok
PRAGMA disable_profiling;

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_fs.json';

query I
SELECT
	CASE WHEN storage.checkpoint_latency >= 0 THEN 'true'
	ELSE 'false' END
FROM metrics_output;
----
true

# WAITING_TO_ATTACH_LATENCY, ATTACH_LOAD_STORAGE_LATENCY and ATTACH_REPLAY_WAL_LATENCY.

statement ok
CREATE TABLE profile_fs.other_tbl AS SELECT range AS id FROM range(100_000);

statement ok
DETACH profile_fs;

statement ok
SET enable_profiling = 'json';

statement ok
ATTACH '{TEST_DIR}/profile_fs.db';

statement ok
PRAGMA disable_profiling;

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_fs.json';

query I
SELECT
	CASE WHEN storage.waiting_to_attach_latency >= 0 THEN 'true'
	ELSE 'false' END
FROM metrics_output;
----
true

query I
SELECT
	CASE WHEN storage.attach_load_storage_latency >= 0 THEN 'true'
	ELSE 'false' END
FROM metrics_output;
----
true

query I
SELECT
	CASE WHEN storage.attach_replay_wal_latency >= 0 THEN 'true'
	ELSE 'false' END
FROM metrics_output;
----
true
