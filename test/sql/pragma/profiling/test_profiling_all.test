# name: test/sql/pragma/profiling/test_profiling_all.test
# description: Test profiling all operator types.
# group: [profiling]

require json

require skip_reload

# Test ATTACH.
statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/profile_attach.json';

statement ok
SET profiling_coverage='ALL';

statement ok
ATTACH '{TEST_DIR}/profile_attach.db';

statement ok
PRAGMA disable_profiling;

statement ok
SET profiling_coverage='SELECT';

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_attach.json';

query II
SELECT query.total_time != 0, contains(query.sql, 'ATTACH') FROM metrics_output;
----
true	true

# Test CREATE TABLE.

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_coverage='ALL';

statement ok
CREATE TABLE profile_attach.tbl AS SELECT range AS id FROM range(10000);

statement ok
PRAGMA disable_profiling;

statement ok
SET profiling_coverage='SELECT';

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_attach.json';

query II
SELECT query.total_time != 0, contains(query.sql, 'CREATE TABLE') FROM metrics_output;
----
true	true

# Test INSERT.

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_coverage='ALL';

statement ok
INSERT INTO profile_attach.tbl SELECT range + 20000 FROM range(10000);

statement ok
PRAGMA disable_profiling;

statement ok
SET profiling_coverage='SELECT';

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_attach.json';

query II
SELECT query.total_time != 0, contains(query.sql, 'INSERT INTO') FROM metrics_output;
----
true	true

# Test CREATE INDEX.

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_coverage='ALL';

statement ok
CREATE INDEX idx ON profile_attach.tbl(id);

statement ok
PRAGMA disable_profiling;

statement ok
SET profiling_coverage='SELECT';

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_attach.json';

query II
SELECT query.total_time != 0, contains(query.sql, 'CREATE INDEX') FROM metrics_output;
----
true	true

# Test DETACH.

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_coverage='ALL';

statement ok
DETACH profile_attach;

statement ok
PRAGMA disable_profiling;

statement ok
SET profiling_coverage='SELECT';

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profile_attach.json';

query II
SELECT query.total_time != 0, contains(query.sql, 'DETACH') FROM metrics_output;
----
true	true
