# name: test/sql/pragma/profiling/test_autocheckpoint_latency.test
# description: Test that auto-checkpoint correctly reports all checkpoint-related metrics via profiling.
# group: [profiling]

require notwindows

require json

require noforcestorage

require skip_reload

statement ok
SET threads = 1;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

# Disable size-based autocheckpoint so only entry count triggers it.
statement ok
SET wal_autocheckpoint='1TB';

statement ok
ATTACH '{TEST_DIR}/autocheckpoint_latency.db' AS acp_db;

statement ok
CREATE TABLE acp_db.tbl(id INTEGER);

statement ok
CHECKPOINT acp_db;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/acp_before.json';

statement ok
SET tracked_metrics = ['storage.checkpoint_latency', 'io.total_bytes_written', 'storage.commit_local_storage_latency', 'storage.write_to_wal_latency'];

statement ok
SET profiling_coverage='ALL';

# A simple INSERT with no auto-checkpoint should have checkpoint_latency absent (not recorded) and total_bytes_written == 0.
# COMMIT_LOCAL_STORAGE_LATENCY and WRITE_TO_WAL_LATENCY will be > 0 since the INSERT still commits and writes WAL.
statement ok
INSERT INTO acp_db.tbl VALUES (1);

statement ok
PRAGMA disable_profiling;

query IIII
SELECT
    CASE WHEN json_extract(to_json(storage), '$.checkpoint_latency') IS NULL THEN 'true' ELSE 'false' END,
    CASE WHEN io.total_bytes_written = 0 THEN 'true' ELSE 'false' END,
    CASE WHEN storage.commit_local_storage_latency > 0 THEN 'true' ELSE 'false' END,
    CASE WHEN storage.write_to_wal_latency > 0 THEN 'true' ELSE 'false' END
FROM '{TEST_DIR}/acp_before.json';
----
true	true	true	true

# Now set a very low entry count threshold so the next commit triggers auto-checkpoint.
statement ok
SET wal_autocheckpoint_entries=1;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/acp_after.json';

# This INSERT should trigger auto-checkpoint on commit.
statement ok
INSERT INTO acp_db.tbl VALUES (2);

statement ok
PRAGMA disable_profiling;

# After auto-checkpoint, all metrics should be > 0.
query IIII
SELECT
    CASE WHEN storage.checkpoint_latency > 0 THEN 'true' ELSE 'false' END,
    CASE WHEN io.total_bytes_written > 0 THEN 'true' ELSE 'false' END,
    CASE WHEN storage.commit_local_storage_latency > 0 THEN 'true' ELSE 'false' END,
    CASE WHEN storage.write_to_wal_latency > 0 THEN 'true' ELSE 'false' END
FROM '{TEST_DIR}/acp_after.json';
----
true	true	true	true

statement ok
DETACH acp_db;
