# name: test/sql/pragma/profiling/test_custom_profiling_rows_scanned.test
# description: Test ROWS_SCANNED metric.
# group: [profiling]

require json

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/profiling_output.json';

statement ok
SET tracked_metrics = ['operator.intermediate_rows', 'operator.rows_scanned', 'query.total_intermediate_rows', 'query.total_rows_scanned'];

statement ok
CREATE TABLE integers(i INTEGER);

statement ok
INSERT INTO integers VALUES (1), (2), (3), (NULL);

statement ok
SELECT * FROM integers i1, integers i2 WHERE i1.i = i2.i ORDER BY 1;

statement ok
pragma disable_profiling;

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profiling_output.json';

statement ok
SELECT query.total_intermediate_rows, query.total_rows_scanned FROM metrics_output;

query I
SELECT
	CASE WHEN query.total_rows_scanned = 8 THEN NULL
	ELSE metrics_output END
FROM metrics_output;
----
NULL

# Only output the cumulative metric.

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/profiling_output.json';

statement ok
SET tracked_metrics = ['query.total_intermediate_rows', 'query.total_rows_scanned', 'system.blocked_thread_time'];

statement ok
SELECT * FROM integers i1, integers i2 WHERE i1.i = i2.i ORDER BY 1;

statement ok
PRAGMA disable_profiling;

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profiling_output.json';

query I
SELECT
	CASE WHEN query.total_rows_scanned > 0 THEN 'true'
	ELSE 'false' END
FROM metrics_output;
----
true
