# name: test/sql/pragma/profiling/test_empty_profiling_settings.test
# description: Test empty profiling settings.
# group: [profiling]

require json

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/profiling_output.json';

statement ok
SET tracked_metrics = [];

statement ok
SELECT unnest(['Maia', 'Thijs', 'Mark', 'Hannes', 'Tom', 'Max', 'Carlo', 'Sam', 'Tania']) AS names ORDER BY random();

statement ok
PRAGMA disable_profiling;

# Evaluate results.

query I
SELECT unnest(current_setting('tracked_metrics')) ORDER BY ALL
----

statement ok
CREATE OR REPLACE TABLE metrics_output AS SELECT * FROM '{TEST_DIR}/profiling_output.json';

statement error
SELECT cpu_time FROM metrics_output;
----
<REGEX>:Binder Error.*Referenced column "cpu_time" not found in FROM clause!.*

statement error
SELECT extra_info FROM metrics_output;
----
