# name: test/sql/filter/disjunctive_compressed_filter.test
# description: Disjunctive scan filters handle dictionaries and run arrays larger than a vector
# group: [filter]

require parquet

load {TEST_DIR}/disjunctive_compressed_filter.db

statement ok
SET force_compression='rle';

statement ok
CREATE TABLE runs AS SELECT (i//10)::INTEGER AS v FROM range(100000) t(i);

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) > 0 FROM pragma_storage_info('runs') WHERE column_name='v' AND compression='RLE';
----
true

query I
SELECT count(*) FROM runs WHERE v BETWEEN 1000 AND 4000 OR v BETWEEN 6000 AND 9000;
----
60020

statement ok
COPY (SELECT lpad((i%10000)::VARCHAR,6,'0') AS v FROM range(100000) t(i))
TO '{TEST_DIR}/disjunctive_compressed_filter.parquet' (FORMAT parquet);

query I
SELECT count(*) > 0 FROM parquet_metadata('{TEST_DIR}/disjunctive_compressed_filter.parquet')
WHERE encodings LIKE '%DICTIONARY%';
----
true

query I
SELECT count(*) FROM '{TEST_DIR}/disjunctive_compressed_filter.parquet'
WHERE v BETWEEN '001000' AND '004000' OR v BETWEEN '006000' AND '009000';
----
60020
