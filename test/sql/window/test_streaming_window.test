# A first chunk holding a single repeated non-NULL value, with no NULLs anywhere
query TT
EXPLAIN
WITH w AS (
	SELECT i, LAST_VALUE(CASE WHEN i < 2048 THEN 42 WHEN i % 2 = 0 THEN i ELSE -i END IGNORE NULLS) OVER (
		ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS x
	FROM range(2051) AS r(i)
)
