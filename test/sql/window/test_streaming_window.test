# First value NULL
query II
SELECT s,
	first(s IGNORE NULLS) over(ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM (VALUES (NULL), ('A'), (NULL), ('B')) t(s)
