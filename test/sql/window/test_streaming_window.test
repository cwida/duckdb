query TT
EXPLAIN
SELECT first_value(i) OVER (ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM integers;
----
physical_plan	<REGEX>:.*STREAMING_WINDOW.*

query TTTT
select i, j, first_value(i) over (), first_value(j) over () from integers
