# A non-NULL value carried across a chunk boundary into a chunk whose first row is NULL
query TT
EXPLAIN
WITH w AS (
	SELECT i, LAST_VALUE(CASE WHEN i = 100 THEN i END IGNORE NULLS) OVER (
		ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS x
	FROM range(2051) AS r(i)
)
SELECT COUNT(*), COUNT(*) FILTER (WHERE x IS DISTINCT FROM CASE WHEN i >= 100 THEN 100 END) FROM w;
----
