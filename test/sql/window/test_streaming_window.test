# Specify window and output order because the rollup aggregate output order is not deterministic.
query IRIR
SELECT 
	k, 
	STDDEV_POP(i), 
	SUM(j), 
	STDDEV_SAMP(k) OVER (ORDER BY k NULLS FIRST ROWS UNBOUNDED PRECEDING) std_wf 
FROM issue17621 
GROUP BY ROLLUP(k)
ORDER BY k NULLS FIRST
----
NULL	0.0	48	NULL
1	0.0	15	NULL
2	0.0	11	0.7071067811865476
3	0.0	11	1.0
4	0.0	11	1.2909944487358056

# UNION multiple local states
query II
WITH start_and_inputs AS (
    SELECT 50 AS moves
    UNION ALL
    SELECT 50 AS moves
)
SELECT moves, sum(moves) OVER (ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS sum
FROM start_and_inputs;
----
50	50
50	100

# Reset the argument between chunks when the first non-NULL is in a later chunk
query TT
EXPLAIN
WITH w AS (
	SELECT i, FIRST_VALUE(CASE WHEN i = 2048 THEN i END IGNORE NULLS) OVER (
		ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS x
	FROM range(2051) AS r(i)
)
SELECT COUNT(*), COUNT(*) FILTER (WHERE x IS DISTINCT FROM CASE WHEN i >= 2048 THEN 2048 END) FROM w;
----
physical_plan	<REGEX>:.*STREAMING_WINDOW.*

query II
WITH w AS (
	SELECT i, FIRST_VALUE(CASE WHEN i = 2048 THEN i END IGNORE NULLS) OVER (
		ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS x
	FROM range(2051) AS r(i)
)
SELECT COUNT(*), COUNT(*) FILTER (WHERE x IS DISTINCT FROM CASE WHEN i >= 2048 THEN 2048 END) FROM w;
----
2051	0

