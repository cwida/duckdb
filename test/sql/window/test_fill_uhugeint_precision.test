# name: test/sql/window/test_fill_uhugeint_precision.test
# description: Preserve precision when filling between nearby large UHUGEINT values
# group: [window]

query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, 9999999999999999999999999997::UHUGEINT),
             (1, NULL::UHUGEINT),
             (2, 9999999999999999999999999999::UHUGEINT)) t(i, v)
ORDER BY i;
----
0	9999999999999999999999999997
1	9999999999999999999999999998
2	9999999999999999999999999999

# Converting a rounded endpoint to UINT128 previously threw near UHUGEINT_MAX.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, 340282366920938463463374607431768211453::UHUGEINT),
             (1, NULL::UHUGEINT),
             (2, 340282366920938463463374607431768211455::UHUGEINT)) t(i, v)
ORDER BY i;
----
0	340282366920938463463374607431768211453
1	340282366920938463463374607431768211454
2	340282366920938463463374607431768211455

# Use the correct weight from the lower endpoint for ascending and descending values.
query III
SELECT i,
       fill(ascending_v ORDER BY i) OVER () AS ascending_filled,
       fill(descending_v ORDER BY i) OVER () AS descending_filled
FROM (VALUES (0, 340282366920938463463374607431768211451::UHUGEINT,
                 340282366920938463463374607431768211455::UHUGEINT),
             (1, NULL::UHUGEINT, NULL::UHUGEINT),
             (4, 340282366920938463463374607431768211455::UHUGEINT,
                 340282366920938463463374607431768211451::UHUGEINT)) t(i, ascending_v, descending_v)
QUALIFY i = 1;
----
1	340282366920938463463374607431768211452	340282366920938463463374607431768211454

# Fall back when the full endpoint delta cannot make an exact round trip through DOUBLE.
query III
SELECT i,
       fill(ascending_v ORDER BY i) OVER () AS ascending_filled,
       fill(descending_v ORDER BY i) OVER () AS descending_filled
FROM (VALUES (0, 1::UHUGEINT, 340282366920938463463374607431768211455::UHUGEINT),
             (1, NULL::UHUGEINT, NULL::UHUGEINT),
             (2, 340282366920938463463374607431768211455::UHUGEINT, 1::UHUGEINT))
     t(i, ascending_v, descending_v)
QUALIFY i = 1;
----
1	170141183460469231731687303715884105728	170141183460469231731687303715884105728

# Full-width spans use the exact binary value of a non-binary interpolation weight.
query III
SELECT i,
       fill(ascending_v ORDER BY i) OVER () AS ascending_filled,
       fill(descending_v ORDER BY i) OVER () AS descending_filled
FROM (VALUES (0, 0::UHUGEINT, 340282366920938463463374607431768211455::UHUGEINT),
             (1, NULL::UHUGEINT, NULL::UHUGEINT),
             (2, NULL::UHUGEINT, NULL::UHUGEINT),
             (3, 340282366920938463463374607431768211455::UHUGEINT, 0::UHUGEINT))
     t(i, ascending_v, descending_v)
ORDER BY i;
----
0	0	340282366920938463463374607431768211455
1	113427455640312814857969558651062452223	226854911280625667494870980259286614015
2	226854911280625629715939117302124904447	113427455640312833747435490129643307007
3	340282366920938463463374607431768211455	0

# A non-roundtripping span near UHUGEINT_MAX must not round the endpoint to 2^128.
query III
SELECT i,
       fill(ascending_v ORDER BY i) OVER () AS ascending_filled,
       fill(descending_v ORDER BY i) OVER () AS descending_filled
FROM (VALUES (0, 340282366920938463463365600232513470462::UHUGEINT,
                 340282366920938463463374607431768211455::UHUGEINT),
             (1, NULL::UHUGEINT, NULL::UHUGEINT),
             (2, NULL::UHUGEINT, NULL::UHUGEINT),
             (3, NULL::UHUGEINT, NULL::UHUGEINT),
             (4, 340282366920938463463374607431768211455::UHUGEINT,
                 340282366920938463463365600232513470462::UHUGEINT)) t(i, ascending_v, descending_v)
ORDER BY i;
----
0	340282366920938463463365600232513470462	340282366920938463463374607431768211455
1	340282366920938463463367852032327155710	340282366920938463463372355631954526206
2	340282366920938463463370103832140840958	340282366920938463463370103832140840958
3	340282366920938463463372355631954526206	340282366920938463463367852032327155710
4	340282366920938463463374607431768211455	340282366920938463463365600232513470462

# A 1/4096 weight shifts the three-limb product by exactly one 64-bit limb.
query I
SELECT fill(CASE WHEN i = 0 THEN 0::UHUGEINT
                 WHEN i = 4096 THEN 340282366920938463463374607431768211455::UHUGEINT
            END ORDER BY i) OVER () AS filled
FROM range(4097) t(i)
QUALIFY i = 1;
----
83076749736557242056487941267521535

# Backward extrapolation (leading NULLs) over neighbouring values near 10^28.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, NULL::UHUGEINT),
             (1, 9999999999999999999999999998::UHUGEINT),
             (2, 9999999999999999999999999999::UHUGEINT)) t(i, v)
ORDER BY i;
----
0	9999999999999999999999999997
1	9999999999999999999999999998
2	9999999999999999999999999999

# Forward extrapolation (trailing NULLs) over neighbouring values near 10^28.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, 9999999999999999999999999997::UHUGEINT),
             (1, 9999999999999999999999999998::UHUGEINT),
             (2, NULL::UHUGEINT)) t(i, v)
ORDER BY i;
----
0	9999999999999999999999999997
1	9999999999999999999999999998
2	9999999999999999999999999999

# Descending extrapolation in both directions.
query III
SELECT i,
       fill(trailing_v ORDER BY i) OVER () AS trailing_filled,
       fill(leading_v ORDER BY i) OVER () AS leading_filled
FROM (VALUES (0, 9999999999999999999999999999::UHUGEINT, NULL::UHUGEINT),
             (1, 9999999999999999999999999998::UHUGEINT, 9999999999999999999999999999::UHUGEINT),
             (2, NULL::UHUGEINT, 9999999999999999999999999998::UHUGEINT)) t(i, trailing_v, leading_v)
ORDER BY i;
----
0	9999999999999999999999999999	10000000000000000000000000000
1	9999999999999999999999999998	9999999999999999999999999999
2	9999999999999999999999999997	9999999999999999999999999998

# A fractional extrapolation weight truncates the exact offset.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, NULL::UHUGEINT),
             (1, 9999999999999999999999999998::UHUGEINT),
             (3, 9999999999999999999999999999::UHUGEINT)) t(i, v)
QUALIFY i = 0;
----
0	9999999999999999999999999998

# Forward extrapolation can land exactly on UHUGEINT_MAX without rounding to 2^128.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, 340282366920938463463374607431768211453::UHUGEINT),
             (1, 340282366920938463463374607431768211454::UHUGEINT),
             (2, NULL::UHUGEINT)) t(i, v)
ORDER BY i;
----
0	340282366920938463463374607431768211453
1	340282366920938463463374607431768211454
2	340282366920938463463374607431768211455

# Extrapolations out of the unsigned 128-bit range still produce NULL, not an error.
query II
SELECT i, fill(overflow_v ORDER BY i) OVER () AS overflow_filled
FROM (VALUES (0, 340282366920938463463374607431768211454::UHUGEINT),
             (1, 340282366920938463463374607431768211455::UHUGEINT),
             (2, NULL::UHUGEINT)) t(i, overflow_v)
QUALIFY i = 2;
----
2	NULL

query II
SELECT i, fill(underflow_v ORDER BY i) OVER () AS underflow_filled
FROM (VALUES (0, NULL::UHUGEINT),
             (1, 5::UHUGEINT),
             (2, 12::UHUGEINT)) t(i, underflow_v)
QUALIFY i = 0;
----
0	NULL

# Backward extrapolation can land exactly on zero.
query II
SELECT i, fill(v ORDER BY i) OVER () AS filled
FROM (VALUES (0, NULL::UHUGEINT),
             (1, 5::UHUGEINT),
             (2, 10::UHUGEINT)) t(i, v)
QUALIFY i = 0;
----
0	0

# Duplicate order keys can place a missing value exactly at either endpoint.
query II
SELECT id, fill(v ORDER BY ordering) OVER () AS filled
FROM (VALUES (0, 0, 340282366920938463463374607431768211453::UHUGEINT),
             (1, 0, NULL::UHUGEINT),
             (2, 1, 340282366920938463463374607431768211455::UHUGEINT),
             (3, 1, NULL::UHUGEINT)) t(id, ordering, v)
QUALIFY id IN (1, 3)
ORDER BY id;
----
1	340282366920938463463374607431768211453
3	340282366920938463463374607431768211455
