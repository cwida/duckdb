SELECT i, LAG(i, 3000) OVER() AS i1
FROM range(5000) tbl(i);
----
physical_plan	<!REGEX>:.*STREAMING_WINDOW.*

query TT
EXPLAIN
SELECT i, LEAD(i, 3000) OVER() AS i1
FROM range(5000) tbl(i);
----
physical_plan	<!REGEX>:.*STREAMING_WINDOW.*

# Test multiple, unequal LEADs
query III
SELECT i, LEAD(i, 1) OVER(), LEAD(i, 2) OVER()
FROM range(10) tbl(i)
----
0	1	2
1	2	3
2	3	4
3	4	5
4	5	6
5	6	7
6	7	8
7	8	9
8	9	NULL
9	NULL	NULL

# Test incomplete buffering
query II
select * from (
	select 
		id, 
		lead(id, 2047, -1) over() l 
	from range(6144) tbl(id)
	where id != 1 
	  and id != 2 
	  and id != 2500 
	  and id != 2501 
	  and id != 2502
) 
where id >= 2040 and id <= 2050;
----
2040	4090
2041	4091
2042	4092
2043	4093
2044	4094
2045	4095
2046	4096
2047	4097
2048	4098
2049	4099
2050	4100

query I
SELECT LAG ( v3 , 10 , 3 ) OVER( ) 
FROM VALUES 
	( 0 , 1::VARCHAR , 1 ),
	( 1 , NULL , 2 )
	AS v0(v1, v3, v2);
----
3
3

query I
SELECT LEAD(i, (-9223372036854775808)::BIGINT) OVER () FROM range(3) t(i);
----
NULL
NULL
NULL

query I
SELECT LAG(i, (-9223372036854775808)::BIGINT) OVER () FROM range(3) t(i);
----
NULL
NULL
NULL

# UNIONs mess up the pipelining
query II
WITH t AS (
	SELECT range AS i FROM range(3) 
	UNION ALL 
	SELECT range AS i FROM range(3)
)
SELECT i, lead(i, 1) OVER () AS next_i
FROM t;
----
0	1
1	2
2	0
0	1
1	2
2	NULL
