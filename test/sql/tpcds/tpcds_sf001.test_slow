# name: test/sql/tpcds/tpcds_sf001.test_slow
# description: Test TPC-DS SF0.001
# group: [tpcds]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

require tpcds

statement ok
SET debug_verify_serializer=true;

# answers are generated from postgres
# hence check with NULLS LAST flag
statement ok
PRAGMA default_null_order='postgres'

statement ok
CALL dsdgen(sf=0.01)

