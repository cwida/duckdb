# name: test/sql/tpcds/dsdgen_nested_schema.test
# description: dsdgen keeps the full current schema path and overwrites only the selected schema
# group: [tpcds]

require tpcds

statement ok
ATTACH '{TEST_DIR}/dsdgen_nested_schema.db' AS dsdgen_nested (STORAGE_VERSION 'v2.0.0');

statement ok
USE dsdgen_nested;

statement ok
CREATE SCHEMA a;

statement ok
CREATE SCHEMA a.b;

statement ok
CREATE SCHEMA b;

statement ok
CREATE SCHEMA "a.b";

statement ok
CREATE TABLE b.customer_address AS SELECT 42 AS sentinel;

statement ok
USE dsdgen_nested.a.b;

statement ok
CALL dsdgen(sf=0, overwrite=true);

query I
SELECT sentinel FROM dsdgen_nested.b.customer_address;
----
42

query I
SELECT count(*) FROM (SHOW TABLES FROM dsdgen_nested.a.b);
----
24

# Exercise the separate sequential and parallel table lookup paths.
foreach threads 1 4

statement ok
SET threads={threads};

statement ok
CALL dsdgen(sf=0.01, overwrite=true);

query I
SELECT count(*) > 0 FROM dsdgen_nested.a.b.customer_address;
----
true

query I
SELECT sentinel FROM dsdgen_nested.b.customer_address;
----
42

endloop

# String schema arguments prefer a nested path when it exists.
statement ok
CALL dsdgen(sf=0, schema='a.b', suffix='_nested_arg');

query I
SELECT count(*) FROM dsdgen_nested.a.b.customer_address_nested_arg;
----
0

query I
SELECT count(*) FROM (SHOW TABLES FROM dsdgen_nested."a.b");
----
0

# Quoting selects the literal name even when the nested path exists.
statement ok
CALL dsdgen(sf=0, schema='"a.b"');

query I
SELECT count(*) FROM dsdgen_nested."a.b".customer_address;
----
0

# Without a nested path, the unquoted argument falls back to a literal name.
statement ok
CREATE SCHEMA dsdgen_nested."legacy.dot";

statement ok
CALL dsdgen(sf=0, schema='legacy.dot');

query I
SELECT count(*) FROM dsdgen_nested."legacy.dot".customer_address;
----
0

# Resolve schema= in the supplied catalog, regardless of parameter order.
statement ok
ATTACH '{TEST_DIR}/dsdgen_schema_arg.db' AS dsdgen_arg (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE SCHEMA dsdgen_arg."a.b";

statement ok
CALL dsdgen(sf=0, schema='a.b', catalog='dsdgen_arg');

query I
SELECT count(*) FROM dsdgen_arg."a.b".customer_address;
----
0

statement ok
CALL dsdgen(sf=0, catalog='dsdgen_arg', schema='a.b', suffix='_reverse');

query I
SELECT count(*) FROM dsdgen_arg."a.b".customer_address_reverse;
----
0

# USE also preserves a literal dot within a nested schema component.
statement ok
CREATE SCHEMA dsdgen_nested.a."b.c";

statement ok
USE dsdgen_nested.a."b.c";

statement ok
CALL dsdgen(sf=0, suffix='_quoted');

query I
SELECT count(*) FROM dsdgen_nested.a."b.c".customer_address_quoted;
----
0

statement ok
RESET threads;
