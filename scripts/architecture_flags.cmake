function(duckdb_resolve_architecture_flags OUT_VARIABLE)
  string(TOUPPER "${DUCKDB_OPTIMIZATION_PROFILE}" DUCKDB_RESOLVED_OPTIMIZATION_PROFILE)
  if(NOT DUCKDB_RESOLVED_OPTIMIZATION_PROFILE MATCHES "^(CLI|EXTENSION|NONE)$")
    message(FATAL_ERROR
      "DUCKDB_OPTIMIZATION_PROFILE must be CLI, EXTENSION, or NONE; got '${DUCKDB_OPTIMIZATION_PROFILE}'")
  endif()

  if(DUCKDB_RESOLVED_OPTIMIZATION_PROFILE STREQUAL "NONE" OR NATIVE_ARCH OR ANDROID)
    set(${OUT_VARIABLE} "" PARENT_SCOPE)
    return()
  endif()

  set(DUCKDB_TARGET_ARCHITECTURE "")
  if(DUCKDB_EXPLICIT_PLATFORM MATCHES "(^|_)amd64($|_)")
    set(DUCKDB_TARGET_ARCHITECTURE "amd64")
  elseif(DUCKDB_EXPLICIT_PLATFORM MATCHES "(^|_)arm64($|_)")
    set(DUCKDB_TARGET_ARCHITECTURE "arm64")
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(DUCKDB_TARGET_ARCHITECTURE "amd64")
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
    set(DUCKDB_TARGET_ARCHITECTURE "arm64")
  endif()

  set(DUCKDB_ARCHITECTURE_FLAGS "")
  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    if(DUCKDB_TARGET_ARCHITECTURE STREQUAL "arm64" OR "arm64" IN_LIST CMAKE_OSX_ARCHITECTURES)
      if("x86_64" IN_LIST CMAKE_OSX_ARCHITECTURES)
        set(DUCKDB_ARCHITECTURE_FLAGS "-Xarch_arm64;-mcpu=apple-m1")
      else()
        set(DUCKDB_ARCHITECTURE_FLAGS "-mcpu=apple-m1")
      endif()
    endif()
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
      set(${OUT_VARIABLE} "" PARENT_SCOPE)
      return()
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
      set(${OUT_VARIABLE} "" PARENT_SCOPE)
      return()
    endif()

    if(DUCKDB_TARGET_ARCHITECTURE STREQUAL "amd64")
      if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        set(DUCKDB_ARCHITECTURE_FLAGS "-march=haswell;-mtune=generic")
      elseif(DUCKDB_RESOLVED_OPTIMIZATION_PROFILE STREQUAL "EXTENSION")
        set(DUCKDB_ARCHITECTURE_FLAGS "-march=x86-64-v2;-mtune=generic")
      else()
        set(DUCKDB_ARCHITECTURE_FLAGS "-march=x86-64-v3;-mtune=generic")
      endif()
    elseif(DUCKDB_TARGET_ARCHITECTURE STREQUAL "arm64")
      set(DUCKDB_ARCHITECTURE_FLAGS "-march=armv8-a;-mtune=generic")
    endif()
  endif()

  set(${OUT_VARIABLE} "${DUCKDB_ARCHITECTURE_FLAGS}" PARENT_SCOPE)
endfunction()

function(duckdb_collect_build_targets DIRECTORY_PATH OUT_VARIABLE)
  get_property(DUCKDB_DIRECTORY_TARGETS DIRECTORY "${DIRECTORY_PATH}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(DUCKDB_SUBDIRECTORIES DIRECTORY "${DIRECTORY_PATH}" PROPERTY SUBDIRECTORIES)
  foreach(DUCKDB_SUBDIRECTORY IN LISTS DUCKDB_SUBDIRECTORIES)
    duckdb_collect_build_targets("${DUCKDB_SUBDIRECTORY}" DUCKDB_SUBDIRECTORY_TARGETS)
    list(APPEND DUCKDB_DIRECTORY_TARGETS ${DUCKDB_SUBDIRECTORY_TARGETS})
  endforeach()
  set(${OUT_VARIABLE} "${DUCKDB_DIRECTORY_TARGETS}" PARENT_SCOPE)
endfunction()

function(duckdb_requires_x86_64_v3_check ARCHITECTURE_FLAGS OUT_VARIABLE)
  if("-march=x86-64-v3" IN_LIST ARCHITECTURE_FLAGS OR "-march=haswell" IN_LIST ARCHITECTURE_FLAGS)
    set(${OUT_VARIABLE} TRUE PARENT_SCOPE)
  else()
    set(${OUT_VARIABLE} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(duckdb_resolve_target_architecture_flags TARGET_NAME ARCHITECTURE_FLAGS OUT_FLAGS OUT_CHECK)
  duckdb_requires_x86_64_v3_check("${ARCHITECTURE_FLAGS}" REQUIRES_X86_64_V3_CHECK)
  if(REQUIRES_X86_64_V3_CHECK AND TARGET_NAME STREQUAL "shell")
    set(${OUT_FLAGS} "" PARENT_SCOPE)
    set(${OUT_CHECK} TRUE PARENT_SCOPE)
  else()
    set(${OUT_FLAGS} "${ARCHITECTURE_FLAGS}" PARENT_SCOPE)
    set(${OUT_CHECK} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(duckdb_apply_architecture_flags)
  duckdb_resolve_architecture_flags(DUCKDB_ARCHITECTURE_FLAGS)
  if(NOT DUCKDB_ARCHITECTURE_FLAGS)
    if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC"
       AND NOT DUCKDB_OPTIMIZATION_PROFILE STREQUAL "NONE" AND NOT NATIVE_ARCH)
      message(STATUS "MSVC does not support the DuckDB architecture profile; keeping baseline code generation")
    endif()
    return()
  endif()

  duckdb_collect_build_targets("${CMAKE_CURRENT_SOURCE_DIR}" DUCKDB_BUILD_TARGETS)
  foreach(DUCKDB_BUILD_TARGET IN LISTS DUCKDB_BUILD_TARGETS)
    get_target_property(DUCKDB_BUILD_TARGET_TYPE ${DUCKDB_BUILD_TARGET} TYPE)
    if(DUCKDB_BUILD_TARGET_TYPE STREQUAL "INTERFACE_LIBRARY"
       OR DUCKDB_BUILD_TARGET_TYPE STREQUAL "UTILITY")
      continue()
    endif()
    duckdb_resolve_target_architecture_flags("${DUCKDB_BUILD_TARGET}" "${DUCKDB_ARCHITECTURE_FLAGS}"
      DUCKDB_BUILD_TARGET_ARCHITECTURE_FLAGS DUCKDB_BUILD_TARGET_REQUIRES_X86_64_V3_CHECK)
    if(DUCKDB_BUILD_TARGET_REQUIRES_X86_64_V3_CHECK)
      target_compile_definitions(shell PRIVATE "$<$<CONFIG:Release>:DUCKDB_SHELL_X86_64_V3>")
    endif()
    foreach(DUCKDB_ARCHITECTURE_FLAG IN LISTS DUCKDB_BUILD_TARGET_ARCHITECTURE_FLAGS)
      target_compile_options(${DUCKDB_BUILD_TARGET} PRIVATE
        "$<$<AND:$<CONFIG:Release>,$<OR:$<COMPILE_LANGUAGE:C>,$<COMPILE_LANGUAGE:CXX>>>:${DUCKDB_ARCHITECTURE_FLAG}>")
    endforeach()
  endforeach()

  string(JOIN " " DUCKDB_ARCHITECTURE_FLAGS_STRING ${DUCKDB_ARCHITECTURE_FLAGS})
  message(STATUS
    "DuckDB ${DUCKDB_OPTIMIZATION_PROFILE} Release architecture flags: ${DUCKDB_ARCHITECTURE_FLAGS_STRING}")
endfunction()
