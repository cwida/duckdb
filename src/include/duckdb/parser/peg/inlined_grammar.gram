'VALUE' /
'VARIABLE' /
'VARYING' /
'VERSION' /
'VIEW' /
'VIEWS' /
'VIRTUAL' /
'VOLATILE' /
'WEEK' /
'WEEKS' /
'WHITESPACE' /
