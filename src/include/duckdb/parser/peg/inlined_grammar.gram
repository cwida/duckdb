'ZONE'
AlterStatement <- 'ALTER' AlterOptions

AlterOptions <- AlterTableStmt / AlterViewStmt / AlterSequenceStmt / AlterDatabaseStmt / AlterSchemaStmt

AlterTableStmt <- 'TABLE' IfExists? BaseTableName List(AlterTableOptions)
AlterSchemaStmt <- 'SCHEMA' IfExists? QualifiedName AlterSchemaOptions
AlterSchemaOptions <- RenameAlter / SetOptions / ResetOptions

AlterTableOptions <- AddColumn / DropConstraint / DropColumn / AlterColumn / AddConstraint /
        RenameColumn / RenameAlter / SetPartitionedBy / ResetPartitionedBy / SetSortedBy / ResetSortedBy / SetOptions / ResetOptions

AddConstraint <- 'ADD' TopLevelConstraint
DropConstraint <- 'DROP' 'CONSTRAINT' IfExists? ConstraintName DropBehavior?
AddColumn <- 'ADD' 'COLUMN'? IfNotExists? AddColumnEntry
AddColumnEntry <- DottedIdentifier Type? GeneratedColumn? ColumnConstraint*
DropColumn <- 'DROP' 'COLUMN'? IfExists? NestedColumnName DropBehavior?
AlterColumn <- 'ALTER' 'COLUMN'? NestedColumnName AlterColumnEntry
RenameColumn <- 'RENAME' 'COLUMN'? NestedColumnName 'TO' ColIdOrString
NestedColumnName <- IdentifierDot* ColumnName
IdentifierDot <- Identifier '.'
RenameAlter <- 'RENAME' 'TO' ColIdOrString
SetPartitionedBy <- 'SET' 'PARTITIONED' 'BY' Parens(List(Expression))
ResetPartitionedBy <- 'RESET' 'PARTITIONED' 'BY'
SetSortedBy <- 'SET' 'SORTED' 'BY' Parens(OrderByExpressions)
ResetSortedBy <- 'RESET' 'SORTED' 'BY'
SetOptions <- 'SET' RelOptionList
ResetOptions <- 'RESET' RelOptionList

AlterColumnEntry <- AddOrDropDefault / ChangeNullability / AlterType

AddOrDropDefault <- AddDefault / DropDefault
AddDefault <- 'SET' 'DEFAULT' Expression
DropDefault <- 'DROP' 'DEFAULT'

ChangeNullability <- DropOrSet 'NOT' 'NULL'
DropOrSet <- DropNullability / SetNullability
DropNullability <- 'DROP'
SetNullability <- 'SET'

AlterType <- SetData? 'TYPE' Type? ColumnCollation? UsingExpression?
SetData <- 'SET' 'DATA'?
UsingExpression <- 'USING' Expression

AlterViewStmt <- 'VIEW' IfExists? BaseTableName RenameAlter

AlterSequenceStmt <- 'SEQUENCE' IfExists? QualifiedSequenceName AlterSequenceOptions

QualifiedSequenceName <- CatalogQualification? SchemaQualification? SequenceName

AlterSequenceOptions <- RenameAlterSequenceOptions / SetSequenceOption
RenameAlterSequenceOptions <- RenameAlter
SetSequenceOption <- SequenceOption+

AlterDatabaseStmt <- 'DATABASE' IfExists? Identifier 'SET' 'ALIAS' 'TO' Identifier

AnalyzeStatement <- AnalyzeKeyword AnalyzeVerbose? AnalyzeTarget?
AnalyzeTarget <- BaseTableName NameList?
AnalyzeVerbose <- 'VERBOSE'

AttachStatement <- 'ATTACH' OrReplace? IfNotExists? Database? DatabasePath AttachAlias? AttachOptions?

Database <- 'DATABASE'
DatabasePath <- Expression
AttachAlias <- 'AS' ColId
AttachOptions <- GenericCopyOptionList

CallStatement <- 'CALL' QualifiedTableFunction TableFunctionArguments

CheckpointStatement <- CheckpointForce? 'CHECKPOINT' CatalogName?
CheckpointForce <- 'FORCE'

CommentStatement <- 'COMMENT' 'ON' CommentOnType CommentTarget 'IS' CommentValue

CommentTarget <- DottedIdentifier / CommentStringLiteralIdentifier
CommentStringLiteralIdentifier <- StringLiteralIdentifier

CommentOnType <-    CommentTable / CommentSequence / CommentFunction / CommentMacroTable / CommentMacro /
                    CommentView / CommentDatabase / CommentIndex / CommentSchema / CommentType / CommentColumn

CommentTable <- 'TABLE'
CommentSequence <- 'SEQUENCE'
CommentFunction <- 'FUNCTION'
CommentMacroTable <- 'MACRO' 'TABLE'
CommentMacro <- 'MACRO'
CommentView <- 'VIEW'
CommentDatabase <- 'DATABASE'
CommentIndex <- 'INDEX'
CommentSchema <- 'SCHEMA'
CommentType <- 'TYPE'
CommentColumn <- 'COLUMN'

CommentValue <- NullLiteral / StringLiteralValue
StringLiteralValue <- StringLiteral

ConnectStatement <- 'CONNECT' SessionTarget?
DisconnectStatement <- 'DISCONNECT'
SessionTarget <- LocalSessionTarget / StringSessionTarget / CatalogSessionTarget
LocalSessionTarget <- 'LOCAL'
StringSessionTarget <- StringLiteral GenericCopyOptionList?
CatalogSessionTarget <- CatalogName

CopyStatement <- 'COPY' CopyVariations
CopyVariations <- CopyTable / CopySelect / CopyFromDatabase

CopyTable <- BaseTableName InsertColumnList? FromOrTo CopyFileName CopyLegacyOption? CopyOptions?
FromOrTo <- CopyFrom / CopyTo
CopyFrom <- 'FROM'
CopyTo <- 'TO'

CopySelect <- Parens(SelectStatementInternal) 'TO' CopyFileName CopyOptions?

CopyFileName <- CopyFileNameExpression / CopyFileNameStringLiteral / CopyFileNameIdentifierColId / CopyFileNameIdentifier
CopyFileNameExpression <- Parameter / ParensExpression
CopyFileNameStringLiteral <- StringLiteral
CopyFileNameIdentifier <- Identifier
CopyFileNameIdentifierColId <- IdentifierColId
IdentifierColId <- Identifier CopyFileNameSuffix+
CopyFileNameSuffix <- '.' ColId

CopyLegacyOption <- 'USING'? 'DELIMITERS' StringLiteral

CopyOptions <- 'WITH'? CopyOptionList
CopyOptionList <- CopyGenericOptionList / SpecializedOptionList
SpecializedOptionList <- SpecializedOption SpecializedOptionTail*
SpecializedOptionTail <- ','? SpecializedOption
SpecializedOption <- SingleOption / NullAsOption / DelimiterAsOption / EscapeAsOption /
	EncodingOption / QuoteAsOption / ForceQuoteOption / PartitionByOption / ForceNullOption

SingleOption <- BinaryOption / FreezeOption / OidsOption / CsvOption / HeaderOption
BinaryOption <- 'BINARY'
FreezeOption <- 'FREEZE'
OidsOption <- 'OIDS'
CsvOption <- 'CSV'
HeaderOption <- 'HEADER'
NullAsOption <- 'NULL' 'AS'? StringLiteral
DelimiterAsOption <- 'DELIMITER' 'AS'? StringLiteral
QuoteAsOption <- 'QUOTE' 'AS'? StringLiteral
EscapeAsOption <- 'ESCAPE' 'AS'? StringLiteral
EncodingOption <- 'ENCODING' StringLiteral
ForceQuoteOption <- ForceQuote? 'QUOTE' StarSymbolColumnList
StarSymbolColumnList <- StarSymbol / ColumnList
ForceQuote <- 'FORCE'
PartitionByOption <- ('PARTITION' / 'PARTITIONED') 'BY' PartitionByColumnList
PartitionByColumnList <- StarPartitionByColumnList / ParenthesizedPartitionByColumnList / SinglePartitionByColumnList
StarPartitionByColumnList <- StarSymbol
ParenthesizedPartitionByColumnList <- Parens(ColumnList)
SinglePartitionByColumnList <- ColId
ForceNullOption <- 'FORCE' ForceNotNull? 'NULL' ColumnList
ForceNotNull <- 'NOT'
StarSymbol <- '*'

CopyGenericOptionList <- Parens(List(CopyGenericOption))
CopyGenericOption <- OrderByCopyOption / PartitionedByCopyOption / GenericCopyOption
OrderByCopyOption <- 'ORDER' 'BY' GenericCopyOptionValue?
PartitionedByCopyOption <- ('PARTITION' / 'PARTITIONED') 'BY' GenericCopyOptionValue?
GenericCopyOptionList <- Parens(List(GenericCopyOption))
GenericCopyOption <- CopyOptionName GenericCopyOptionValue?
GenericCopyOptionValue <- GenericCopyOptionOrderList / GenericCopyOptionExpression
GenericCopyOptionOrderList <- GenericCopyOptionParenthesizedExpressionList
GenericCopyOptionExpression <- Expression
GenericCopyOptionParenthesizedExpressionList <- Parens(OrderByExpressionList)

CopyFromDatabase <- CopyFromDatabaseWithFlag / CopyFromDatabaseWithoutFlag
CopyFromDatabaseWithFlag <- 'FROM' 'DATABASE' ColId 'TO' ColId CopyDatabaseFlag
CopyFromDatabaseWithoutFlag <- 'FROM' 'DATABASE' ColId 'TO' ColId

CopyDatabaseFlag <- Parens(SchemaOrData)
SchemaOrData <- CopySchema / CopyData
CopySchema <- 'SCHEMA'
CopyData <- 'DATA'

CreateIndexStmt <- UniqueIndex? 'INDEX' IndexConcurrently? IfNotExists? IndexName? 'ON' BaseTableName IndexType? Parens(List(IndexElement)) WithList? WhereClause?

WithList <- 'WITH' RelOptionOrOids
RelOptionOrOids <- RelOptionList / Oids
RelOptionList <- Parens(List(RelOption))
Oids <- WithOrWithoutOids 'OIDS'
WithOrWithoutOids <- WithOids / WithoutOids
WithOids <- 'WITH'
WithoutOids <- 'WITHOUT'
IndexElement <- Expression DescOrAsc? NullsFirstOrLast?
UniqueIndex <- 'UNIQUE'
IndexConcurrently <- 'CONCURRENTLY'
IndexType <- 'USING' Identifier
RelOption <- RelOptionName RelOptionArgumentOpt?
RelOptionName <- DottedColLabel / StringLiteral
DottedColLabel <- ColLabel DotColLabel*
RelOptionArgumentOpt <- '=' DefArg
DefArg <- DefArgNull / DefArgStringLiteral / NumberLiteral / NoneLiteral / Expression / DefArgKeyword
DefArgNull <- NullLiteral
DefArgKeyword <- ReservedKeyword
DefArgStringLiteral <- StringLiteral
NoneLiteral <- 'NONE'

CreateMacroStmt <- MacroOrFunction IfNotExists? QualifiedName List(MacroDefinition)

ReturnsType <- 'RETURNS' Type

MacroOrFunction <- MacroKeyword / FunctionKeyword
MacroKeyword <- 'MACRO'
FunctionKeyword <- 'FUNCTION'

MacroDefinition <- Parens(MacroParameters?) ReturnsType? 'AS' MacroDefinitionBody
MacroDefinitionBody <- TableMacroDefinition / ScalarMacroDefinition

MacroParameters <- List(MacroParameter)
MacroParameter <- NamedParameter / SimpleParameter
SimpleParameter <- TypeFuncName Type?

ScalarMacroDefinition <- Expression
TableMacroDefinition <- 'TABLE' SelectStatementInternal

CreateSchemaStmt <- 'SCHEMA' IfNotExists? QualifiedName WithOptionList?

WithOptionList <- 'WITH' RelOptionList

CreateSecretStmt <- 'SECRET' IfNotExists? SecretName? SecretStorageSpecifier? GenericCopyOptionList

SecretStorageSpecifier <- 'IN' Identifier
SecretName <- ColId

CreateSequenceStmt <- 'SEQUENCE' IfNotExists? QualifiedName SequenceOption*

SequenceOption <-
	SeqSetCycle /
	SeqSetIncrement /
	SeqSetMinMax /
	SeqNoMinMax /
	SeqStartWith /
	SeqOwnedBy

SeqSetCycle <- SeqCycle / SeqNoCycle
SeqCycle <- 'CYCLE'
SeqNoCycle <- 'NO' 'CYCLE'
SeqSetIncrement <- 'INCREMENT' 'BY'? Expression
SeqSetMinMax <- SeqMinOrMax Expression
SeqNoMinMax <- 'NO' SeqMinOrMax
SeqStartWith <- 'START' 'WITH'? Expression
SeqOwnedBy <- 'OWNED' 'BY' QualifiedName

SeqMinOrMax <- MinValue / MaxValue
MinValue <- 'MINVALUE'
MaxValue <- 'MAXVALUE'

CreateStatement <- 'CREATE' OrReplace? Temporary? CreateStatementVariation
CreateStatementVariation <- CreateTableStmt / CreateMacroStmt / CreateSequenceStmt / CreateTypeStmt / CreateSchemaStmt / CreateViewStmt / CreateIndexStmt / CreateSecretStmt / CreateTriggerStmt
OrReplace <- 'OR' 'REPLACE'
Temporary <- Persistent / TempPersistent / TemporaryPersistent
Persistent <- 'PERSISTENT'
TempPersistent <- 'TEMP'
TemporaryPersistent <- 'TEMPORARY'

CreateTableStmt <- 'TABLE' IfNotExists? QualifiedName CreateTableDefinition CommitAction?
CreateTableDefinition <- CreateTableAs / CreateColumnList

CreateTableAs <- IdentifierList? PartitionSortedOptions? WithList? 'AS' Statement WithData?
PartitionSortedOptions <- PartitionOptSortedOptions / SortedOptPartitionOptions
PartitionOptSortedOptions <- PartitionOptions SortedOptions?
SortedOptPartitionOptions <- SortedOptions PartitionOptions?
PartitionOptions <- 'PARTITIONED' 'BY' Parens(List(Expression))
SortedOptions <- 'SORTED' 'BY' Parens(List(Expression))

WithData <- WithDataOnly / WithNoData
WithDataOnly <- 'WITH' 'DATA'
WithNoData <- 'WITH' 'NO' 'DATA'
IdentifierList <- Parens(List(Identifier))
CreateColumnList <- Parens(CreateTableColumnList?) PartitionSortedOptions? WithList?
IfNotExists <- 'IF' 'NOT' 'EXISTS'
QualifiedName <- CatalogReservedSchemaIdentifier / SchemaReservedIdentifierOrStringLiteral / IdentifierOrStringLiteral
SchemaReservedIdentifierOrStringLiteral <- SchemaQualification ReservedIdentifierOrStringLiteral
CatalogReservedSchemaIdentifier <- CatalogQualification ReservedSchemaQualification+ ReservedIdentifierOrStringLiteral
IdentifierOrStringLiteral <- Identifier / StringLiteral
ReservedIdentifierOrStringLiteral <- ReservedIdentifier / StringLiteral
CatalogQualification <- CatalogName '.'
SchemaQualification <- SchemaName '.'
ReservedSchemaQualification <- ReservedSchemaName '.'
TableQualification <- TableName '.'
ReservedTableQualification <- ReservedTableName '.'

CreateTableColumnList <- List(CreateTableColumnElement)
CreateTableColumnElement <- CreateTableColumnDefinition / CreateTableConstraint
CreateTableColumnDefinition <- ColumnDefinition
CreateTableConstraint <- TopLevelConstraint
ColumnDefinition <- Identifier Type? GeneratedColumn? ColumnConstraint*
ColumnConstraint <- NameableColumnConstraint / ColumnCollation
NameableColumnConstraint <- ConstraintNameClause? ColumnConstraintElement
ColumnConstraintElement <- NotNullConstraint / UniqueConstraint / PrimaryKeyConstraint / DefaultValue / CheckConstraint / ForeignKeyConstraint / ColumnCompression
NotNullConstraint <- NullConstraint / NotNullColumnConstraint
NullConstraint <- 'NULL'
NotNullColumnConstraint <- 'NOT' 'NULL'
UniqueConstraint <- 'UNIQUE' ConstraintTiming?
PrimaryKeyConstraint <- 'PRIMARY' 'KEY' ConstraintTiming?
ConstraintTiming <- ImmediateConstraint / DeferredConstraint
ImmediateConstraint <- 'IMMEDIATE'
DeferredConstraint <- 'DEFERRED'
DefaultValue <- 'DEFAULT' ColumnDefaultExpr
CheckConstraint <- 'CHECK' Parens(Expression)
ForeignKeyConstraint <- 'REFERENCES' BaseTableName Parens(ColumnList)? KeyActions?
ColumnCollation <- 'COLLATE' DottedIdentifier
ColumnCompression <- 'USING' 'COMPRESSION' ColIdOrString

KeyActions <- UpdateFirstKeyActions / DeleteFirstKeyActions
UpdateFirstKeyActions <- UpdateAction DeleteAction?
DeleteFirstKeyActions <- DeleteAction UpdateAction?
UpdateAction <- 'ON' 'UPDATE' KeyAction
DeleteAction <- 'ON' 'DELETE' KeyAction
KeyAction <- NoKeyAction / RestrictKeyAction / CascadeKeyAction / SetNullKeyAction / SetDefaultKeyAction
NoKeyAction <- 'NO' 'ACTION'
RestrictKeyAction <- 'RESTRICT'
CascadeKeyAction <- 'CASCADE'
SetNullKeyAction <- 'SET' 'NULL'
SetDefaultKeyAction <- 'SET' 'DEFAULT'

TopLevelConstraint <- ConstraintNameClause? TopLevelConstraintList
TopLevelConstraintList <- TopPrimaryKeyConstraint / TopCheckConstraint / TopUniqueConstraint / TopForeignKeyConstraint
ConstraintNameClause <- 'CONSTRAINT' ConstraintName
TopCheckConstraint <- CheckConstraint
TopPrimaryKeyConstraint <- 'PRIMARY' 'KEY' ColumnIdList ConstraintTiming?
TopUniqueConstraint <- 'UNIQUE' ColumnIdList ConstraintTiming?
TopForeignKeyConstraint <- 'FOREIGN' 'KEY' ColumnIdList ForeignKeyConstraint
ColumnIdList <- Parens(List(ColId))

PlainIdentifier <- !ReservedKeyword <[a-z_]i[a-z0-9_]i*>
QuotedIdentifier <- ('"' [^"]* '"') / ('`' [^`]* '`')
DottedIdentifier <- Identifier DotColLabel*
DotColLabel <- '.' ColLabel
Identifier <- QuotedIdentifier / PlainIdentifier

ColId <- UnreservedKeyword / ColumnNameKeyword / Identifier
ColIdOrString <- ColId / StringLiteralIdentifier
TypeFuncName <- UnreservedKeyword / TypeFuncKeyword / Identifier
TypeFuncKeyword <- TypeNameKeyword / FuncNameKeyword
TypeName <- UnreservedKeyword / TypeNameKeyword / Identifier
ColLabel <- ReservedKeyword / UnreservedKeyword / ColumnNameKeyword / FuncNameKeyword / TypeNameKeyword / Identifier
ColLabelOrString <- ColLabelIdentifier / StringLiteralIdentifier
ColLabelIdentifier <- ColLabel
BareColLabel <- BareLabelKeyword / Identifier
StringLiteralIdentifier <- StringLiteral
GeneratedColumn <- Generated? 'AS' Parens(Expression) GeneratedColumnType?

Generated <- GeneratedAlways / GeneratedByDefault
GeneratedAlways <- 'GENERATED' 'ALWAYS'
GeneratedByDefault <- 'GENERATED' 'BY' 'DEFAULT'
GeneratedColumnType <- VirtualGeneratedColumn / StoredGeneratedColumn

CommitAction <- 'ON' 'COMMIT' PreserveOrDelete 'ROWS'
PreserveOrDelete <- PreserveRows / DeleteRows
PreserveRows <- 'PRESERVE'
DeleteRows <- 'DELETE'
VirtualGeneratedColumn <- 'VIRTUAL'
StoredGeneratedColumn <- 'STORED'

CreateTriggerStmt <- 'TRIGGER' IfNotExists? TriggerName TriggerTiming TriggerEvent 'ON' BaseTableName ReferencingClause? ForEachClause? TriggerBody

TriggerBody <- InsertStatement / UpdateStatement / DeleteStatement / MergeIntoStatement
TriggerName <- Identifier

ReferencingClause <- 'REFERENCING' ReferencingItem ReferencingItem?
ReferencingItem <- ReferencingNewTableAs / ReferencingOldTableAs
ReferencingNewTableAs <- 'NEW' 'TABLE' 'AS' ColId
ReferencingOldTableAs <- 'OLD' 'TABLE' 'AS' ColId

TriggerTiming <- TriggerBefore / TriggerAfter / TriggerInsteadOf
TriggerBefore <- 'BEFORE'
TriggerAfter <- 'AFTER'
TriggerInsteadOf <- 'INSTEAD' 'OF'

TriggerEvent <- TriggerEventUpdateOf / TriggerEventInsert / TriggerEventDelete / TriggerEventUpdate
TriggerEventInsert <- 'INSERT'
TriggerEventDelete <- 'DELETE'
TriggerEventUpdate <- 'UPDATE'
TriggerEventUpdateOf <- 'UPDATE' 'OF' TriggerColumnList

TriggerColumnList <- List(ColId)

ForEachClause <- ForEachRow / ForEachStatement
ForEachRow <- 'FOR' 'EACH' 'ROW'
ForEachStatement <- 'FOR' 'EACH' 'STATEMENT'

CreateTypeStmt <- 'TYPE' IfNotExists? QualifiedName 'AS' CreateType
CreateType <- EnumSelectType / EnumStringLiteralList / CreateTypeFromType
CreateTypeFromType <- Type
EnumSelectType <- 'ENUM' Parens(SelectStatementInternal)
EnumStringLiteralList <- 'ENUM' Parens(List(StringLiteral)?) ArrayBounds*

CreateViewStmt <- CreateSecure? CreateRecursive? 'VIEW' IfNotExists? QualifiedName InsertColumnList? WithList? 'AS' SelectStatementInternal
CreateRecursive <- 'RECURSIVE'
CreateSecure <- 'SECURE'

DeallocateStatement <- 'DEALLOCATE' DeallocatePrepare? ColIdOrString
DeallocatePrepare <- 'PREPARE'

DeleteStatement <- WithClause? 'DELETE' 'FROM' TargetOptAlias DeleteUsingClause? WhereClause? ReturningClause?
TruncateStatement <- 'TRUNCATE' 'TABLE'? BaseTableName TruncateOptions?
# DropBehavior first, so CASCADE/RESTRICT are not consumed as an alias
TruncateOptions <- TruncateDropBehavior / TruncateAliasOptions
TruncateAliasOptions <- TargetAlias TruncateDropBehavior?
TruncateDropBehavior <- DropBehavior
TargetOptAlias <- BaseTableName TargetAlias?
TargetAlias <- 'AS'? ColId
DeleteUsingClause <- 'USING' List(TableRef)

DescribeStatement <- ShowTables / ShowDeprecatedSelect / DescribeSelect / ShowAllTables / ShowByName / DescribeByName

# "DESCRIBE (query)" and "SUMMARIZE (query)" describe the query's columns. "SHOW (query)" does too but is deprecated,
# so ShowDeprecatedSelect is parsed yet suppressed from autocomplete (matcher_factory.cpp) - SHOW won't offer to complete a query.
ShowDeprecatedSelect <- ShowRule SelectStatementInternal
DescribeSelect <- DescribeOrSummarize SelectStatementInternal
ShowAllTables <- ShowOrDescribe 'ALL' 'TABLES'?
ShowTables <- ShowOrDescribe 'TABLES' 'FROM' QualifiedName

# "SHOW name" is settings-first, so its target autocompletes setting names (and the special MySQL forms), not
# arbitrary tables. "DESCRIBE"/"SUMMARIZE" describe a relation, so their target autocompletes table names.
ShowByName <- ShowRule ShowTarget?
DescribeByName <- DescribeOrSummarize DescribeTarget?
DescribeOrSummarize <- DescribeRule / Summarize

# SHOW's own forms (a settings-first name and the special MySQL forms) plus the describe-style targets it still
# tolerates for the deprecated "describe via SHOW". Only settings and the special forms are autocompleted after SHOW;
# a qualified table is parsed but its suggestions are suppressed (see matcher.cpp).
ShowTarget <- ShowDeprecatedQualifiedTableName / ShowSettingName / DescribeStringLiteral / ShowSpecialForm
# "SHOW cat.tbl" still describes a table (deprecated), but is suppressed from autocomplete (see matcher.cpp) so SHOW
# does not complete qualified tables (unlike DESCRIBE, which does). Wraps the generic QualifiedTableName (select.gram).
ShowDeprecatedQualifiedTableName <- QualifiedTableName
# A bare identifier is suggested as a setting name (SettingName is overridden to SUGGEST_SETTING_NAME).
ShowSettingName <- SettingName
# The special MySQL forms are only here so autocomplete suggests these keywords after SHOW; parsing of e.g.
# "SHOW databases" resolves through ShowSettingName (the identifier) above, which the transformer special-cases.
ShowSpecialForm <- 'DATABASES' / 'SCHEMAS' / 'TABLES' / 'VARIABLES'

DescribeTarget <- DescribeBaseTableName / DescribeStringLiteral
DescribeBaseTableName <- BaseTableName
DescribeStringLiteral <- StringLiteral

Summarize <- SummarizeRule
SummarizeRule <- 'SUMMARIZE'
ShowOrDescribe <- ShowRule / DescribeRule
ShowRule <- 'SHOW'
DescribeRule <- DescribeLongRule / DescRule
DescribeLongRule <- 'DESCRIBE'
DescRule <- 'DESC'

DetachStatement <- 'DETACH' Database? IfExists? CatalogName

DropStatement <- 'DROP' DropEntries DropBehavior?

DropEntries <-
	DropTable /
	DropTableFunction /
	DropFunction /
	DropSchema /
	DropIndex /
	DropSequence /
	DropCollation /
	DropType /
	DropSecret /
	DropTrigger

DropTrigger <- 'TRIGGER' IfExists? TriggerName 'ON' BaseTableName

DropTable <- TableOrView IfExists? List(BaseTableName)
DropTableFunction <- CommentMacroTable IfExists? List(QualifiedTableFunction)
DropFunction <- FunctionTypeMacro IfExists? List(FunctionIdentifier)
DropSchema <- 'SCHEMA' IfExists? List(QualifiedName)
DropIndex <- 'INDEX' IfExists? List(QualifiedIndexName)
QualifiedIndexName <- CatalogReservedSchemaIndex / SchemaReservedIndex / QualifiedIndexNameString
QualifiedIndexNameString <- IndexName
SchemaReservedIndex <- SchemaQualification ReservedIndexName
CatalogReservedSchemaIndex <- CatalogQualification ReservedSchemaQualification ReservedIndexName
DropSequence <- 'SEQUENCE' IfExists? List(QualifiedSequenceName)
DropCollation <- 'COLLATION' IfExists? List(CollationName)
DropType <- 'TYPE' IfExists? List(QualifiedTypeName)
DropSecret <- Temporary? 'SECRET' IfExists? SecretName DropSecretStorage?

TableOrView <- CommentTable / CommentView / MaterializedViewEntry
MaterializedViewEntry <- 'MATERIALIZED' 'VIEW'
FunctionTypeMacro <- FunctionTypeMacroKeyword / FunctionTypeFunction
FunctionTypeMacroKeyword <- 'MACRO'
FunctionTypeFunction <- 'FUNCTION'

DropBehavior <- CascadeDropBehavior / RestrictDropBehavior
CascadeDropBehavior <- 'CASCADE'
RestrictDropBehavior <- 'RESTRICT'

IfExists <- 'IF' 'EXISTS'

DropSecretStorage <- 'FROM' Identifier

ExecuteStatement <- 'EXECUTE' ColIdOrString TableFunctionArguments?

ExplainStatement <- 'EXPLAIN' AnalyzeKeyword? ExplainOptionList? ExplainableStatements
ExplainOptionList <- Parens(List(ExplainOption))
ExplainOption <- ExplainOptionName Expression?
ExplainOptionName <- AnalyzeKeyword / ColId / FuncNameKeyword / TypeNameKeyword

ExplainSelectStatement <- SelectStatementInternal

ExplainableStatements <-
    AlterStatement /
    AnalyzeStatement /
    CallStatement /
    CheckpointStatement /
    CopyStatement /
    CreateStatement /
    DeallocateStatement /
    DeleteStatement /
    DropStatement /
    ExecuteStatement /
    InsertStatement /
    InstallStatement /
    LoadStatement /
    MergeIntoStatement /
    PragmaStatement /
    PrepareStatement /
    ExplainSelectStatement /
    TransactionStatement /
    TruncateStatement /
    UpdateExtensionsStatement /
    UpdateStatement /
    VacuumStatement /
    SetStatement /
    ResetStatement

ExportStatement <- 'EXPORT' 'DATABASE' ExportSource? StringLiteral ExportOptions?
ExportSource <- CatalogName 'TO'
ExportOptions <- GenericCopyOptionList / SpecializedOptionList
ImportStatement <- 'IMPORT' 'DATABASE' StringLiteral

ColumnReference <- NestedSchemaTableColumnName / CatalogReservedSchemaTableColumnName / SchemaReservedTableColumnName / TableReservedColumnName / NestedColumnName
# a column of a table in a nested schema chain - five or more components, where the qualification is deeper than
# catalog + schema and it is no longer positional which components are schemas and which is the table
NestedSchemaTableColumnName <- CatalogQualification ReservedSchemaQualification ReservedSchemaQualification ReservedSchemaQualification+ ReservedColumnName
CatalogReservedSchemaTableColumnName <- CatalogQualification ReservedSchemaQualification ReservedTableQualification ReservedColumnName
SchemaReservedTableColumnName <- SchemaQualification ReservedTableQualification ReservedColumnName
TableReservedColumnName <- TableQualification ReservedColumnName
FunctionExpression <- FunctionIdentifier FunctionExpressionArguments WithinGroupClause? FilterClause? ExportClause? OverClause?
FunctionExpressionArguments <- Parens(FunctionExpressionArgumentList)
FunctionExpressionArgumentList <- DistinctOrAll? FunctionArgumentList? OrderByClause? IgnoreOrRespectNulls?
FunctionArgumentList <- List(FunctionArgument)

FunctionIdentifier <- CatalogReservedSchemaFunctionName / SchemaReservedFunctionName / FunctionNameAsQualifiedName
FunctionNameAsQualifiedName <- FunctionName
CatalogReservedSchemaFunctionName <- CatalogQualification ReservedSchemaQualification* ReservedFunctionName
SchemaReservedFunctionName <- SchemaQualification ReservedFunctionName

DistinctOrAll <- DistinctKeyword / AllKeyword
DistinctKeyword <- 'DISTINCT'
AllKeyword <- 'ALL'
ExportClause <- 'EXPORT_STATE'
WithinGroupClause <- 'WITHIN' 'GROUP' Parens(OrderByClause)
FilterClause <- 'FILTER' FilterClauseExpression
FilterClauseExpression <- Parens(FilterClauseContents)
FilterClauseContents <- 'WHERE'? Expression
IgnoreOrRespectNulls <- IgnoreNulls / RespectNulls
IgnoreNulls <- 'IGNORE' 'NULLS'
RespectNulls <- 'RESPECT' 'NULLS'

ParenthesisExpression <- Parens(List(Expression)?)
LiteralExpression <- StringLiteral / NumberLiteral / ConstantLiteral
ConstantLiteral <- NullLiteral / TrueLiteral / FalseLiteral
NullLiteral <- 'NULL'
TrueLiteral <- 'TRUE'
FalseLiteral <- 'FALSE'
CastExpression <- CastOrTryCast Parens(CastArguments)
CastArguments <- Expression 'AS' Type
CastOrTryCast <- CastKeyword / TryCastKeyword
CastKeyword <- 'CAST'
TryCastKeyword <- 'TRY_CAST'
ColIdDot <- ColId '.'
StarExpression <- StarQualifierList? '*' ExcludeList? ReplaceList? RenameList?
StarQualifierList <- ColIdDot+
ExcludeList <- ExcludeOrExcept ExcludeNames
ExcludeOrExcept <- 'EXCLUDE' / 'EXCEPT'
ExcludeNames <- ExcludeNameList / ExcludeNameSingle
ExcludeNameList <- Parens(List(ExcludeName))
ExcludeNameSingle <- ExcludeName
ExcludeName <- ExcludeDottedName / ExcludeColumnName
ExcludeDottedName <- DottedIdentifier
ExcludeColumnName <- ColIdOrString
ReplaceList <- 'REPLACE' ReplaceEntries
ReplaceEntries <- ReplaceEntrySingle / ReplaceEntryList
ReplaceEntrySingle <- ReplaceEntry
ReplaceEntryList <- Parens(List(ReplaceEntry))
ReplaceEntry <- Expression 'AS' ColumnReference
RenameList <- 'RENAME' RenameEntries
RenameEntries <- RenameEntryList / SingleRenameEntry
RenameEntryList <- Parens(List(RenameEntry))
SingleRenameEntry <- RenameEntry
RenameEntry <- ExcludeName 'AS' Identifier
SubqueryExpression <- SubqueryNot? SubqueryExists? SubqueryReference
SubqueryNot <- 'NOT'
SubqueryExists <- 'EXISTS'
CaseExpression <- SimpleCaseExpression / SearchedCaseExpression
SimpleCaseExpression <- 'CASE' Expression SimpleCaseWhenThen+ CaseElse? 'END'
SearchedCaseExpression <- 'CASE' CaseWhenThen+ CaseElse? 'END'
SimpleCaseWhenThen <- 'WHEN' List(SimpleCaseWhenOperand) 'THEN' Expression
# WHEN < 0 compares the CASE operand with <, a WHEN operand without an operator compares with =
# WHEN 0, 1 matches if any of the operands matches
SimpleCaseWhenOperand <- ComparisonExpressionTail / SimpleCaseWhenEquals
SimpleCaseWhenEquals <- Expression
CaseWhenThen <- 'WHEN' Expression 'THEN' Expression
CaseElse <- 'ELSE' Expression
TypeLiteral <- Type StringLiteral
IntervalLiteral <- 'INTERVAL' IntervalParameter Interval?
IntervalParameter <- IntervalStringParameter / NumberLiteral / ParensExpression
IntervalStringParameter <- StringLiteral
FrameClause <- Framing FrameExtent WindowExcludeClause?
Framing <- RowsFraming / RangeFraming / GroupsFraming
RowsFraming <- 'ROWS'
RangeFraming <- 'RANGE'
GroupsFraming <- 'GROUPS'
FrameExtent <- BetweenFrameExtent / SingleFrameExtent
SingleFrameExtent <- FrameBound
BetweenFrameExtent <- 'BETWEEN' FrameBound 'AND' FrameBound
FrameBound <- FrameUnbounded / FrameCurrentRow / FrameExpression
FrameUnbounded <- 'UNBOUNDED' PrecedingOrFollowing
FrameExpression <- Expression PrecedingOrFollowing
FrameCurrentRow <- 'CURRENT' 'ROW'
PrecedingOrFollowing <- PrecedingFrame / FollowingFrame
PrecedingFrame <- 'PRECEDING'
FollowingFrame <- 'FOLLOWING'
WindowExcludeClause <- 'EXCLUDE' WindowExcludeElement
WindowExcludeElement <- ExcludeCurrentRow / ExcludeGroup / ExcludeTies / ExcludeNoOthers
ExcludeCurrentRow <- 'CURRENT' 'ROW'
ExcludeGroup <- 'GROUP'
ExcludeTies <- 'TIES'
ExcludeNoOthers <- 'NO' 'OTHERS'
OverClause <- 'OVER' WindowFrame
WindowFrame <- ParensIdentifier / WindowFrameDefinition / IdentifierWindowFrame
IdentifierWindowFrame <- Identifier
ParensIdentifier <- Parens(Identifier)
WindowFrameDefinition <- WindowFrameNameContentsParens / WindowFrameContentsParens
WindowFrameNameContentsParens <- Parens(WindowFrameNameContents)
WindowFrameNameContents <- BaseWindowName? WindowFrameContents
WindowFrameContentsParens <- Parens(WindowFrameContents)
WindowFrameContents <- WindowPartition? OrderByClause? FrameClause?
BaseWindowName <- Identifier
WindowPartition <- 'PARTITION' 'BY' List(Expression)
ListExpression <- ArrayBoundedListExpression / ArrayParensSelect
ArrayBoundedListExpression <- 'ARRAY'? BoundedListExpression
ArrayParensSelect <- 'ARRAY' Parens(SelectStatementInternal)
BoundedListExpression <- '[' List(Expression)? ']'
StructExpression <- '{' List(StructField)? '}'
StructField <- ColIdOrString ':' Expression
MapExpression <- 'MAP' MapStructExpression
MapStructExpression <- '{' List(MapStructField)? '}'
MapStructField <- Expression ':' Expression

GroupingExpression <- GroupingOrGroupingId Parens(List(Expression)?)
GroupingOrGroupingId <- GroupingKeyword / GroupingIdKeyword
GroupingKeyword <- 'GROUPING'
GroupingIdKeyword <- 'GROUPING_ID'
Parameter <- QuestionMarkNumberedParameter / AnonymousParameter / NumberedParameter / ColLabelParameter
QuestionMarkNumberedParameter <- '?' NumberLiteral
AnonymousParameter <- '?'
NumberedParameter <- '$' NumberLiteral
ColLabelParameter <- '$' ColLabel
PositionalExpression <- '#' NumberLiteral
DefaultExpression <- 'DEFAULT'

ListComprehensionExpression <- '[' Expression 'FOR' List(ColIdOrString) 'IN' Expression ListComprehensionFilter? ']'
ListComprehensionFilter <- 'IF' Expression

ParensExpression <- Parens(Expression)

# RUNNING and FINAL say how much of a MATCH_RECOGNIZE match the call below them reads. They are only
# meaningful in MEASURES, which is where the binder checks for them.
MeasureSemanticsExpression <- MeasureSemantics FunctionExpression

SingleExpression <-
    ParensExpression /
	LiteralExpression /
	Parameter /
    SubqueryExpression /
    SpecialFunctionExpression /
    ParenthesisExpression /
    IntervalLiteral /
    TypeLiteral /
    CaseExpression /
    StarExpression /
    CastExpression /
    GroupingExpression /
    MapExpression /
    MeasureSemanticsExpression /
    FunctionExpression /
    ColumnReference /
    ListComprehensionExpression /
    ListExpression /
    StructExpression /
    PositionalExpression /
    DefaultExpression

# LEVEL 1 (Lowest)
Expression <- LambdaArrowExpression
ColumnDefaultExpr <- ColDefOrExpr
# LEVEL 1.5
LambdaArrowExpression <- LogicalOrExpression SingleArrowPair*
SingleArrowPair <- '->' LogicalOrExpression
LogicalOrExpression <- LogicalAndExpression LogicalOrExpressionTail*
LogicalOrExpressionTail <- 'OR' LogicalAndExpression
ColDefOrExpr <- ColDefAndExpr ColDefOrExpressionTail*
ColDefOrExpressionTail <- 'OR' ColDefAndExpr
# LEVEL 2
LogicalAndExpression <- LogicalNotExpression LogicalAndExpressionTail*
LogicalAndExpressionTail <- 'AND' LogicalNotExpression
ColDefAndExpr <- IsDistinctFromExpression ColDefAndExpressionTail*
ColDefAndExpressionTail <- 'AND' IsDistinctFromExpression
# LEVEL 3
LogicalNotExpression <- NotExpression? IsExpression
NotExpression <- NotKeyword+
NotKeyword <- 'NOT'
# LEVEL 4
IsExpression <- IsDistinctFromExpression IsExpressionContinuation?
IsExpressionContinuation <- IsTest IsExpressionTail*
IsExpressionTail <- IsTestTail / IsDistinctTail / IsComparisonTail / IsOtherOperatorTail / IsCastTail
IsTestTail <- IsTest
IsDistinctTail <- IsDistinctFromTail
IsComparisonTail <- ComparisonExpressionTail
IsOtherOperatorTail <- OtherOperatorTail
IsCastTail <- CastOperator
IsTest <- IsLiteral / NotNull / IsNull
IsLiteral <- 'IS' 'NOT'? IsLiteralValue
IsLiteralValue <- TrueLiteral / FalseLiteral / NullLiteral / UnknownLiteral
UnknownLiteral <- 'UNKNOWN'
NotNull <- NotNullKeyword / NotNullOperator
NotNullKeyword <- 'NOT' 'NULL'
NotNullOperator <- 'NOTNULL'
IsNull <- IsNullOperator
IsNullOperator <- 'ISNULL'
# LEVEL 5 (IS DISTINCT FROM retains the comparison binding)
IsDistinctFromExpression <- ComparisonExpression IsDistinctFromTail*
IsDistinctFromTail <- IsDistinctFromOp ComparisonExpression
IsDistinctFromOp <- 'IS' 'NOT'? 'DISTINCT' 'FROM'
# LEVEL 6
ComparisonExpression <- BetweenInLikeExpression ComparisonExpressionTail*
ComparisonExpressionTail <- ComparisonOperator ComparisonOperand
ComparisonOperand <- NotComparisonOperand / BetweenInLikeExpression
# NOT after a comparison operator binds everything up to the IS level: a < NOT b IS NULL is a < (NOT (b IS NULL))
NotComparisonOperand <- NotExpression IsExpression
ComparisonOperator <-
    OperatorEqual /
    OperatorNotEqual /
    OperatorLessThan /
    OperatorGreaterThan /
    OperatorLessThanEquals /
    OperatorGreaterThanEquals

OperatorEqual <- '=' / '=='
OperatorNotEqual <- '!=' / '<>'
OperatorLessThan <- '<'
OperatorGreaterThan <- '>'
OperatorLessThanEquals <- '<='
OperatorGreaterThanEquals <- '>='
# LEVEL 7
BetweenInLikeExpression <- OtherOperatorExpression InPredicate* BetweenLikeOp?
InPredicate <- 'NOT'? InClause CastOperator*
BetweenLikeOp <- 'NOT'? BetweenLikeOpExpression
BetweenLikeOpExpression <- BetweenClause / LikeClause
LikeClause <- LikeVariations OtherOperatorExpression EscapeClause?
EscapeClause <- 'ESCAPE' OtherOperatorExpression

LikeVariations <- SimilarToToken / RegexInsensitiveMatchToken / RegexMatchToken / ILikeToken / LikeToken / GlobToken / NotILikeOp / NotLikeOp / NotRegexInsensitiveMatchOp / NotSimilarToOp
LikeToken      <- 'LIKE' / '~~'
ILikeToken     <- 'ILIKE' / '~~*'
GlobToken      <- 'GLOB' / '~~~'
SimilarToToken <- 'SIMILAR' 'TO'
RegexMatchToken <- '~'
RegexInsensitiveMatchToken <- '~*'
NotILikeOp     <- '!~~*'
NotLikeOp      <- '!~~'
NotRegexInsensitiveMatchOp <- '!~*'
NotSimilarToOp <- '!~'

InClause <- 'IN' InExpression
InExpression <- InExpressionList / InSelectStatement / InContainsExpression
InContainsExpression <- OtherOperatorExpression
InExpressionList <- Parens(List(Expression))
InSelectStatement <- Parens(SelectStatementInternal)
BetweenClause <- 'BETWEEN' Asymmetric? OtherOperatorExpression 'AND' OtherOperatorExpression
Asymmetric <- 'ASYMMETRIC'
# LEVEL 8
OtherOperatorExpression <- InfixOtherOperatorExpression
InfixOtherOperatorExpression <- BitwiseExpression OtherOperatorTail*
OtherOperatorTail <- OtherOperator BitwiseExpression
OtherOperator <-
    AnyAllParsedOperator / NamedOtherOperator
AnyAllParsedOperator <- AnyAllOperator
NamedOtherOperator <-
    QualifiedOperator / OperatorLiteral
OperatorLiteral <- Identifier
AnyOperatorLiteral <- Identifier
AnyAllOperator <- AnyOperatorLiteral AnyOrAll
AnyOrAll <- SubqueryAny / SubqueryAll
SubqueryAny <- 'ANY' / 'SOME'
SubqueryAll <- 'ALL'
QualifiedOperator <- 'OPERATOR' Parens(QualifiedOperatorContents)
QualifiedOperatorContents <- ColIdDot* AnyOperatorLiteral
# LEVEL 9
BitwiseExpression <- TildeExpression BitwiseExpressionTail*
BitwiseExpressionTail <- BitOperator TildeExpression
BitOperator <- '&' / '|' / '<<' / '>>'
# LEVEL 9.5
TildeExpression <- TildePrefixOperator* AdditiveExpression
# LEVEL 10
AdditiveExpression <- MultiplicativeExpression AdditiveExpressionTail*
AdditiveExpressionTail <- Term MultiplicativeExpression
Term <- '+' / '-'
# LEVEL 11
MultiplicativeExpression <- ExponentiationExpression MultiplicativeExpressionTail*
MultiplicativeExpressionTail <- Factor ExponentiationExpression
Factor <- '*' / '/' / '//' / '%'
# LEVEL 12
ExponentiationExpression <- CollateExpression ExponentiationExpressionTail*
ExponentiationExpressionTail <- ExponentOperator CollateExpression
ExponentOperator <- '^' / '**'
# LEVEL 13
CollateExpression <- AtTimeZoneExpression CollateExpressionTail*
CollateExpressionTail <- CollateOperator AtTimeZoneExpression
CollateOperator <- 'COLLATE'
# LEVEL 14
AtTimeZoneExpression <- UnaryExpression AtTimeZoneExpressionTail*
AtTimeZoneExpressionTail <- AtTimeZoneOperator UnaryExpression
AtTimeZoneOperator <- 'AT' 'TIME' 'ZONE'
# LEVEL 15
UnaryExpression <- PrefixExpression / CustomPrefixExpression
PrefixExpression <- PrefixOperator* BaseExpression
CustomPrefixExpression <- OperatorLiteral TildeExpression
PrefixOperator <- QualifiedOperator / MinusPrefixOperator / PlusPrefixOperator
MinusPrefixOperator <- '-'
PlusPrefixOperator <- '+'
TildePrefixOperator <- '~'
# LEVEL 16 (Highest)
BaseExpression <- SingleExpression IndirectionList?
IndirectionList <- Indirection+

Indirection <- CastOperator / DotOperator / SliceExpression / PostfixOperator
CastOperator <- '::' Type
DotOperator <- DotMethodOperator / DotColumnOperator
DotMethodOperator <- '.' MethodExpression
DotColumnOperator <- '.' ColLabel
MethodExpression <- ColLabel MethodExpressionArguments
MethodExpressionArguments <- Parens(MethodExpressionArgumentList)
MethodExpressionArgumentList <- DistinctOrAll? MethodFunctionArguments? OrderByClause? IgnoreOrRespectNulls?
MethodFunctionArguments <- List(FunctionArgument)
SliceExpression <- '[' SliceBound ']'
SliceBound <- Expression? SliceUpperBound?
SliceUpperBound <- MinusStepSliceBound / EndStepSliceBound
MinusStepSliceBound <- ':' '-' StepSliceBound
EndStepSliceBound <- EndSliceBound StepSliceBound?
EndSliceBound <- ':' Expression?
StepSliceBound <- ':' Expression?
PostfixOperator <- '!'


SpecialFunctionExpression <- CoalesceExpression / UnpackExpression / TryExpression / ColumnsExpression / ExtractExpression / LambdaExpression / NullIfExpression / PositionExpression / RowExpression / SubstringExpression / TrimExpression / OverlayExpression
CoalesceExpression <- 'COALESCE' Parens(List(Expression))
UnpackExpression <- 'UNPACK' Parens(Expression)
TryExpression <- 'TRY' Parens(Expression)
ColumnsExpression <- StarSymbol? 'COLUMNS' Parens(Expression)
ExtractExpression <- 'EXTRACT' Parens(ExtractArguments)
ExtractArguments <- ExtractArgument 'FROM' Expression
LambdaExpression <- 'LAMBDA' List(ColIdOrString) ':' Expression
NullIfExpression <- 'NULLIF' Parens(NullIfArguments)
NullIfArguments <- Expression ',' Expression
PositionExpression <- 'POSITION' Parens(PositionArguments)
PositionArguments <- OtherOperatorExpression 'IN' Expression
RowExpression <- 'ROW' Parens(List(Expression)?)
SubstringExpression <- 'SUBSTRING' Parens(SubstringArguments)
SubstringArguments <- SubstringParameters / SubstringExpressionList
SubstringExpressionList <- List(Expression)
SubstringParameters <- Expression SubstringFromFor
SubstringFromFor <- SubstringFromOptionalFor / SubstringFor
SubstringFromOptionalFor <- FromExpression ForExpression?
SubstringFor <- ForExpression
TrimExpression <- 'TRIM' Parens(TrimArguments)
TrimArguments <- TrimDirection? TrimSource? List(Expression)
TrimDirection <- TrimBoth / TrimLeading / TrimTrailing
TrimBoth <- 'BOTH'
TrimLeading <- 'LEADING'
TrimTrailing <- 'TRAILING'
TrimSource <- Expression? 'FROM'
OverlayExpression <- 'OVERLAY' Parens(OverlayArguments)
OverlayArguments <- OverlayParameters / OverlayExpressionList
OverlayParameters <- Expression 'PLACING' Expression FromExpression ForExpression?
FromExpression <- 'FROM' Expression
ForExpression <- 'FOR' Expression
OverlayExpressionList <- List(Expression)

ExtractArgument <- ExtractDatePartArgument / ExtractIdentifierArgument / ExtractStringArgument
ExtractDatePartArgument <- ExtractDatePart
ExtractIdentifierArgument <- Identifier
ExtractStringArgument <- StringLiteral
ExtractDatePart <-
    YearKeyword / MonthKeyword / DayKeyword / HourKeyword / MinuteKeyword / SecondKeyword /
    MillisecondKeyword / MicrosecondKeyword / WeekKeyword / QuarterKeyword / DecadeKeyword /
    CenturyKeyword / MillenniumKeyword

# Every statement about external resources, so the top-level Statement choice carries one entry
# rather than one per form.
ExternalResourceStatement <- CreateExternalResourceStmt / RegisterExternalResourceStmt / DestroyExternalResourceStmt / ShowExternalResourcesStmt / AttachToExternalResource / ConnectToExternalResource

CreateExternalResourceStmt <- 'CREATE' ExternalResourceKeyword StringLiteral AttachAlias? ExternalResourceCreationOptions?
RegisterExternalResourceStmt <- 'REGISTER' ExternalResourceKeyword StringLiteral AttachAlias? 'FROM' Expression
DestroyExternalResourceStmt <- 'DESTROY' ExternalResourceKeyword ColId
ShowExternalResourcesStmt <- 'SHOW' ShowAllModifier? 'EXTERNAL' 'RESOURCES'
ShowAllModifier <- 'ALL'

# Syntax only: the keyword pair every singular form repeats. The plural in SHOW cannot share it.
ExternalResourceKeyword <- 'EXTERNAL' 'RESOURCE'

# The recipe's create params. Its own rule rather than AttachOptions: the two option bags are
# distinct, and a statement can carry both.
ExternalResourceCreationOptions <- GenericCopyOptionList

# The attach alias is mandatory: it separates the recipe's create params, which precede it, from the
# attachment's own options, which follow. Without it a single option list would be ambiguous.
# CONNECT has no such separator. Borrowing a registered resource has no create params to be confused
# with, so a list there is the connection's; provisioning does, and the transformer rejects the second
# list rather than let position decide.
AttachToExternalResource <- 'ATTACH' 'TO' ExternalResourceSource AttachAlias AttachOptions?
ConnectToExternalResource <- 'CONNECT' 'TO' ExternalResourceSource AttachOptions?
ExternalResourceSource <- ExternalResourceCreateClause / ExternalResourceReferenceClause
ExternalResourceCreateClause <- 'NEW' 'TEMPORARY' ExternalResourceKeyword StringLiteral ExternalResourceCreationOptions?
ExternalResourceReferenceClause <- ExternalResourceKeyword ColId

InsertStatement <- WithClause? 'INSERT' OrAction? 'INTO' InsertTarget ByNameOrPosition? InsertColumnList? OverridingClause? InsertValues OnConflictClause? ReturningClause?

OrAction <- InsertOrReplace / InsertOrIgnore
InsertOrReplace <- 'OR' 'REPLACE'
InsertOrIgnore <- 'OR' 'IGNORE'
ByNameOrPosition <- InsertByNameOrder / InsertByPositionOrder
InsertByNameOrder <- 'BY' InsertByName
InsertByPositionOrder <- 'BY' InsertByPosition
InsertByName <- 'NAME'
InsertByPosition <- 'POSITION'
OverridingClause <- 'OVERRIDING' OverridingScope 'VALUE'
OverridingScope <- 'USER' / 'SYSTEM'

InsertTarget <- BaseTableName InsertAlias?
InsertAlias <- 'AS' Identifier

ColumnList <- List(ColId)
InsertColumnList <- Parens(ColumnList)

InsertValues <- SelectInsertValues / DefaultValues
SelectInsertValues <- SelectStatementInternal
DefaultValues <- 'DEFAULT' 'VALUES'

OnConflictClause <- 'ON' 'CONFLICT' OnConflictTarget? OnConflictAction

OnConflictTarget <- OnConflictExpressionTarget / OnConflictIndexTarget
OnConflictExpressionTarget <- ColumnIdList WhereClause?
OnConflictIndexTarget <- 'ON' 'CONSTRAINT' ConstraintName


OnConflictAction <- OnConflictUpdate / OnConflictNothing

OnConflictUpdate <- 'DO' 'UPDATE' 'SET' UpdateSetClauseList WhereClause?
OnConflictNothing <- 'DO' 'NOTHING'

ReturningClause <- 'RETURNING' TargetList

LoadStatement <- 'LOAD' ColIdOrString FromSource? ExtensionAlias?
ExtensionAlias <- 'AS' Identifier
InstallStatement <- 'FORCE'? 'INSTALL' InstallAndLoad? IdentifierOrStringLiteral FromSource? VersionNumber?
InstallAndLoad <- 'AND' 'LOAD'
UpdateExtensionsStatement <- 'UPDATE' 'EXTENSIONS' Parens(List(Identifier))?
FromSource <- FromSourceIdentifier / FromSourceString
FromSourceIdentifier <- 'FROM' Identifier
FromSourceString <- 'FROM' StringLiteral
VersionNumber <- 'VERSION' IdentifierOrStringLiteral

ExtensionRepositoryStatement <- CreateExtensionRepositoryStmt / DropExtensionRepositoryStmt
CreateExtensionRepositoryStmt <- 'CREATE' OrReplace? 'EXTENSION' 'REPOSITORY' IfNotExists? ColIdOrString RepositoryPrefix RepositoryPublicKey?
RepositoryPrefix <- 'WITH'? 'PREFIX' StringLiteral
RepositoryPublicKey <- 'USING'? 'PUBLIC' ('KEYS' / 'KEY') List(StringLiteral)
DropExtensionRepositoryStmt <- 'DROP' 'EXTENSION' 'REPOSITORY' IfExists? ColIdOrString

TableMatchRecognizeClause <- 'MATCH_RECOGNIZE' Parens(MatchRecognizeBody) TableAlias?
MatchRecognizeBody <- MatchRecognizeClause+
MatchRecognizeClause <- MRPartition / MROrderBy / MRMeasures / MRRows / MRSkip / MRPattern / MRSubset / MRDefineAuto / MRDefine
MRPartition <- WindowPartition
MROrderBy <- OrderByClause
MRMeasures <- MeasuresClause
MRRows <- RowsPerMatch
MRSkip <- AfterMatchSkip
MRPattern <- PatternClause
MRSubset <- SubsetClause
MRDefineAuto <- ('DEFINE' / 'DEFINES') 'AUTO'
MRDefine <- DefineClause

MeasuresClause <- 'MEASURES' List(MeasuresElement)
MeasuresElement <- Expression 'AS' ColLabelOrString
MeasureSemantics <- RunningSemantics / FinalSemantics
RunningSemantics <- 'RUNNING'
FinalSemantics <- 'FINAL'

RowsPerMatch <- OneRowPerMatch / AllRowsPerMatch
OneRowPerMatch <- 'ONE' 'ROW' 'PER' 'MATCH'
AllRowsPerMatch <- 'ALL' 'ROWS' 'PER' 'MATCH' AllRowsEmptyMatches?
AllRowsEmptyMatches <- ShowEmptyMatches / OmitEmptyMatches / WithUnmatchedRows
ShowEmptyMatches <- 'SHOW' 'EMPTY' 'MATCHES'
OmitEmptyMatches <- 'OMIT' 'EMPTY' 'MATCHES'
WithUnmatchedRows <- 'WITH' 'UNMATCHED' 'ROWS'

AfterMatchSkip <- 'AFTER' 'MATCH' 'SKIP' AfterMatchSkipTarget
AfterMatchSkipTarget <- SkipToNextRow / SkipPastLastRow / SkipToFirstVar / SkipToLastVar / SkipToVar
SkipToNextRow <- 'TO' 'NEXT' 'ROW'
SkipPastLastRow <- 'PAST' 'LAST' 'ROW'
SkipToFirstVar <- 'TO' 'FIRST' ColLabelOrString
SkipToLastVar <- 'TO' 'LAST' ColLabelOrString
# naming a variable without saying which of its rows means its last one
SkipToVar <- 'TO' ColLabelOrString

PatternClause <- 'PATTERN' Parens(RowPattern)

# alternation binds loosest, then concatenation, then quantifiers
RowPattern <- RowPatternTerm RowPatternAlternative*
RowPatternAlternative <- '|' RowPatternTerm
RowPatternTerm <- RowPatternFactor+
RowPatternFactor <- RowPatternPrimary RowPatternQuantifier?
# PERMUTE has to be tried before a plain label, which would otherwise consume the keyword
RowPatternPrimary <- RowPatternPermute / RowPatternExclusion / RowPatternEmpty / RowPatternGroup / RowPatternAnchor / RowPatternLabel
RowPatternPermute <- 'PERMUTE' Parens(List(RowPattern))
# ^ and $ hold at the ends of the partition without taking a row
RowPatternAnchor <- PatternStart / PatternEnd
PatternStart <- '^'
PatternEnd <- '$'
RowPatternGroup <- Parens(RowPattern)
# () matches where it stands without taking a row
RowPatternEmpty <- '(' ')'
RowPatternExclusion <- '{' '-' RowPattern '-' '}'
RowPatternLabel <- ColLabelOrString

# a trailing ? makes the quantifier reluctant: it prefers the fewest repetitions rather than the most
RowPatternQuantifier <- RowPatternQuantifierKind QuantifierReluctant?
RowPatternQuantifierKind <- QuantifierStar / QuantifierPlus / QuantifierOptional / QuantifierRange
QuantifierReluctant <- '?'
QuantifierStar <- '*'
QuantifierPlus <- '+'
QuantifierOptional <- '?'
QuantifierRange <- '{' QuantifierBounds '}'
QuantifierBounds <- QuantifierMinMax / QuantifierMin / QuantifierMax / QuantifierExact
QuantifierMinMax <- NumberLiteral ',' NumberLiteral
QuantifierMin <- NumberLiteral ','
QuantifierMax <- ',' NumberLiteral
QuantifierExact <- NumberLiteral

SubsetClause <- 'SUBSET' List(SubsetElement)
SubsetElement <- ColLabelOrString '=' Parens(List(ColLabelOrString))

DefineClause <- ('DEFINE' / 'DEFINES') List(DefineElement)
DefineElement <- ColLabelOrString 'AS' Expression

MergeIntoStatement <- WithClause? 'MERGE' 'INTO' TargetOptAlias MergeIntoUsingClause JoinQualifier MergeMatch+ ReturningClause?
MergeIntoUsingClause <- 'USING' TableRef
MergeMatch <- MatchedClause / NotMatchedClause
MatchedClause <- 'WHEN' 'MATCHED' AndExpression? 'THEN' MatchedClauseAction
MatchedClauseAction <- UpdateMatchClause / DeleteMatchClause / InsertMatchClause / DoNothingMatchClause / ErrorMatchClause
UpdateMatchClause <- 'UPDATE' UpdateMatchInfo?
UpdateMatchInfo <- UpdateMatchSetAction / UpdateByNameOrPosition
UpdateMatchSetAction <- UpdateMatchSetClause
UpdateByNameOrPosition <- ByNameOrPosition
DeleteMatchClause <- 'DELETE'
InsertMatchClause <- 'INSERT' InsertMatchInfo?
InsertMatchInfo <- InsertValuesList / InsertDefaultValues / InsertByNameOrPosition
InsertDefaultValues <- 'DEFAULT' 'VALUES'
InsertByNameOrPosition <- ByNameOrPosition? '*'?
InsertValuesList <- InsertColumnList? 'VALUES' Parens(List(Expression))
DoNothingMatchClause <- 'DO' 'NOTHING'
ErrorMatchClause <- 'ERROR' Expression?
UpdateMatchSetClause <- 'SET' UpdateMatchSetInfo
UpdateMatchSetInfo <- UpdateSetClauseList / StarSymbol
AndExpression <- 'AND' Expression
NotMatchedClause <- 'WHEN' 'NOT' 'MATCHED' BySourceOrTarget? AndExpression? 'THEN' MatchedClauseAction
BySourceOrTarget <- BySource / ByTarget
BySource <- 'BY' 'SOURCE'
ByTarget <- 'BY' 'TARGET'




PivotStatement <- PivotKeyword TableRef PivotOn? PivotUsing? PivotGroupByList?

PivotOn <- 'ON' PivotColumnList
PivotUsing <- 'USING' TargetList
PivotColumnList <- List(PivotColumnEntry)
PivotColumnEntry <- PivotColumnSubquery / PivotValueList / PivotColumnExpression
PivotColumnExpression <- Expression
PivotColumnSubquery <- BaseExpression 'IN' Parens(SelectStatementInternal)

PivotKeyword <- 'PIVOT' / 'PIVOT_WIDER'
UnpivotKeyword <- 'UNPIVOT' / 'PIVOT_LONGER'

UnpivotStatement <- UnpivotKeyword TableRef 'ON' TargetList IntoNameValues?

IntoNameValues <- 'INTO' 'NAME' ColIdOrString ValueOrValues OptionalParensNameList

ValueOrValues <- 'VALUE' / 'VALUES'

OptionalParensNameList <- ParenthesizedNameList / BareNameList
ParenthesizedNameList <- Parens(List(ColIdOrString))
BareNameList <- List(ColIdOrString)

IncludeOrExcludeNulls <- IncludeNulls / ExcludeNulls
IncludeNulls <- 'INCLUDE' 'NULLS'
ExcludeNulls <- 'EXCLUDE' 'NULLS'
UnpivotHeader <- UnpivotHeaderSingle / UnpivotHeaderList
UnpivotHeaderSingle <- ColIdOrString
UnpivotHeaderList <- Parens(List(ColIdOrString))

PragmaStatement <- 'PRAGMA' PragmaAssignOrFunction
PragmaAssignOrFunction <- PragmaAssign / PragmaFunction

PragmaAssign <- SettingName '=' VariableList
PragmaFunction <- PragmaName PragmaParameters?
PragmaParameters <- Parens(List(Expression))

PrepareStatement <- 'PREPARE' ColIdOrString TypeList? 'AS' Statement

TypeList <- Parens(List(Type))

SelectStatement <- SelectStatementInternal
SelectStatementInternal <- WithClause? SelectSetOpChain ResultModifiers?
SelectSetOpChain <- IntersectChain SelectSetOpChainTail*
SelectSetOpChainTail <- SetopClause IntersectChain
IntersectChain <- SelectAtom IntersectChainTail*
IntersectChainTail <- SetIntersectClause SelectAtom
SetIntersectClause <- 'INTERSECT' DistinctOrAll?
SelectAtom <- SelectParens / SelectStatementType

SelectParens <- Parens(SelectStatementInternal)

SetopClause <- SetopType DistinctOrAll? ByName?
SetopType <- SetopUnion / SetopExcept
SetopUnion <- 'UNION'
SetopExcept <- 'EXCEPT'
ByName <- 'BY' 'NAME'

SelectStatementType <- OptionalParensSimpleSelect / ValuesClause / DescribeStatement / TableStatement / PivotStatement / UnpivotStatement
ResultModifiers <- OrderByClause? LimitOffset?
LimitOffset <- LimitOffsetClause / OffsetFetchClause / OffsetLimitClause / FetchOffsetClause / FetchOnlyClause
LimitOffsetClause <- LimitClause OffsetClause?
OffsetLimitClause <- OffsetClause LimitClause?
OffsetFetchClause <- OffsetClause FetchClause
FetchOffsetClause <- FetchClause OffsetClause
FetchOnlyClause <- FetchClause
TableStatement <- 'TABLE' BaseTableName
OptionalParensSimpleSelect <- SimpleSelectParens / SimpleSelect
SimpleSelectParens <- Parens(SimpleSelect)
SimpleSelect <- SelectFrom WhereClause? GroupByClause? HavingClause? WindowClause? QualifyClause? SelectSampleClause?

SelectFrom <- SelectFromClause / FromSelectClause
SelectFromClause <- SelectClause FromClause?
FromSelectClause <- FromClause SelectClause?
WithStatement <- ColIdOrString ColumnAliases? UsingKey? 'AS' Materialized? CTEBody
CTEBody <- CTESelectBody / CTEDMLBody
CTESelectBody <- Parens(SelectStatementInternal)
CTEDMLBody <- Parens(Statement)
UsingKey <- 'USING' 'KEY' Parens(TargetList)
Materialized <- 'NOT'? 'MATERIALIZED'
WithClause <- 'WITH' Recursive? List(WithStatement)
Recursive <- 'RECURSIVE'
SelectClause <- 'SELECT' DistinctClause? TargetList?
TargetList <- List(AliasedExpression)
ColumnAliases <- Parens(List(ColIdOrString))

DistinctClause <- DistinctOn / DistinctAll
DistinctAll <- 'ALL'
DistinctOn <- 'DISTINCT' DistinctOnTargets?
DistinctOnTargets <- 'ON' Parens(List(Expression))

InnerTableRef <- ValuesRef / TableFunction / TableSubquery / BaseTableRef / ParensTableRef

TableRef <- InnerTableRef JoinOrPivot*
TableSubquery <- TableAliasColon? Lateral? SubqueryReference TableAlias? SampleClause?
BaseTableRef <- TableAliasColon? BaseTableName TableAlias? AtClause? SampleClause?
TableAliasColon <- ColIdOrString ':'
ValuesRef <- TableAliasColon? ValuesClause TableAlias? SampleClause?
ParensTableRef <- TableAliasColon? Parens(TableRef) TableAlias? SampleClause?

JoinOrPivot <- JoinClause / TablePivotClause / TableUnpivotClause / TableMatchRecognizeClause

TablePivotClause <- 'PIVOT' Parens(TablePivotClauseBody) TableAlias?
TablePivotClauseBody <- TargetList 'FOR' PivotValueList+ PivotGroupByList?
PivotGroupByList <- 'GROUP' 'BY' OptionalParensNameList
TableUnpivotClause <- 'UNPIVOT' IncludeOrExcludeNulls? Parens(TableUnpivotClauseBody) TableAlias?
TableUnpivotClauseBody <- UnpivotHeader 'FOR' UnpivotValueList+

PivotHeader <- BaseExpression
PivotValueList <- PivotHeader 'IN' PivotValueTarget
PivotValueTarget <- PivotEnumTarget / PivotListTarget
PivotEnumTarget <- Identifier
PivotListTarget <- PivotTargetList
UnpivotValueList <- UnpivotHeader 'IN' UnpivotTargetList
PivotTargetList <- Parens(TargetList)
UnpivotTargetList <- Parens(TargetList)

Lateral <- 'LATERAL'

BaseTableName <- QualifiedTableName / UnqualifiedBaseTableName
UnqualifiedBaseTableName <- TableName
QualifiedTableName <- CatalogReservedSchemaTable / SchemaReservedTable
SchemaReservedTable <- SchemaQualification ReservedTableName
CatalogReservedSchemaTable <- CatalogQualification ReservedSchemaQualification+ ReservedTableName

TableFunction <- TableFunctionLateralOpt / TableFunctionAliasColon
TableFunctionLateralOpt <- Lateral? QualifiedTableFunction TableFunctionArguments WithOrdinality? TableAlias? SampleClause?
TableFunctionAliasColon <- TableAliasColon QualifiedTableFunction TableFunctionArguments WithOrdinality? SampleClause?
WithOrdinality <- 'WITH' 'ORDINALITY'
QualifiedTableFunction <- CatalogQualification? SchemaQualification* TableFunctionName
TableFunctionArguments <- Parens(List(FunctionArgument)?)
FunctionArgument <- NamedFunctionArgument / PositionalFunctionArgument
NamedFunctionArgument <- TypeFuncName NamedParameterAssignment Expression
PositionalFunctionArgument <- Expression
NamedParameter <- TypeFuncName Type? NamedParameterAssignment Expression
NamedParameterAssignment <- ':=' / '=>'

TableAlias <- TableAliasAs / TableAliasWithoutAs
TableAliasAs <- 'AS' IdentifierOrStringLiteral ColumnAliases?
TableAliasWithoutAs <- Identifier ColumnAliases?

AtClause <- 'AT' Parens(AtSpecifier)
AtSpecifier <- AtUnit '=>' Expression
AtUnit <- VersionAtUnit / TimestampAtUnit
VersionAtUnit <- 'VERSION'
TimestampAtUnit <- 'TIMESTAMP'

JoinClause <- JoinByClause / RegularJoinClause / JoinWithoutOnClause / NearestJoinClause
# NEAREST BY has two alternatives so PEG can backtrack: the bare form uses alias-less target mirrors (tried
# first, so an unaliased target does not greedily consume NEAREST/APPROX/EXACT as an alias), and the aliased
# form falls back to a full TableRef when a real alias identifier follows the target.
NearestJoinClause <- NearestJoinBare / NearestJoinAliased
NearestJoinAliased <- JoinType? 'JOIN' TableRef ApproxOrExact? 'NEAREST' NumberLiteral? 'BY' DistanceOrSimilarity Expression
NearestJoinBare <- JoinType? 'JOIN' NearestBareTableRef ApproxOrExact? 'NEAREST' NumberLiteral? 'BY' DistanceOrSimilarity Expression
NearestBareTableRef <- NearestValuesRef / NearestTableFunction / NearestTableSubquery / NearestBaseTableRef / NearestParensTableRef
NearestValuesRef <- ValuesClause
NearestTableFunction <- Lateral? QualifiedTableFunction TableFunctionArguments WithOrdinality?
NearestTableSubquery <- Lateral? SubqueryReference
NearestBaseTableRef <- BaseTableName AtClause? SampleClause?
NearestParensTableRef <- Parens(TableRef) SampleClause?
ApproxOrExact <- NearestApprox / NearestExact
NearestApprox <- 'APPROX'
NearestExact <- 'EXACT'
DistanceOrSimilarity <- NearestDistance / NearestSimilarity
NearestDistance <- 'DISTANCE'
NearestSimilarity <- 'SIMILARITY'
RegularJoinClause <- Asof? JoinType? 'JOIN' TableRef JoinQualifier
JoinByClause <- 'JOIN' 'BY' Parens('TYPE' ColLabel) TableRef JoinQualifier
Asof <- 'ASOF'
JoinWithoutOnClause <- JoinPrefix 'JOIN' InnerTableRef
JoinQualifier <- OnClause / UsingClause
OnClause <- 'ON' Expression
UsingClause <- 'USING' Parens(List(UsingColumnName))
UsingColumnName <- ColumnName / StringLiteralIdentifier

JoinType <- FullJoin / LeftJoin / RightJoin / SemiJoin / AntiJoin / InnerJoin
JoinPrefix <- CrossJoinPrefix / NaturalJoinPrefix / PositionalJoinPrefix
CrossJoinPrefix <- 'CROSS'
NaturalJoinPrefix <- 'NATURAL' JoinType?
PositionalJoinPrefix <- 'POSITIONAL'
FullJoin <- 'FULL' 'OUTER'?
LeftJoin <- 'LEFT' 'OUTER'?
RightJoin <- 'RIGHT' 'OUTER'?
SemiJoin <- 'SEMI'
AntiJoin <- 'ANTI'
InnerJoin <- 'INNER'

FromClause <- 'FROM' List(TableRef)
WhereClause <- 'WHERE' Expression
GroupByClause <- 'GROUP' 'BY' GroupByExpressions
HavingClause <- 'HAVING' Expression
QualifyClause <- 'QUALIFY' Expression
SampleClause <- TableSample SampleEntry
SelectSampleClause <- UsingSample SampleEntry
UsingSample <- 'USING' 'SAMPLE'
TableSample <- 'TABLESAMPLE'
WindowClause <- 'WINDOW' List(WindowDefinition)
WindowDefinition <- Identifier 'AS' WindowFrameDefinition

SampleEntry <- SampleEntryFunction / SampleEntryCount
SampleEntryCount <- SampleCount Parens(SampleProperties)?
SampleEntryFunction <- SampleFunction? Parens(SampleCount) RepeatableSample?
SampleFunction <- ColId
SampleProperties <- ColId (',' SampleSeed)?
RepeatableSample <- 'REPEATABLE' Parens(SampleSeed)

SampleSeed <- NumberLiteral

SampleCount <- SampleValue SampleUnit?
SampleValue <- NumberLiteral / Parameter
SampleUnit <- SamplePercentage / SampleRows
SamplePercentage <- '%' / 'PERCENT'
SampleRows <- 'ROWS'

GroupByExpressions <- GroupByList / GroupByAll
GroupByAll <- 'ALL'
GroupByList <- List(GroupByExpression)
GroupByExpression <- EmptyGroupingItem / CubeOrRollupClause / GroupingSetsClause / GroupByBaseExpression
GroupByBaseExpression <- Expression
EmptyGroupingItem <- '(' ')'
CubeOrRollupClause <- CubeOrRollup Parens(List(Expression)?)
CubeOrRollup <- CubeKeyword / RollupKeyword
CubeKeyword <- 'CUBE'
RollupKeyword <- 'ROLLUP'
GroupingSetsClause <- 'GROUPING' 'SETS' Parens(List(GroupByExpression))

SubqueryReference <- Parens(SelectStatementInternal)

OrderByExpression <- Expression DescOrAsc? NullsFirstOrLast?
DescOrAsc <- DescendingOrder / AscendingOrder
DescendingOrder <- 'DESC' / 'DESCENDING'
AscendingOrder <- 'ASC' / 'ASCENDING'
NullsFirstOrLast <- NullsFirst / NullsLast
NullsFirst <- 'NULLS' 'FIRST'
NullsLast <- 'NULLS' 'LAST'
OrderByClause <- 'ORDER' 'BY' OrderByExpressions
OrderByExpressions <- OrderByAll / OrderByExpressionList
OrderByExpressionList <- List(OrderByExpression)
OrderByAll <- 'ALL' DescOrAsc? NullsFirstOrLast?

LimitClause <- 'LIMIT' LimitValue
OffsetClause <- 'OFFSET' OffsetValue
OffsetValue <- Expression RowOrRows?
RowOrRows <- 'ROW' / 'ROWS'
LimitValue <- LimitAll / LimitLiteralPercent / LimitExpression
LimitAll <- 'ALL'
LimitLiteralPercent <- NumberLiteral 'PERCENT'
LimitExpression <- Expression '%'?
FetchClause <- FetchClauseWithoutValue / FetchClauseWithValue
FetchClauseWithoutValue <- 'FETCH' FirstOrNext RowOrRows 'ONLY'
FetchClauseWithValue <- 'FETCH' FirstOrNext FetchValue RowOrRows 'ONLY'
FirstOrNext <- 'FIRST' / 'NEXT'
FetchValue <- Expression

AliasedExpression <- ColIdExpression / ExpressionAsCollabel / ExpressionOptIdentifier
ColIdExpression <- ColId ':' Expression
ExpressionAsCollabel <- Expression 'AS' ColLabelOrString
ExpressionOptIdentifier <- Expression BareColLabel?

ValuesClause <- 'VALUES' List(ValuesExpressions)
ValuesExpressions <- Parens(List(Expression))

SetStatement <- SetKeywordStatement / VariableAssignment
SetKeywordStatement <- 'SET' SetAssignmentOrTimeZone
VariableAssignment <- '$' Identifier ':=' Expression
SetAssignmentOrTimeZone <- SetSchema / StandardAssignment / SetTimeZone

ResetStatement <- 'RESET' ResetTarget
ResetTarget <- ResetTimeZone / ResetVariableOrSetting
ResetTimeZone <- SettingScope? 'TIME' 'ZONE'
ResetVariableOrSetting <- SetVariableOrSetting
SetSchema <- SettingScope? 'SCHEMA' StringLiteral
StandardAssignment <- SetVariableOrSetting SetAssignment
SetVariableOrSetting <- SetVariable / SetSetting
SetTimeZone <- SettingScope? 'TIME' 'ZONE' ZoneValue

ZoneValue <- ZoneIntervalWithPrecision / ZoneIntervalWithInterval / ZoneLocal / ZoneDefault / ZoneStringLiteral / ZoneIdentifier / NumberLiteral
ZoneLocal <- 'LOCAL'
ZoneDefault <- 'DEFAULT'
ZoneStringLiteral <- StringLiteral
ZoneIdentifier <- Identifier
ZoneIntervalWithInterval <- 'INTERVAL' StringLiteral Interval?
ZoneIntervalWithPrecision <- 'INTERVAL' Parens(NumberLiteral) StringLiteral

SetSetting <- SettingScope? SettingName
SetVariable <- VariableScope Identifier
VariableScope <- 'VARIABLE'

SettingScope <- LocalScope / SessionScope / GlobalScope
LocalScope <- 'LOCAL'
SessionScope <- 'SESSION'
GlobalScope <- 'GLOBAL'

SetAssignment <- VariableAssign VariableList

VariableAssign <- '=' / 'TO'
VariableList <- List(Expression)

TransactionStatement <- BeginTransaction / RollbackTransaction / CommitTransaction

BeginTransaction <- StartOrBegin Transaction? ReadOrWrite?
RollbackTransaction <- AbortOrRollback Transaction?
CommitTransaction <- CommitOrEnd Transaction?

StartOrBegin <- 'START' / 'BEGIN'
Transaction <- 'WORK' / 'TRANSACTION'
ReadOrWrite <- 'READ' ReadOnlyOrReadWrite
ReadOnlyOrReadWrite <- ReadOnly / ReadWrite
ReadOnly <- 'ONLY'
ReadWrite <- 'WRITE'
AbortOrRollback <- 'ABORT' / 'ROLLBACK'
CommitOrEnd <- 'COMMIT' / 'END'
UpdateStatement <- WithClause? 'UPDATE' UpdateTarget UpdateSetClauseList FromClause? WhereClause? ReturningClause?

UpdateTarget <- BaseTableSet / BaseTableAliasSet
BaseTableSet <- BaseTableName 'SET'
BaseTableAliasSet <- BaseTableName UpdateAlias? 'SET'
UpdateAlias <- 'AS'? ColId
UpdateSetClauseList <- List(UpdateSetClause)
UpdateSetClause <- UpdateSetElement / UpdateSetTuple
UpdateSetTuple <- Parens(List(ColumnName)) '=' Expression
UpdateSetElement <- UpdateSetColumnTarget '=' Expression
UpdateSetColumnTarget <- ColumnName DotIdentifier*

UseStatement <- 'USE' UseTarget

UseTarget <- UseTargetCatalogSchema / SchemaNameAsUseTarget / CatalogNameAsUseTarget
SchemaNameAsUseTarget <- SchemaName / StringLiteral
CatalogNameAsUseTarget <- CatalogName / StringLiteral
UseTargetCatalogSchema <- CatalogName '.' ReservedSchemaName DotIdentifier*
DotIdentifier <- '.' Identifier

VacuumStatement <- 'VACUUM' VacuumOptions? AnalyzeTarget?
VacuumOptions <- VacuumParensOptions / VacuumLegacyOptions

VacuumParensOptions <- Parens(List(VacuumOption))
VacuumLegacyOptions <- OptFull? OptFreeze? OptVerbose? OptAnalyze?
VacuumOption <- OptAnalyze / OptFreeze / OptFull / OptVerbose / Identifier

OptAnalyze <- AnalyzeKeyword
OptFull <- 'FULL'
OptFreeze <- 'FREEZE'
OptVerbose <- 'VERBOSE'

NameList <- Parens(List(ColIdOrString))

