LoadStatement <- 'LOAD' ColIdOrString FromSource? ExtensionAlias?
ExtensionAlias <- 'AS' Identifier
InstallStatement <- 'FORCE'? 'INSTALL' InstallAndLoad? IdentifierOrStringLiteral FromSource? VersionNumber?
InstallAndLoad <- 'AND' 'LOAD'
UpdateExtensionsStatement <- 'UPDATE' 'EXTENSIONS' Parens(List(Identifier))?
FromSource <- FromSourceIdentifier / FromSourceString
FromSourceIdentifier <- 'FROM' FromSourceName
FromSourceString <- 'FROM' StringLiteral
# a repository named after its host is spelled as dotted words: INSTALL x FROM carlopi.github.io
FromSourceName <- ExtensionRepositoryHostName / Identifier
VersionNumber <- 'VERSION' IdentifierOrStringLiteral

ExtensionRepositoryStatement <- CreateExtensionRepositoryStmt / CreateExtensionRepositoryFromHostStmt / DropExtensionRepositoryStmt
CreateExtensionRepositoryStmt <- 'CREATE' OrReplace? 'EXTENSION' 'REPOSITORY' IfNotExists? ExtensionRepositoryName RepositoryPrefix RepositoryPublicKey?
RepositoryPrefix <- 'WITH'? 'PREFIX' StringLiteral
RepositoryPublicKey <- 'USING'? 'PUBLIC' ('KEYS' / 'KEY') List(StringLiteral)
# "CREATE EXTENSION REPOSITORY carlopi.github.io": without a prefix the name is the host of the publisher, and the host
# says where its repository is: https://<name>/.well-known/duckdb-extension-repo.json names the prefix (and may carry
# the signing keys). The rest is CREATE EXTENSION REPOSITORY <name> WITH PREFIX <that prefix>.
CreateExtensionRepositoryFromHostStmt <- 'CREATE' OrReplace? 'EXTENSION' 'REPOSITORY' IfNotExists? ExtensionRepositoryName
DropExtensionRepositoryStmt <- 'DROP' 'EXTENSION' 'REPOSITORY' IfExists? ExtensionRepositoryName
# A repository name: an identifier or a string, or a host spelled as dotted words. A host with a '-' in it cannot be
# spelled unquoted ('-' is an operator); it is given as a string: 'duckdb-extensions.example.com'
ExtensionRepositoryName <- ExtensionRepositoryHostName / ColIdOrString
ExtensionRepositoryHostName <- ColId DotColLabel+
