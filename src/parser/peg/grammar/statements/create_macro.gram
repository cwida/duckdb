CreateMacroStmt <- MacroOrFunction IfNotExists? MacroName List(MacroDefinition)
MacroName <- QualifiedName / MacroFunctionName
# the bare names a call accepts, parsed but not suggested (matcher_factory.cpp)
MacroFunctionName <- FunctionNameAsQualifiedName

ReturnsType <- 'RETURNS' Type

MacroOrFunction <- MacroKeyword / FunctionKeyword
MacroKeyword <- 'MACRO'
FunctionKeyword <- 'FUNCTION'

MacroDefinition <- Parens(MacroParameters?) ReturnsType? 'AS' MacroDefinitionBody
MacroDefinitionBody <- TableMacroDefinition / ScalarMacroDefinition

MacroParameters <- List(MacroParameter)
MacroParameter <- NamedParameter / SimpleParameter
SimpleParameter <- TypeFuncName Type?

ScalarMacroDefinition <- Expression
TableMacroDefinition <- 'TABLE' SelectStatementInternal
