# The attach alias is mandatory: it separates the recipe's create params, which precede it, from the
# attachment's own options, which follow. Without it a single option list would be ambiguous.
# CONNECT has no such separator. Borrowing a registered resource has no create params to be confused
# with, so a list there is the connection's; provisioning does, and the transformer rejects the second
# list rather than let position decide.
AttachToExternalResource <- 'ATTACH' 'TO' ExternalResourceSource AttachAlias AttachOptions?
ConnectToExternalResource <- 'CONNECT' 'TO' ExternalResourceSource AttachOptions?
ExternalResourceSource <- ExternalResourceCreateClause / ResourceWordsCreateClause / ExternalResourceReferenceClause / ResourceReferenceClause
ExternalResourceCreateClause <- 'NEW' 'TEMPORARY' ExternalResourceKeyword StringLiteral ExternalResourceCreationOptions?
ExternalResourceReferenceClause <- ExternalResourceKeyword ColId
# The short noun, as in CREATE RESOURCE: "NEW TEMPORARY RESOURCE A B (...)" spells the type as words. A reference
# has no type to spell, so "RESOURCE <name>" is the long form's "EXTERNAL RESOURCE <name>" with less to type.
ResourceWordsCreateClause <- 'NEW' 'TEMPORARY' 'RESOURCE' ColId ColId+ ExternalResourceCreationOptions?
ResourceReferenceClause <- 'RESOURCE' ColId
