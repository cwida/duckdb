+static bool SkipPassthroughOperators(unique_ptr<LogicalOperator> *&op, unique_ptr<Expression> &expression) {
+	while ((*op)->children.size() == 1) {
+		if ((*op)->type == LogicalOperatorType::LOGICAL_FILTER) {
+			if (!(*op)->Cast<LogicalFilter>().expressions.empty()) {
+				break;
+			}
+		} else if ((*op)->type == LogicalOperatorType::LOGICAL_PROJECTION) {
+			auto &projection = (*op)->Cast<LogicalProjection>();
+			auto bindings = projection.GetColumnBindings();
+			ColumnBindingReplacer replacer;
+			for (idx_t i = 0; i < projection.expressions.size(); i++) {
+				if (projection.expressions[i]->GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {
+					return false;
+				}
+				auto &column = projection.expressions[i]->Cast<BoundColumnRefExpression>();
+				replacer.replacement_bindings.emplace_back(bindings[i], column.Binding());
+			}
+			replacer.VisitExpression(&expression);
+		} else {
+			break;
+		}
+		op = &(*op)->children[0];
+	}
+	return true;
+}
